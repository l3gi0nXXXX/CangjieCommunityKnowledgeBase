{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/l3gi0nXXXX/CangjieCommunityKnowledgeBase/reproducibility/environment-lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identityStatus", "certifiedPlatform", "cpuArchitecture", "cangjieSdkVersion", "cangjieSdkHash", "opensslVersion", "serviceHeap", "qdrantImageDigest", "runCandidateCommit", "runCriticalFilesManifestHash", "runCriticalTreeHash", "compositionManifestPath", "compositionManifestHash", "claudeCodeVersion", "glmProvider", "glmBaseUrl", "glmModel", "modelFingerprint", "glmCredentialEnv", "embeddingProvider", "embeddingModel", "embeddingDimension", "embeddingCredentialEnv", "archiveTool", "archiveToolVersion", "experimentGroup", "ckbRequired", "localDocsPolicy", "modelEffort", "modelBudget", "timeoutSeconds", "transportRetryBudget", "promptHash", "mcpCommand", "mcpTransport", "sandboxCapability", "datasetVersion", "authorityDeliveryHash", "attestationAuthorityManifestPath", "attestationAuthorityHash"],
  "properties": {
    "schemaVersion": {"const": "ckb-repro-environment-v1"},
    "identityStatus": {"enum": ["planned", "frozen"]},
    "certifiedPlatform": {"const": "macOS"},
    "cpuArchitecture": {"const": "arm64"},
    "cangjieSdkVersion": {"type": "string"},
    "cangjieSdkHash": {"type": "string"},
    "opensslVersion": {"type": "string"},
    "serviceHeap": {"const": "4GB"},
    "qdrantImageDigest": {"type": "string"},
    "runCandidateCommit": {"type": "string"},
    "runCriticalFilesManifestHash": {"type": "string"},
    "runCriticalTreeHash": {"type": "string"},
    "compositionManifestPath": {"const": "reproducibility/manifests/runtime-composition.json"},
    "compositionManifestHash": {"type": "string", "$comment": "Hash of the exact private runtime-composition manifest; the manifest must not contain this environment lock."},
    "claudeCodeVersion": {"type": "string"},
    "glmProvider": {"type": "string"},
    "glmBaseUrl": {"type": "string"},
    "glmModel": {"const": "GLM-5.2"},
    "modelFingerprint": {"const": "claude-code-glm-5.2"},
    "glmCredentialEnv": {"type": "string"},
    "embeddingProvider": {"type": "string"},
    "embeddingModel": {"type": "string"},
    "embeddingDimension": {"type": "integer", "minimum": 1},
    "embeddingCredentialEnv": {"type": "string"},
    "archiveTool": {"type": "string"},
    "archiveToolVersion": {"type": "string"},
    "experimentGroup": {"const": "D-ckb-mcp-http"},
    "ckbRequired": {"const": true},
    "localDocsPolicy": {"type": "string"},
    "modelEffort": {"type": "string"},
    "modelBudget": {"type": "string"},
    "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "transportRetryBudget": {"type": "integer", "minimum": 0},
    "promptHash": {"type": "string"},
    "mcpCommand": {"type": "string"},
    "mcpTransport": {"enum": ["mcp_stdio", "rest", "mcp_http"]},
    "sandboxCapability": {"const": "macos-sandbox-exec"},
    "datasetVersion": {"type": "string"},
    "authorityDeliveryHash": {"type": "string"},
    "attestationAuthorityManifestPath": {"const": "reproducibility/manifests/environment-attestation-authority.json"},
    "attestationAuthorityHash": {"type": "string", "$comment": "Full authority manifest hash; included in canonical environmentManifestHash and certifiedRunInputHash."}
  }
}
