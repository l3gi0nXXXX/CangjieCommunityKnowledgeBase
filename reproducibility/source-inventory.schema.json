{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ckb-source-inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "sourceId", "recordKind", "portableLocator", "sourceType", "license"],
  "properties": {
    "identity": {"type": "string", "minLength": 1},
    "sourceId": {"type": "string", "minLength": 1},
    "recordKind": {"type": "string", "minLength": 1},
    "portableLocator": {"type": "string", "minLength": 1},
    "sourceType": {"enum": ["external_git", "generated"]},
    "license": {"type": "string", "minLength": 1}
  }
}
