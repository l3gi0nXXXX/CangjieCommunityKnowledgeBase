{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/l3gi0nXXXX/CangjieCommunityKnowledgeBase/reproducibility/run-critical-files.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "files"],
  "properties": {
    "schemaVersion": {"const": "ckb-run-critical-files-v1"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^src/[A-Za-z0-9_/-]+\\.cj$"},
          "status": {"enum": ["planned", "present"]},
          "sha256": {"type": "string"}
        }
      }
    }
  }
}
