{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/l3gi0nXXXX/CangjieCommunityKnowledgeBase/reproducibility/reference-run.schema.json",
  "title": "CKB reproducibility reference run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "baselineKind", "evidenceStatus", "releaseRepository",
    "releaseRepositoryUrl", "releaseBranch", "observedRemote", "runId",
    "knowledgeVersion", "vectorProofHash", "datasetVersion", "runnerCommit",
    "claudeCodeVersion", "model", "providerFingerprint", "experimentGroup",
    "toolTransport", "mcpTransport", "ckbRequired", "localDocsPolicy",
    "modelEffort", "modelBudget", "timeoutSeconds", "transportRetryBudget",
    "promptHash", "resultsHash", "runCriticalTreeHash", "totalCases",
    "rawPassed", "strictPassed", "strictFailed", "businessFailed",
    "protocolInvalid", "transportUnresolved", "missingEvidence"
  ],
  "properties": {
    "schemaVersion": {"const": "ckb-repro-reference-v1"},
    "baselineKind": {"enum": ["historical_pre_portable", "portable_release"]},
    "evidenceStatus": {"enum": ["complete", "incomplete"]},
    "releaseRepository": {"const": "l3gi0nXXXX/CangjieCommunityKnowledgeBase"},
    "releaseRepositoryUrl": {"const": "https://github.com/l3gi0nXXXX/CangjieCommunityKnowledgeBase"},
    "releaseBranch": {"const": "main"},
    "observedRemote": {"type": "string"},
    "runId": {"type": "string", "minLength": 1},
    "knowledgeVersion": {"type": "string", "minLength": 1},
    "vectorProofHash": {"type": "string"},
    "datasetVersion": {"type": "string", "minLength": 1},
    "runnerCommit": {"type": "string", "minLength": 40},
    "claudeCodeVersion": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "providerFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "experimentGroup": {"type": "string", "minLength": 1},
    "toolTransport": {"type": "string", "minLength": 1},
    "mcpTransport": {"type": "string", "minLength": 1},
    "ckbRequired": {"const": true},
    "localDocsPolicy": {"enum": ["disabled", "isolated"]},
    "modelEffort": {"type": "string"},
    "modelBudget": {"type": "string"},
    "timeoutSeconds": {"type": "integer", "minimum": 0},
    "transportRetryBudget": {"type": "integer", "minimum": 0},
    "promptHash": {"type": "string"},
    "resultsHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runCriticalTreeHash": {"type": "string"},
    "totalCases": {"const": 164},
    "rawPassed": {"type": "integer", "minimum": 0, "maximum": 164},
    "strictPassed": {"type": "integer", "minimum": 0, "maximum": 164},
    "strictFailed": {"type": "integer", "minimum": 0, "maximum": 164},
    "businessFailed": {"type": "integer", "minimum": 0, "maximum": 164},
    "protocolInvalid": {"type": "integer", "minimum": 0, "maximum": 164},
    "transportUnresolved": {"const": 0},
    "missingEvidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
