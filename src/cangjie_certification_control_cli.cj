package cangjie_community_knowledge_base

import std.collection.{ArrayList, HashSet}
import std.fs.{File, Path, exists, rename}
import stdx.encoding.json.*

// File-only control plane for the P6 seal.  The manifest contains paths and
// public hashes only; credentials are neither accepted nor persisted.
public class CkbCertificationControlManifestParse{public var ok=false;public var diagnostic="not_parsed";public var raw="";public var kind="";public init(){}}

public func parseCkbCertificationControlManifest(bytes:Array<UInt8>):CkbCertificationControlManifestParse{
    let parsed=CkbCertificationControlManifestParse();let raw=try{String.fromUtf8(bytes)}catch(_:Exception){parsed.diagnostic="invalid_response_encoding";return parsed};parsed.raw=raw
    if(ckbControlContainsSecret(raw)){parsed.diagnostic="secret_artifact_forbidden";return parsed}
    try{let root=JsonValue.fromStr(raw).asObject();let manifestExpected=HashSet<String>([
        "runId","outputRoot","workspaceRoot","runtimeHomeRoot","frozenVersion","activeStatusStartPath","activeStatusEndPath",
        "modelVersion","claudeCodeVersion","certificationTransport","transportRetryBudget","modelTimeoutSeconds","certificationBinaryPath",
        "certificationConfigPath","certificationStorePath","certificationRunRoot","ckbHttpBase","authorityManifestPath","datasetVersion",
        "authorityManifestHash","developmentClosurePath","knowledgeGatePath","releaseGatePath","filesystemProbePath","providerIdentityPath",
        "parityRestPath","parityStdioPath","parityHttpPath","knowledgeContentHash","studentLeakageProofPath","frozenCandidateManifestPath",
        "promptHash","toolConfigHash","runtimeConfigHash","skillBundlePath","skillBundleVersion","skillBundleHash","samplingCapabilityPath",
        "samplingCapabilityHash","generationProtocol","samplesPerCase","outputSchemaHash"]);let inputExpected=HashSet<String>([
        "runId","outputRoot","workspaceRoot","runtimeHomeRoot","frozenVersion","activeStatusStartPath","activeStatusEndPath",
        "modelVersion","claudeCodeVersion","certificationTransport","transportRetryBudget","modelTimeoutSeconds","certificationBinaryPath",
        "certificationConfigPath","certificationStorePath","certificationRunRoot","ckbHttpBase","authorityManifestPath","datasetVersion",
        "developmentClosurePath","knowledgeGatePath","releaseGatePath","filesystemProbePath","providerIdentityPath","parityRestPath",
        "parityStdioPath","parityHttpPath","studentLeakageProofPath","frozenCandidateManifestPath","systemPromptPath","skillBundlePath",
        "skillBundleVersion","samplingCapabilityPath","generationProtocol","samplesPerCase"]);let inputMode=match(root.get("systemPromptPath")){case Some(_)=>true;case None=>false};let expected=if(inputMode){parsed.kind="input";inputExpected}else{parsed.kind="manifest";manifestExpected}
        let keys=ckbControlTopLevelKeys(raw);let seen=HashSet<String>();for(key in keys){if(seen.contains(key)){parsed.diagnostic="control_manifest_duplicate_field:${key}";return parsed};seen.add(key);if(!expected.contains(key)){parsed.diagnostic="control_manifest_unknown_field:${key}";return parsed}};for(key in expected){if(!seen.contains(key)){parsed.diagnostic="control_manifest_missing_field:${key}";return parsed}}
        if(root.getFields().size!=expected.size){parsed.diagnostic="control_manifest_schema_fields_invalid";return parsed}
        for(key in expected){if(key!="transportRetryBudget"&&key!="modelTimeoutSeconds"&&key!="samplesPerCase"&&ckbControlString(root,key).trimAscii()==""){parsed.diagnostic="control_manifest_required_field:${key}";return parsed}}
        if(ckbControlString(root,"generationProtocol")!="completion-only-v1"||ckbControlInt(root,"samplesPerCase")!=1){parsed.diagnostic="completion_generation_contract_invalid";return parsed};parsed.ok=true;parsed.diagnostic="ok";parsed
    }catch(_:Exception){parsed.diagnostic="control_manifest_malformed_json";parsed}
}
public func validateCkbCertificationControlManifest(parsed:CkbCertificationControlManifestParse):String{if(parsed.ok){"ok"}else{parsed.diagnostic}}
public func validateCkbCertificationControlManifest(bytes:Array<UInt8>):String{validateCkbCertificationControlManifest(parseCkbCertificationControlManifest(bytes))}

public func runCkbCertificationPreflightCli(args: Array<String>,store!:FileKnowledgeStore=FileKnowledgeStore("target/ckb-preflight-default")): Int64 {
    let filtered=ArrayList<String>();var json=false;for(a in args){if(a=="--json"){if(json){println("usage error: duplicate_argument:--json");return 2};json=true}else{filtered.add(a)}};let usage=ckbCertificationPreflightCliArgs(filtered.toArray())
    if(usage[0]!="ok"){println("usage error: ${usage[0]}");return 2}
    let path=usage[1];if(!exists(Path(path))){println("preflight blocked: control_manifest_missing");return 1}
    try {
        let controlBytes=File.readFrom(Path(path));let parsedControl=parseCkbCertificationControlManifest(controlBytes);let controlDiagnostic=validateCkbCertificationControlManifest(parsedControl);if(controlDiagnostic!="ok"||parsedControl.kind!="manifest"){println("preflight blocked: ${if(controlDiagnostic!="ok"){controlDiagnostic}else{"sealed_control_manifest_required"}}");return 1}
        let root=JsonValue.fromStr(String.fromUtf8(controlBytes)).asObject()
        let options=CkbCertificationPreflightOptions();let fp=CkbFrozenFingerprintInput()
        options.runId=ckbControlString(root,"runId");options.outputRoot=ckbControlString(root,"outputRoot");options.workspaceRoot=ckbControlString(root,"workspaceRoot");options.runtimeHomeRoot=ckbControlString(root,"runtimeHomeRoot")
        options.frozenVersion=ckbControlString(root,"frozenVersion");options.datasetVersion=ckbControlString(root,"datasetVersion");options.activeVersionAtStart=ckbControlActiveVersion(ckbControlRead(ckbControlString(root,"activeStatusStartPath")));options.activeVersionAtEnd=ckbControlActiveVersion(ckbControlRead(ckbControlString(root,"activeStatusEndPath")));options.modelVersion=ckbControlString(root,"modelVersion");options.claudeCodeVersion=ckbControlString(root,"claudeCodeVersion");options.certificationTransport=ckbControlString(root,"certificationTransport")
        options.budget.transportRetries=ckbControlInt(root,"transportRetryBudget");options.modelTimeoutSeconds=ckbControlInt(root,"modelTimeoutSeconds")
        options.certificationBinaryPath=ckbControlString(root,"certificationBinaryPath");options.certificationConfigPath=ckbControlString(root,"certificationConfigPath");options.certificationStorePath=ckbControlString(root,"certificationStorePath");options.certificationRunRoot=ckbControlString(root,"certificationRunRoot");options.certificationHttpBase=ckbControlString(root,"ckbHttpBase")
        let authority=ckbControlRead(ckbControlString(root,"authorityManifestPath"));let parsedAuthority=parseCangjieHumanEvalAuthorityManifest(authority);if(!parsedAuthority.ok||parsedAuthority.rows.size!=164){println("preflight blocked: authority_manifest_invalid");return 1};let declaredDatasetVersion=ckbControlString(root,"datasetVersion");if(cangjieHumanEvalAuthorityDatasetDiagnostic(parsedAuthority,declaredDatasetVersion)!="ok"){println("preflight blocked: authority_dataset_version_mismatch");return 1};options.actualManifestHash=benchmarkGapSha256(authority);options.expectedManifestHash=ckbControlString(root,"authorityManifestHash")
        options.developmentClosureJson=ckbControlRead(ckbControlString(root,"developmentClosurePath"));options.knowledgeGateJson=ckbControlRead(ckbControlString(root,"knowledgeGatePath"));options.releaseGateJson=ckbControlRead(ckbControlString(root,"releaseGatePath"));options.filesystemProbeJson=ckbControlRead(ckbControlString(root,"filesystemProbePath"));options.providerIdentityJson=ckbControlRead(ckbControlString(root,"providerIdentityPath"));options.providerIdentityHash=benchmarkGapSha256(options.providerIdentityJson)
        options.parityRestPayload=ckbControlRead(ckbControlString(root,"parityRestPath"));options.parityStdioPayload=ckbControlRead(ckbControlString(root,"parityStdioPath"));options.parityHttpPayload=ckbControlRead(ckbControlString(root,"parityHttpPath"));options.parityEvidenceHash=benchmarkGapSha256(options.parityRestPayload)
        options.candidateChecksum=ckbControlString(root,"knowledgeContentHash");options.studentLeakageProofJson=ckbControlRead(ckbControlString(root,"studentLeakageProofPath"));options.studentLeakageProofHash=benchmarkGapSha256(options.studentLeakageProofJson);options.frozenCandidateManifestJson=ckbControlRead(ckbControlString(root,"frozenCandidateManifestPath"));options.frozenCandidateManifestHash=benchmarkGapSha256(options.frozenCandidateManifestJson);if(ckbFrozenCandidateManifestDiagnostic(store,options.frozenCandidateManifestJson)!="ok"){println("preflight blocked: frozen_candidate_manifest_drift");return 1}
        options.skillBundlePath=ckbControlString(root,"skillBundlePath");options.skillBundleVersion=ckbControlString(root,"skillBundleVersion");options.skillBundleHash=ckbControlString(root,"skillBundleHash");options.samplingCapabilityPath=ckbControlString(root,"samplingCapabilityPath");options.samplingCapabilityHash=ckbControlString(root,"samplingCapabilityHash");options.generationProtocol=ckbControlString(root,"generationProtocol");options.samplesPerCase=ckbControlInt(root,"samplesPerCase");options.outputSchemaHash=ckbControlString(root,"outputSchemaHash")
        fp.knowledgeVersion=options.frozenVersion;fp.knowledgeContentHash=options.candidateChecksum;fp.datasetVersion=declaredDatasetVersion;fp.manifestHash=options.actualManifestHash;fp.modelVersion=options.modelVersion;fp.claudeCodeVersion=options.claudeCodeVersion;fp.promptHash=ckbControlString(root,"promptHash");fp.toolConfigHash=ckbControlString(root,"toolConfigHash");fp.providerIdentityHash=options.providerIdentityHash;fp.certificationTransport=options.certificationTransport;fp.runtimeConfigHash=ckbControlString(root,"runtimeConfigHash");fp.candidateChecksum=options.candidateChecksum;fp.studentLeakageProofHash=options.studentLeakageProofHash;fp.frozenCandidateManifestHash=options.frozenCandidateManifestHash;fp.skillBundleVersion=options.skillBundleVersion;fp.skillBundleHash=options.skillBundleHash;fp.samplingCapabilityHash=options.samplingCapabilityHash;fp.generationProtocol=options.generationProtocol;fp.outputSchemaHash=options.outputSchemaHash
        for(raw in [options.developmentClosureJson,options.knowledgeGateJson,options.releaseGateJson,options.filesystemProbeJson,options.providerIdentityJson,options.parityRestPayload,options.parityStdioPayload,options.parityHttpPayload,options.studentLeakageProofJson,options.frozenCandidateManifestJson]){if(ckbControlContainsSecret(raw)){println("preflight blocked: secret_artifact_forbidden");return 1}}
        let report=runCertificationPreflight(options,fp);if(report.ok){if(json){println("{\"ok\":true,\"preflightPath\":\"${ckbControlEscape(options.outputRoot)}/preflight.json\",\"runManifestPath\":\"${ckbControlEscape(report.runManifestPath)}\"}")}else{println("preflight complete: preflightPath=${options.outputRoot}/preflight.json runManifestPath=${report.runManifestPath}")}}else{if(json){println("{\"ok\":false,\"diagnostic\":\"${ckbControlEscape(report.diagnostic)}\"}")}else{println("preflight blocked: ${report.diagnostic}")}};return if(report.ok){0}else{1}
    } catch(_:Exception){println("preflight blocked: malformed_or_unreadable_artifact");1}
}

public func sealCkbCertificationControlManifest(parsed:CkbCertificationControlManifestParse):String{
    if(!parsed.ok||parsed.kind!="input"){return ""};try{let o=JsonValue.fromStr(parsed.raw).asObject();let bundle=parseStudentSkillBundle(File.readFrom(Path(ckbControlString(o,"skillBundlePath"))));if(validateStudentSkillBundle(bundle)!="ok"||bundle.bundleVersion!=ckbControlString(o,"skillBundleVersion")){return ""};let sampling=ckbControlRead(ckbControlString(o,"samplingCapabilityPath"));let authority=ckbControlRead(ckbControlString(o,"authorityManifestPath"));let config=ckbControlRead(ckbControlString(o,"certificationConfigPath"));let systemPrompt=ckbControlRead(ckbControlString(o,"systemPromptPath"));let frozen=JsonValue.fromStr(ckbControlRead(ckbControlString(o,"frozenCandidateManifestPath"))).asObject();let candidateChecksum=ckbControlString(frozen,"candidateChecksum");if(candidateChecksum==""){return ""};let toolHash=benchmarkGapSha256(ckbControlString(o,"generationProtocol")+"|${ckbControlInt(o,"samplesPerCase")}|"+ckbControlString(o,"certificationTransport"));ckbControlRenderSealed(o,benchmarkGapSha256(authority),candidateChecksum,benchmarkGapSha256(systemPrompt),toolHash,benchmarkGapSha256(config),bundle.canonicalHash,benchmarkGapSha256(sampling),benchmarkGapSha256(ckbAbcdeCompletionOutputSchema()))+"\n"}catch(_:Exception){""}
}

public func runCkbCertificationControlSealCli(args:Array<String>,store!:FileKnowledgeStore=FileKnowledgeStore("target/ckb-preflight-default")):Int64{
    let usage=ckbCertificationControlSealCliArgs(args);if(usage[0]!="ok"){println("usage error: ${usage[0]}");return 2};if(!exists(Path(usage[1]))){println("control seal blocked: control_input_missing");return 1};try{let parsed=parseCkbCertificationControlManifest(File.readFrom(Path(usage[1])));if(!parsed.ok){println("control seal blocked: ${parsed.diagnostic}");return 1};let sealed=sealCkbCertificationControlManifest(parsed);if(sealed==""){println("control seal blocked: artifact_binding_invalid");return 1};let output=Path(usage[2]);if(exists(output)){let existing=String.fromUtf8(File.readFrom(output));if(existing!=sealed){println("control seal blocked: immutable_output_conflict");return 1}}else{let tmp=output.parent.join(".${output.fileName}.tmp-${benchmarkGapSha256(sealed).replace("sha256:","")}");File.writeTo(tmp,sealed.toArray());rename(tmp.toString(),to:output.toString(),overwrite:false)};println("controlManifestSealed=true unknownFieldCount=0 secretFieldCount=0 output=${output}");0}catch(_:Exception){println("control seal blocked: malformed_or_unreadable_artifact");1}
}

public func ckbCertificationPreflightCliArgs(args:Array<String>):(String,String){
    ckbControlArgs(args,"cangjie-certification-preflight",["--control-manifest"])
}
public func ckbCertificationControlSealCliArgs(args:Array<String>):(String,String,String){let seen=HashSet<String>();var command=false;var input="";var output="";var i:Int64=0;while(i<args.size){let a=args[i];if(a=="cangjie-certification-control-seal"&&!command){command=true;i+=1;continue};if(a!="--input"&&a!="--output"&&a!="--store"){return("unknown_argument:${a}","","")};if(seen.contains(a)){return("duplicate_argument:${a}","","")};if(i+1>=args.size||args[i+1].startsWith("--")){return("missing_argument_value:${a}","","")};seen.add(a);if(a=="--input"){input=args[i+1]}else if(a=="--output"){output=args[i+1]};i+=2};if(!command){return("command_required","","")};if(input==""){return("required_argument_missing:--input","","")};if(output==""){return("required_argument_missing:--output","","")};("ok",input,output)}

private func ckbControlArgs(args:Array<String>,command:String,required:Array<String>):(String,String){let seen=HashSet<String>();var commandSeen=false;var value="";var i:Int64=0;while(i<args.size){let a=args[i];if(a==command&&!commandSeen){commandSeen=true;i+=1;continue};var known=a=="--store";for(k in required){if(a==k){known=true}};if(!known){return("unknown_argument:${a}","")};if(seen.contains(a)){return("duplicate_argument:${a}","")};if(i+1>=args.size||args[i+1].startsWith("--")){return("missing_argument_value:${a}","")};seen.add(a);if(a!="--store"){value=args[i+1]};i+=2};if(!commandSeen){return("command_required","")};for(k in required){if(!seen.contains(k)){return("required_argument_missing:${k}","")}};("ok",value)}
private func ckbControlRead(path:String):String{String.fromUtf8(File.readFrom(Path(path)))}
private func ckbControlString(o:JsonObject,k:String):String{o.get(k).getOrThrow().asString().getValue()}
private func ckbControlInt(o:JsonObject,k:String):Int64{o.get(k).getOrThrow().asInt().getValue()}
private func ckbControlBool(o:JsonObject,k:String):Bool{o.get(k).getOrThrow().asBool().getValue()}
private func ckbControlRenderSealed(o:JsonObject,authorityHash:String,contentHash:String,promptHash:String,toolHash:String,runtimeHash:String,bundleHash:String,samplingHash:String,schemaHash:String):String{
    "{\"runId\":\"${ckbControlEscape(ckbControlString(o,"runId"))}\",\"outputRoot\":\"${ckbControlEscape(ckbControlString(o,"outputRoot"))}\",\"workspaceRoot\":\"${ckbControlEscape(ckbControlString(o,"workspaceRoot"))}\",\"runtimeHomeRoot\":\"${ckbControlEscape(ckbControlString(o,"runtimeHomeRoot"))}\",\"frozenVersion\":\"${ckbControlEscape(ckbControlString(o,"frozenVersion"))}\",\"activeStatusStartPath\":\"${ckbControlEscape(ckbControlString(o,"activeStatusStartPath"))}\",\"activeStatusEndPath\":\"${ckbControlEscape(ckbControlString(o,"activeStatusEndPath"))}\",\"modelVersion\":\"${ckbControlEscape(ckbControlString(o,"modelVersion"))}\",\"claudeCodeVersion\":\"${ckbControlEscape(ckbControlString(o,"claudeCodeVersion"))}\",\"certificationTransport\":\"${ckbControlEscape(ckbControlString(o,"certificationTransport"))}\",\"transportRetryBudget\":${ckbControlInt(o,"transportRetryBudget")},\"modelTimeoutSeconds\":${ckbControlInt(o,"modelTimeoutSeconds")},\"certificationBinaryPath\":\"${ckbControlEscape(ckbControlString(o,"certificationBinaryPath"))}\",\"certificationConfigPath\":\"${ckbControlEscape(ckbControlString(o,"certificationConfigPath"))}\",\"certificationStorePath\":\"${ckbControlEscape(ckbControlString(o,"certificationStorePath"))}\",\"certificationRunRoot\":\"${ckbControlEscape(ckbControlString(o,"certificationRunRoot"))}\",\"ckbHttpBase\":\"${ckbControlEscape(ckbControlString(o,"ckbHttpBase"))}\",\"authorityManifestPath\":\"${ckbControlEscape(ckbControlString(o,"authorityManifestPath"))}\",\"datasetVersion\":\"${ckbControlEscape(ckbControlString(o,"datasetVersion"))}\",\"authorityManifestHash\":\"${authorityHash}\",\"developmentClosurePath\":\"${ckbControlEscape(ckbControlString(o,"developmentClosurePath"))}\",\"knowledgeGatePath\":\"${ckbControlEscape(ckbControlString(o,"knowledgeGatePath"))}\",\"releaseGatePath\":\"${ckbControlEscape(ckbControlString(o,"releaseGatePath"))}\",\"filesystemProbePath\":\"${ckbControlEscape(ckbControlString(o,"filesystemProbePath"))}\",\"providerIdentityPath\":\"${ckbControlEscape(ckbControlString(o,"providerIdentityPath"))}\",\"parityRestPath\":\"${ckbControlEscape(ckbControlString(o,"parityRestPath"))}\",\"parityStdioPath\":\"${ckbControlEscape(ckbControlString(o,"parityStdioPath"))}\",\"parityHttpPath\":\"${ckbControlEscape(ckbControlString(o,"parityHttpPath"))}\",\"knowledgeContentHash\":\"${contentHash}\",\"studentLeakageProofPath\":\"${ckbControlEscape(ckbControlString(o,"studentLeakageProofPath"))}\",\"frozenCandidateManifestPath\":\"${ckbControlEscape(ckbControlString(o,"frozenCandidateManifestPath"))}\",\"promptHash\":\"${promptHash}\",\"toolConfigHash\":\"${toolHash}\",\"runtimeConfigHash\":\"${runtimeHash}\",\"skillBundlePath\":\"${ckbControlEscape(ckbControlString(o,"skillBundlePath"))}\",\"skillBundleVersion\":\"${ckbControlEscape(ckbControlString(o,"skillBundleVersion"))}\",\"skillBundleHash\":\"${bundleHash}\",\"samplingCapabilityPath\":\"${ckbControlEscape(ckbControlString(o,"samplingCapabilityPath"))}\",\"samplingCapabilityHash\":\"${samplingHash}\",\"generationProtocol\":\"${ckbControlEscape(ckbControlString(o,"generationProtocol"))}\",\"samplesPerCase\":${ckbControlInt(o,"samplesPerCase")},\"outputSchemaHash\":\"${schemaHash}\"}"
}
private func ckbControlEscape(v:String):String{v.replace("\\","\\\\").replace("\"","\\\"").replace("\n","\\n").replace("\r","\\r").replace("\t","\\t")}
private func ckbControlTopLevelKeys(raw:String):ArrayList<String>{
    let out=ArrayList<String>();let runes=raw.toRuneArray();var depth:Int64=0;var i:Int64=0
    while(i<runes.size){let rune=runes[i];if(rune==r'{'){depth+=1;i+=1;continue};if(rune==r'}'){depth-=1;i+=1;continue};if(depth==1&&rune==r'"'){let key=StringBuilder();i+=1;var escaped=false;while(i<runes.size){let current=runes[i];if(escaped){key.append(current);escaped=false;i+=1;continue};if(current==r'\\'){escaped=true;i+=1;continue};if(current==r'"'){break};key.append(current);i+=1};if(i>=runes.size){return out};i+=1;var look=i;while(look<runes.size&&(runes[look]==r' '||runes[look]==r'\n'||runes[look]==r'\r'||runes[look]==r'\t')){look+=1};if(look<runes.size&&runes[look]==r':'){out.add(key.toString())};continue};i+=1};out
}
public func ckbControlContainsSecret(raw:String):Bool{let v=raw.toAsciiLower();for(k in ["\"token\"","\"api_key\"","\"apikey\"","\"authorization\"","\"password\"","\"secret\"","bearer "]){if(v.contains(k)){return true}};false}
private func ckbControlActiveVersion(raw:String):String{try{return ckbControlString(JsonValue.fromStr(raw).asObject(),"activeKnowledgeVersion")}catch(_:Exception){};for(line in raw.split("\n")){if(line.startsWith("activeKnowledgeVersion=")){let parts=line.split("=");if(parts.size==2){return parts[1].trimAscii()}};if(line.startsWith("active=")){let parts=line.split("=");if(parts.size==2){return parts[1].trimAscii()}}};""}
