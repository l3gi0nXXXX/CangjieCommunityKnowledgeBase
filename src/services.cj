    var out = "routine repair ok=${result.ok} force=${result.force} repairPerformed=${result.repairPerformed} diagnostics=${joinStrings(result.diagnostics, ",")}\n"
    out += renderCkbVectorReconcileText(result.vectorReconcile)
    out += renderCkbRoutineRuntimePreflightText(result.preflight)
    out
}

public func ckbCleanDerivedVectorArtifacts(config: CkbRuntimeConfig, store: FileKnowledgeStore, force: Bool): CkbDerivedVectorCleanupResult {
    let vector = vectorStoreConfigFromRuntime(config)
    store.deleteAllDerivedVectorArtifacts(vector.activeCollection, vector.candidateCollection, force: force)
}

public func ckbVectorReconcile(kb: KnowledgeBase, store: FileKnowledgeStore, config: CkbRuntimeConfig, force: Bool): CkbVectorReconcileResult {
    ckbVectorReconcileWithVectorStore(kb, store, config, vectorStoreFromRuntime(config), force)
}

public func ckbRoutineRepair(kb: KnowledgeBase, store: FileKnowledgeStore, config: CkbRuntimeConfig, storePath: String, force: Bool): CkbRoutineRepairResult {
    ckbRoutineRepairWithStores(kb, store, config, storePath, force, vectorStoreFromRuntime(config), embeddingProviderFromRuntime(config))
}

public func ckbRoutineRepairWithStores(kb: KnowledgeBase, store: FileKnowledgeStore, config: CkbRuntimeConfig, storePath: String, force: Bool, vectorStore: VectorStore, embeddingProvider: EmbeddingProvider): CkbRoutineRepairResult {
    let heap = if (let Some(value) <- getVariable("cjHeapSize")) { value } else { "" }
    let dyld = if (let Some(value) <- getVariable("DYLD_LIBRARY_PATH")) { value } else { "" }
    ckbRoutineRepairWithStoresAndEnv(kb, store, config, storePath, force, vectorStore, embeddingProvider, heap, dyld)
}

public func ckbRoutineRepairWithStoresAndEnv(kb: KnowledgeBase, store: FileKnowledgeStore, config: CkbRuntimeConfig, storePath: String, force: Bool, vectorStore: VectorStore, embeddingProvider: EmbeddingProvider, cjHeapSize: String, dyldLibraryPath: String, deadlineAtMillis!: Int64 = 0): CkbRoutineRepairResult {
    let result = CkbRoutineRepairResult()
    result.force = force
    if (!force) {
        result.ok = false
        result.diagnostics.add("routine_repair_requires_force")
        result.preflight = ckbRoutineRuntimePreflightWithBootstrap(config, storePath, cjHeapSize, dyldLibraryPath, vectorStore, embeddingProvider)
        return result
    }
    result.vectorReconcile = ckbVectorReconcileWithVectorStore(kb, store, config, vectorStore, true, deadlineAtMillis: deadlineAtMillis)
    result.repairPerformed = result.vectorReconcile.ok
    if (!result.vectorReconcile.ok) {
        result.ok = false
        result.diagnostics.add("vector_reconcile_failed")
        result.preflight = ckbRoutineRuntimePreflightWithBootstrap(config, storePath, cjHeapSize, dyldLibraryPath, vectorStore, embeddingProvider)
        return result
    }
    result.preflight = ckbRoutineRuntimePreflightWithBootstrap(config, storePath, cjHeapSize, dyldLibraryPath, vectorStore, embeddingProvider)
    result.ok = result.preflight.ok
    if (!result.preflight.ok) {
        result.diagnostics.add("post_repair_preflight_failed")
    } else {
        result.diagnostics.add("routine_repair_succeeded")
    }
    result
}

public func ckbRoutineRepairWorkerTimeoutResult(force: Bool, timeoutMillis: Int64, diagnostic: String, workerPid!: Int64 = 0, outSnippet!: String = "", errSnippet!: String = ""): CkbRoutineRepairResult {
    let result = CkbRoutineRepairResult()
    result.ok = false
    result.force = force
    result.repairPerformed = false
    result.diagnostics.add(diagnostic)
    if (workerPid > 0) {
        result.diagnostics.add("worker_pid:${workerPid}")
    }
    let combined = "${outSnippet} ${errSnippet}".toAsciiLower()
    if (combined.contains("out of memory") || combined.contains("outofmemory") || combined.contains("oom")) {
        result.diagnostics.add("worker_out_of_memory")
    }
    if (outSnippet.trimAscii() != "") {
        result.diagnostics.add("worker_out:${utf8SafePrefix(redactSensitive(outSnippet.replace("\n", " ").replace("\r", " ")), 160)}")
    }
    if (errSnippet.trimAscii() != "") {
        result.diagnostics.add("worker_err:${utf8SafePrefix(redactSensitive(errSnippet.replace("\n", " ").replace("\r", " ")), 160)}")
    }
    result
}

public func ckbVectorReconcileWithVectorStore(kb: KnowledgeBase, store: FileKnowledgeStore, config: CkbRuntimeConfig, vectorStore: VectorStore, force: Bool, deadlineAtMillis!: Int64 = 0): CkbVectorReconcileResult {
    let result = CkbVectorReconcileResult()
    result.force = force
    result.dryRun = !force
    let status = kb.status()
    result.activeRecords = status.storage.indexCount
    result.activeKnowledgeVersion = status.activeKnowledgeVersion
    let vector = vectorStoreConfigFromRuntime(config)
    let effective = ckbEffectiveVectorCollections(config, store)
    result.configuredActiveCollection = effective.configuredActiveCollection
    result.effectiveActiveCollection = effective.effectiveActiveCollection
    result.effectiveActiveSource = effective.source
    for (diagnostic in effective.diagnostics) {
        result.diagnostics.add(diagnostic)
    }
    let before = vectorStore.status(effective.effectiveActiveCollection)
    result.qdrantBeforeCount = before.count
    result.vectorState = before.state
    if (before.state == EmbeddingProviderState.DOWN) {
        result.ok = false
        result.diagnostics.add("qdrant_active_not_ready:${effective.effectiveActiveCollection}:${if (before.degradedReason != "") { before.degradedReason } else { before.state }}")
        return result
    }
    let cleanup = store.deleteAllDerivedVectorArtifacts(effective.effectiveActiveCollection, effective.candidateCollection, force: force)
    ckbAppendStrings(result.deletedVectorArtifacts, cleanup.deletedFiles)
    ckbAppendStrings(result.plannedVectorArtifacts, cleanup.plannedFiles)
    ckbAppendStrings(result.diagnostics, cleanup.diagnostics)
    if (!cleanup.ok) {
        result.ok = false
        result.diagnostics.add("derived_vector_cleanup_failed")
        return result
    }
    if (!force) {
        result.diagnostics.add("dry_run")
        return result
    }
    if (ckbVectorReconcileDeadlineExceeded(result, "before_rebuild", deadlineAtMillis)) {
        return result
    }
    if (!ckbVectorReconcilePrepareUniqueBenchmarkGapSnapshot(kb, store, result)) {
        return result
    }
    let stagingCollection = ckbVectorReconcileStagingCollection(effective.effectiveActiveCollection)
    let progressSink = FileVectorBuildProgressSink(store)
    let rebuild = ckbRebuildIndex(kb, store, progressSink: progressSink, targetVectorCollection: stagingCollection, persistSnapshot: false, deadlineAtMillis: deadlineAtMillis)
    result.progressPath = progressSink.currentProgressPath()
    result.rebuiltVectorCount = rebuild.count
    result.activeKnowledgeVersion = rebuild.activeVersion
    if (!rebuild.ok) {
        result.ok = false
        result.diagnostics.add("rebuild_failed:${rebuild.failedVersion}")
        let failedStatus = vectorStore.status(stagingCollection)
        result.qdrantAfterCount = failedStatus.count
        result.vectorState = failedStatus.state
        if (failedStatus.state != EmbeddingProviderState.READY) {
            result.diagnostics.add("vector_store_not_ready:${failedStatus.degradedReason}")
        }
        ckbVectorReconcileDeleteStaging(vectorStore, stagingCollection, result.diagnostics)
        return result
    }
    if (ckbVectorReconcileDeadlineExceeded(result, "after_rebuild", deadlineAtMillis)) {
        ckbVectorReconcileDeleteStaging(vectorStore, stagingCollection, result.diagnostics)
        return result
    }
    let staging = vectorStore.status(stagingCollection)
    result.qdrantAfterCount = staging.count
    result.vectorState = staging.state
    if (staging.state != EmbeddingProviderState.READY) {
        result.ok = false
        result.diagnostics.add("vector_store_not_ready:${staging.degradedReason}")
        ckbVectorReconcileDeleteStaging(vectorStore, stagingCollection, result.diagnostics)
        return result
    }
    if (vector.backend == "qdrant" && staging.count != rebuild.count) {
        result.ok = false
        result.diagnostics.add("qdrant_staging_count_mismatch:${staging.count}:${rebuild.count}")
        let duplicateSummary = ckbActiveIndexDuplicateIdentitySummary(store)
        if (duplicateSummary.duplicateIdCount > 0) {
            result.diagnostics.add("duplicate_vector_ids:${duplicateSummary.duplicateIdCount}:${duplicateSummary.duplicateRows}")
        }
        ckbAppendStrings(result.diagnostics, duplicateSummary.diagnostics)
        ckbVectorReconcileDeleteStaging(vectorStore, stagingCollection, result.diagnostics)
        return result
    }
    if (vector.dimensions > 0 && staging.dimension > 0 && staging.dimension != vector.dimensions) {
        result.ok = false
        result.diagnostics.add("qdrant_staging_dimension_mismatch:${staging.dimension}:${vector.dimensions}")
        ckbVectorReconcileDeleteStaging(vectorStore, stagingCollection, result.diagnostics)
        return result
    }
    if (vector.distance != "" && staging.distance != "" && staging.distance.trimAscii().toAsciiLower() != vector.distance.trimAscii().toAsciiLower()) {
        result.ok = false
        result.diagnostics.add("qdrant_staging_distance_mismatch:${staging.distance}:${vector.distance}")
        ckbVectorReconcileDeleteStaging(vectorStore, stagingCollection, result.diagnostics)
        return result
    }
    if (ckbVectorReconcileDeadlineExceeded(result, "before_promote", deadlineAtMillis)) {
        ckbVectorReconcileDeleteStaging(vectorStore, stagingCollection, result.diagnostics)
        return result
    }
    kb.promoteVectorActiveCollection(stagingCollection)
    kb.persistActiveSnapshotUsingVectorRecords(store, kb.lastVectorIndexBuild().vectorRecords, persistVectorFile: false, deadlineAtMillis: deadlineAtMillis)
    result.activeKnowledgeVersion = kb.status().activeKnowledgeVersion
    result.vectorState = EmbeddingProviderState.READY
    result.diagnostics.add("qdrant_logical_promote_succeeded:${stagingCollection}")
    result
}

private func ckbVectorReconcilePrepareUniqueBenchmarkGapSnapshot(kb: KnowledgeBase, store: FileKnowledgeStore,
    result: CkbVectorReconcileResult): Bool {
    let snapshot = store.loadActiveSnapshot()
    if (!snapshot.valid) {
        if (!store.has("metadata/active-snapshot.manifest")) {
            return true
        }
        result.ok = false
        result.diagnostics.add("active_snapshot_dedup_unavailable:${snapshot.diagnostic}")
        return false
    }
    let empty = ArrayList<NormalizedRecord>()
    let active = overlayBenchmarkGapRecords(snapshot.activeIndex, empty)
    let normalized = overlayBenchmarkGapRecords(snapshot.normalizedRecords, empty)
    if (!ckbBenchmarkGapOverlayChanged(snapshot.activeIndex, active) &&
        !ckbBenchmarkGapOverlayChanged(snapshot.normalizedRecords, normalized)) {
        return true
    }
    let raw = ckbBenchmarkGapCandidateRawOverlay(snapshot.rawRecords, empty)
    let removed = snapshot.activeIndex.size - active.size
    let migrated = ckbBenchmarkGapMigratedIdentityCount(snapshot.activeIndex, active)
    snapshot.activeIndex.clear(); for (record in active) { snapshot.activeIndex.add(record) }
    snapshot.normalizedRecords.clear(); for (record in normalized) { snapshot.normalizedRecords.add(record) }
    snapshot.rawRecords.clear(); for (record in raw) { snapshot.rawRecords.add(record) }
    snapshot.vectorRecords.clear(); snapshot.hasVectorArtifact = false
    if (!kb.restoreActiveSnapshot(snapshot)) {
        result.ok = false
        result.diagnostics.add("active_snapshot_dedup_restore_failed")
        return false
    }
    result.activeRecords = active.size
    if (removed > 0) { result.diagnostics.add("benchmark_gap_exact_duplicates_removed:${removed}") }
    if (migrated > 0) { result.diagnostics.add("benchmark_gap_legacy_identities_migrated:${migrated}") }
    true
}

private func ckbBenchmarkGapOverlayChanged(before: ArrayList<NormalizedRecord>, after: ArrayList<NormalizedRecord>): Bool {
    if (before.size != after.size) { return true }
    for (index in 0..before.size) {
        if (before[index].sourceId != after[index].sourceId) { return true }
    }
    false
}

private func ckbBenchmarkGapMigratedIdentityCount(before: ArrayList<NormalizedRecord>, after: ArrayList<NormalizedRecord>): Int64 {
    let migrated = HashSet<String>()
    for (record in before) {
        if (record.sourceId.startsWith("curated-gap-h")) {
            migrated.add(benchmarkGapLegacyPersistentSourceId(record.metadata.path, record.metadata.symbol,
                record.metadata.targetVersion, record.metadata.docVersion, record.title, record.chunk))
        }
    }
    var count: Int64 = 0
    for (record in after) {
        if (migrated.contains(record.sourceId)) { count += 1 }
    }
    count
}

private func ckbVectorReconcileDeadlineExceeded(result: CkbVectorReconcileResult, stage: String, deadlineAtMillis: Int64): Bool {
    let deadline = ckbDeadlineGuard("vector_reconcile_${stage}", deadlineAtMillis)
    if (!deadline.exceeded) {
        return false
    }
    result.ok = false
    result.vectorState = "deadline_exceeded"
    result.diagnostics.add("deadline_exceeded:${stage}:deadlineAtMillis=${deadlineAtMillis}:nowMillis=${deadline.nowMillis}")
    true
}

private func ckbActiveIndexDuplicateIdentitySummary(store: FileKnowledgeStore): CkbDuplicateVectorIdentitySummary {
    let summary = CkbDuplicateVectorIdentitySummary()
    let snapshot = store.loadActiveSnapshot()
    if (!snapshot.valid) {
        summary.diagnostics.add("duplicate_vector_summary_unavailable:${snapshot.diagnostic}")
        return summary
    }
    let ids = ArrayList<String>()
    let counts = ArrayList<Int64>()
    for (record in snapshot.activeIndex) {
        let id = record.sourceId
        if (id == "") {
            continue
        }
        var found: Int64 = -1
        var i: Int64 = 0
        while (i < ids.size) {
            if (ids[i] == id) {
                found = i
                break
            }
            i += 1
        }
        if (found >= 0) {
            counts[found] = counts[found] + 1
        } else {
            ids.add(id)
            counts.add(1)
        }
    }
    for (count in counts) {
        if (count > 1) {
            summary.duplicateIdCount += 1
            summary.duplicateRows += count - 1
        }
    }
    let selected = ArrayList<Int64>()
    while (selected.size < 10 && selected.size < ids.size) {
        var bestIndex: Int64 = -1
        var bestCount: Int64 = 1
        var i: Int64 = 0
        while (i < ids.size) {
            if (!ckbInt64ListContains(selected, i) && counts[i] > bestCount) {
                bestIndex = i
                bestCount = counts[i]
            }
            i += 1
        }
        if (bestIndex < 0) {
            break
        }
        selected.add(bestIndex)
        summary.diagnostics.add("duplicate_vector_id:${ids[bestIndex]}:${counts[bestIndex]}")
    }
    summary
}

private func ckbInt64ListContains(values: ArrayList<Int64>, target: Int64): Bool {
    for (value in values) {
        if (value == target) {
            return true
        }
    }
    false
}

private func ckbVectorReconcileStagingCollection(activeCollection: String): String {
    let base = if (activeCollection.trimAscii() == "") { "active" } else { activeCollection.trimAscii() }
    "${safeName(base)}_reconcile_${DateTime.now().toUnixTimeStamp().toMilliseconds()}"
}

private func ckbVectorReconcileDeleteStaging(vectorStore: VectorStore, stagingCollection: String, diagnostics: ArrayList<String>): Unit {
    let deleted = vectorStore.deleteCollection(stagingCollection)
    if (deleted.state == EmbeddingProviderState.READY) {
        diagnostics.add("qdrant_staging_deleted:${stagingCollection}")
    } else {
        diagnostics.add("qdrant_staging_delete_failed:${deleted.degradedReason}")
    }
}

private func ckbDeleteStagingBestEffort(vectorStore: VectorStore, stagingCollection: String): Unit {
    let diagnostics = ArrayList<String>()
    ckbVectorReconcileDeleteStaging(vectorStore, stagingCollection, diagnostics)
}

private func ckbDeleteKnowledgeBaseStagingBestEffort(kb: KnowledgeBase, stagingCollection: String): Unit {
    _ = kb.deleteVectorCollection(stagingCollection)
}

private func ckbAppendStrings(target: ArrayList<String>, source: ArrayList<String>): Unit {
    for (item in source) {
        target.add(item)
    }
}

public func ckbRuntimeEmbeddingReadiness(config: CkbRuntimeConfig): CkbRuntimeEmbeddingReadiness {
    ckbRuntimeEmbeddingReadinessWithProvider(config, embeddingProviderFromRuntime(config))
}

public func ckbRuntimeEmbeddingReadinessWithProvider(config: CkbRuntimeConfig, provider: EmbeddingProvider): CkbRuntimeEmbeddingReadiness {
    let result = CkbRuntimeEmbeddingReadiness()
    let embedding = embeddingConfigFromRuntime(config)
    result.provider = embedding.provider
    result.model = embedding.model
    result.dimensions = embedding.dimensions
    if (embedding.provider == "" || embedding.provider == "none") {
        result.ready = false
        result.state = "missing"
        result.reason = "embedding_provider_missing"
        return result
    }
    let status = provider.status()
    result.provider = status.provider
    result.model = if (status.model != "") { status.model } else { embedding.model }
    result.dimensions = if (status.dimensions > 0) { status.dimensions } else { embedding.dimensions }
    if (status.state != EmbeddingProviderState.READY) {
        result.ready = false
        result.state = status.state
        result.reason = if (status.degradedReason != "") { status.degradedReason } else { "embedding_provider_not_ready" }
        return result
    }
    let smoke = ArrayList<String>()
    smoke.add("CKB embedding readiness smoke 仓颉")
    let batch = provider.embed(smoke, result.model, result.dimensions)
    if (batch.status.state != EmbeddingProviderState.READY) {
        result.ready = false
        result.state = batch.status.state
        result.reason = if (batch.status.degradedReason != "") { batch.status.degradedReason } else { "embedding_smoke_failed" }
        return result
    }
    if (batch.vectors.size != 1 || batch.vectors[0].size != result.dimensions) {
        result.ready = false
        result.state = EmbeddingProviderState.DEGRADED
        result.reason = "embedding_smoke_dimension_mismatch:${batch.vectors.size}:${if (batch.vectors.size > 0) { batch.vectors[0].size } else { 0 }}:${result.dimensions}"
        return result
    }
    result.state = EmbeddingProviderState.READY
    result.reason = ""
    result
}

public class CkbOllamaEmbeddingBenchmarkResult {
    public var ok: Bool = false
    public var status: String = "not_started"
    public var sampleSize: Int64 = 0
    public var totalBytes: Int64 = 0
    public var p50Bytes: Int64 = 0
    public var p95Bytes: Int64 = 0
    public var p99Bytes: Int64 = 0
    public var maxBytes: Int64 = 0
    public var measuredBatchItems: Int64 = 0
    public var measuredBatchBytes: Int64 = 0
    public var measuredLatencyMillis: Int64 = 0
    public var maxBatchItems: Int64 = 0
    public var maxBatchBytes: Int64 = 0
    public var maxTextBytes: Int64 = 0
    public var diagnostic: String = ""

    public init() {}
}

public func ckbRunOllamaEmbeddingBenchmark(kb: KnowledgeBase, config: CkbRuntimeConfig, sampleSize: Int64): CkbOllamaEmbeddingBenchmarkResult {
    let result = CkbOllamaEmbeddingBenchmarkResult()
    let limit = if (sampleSize <= 0) { 64 } else { sampleSize }
    let texts = kb.activeEmbeddingTextSnapshot(limit: limit)
    result.sampleSize = texts.size
    if (texts.size == 0) {
        result.status = "empty_active_index"
        result.diagnostic = "empty_active_index"
        return result
    }
    let lengths = ArrayList<Int64>()
    for (text in texts) {
        lengths.add(text.size)
        result.totalBytes += text.size
        if (text.size > result.maxBytes) {
            result.maxBytes = text.size
        }
    }
    ckbSortInt64(lengths)
    result.p50Bytes = ckbPercentileInt64(lengths, 50)
    result.p95Bytes = ckbPercentileInt64(lengths, 95)
    result.p99Bytes = ckbPercentileInt64(lengths, 99)

    let embedding = embeddingConfigFromRuntime(config)
    let provider = embeddingProviderFromRuntime(config)
    let smoke = ArrayList<String>()
    let smokeLimit = if (texts.size < 4) { texts.size } else { 4 }
    for (i in 0..smokeLimit) {
        smoke.add(ckbUtf8SafePrefix(texts[i], embedding.maxTextBytes))
        result.measuredBatchBytes += smoke[i].size
    }
    result.measuredBatchItems = smoke.size
    let started = DateTime.now().toUnixTimeStamp().toMilliseconds()
    let batch = provider.embed(smoke, embedding.model, embedding.dimensions)
    result.measuredLatencyMillis = DateTime.now().toUnixTimeStamp().toMilliseconds() - started
    let recommended = ckbRecommendOllamaEmbeddingBudget(config, result)
    result.maxBatchItems = recommended.maxBatchItems
    result.maxBatchBytes = recommended.maxBatchBytes
    result.maxTextBytes = recommended.maxTextBytes
    result.ok = batch.status.state == EmbeddingProviderState.READY
    result.status = if (result.ok) { "ready" } else { batch.status.state }
    result.diagnostic = if (result.ok) { "ok" } else { batch.status.degradedReason }
    result
}

public func ckbRecommendOllamaEmbeddingBudget(config: CkbRuntimeConfig, benchmark: CkbOllamaEmbeddingBenchmarkResult): CkbEmbeddingTextBudget {
    let budget = CkbEmbeddingTextBudget()
    let configured = embeddingConfigFromRuntime(config)
    let targetMillis = if (configured.timeoutMillis > 0) { configured.timeoutMillis / 2 } else { 5000 }
    var latencyBytes = configured.maxBatchBytes
    if (benchmark.measuredLatencyMillis > 0 && benchmark.measuredBatchBytes > 0 && targetMillis > 0) {
        latencyBytes = (benchmark.measuredBatchBytes * targetMillis) / benchmark.measuredLatencyMillis
    }
    budget.maxBatchBytes = ckbClampInt64(latencyBytes, 8192, configured.maxBatchBytes)
    let p95Items = if (benchmark.p95Bytes > 0) { budget.maxBatchBytes / benchmark.p95Bytes } else { configured.batchSize }
    budget.maxBatchItems = ckbClampInt64(p95Items, 1, configured.batchSize)
    let textLimit = if (benchmark.p99Bytes > 0 && benchmark.p99Bytes < configured.maxTextBytes) { benchmark.p99Bytes } else { configured.maxTextBytes }
    budget.maxTextBytes = ckbClampInt64(textLimit, 1024, configured.maxTextBytes)
    budget
}

public func renderCkbOllamaEmbeddingBenchmarkJson(result: CkbOllamaEmbeddingBenchmarkResult): String {
    "{\"ok\":${result.ok},\"status\":\"${ckbRuntimePreflightJsonEscape(result.status)}\",\"sampleSize\":${result.sampleSize},\"lengthDistribution\":{\"totalBytes\":${result.totalBytes},\"p50Bytes\":${result.p50Bytes},\"p95Bytes\":${result.p95Bytes},\"p99Bytes\":${result.p99Bytes},\"maxBytes\":${result.maxBytes}},\"latencyMatrix\":{\"measuredBatchItems\":${result.measuredBatchItems},\"measuredBatchBytes\":${result.measuredBatchBytes},\"measuredLatencyMillis\":${result.measuredLatencyMillis}},\"recommendation\":{\"maxBatchItems\":${result.maxBatchItems},\"maxBatchBytes\":${result.maxBatchBytes},\"maxTextBytes\":${result.maxTextBytes}},\"diagnostic\":\"${ckbRuntimePreflightJsonEscape(result.diagnostic)}\"}"
}

private class CkbEnsureVectorCollectionResult {
    public var ok: Bool = true
    public var state: String = "unknown"
    public var diagnostics: ArrayList<String> = ArrayList<String>()

    public init() {}
}

private func ckbEnsureVectorCollection(vectorStore: VectorStore, collection: String, role: String): CkbEnsureVectorCollectionResult {
    let result = CkbEnsureVectorCollectionResult()
    try {
        let before = vectorStore.status(collection)
        let after = vectorStore.ensureReadyCollection(collection)
        result.state = after.state
        if (after.state == EmbeddingProviderState.READY) {
            if (after.degradedReason == "already_exists_ready") {
                result.diagnostics.add("qdrant_collection_already_exists_ready:${role}:${collection}")
            } else if (before.state == EmbeddingProviderState.READY) {
                result.diagnostics.add("qdrant_collection_ready:${role}:${collection}")
            } else {
                result.diagnostics.add("qdrant_collection_created:${role}:${collection}")
            }
            return result
        }
        result.ok = false
        result.diagnostics.add("qdrant_collection_bootstrap_failed:${role}:${collection}:${if (after.degradedReason != "") { after.degradedReason } else { after.state }}")
        return result
    } catch (_: Exception) {
        result.ok = false
        result.state = EmbeddingProviderState.DEGRADED
        result.diagnostics.add("qdrant_collection_bootstrap_failed:${role}:${collection}:exception")
        return result
    }
}

public func ckbRuntimeVectorReadiness(config: CkbRuntimeConfig): CkbRuntimeVectorReadiness {
    let vector = vectorStoreConfigFromRuntime(config)
    let readiness = ckbRuntimeVectorConfigReadiness(config)
    if (!readiness.ready || vector.backend != "qdrant") {
        return readiness
    }
    ckbRuntimeVectorReadinessWithStore(config, vectorStoreFromRuntime(config))
}

public func ckbRuntimeVectorReadinessWithStore(config: CkbRuntimeConfig, vectorStore: VectorStore): CkbRuntimeVectorReadiness {
    let vector = vectorStoreConfigFromRuntime(config)
    let result = ckbRuntimeVectorConfigReadiness(config)
    if (!result.ready || vector.backend != "qdrant") {
        return result
    }
    try {
        let status = vectorStore.status(vector.activeCollection)
        if (status.dimension > 0) {
            result.vectorDimensions = status.dimension
        }
        if (status.state == EmbeddingProviderState.READY) {
            if (result.embeddingDimensions > 0 && result.vectorDimensions > 0 && result.embeddingDimensions != result.vectorDimensions) {
                result.ready = false
                result.state = "degraded"
                result.reason = "qdrant_collection_dimension_mismatch:${result.embeddingDimensions}:${result.vectorDimensions}"
            }
            let expectedDistance = vector.distance.trimAscii().toAsciiLower()
            let actualDistance = status.distance.trimAscii().toAsciiLower()
            if (result.ready && expectedDistance != "" && actualDistance != "" && expectedDistance != actualDistance) {
                result.ready = false
                result.state = "degraded"
                result.reason = "qdrant_collection_distance_mismatch:${status.distance}:${vector.distance}"
            }
            return result
        }
        result.ready = false
        result.state = "degraded"
        result.reason = ckbRuntimeQdrantReadinessReason(status)
        return result
    } catch (_: Exception) {
        result.ready = false
        result.state = "degraded"
        result.reason = "qdrant_unreachable:exception"
        return result
    }
}

private func ckbRuntimeVectorConfigReadiness(config: CkbRuntimeConfig): CkbRuntimeVectorReadiness {
    let result = CkbRuntimeVectorReadiness()
    let embedding = embeddingConfigFromRuntime(config)
    let vector = vectorStoreConfigFromRuntime(config)
    result.embeddingDimensions = embedding.dimensions
    result.vectorDimensions = vector.dimensions
    if (vector.backend == "qdrant" && embedding.dimensions > 0 && vector.dimensions > 0 && embedding.dimensions != vector.dimensions) {
        result.ready = false
        result.state = "degraded"
        result.reason = "vector_dimension_mismatch:${embedding.dimensions}:${vector.dimensions}"
    }
    result
}

private func ckbRuntimeQdrantReadinessReason(status: VectorStoreStatus): String {
    let reason = if (status.degradedReason != "") { status.degradedReason } else { "status_${status.state}" }
    if (status.state == EmbeddingProviderState.DOWN) {
        return "qdrant_unreachable:${reason}"
    }
    "qdrant_degraded:${reason}"
}

public class CkbSchedulerFailedTaskSummary {
    public var taskName: String = ""
    public var status: String = ""
    public var primaryFailure: String = ""
    public var failedSources: ArrayList<String> = ArrayList<String>()
    public var missingArtifacts: ArrayList<String> = ArrayList<String>()

    public init() {}
}

public func ckbSchedulerFailureSummaries(result: SchedulerExecutorResult): ArrayList<CkbSchedulerFailedTaskSummary> {
    let summaries = ArrayList<CkbSchedulerFailedTaskSummary>()
    for (line in result.details.split("\n")) {
        ckbSchedulerCollectFailedDetailLine(summaries, line.trimAscii())
    }
    for (diagnostic in result.validationDiagnostics) {
        ckbSchedulerCollectFailedDiagnostic(summaries, diagnostic)
    }
    let out = ArrayList<CkbSchedulerFailedTaskSummary>()
    for (summary in summaries) {
        if (summary.primaryFailure == "") {
            summary.primaryFailure = if (summary.status != "") {
                summary.status
            } else if (summary.failedSources.size > 0) {
                summary.failedSources[0]
            } else if (summary.missingArtifacts.size > 0) {
                "missing_artifacts"
            } else {
                ""
            }
        }
        if (summary.status != "" || summary.primaryFailure != "" || summary.failedSources.size > 0 || summary.missingArtifacts.size > 0) {
            out.add(summary)
        }
    }
    out
}

public func ckbSchedulerPreRunGate(config: CkbRuntimeConfig, store: FileKnowledgeStore, vectorStore: VectorStore, taskNames: ArrayList<String>): CkbSchedulerPreRunGateResult {
    let result = CkbSchedulerPreRunGateResult()
    if (!ckbSchedulerPreRunGateRequiresActiveVector(taskNames)) {
        return result
    }
    let vector = vectorStoreConfigFromRuntime(config)
    if (vector.backend != "qdrant") {
        result.diagnostics.add("scheduler_pre_run_gate_skipped_backend:${vector.backend}")
        return result
    }
    let effective = ckbEffectiveVectorCollections(config, store)
    for (diagnostic in effective.diagnostics) {
        result.diagnostics.add(diagnostic)
    }
    let metadata = store.loadMetadataStatus()
    if (!effective.valid || !metadata.valid || metadata.snapshotManifestTxId == "" || !store.has("transactions/${safeName(metadata.snapshotManifestTxId)}/COMMIT")) {
        result.ok = false
        result.diagnostics.add("scheduler_pre_run_gate_failed:active_snapshot_invalid:${if (!metadata.valid) { metadata.diagnostic } else { "manifest_missing_or_uncommitted" }}")
        return result
    }
    if (ckbSchedulerActiveCountsPartiallyEmpty(metadata)) {
        result.ok = false
        result.diagnostics.add("scheduler_pre_run_gate_failed:active_snapshot_invalid:active_count_partial")
        return result
    }
    let activeCount = ckbRoutineExpectedActiveCount(metadata)
    if (activeCount <= 0 && !ckbSchedulerCommittedZeroSnapshotValid(store, metadata, effective)) {
        result.ok = false
        result.diagnostics.add("scheduler_pre_run_gate_failed:active_snapshot_invalid:active_count_missing")
        return result
    }
    let qdrant = vectorStore.status(effective.effectiveActiveCollection)
    if (qdrant.state != EmbeddingProviderState.READY) {
        result.ok = false
        result.diagnostics.add("scheduler_pre_run_gate_failed:qdrant_active_not_ready:${effective.effectiveActiveCollection}:${if (qdrant.degradedReason != "") { qdrant.degradedReason } else { qdrant.state }}")
        return result
    }
    if (qdrant.count != activeCount) {
        result.ok = false
        result.diagnostics.add("scheduler_pre_run_gate_failed:qdrant_active_count_mismatch:${qdrant.count}:${activeCount}:${effective.effectiveActiveCollection}")
    }
    if (vector.dimensions > 0 && qdrant.dimension > 0 && qdrant.dimension != vector.dimensions) {
        result.ok = false
        result.diagnostics.add("scheduler_pre_run_gate_failed:qdrant_active_dimension_mismatch:${qdrant.dimension}:${vector.dimensions}:${effective.effectiveActiveCollection}")
    }
    if (vector.distance != "" && qdrant.distance != "" && qdrant.distance.trimAscii().toAsciiLower() != vector.distance.trimAscii().toAsciiLower()) {
        result.ok = false
        result.diagnostics.add("scheduler_pre_run_gate_failed:qdrant_active_distance_mismatch:${qdrant.distance}:${vector.distance}:${effective.effectiveActiveCollection}")
    }
    result
}

private func ckbSchedulerActiveCountsPartiallyEmpty(metadata: StoreMetadataStatus): Bool {
    let anyPositive = metadata.rawCount > 0 || metadata.normalizedCount > 0 ||
        metadata.indexCount > 0 || metadata.vectorIndexCount > 0
    anyPositive && (metadata.rawCount <= 0 || metadata.normalizedCount <= 0 ||
        metadata.indexCount <= 0 || metadata.vectorIndexCount <= 0)
}

private func ckbSchedulerCommittedZeroSnapshotValid(store: FileKnowledgeStore,
    metadata: StoreMetadataStatus, effective: CkbEffectiveVectorCollections): Bool {
    if (metadata.rawCount != 0 || metadata.normalizedCount != 0 ||
        metadata.indexCount != 0 || metadata.vectorIndexCount != 0 ||
        metadata.graphNodeCount != 0 || metadata.graphEdgeCount != 0 ||
        metadata.activeVersion == "" || metadata.vectorActiveCollection == "" ||
        metadata.vectorCandidateCollection == "" ||
        metadata.vectorActiveCollection != effective.effectiveActiveCollection ||
        metadata.vectorCandidateCollection != effective.candidateCollection) {
        return false
    }
    let pointer = store.loadActiveSnapshotPointer()
    if (!pointer.valid || pointer.legacy || pointer.txId != metadata.snapshotManifestTxId ||
        pointer.activeVersion != metadata.activeVersion ||
        pointer.vectorActiveCollection != metadata.vectorActiveCollection ||
        !store.has("transactions/${safeName(pointer.txId)}/COMMIT")) {
        return false
    }
    let snapshot = store.loadActiveSnapshot()
    snapshot.valid && snapshot.activeVersion == metadata.activeVersion &&
        snapshot.vectorActiveCollection == metadata.vectorActiveCollection &&
        snapshot.vectorCandidateCollection == metadata.vectorCandidateCollection &&
        snapshot.rawRecords.size == 0 && snapshot.normalizedRecords.size == 0 &&
        snapshot.activeIndex.size == 0 && snapshot.vectorRecords.size == 0
}

public func ckbSchedulerPreRunGateFailureResult(gate: CkbSchedulerPreRunGateResult, taskNames: ArrayList<String>, force: Bool): SchedulerExecutorResult {
    let result = SchedulerExecutorResult()
    let failedTask = ckbSchedulerPreRunGateTaskName(taskNames)
    result.forced = force
    result.runId = "scheduler-pre-run-gate-${ckbCoreNowMillis()}"
    result.startedAtMillis = ckbCoreNowMillis()
    result.endedAtMillis = result.startedAtMillis
    if (taskNames.size == 0) {
        result.taskNames.add(failedTask)
    } else {
        for (name in taskNames) {
            result.taskNames.add(name)
        }
    }
    result.failed = 1
    result.details = "task ${failedTask} ok=false status=scheduler_pre_run_gate_failed\n"
    for (diagnostic in gate.diagnostics) {
        result.validationDiagnostics.add(diagnostic)
        result.details += "scheduler_pre_run_gate ${diagnostic}\n"
    }
    result
}

private func ckbSchedulerPreRunGateRequiresActiveVector(taskNames: ArrayList<String>): Bool {
    for (name in taskNames) {
        if (ckbSchedulerTaskNeedsRoutineHeap(name)) {
            return true
        }
    }
    false
}

private func ckbSchedulerPreRunGateTaskName(taskNames: ArrayList<String>): String {
    for (name in taskNames) {
        if (ckbSchedulerTaskNeedsRoutineHeap(name)) {
            return name
        }
    }
    if (taskNames.size > 0) {
        return taskNames[0]
    }
    "weekly_full_rebuild"
}

public func ckbSchedulerRunTaskRecordsJson(records: ArrayList<SchedulerTaskRunRecord>): String {
    let parts = ArrayList<String>()
    for (record in records) {
        parts.add("{\"taskName\":\"${ckbRuntimePreflightJsonEscape(record.taskName)}\",\"ok\":${record.ok},\"status\":\"${ckbRuntimePreflightJsonEscape(record.status)}\",\"schedulerRunId\":\"${ckbRuntimePreflightJsonEscape(record.schedulerRunId)}\",\"schedulerTaskName\":\"${ckbRuntimePreflightJsonEscape(record.schedulerTaskName)}\",\"startedAtMillis\":${record.startedAtMillis},\"endedAtMillis\":${record.endedAtMillis},\"deadlineAtMillis\":${record.deadlineAtMillis},\"durationMillis\":${record.durationMillis},\"bootstrapStartedAtMillis\":${record.bootstrapStartedAtMillis},\"taskBodyStartedAtMillis\":${record.taskBodyStartedAtMillis},\"taskBodyEndedAtMillis\":${record.taskBodyEndedAtMillis},\"bootstrapDurationMillis\":${record.bootstrapDurationMillis},\"resultWrittenAtMillis\":${record.resultWrittenAtMillis},\"resultFlushDurationMillis\":${record.resultFlushDurationMillis},\"businessStatus\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(record.businessStatus), 160))}\",\"finalizationStatus\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(record.finalizationStatus), 160))}\",\"finalizationFailure\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(record.finalizationFailure), 240))}\",\"stageDurations\":${ckbSchedulerStageDurationsJson(record.stageDurations)},\"timeBudgetMillis\":${record.timeBudgetMillis},\"requestCount\":${record.requestCount},\"actualAttempts\":${record.actualAttempts},\"successfulAttempts\":${record.successfulAttempts},\"retryAttempts\":${record.retryAttempts},\"plannedRequests\":${record.plannedRequests},\"completedRequests\":${record.completedRequests},\"failedRequests\":${record.failedRequests},\"validationGates\":${ckbSchedulerStageDurationsJson(record.validationGates)},\"transactionId\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(record.transactionId), 160))}\",\"manifestEvidenceHash\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(record.manifestEvidenceHash), 96))}\",\"freshnessEvidenceHash\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(record.freshnessEvidenceHash), 96))}\",\"sourceCoverageEvidenceHash\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(record.sourceCoverageEvidenceHash), 96))}\",\"inventoryEvidenceHash\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(record.inventoryEvidenceHash), 96))}\",\"lastStage\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(record.lastStage), 120))}\",\"lastProgress\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(record.lastProgress), 240))}\",\"workerPid\":${record.workerPid},\"workerOutSnippet\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(record.workerOutSnippet), 240))}\",\"workerErrSnippet\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(record.workerErrSnippet), 240))}\",\"primaryFailure\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(record.primaryFailure), 240))}\"}")
    }
    "[${joinStrings(parts, ",")}]"
}

private func ckbSchedulerStageDurationsJson(values: ArrayList<String>): String {
    let parts = ArrayList<String>()
    for (value in values) {
        parts.add("\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(value), 240))}\"")
    }
    "[${joinStrings(parts, ",")}]"
}

private func ckbSchedulerCollectFailedDetailLine(summaries: ArrayList<CkbSchedulerFailedTaskSummary>, line: String): Unit {
    if (!line.startsWith("task ") || !line.contains("ok=false")) {
        return
    }
    let parts = line.split(" ")
    if (parts.size < 2) {
        return
    }
    let summary = ckbSchedulerFindOrCreateFailedSummary(summaries, parts[1])
    let status = ckbSchedulerTokenValue(line, "status=")
    if (summary.status == "" && status != "") {
        summary.status = status
    }
}

private func ckbSchedulerCollectFailedDiagnostic(summaries: ArrayList<CkbSchedulerFailedTaskSummary>, diagnostic: String): Unit {
    let taskName = ckbSchedulerDiagnosticTaskName(diagnostic)
    if (taskName == "") {
        return
    }
    let summary = ckbSchedulerFindOrCreateFailedSummary(summaries, taskName)
    if (diagnostic.contains("fetch:") && diagnostic.contains("ok=false")) {
        ckbSchedulerAddUniqueString(summary.failedSources, redactSensitive(diagnostic))
    }
    let failure = ckbSchedulerPrimaryFailureFromDiagnostic(diagnostic)
    if (failure != "" && ckbSchedulerCanReplacePrimaryFailure(summary.primaryFailure)) {
        summary.primaryFailure = failure
    }
    if (diagnostic.contains("routine_contract:")) {
        ckbSchedulerCollectRoutineContractDiagnostic(summary, diagnostic)
    }
}

private func ckbSchedulerPrimaryFailureFromDiagnostic(diagnostic: String): String {
    if (ckbSchedulerFreshnessDiagnosticIsSignal(diagnostic)) {
        return ""
    }
    if (ckbSchedulerFreshnessDiagnosticIsBlocking(diagnostic)) {
        return redactSensitive(diagnostic)
    }
    if (diagnostic.contains("routine_contract_passed") ||
        diagnostic.contains("profile_stage_budget") ||
        diagnostic.contains("profile_stage_checkpoint")) {
        return ""
    }
    if (diagnostic.contains("readiness:")) {
        return ckbSchedulerDiagnosticSuffix(diagnostic, "readiness:")
    }
    if (diagnostic.contains("version_manifest_write_verify_failed")) {
        return "version_manifest_write_verify_failed"
    }
    if (diagnostic.contains("version_manifest_empty_after_refresh")) {
        return "version_manifest_empty_after_refresh"
    }
    if (diagnostic.contains("internal_timeout:")) {
        return ckbSchedulerDiagnosticSuffix(diagnostic, "internal_timeout:")
    }
    if (diagnostic.contains("worker_artifact:")) {
        return ckbSchedulerDiagnosticSuffix(diagnostic, "worker_artifact:")
    }
    if (diagnostic.contains("fetch:") && diagnostic.contains("ok=false")) {
        return redactSensitive(diagnostic)
    }
    ""
}

private func ckbSchedulerFreshnessDiagnosticIsBlocking(diagnostic: String): Bool {
    diagnostic.contains("probe_failed") ||
        diagnostic.contains("manifest_not_ready_for_freshness") ||
        diagnostic.contains("manifest_blocking_for_freshness") ||
        diagnostic.contains("manifest_missing_for_freshness") ||
        diagnostic.contains("manifest_offline_baseline_for_freshness") ||
        diagnostic.contains("version_manifest_contains_offline_baseline") ||
        diagnostic.contains("version_manifest_invalid_encoding") ||
        diagnostic.contains("version_manifest_malformed")
}

private func ckbSchedulerFreshnessDiagnosticIsSignal(diagnostic: String): Bool {
    diagnostic.contains("freshness_source_hash_changed") ||
        diagnostic.contains("staleness_stale") ||
        diagnostic.contains("freshness_stale_signal") ||
        diagnostic.contains("freshness_source:") ||
        diagnostic.contains("manifest_source_tree_resolved") ||
        diagnostic.contains("manifest_source_content_sample_ok") ||
        diagnostic.contains("manifest_ready_for_freshness")
}

private func ckbSchedulerCanReplacePrimaryFailure(current: String): Bool {
    current == "" ||
        current.startsWith("task_not_ok:") ||
        current == "scheduled_readiness_failed" ||
        current.contains("profile_stage_budget") ||
        current.contains("profile_stage_checkpoint")
}

private func ckbSchedulerCollectRoutineContractDiagnostic(summary: CkbSchedulerFailedTaskSummary, diagnostic: String): Unit {
    let parts = diagnostic.split("routine_contract:")
    if (parts.size < 2) {
        return
    }
    let raw = parts[1]
    let status = jsonStringField(raw, "diagnostic")
    if (status == "routine_contract_passed") {
        return
    }
    if (summary.status == "" && status != "") {
        summary.status = status
    }
    if (summary.primaryFailure == "" && status != "") {
        summary.primaryFailure = status
    }
    for (artifact in ckbSchedulerJsonStringArrayField(raw, "missingArtifacts")) {
        ckbSchedulerAddUniqueString(summary.missingArtifacts, artifact)
    }
}

private func ckbSchedulerDiagnosticTaskName(diagnostic: String): String {
    let parts = diagnostic.split(":")
    if (parts.size < 2) {
        return ""
    }
    parts[0]
}

private func ckbSchedulerDiagnosticSuffix(diagnostic: String, marker: String): String {
    let parts = diagnostic.split(marker)
    if (parts.size < 2) {
        return ""
    }
    redactSensitive(parts[1])
}

private func ckbSchedulerTokenValue(raw: String, prefix: String): String {
    for (part in raw.split(" ")) {
        if (part.startsWith(prefix) && part.size > prefix.size) {
            return part[prefix.size..part.size]
        }
    }
    ""
}

private func ckbSchedulerFindOrCreateFailedSummary(summaries: ArrayList<CkbSchedulerFailedTaskSummary>, taskName: String): CkbSchedulerFailedTaskSummary {
    for (summary in summaries) {
        if (summary.taskName == taskName) {
            return summary
        }
    }
    let summary = CkbSchedulerFailedTaskSummary()
    summary.taskName = taskName
    summaries.add(summary)
    summary
}

private func ckbSchedulerJsonStringArrayField(raw: String, key: String): ArrayList<String> {
    let out = ArrayList<String>()
    let parts = raw.split("\"${key}\":[")
    if (parts.size < 2) {
        return out
    }
    let tailParts = parts[1].split("]")
    if (tailParts.size == 0) {
        return out
    }
    let tokens = tailParts[0].split("\"")
    var i: Int64 = 1
    while (i < tokens.size) {
        if (tokens[i] != "") {
            ckbSchedulerAddUniqueString(out, tokens[i])
        }
        i += 2
    }
    out
}

private func ckbSchedulerAddUniqueString(values: ArrayList<String>, value: String): Unit {
    if (value == "") {
        return
    }
    for (existing in values) {
        if (existing == value) {
            return
        }
    }
    values.add(value)
}

private func ckbParseHeapMiB(raw: String): Int64 {
    let value = raw.trimAscii().toAsciiLower()
    if (value == "") {
        return 0
    }
    if (value.endsWith("gb") && value.size > 2) {
        return ckbRuntimePreflightParseIntSafe(value[0..value.size - 2], 0) * 1024
    }
    if (value.endsWith("g") && value.size > 1) {
        return ckbRuntimePreflightParseIntSafe(value[0..value.size - 1], 0) * 1024
    }
    if (value.endsWith("mb") && value.size > 2) {
        return ckbRuntimePreflightParseIntSafe(value[0..value.size - 2], 0)
    }
    if (value.endsWith("m") && value.size > 1) {
        return ckbRuntimePreflightParseIntSafe(value[0..value.size - 1], 0)
    }
    ckbRuntimePreflightParseIntSafe(value, 0)
}

private func ckbRuntimePreflightParseIntSafe(raw: String, fallback: Int64): Int64 {
    try { Int64.parse(raw.trimAscii()) } catch (_: Exception) { fallback }
}

private func ckbRuntimePreflightStringListJson(values: ArrayList<String>): String {
    var out = "["
    for (i in 0..values.size) {
        if (i > 0) {
            out += ","
        }
        out += "\"${ckbRuntimePreflightJsonEscape(values[i])}\""
    }
    out + "]"
}

private func ckbRuntimePreflightJsonEscape(raw: String): String {
    redactSensitive(raw).replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
}

private func snapshotDiagnostic(primary: String, extra: String): String {
    if (extra == "") {
        return primary
    }
    "${primary};${extra}"
}

public interface CkbActiveSnapshotTxClock {
    func nowMillis(): Int64
}

public class SystemCkbActiveSnapshotTxClock <: CkbActiveSnapshotTxClock {
    public init() {}
    public func nowMillis(): Int64 {
        DateTime.now().toUnixTimeStamp().toMilliseconds()
    }
}

class CkbRoutineReleaseCoverageSummary {
    var valid: Bool = false
    var sourceCoverageEvidenceHash: String = ""
    var inventoryEvidenceHash: String = ""

    init() {}
}

// P6-S6: immutable identity plus independently attestable event phases.
public class CkbRepositoryEventLedger {
    public var eventId: String = ""
    public var dedupeKey: String = ""
    public var canonicalSha256: String = ""
    public var deliveryId: String = ""
    public var receiptRevision: Int64 = 0
    public var receiptAttempt: Int64 = 0
    public var receiptChecksum: String = ""
    public var state: String = "queued"
    public var resolvedCommit: String = ""
    public var ingestedEvidenceHash: String = ""
    public var committedEvidenceHash: String = ""
    public var schedulerRunId: String = ""
    public var transactionId: String = ""
    public var candidateVersion: String = ""
    public var activeVersion: String = ""
    public var gates: ArrayList<String> = ArrayList<String>()
    public var checksum: String = ""
    public var valid: Bool = false
    public var diagnostic: String = "not_found"

    public init() {}
}

private func ckbRepositoryEventLedgerPath(dedupeKey: String): String {
    "metadata/repository-event-ledger/${safeName(ckbReleaseEvidenceHash(dedupeKey))}.ckb"
}

private func ckbRepositoryEventLedgerChecksum(ledger: CkbRepositoryEventLedger): String {
    let gateArray = ledger.gates.toArray(); sort(gateArray)
    let gates = ArrayList<String>()
    for (gate in gateArray) { gates.add(gate) }
    ckbReleaseEvidenceHash("eventId=${ledger.eventId}|dedupeKey=${ledger.dedupeKey}|canonicalSha256=${ledger.canonicalSha256}|state=${ledger.state}|resolvedCommit=${ledger.resolvedCommit}|ingested=${ledger.ingestedEvidenceHash}|committed=${ledger.committedEvidenceHash}|run=${ledger.schedulerRunId}|tx=${ledger.transactionId}|candidate=${ledger.candidateVersion}|active=${ledger.activeVersion}|gates=${joinStrings(gates, ",")}")
}

public func ckbRepositoryEventCommittedEvidenceHash(ledger: CkbRepositoryEventLedger): String {
    let gateArray = ledger.gates.toArray(); sort(gateArray)
    let gates = ArrayList<String>()
    for (gate in gateArray) { gates.add(gate) }
    ckbReleaseEvidenceHash("canonical=${ledger.canonicalSha256}|resolved=${ledger.resolvedCommit}|ingested=${ledger.ingestedEvidenceHash}|run=${ledger.schedulerRunId}|tx=${ledger.transactionId}|candidate=${ledger.candidateVersion}|active=${ledger.activeVersion}|gates=${joinStrings(gates, ",")}")
}

private func ckbRepositoryEventLedgerText(ledger: CkbRepositoryEventLedger): String {
    var text = "schemaVersion=ckb-repository-event-ledger-v1\n"
    text += "eventId=${escapeField(ledger.eventId)}\ndedupeKey=${escapeField(ledger.dedupeKey)}\ncanonicalSha256=${ledger.canonicalSha256}\nstate=${ledger.state}\nresolvedCommit=${escapeField(ledger.resolvedCommit)}\ningestedEvidenceHash=${ledger.ingestedEvidenceHash}\ncommittedEvidenceHash=${ledger.committedEvidenceHash}\nschedulerRunId=${escapeField(ledger.schedulerRunId)}\ntransactionId=${escapeField(ledger.transactionId)}\ncandidateVersion=${escapeField(ledger.candidateVersion)}\nactiveVersion=${escapeField(ledger.activeVersion)}\n"
    for (gate in ledger.gates) { text += "gate|${escapeField(gate)}\n" }
    text += "checksum=${ledger.checksum}\n"; text
}

public class FileKnowledgeStore {
    public let root: Path
    private var atomicTmpSequence: Int64 = 0
    private var activeSnapshotMaterializations: Int64 = 0
    private let activeSnapshotTxClock: CkbActiveSnapshotTxClock

    public init(root: String, txClock!: CkbActiveSnapshotTxClock = SystemCkbActiveSnapshotTxClock()) {
        this.root = Path(root)
        this.activeSnapshotTxClock = txClock
    }

    public func rootPath(): String {
        this.root.toString()
    }

    func activeSnapshotMaterializationCount(): Int64 {
        this.activeSnapshotMaterializations
    }

    public func ensureLayout(): Unit {
        this.ensure("raw")
        this.ensure("normalized")
        this.ensure("metadata")
        this.ensure("index")
        this.ensure("derived")
        this.ensure("cache")
    }

    public func saveRaw(records: ArrayList<RawRecord>): Unit {
        this.writeLines("raw/records.ckb", this.rawLines(records))
        for (record in records) {
            this.writeLines("raw/${safeName(record.metadata.sourceType)}/${safeName(record.sourceId)}.ckb", this.rawLines(singleRawRecord(record)))
        }
    }

    public func saveNormalized(records: ArrayList<NormalizedRecord>): Unit {
        this.writeLines("normalized/records.ckb", this.normalizedLines(records))
    }

    public func saveCandidateRaw(records: ArrayList<RawRecord>, version: String): Unit {
        if (version == "") {
            return
        }
        this.writeLines("raw/candidate/${safeName(version)}/records.ckb", this.rawLines(records))
    }

    public func saveCandidateNormalized(records: ArrayList<NormalizedRecord>, version: String): Unit {
        if (version == "") {
            return
        }
        this.writeLines("normalized/candidate/${safeName(version)}.ckb", this.normalizedLines(records))
    }

    public func saveCandidateSnapshotImmutable(rawRecords: ArrayList<RawRecord>, normalizedRecords: ArrayList<NormalizedRecord>, version: String, deadlineAtMillis!: Int64 = 0): CkbCandidateMaterializationResult {
        let result = CkbCandidateMaterializationResult()
        if (version.trimAscii() == "") {
            result.status = "candidate_version_missing"
            result.diagnostic = result.status
            return result
        }
        this.cleanupCandidateStaleTemps(version)
        this.ensureActiveSnapshotDeadline("candidate_materialization_before", deadlineAtMillis)
        result.rawCount = rawRecords.size
        result.normalizedCount = normalizedRecords.size
        result.rawEvidenceHash = this.candidateRawEvidenceHash(rawRecords)
        result.normalizedEvidenceHash = this.candidateNormalizedEvidenceHash(normalizedRecords)
        let rawPath = "raw/candidate/${safeName(version)}/records.ckb"
        let normalizedPath = "normalized/candidate/${safeName(version)}.ckb"
        let rawFileHash = this.candidateRawFileHash(rawRecords, deadlineAtMillis)
        let normalizedFileHash = this.candidateNormalizedFileHash(normalizedRecords, 0, normalizedRecords.size, deadlineAtMillis)
        let batchSize: Int64 = 256
        let batchPaths = ArrayList<String>()
        let batchCounts = ArrayList<Int64>()
        let batchHashes = ArrayList<String>()
        var expectedStart: Int64 = 0
        var expectedBatchIndex: Int64 = 0
        while (expectedStart < normalizedRecords.size) {
            let expectedEnd = if (expectedStart + batchSize < normalizedRecords.size) { expectedStart + batchSize } else { normalizedRecords.size }
            batchPaths.add("candidate-artifacts/${safeName(version)}/batches/batch-${expectedBatchIndex}.ckb")
            batchCounts.add(expectedEnd - expectedStart)
            batchHashes.add(this.candidateNormalizedFileHash(normalizedRecords, expectedStart, expectedEnd, deadlineAtMillis))
            expectedBatchIndex += 1
            expectedStart = expectedEnd
        }
        let manifestSeed = StringBuilder()
        manifestSeed.append("${version}|${result.rawCount}|${result.normalizedCount}|${result.rawEvidenceHash}|${result.normalizedEvidenceHash}|${rawPath}|${rawFileHash}|${normalizedPath}|${normalizedFileHash}")
        for (index in 0..batchPaths.size) { manifestSeed.append("|${batchPaths[index]}|${batchCounts[index]}|${batchHashes[index]}") }
        result.manifestEvidenceHash = ckbReleaseEvidenceHash(manifestSeed.toString())
        let manifestPath = "candidate-artifacts/${safeName(version)}/manifest.ckb"
        let existing = try { this.readText(manifestPath) } catch (_: Exception) {
            result.status = "candidate_manifest_invalid_response_encoding"
            result.diagnostic = result.status
            return result
        }
        if (existing != "") {
            let sameIdentity = ckbCurrentField(existing, "version") == version &&
                parseIntField(ckbCurrentField(existing, "rawCount"), -1) == result.rawCount &&
                parseIntField(ckbCurrentField(existing, "normalizedCount"), -1) == result.normalizedCount &&
                ckbCurrentField(existing, "rawEvidenceHash") == result.rawEvidenceHash &&
                ckbCurrentField(existing, "normalizedEvidenceHash") == result.normalizedEvidenceHash
            if (!sameIdentity) {
                result.status = "candidate_immutable_manifest_mismatch"
                result.diagnostic = result.status
                return result
            }
            var filesValid = ckbCurrentField(existing, "manifestEvidenceHash") == result.manifestEvidenceHash &&
                ckbCurrentField(existing, "rawPath") == rawPath && ckbCurrentField(existing, "rawFileHash") == rawFileHash &&
                ckbCurrentField(existing, "normalizedPath") == normalizedPath && ckbCurrentField(existing, "normalizedFileHash") == normalizedFileHash &&
                parseIntField(ckbCurrentField(existing, "batchCount"), -1) == batchPaths.size &&
                this.candidateFileHashMatches(rawPath, rawFileHash, deadlineAtMillis) && this.candidateFileHashMatches(normalizedPath, normalizedFileHash, deadlineAtMillis)
            if (filesValid) {
                for (index in 0..batchPaths.size) {
                    if (ckbCurrentField(existing, "batch${index}Path") != batchPaths[index] ||
                        parseIntField(ckbCurrentField(existing, "batch${index}Count"), -1) != batchCounts[index] ||
                        ckbCurrentField(existing, "batch${index}Hash") != batchHashes[index] ||
                        !this.candidateFileHashMatches(batchPaths[index], batchHashes[index], deadlineAtMillis)) {
                        filesValid = false
                        break
                    }
                }
            }
            if (filesValid) {
                result.ok = true
                result.status = "candidate_immutable_reused"
                result.immutableReused = true
                result.batchCount = batchPaths.size
                result.reusedBatchCount = batchPaths.size
                result.peakBufferedRecords = if (normalizedRecords.size < batchSize) { normalizedRecords.size } else { batchSize }
                if (!this.trySaveCandidateMaterializationCheckpoint(version, "completed", batchPaths.size, batchPaths.size, result.manifestEvidenceHash)) { result.checkpointDegraded = true; result.diagnostic = "candidate_checkpoint_write_degraded" }
                return result
            }
        }

        let checkpoint = this.loadCandidateMaterializationCheckpoint(version, result.manifestEvidenceHash, batchPaths.size)
        if (!checkpoint.valid && checkpoint.status != "not_found") { result.diagnostic = "candidate_checkpoint_rejected:${checkpoint.status}" }
        var checkpointRank = if (checkpoint.valid) { this.candidateCheckpointPhaseRank(checkpoint.phase) } else { 0 }
        var committedBatches = if (checkpoint.valid) { checkpoint.completedBatches } else { 0 }
        if (!checkpoint.valid && !this.trySaveCandidateMaterializationCheckpoint(version, "before", 0, batchPaths.size, result.manifestEvidenceHash)) { result.checkpointDegraded = true }
        if (checkpointRank < 1 || !this.candidateFileHashMatches(rawPath, rawFileHash, deadlineAtMillis)) {
            this.writeRawRecordsAtomically(rawPath, rawRecords, deadlineAtMillis, "candidate_raw")
            checkpointRank = 1
            committedBatches = 0
            if (!this.trySaveCandidateMaterializationCheckpoint(version, "raw_committed", 0, batchPaths.size, result.manifestEvidenceHash)) { result.checkpointDegraded = true }
        }
        if (checkpointRank < 2 || !this.candidateFileHashMatches(normalizedPath, normalizedFileHash, deadlineAtMillis)) {
            this.writeNormalizedRecordsAtomically(normalizedPath, normalizedRecords, deadlineAtMillis, "candidate_normalized")
            checkpointRank = 2
            committedBatches = 0
            if (!this.trySaveCandidateMaterializationCheckpoint(version, "normalized_committed", 0, batchPaths.size, result.manifestEvidenceHash)) { result.checkpointDegraded = true }
        }
        var start: Int64 = 0
        var batchIndex: Int64 = 0
        var rebuildRemaining = false
        while (start < normalizedRecords.size) {
            let end = if (start + batchSize < normalizedRecords.size) { start + batchSize } else { normalizedRecords.size }
            let batchPath = batchPaths[batchIndex]
            let cursorCommitted = checkpointRank >= 3 && batchIndex < committedBatches
            this.ensureActiveSnapshotDeadline("candidate_batch_verify_before:${batchIndex}:${batchPaths.size}", deadlineAtMillis)
            if (!rebuildRemaining && (!cursorCommitted || !this.candidateFileHashMatches(batchPath, batchHashes[batchIndex], deadlineAtMillis))) { rebuildRemaining = true }
            this.ensureActiveSnapshotDeadline("candidate_batch_verify_after:${batchIndex}:${batchPaths.size}", deadlineAtMillis)
            if (rebuildRemaining) {
                let batch = ArrayList<NormalizedRecord>()
                for (index in start..end) { batch.add(normalizedRecords[index]) }
                this.writeNormalizedRecordsAtomically(batchPath, batch, deadlineAtMillis, "candidate_batch")
                result.writtenBatchCount += 1
            } else {
                result.reusedBatchCount += 1
            }
            if (end - start > result.peakBufferedRecords) { result.peakBufferedRecords = end - start }
            result.batchCount = batchIndex + 1
            if (rebuildRemaining && !this.trySaveCandidateMaterializationCheckpoint(version, "batch_committed", result.batchCount, batchPaths.size, result.manifestEvidenceHash)) { result.checkpointDegraded = true }
            batchIndex += 1
            start = end
        }
        var manifest = "schemaVersion=${CkbCandidateDurableSchema.VERSION}\n"
        manifest += "version=${escapeField(version)}\n"
        manifest += "rawCount=${result.rawCount}\n"
        manifest += "normalizedCount=${result.normalizedCount}\n"
        manifest += "batchCount=${result.batchCount}\n"
        manifest += "peakBufferedRecords=${result.peakBufferedRecords}\n"
        manifest += "rawEvidenceHash=${result.rawEvidenceHash}\n"
        manifest += "normalizedEvidenceHash=${result.normalizedEvidenceHash}\n"
        manifest += "rawPath=${escapeField(rawPath)}\nrawFileHash=${rawFileHash}\n"
        manifest += "normalizedPath=${escapeField(normalizedPath)}\nnormalizedFileHash=${normalizedFileHash}\n"
        for (index in 0..batchPaths.size) {
            manifest += "batch${index}Path=${escapeField(batchPaths[index])}\n"
            manifest += "batch${index}Count=${batchCounts[index]}\n"
            manifest += "batch${index}Hash=${batchHashes[index]}\n"
        }
        manifest += "manifestEvidenceHash=${result.manifestEvidenceHash}\n"
        this.writeLinesAtomically(manifestPath, manifest)
        this.ensureActiveSnapshotDeadline("candidate_materialization_after", deadlineAtMillis)
        if (!this.trySaveCandidateMaterializationCheckpoint(version, "completed", result.batchCount, batchPaths.size, result.manifestEvidenceHash)) { result.checkpointDegraded = true }
        result.ok = true
        result.status = if (result.checkpointDegraded) { "candidate_immutable_written_checkpoint_degraded" } else if (existing == "") { "candidate_immutable_written" } else { "candidate_immutable_repaired" }
        if (result.checkpointDegraded) { result.diagnostic = "candidate_checkpoint_write_degraded" }
        result
    }

    public func saveCandidateLifecycleMetadata(status: KnowledgeStatus): Unit {
        let version = status.candidateKnowledgeVersion
        if (version != "") {
            var text = "candidateVersion=${escapeField(version)}\n"
            text += "activeVersion=${escapeField(status.activeKnowledgeVersion)}\n"
            text += "failedVersion=${escapeField(status.failedCandidateVersion)}\n"
            text += "state=${if (status.failedCandidateVersion == version) { "failed" } else { "staged" }}\n"
            text += "updatedAtMillis=${ckbCoreNowMillis()}\n"
            this.writeLinesAtomically("candidate-artifacts/${safeName(version)}/status.ckb", text)
        }
        this.saveLiveCandidateLifecycleMetadata(status)
    }

    // P6 validation resumes from this small cursor only. Candidate raw/index
    // artifacts and vector batches stay in their P5 stores and are referenced
    // by evidence hash, so this API cannot create a competing materialization.
    public func saveRepositoryEventValidationCheckpoint(
        checkpoint: CkbRepositoryEventValidationCheckpoint): Unit {
        if (!this.repositoryEventValidationCheckpointSemanticallyValid(checkpoint)) {
            throw Exception("repository_event_validation_checkpoint_invalid")
        }
        checkpoint.checksum = ckbRepositoryEventValidationCheckpointChecksum(checkpoint)
        this.writeLinesAtomically(
            ckbRepositoryEventValidationCheckpointRelativePath(checkpoint.acquisitionId),
            this.repositoryEventValidationCheckpointText(checkpoint))
    }

    public func loadRepositoryEventValidationCheckpoint(
        expected: CkbRepositoryEventValidationCheckpoint): CkbRepositoryEventValidationCheckpoint {
        let checkpoint = CkbRepositoryEventValidationCheckpoint()
        checkpoint.eventId = expected.eventId
        checkpoint.runKey = expected.runKey
        checkpoint.acquisitionId = expected.acquisitionId
        checkpoint.planHash = expected.planHash
        checkpoint.recordsEvidenceHash = expected.recordsEvidenceHash
        checkpoint.candidateVersion = expected.candidateVersion
        checkpoint.activeBaseVersion = expected.activeBaseVersion
        if (!this.repositoryEventValidationCheckpointIdentityValid(checkpoint)) {
            checkpoint.status = "validation_checkpoint_identity_invalid"
            checkpoint.diagnostic = checkpoint.status
            return checkpoint
        }
        let relative = ckbRepositoryEventValidationCheckpointRelativePath(checkpoint.acquisitionId)
        if (!this.has(relative)) { return checkpoint }
        let text = try { this.readText(relative) } catch (_: Exception) {
            checkpoint.status = "invalid_response_encoding"
            checkpoint.diagnostic = "repository_event_validation_checkpoint_invalid_response_encoding"
            return checkpoint
        }
        if (text == "") {
            checkpoint.status = "validation_checkpoint_malformed"
            checkpoint.diagnostic = "repository_event_validation_checkpoint_empty"
            return checkpoint
        }
        if (ckbCurrentField(text, "schemaVersion") != CkbCandidateDurableSchema.VALIDATION_RESUME_VERSION) {
            checkpoint.status = "validation_checkpoint_schema_mismatch"
            checkpoint.diagnostic = checkpoint.status
            return checkpoint
        }
        checkpoint.eventId = ckbCurrentField(text, "eventId")
        checkpoint.runKey = ckbCurrentField(text, "runKey")
        checkpoint.acquisitionId = ckbCurrentField(text, "acquisitionId")
        checkpoint.planHash = ckbCurrentField(text, "planHash")
        checkpoint.recordsEvidenceHash = ckbCurrentField(text, "recordsEvidenceHash")
        checkpoint.candidateVersion = ckbCurrentField(text, "candidateVersion")
        checkpoint.activeBaseVersion = ckbCurrentField(text, "activeBaseVersion")
        if (checkpoint.eventId != expected.eventId || checkpoint.runKey != expected.runKey ||
            checkpoint.acquisitionId != expected.acquisitionId || checkpoint.planHash != expected.planHash ||
            checkpoint.recordsEvidenceHash != expected.recordsEvidenceHash ||
            checkpoint.candidateVersion != expected.candidateVersion ||
            checkpoint.activeBaseVersion != expected.activeBaseVersion) {
            checkpoint.status = "validation_checkpoint_identity_mismatch"
            checkpoint.diagnostic = checkpoint.status
            return checkpoint
        }
        checkpoint.phase = ckbCurrentField(text, "phase")
        checkpoint.documentCursor = parseIntField(ckbCurrentField(text, "documentCursor"), -1)
        checkpoint.documentTotal = parseIntField(ckbCurrentField(text, "documentTotal"), -1)
        checkpoint.partitionCursor = parseIntField(ckbCurrentField(text, "partitionCursor"), -1)
        checkpoint.partitionCount = parseIntField(ckbCurrentField(text, "partitionCount"), -1)
        if (!ckbScheduledFetchDecodePathsJson(ckbCurrentField(text, "partitionIdsJson"), checkpoint.partitionIds)) {
            checkpoint.status = "validation_checkpoint_malformed"
            checkpoint.diagnostic = "validation_checkpoint_partition_ids_malformed"
            return checkpoint
        }
        checkpoint.worksetEvidenceHash = ckbCurrentField(text, "worksetEvidenceHash")
        checkpoint.currentPartition = ckbCurrentField(text, "currentPartition")
        checkpoint.completedPartitionsEvidenceHash = ckbCurrentField(text, "completedPartitionsEvidenceHash")
        checkpoint.exactSymbolHits = parseIntField(ckbCurrentField(text, "exactSymbolHits"), -1)
        checkpoint.docSectionHits = parseIntField(ckbCurrentField(text, "docSectionHits"), -1)
        checkpoint.toolManualHits = parseIntField(ckbCurrentField(text, "toolManualHits"), -1)
        checkpoint.negativeRuleHits = parseIntField(ckbCurrentField(text, "negativeRuleHits"), -1)
        checkpoint.moduleHits = parseIntField(ckbCurrentField(text, "moduleHits"), -1)
        checkpoint.availabilityHits = parseIntField(ckbCurrentField(text, "availabilityHits"), -1)
        checkpoint.deltaEvidenceHash = ckbCurrentField(text, "deltaEvidenceHash")
        checkpoint.overlayEvidenceHash = ckbCurrentField(text, "overlayEvidenceHash")
        checkpoint.vectorEvidenceHash = ckbCurrentField(text, "vectorEvidenceHash")
        checkpoint.validationEvidenceHash = ckbCurrentField(text, "validationEvidenceHash")
        checkpoint.indexArtifactChecksum = ckbCurrentField(text, "indexArtifactChecksum")
        checkpoint.transportParityPass = ckbCurrentField(text, "transportParityPass") == "true"
        checkpoint.performancePass = ckbCurrentField(text, "performancePass") == "true"
        checkpoint.vectorHealthPass = ckbCurrentField(text, "vectorHealthPass") == "true"
        checkpoint.performanceP95Cost = parseIntField(ckbCurrentField(text, "performanceP95Cost"), -1)
        checkpoint.performanceEvidenceHash = ckbCurrentField(text, "performanceEvidenceHash")
        checkpoint.vectorState = ckbCurrentField(text, "vectorState")
        checkpoint.vectorDimension = parseIntField(ckbCurrentField(text, "vectorDimension"), -1)
        checkpoint.vectorCount = parseIntField(ckbCurrentField(text, "vectorCount"), -1)
        checkpoint.vectorCollection = ckbCurrentField(text, "vectorCollection")
        checkpoint.vectorStatusEvidenceHash = ckbCurrentField(text, "vectorStatusEvidenceHash")
        checkpoint.vectorDegradedReason = ckbCurrentField(text, "vectorDegradedReason")
        checkpoint.checksum = ckbCurrentField(text, "checksum")
        if (!this.repositoryEventValidationCheckpointSemanticallyValid(checkpoint)) {
            checkpoint.status = "validation_checkpoint_malformed"
            checkpoint.diagnostic = checkpoint.status
            return checkpoint
        }
        if (checkpoint.checksum != ckbRepositoryEventValidationCheckpointChecksum(checkpoint)) {
            checkpoint.status = "validation_checkpoint_checksum_mismatch"
            checkpoint.diagnostic = checkpoint.status
            return checkpoint
        }
        if (text != this.repositoryEventValidationCheckpointText(checkpoint)) {
            checkpoint.status = "validation_checkpoint_malformed"
            checkpoint.diagnostic = "repository_event_validation_checkpoint_noncanonical"
            return checkpoint
        }
        checkpoint.valid = true
        checkpoint.status = "ok"
        checkpoint
    }

    private func repositoryEventValidationCheckpointText(
        checkpoint: CkbRepositoryEventValidationCheckpoint): String {
        var text = "schemaVersion=${CkbCandidateDurableSchema.VALIDATION_RESUME_VERSION}\n"
        text += "eventId=${escapeField(checkpoint.eventId)}\n"
        text += "runKey=${escapeField(checkpoint.runKey)}\n"
        text += "acquisitionId=${escapeField(checkpoint.acquisitionId)}\n"
        text += "planHash=${escapeField(checkpoint.planHash)}\n"
        text += "recordsEvidenceHash=${escapeField(checkpoint.recordsEvidenceHash)}\n"
        text += "candidateVersion=${escapeField(checkpoint.candidateVersion)}\n"
        text += "activeBaseVersion=${escapeField(checkpoint.activeBaseVersion)}\n"
        text += "phase=${escapeField(checkpoint.phase)}\n"
        text += "documentCursor=${checkpoint.documentCursor}\n"
        text += "documentTotal=${checkpoint.documentTotal}\n"
        text += "partitionCursor=${checkpoint.partitionCursor}\n"
        text += "partitionCount=${checkpoint.partitionCount}\n"
        text += "partitionIdsJson=${escapeField(ckbScheduledFetchPathsJson(checkpoint.partitionIds))}\n"
        text += "worksetEvidenceHash=${checkpoint.worksetEvidenceHash}\n"
        text += "currentPartition=${escapeField(checkpoint.currentPartition)}\n"
        text += "completedPartitionsEvidenceHash=${checkpoint.completedPartitionsEvidenceHash}\n"
        text += "exactSymbolHits=${checkpoint.exactSymbolHits}\n"
        text += "docSectionHits=${checkpoint.docSectionHits}\n"
        text += "toolManualHits=${checkpoint.toolManualHits}\n"
        text += "negativeRuleHits=${checkpoint.negativeRuleHits}\n"
        text += "moduleHits=${checkpoint.moduleHits}\n"
        text += "availabilityHits=${checkpoint.availabilityHits}\n"
        text += "deltaEvidenceHash=${checkpoint.deltaEvidenceHash}\n"
        text += "overlayEvidenceHash=${checkpoint.overlayEvidenceHash}\n"
        text += "vectorEvidenceHash=${checkpoint.vectorEvidenceHash}\n"
        text += "validationEvidenceHash=${checkpoint.validationEvidenceHash}\n"
        text += "indexArtifactChecksum=${checkpoint.indexArtifactChecksum}\n"
        text += "transportParityPass=${checkpoint.transportParityPass}\n"
        text += "performancePass=${checkpoint.performancePass}\n"
        text += "vectorHealthPass=${checkpoint.vectorHealthPass}\n"
        text += "performanceP95Cost=${checkpoint.performanceP95Cost}\n"
        text += "performanceEvidenceHash=${checkpoint.performanceEvidenceHash}\n"
        text += "vectorState=${escapeField(checkpoint.vectorState)}\n"
        text += "vectorDimension=${checkpoint.vectorDimension}\n"
        text += "vectorCount=${checkpoint.vectorCount}\n"
        text += "vectorCollection=${escapeField(checkpoint.vectorCollection)}\n"
        text += "vectorStatusEvidenceHash=${checkpoint.vectorStatusEvidenceHash}\n"
        text += "vectorDegradedReason=${escapeField(checkpoint.vectorDegradedReason)}\n"
        text += "checksum=${checkpoint.checksum}\n"
        text
    }

    private func repositoryEventValidationCheckpointIdentityValid(
        checkpoint: CkbRepositoryEventValidationCheckpoint): Bool {
        this.validS4PathSegment(checkpoint.acquisitionId) && checkpoint.eventId.trimAscii() != "" &&
            checkpoint.runKey.trimAscii() != "" && checkpoint.planHash.trimAscii() != "" &&
            ckbP6ValidationEvidenceHashValid(checkpoint.recordsEvidenceHash) &&
            checkpoint.candidateVersion.trimAscii() != "" && checkpoint.activeBaseVersion.trimAscii() != ""
    }

    private func repositoryEventValidationCheckpointSemanticallyValid(
        checkpoint: CkbRepositoryEventValidationCheckpoint): Bool {
        if (!this.repositoryEventValidationCheckpointIdentityValid(checkpoint) ||
            checkpoint.documentCursor < 0 || checkpoint.documentTotal < 0 ||
            checkpoint.documentCursor > checkpoint.documentTotal || checkpoint.partitionCursor < 0 ||
            checkpoint.partitionCount < 0 || checkpoint.partitionCursor > checkpoint.partitionCount ||
            checkpoint.partitionIds.size != checkpoint.partitionCount ||
            checkpoint.exactSymbolHits < 0 ||
            checkpoint.docSectionHits < 0 || checkpoint.toolManualHits < 0 ||
            checkpoint.negativeRuleHits < 0 || checkpoint.moduleHits < 0 ||
            checkpoint.availabilityHits < 0 || checkpoint.performanceP95Cost < 0 ||
            checkpoint.vectorDimension < 0 || checkpoint.vectorCount < 0) {
            return false
        }
        let deltaValid = checkpoint.deltaEvidenceHash == "" || ckbP6ValidationEvidenceHashValid(checkpoint.deltaEvidenceHash)
        let overlayValid = checkpoint.overlayEvidenceHash == "" || ckbP6ValidationEvidenceHashValid(checkpoint.overlayEvidenceHash)
        let vectorValid = checkpoint.vectorEvidenceHash == "" || ckbP6ValidationEvidenceHashValid(checkpoint.vectorEvidenceHash)
        let validationValid = checkpoint.validationEvidenceHash == "" || ckbP6ValidationEvidenceHashValid(checkpoint.validationEvidenceHash)
        let indexArtifactValid = checkpoint.indexArtifactChecksum == "" || ckbP6ValidationEvidenceHashValid(checkpoint.indexArtifactChecksum)
        let performanceEvidenceValid = checkpoint.performanceEvidenceHash == "" || ckbP6ValidationEvidenceHashValid(checkpoint.performanceEvidenceHash)
        let vectorStatusEvidenceValid = checkpoint.vectorStatusEvidenceHash == "" || ckbP6ValidationEvidenceHashValid(checkpoint.vectorStatusEvidenceHash)
        let partitionsValid = checkpoint.completedPartitionsEvidenceHash == "" || ckbP6ValidationEvidenceHashValid(checkpoint.completedPartitionsEvidenceHash)
        let worksetValid = checkpoint.worksetEvidenceHash == "" || ckbP6ValidationEvidenceHashValid(checkpoint.worksetEvidenceHash)
        if (!deltaValid || !overlayValid || !vectorValid || !validationValid || !indexArtifactValid || !performanceEvidenceValid || !vectorStatusEvidenceValid || !partitionsValid || !worksetValid) { return false }
        if (checkpoint.phase == "delta_materialized") { return checkpoint.deltaEvidenceHash != "" }
        if (checkpoint.phase == "overlay_materialized") { return checkpoint.deltaEvidenceHash != "" && checkpoint.overlayEvidenceHash != "" }
        if (checkpoint.phase == "vector_completed") { return checkpoint.deltaEvidenceHash != "" && checkpoint.overlayEvidenceHash != "" && checkpoint.vectorEvidenceHash != "" }
        if (checkpoint.phase == "validation_documents" || checkpoint.phase == "validation_gate" ||
            checkpoint.phase == "completed" || checkpoint.phase == "terminal_failed") {
            let requiresIndexArtifact = checkpoint.phase == "completed" ||
                checkpoint.currentPartition == "index_ready" ||
                checkpoint.currentPartition == "parity_completed"
            let completedGateValid = checkpoint.phase != "completed" ||
                (checkpoint.transportParityPass && checkpoint.performancePass &&
                    checkpoint.vectorHealthPass && checkpoint.performanceP95Cost > 0 &&
                    checkpoint.performanceEvidenceHash != "" && checkpoint.vectorState != "" &&
                    checkpoint.vectorDimension > 0 && checkpoint.vectorDegradedReason == "")
            return checkpoint.deltaEvidenceHash != "" && checkpoint.overlayEvidenceHash != "" &&
                checkpoint.vectorEvidenceHash != "" && checkpoint.validationEvidenceHash != "" &&
                checkpoint.completedPartitionsEvidenceHash != "" && checkpoint.worksetEvidenceHash != "" &&
                checkpoint.partitionCount > 0 &&
                (!requiresIndexArtifact || checkpoint.indexArtifactChecksum != "") &&
                completedGateValid
        }
        false
    }

    public func saveRepositoryEventValidationIndexArtifact(
        checkpoint: CkbRepositoryEventValidationCheckpoint,
        index: CangjieServingIndex): CkbRepositoryEventValidationIndexArtifact {
        let artifact = CkbRepositoryEventValidationIndexArtifact()
        artifact.acquisitionId = checkpoint.acquisitionId
        artifact.recordsEvidenceHash = checkpoint.recordsEvidenceHash
        artifact.activeBaseVersion = checkpoint.activeBaseVersion
        artifact.documentCount = index.documents.size
        artifact.documentEvidenceHash = ckbRepositoryEventValidationIndexDocumentsEvidenceHash(
            index.documents)
        if (!this.repositoryEventValidationIndexArtifactIdentityValid(artifact) ||
            artifact.documentCount <= 0 ||
            !ckbP6ValidationEvidenceHashValid(artifact.documentEvidenceHash)) {
            artifact.status = "validation_index_artifact_invalid"
            return artifact
        }
        artifact.checksum = ckbRepositoryEventValidationIndexArtifactChecksum(artifact)
        try {
            let batchSize = CkbCandidateDurableSchema.VALIDATION_INDEX_ARTIFACT_BATCH_SIZE
            var batchIndex: Int64 = 0
            var start: Int64 = 0
            while (start < index.documents.size) {
                let end = if (start + batchSize < index.documents.size) {
                    start + batchSize
                } else { index.documents.size }
                let documents = ArrayList<CangjieServingDocument>()
                for (offset in start..end) { documents.add(index.documents[offset]) }
                let text = this.repositoryEventValidationIndexArtifactBatchText(artifact,
                    batchIndex, documents)
                let path = ckbRepositoryEventValidationIndexArtifactBatchPath(
                    artifact.acquisitionId, batchIndex)
                this.writeLinesAtomically(path, text)
                if (this.readText(path) != text) {
                    artifact.status = "validation_index_artifact_readback_failed"
                    return artifact
                }
                start = end
                batchIndex += 1
            }
            let manifest = this.repositoryEventValidationIndexArtifactText(artifact)
            this.writeLinesAtomically(
                ckbRepositoryEventValidationIndexArtifactPath(artifact.acquisitionId), manifest)
            if (this.readText(ckbRepositoryEventValidationIndexArtifactPath(
                artifact.acquisitionId)) != manifest) {
                artifact.status = "validation_index_artifact_readback_failed"
                return artifact
            }
        } catch (_: Exception) {
            artifact.status = "validation_index_artifact_write_failed"
            return artifact
        }
        artifact.valid = true
        artifact.status = "ok"
        artifact
    }

    public func loadRepositoryEventValidationIndexArtifact(
        checkpoint: CkbRepositoryEventValidationCheckpoint): CkbRepositoryEventValidationIndexArtifact {
        let artifact = CkbRepositoryEventValidationIndexArtifact()
        artifact.acquisitionId = checkpoint.acquisitionId
        artifact.recordsEvidenceHash = checkpoint.recordsEvidenceHash
        artifact.activeBaseVersion = checkpoint.activeBaseVersion
        if (!this.repositoryEventValidationIndexArtifactIdentityValid(artifact)) {
            artifact.status = "validation_index_artifact_identity_invalid"
            return artifact
        }
        let relative = ckbRepositoryEventValidationIndexArtifactPath(artifact.acquisitionId)
        if (!this.has(relative)) { return artifact }
        let text = try { this.readText(relative) } catch (_: Exception) {
            artifact.status = "invalid_response_encoding"
            return artifact
        }
        if (text == "" || ckbCurrentField(text, "schemaVersion") !=
            "p6-validation-index-artifact-v2") {
            artifact.status = "validation_index_artifact_malformed"
            return artifact
        }
        artifact.acquisitionId = ckbCurrentField(text, "acquisitionId")
        artifact.recordsEvidenceHash = ckbCurrentField(text, "recordsEvidenceHash")
        artifact.activeBaseVersion = ckbCurrentField(text, "activeBaseVersion")
        artifact.documentEvidenceHash = ckbCurrentField(text, "documentEvidenceHash")
        artifact.documentCount = parseIntField(ckbCurrentField(text, "documentCount"), -1)
        artifact.checksum = ckbCurrentField(text, "checksum")
        let batchSize = CkbCandidateDurableSchema.VALIDATION_INDEX_ARTIFACT_BATCH_SIZE
        let batchCount = (artifact.documentCount + batchSize - 1) / batchSize
        for (batchIndex in 0..batchCount) {
            let batchPath = ckbRepositoryEventValidationIndexArtifactBatchPath(
                artifact.acquisitionId, batchIndex)
            let batchText = try { this.readText(batchPath) } catch (_: Exception) {
                artifact.status = "invalid_response_encoding"
                return artifact
            }
            if (!this.repositoryEventValidationIndexArtifactLoadBatch(artifact,
                batchIndex, batchText)) { return artifact }
        }
        if (artifact.acquisitionId != checkpoint.acquisitionId ||
            artifact.recordsEvidenceHash != checkpoint.recordsEvidenceHash ||
            artifact.activeBaseVersion != checkpoint.activeBaseVersion) {
            artifact.status = "validation_index_artifact_identity_mismatch"
            return artifact
        }
        if (!this.repositoryEventValidationIndexArtifactValid(artifact) ||
            artifact.checksum != ckbRepositoryEventValidationIndexArtifactChecksum(artifact)) {
            artifact.status = "validation_index_artifact_checksum_mismatch"
            return artifact
        }
        if (text != this.repositoryEventValidationIndexArtifactText(artifact)) {
            artifact.status = "validation_index_artifact_malformed"
            return artifact
        }
        artifact.valid = true
        artifact.status = "ok"
        artifact
    }

    private func repositoryEventValidationIndexArtifactText(
        artifact: CkbRepositoryEventValidationIndexArtifact): String {
        var text = "schemaVersion=p6-validation-index-artifact-v2\n"
        text += "acquisitionId=${escapeField(artifact.acquisitionId)}\n"
        text += "recordsEvidenceHash=${artifact.recordsEvidenceHash}\n"
        text += "activeBaseVersion=${escapeField(artifact.activeBaseVersion)}\n"
        text += "documentEvidenceHash=${artifact.documentEvidenceHash}\n"
        text += "documentCount=${artifact.documentCount}\n"
        text += "checksum=${artifact.checksum}\n"
        text
    }

    private func repositoryEventValidationIndexArtifactBatchText(
        artifact: CkbRepositoryEventValidationIndexArtifact, batchIndex: Int64,
        documents: ArrayList<CangjieServingDocument>): String {
        let evidence = ckbRepositoryEventValidationIndexDocumentsEvidenceHash(documents)
        let checksum = ckbReleaseEvidenceHash("${artifact.checksum}|${batchIndex}|${documents.size}|${evidence}")
        var text = "schemaVersion=p6-validation-index-artifact-batch-v1\n"
        text += "acquisitionId=${escapeField(artifact.acquisitionId)}\n"
        text += "batchIndex=${batchIndex}\ndocumentCount=${documents.size}\n"
        text += "documentEvidenceHash=${evidence}\n"
        for (document in documents) {
            text += this.repositoryEventValidationIndexArtifactDocumentLine(document)
        }
        text += "checksum=${checksum}\n"
        text
    }

    private func repositoryEventValidationIndexArtifactDocumentLine(
        document: CangjieServingDocument): String {
        "document=${escapeField(document.documentId)}|${escapeField(document.recordKind)}|${escapeField(document.title)}|${escapeField(document.text)}|${escapeField(document.symbolKey)}|${escapeField(document.module)}|${escapeField(document.sourceSet)}|${escapeField(document.trustLevel)}|${escapeField(document.reviewState)}|${escapeField(document.targetVersion)}|${escapeField(document.versionResolutionId)}|${escapeField(document.contentHash)}|${escapeField(document.citation)}|${escapeField(document.sourceId)}|${escapeField(document.rankProfile)}|${document.rejected}|${escapeField(document.diagnostic)}\n"
    }

    private func repositoryEventValidationIndexArtifactLoadBatch(
        artifact: CkbRepositoryEventValidationIndexArtifact, batchIndex: Int64,
        text: String): Bool {
        if (text == "" || ckbCurrentField(text, "schemaVersion") !=
            "p6-validation-index-artifact-batch-v1" ||
            ckbCurrentField(text, "acquisitionId") != artifact.acquisitionId ||
            parseIntField(ckbCurrentField(text, "batchIndex"), -1) != batchIndex) {
            artifact.status = "validation_index_artifact_malformed"
            return false
        }
        let documents = ArrayList<CangjieServingDocument>()
        for (line in text.split("\n")) {
            if (!line.startsWith("document=")) { continue }
            let fields = line[9..line.size].split("|")
            if (fields.size != 17 || (fields[15] != "true" && fields[15] != "false")) {
                artifact.status = "validation_index_artifact_malformed"
                return false
            }
            let document = CangjieServingDocument()
            document.documentId = unescapeField(fields[0])
            document.recordKind = unescapeField(fields[1])
            document.title = unescapeField(fields[2])
            document.text = unescapeField(fields[3])
            document.symbolKey = unescapeField(fields[4])
            document.module = unescapeField(fields[5])
            document.sourceSet = unescapeField(fields[6])
            document.trustLevel = unescapeField(fields[7])
            document.reviewState = unescapeField(fields[8])
            document.targetVersion = unescapeField(fields[9])
            document.versionResolutionId = unescapeField(fields[10])
            document.contentHash = unescapeField(fields[11])
            document.citation = unescapeField(fields[12])
            document.sourceId = unescapeField(fields[13])
            document.rankProfile = unescapeField(fields[14])
            document.rejected = fields[15] == "true"
            document.diagnostic = unescapeField(fields[16])
            documents.add(document)
        }
        let evidence = ckbRepositoryEventValidationIndexDocumentsEvidenceHash(documents)
        let expected = ckbReleaseEvidenceHash("${artifact.checksum}|${batchIndex}|${documents.size}|${evidence}")
        if (parseIntField(ckbCurrentField(text, "documentCount"), -1) != documents.size ||
            ckbCurrentField(text, "documentEvidenceHash") != evidence ||
            ckbCurrentField(text, "checksum") != expected ||
            text != this.repositoryEventValidationIndexArtifactBatchText(artifact,
                batchIndex, documents)) {
            artifact.status = "validation_index_artifact_checksum_mismatch"
            return false
        }
        for (document in documents) { artifact.documents.add(document) }
        true
    }

    private func repositoryEventValidationIndexArtifactIdentityValid(
        artifact: CkbRepositoryEventValidationIndexArtifact): Bool {
        this.validS4PathSegment(artifact.acquisitionId) &&
            ckbP6ValidationEvidenceHashValid(artifact.recordsEvidenceHash) &&
            artifact.activeBaseVersion.trimAscii() != ""
    }

    private func repositoryEventValidationIndexArtifactValid(
        artifact: CkbRepositoryEventValidationIndexArtifact): Bool {
        this.repositoryEventValidationIndexArtifactIdentityValid(artifact) &&
            artifact.documentCount > 0 && artifact.documents.size == artifact.documentCount &&
            artifact.documentEvidenceHash ==
                ckbRepositoryEventValidationIndexDocumentsEvidenceHash(artifact.documents) &&
            ckbP6ValidationEvidenceHashValid(artifact.documentEvidenceHash)
    }

    private func saveLiveCandidateLifecycleMetadata(status: KnowledgeStatus): Unit {
        let pointer = this.loadActiveSnapshotPointer()
        if (pointer.valid) {
            let liveText = this.readLines("metadata/status.ckb")
            let live = this.loadMetadataStatusFromPrefix("")
            if (liveText == "" || live.activeVersion != pointer.activeVersion ||
                status.activeKnowledgeVersion != pointer.activeVersion) {
                throw Exception("candidate_lifecycle_active_identity_mismatch")
            }
            this.writeLinesAtomically("metadata/status.ckb",
                this.metadataWithCandidateLifecycle(liveText,
                    status.candidateKnowledgeVersion,
                    status.failedCandidateVersion))
        } else if (this.hasAuthoritativeActiveSnapshotPointer()) {
            throw Exception("candidate_lifecycle_active_pointer_invalid")
        } else {
            this.saveMetadata(status)
        }
    }

    private func metadataWithCandidateLifecycle(text: String, candidateVersion: String,
        failedVersion: String): String {
        let out = StringBuilder()
        var candidateFound = false
        var failedFound = false
        for (line in text.split("\n")) {
            if (line == "") { continue }
            if (line.startsWith("candidate=")) {
                out.append("candidate=${candidateVersion}\n")
                candidateFound = true
            } else if (line.startsWith("failed=")) {
                out.append("failed=${failedVersion}\n")
                failedFound = true
            } else {
                out.append(line)
                out.append("\n")
            }
        }
        if (!candidateFound) { out.append("candidate=${candidateVersion}\n") }
        if (!failedFound) { out.append("failed=${failedVersion}\n") }
        out.toString()
    }

    public func saveCandidateCollectionOwner(owner: CkbCandidateCollectionOwner): CkbCandidateCollectionOwner {
        owner.relativePath = this.candidateCollectionOwnerPath(owner.collection)
        owner.evidenceHash = ckbCandidateCollectionOwnerEvidenceHash(owner)
        var text = "schemaVersion=${CkbCandidateDurableSchema.VERSION}\n"
        text += "collection=${escapeField(owner.collection)}\n"
        text += "acquisitionId=${escapeField(owner.acquisitionId)}\n"
        text += "schedulerRunId=${escapeField(owner.schedulerRunId)}\n"
        text += "taskId=${escapeField(owner.taskId)}\n"
        text += "candidateVersion=${escapeField(owner.candidateVersion)}\n"
        text += "planHash=${escapeField(owner.planHash)}\n"
        text += "recordsEvidenceHash=${escapeField(owner.recordsEvidenceHash)}\n"
        text += "state=${escapeField(owner.state)}\n"
        text += "evidenceHash=${owner.evidenceHash}\n"
        this.writeLinesAtomically(owner.relativePath, text)
        owner.valid = true
        owner.status = "ok"
        owner
    }

    public func loadCandidateCollectionOwner(collection: String): CkbCandidateCollectionOwner {
        let owner = CkbCandidateCollectionOwner()
        owner.collection = collection
        owner.relativePath = this.candidateCollectionOwnerPath(collection)
        let text = try { this.readText(owner.relativePath) } catch (_: Exception) {
            owner.status = "invalid_response_encoding"
            owner.diagnostic = "candidate_owner_invalid_response_encoding"
            return owner
        }
        if (text == "") { return owner }
        if (ckbCurrentField(text, "schemaVersion") != CkbCandidateDurableSchema.VERSION) {
            owner.status = "owner_schema_mismatch"
            owner.diagnostic = owner.status
            return owner
        }
        owner.collection = ckbCurrentField(text, "collection")
        owner.acquisitionId = ckbCurrentField(text, "acquisitionId")
        owner.schedulerRunId = ckbCurrentField(text, "schedulerRunId")
        owner.taskId = ckbCurrentField(text, "taskId")
        owner.candidateVersion = ckbCurrentField(text, "candidateVersion")
        owner.planHash = ckbCurrentField(text, "planHash")
        owner.recordsEvidenceHash = ckbCurrentField(text, "recordsEvidenceHash")
        owner.state = ckbCurrentField(text, "state")
        owner.evidenceHash = ckbCurrentField(text, "evidenceHash")
        let knownState = owner.state == "planned" || owner.state == "adopted" || owner.state == "committed_active" || owner.state == "cleaned" || owner.state == "cleanup_pending"
        owner.valid = owner.collection == collection && knownState && owner.evidenceHash == ckbCandidateCollectionOwnerEvidenceHash(owner)
        owner.status = if (owner.valid) { "ok" } else if (!knownState) { "owner_state_unknown" } else { "owner_evidence_mismatch" }
        owner.diagnostic = if (owner.valid) { "" } else { owner.status }
        owner
    }

    public func listCandidateCollectionOwners(): ArrayList<CkbCandidateCollectionOwner> {
        let out = ArrayList<CkbCandidateCollectionOwner>()
        let root = this.root.join("metadata/candidate-collection-owners")
        if (!exists(root)) { return out }
        try {
            for (entry in Directory.readFrom(root)) {
                if (!entry.isRegular() || !entry.name.endsWith(".ckb")) { continue }
                let text = try { String.fromUtf8(File.readFrom(root.join(entry.name))) } catch (_: Exception) {
                    let invalid = CkbCandidateCollectionOwner()
                    invalid.status = "invalid_response_encoding"
                    invalid.diagnostic = "candidate_owner_invalid_response_encoding:${ckbReleaseEvidenceHash(entry.name)}"
                    invalid.relativePath = "metadata/candidate-collection-owners/${entry.name}"
                    out.add(invalid)
                    continue
                }
                let collection = ckbCurrentField(text, "collection")
                if (collection != "") {
                    out.add(this.loadCandidateCollectionOwner(collection))
                } else {
                    let invalid = CkbCandidateCollectionOwner()
                    invalid.status = "owner_collection_missing"
                    invalid.diagnostic = "candidate_owner_collection_missing:${ckbReleaseEvidenceHash(entry.name)}"
                    invalid.relativePath = "metadata/candidate-collection-owners/${entry.name}"
                    out.add(invalid)
                }
            }
        } catch (_: Exception) {
            ()
        }
        out
    }

    public func writeVectorSpoolBatch(descriptor: CkbVectorSpoolDescriptor, batchIndex: Int64, records: ArrayList<VectorRecord>, deadlineAtMillis!: Int64 = 0): String {
        let relative = "metadata/vector-builds/${descriptor.acquisitionId}/batches/batch-${batchIndex}.ckb"
        this.writeVectorRecordsAtomically(relative, records, deadlineAtMillis, "vector_spool_batch")
        relative
    }

    public func vectorSpoolBatchEvidenceHash(records: ArrayList<VectorRecord>): String {
        ckbReleaseEvidenceHash(this.vectorLines(records))
    }

    public func loadVectorSpoolBatch(relative: String, expectedHash: String): CkbVectorSpoolBatchLoadResult {
        let result = CkbVectorSpoolBatchLoadResult()
        if (!this.validVectorSpoolBatchPath(relative) || expectedHash == "") {
            result.status = "vector_spool_path_invalid"
            result.diagnostic = result.status
            return result
        }
        let text = try { this.readText(relative) } catch (_: Exception) {
            result.status = "invalid_response_encoding"
            result.diagnostic = "vector_spool_invalid_response_encoding"
            return result
        }
        if (text == "") { return result }
        result.evidenceHash = ckbReleaseEvidenceHash(text)
        if (result.evidenceHash != expectedHash) {
            result.status = "vector_spool_hash_mismatch"
            result.diagnostic = result.status
            return result
        }
        if (!this.vectorSpoolTextSchemaValid(text)) {
            result.status = "vector_spool_schema_mismatch"
            result.diagnostic = result.status
            return result
        }
        result.records = this.parseVector(text)
        if (result.records.size == 0) {
            result.status = "vector_spool_malformed"
            result.diagnostic = result.status
            return result
        }
        result.valid = true
        result.status = "ok"
        result
    }

    public func saveVectorSpoolCheckpoint(descriptor: CkbVectorSpoolDescriptor, completed!: Bool = false): Unit {
        descriptor.checkpointRelativePath = "metadata/vector-builds/${descriptor.acquisitionId}/checkpoint.ckb"
        descriptor.manifestRelativePath = "metadata/vector-builds/${descriptor.acquisitionId}/manifest.ckb"
        descriptor.evidenceHash = this.vectorSpoolDescriptorEvidenceHash(descriptor)
        var text = "schemaVersion=${CkbCandidateDurableSchema.VERSION}\n"
        text += "acquisitionId=${escapeField(descriptor.acquisitionId)}\n"
        text += "candidateVersion=${escapeField(descriptor.candidateVersion)}\n"
        text += "planHash=${escapeField(descriptor.planHash)}\n"
        text += "recordsEvidenceHash=${escapeField(descriptor.recordsEvidenceHash)}\n"
        text += "collection=${escapeField(descriptor.collection)}\n"
        text += "status=${escapeField(if (completed) { "completed" } else { descriptor.status })}\n"
        text += "total=${descriptor.total}\ncompleted=${descriptor.completed}\nreused=${descriptor.reused}\nembedded=${descriptor.embedded}\nfailed=${descriptor.failed}\n"
        text += "batchSize=${descriptor.batchSize}\npeakBufferedRecords=${descriptor.peakBufferedRecords}\npeakBufferedBytes=${descriptor.peakBufferedBytes}\n"
        text += "batchPathsJson=${escapeField(ckbScheduledFetchPathsJson(descriptor.batchRelativePaths))}\n"
        text += "batchHashesJson=${escapeField(ckbScheduledFetchPathsJson(descriptor.batchEvidenceHashes))}\n"
        text += "batchCountsJson=${escapeField(ckbScheduledFetchPathsJson(descriptor.batchRecordCounts))}\n"
        text += "evidenceHash=${descriptor.evidenceHash}\n"
        this.writeLinesAtomically(descriptor.checkpointRelativePath, text)
        if (completed) { this.writeLinesAtomically(descriptor.manifestRelativePath, text) }
    }

    public func loadVectorSpoolCheckpoint(context: CkbCandidateAcquisitionContext, collection: String): CkbVectorSpoolDescriptor {
        let descriptor = CkbVectorSpoolDescriptor()
        if (!this.validS4PathSegment(context.acquisitionId)) {
            descriptor.status = "vector_checkpoint_identity_mismatch"
            descriptor.diagnostic = descriptor.status
            return descriptor
        }
        descriptor.acquisitionId = context.acquisitionId
        descriptor.checkpointRelativePath = "metadata/vector-builds/${context.acquisitionId}/checkpoint.ckb"
        let text = try { this.readText(descriptor.checkpointRelativePath) } catch (_: Exception) {
            descriptor.status = "invalid_response_encoding"
            descriptor.diagnostic = "vector_checkpoint_invalid_response_encoding"
            return descriptor
        }
        if (text == "") { return descriptor }
        if (ckbCurrentField(text, "schemaVersion") != CkbCandidateDurableSchema.VERSION) {
            descriptor.status = "vector_checkpoint_schema_mismatch"
            descriptor.diagnostic = descriptor.status
            return descriptor
        }
        descriptor.acquisitionId = ckbCurrentField(text, "acquisitionId")
        descriptor.candidateVersion = ckbCurrentField(text, "candidateVersion")
        descriptor.planHash = ckbCurrentField(text, "planHash")
        descriptor.recordsEvidenceHash = ckbCurrentField(text, "recordsEvidenceHash")
        descriptor.collection = ckbCurrentField(text, "collection")
        descriptor.status = ckbCurrentField(text, "status")
        descriptor.total = parseIntField(ckbCurrentField(text, "total"), -1)
        descriptor.completed = parseIntField(ckbCurrentField(text, "completed"), -1)
        descriptor.reused = parseIntField(ckbCurrentField(text, "reused"), 0)
        descriptor.embedded = parseIntField(ckbCurrentField(text, "embedded"), 0)
        descriptor.failed = parseIntField(ckbCurrentField(text, "failed"), 0)
        descriptor.batchSize = parseIntField(ckbCurrentField(text, "batchSize"), CkbCandidateDurableSchema.VECTOR_BATCH_SIZE)
        descriptor.peakBufferedRecords = parseIntField(ckbCurrentField(text, "peakBufferedRecords"), 0)
        descriptor.peakBufferedBytes = parseIntField(ckbCurrentField(text, "peakBufferedBytes"), 0)
        let pathsOk = ckbCandidateDecodeOrderedJsonStrings(ckbCurrentField(text, "batchPathsJson"), descriptor.batchRelativePaths)
        let hashesOk = ckbCandidateDecodeOrderedJsonStrings(ckbCurrentField(text, "batchHashesJson"), descriptor.batchEvidenceHashes)
        let countsOk = ckbCandidateDecodeOrderedJsonStrings(ckbCurrentField(text, "batchCountsJson"), descriptor.batchRecordCounts)
        descriptor.evidenceHash = ckbCurrentField(text, "evidenceHash")
        let identityOk = descriptor.acquisitionId == context.acquisitionId &&
            descriptor.candidateVersion == context.candidateVersion &&
            descriptor.planHash == context.planHash &&
            descriptor.recordsEvidenceHash == context.recordsEvidenceHash &&
            descriptor.collection == collection
        var committedPathsValid = pathsOk && hashesOk && countsOk && descriptor.batchRelativePaths.size == descriptor.batchEvidenceHashes.size && descriptor.batchRelativePaths.size == descriptor.batchRecordCounts.size
        var committedCount: Int64 = 0
        if (committedPathsValid) {
            for (index in 0..descriptor.batchRelativePaths.size) {
                let expectedPath = "metadata/vector-builds/${context.acquisitionId}/batches/batch-${index}.ckb"
                let batchCount = parseIntField(descriptor.batchRecordCounts[index], -1)
                if (descriptor.batchRelativePaths[index] != expectedPath || !this.validVectorSpoolBatchPath(descriptor.batchRelativePaths[index]) || descriptor.batchEvidenceHashes[index] == "" || batchCount <= 0 || batchCount > descriptor.batchSize) {
                    committedPathsValid = false
                    break
                }
                committedCount += batchCount
            }
        }
        if (committedCount != descriptor.completed) { committedPathsValid = false }
        descriptor.valid = identityOk && committedPathsValid &&
            descriptor.total >= 0 && descriptor.completed >= 0 && descriptor.completed <= descriptor.total &&
            descriptor.reused >= 0 && descriptor.embedded >= 0 && descriptor.reused + descriptor.embedded == descriptor.completed &&
            descriptor.evidenceHash == this.vectorSpoolDescriptorEvidenceHash(descriptor)
        if (!descriptor.valid) {
            descriptor.status = if (!identityOk) { "vector_checkpoint_identity_mismatch" } else { "vector_checkpoint_hash_mismatch" }
            descriptor.diagnostic = descriptor.status
        }
        descriptor
    }

    private func ckbCandidateDecodeOrderedJsonStrings(raw: String, out: ArrayList<String>): Bool {
        try {
            let items = JsonValue.fromStr(raw).asArray().getItems()
            for (item in items) {
                let value = item.asString().getValue()
                if (value == "") { return false }
                out.add(value)
            }
            true
        } catch (_: Exception) {
            false
        }
    }

    public func streamVectorSpoolToFile(relative: String, descriptor: CkbVectorSpoolDescriptor, deadlineAtMillis: Int64): Unit {
        let path = this.root.join(relative)
        if (!exists(path.parent)) { Directory.create(path.parent, recursive: true) }
        let tmp = this.atomicTmpPath(path, relative)
        try {
            var written: Int64 = 0
            try (file = File(tmp, OpenMode.Write)) {
                for (index in 0..descriptor.batchRelativePaths.size) {
                    this.ensureActiveSnapshotDeadline("vector_spool_stream:${index}:${descriptor.batchRelativePaths.size}", deadlineAtMillis)
                    let batch = this.loadVectorSpoolBatch(descriptor.batchRelativePaths[index], descriptor.batchEvidenceHashes[index])
                    if (!batch.valid || batch.records.size != parseIntField(descriptor.batchRecordCounts[index], -1)) { throw Exception(if (!batch.valid) { batch.diagnostic } else { "vector_spool_batch_count_mismatch" }) }
                    for (record in batch.records) { file.write(this.vectorLine(record).toArray()); written += 1 }
                }
            }
            if (written != descriptor.total) { throw Exception("vector_spool_count_mismatch:${written}:${descriptor.total}") }
            this.replaceFileWithTmp(path, tmp)
        } catch (e: Exception) {
            this.deleteAtomicTmp(tmp)
            throw e
        }
    }

    public func deleteS4ArtifactTree(relative: String): Bool {
        if ((!relative.startsWith("metadata/vector-builds/") && !relative.startsWith("candidate-artifacts/")) ||
            relative.contains("..") || relative.contains("\u{0000}")) {
            return false
        }
        let path = this.root.join(relative)
        if (!exists(path)) { return true }
        try { launch("/bin/rm", ["-rf", path.toString()]).wait() == 0 && !exists(path) } catch (_: Exception) { false }
    }

    public func deleteS4ArtifactFile(relative: String): Bool {
        if (!this.validVectorSpoolBatchPath(relative)) { return false }
        let path = this.root.join(relative)
        if (!exists(path)) { return true }
        try { launch("/bin/rm", ["-f", path.toString()]).wait() == 0 && !exists(path) } catch (_: Exception) { false }
    }

    public func cleanupVectorBuildStaleTemps(acquisitionId: String): Int64 {
        if (!this.validS4PathSegment(acquisitionId)) { return 0 }
        this.cleanupS4TmpFiles(this.root.join("metadata/vector-builds/${acquisitionId}"), "")
    }

    public func cleanupReleaseAcquisitionStaleTemps(acquisitionId: String): Int64 {
        if (!this.validS4PathSegment(acquisitionId) || !acquisitionId.startsWith("p5-acq-")) { return 0 }
        this.cleanupS4TmpFiles(this.root.join("metadata/release-acquisitions/${acquisitionId}"), "")
    }

    public func cleanupCandidateOwnerStaleTemps(): Int64 {
        this.cleanupS4TmpFiles(this.root.join("metadata/candidate-collection-owners"), "")
    }

    private func cleanupCandidateStaleTemps(version: String): Unit {
        let safeVersion = safeName(version)
        if (safeVersion == "" || version.contains("..") || version.contains("/") || version.contains("\\") || version.contains("\u{0000}")) { return }
        _ = this.cleanupS4TmpFiles(this.root.join("raw/candidate/${safeVersion}"), "")
        _ = this.cleanupS4TmpFiles(this.root.join("candidate-artifacts/${safeVersion}"), "")
        _ = this.cleanupS4TmpFiles(this.root.join("normalized/candidate"), safeVersion)
    }

    private func cleanupS4TmpFiles(rootPath: Path, requiredToken: String): Int64 {
        if (!exists(rootPath)) { return 0 }
        var removed: Int64 = 0
        try {
            for (entry in Directory.readFrom(rootPath)) {
                let child = rootPath.join(entry.name)
                if (entry.isDirectory()) {
                    removed += this.cleanupS4TmpFiles(child, requiredToken)
                } else if (entry.isRegular() && entry.name.startsWith(".tmp-") && (requiredToken == "" || entry.name.contains(requiredToken))) {
                    if (launch("/bin/rm", ["-f", child.toString()]).wait() == 0 && !exists(child)) { removed += 1 }
                }
            }
        } catch (_: Exception) { () }
        removed
    }

    private func trySaveCandidateMaterializationCheckpoint(version: String, phase: String, completedBatches: Int64, totalBatches: Int64, manifestEvidenceHash: String): Bool {
        try {
            let evidenceHash = ckbReleaseEvidenceHash("${version}|${phase}|${completedBatches}|${totalBatches}|${manifestEvidenceHash}")
            var text = "schemaVersion=${CkbCandidateDurableSchema.VERSION}\n"
            text += "version=${escapeField(version)}\nphase=${escapeField(phase)}\n"
            text += "completedBatches=${completedBatches}\ntotalBatches=${totalBatches}\n"
            text += "manifestEvidenceHash=${manifestEvidenceHash}\nupdatedAtMillis=${ckbCoreNowMillis()}\n"
            text += "evidenceHash=${evidenceHash}\n"
            this.writeLinesAtomically("candidate-artifacts/${safeName(version)}/checkpoint.ckb", text)
            true
        } catch (_: Exception) { false }
    }

    private func loadCandidateMaterializationCheckpoint(version: String, expectedManifestEvidenceHash: String, expectedTotalBatches: Int64): CkbCandidateMaterializationCheckpoint {
        let checkpoint = CkbCandidateMaterializationCheckpoint()
        let relative = "candidate-artifacts/${safeName(version)}/checkpoint.ckb"
        let text = try { this.readText(relative) } catch (_: Exception) { checkpoint.status = "invalid_response_encoding"; return checkpoint }
        if (text == "") { return checkpoint }
        checkpoint.phase = ckbCurrentField(text, "phase")
        checkpoint.completedBatches = parseIntField(ckbCurrentField(text, "completedBatches"), -1)
        checkpoint.totalBatches = parseIntField(ckbCurrentField(text, "totalBatches"), -1)
        checkpoint.manifestEvidenceHash = ckbCurrentField(text, "manifestEvidenceHash")
        checkpoint.evidenceHash = ckbCurrentField(text, "evidenceHash")
        let expectedEvidence = ckbReleaseEvidenceHash("${version}|${checkpoint.phase}|${checkpoint.completedBatches}|${checkpoint.totalBatches}|${checkpoint.manifestEvidenceHash}")
        let phaseRank = this.candidateCheckpointPhaseRank(checkpoint.phase)
        let cursorValid = if (phaseRank < 3) { checkpoint.completedBatches == 0 } else if (phaseRank == 4) { checkpoint.completedBatches == checkpoint.totalBatches } else { checkpoint.completedBatches >= 0 && checkpoint.completedBatches <= checkpoint.totalBatches }
        checkpoint.valid = ckbCurrentField(text, "schemaVersion") == CkbCandidateDurableSchema.VERSION && ckbCurrentField(text, "version") == version && checkpoint.totalBatches == expectedTotalBatches && checkpoint.manifestEvidenceHash == expectedManifestEvidenceHash && phaseRank >= 0 && cursorValid && checkpoint.evidenceHash == expectedEvidence
        checkpoint.status = if (checkpoint.valid) { "ok" } else { "candidate_checkpoint_invalid" }
        checkpoint
    }

    private func candidateCheckpointPhaseRank(phase: String): Int64 {
        if (phase == "before") { return 0 }
        if (phase == "raw_committed") { return 1 }
        if (phase == "normalized_committed") { return 2 }
        if (phase == "batch_committed") { return 3 }
        if (phase == "completed") { return 4 }
        -1
    }

    private func validS4PathSegment(value: String): Bool {
        let clean = value.trimAscii()
        clean != "" && clean == value && !clean.contains("/") && !clean.contains("\\") && !clean.contains("..") && !clean.contains("\u{0000}")
    }

    private func validVectorSpoolBatchPath(relative: String): Bool {
        relative.startsWith("metadata/vector-builds/") && relative.contains("/batches/batch-") && relative.endsWith(".ckb") &&
            !relative.startsWith("/") && !relative.contains("..") && !relative.contains("\\") && !relative.contains("\u{0000}")
    }

    private func candidateCollectionOwnerPath(collection: String): String {
        "metadata/candidate-collection-owners/${ckbReleaseEvidenceHash(collection)}.ckb"
    }

    private func candidateRawEvidenceHash(records: ArrayList<RawRecord>): String {
        let digest = SHA256()
        for (record in records) {
            digest.write(record.sourceId.toArray())
            digest.write(":".toArray())
            digest.write(record.contentHash.toArray())
            digest.write("|".toArray())
        }
        this.candidateDigestHex(digest)
    }

    private func candidateNormalizedEvidenceHash(records: ArrayList<NormalizedRecord>): String {
        let digest = SHA256()
        for (record in records) {
            digest.write(record.sourceId.toArray())
            digest.write(":".toArray())
            digest.write(ckbReleaseEvidenceHash("${record.sourceId}|${record.recordKind}|${record.title}|${record.chunk}|${record.citation}").toArray())
            digest.write("|".toArray())
        }
        this.candidateDigestHex(digest)
    }

    private func candidateRawFileHash(records: ArrayList<RawRecord>, deadlineAtMillis: Int64): String {
        let digest = SHA256()
        for (index in 0..records.size) { if (index % 256 == 0) { this.ensureActiveSnapshotDeadline("candidate_raw_hash:${index}:${records.size}", deadlineAtMillis) }; digest.write(this.rawLine(records[index]).toArray()) }
        this.candidateDigestHex(digest)
    }

    private func candidateNormalizedFileHash(records: ArrayList<NormalizedRecord>, start: Int64, end: Int64, deadlineAtMillis: Int64): String {
        let digest = SHA256()
        for (index in start..end) { if ((index - start) % 256 == 0) { this.ensureActiveSnapshotDeadline("candidate_normalized_hash:${index}:${end}", deadlineAtMillis) }; digest.write(this.normalizedLine(records[index]).toArray()) }
        this.candidateDigestHex(digest)
    }

    private func candidateFileHashMatches(relative: String, expectedHash: String, deadlineAtMillis: Int64): Bool {
        if (expectedHash == "" || relative.startsWith("/") || relative.contains("..") || relative.contains("\u{0000}")) { return false }
        let path = this.root.join(relative)
        if (!exists(path)) { return false }
        let digest = SHA256()
        try {
            try (file = File(path, OpenMode.Read)) {
                let buffer = Array<Byte>(65536, repeat: 0)
                while (true) {
                    this.ensureActiveSnapshotDeadline("candidate_file_hash:${ckbReleaseEvidenceHash(relative)}", deadlineAtMillis)
                    let read = file.read(buffer)
                    if (read <= 0) { break }
                    if (read == buffer.size) { digest.write(buffer) } else { digest.write(buffer[0..read].clone()) }
                }
            }
            this.candidateDigestHex(digest) == expectedHash
        } catch (e: Exception) {
            if (e.message.startsWith("deadline_exceeded:")) { throw e }
            false
        }
    }

    private func candidateDigestHex(digest: SHA256): String {
        let out = StringBuilder()
        for (byte in digest.finish()) {
            out.append(this.candidateHexNibble(byte / UInt8(16)))
            out.append(this.candidateHexNibble(byte % UInt8(16)))
        }
        out.toString()
    }

    private func candidateHexNibble(value: UInt8): String {
        if (value == UInt8(0)) { return "0" }; if (value == UInt8(1)) { return "1" }
        if (value == UInt8(2)) { return "2" }; if (value == UInt8(3)) { return "3" }
        if (value == UInt8(4)) { return "4" }; if (value == UInt8(5)) { return "5" }
        if (value == UInt8(6)) { return "6" }; if (value == UInt8(7)) { return "7" }
        if (value == UInt8(8)) { return "8" }; if (value == UInt8(9)) { return "9" }
        if (value == UInt8(10)) { return "a" }; if (value == UInt8(11)) { return "b" }
        if (value == UInt8(12)) { return "c" }; if (value == UInt8(13)) { return "d" }
        if (value == UInt8(14)) { return "e" }
        "f"
    }

    private func vectorSpoolDescriptorEvidenceHash(descriptor: CkbVectorSpoolDescriptor): String {
        ckbReleaseEvidenceHash("${descriptor.acquisitionId}|${descriptor.candidateVersion}|${descriptor.planHash}|${descriptor.recordsEvidenceHash}|${descriptor.collection}|${descriptor.total}|${descriptor.completed}|${descriptor.reused}|${descriptor.embedded}|${descriptor.failed}|${descriptor.batchSize}|${descriptor.peakBufferedRecords}|${descriptor.peakBufferedBytes}|${ckbScheduledFetchPathsJson(descriptor.batchRelativePaths)}|${ckbScheduledFetchPathsJson(descriptor.batchEvidenceHashes)}|${ckbScheduledFetchPathsJson(descriptor.batchRecordCounts)}")
    }

    public func saveMetadata(status: KnowledgeStatus): Unit {
        this.writeLines("metadata/status.ckb", this.metadataLines(status))
    }

    public func saveActiveIndex(records: ArrayList<NormalizedRecord>, version: String): Unit {
        this.writeLines("index/active.version", version + "\n")
        this.writeLines("index/active.ckb", this.normalizedLines(records))
    }

    public func saveCandidateIndex(records: ArrayList<NormalizedRecord>, version: String): Unit {
        this.writeLines("index/candidate.version", version + "\n")
        this.writeLines("index/candidate.ckb", this.normalizedLines(records))
    }

    public func saveVectorCollection(records: ArrayList<VectorRecord>, collection: String): Unit {
        this.writeLines("index/vector-${safeName(collection)}.ckb", this.vectorLines(records))
    }

    public func loadVectorCollection(collection: String): ArrayList<VectorRecord> {
        this.parseVector(this.readLines("index/vector-${safeName(collection)}.ckb"))
    }

    public func listDerivedVectorArtifacts(): ArrayList<String> {
        let out = ArrayList<String>()
        let indexRoot = this.root.join("index")
        if (!exists(indexRoot)) {
            return out
        }
        try {
            for (entry in Directory.readFrom(indexRoot)) {
                let name = entry.name.trimAscii()
                if (entry.isRegular() && name.startsWith("vector-") && name.endsWith(".ckb")) {
                    out.add("index/${name}")
                }
            }
        } catch (_: Exception) {
            return out
        }
        out
    }

    public func deleteVectorCollection(collection: String): Bool {
        this.deleteRelativeFile("index/vector-${safeName(collection)}.ckb")
    }

    public func deleteAllDerivedVectorArtifacts(activeCollection: String, candidateCollection: String, force!: Bool = false): CkbDerivedVectorCleanupResult {
        let result = CkbDerivedVectorCleanupResult()
        result.force = force
        result.dryRun = !force
        result.protectedFiles.add("index/active.ckb")
        result.protectedFiles.add("index/active.version")
        result.protectedFiles.add("raw/**")
        result.protectedFiles.add("normalized/**")
        result.protectedFiles.add("metadata/**")
        if (activeCollection != "") {
            result.diagnostics.add("active_collection:${safeName(activeCollection)}")
        }
        if (candidateCollection != "") {
            result.diagnostics.add("candidate_collection:${safeName(candidateCollection)}")
        }
        let artifacts = this.listDerivedVectorArtifacts()
        if (artifacts.size == 0) {
            result.diagnostics.add("no_derived_vector_artifacts")
            return result
        }
        for (relative in artifacts) {
            result.plannedFiles.add(relative)
            if (!force) {
                continue
            }
            if (this.deleteRelativeFile(relative)) {
                result.deletedFiles.add(relative)
            } else {
                result.ok = false
                result.skippedFiles.add(relative)
                result.diagnostics.add("delete_failed:${relative}")
            }
        }
        result
    }

    public func backupVectorCollection(collection: String, backupName: String): Bool {
        let source = this.readLines("index/vector-${safeName(collection)}.ckb")
        if (source == "") {
            return false
        }
        this.writeLines("backup/vector-${safeName(backupName)}-${safeName(collection)}.ckb", source)
        true
    }

    public func restoreVectorBackup(collection: String, backupName: String): Bool {
        let source = this.readLines("backup/vector-${safeName(backupName)}-${safeName(collection)}.ckb")
        if (source == "") {
            return false
        }
        this.writeLines("index/vector-${safeName(collection)}.ckb", source)
        true
    }

    public func saveGraph(graph: GraphBuildResult): Unit {
        this.writeLines("index/graph-nodes.ckb", this.graphNodeLines(graph.nodes))
        this.writeLines("index/graph-edges.ckb", this.graphEdgeLines(graph.edges))
    }

    public func writeActiveSnapshotTransaction(status: KnowledgeStatus, rawRecords: ArrayList<RawRecord>, normalizedRecords: ArrayList<NormalizedRecord>, activeIndex: ArrayList<NormalizedRecord>, vectorRecords: ArrayList<VectorRecord>, vectorCollection: String, graph: GraphBuildResult, persistVectorFile!: Bool = true, deadlineAtMillis!: Int64 = 0, stageSink!: CkbStagedRebuildStageSink = NoopCkbStagedRebuildStageSink(), vectorSpool!: CkbVectorSpoolDescriptor = CkbVectorSpoolDescriptor(), releaseBundle!: CkbReleaseCommitBundle = CkbReleaseCommitBundle(), companionCopy!: CkbActiveSnapshotCompanionCopy = CkbActiveSnapshotCompanionCopy(), repositoryEventIdentity!: String = "", faultInjector!: CkbActiveSnapshotFaultInjector = NoopCkbActiveSnapshotFaultInjector()): CkbActiveSnapshotTransactionResult {
        let result = CkbActiveSnapshotTransactionResult()
        let entryDeadline = ckbDeadlineGuard("active_snapshot_tx_begin", deadlineAtMillis)
        if (entryDeadline.exceeded) {
            result.failureDiagnostic = entryDeadline.diagnostic
            result.diagnostics.add(entryDeadline.diagnostic)
            return result
        }
        if (status.activeKnowledgeVersion == "" ||
            status.storage.vectorActiveCollection == "" ||
            vectorCollection != status.storage.vectorActiveCollection) {
            result.failureDiagnostic = "active_snapshot_identity_invalid"
            result.diagnostics.add("active_snapshot_identity_invalid")
            return result
        }
        let companions = this.activeSnapshotCompanionPayload(releaseBundle, companionCopy,
            status)
        result.companionMode = companions.mode
        result.manifestHash = companions.manifestHash
        result.freshnessHash = companions.freshnessHash
        result.coverageHash = companions.coverageHash
        if (!companions.valid) {
            result.failureDiagnostic = companions.diagnostic
            result.diagnostics.add(companions.diagnostic)
            return result
        }
        this.ensureLayout()
        this.ensure("transactions")
        let txId = this.newActiveSnapshotTxId(status.activeKnowledgeVersion)
        let txRoot = "transactions/${safeName(txId)}"
        result.txId = txId
        result.activeVersion = status.activeKnowledgeVersion
        result.vectorActiveCollection = status.storage.vectorActiveCollection
        result.persistVectorFile = persistVectorFile
        try {
            if (this.has(txRoot)) { throw Exception("active_snapshot_tx_id_already_exists") }
            Directory.create(this.root.join(txRoot), recursive: false)
        } catch (e: Exception) {
            result.failureDiagnostic = if (e.message == "") {
                "active_snapshot_tx_reservation_failed"
            } else { utf8SafePrefix(redactSensitive(e.message), 180) }
            result.diagnostics.add("snapshot_transaction_reservation_failed:${result.failureDiagnostic}")
            return result
        }
        ckbEmitStagedRebuildStage(stageSink,
            "active_snapshot_transaction_started", "running",
            deadlineAtMillis,
            "active=${status.activeKnowledgeVersion}|txReserved=true",
            typedEvent: "snapshot.transaction.started", txId: txId,
            activeKnowledgeVersion: status.activeKnowledgeVersion)
        try {
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_tx_raw_before", "running", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            this.ensureActiveSnapshotDeadline("active_snapshot_tx_raw_before", deadlineAtMillis)
            this.writeRawFilesAtomically(txRoot, rawRecords, deadlineAtMillis: deadlineAtMillis, progressStage: "active_snapshot_tx_raw")
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_tx_raw_after", "ok", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_tx_normalized_before", "running", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            this.ensureActiveSnapshotDeadline("active_snapshot_tx_normalized_before", deadlineAtMillis)
            this.writeNormalizedRecordsAtomically("${txRoot}/normalized/records.ckb", normalizedRecords, deadlineAtMillis, "active_snapshot_tx_normalized")
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_tx_normalized_after", "ok", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_tx_index_before", "running", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            this.ensureActiveSnapshotDeadline("active_snapshot_tx_index_before", deadlineAtMillis)
            this.writeLinesAtomically("${txRoot}/index/active.version", status.activeKnowledgeVersion + "\n")
            this.writeNormalizedRecordsAtomically("${txRoot}/index/active.ckb", activeIndex, deadlineAtMillis, "active_snapshot_tx_index")
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_tx_index_after", "ok", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            if (persistVectorFile) {
                this.emitActiveSnapshotStage(stageSink, "active_snapshot_tx_vector_before", "running", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
                this.ensureActiveSnapshotDeadline("active_snapshot_tx_vector_before", deadlineAtMillis)
                if (vectorSpool.valid) {
                    this.streamVectorSpoolToFile("${txRoot}/index/vector-${safeName(vectorCollection)}.ckb", vectorSpool, deadlineAtMillis)
                } else {
                    this.writeVectorRecordsAtomically("${txRoot}/index/vector-${safeName(vectorCollection)}.ckb", vectorRecords, deadlineAtMillis, "active_snapshot_tx_vector")
                }
                this.emitActiveSnapshotStage(stageSink, "active_snapshot_tx_vector_after", "ok", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            } else {
                this.emitActiveSnapshotStage(stageSink, "active_snapshot_tx_vector_skipped", "skipped", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            }
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_tx_graph_before", "running", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            this.ensureActiveSnapshotDeadline("active_snapshot_tx_graph_before", deadlineAtMillis)
            this.writeGraphNodesAtomically("${txRoot}/index/graph-nodes.ckb", graph.nodes, deadlineAtMillis, "active_snapshot_tx_graph_nodes")
            this.writeGraphEdgesAtomically("${txRoot}/index/graph-edges.ckb", graph.edges, deadlineAtMillis, "active_snapshot_tx_graph_edges")
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_tx_graph_after", "ok", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_tx_status_before", "running", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            this.ensureActiveSnapshotDeadline("active_snapshot_tx_status_before", deadlineAtMillis)
            this.writeLinesAtomically("${txRoot}/metadata/status.ckb", this.metadataLines(status))
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_tx_status_after", "ok", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            result.payloadHash = this.activeSnapshotPayloadEvidenceHash(txRoot, vectorCollection, persistVectorFile)
            if (!this.activeSnapshotPayloadMatches(txRoot, status, rawRecords.size, normalizedRecords.size,
                activeIndex.size, vectorCollection, persistVectorFile, result.payloadHash)) {
                throw Exception("active_snapshot_payload_readback_mismatch")
            }
            this.writeActiveSnapshotCompanions(txRoot, companions, faultInjector)
            if (repositoryEventIdentity != "") {
                let pointerHash = ckbReleaseEvidenceHash("${txId}|${status.activeKnowledgeVersion}|${result.manifestHash}|${result.freshnessHash}|${result.coverageHash}")
                let recovery = "schemaVersion=ckb-repository-event-recovery-v1\neventIdentity=${escapeField(repositoryEventIdentity)}\ntxId=${escapeField(txId)}\nactiveVersion=${escapeField(status.activeKnowledgeVersion)}\npointerHash=${pointerHash}\nstatus=committed_recovery_required\n"
                let recoveryText = recovery + "checksum=${ckbReleaseEvidenceHash(recovery)}\n"
                this.writeLinesAtomically("${txRoot}/metadata/repository-event-recovery.ckb", recoveryText)
                if (this.readLines("${txRoot}/metadata/repository-event-recovery.ckb") != recoveryText) {
                    throw Exception("repository_event_recovery_sidecar_readback_failed")
                }
            }
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_tx_commit_before", "running", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            this.ensureActiveSnapshotDeadline("active_snapshot_tx_commit_before", deadlineAtMillis)
            faultInjector.checkpoint(CkbActiveSnapshotFaultPoints.COMMIT)
            let commitText = this.activeSnapshotCommitLines(txId, status, result)
            this.writeLinesAtomically("${txRoot}/COMMIT", commitText)
            if (this.readLines("${txRoot}/COMMIT") != commitText) {
                throw Exception("active_snapshot_commit_readback_mismatch")
            }
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_tx_commit_after", "ok", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_manifest_before", "running", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            this.ensureActiveSnapshotDeadline("active_snapshot_manifest_before", deadlineAtMillis)
            faultInjector.checkpoint(CkbActiveSnapshotFaultPoints.POINTER_BEFORE)
            this.writeLinesAtomically("metadata/active-snapshot.manifest",
                this.activeSnapshotManifestLines(txId, status, result))
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_manifest_after", "ok", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            faultInjector.checkpoint(CkbActiveSnapshotFaultPoints.POINTER_AFTER)
        } catch (e: Exception) {
            result.failureDiagnostic = if (e.message == "") {
                "active_snapshot_transaction_write_failed"
            } else { utf8SafePrefix(redactSensitive(e.message), 180) }
            result.diagnostics.add("snapshot_transaction_write_failed:${utf8SafePrefix(redactSensitive(e.message), 180)}")
        }
        let committedPointer = this.loadActiveSnapshotPointer()
        result.pointerCommitted = this.activeSnapshotPointerMatchesResult(committedPointer, result)
        result.businessCommitted = result.pointerCommitted && this.has("${txRoot}/COMMIT")
        if (!result.businessCommitted) {
            result.ok = false
            result.diagnostics.add("snapshot_transaction_not_committed:txId=${ckbReleaseEvidenceHash(txId)}|pointerCommitted=${result.pointerCommitted}")
            return result
        }
        ckbEmitStagedRebuildStage(stageSink,
            "active_snapshot_transaction_committed", "ok",
            deadlineAtMillis,
            "active=${status.activeKnowledgeVersion}|pointerCommitted=true",
            typedEvent: "snapshot.transaction.committed", txId: txId,
            activeKnowledgeVersion: status.activeKnowledgeVersion,
            manifestPath: "metadata/active-snapshot.manifest",
            commitPath: "${txRoot}/COMMIT")
        let liveShadowStartedAtMillis = ckbCoreNowMillis()
        try {
            faultInjector.checkpoint(CkbActiveSnapshotFaultPoints.LIVE_SHADOW)
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_live_shadow_before", "running", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            this.writeActiveSnapshotLiveShadow(txRoot, status, rawRecords, normalizedRecords, activeIndex, vectorRecords, vectorCollection, graph, persistVectorFile: persistVectorFile, deadlineAtMillis: deadlineAtMillis, stageSink: stageSink)
            result.liveShadowConsistent = this.activeLiveShadowMatchesTx(txRoot,
                companionMode: companions.mode)
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_live_shadow_after", if (result.liveShadowConsistent) { "ok" } else { "degraded" }, status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile, durationMillis: ckbCoreNowMillis() - liveShadowStartedAtMillis)
        } catch (e: Exception) {
            result.liveShadowConsistent = false
            result.diagnostics.add("snapshot_live_shadow_degraded:${utf8SafePrefix(redactSensitive(e.message), 180)}")
        }
        let manifestVectorCount = if (persistVectorFile && vectorSpool.valid) { vectorSpool.total } else if (persistVectorFile) { vectorRecords.size } else { status.storage.vectorIndexCount }
        try {
            this.writeLinesAtomically("metadata/active-snapshot-commits/${safeName(txId)}.ckb",
                this.activeSnapshotCommitSidecarLines(txId, status, vectorCollection, activeIndex.size,
                    manifestVectorCount, persistVectorFile, result))
        } catch (e: Exception) {
            result.diagnostics.add("snapshot_commit_sidecar_degraded:${utf8SafePrefix(redactSensitive(e.message), 180)}")
        }
        result.diagnostics.add("snapshot_transaction_committed:txId=${ckbReleaseEvidenceHash(txId)}|manifestHash=${result.manifestHash}|freshnessHash=${result.freshnessHash}|coverageHash=${result.coverageHash}|pointerCommitted=${result.pointerCommitted}|liveShadowConsistent=${result.liveShadowConsistent}")
        result.ok = true
        result
    }

    private func emitActiveSnapshotStage(stageSink: CkbStagedRebuildStageSink, stage: String, statusText: String, status: KnowledgeStatus, rawRecords: ArrayList<RawRecord>, normalizedRecords: ArrayList<NormalizedRecord>, activeIndex: ArrayList<NormalizedRecord>, vectorRecords: ArrayList<VectorRecord>, graph: GraphBuildResult, deadlineAtMillis: Int64, persistVectorFile: Bool, durationMillis!: Int64 = 0): Unit {
        let vectorCount = if (persistVectorFile && vectorRecords.size > 0) { vectorRecords.size } else { status.storage.vectorIndexCount }
        let diagnostic = "active=${status.activeKnowledgeVersion}|rawCount=${rawRecords.size}|normalizedCount=${normalizedRecords.size}|indexCount=${activeIndex.size}|vectorCount=${vectorCount}|graphNodeCount=${graph.nodes.size}|graphEdgeCount=${graph.edges.size}|persistVectorFile=${persistVectorFile}"
        ckbEmitStagedRebuildStage(stageSink, stage, statusText, deadlineAtMillis, diagnostic, durationMillis: durationMillis, itemCount: activeIndex.size)
    }

    private func ensureActiveSnapshotDeadline(stage: String, deadlineAtMillis: Int64): Unit {
        let deadline = ckbDeadlineGuard(stage, deadlineAtMillis)
        if (deadline.exceeded) {
            throw Exception(deadline.diagnostic)
        }
    }

    private func activeSnapshotCompanionPayload(releaseBundle: CkbReleaseCommitBundle,
        companionCopy: CkbActiveSnapshotCompanionCopy,
        status: KnowledgeStatus): CkbActiveSnapshotCompanionPayload {
        let payload = CkbActiveSnapshotCompanionPayload()
        let emptyHash = ckbReleaseCompanionEvidenceHash("")
        payload.manifestHash = emptyHash
        payload.freshnessHash = emptyHash
        payload.coverageHash = emptyHash
        if (releaseBundle.status != "not_prepared") {
            payload.mode = CkbActiveSnapshotCompanionMode.RELEASE
            payload.manifestText = ckbRenderCangjieVersionManifestArtifact(releaseBundle.manifest)
            payload.freshnessText = ckbRenderCangjieFreshnessArtifact(releaseBundle.freshness)
            payload.coverageText = ckbRenderReleaseCoverageArtifact(releaseBundle.coverage, releaseBundle.removed)
            payload.manifestHash = ckbReleaseCompanionEvidenceHash(payload.manifestText)
            payload.freshnessHash = ckbReleaseCompanionEvidenceHash(payload.freshnessText)
            payload.coverageHash = ckbReleaseCompanionEvidenceHash(payload.coverageText)
            payload.diagnostic = ckbValidateReleaseCommitBundleForSnapshot(releaseBundle,
                status, payload.manifestHash, payload.freshnessHash, payload.coverageHash)
            payload.valid = payload.diagnostic == ""
            return payload
        }
        if (companionCopy.provided) {
            if (!companionCopy.valid) {
                payload.valid = false
                payload.diagnostic = "active_companion_restore_source_invalid:${companionCopy.diagnostic}"
                return payload
            }
            if (companionCopy.mode == CkbActiveSnapshotCompanionMode.NONE) {
                payload.mode = CkbActiveSnapshotCompanionMode.NONE
                payload.valid = companionCopy.manifestText == "" && companionCopy.freshnessText == "" &&
                    companionCopy.coverageText == ""
                if (!payload.valid) { payload.diagnostic = "active_companion_none_has_payload" }
                return payload
            }
            if (companionCopy.mode != CkbActiveSnapshotCompanionMode.RELEASE &&
                companionCopy.mode != CkbActiveSnapshotCompanionMode.COPY_FORWARD) {
                payload.valid = false
                payload.diagnostic = "active_companion_restore_mode_invalid"
                return payload
            }
            payload.mode = CkbActiveSnapshotCompanionMode.COPY_FORWARD
            payload.manifestText = companionCopy.manifestText
            payload.freshnessText = companionCopy.freshnessText
            payload.coverageText = companionCopy.coverageText
            payload.manifestHash = ckbReleaseCompanionEvidenceHash(payload.manifestText)
            payload.freshnessHash = ckbReleaseCompanionEvidenceHash(payload.freshnessText)
            payload.coverageHash = ckbReleaseCompanionEvidenceHash(payload.coverageText)
            payload.valid = payload.manifestText != "" && payload.freshnessText != "" &&
                payload.coverageText != "" && payload.manifestHash == companionCopy.manifestHash &&
                payload.freshnessHash == companionCopy.freshnessHash &&
                payload.coverageHash == companionCopy.coverageHash
            if (!payload.valid) {
                payload.diagnostic = "active_companion_restore_hash_mismatch"
                return payload
            }
            let copiedManifest = ckbParseCangjieVersionManifestArtifact(
                payload.manifestText)
            let copiedFreshness = ckbParseCangjieFreshnessArtifact(
                payload.freshnessText)
            payload.valid = copiedManifest.manifestVersion ==
                CangjieVersionManifestVersions.V2 && copiedManifest.sources.size > 0 &&
                copiedFreshness.sources.size == copiedManifest.sources.size &&
                copiedFreshness.activeKnowledgeVersion == status.activeKnowledgeVersion &&
                copiedFreshness.candidateKnowledgeVersion == status.candidateKnowledgeVersion &&
                copiedFreshness.failedCandidateVersion == status.failedCandidateVersion &&
                copiedManifest.defaultTargetVersion != "" &&
                copiedFreshness.targetVersion == copiedManifest.defaultTargetVersion &&
                ckbReleaseFreshnessManifestCommitAligned(copiedFreshness,
                    copiedManifest, status.activeKnowledgeVersion)
            if (!payload.valid) {
                payload.diagnostic = "active_companion_restore_semantic_mismatch"
            }
            return payload
        }
        if (!this.has("metadata/active-snapshot.manifest")) {
            payload.mode = CkbActiveSnapshotCompanionMode.NONE
            return payload
        }
        let pointer = this.loadActiveSnapshotPointer()
        if (!pointer.valid) {
            payload.valid = false
            payload.diagnostic = "active_companion_copy_forward_pointer_invalid:${pointer.diagnostic}"
            return payload
        }
        if (pointer.legacy || pointer.companionMode == CkbActiveSnapshotCompanionMode.NONE) {
            payload.mode = CkbActiveSnapshotCompanionMode.NONE
            return payload
        }
        if (!this.activeSnapshotPointerCompanionsValid(pointer)) {
            payload.valid = false
            payload.diagnostic = "active_companion_copy_forward_invalid"
            return payload
        }
        let txRoot = "transactions/${safeName(pointer.txId)}"
        payload.mode = CkbActiveSnapshotCompanionMode.COPY_FORWARD
        payload.manifestText = this.readLines("${txRoot}/metadata/cangjie-version-manifest.ckb")
        payload.coverageText = this.readLines("${txRoot}/metadata/cangjie-release-coverage.ckb")
        let manifest = this.loadCangjieVersionManifestFromRelative(
            "${txRoot}/metadata/cangjie-version-manifest.ckb")
        let freshness = this.loadCangjieCorpusFreshnessFromRelative(
            "${txRoot}/metadata/cangjie-freshness.ckb")
        if (manifest.sources.size == 0 || freshness.sources.size == 0 ||
            freshness.sources.size != manifest.sources.size ||
            freshness.targetVersion != manifest.defaultTargetVersion) {
            payload.valid = false
            payload.diagnostic = "active_companion_copy_forward_semantic_invalid"
            return payload
        }
        freshness.activeKnowledgeVersion = status.activeKnowledgeVersion
        freshness.candidateKnowledgeVersion = status.candidateKnowledgeVersion
        freshness.failedCandidateVersion = status.failedCandidateVersion
        for (source in freshness.sources) {
            source.indexedAt = status.activeKnowledgeVersion
        }
        if (!ckbReleaseFreshnessManifestCommitAligned(freshness, manifest,
            status.activeKnowledgeVersion)) {
            payload.valid = false
            payload.diagnostic = "active_companion_copy_forward_semantic_mismatch"
            return payload
        }
        payload.freshnessText = ckbRenderCangjieFreshnessArtifact(freshness)
        payload.manifestHash = ckbReleaseCompanionEvidenceHash(payload.manifestText)
        payload.freshnessHash = ckbReleaseCompanionEvidenceHash(payload.freshnessText)
        payload.coverageHash = ckbReleaseCompanionEvidenceHash(payload.coverageText)
        payload.valid = payload.manifestHash == pointer.manifestHash &&
            payload.coverageHash == pointer.coverageHash &&
            payload.freshnessText != "" &&
            ckbValidationEvidenceIsSha256(payload.freshnessHash)
        if (!payload.valid) { payload.diagnostic = "active_companion_copy_forward_hash_mismatch" }
        payload
    }

    private func writeActiveSnapshotCompanions(txRoot: String,
        payload: CkbActiveSnapshotCompanionPayload,
        faultInjector: CkbActiveSnapshotFaultInjector): Unit {
        if (payload.mode == CkbActiveSnapshotCompanionMode.NONE) { return }
        faultInjector.checkpoint(CkbActiveSnapshotFaultPoints.MANIFEST)
        this.writeLinesAtomically("${txRoot}/metadata/cangjie-version-manifest.ckb", payload.manifestText)
        if (this.readLines("${txRoot}/metadata/cangjie-version-manifest.ckb") != payload.manifestText ||
            ckbReleaseCompanionEvidenceHash(payload.manifestText) != payload.manifestHash) {
            throw Exception("transaction_manifest_readback_mismatch")
        }
        faultInjector.checkpoint(CkbActiveSnapshotFaultPoints.FRESHNESS)
        this.writeLinesAtomically("${txRoot}/metadata/cangjie-freshness.ckb", payload.freshnessText)
        if (this.readLines("${txRoot}/metadata/cangjie-freshness.ckb") != payload.freshnessText ||
            ckbReleaseCompanionEvidenceHash(payload.freshnessText) != payload.freshnessHash) {
            throw Exception("transaction_freshness_readback_mismatch")
        }
        faultInjector.checkpoint(CkbActiveSnapshotFaultPoints.COVERAGE)
        this.writeLinesAtomically("${txRoot}/metadata/cangjie-release-coverage.ckb", payload.coverageText)
        if (this.readLines("${txRoot}/metadata/cangjie-release-coverage.ckb") != payload.coverageText ||
            ckbReleaseCompanionEvidenceHash(payload.coverageText) != payload.coverageHash) {
            throw Exception("transaction_coverage_readback_mismatch")
        }
    }

    private func activeSnapshotPayloadEvidenceHash(txRoot: String, vectorCollection: String,
        persistVectorFile: Bool): String {
        let fields = ArrayList<String>()
        fields.add("raw=${this.activeSnapshotDirectoryEvidenceHash("${txRoot}/raw")}")
        fields.add("normalized=${this.activeSnapshotFileEvidenceHash("${txRoot}/normalized/records.ckb")}")
        fields.add("version=${this.activeSnapshotFileEvidenceHash("${txRoot}/index/active.version")}")
        fields.add("index=${this.activeSnapshotFileEvidenceHash("${txRoot}/index/active.ckb")}")
        fields.add("graphNodes=${this.activeSnapshotFileEvidenceHash("${txRoot}/index/graph-nodes.ckb")}")
        fields.add("graphEdges=${this.activeSnapshotFileEvidenceHash("${txRoot}/index/graph-edges.ckb")}")
        fields.add("status=${this.activeSnapshotFileEvidenceHash("${txRoot}/metadata/status.ckb")}")
        if (persistVectorFile) {
            fields.add("vector=${this.activeSnapshotFileEvidenceHash("${txRoot}/index/vector-${safeName(vectorCollection)}.ckb")}")
        }
        ckbReleaseCompanionEvidenceHash(joinStrings(fields, "|"))
    }

    private func activeSnapshotPayloadMatches(txRoot: String, status: KnowledgeStatus,
        rawCount: Int64, normalizedCount: Int64, activeCount: Int64, vectorCollection: String,
        persistVectorFile: Bool, payloadHash: String): Bool {
        if (!ckbValidationEvidenceIsSha256(payloadHash)) { return false }
        let metadata = this.loadMetadataStatusFromPrefix(txRoot)
        if (this.readLinesFromPrefix(txRoot, "index/active.version").trimAscii() !=
            status.activeKnowledgeVersion || metadata.activeVersion != status.activeKnowledgeVersion ||
            metadata.rawCount != rawCount || metadata.normalizedCount != normalizedCount ||
            metadata.indexCount != activeCount ||
            this.activeSnapshotFileLineCount("${txRoot}/raw/records.ckb") != rawCount ||
            this.activeSnapshotFileLineCount("${txRoot}/normalized/records.ckb") != normalizedCount ||
            this.activeSnapshotFileLineCount("${txRoot}/index/active.ckb") != activeCount ||
            metadata.vectorActiveCollection != status.storage.vectorActiveCollection ||
            !this.has("${txRoot}/index/graph-nodes.ckb") ||
            !this.has("${txRoot}/index/graph-edges.ckb") ||
            !this.has("${txRoot}/metadata/status.ckb")) {
            return false
        }
        if (persistVectorFile && !this.has("${txRoot}/index/vector-${safeName(vectorCollection)}.ckb")) {
            return false
        }
        this.activeSnapshotPayloadEvidenceHash(txRoot, vectorCollection, persistVectorFile) == payloadHash
    }

    private func activeSnapshotFileLineCount(relative: String): Int64 {
        let path = this.root.join(relative)
        if (!exists(path)) { return -1 }
        var lines: Int64 = 0
        try (file = File(path, OpenMode.Read)) {
            let buffer = Array<Byte>(65536, repeat: 0)
            while (true) {
                let read = file.read(buffer)
                if (read <= 0) { break }
                for (i in 0..read) {
                    if (buffer[i] == UInt8(10)) { lines += 1 }
                }
            }
        }
        lines
    }

    private func activeSnapshotFileEvidenceHash(relative: String): String {
        let path = this.root.join(relative)
        this.activeSnapshotFilePathEvidenceHash(path)
    }

    private func activeSnapshotFilePathEvidenceHash(path: Path): String {
        if (!exists(path)) { return "missing" }
        let digest = SHA256()
        try (file = File(path, OpenMode.Read)) {
            let buffer = Array<Byte>(65536, repeat: 0)
            while (true) {
                let read = file.read(buffer)
                if (read <= 0) { break }
                if (read == buffer.size) { digest.write(buffer) } else { digest.write(buffer[0..read].clone()) }
            }
        }
        "hsha256:${this.candidateDigestHex(digest).toAsciiLower()}"
    }

    private func activeSnapshotDirectoryEvidenceHash(relative: String): String {
        let root = this.root.join(relative)
        this.activeSnapshotDirectoryPathEvidenceHash(root)
    }

    private func activeSnapshotDirectoryPathEvidenceHash(root: Path): String {
        if (!exists(root)) { return "missing" }
        let entries = ArrayList<String>()
        this.activeSnapshotCollectDirectoryEvidence(root, "", entries)
        let ordered = entries.toArray()
        sort(ordered)
        let canonical = ArrayList<String>()
        canonical.add(all: ordered)
        ckbReleaseCompanionEvidenceHash(joinStrings(canonical, "|"))
    }

    private func activeSnapshotCollectDirectoryEvidence(root: Path, prefix: String,
        out: ArrayList<String>): Unit {
        for (entry in Directory.readFrom(root)) {
            let relative = if (prefix == "") { entry.name } else { "${prefix}/${entry.name}" }
            if (entry.isDirectory()) {
                this.activeSnapshotCollectDirectoryEvidence(entry.path, relative, out)
            } else if (entry.isRegular()) {
                out.add("${relative}=${this.activeSnapshotFilePathEvidenceHash(entry.path)}")
            }
        }
    }

    public func loadActiveSnapshotPointer(): CkbActiveSnapshotPointer {
        let pointer = CkbActiveSnapshotPointer()
        var text = ""
        try {
            text = this.readLines("metadata/active-snapshot.manifest")
        } catch (_: Exception) {
            pointer.diagnostic = "active_pointer_invalid_response_encoding"
            return pointer
        }
        if (text == "") { return pointer }
        pointer.schema = ckbCurrentField(text, "schema")
        pointer.txId = ckbCurrentField(text, "txId")
        pointer.activeVersion = ckbCurrentField(text, "active")
        pointer.vectorActiveCollection = ckbCurrentField(text, "vectorActiveCollection")
        if (pointer.schema == "") {
            let hasV2PointerFields = ckbCurrentField(text, "companionMode") != "" ||
                ckbCurrentField(text, "manifestHash") != "" ||
                ckbCurrentField(text, "freshnessHash") != "" ||
                ckbCurrentField(text, "coverageHash") != ""
            var commitDeclaresSchema = false
            if (this.activeSnapshotPointerIdentitySafe(pointer)) {
                try {
                    let commit = this.readLines("transactions/${safeName(pointer.txId)}/COMMIT")
                    commitDeclaresSchema = ckbCurrentField(commit, "schema") != ""
                } catch (_: Exception) {
                    // An undecodable commit cannot prove a legacy transaction.
                    commitDeclaresSchema = true
                }
            }
            if (hasV2PointerFields || commitDeclaresSchema) {
                pointer.legacy = false
                pointer.valid = false
                pointer.diagnostic = "active_pointer_v2_schema_missing"
                return pointer
            }
            if (!this.activeSnapshotPointerIdentitySafe(pointer)) {
                pointer.legacy = false
                pointer.valid = false
                pointer.diagnostic = "active_pointer_malformed"
                return pointer
            }
            pointer.legacy = true
            pointer.valid = ckbCurrentField(text, "committed") == "true"
            pointer.diagnostic = if (pointer.valid) { "legacy_active_pointer" } else { "legacy_active_pointer_malformed" }
            return pointer
        }
        if (pointer.schema != "ckb-active-pointer-v2") {
            pointer.diagnostic = "active_pointer_schema_unsupported"
            return pointer
        }
        pointer.companionMode = ckbCurrentField(text, "companionMode")
        pointer.manifestHash = ckbCurrentField(text, "manifestHash")
        pointer.freshnessHash = ckbCurrentField(text, "freshnessHash")
        pointer.coverageHash = ckbCurrentField(text, "coverageHash")
        let modeValid = pointer.companionMode == CkbActiveSnapshotCompanionMode.RELEASE ||
            pointer.companionMode == CkbActiveSnapshotCompanionMode.COPY_FORWARD ||
            pointer.companionMode == CkbActiveSnapshotCompanionMode.NONE
        let hashesValid = ckbValidationEvidenceIsSha256(pointer.manifestHash) &&
            ckbValidationEvidenceIsSha256(pointer.freshnessHash) &&
            ckbValidationEvidenceIsSha256(pointer.coverageHash)
        pointer.valid = try {
            modeValid && hashesValid && this.activeSnapshotPointerIdentitySafe(pointer) &&
                this.activeSnapshotCommitMatchesPointer(pointer) &&
                this.activeSnapshotPointerCompanionsValid(pointer) &&
                ckbCurrentField(text, "committed") == "true"
        } catch (_: Exception) { false }
        pointer.diagnostic = if (pointer.valid) { "ok" } else { "active_pointer_v2_malformed_or_uncommitted" }
        pointer
    }

    private func activeSnapshotPointerIdentitySafe(pointer: CkbActiveSnapshotPointer): Bool {
        pointer.txId != "" && pointer.activeVersion != "" && pointer.vectorActiveCollection != "" &&
            !pointer.txId.contains("/") && !pointer.txId.contains("\\") &&
            !pointer.txId.contains("..") && !pointer.txId.contains("\u{0000}")
    }

    private func activeSnapshotCommitMatchesPointer(pointer: CkbActiveSnapshotPointer): Bool {
        let txRoot = "transactions/${safeName(pointer.txId)}"
        let text = this.readLines("${txRoot}/COMMIT")
        let payloadHash = ckbCurrentField(text, "payloadHash")
        let persistVectorFileText = ckbCurrentField(text, "persistVectorFile")
        if (persistVectorFileText != "true" && persistVectorFileText != "false") {
            return false
        }
        let persistVectorFile = persistVectorFileText == "true"
        let metadata = this.loadMetadataStatusFromPrefix(txRoot)
        text != "" &&
            this.readLinesFromPrefix(txRoot, "index/active.version").trimAscii() == pointer.activeVersion &&
            metadata.activeVersion == pointer.activeVersion &&
            metadata.vectorActiveCollection == pointer.vectorActiveCollection &&
            this.has("${txRoot}/raw/records.ckb") &&
            this.has("${txRoot}/normalized/records.ckb") &&
            this.has("${txRoot}/index/active.ckb") &&
            this.has("${txRoot}/index/graph-nodes.ckb") &&
            this.has("${txRoot}/index/graph-edges.ckb") &&
            this.has("${txRoot}/metadata/status.ckb") &&
            (!persistVectorFile || this.has("${txRoot}/index/vector-${safeName(pointer.vectorActiveCollection)}.ckb")) &&
            ckbCurrentField(text, "schema") == "ckb-active-commit-v2" &&
            ckbCurrentField(text, "txId") == pointer.txId &&
            ckbCurrentField(text, "active") == pointer.activeVersion &&
            ckbCurrentField(text, "vectorActiveCollection") == pointer.vectorActiveCollection &&
            ckbCurrentField(text, "companionMode") == pointer.companionMode &&
            ckbCurrentField(text, "manifestHash") == pointer.manifestHash &&
            ckbCurrentField(text, "freshnessHash") == pointer.freshnessHash &&
            ckbCurrentField(text, "coverageHash") == pointer.coverageHash &&
            ckbValidationEvidenceIsSha256(payloadHash) &&
            this.activeSnapshotPayloadEvidenceHash(txRoot, pointer.vectorActiveCollection,
                persistVectorFile) == payloadHash &&
            ckbCurrentField(text, "committed") == "true"
    }

    private func activeSnapshotPointerCompanionsValid(pointer: CkbActiveSnapshotPointer): Bool {
        let emptyHash = ckbReleaseCompanionEvidenceHash("")
        if (pointer.companionMode == CkbActiveSnapshotCompanionMode.NONE) {
            return pointer.manifestHash == emptyHash && pointer.freshnessHash == emptyHash &&
                pointer.coverageHash == emptyHash
        }
        let txRoot = "transactions/${safeName(pointer.txId)}"
        let manifestHash = this.activeSnapshotFileEvidenceHash(
            "${txRoot}/metadata/cangjie-version-manifest.ckb")
        let freshnessHash = this.activeSnapshotFileEvidenceHash(
            "${txRoot}/metadata/cangjie-freshness.ckb")
        let coverageHash = this.activeSnapshotFileEvidenceHash(
            "${txRoot}/metadata/cangjie-release-coverage.ckb")
        manifestHash != emptyHash && freshnessHash != emptyHash && coverageHash != emptyHash &&
            manifestHash == pointer.manifestHash && freshnessHash == pointer.freshnessHash &&
            coverageHash == pointer.coverageHash
    }

    public func loadActiveSnapshotCompanionCopy(): CkbActiveSnapshotCompanionCopy {
        let copy = CkbActiveSnapshotCompanionCopy()
        copy.provided = true
        if (!this.has("metadata/active-snapshot.manifest")) {
            copy.mode = CkbActiveSnapshotCompanionMode.NONE
            copy.manifestHash = ckbReleaseCompanionEvidenceHash("")
            copy.freshnessHash = ckbReleaseCompanionEvidenceHash("")
            copy.coverageHash = ckbReleaseCompanionEvidenceHash("")
            return copy
        }
        let pointer = this.loadActiveSnapshotPointer()
        if (!pointer.valid) {
            copy.valid = false
            copy.diagnostic = pointer.diagnostic
            return copy
        }
        copy.mode = pointer.companionMode
        if (pointer.legacy || pointer.companionMode == CkbActiveSnapshotCompanionMode.NONE) {
            copy.mode = CkbActiveSnapshotCompanionMode.NONE
            copy.manifestHash = ckbReleaseCompanionEvidenceHash("")
            copy.freshnessHash = ckbReleaseCompanionEvidenceHash("")
            copy.coverageHash = ckbReleaseCompanionEvidenceHash("")
            return copy
        }
        let txRoot = "transactions/${safeName(pointer.txId)}"
        try {
            copy.manifestText = this.readLines("${txRoot}/metadata/cangjie-version-manifest.ckb")
            copy.freshnessText = this.readLines("${txRoot}/metadata/cangjie-freshness.ckb")
            copy.coverageText = this.readLines("${txRoot}/metadata/cangjie-release-coverage.ckb")
        } catch (_: Exception) {
            copy.valid = false
            copy.diagnostic = "active_companion_copy_invalid_encoding"
            return copy
        }
        copy.manifestHash = ckbReleaseCompanionEvidenceHash(copy.manifestText)
        copy.freshnessHash = ckbReleaseCompanionEvidenceHash(copy.freshnessText)
        copy.coverageHash = ckbReleaseCompanionEvidenceHash(copy.coverageText)
        copy.valid = copy.manifestHash == pointer.manifestHash &&
            copy.freshnessHash == pointer.freshnessHash && copy.coverageHash == pointer.coverageHash
        if (!copy.valid) { copy.diagnostic = "active_companion_copy_hash_mismatch" }
        copy
    }

    private func activeSnapshotPointerMatchesResult(pointer: CkbActiveSnapshotPointer,
        result: CkbActiveSnapshotTransactionResult): Bool {
        pointer.valid && !pointer.legacy && pointer.txId == result.txId &&
            pointer.activeVersion == result.activeVersion &&
            pointer.vectorActiveCollection == result.vectorActiveCollection &&
            pointer.companionMode == result.companionMode &&
            pointer.manifestHash == result.manifestHash &&
            pointer.freshnessHash == result.freshnessHash &&
            pointer.coverageHash == result.coverageHash
    }

    public func repairActiveLiveShadowFromManifest(): ActiveSnapshotRepairResult {
        let result = ActiveSnapshotRepairResult()
        let pointer = this.loadActiveSnapshotPointer()
        result.txId = pointer.txId
        if (!pointer.valid) {
            result.ok = false
            result.diagnostic = "active_snapshot_pointer_invalid:${pointer.diagnostic}"
            return result
        }
        let txRoot = "transactions/${safeName(pointer.txId)}"
        let snapshot = this.loadActiveSnapshotFromPrefix(txRoot, "",
            allowLiveOverlay: pointer.legacy)
        result.activeVersion = snapshot.activeVersion
        if (!snapshot.valid) {
            result.ok = false
            result.diagnostic = "active_snapshot_tx_invalid:${snapshot.diagnostic}"
            return result
        }
        if (this.activeLiveShadowMatchesTx(txRoot, companionMode: pointer.companionMode)) {
            result.ok = true
            result.repairPerformed = false
            result.liveShadowConsistent = true
            result.diagnostic = "active_snapshot_live_shadow_consistent:${pointer.txId}"
            return result
        }
        var preserveLiveLifecycle = false
        var liveCandidateVersion = ""
        var liveFailedVersion = ""
        try {
            let live = this.loadMetadataStatusFromPrefix("")
            if (live.activeVersion == pointer.activeVersion) {
                preserveLiveLifecycle = true
                liveCandidateVersion = live.candidateVersion
                liveFailedVersion = live.failedVersion
            }
        } catch (_: Exception) {
            // An unreadable or identity-mismatched live status cannot override
            // the authoritative transaction status during repair.
            ()
        }
        try {
            this.copySnapshotDirectoryContentsFromTx(txRoot, "raw", 0,
                "active_snapshot_repair_raw")
            result.copiedFiles.add("raw")
            this.copySnapshotFileFromTx(txRoot, "normalized/records.ckb", result)
            this.copySnapshotFileFromTx(txRoot, "index/active.version", result)
            this.copySnapshotFileFromTx(txRoot, "index/active.ckb", result)
            this.copySnapshotFileFromTx(txRoot, "index/graph-nodes.ckb", result)
            this.copySnapshotFileFromTx(txRoot, "index/graph-edges.ckb", result)
            this.copySnapshotFileFromTx(txRoot, "metadata/status.ckb", result)
            if (preserveLiveLifecycle) {
                let lifecycle = KnowledgeStatus()
                lifecycle.activeKnowledgeVersion = pointer.activeVersion
                lifecycle.candidateKnowledgeVersion = liveCandidateVersion
                lifecycle.failedCandidateVersion = liveFailedVersion
                this.saveLiveCandidateLifecycleMetadata(lifecycle)
            }
            let metadata = this.loadMetadataStatusFromPrefix(txRoot)
            let vectorCollection = if (metadata.vectorActiveCollection == "") { "active" } else { metadata.vectorActiveCollection }
            let vectorRelative = "index/vector-${safeName(vectorCollection)}.ckb"
            if (this.has("${txRoot}/${vectorRelative}")) {
                this.copySnapshotFileFromTx(txRoot, vectorRelative, result)
            }
            if (pointer.companionMode != CkbActiveSnapshotCompanionMode.NONE) {
                this.writeLinesAtomically("metadata/active-cangjie-version-manifest.ckb",
                    this.readLines("${txRoot}/metadata/cangjie-version-manifest.ckb"))
                this.writeLinesAtomically("metadata/active-cangjie-freshness.ckb",
                    this.readLines("${txRoot}/metadata/cangjie-freshness.ckb"))
                this.writeLinesAtomically("metadata/active-cangjie-release-coverage.ckb",
                    this.readLines("${txRoot}/metadata/cangjie-release-coverage.ckb"))
                result.copiedFiles.add("metadata/active-cangjie-version-manifest.ckb")
                result.copiedFiles.add("metadata/active-cangjie-freshness.ckb")
                result.copiedFiles.add("metadata/active-cangjie-release-coverage.ckb")
            } else {
                this.deleteActiveSnapshotCompanionLiveShadows()
                result.removedFiles.add("metadata/active-cangjie-version-manifest.ckb")
                result.removedFiles.add("metadata/active-cangjie-freshness.ckb")
                result.removedFiles.add("metadata/active-cangjie-release-coverage.ckb")
            }
        } catch (e: Exception) {
            result.ok = false
            result.liveShadowConsistent = false
            result.diagnostic = "active_snapshot_live_shadow_repair_failed:${utf8SafePrefix(redactSensitive(e.message), 180)}"
            return result
        }
        result.liveShadowConsistent = this.activeLiveShadowMatchesTx(txRoot,
            companionMode: pointer.companionMode)
        result.ok = result.liveShadowConsistent
        result.repairPerformed = true
        result.diagnostic = if (result.ok) {
            "active_snapshot_live_shadow_repaired:${pointer.txId}"
        } else { "active_snapshot_live_shadow_repair_verify_failed:${pointer.txId}" }
        result
    }

    public func saveDerived(task: CurationTask): Unit {
        this.writeLines("derived/${safeName(task.taskId)}.ckb", "${task.taskId}|${task.kind}|${task.repo}|${task.status}|${escapeField(task.derivedKnowledge)}\n")
    }

    public func saveRepositoryListRefresh(result: CkbAdminOperationResult): Unit {
        var text = "repo=${escapeField(result.repo)}\n"
        text += "ref=${escapeField(result.ref)}\n"
        text += "status=active\n"
        text += "activeRepoListVersion=${escapeField(result.activeRepoListVersion)}\n"
        text += "candidateRepoListVersion=${escapeField(result.candidateRepoListVersion)}\n"
        text += "repoCount=${result.repoCount}\n"
        text += "paths=${escapeField(joinStrings(result.matchedPaths, ","))}\n"
        this.writeLinesAtomically("metadata/repo-list.ckb", text)
    }

    public func saveRepositoryEventCheckpoint(result: CkbAdminOperationResult): Unit {
        var text = "repo=${escapeField(result.repo)}\n"
        text += "ref=${escapeField(result.ref)}\n"
        text += "profile=${escapeField(result.profile)}\n"
        text += "status=${escapeField(result.status)}\n"
        text += "diagnostic=${escapeField(result.diagnostic)}\n"
        text += "prNumber=${result.prNumber}\n"
        text += "requestCount=${result.requestCount}\n"
        text += "updatedDataKinds=${escapeField(joinStrings(result.updatedDataKinds, ","))}\n"
        text += "matchedPaths=${escapeField(joinStrings(result.matchedPaths, ","))}\n"
        text += "activeKnowledgeVersion=${escapeField(result.activeKnowledgeVersion)}\n"
        text += "candidateKnowledgeVersion=${escapeField(result.candidateKnowledgeVersion)}\n"
        this.writeLinesAtomically("metadata/repository-event-latest.ckb", text)
    }

    public func repositoryEventLegacyMigrationStatus(): String {
        let path = "metadata/repository-event-latest.ckb"
        if (!this.has(path)) { return "legacy-unverified" }
        let text = try { this.readText(path) } catch (_: Exception) {
            return "legacy-unverified"
        }
        if (text.trimAscii() == "" || ckbCurrentField(text, "status") == "") {
            return "legacy-unverified"
        }
        "legacy-unverified"
    }

    public func emitRepositoryEventTypedLog(event: String,
        receipt: CkbRepositoryEventReceipt, runId!: String = "",
        stage!: String = "receipt", status!: String = "",
        errorCode!: String = "", requestCount!: Int64 = 0): Unit {
        try {
            this.appendLinesAtomically("metadata/repository-event-events.jsonl",
                ckbRepositoryEventTypedLogJson(event, receipt.eventId, runId,
                    receipt.attempt, stage,
                    if (status == "") { receipt.state } else { status },
                    errorCode,
                    if (receipt.updatedAtMillis >= receipt.createdAtMillis) {
                        receipt.updatedAtMillis - receipt.createdAtMillis
                    } else { 0 }, requestCount))
        } catch (_: Exception) { () }
    }

    public func saveRepositoryEventLedger(ledger: CkbRepositoryEventLedger): CkbRepositoryEventLedger {
        ledger.checksum = ckbRepositoryEventLedgerChecksum(ledger)
        this.writeLinesAtomically(ckbRepositoryEventLedgerPath(ledger.dedupeKey),
            ckbRepositoryEventLedgerText(ledger))
        let loaded = this.loadRepositoryEventLedger(ledger.dedupeKey)
        if (!loaded.valid || loaded.checksum != ledger.checksum) {
            throw Exception("repository_event_ledger_readback_failed")
        }
        if (loaded.state == "committed" && loaded.committedEvidenceHash ==
            ckbRepositoryEventCommittedEvidenceHash(loaded)) {
            this.writeLinesAtomically("metadata/repository-event-last-success.ckb",
                ckbRepositoryEventLedgerText(loaded))
        }
        loaded
    }

    public func materializeRepositoryEventCommittedLedger(receipt: CkbRepositoryEventReceipt,
        outcome: CkbRepositoryEventWorkerResult): CkbRepositoryEventLedger {
        let invalid = CkbRepositoryEventLedger()
        let pointer = this.loadActiveSnapshotPointer()
        if (!receipt.valid || outcome.state != "committed") { invalid.diagnostic = "repository_event_receipt_not_committable"; return invalid }
        if (outcome.schedulerRunId == "") { invalid.diagnostic = "repository_event_run_id_missing"; return invalid }
        if (outcome.transactionId == "") { invalid.diagnostic = "repository_event_transaction_id_missing"; return invalid }
        if (outcome.candidateVersion == "") { invalid.diagnostic = "repository_event_candidate_version_missing"; return invalid }
        if (outcome.activeVersion == "") { invalid.diagnostic = "repository_event_active_version_missing"; return invalid }
        if (outcome.validationEvidenceHash == "" || !outcome.validationGates.contains("candidate_validation_passed")) { invalid.diagnostic = "repository_event_validation_evidence_missing"; return invalid }
        if (!pointer.valid || pointer.txId != outcome.transactionId || pointer.activeVersion != outcome.activeVersion) { invalid.diagnostic = "repository_event_active_transaction_misaligned"; return invalid }
        let ledger = this.loadRepositoryEventLedger(receipt.dedupeKey)
        ledger.eventId = receipt.eventId
        ledger.dedupeKey = receipt.dedupeKey
        ledger.canonicalSha256 = receipt.canonicalSha256
        // Persist transaction evidence before the inbox CAS. The receipt
        // transition is the authoritative commit point and advances
        // last-success only after the durable receipt is committed.
        ledger.state = receipt.state
        ledger.resolvedCommit = receipt.resolvedCommit
        ledger.ingestedEvidenceHash = outcome.validationEvidenceHash
        ledger.schedulerRunId = outcome.schedulerRunId
        ledger.transactionId = outcome.transactionId
        ledger.candidateVersion = outcome.candidateVersion
        ledger.activeVersion = outcome.activeVersion
        ledger.gates.clear()
        ledger.gates.add("event_inbox_committed")
        ledger.gates.add("event_delta_reconciled")
        ledger.gates.add("candidate_validation_passed")
        ledger.gates.add("active_transaction_verified")
        ledger.gates.add("repository_event_checkpoint_verified")
        ledger.committedEvidenceHash = ckbRepositoryEventCommittedEvidenceHash(ledger)
        this.saveRepositoryEventLedger(ledger)
    }

    public func loadRepositoryEventLedger(dedupeKey: String): CkbRepositoryEventLedger {
        let ledger = CkbRepositoryEventLedger()
        let path = ckbRepositoryEventLedgerPath(dedupeKey)
        if (!this.has(path)) { return ledger }
        let text = try { this.readText(path) } catch (_: Exception) {
            ledger.diagnostic = "invalid_response_encoding"; return ledger
        }
        if (ckbCurrentField(text, "schemaVersion") != "ckb-repository-event-ledger-v1") {
            ledger.diagnostic = "repository_event_ledger_malformed"; return ledger
        }
        ledger.eventId = unescapeField(ckbCurrentField(text, "eventId")); ledger.dedupeKey = unescapeField(ckbCurrentField(text, "dedupeKey")); ledger.canonicalSha256 = ckbCurrentField(text, "canonicalSha256"); ledger.state = ckbCurrentField(text, "state"); ledger.resolvedCommit = unescapeField(ckbCurrentField(text, "resolvedCommit")); ledger.ingestedEvidenceHash = ckbCurrentField(text, "ingestedEvidenceHash"); ledger.committedEvidenceHash = ckbCurrentField(text, "committedEvidenceHash"); ledger.schedulerRunId = unescapeField(ckbCurrentField(text, "schedulerRunId")); ledger.transactionId = unescapeField(ckbCurrentField(text, "transactionId")); ledger.candidateVersion = unescapeField(ckbCurrentField(text, "candidateVersion")); ledger.activeVersion = unescapeField(ckbCurrentField(text, "activeVersion")); ledger.checksum = ckbCurrentField(text, "checksum")
        for (line in text.split("\n")) {
            let fields = line.split("|")
            if (fields.size == 2 && fields[0] == "gate") {
                ledger.gates.add(utf8SafePrefix(unescapeField(fields[1]), 240))
            }
        }
        ledger.valid = ledger.dedupeKey == dedupeKey && ledger.canonicalSha256 != "" && (ledger.state == "queued" || ledger.state == "running" || ledger.state == "retryable" || ledger.state == "failed" || ledger.state == "committed") && ledger.checksum == ckbRepositoryEventLedgerChecksum(ledger)
        ledger.diagnostic = if (ledger.valid) { "ok" } else { "repository_event_ledger_checksum_mismatch" }
        ledger
    }

    public func loadRepositoryEventLedgerForEventId(eventId: String): CkbRepositoryEventLedger {
        let empty = CkbRepositoryEventLedger()
        if (eventId == "") { return empty }
        let directory = this.root.join("metadata/repository-event-ledger")
        try {
            for (entry in Directory.readFrom(directory)) {
                if (entry.isDirectory() || !entry.name.endsWith(".ckb")) { continue }
                let text = String.fromUtf8(File.readFrom(entry.path))
                if (unescapeField(ckbCurrentField(text, "eventId")) == eventId) {
                    return this.loadRepositoryEventLedger(unescapeField(ckbCurrentField(text, "dedupeKey")))
                }
            }
        } catch (_: Exception) { () }
        empty
    }

    private func saveRepositoryEventLedgerForReceipt(receipt: CkbRepositoryEventReceipt): Unit {
        let ledger = this.loadRepositoryEventLedger(receipt.dedupeKey)
        ledger.eventId = receipt.eventId
        ledger.dedupeKey = receipt.dedupeKey
        ledger.canonicalSha256 = receipt.canonicalSha256
        ledger.state = receipt.state
        ledger.resolvedCommit = receipt.resolvedCommit
        _ = this.saveRepositoryEventLedger(ledger)
    }

    // S1 durable inbox: event records are immutable while the queue pointer is
    // a separate, verified discovery artifact for the S2 scheduler consumer.
    public func saveRepositoryEventReceipt(receipt: CkbRepositoryEventReceipt): CkbRepositoryEventReceipt {
        let existing = this.loadRepositoryEventReceipt(receipt.dedupeKey)
        if (existing.valid) {
            if (!this.has(existing.queuePointerPath)) {
                this.writeLinesAtomically(existing.queuePointerPath, ckbRepositoryEventQueuePointerText(existing))
                if (!this.repositoryEventQueuePointerMatches(existing)) {
                    throw Exception("repository_event_queue_pointer_repair_failed")
                }
            } else if (!this.repositoryEventQueuePointerMatches(existing)) {
                throw Exception("repository_event_queue_pointer_conflict")
            }
            existing.existing = true
            return existing
        }
        if (existing.diagnostic != "not_found") {
            throw Exception("repository_event_receipt_conflict")
        }
        let eventPath = ckbRepositoryEventReceiptPath(receipt.dedupeKey)
        let pointerPath = ckbRepositoryEventQueuePointerPath(receipt.dedupeKey)
        receipt.artifactPath = eventPath
        receipt.queuePointerPath = pointerPath
        receipt.checksum = ckbRepositoryEventReceiptChecksum(receipt)
        try {
            this.writeLinesAtomically(eventPath, ckbRepositoryEventReceiptText(receipt))
            let readback = this.loadRepositoryEventReceipt(receipt.dedupeKey)
            if (!readback.valid || readback.checksum != receipt.checksum) {
                throw Exception("repository_event_receipt_readback_failed")
            }
            this.writeLinesAtomically(pointerPath, ckbRepositoryEventQueuePointerText(receipt))
            if (!this.repositoryEventQueuePointerMatches(receipt)) {
                throw Exception("repository_event_queue_pointer_readback_failed")
            }
        } catch (e: Exception) {
            this.deleteRepositoryEventInboxFile(pointerPath)
            this.deleteRepositoryEventInboxFile(eventPath)
            throw e
        }
        receipt.valid = true
        receipt.diagnostic = "queued"
        this.saveRepositoryEventLedgerForReceipt(receipt)
        receipt
    }

    // Content is persisted with the event identity, rather than treating a
    // completed path as proof that a later retry still has its bytes.
    public func saveRepositoryEventFetchContent(receipt: CkbRepositoryEventReceipt,
        resolvedCommit: String, request: SourceFetchRequest, fetch: SourceFetchResult): Bool {
        if (!fetch.ok || request.path == "" || resolvedCommit == "" ||
            !ckbSafeRepoRelativePath(request.path)) { return false }
        let contentHash = ckbReleaseEvidenceHash(fetch.body)
        var text = "schemaVersion=ckb-repository-event-fetch-v1\n"
        text += "eventId=${escapeField(receipt.eventId)}\nrepo=${escapeField(receipt.repo)}\n"
        text += "resolvedCommit=${escapeField(resolvedCommit)}\npath=${escapeField(request.path)}\n"
        text += "sourceUrl=${escapeField(fetch.sourceUrl)}\nbodyHash=${escapeField(fetch.bodyHash)}\n"
        text += "contentSha256=${contentHash}\ncontent=${escapeField(fetch.body)}\n"
        let checksum = ckbReleaseEvidenceHash(text)
        text += "checksum=${checksum}\n"
        try {
            this.writeLinesAtomically(ckbRepositoryEventFetchCachePath(receipt.eventId,
                receipt.repo, resolvedCommit, request.path), text)
            true
        } catch (_: Exception) { false }
    }

    public func loadRepositoryEventFetchContent(receipt: CkbRepositoryEventReceipt,
        resolvedCommit: String, request: SourceFetchRequest): SourceFetchResult {
        let miss = SourceFetchResult()
        miss.status = "repository_event_content_cache_miss"
        if (request.path == "" || resolvedCommit == "" || !ckbSafeRepoRelativePath(request.path)) {
            miss.status = "repository_event_content_cache_input_invalid"
            return miss
        }
        let text = try {
            this.readText(ckbRepositoryEventFetchCachePath(receipt.eventId, receipt.repo,
                resolvedCommit, request.path))
        } catch (_: Exception) {
            miss.status = "invalid_response_encoding"
            return miss
        }
        if (text == "") { return miss }
        var payload = ""
        let prefix = text.split("\n")
        for (index in 0..prefix.size) {
            let line = prefix[index]
            if (index == prefix.size - 1 && line == "") { continue }
            if (!line.startsWith("checksum=")) { payload += line + "\n" }
        }
        let checksum = ckbCurrentField(text, "checksum")
        let body = ckbCurrentField(text, "content")
        if (ckbCurrentField(text, "schemaVersion") != "ckb-repository-event-fetch-v1" ||
            ckbCurrentField(text, "eventId") != receipt.eventId ||
            ckbCurrentField(text, "repo") != receipt.repo ||
            ckbCurrentField(text, "resolvedCommit") != resolvedCommit ||
            ckbCurrentField(text, "path") != request.path ||
            ckbCurrentField(text, "contentSha256") != ckbReleaseEvidenceHash(body) ||
            checksum != ckbReleaseEvidenceHash(payload)) {
            miss.status = "repository_event_content_cache_invalid"
            return miss
        }
        let hit = SourceFetchResult()
        hit.ok = true
        hit.status = "repository_event_content_cache_hit"
        hit.statusCode = 200
        hit.body = body
        hit.bodyHash = ckbCurrentField(text, "bodyHash")
        hit.sourceUrl = ckbCurrentField(text, "sourceUrl")
        hit.repo = receipt.repo
        hit.ref = request.ref
        hit.path = request.path
        hit.commit = resolvedCommit
        hit.normalizedType = request.kind
        hit
    }

    public func saveRepositoryEventRecoveryMarker(eventIdentity: String, txId: String,
        activeVersion: String, pointerHash: String): Unit {
        let payload = "schemaVersion=ckb-repository-event-recovery-v1\neventIdentity=${escapeField(eventIdentity)}\ntxId=${escapeField(txId)}\nactiveVersion=${escapeField(activeVersion)}\npointerHash=${escapeField(pointerHash)}\nstatus=committed_recovery_required\n"
        this.writeLinesAtomically("metadata/repository-event-inbox/recovery.ckb",
            payload + "checksum=${ckbReleaseEvidenceHash(payload)}\n")
    }

    public func loadRepositoryEventRecoveryMarker(): String {
        this.repositoryEventRecoveryMarkerStatus().text
    }

    public func repositoryEventRecoveryMarkerStatus(): CkbRepositoryEventRecoveryMarkerStatus {
        let status = CkbRepositoryEventRecoveryMarkerStatus()
        var liveDecodeInvalid = false
        let live = try { this.readText("metadata/repository-event-inbox/recovery.ckb") } catch (_: Exception) {
            liveDecodeInvalid = true
            ""
        }
        let pointer = this.loadActiveSnapshotPointer()
        var sidecarDecodeInvalid = false
        let sidecar = if (pointer.valid) {
            try { this.readText("transactions/${safeName(pointer.txId)}/metadata/repository-event-recovery.ckb") } catch (_: Exception) {
                sidecarDecodeInvalid = true
                ""
            }
        } else { "" }
        let text = if (live != "") { live } else { sidecar }
        if (text == "") {
            if (liveDecodeInvalid || sidecarDecodeInvalid) { status.status = "invalid_response_encoding" }
            return status
        }
        if (live == "" && ckbCurrentField(text, "status") == "consumed") { return status }
        let payload = ckbRepositoryEventRecoveryPayload(text)
        if (ckbCurrentField(text, "schemaVersion") != "ckb-repository-event-recovery-v1" ||
            ckbCurrentField(text, "status") != "committed_recovery_required" ||
            ckbCurrentField(text, "eventIdentity") == "" ||
            ckbCurrentField(text, "txId") == "" ||
            ckbCurrentField(text, "activeVersion") == "" ||
            ckbCurrentField(text, "pointerHash") == "" ||
            ckbCurrentField(text, "checksum") != ckbReleaseEvidenceHash(payload)) {
            status.status = "repository_event_recovery_marker_invalid"
            return status
        }
        let expectedPointerHash = ckbReleaseEvidenceHash("${pointer.txId}|${pointer.activeVersion}|${pointer.manifestHash}|${pointer.freshnessHash}|${pointer.coverageHash}")
        if (!pointer.valid || ckbCurrentField(text, "txId") != pointer.txId ||
            ckbCurrentField(text, "activeVersion") != pointer.activeVersion ||
            ckbCurrentField(text, "pointerHash") != expectedPointerHash) {
            status.status = "repository_event_recovery_pointer_mismatch"
            return status
        }
        status.valid = true
        status.status = "committed_recovery_required"
        status.text = text
        status
    }

    public func repositoryEventRecoverySidecarStatus(): CkbRepositoryEventRecoveryMarkerStatus {
        let status = CkbRepositoryEventRecoveryMarkerStatus()
        let pointer = this.loadActiveSnapshotPointer()
        if (!pointer.valid) { return status }
        let text = try { this.readText("transactions/${safeName(pointer.txId)}/metadata/repository-event-recovery.ckb") } catch (_: Exception) {
            status.status = "invalid_response_encoding"
            return status
        }
        if (text == "" || ckbCurrentField(text, "status") == "consumed") { return status }
        let payload = ckbRepositoryEventRecoveryPayload(text)
        let expected = ckbReleaseEvidenceHash("${pointer.txId}|${pointer.activeVersion}|${pointer.manifestHash}|${pointer.freshnessHash}|${pointer.coverageHash}")
        if (ckbCurrentField(text, "schemaVersion") != "ckb-repository-event-recovery-v1" ||
            ckbCurrentField(text, "status") != "committed_recovery_required" ||
            ckbCurrentField(text, "txId") != pointer.txId ||
            ckbCurrentField(text, "activeVersion") != pointer.activeVersion ||
            ckbCurrentField(text, "pointerHash") != expected ||
            ckbCurrentField(text, "checksum") != ckbReleaseEvidenceHash(payload)) {
            status.status = "repository_event_recovery_sidecar_invalid"
            return status
        }
        status.valid = true
        status.status = "committed_recovery_required"
        status.text = text
        status
    }

    public func clearRepositoryEventRecoveryMarker(): Unit {
        this.deleteRepositoryEventInboxFile("metadata/repository-event-inbox/recovery.ckb")
    }

    public func consumeRepositoryEventRecoverySidecar(txId: String): Bool {
        let authority = this.repositoryEventRecoverySidecarStatus()
        if (!authority.valid || ckbCurrentField(authority.text, "txId") != txId) { return false }
        let relative = "transactions/${safeName(txId)}/metadata/repository-event-recovery.ckb"
        try {
            // Re-read and compare to the validated authority so a corrupt or
            // concurrently replaced sidecar can never be rewritten as consumed.
            let text = this.readText(relative)
            if (text == "" || text != authority.text) { return false }
            var payload = ""
            let lines = text.split("\n")
            for (index in 0..lines.size) {
                let line = lines[index]
                if (index == lines.size - 1 && line == "") { continue }
                if (line.startsWith("checksum=")) { continue }
                if (line == "status=committed_recovery_required") {
                    payload += "status=consumed\n"
                } else { payload += line + "\n" }
            }
            let consumed = payload + "checksum=${ckbReleaseEvidenceHash(payload)}\n"
            this.writeLinesAtomically(relative, consumed)
            this.readText(relative) == consumed
        } catch (_: Exception) { false }
    }

    // Claims are serialized by a short-lived store-local directory lock.  The
    // receipt revision is still checked before every write, so a stale process
    // cannot complete a lease it no longer owns after crash recovery.
    public func claimRepositoryEventReceipt(dedupeKey: String, owner: String,
        nowMillis: Int64, leaseMillis: Int64): CkbRepositoryEventLeaseResult {
        let result = CkbRepositoryEventLeaseResult()
        if (owner == "" || leaseMillis <= 0 || nowMillis <= 0) {
            result.state = "invalid"
            result.diagnostic = "repository_event_claim_input_invalid"
            return result
        }
        let current = this.loadRepositoryEventReceipt(dedupeKey)
        if (!current.valid) {
            result.state = "invalid"
            result.diagnostic = current.diagnostic
            return result
        }
        if (current.state == "committed" || current.state == "failed") {
            result.state = current.state
            result.diagnostic = "repository_event_terminal"
            result.receipt = current
            return result
        }
        if (current.state == "running" && current.leaseUntilMillis > nowMillis) {
            result.state = "running"
            result.diagnostic = "repository_event_lease_held"
            result.receipt = current
            return result
        }
        if (current.state == "retryable" && current.nextAttemptAtMillis > nowMillis) {
            result.state = "retryable"
            result.diagnostic = "repository_event_retry_not_due"
            result.receipt = current
            return result
        }
        if (!this.acquireRepositoryEventMutationLock(dedupeKey, current, nowMillis)) {
            result.state = "running"
            result.diagnostic = "repository_event_claim_conflict"
            result.receipt = this.loadRepositoryEventReceipt(dedupeKey)
            return result
        }
        try {
            let fresh = this.loadRepositoryEventReceipt(dedupeKey)
            if (!fresh.valid || fresh.revision != current.revision ||
                (fresh.state == "running" && fresh.leaseUntilMillis > nowMillis) ||
                (fresh.state == "retryable" && fresh.nextAttemptAtMillis > nowMillis)) {
                result.state = if (fresh.valid) { fresh.state } else { "invalid" }
                result.diagnostic = if (fresh.valid) { "repository_event_claim_conflict" } else { fresh.diagnostic }
                result.receipt = fresh
                return result
            }
            if (fresh.attempt >= fresh.maxAttempts) {
                let failed = this.transitionRepositoryEventReceiptUnlocked(fresh, fresh.revision,
                    "", "failed", nowMillis, 0, 0, "max_attempts_exhausted")
                result.state = failed.state
                result.diagnostic = if (failed.valid) { "max_attempts_exhausted" } else { failed.diagnostic }
                result.receipt = failed
                return result
            }
            let claimed = this.transitionRepositoryEventReceiptUnlocked(fresh, fresh.revision,
                owner, "running", nowMillis, nowMillis + leaseMillis, 0, "", claimAttempt: true)
            result.claimed = claimed.valid && claimed.state == "running" && claimed.leaseOwner == owner
            result.state = claimed.state
            result.diagnostic = if (result.claimed) { "repository_event_claimed" } else { claimed.diagnostic }
            result.receipt = claimed
        } finally {
            this.releaseRepositoryEventMutationLock(dedupeKey)
        }
        result
    }

    public func heartbeatRepositoryEventReceipt(dedupeKey: String, owner: String,
        expectedRevision: Int64, nowMillis: Int64, leaseMillis: Int64): CkbRepositoryEventReceipt {
        if (owner == "" || leaseMillis <= 0 || nowMillis <= 0) {
            return this.loadRepositoryEventReceipt(dedupeKey)
        }
        this.transitionRepositoryEventReceipt(dedupeKey, expectedRevision, owner, "running",
            nowMillis, nowMillis + leaseMillis, 0, "", expectedState: "running")
    }

    // Ref names are mutable. Pin the resolved commit under the same receipt
    // CAS/lease that owns acquisition so retries cannot silently switch trees.
    public func pinRepositoryEventResolvedCommit(receipt: CkbRepositoryEventReceipt,
        resolvedCommit: String, nowMillis: Int64): CkbRepositoryEventReceipt {
        if (!receipt.valid || receipt.state != "running" || receipt.leaseOwner == "" ||
            resolvedCommit == "" || nowMillis <= 0) { return receipt }
        let current = this.loadRepositoryEventReceipt(receipt.dedupeKey)
        if (!current.valid || !this.acquireRepositoryEventMutationLock(receipt.dedupeKey, current, nowMillis)) { return current }
        try {
            let fresh = this.loadRepositoryEventReceipt(receipt.dedupeKey)
            if (!fresh.valid || fresh.state != "running" || fresh.leaseOwner != receipt.leaseOwner ||
                fresh.revision != receipt.revision || fresh.leaseUntilMillis <= nowMillis ||
                (fresh.resolvedCommit != "" && fresh.resolvedCommit != resolvedCommit)) { return fresh }
            if (fresh.resolvedCommit == resolvedCommit) { return fresh }
            fresh.resolvedCommit = resolvedCommit
            fresh.canonicalSha256 = ckbRepositoryEventCanonicalSha256(fresh)
            fresh.revision += 1
            fresh.updatedAtMillis = nowMillis
            fresh.checksum = ckbRepositoryEventReceiptChecksum(fresh)
            this.writeLinesAtomically(fresh.artifactPath, ckbRepositoryEventReceiptText(fresh))
            this.writeLinesAtomically(fresh.queuePointerPath, ckbRepositoryEventQueuePointerText(fresh))
            let readback = this.loadRepositoryEventReceipt(fresh.dedupeKey)
            if (!readback.valid) { return current }
            receipt.resolvedCommit = readback.resolvedCommit
            receipt.canonicalSha256 = readback.canonicalSha256
            receipt.checksum = readback.checksum
            receipt.revision = readback.revision
            receipt.updatedAtMillis = readback.updatedAtMillis
            readback
        } catch (_: Exception) { current } finally {
            this.releaseRepositoryEventMutationLock(receipt.dedupeKey)
        }
    }

    public func completeRepositoryEventReceipt(dedupeKey: String, owner: String,
        expectedRevision: Int64, nowMillis: Int64): CkbRepositoryEventReceipt {
        this.transitionRepositoryEventReceipt(dedupeKey, expectedRevision, owner, "committed",
            nowMillis, 0, 0, "", expectedState: "running")
    }

    public func retryRepositoryEventReceipt(dedupeKey: String, owner: String,
        expectedRevision: Int64, nowMillis: Int64, backoffMillis: Int64,
        errorCode: String): CkbRepositoryEventReceipt {
        let current = this.loadRepositoryEventReceipt(dedupeKey)
        if (!current.valid || current.state != "running" || current.leaseOwner != owner) { return current }
        let state = if (current.attempt >= current.maxAttempts) { "failed" } else { "retryable" }
        let next = if (state == "retryable") { nowMillis + if (backoffMillis > 0) { backoffMillis } else { 1 } } else { 0 }
        this.transitionRepositoryEventReceipt(dedupeKey, expectedRevision, owner, state,
            nowMillis, 0, next, errorCode, expectedState: "running")
    }

    public func failRepositoryEventReceipt(dedupeKey: String, owner: String,
        expectedRevision: Int64, nowMillis: Int64, errorCode: String): CkbRepositoryEventReceipt {
        this.transitionRepositoryEventReceipt(dedupeKey, expectedRevision, owner, "failed",
            nowMillis, 0, 0, if (errorCode == "") { "worker_failed" } else { errorCode },
            expectedState: "running")
    }

    // The scheduler worker discovers only verified queue pointers.  It receives
    // a claim, not an HTTP request, which keeps execution out of ingress.
    public func dueRepositoryEventReceipts(nowMillis: Int64): ArrayList<CkbRepositoryEventReceipt> {
        let due = ArrayList<CkbRepositoryEventReceipt>()
        let queue = this.root.join("metadata/repository-event-inbox/queue")
        if (!exists(queue) || nowMillis <= 0) { return due }
        try {
            for (entry in Directory.readFrom(queue)) {
                if (entry.isDirectory() || !entry.name.endsWith(".ckb")) { continue }
                let text = try { String.fromUtf8(File.readFrom(entry.path)) } catch (_: Exception) { continue }
                let key = ckbCurrentField(text, "dedupeKey")
                if (key == "") { continue }
                let receipt = this.loadRepositoryEventReceipt(key)
                if (!receipt.valid) { continue }
                if ((receipt.state == "queued" && receipt.nextAttemptAtMillis <= nowMillis) ||
                    (receipt.state == "retryable" && receipt.nextAttemptAtMillis <= nowMillis) ||
                    (receipt.state == "running" && receipt.leaseUntilMillis <= nowMillis)) {
                    due.add(receipt)
                }
            }
        } catch (_: Exception) { return due }
        due
    }

    private func transitionRepositoryEventReceipt(dedupeKey: String, expectedRevision: Int64,
        owner: String, state: String, nowMillis: Int64, leaseUntilMillis: Int64,
        nextAttemptAtMillis: Int64, errorCode: String, expectedState!: String = ""): CkbRepositoryEventReceipt {
        let current = this.loadRepositoryEventReceipt(dedupeKey)
        if (!current.valid || !this.acquireRepositoryEventMutationLock(dedupeKey, current, nowMillis)) { return current }
        try {
            let fresh = this.loadRepositoryEventReceipt(dedupeKey)
            if (!fresh.valid || fresh.revision != expectedRevision ||
                (expectedState != "" && fresh.state != expectedState) ||
                (owner != "" && fresh.leaseOwner != owner) ||
                (expectedState == "running" && fresh.leaseUntilMillis <= nowMillis)) { return fresh }
            this.transitionRepositoryEventReceiptUnlocked(fresh, expectedRevision, owner, state,
                nowMillis, leaseUntilMillis, nextAttemptAtMillis, errorCode)
        } finally {
            this.releaseRepositoryEventMutationLock(dedupeKey)
        }
    }

    private func transitionRepositoryEventReceiptUnlocked(current: CkbRepositoryEventReceipt,
        expectedRevision: Int64, owner: String, state: String, nowMillis: Int64,
        leaseUntilMillis: Int64, nextAttemptAtMillis: Int64, errorCode: String,
        claimAttempt!: Bool = false): CkbRepositoryEventReceipt {
        let invalid = CkbRepositoryEventReceipt()
        invalid.dedupeKey = current.dedupeKey
        invalid.diagnostic = "repository_event_revision_conflict"
        if (!current.valid || current.revision != expectedRevision || nowMillis <= 0) { return invalid }
        let next = current
        next.state = state
        next.revision = current.revision + 1
        next.updatedAtMillis = nowMillis
        next.leaseOwner = if (state == "running") { owner } else { "" }
        next.leaseUntilMillis = if (state == "running") { leaseUntilMillis } else { 0 }
        next.nextAttemptAtMillis = nextAttemptAtMillis
        next.lastErrorCode = errorCode
        // A heartbeat remains in the same attempt.  Only a fresh claim (queued
        // or retryable/expired-running to running) consumes retry budget.
        if (claimAttempt) {
            next.attempt = current.attempt + 1
        }
        next.checksum = ckbRepositoryEventReceiptChecksum(next)
        try {
            this.writeLinesAtomically(next.artifactPath, ckbRepositoryEventReceiptText(next))
            this.writeLinesAtomically(next.queuePointerPath, ckbRepositoryEventQueuePointerText(next))
            let readback = this.loadRepositoryEventReceipt(next.dedupeKey)
            if (!readback.valid || readback.revision != next.revision ||
                readback.checksum != next.checksum) { return invalid }
            this.saveRepositoryEventLedgerForReceipt(readback)
            let typedEvent = if (readback.state == "running") { "claimed" } else { readback.state }
            this.emitRepositoryEventTypedLog(typedEvent, readback,
                runId: if (readback.state == "running") { owner } else { "" },
                stage: if (readback.state == "running") { "claim" } else { "complete" },
                errorCode: readback.lastErrorCode)
            readback
        } catch (_: Exception) {
            invalid.diagnostic = "repository_event_transition_write_failed"
            invalid
        }
    }

    private func acquireRepositoryEventMutationLock(dedupeKey: String,
        current: CkbRepositoryEventReceipt, nowMillis: Int64): Bool {
        let relative = ckbRepositoryEventMutationLockPath(dedupeKey)
        let path = this.root.join(relative)
        let pending = this.root.join(ckbRepositoryEventMutationPendingPath(dedupeKey))
        if (exists(path)) {
            // The mutation lock has its own TTL.  A queued receipt has no event
            // lease yet, therefore its zero lease must never be used to evict a
            // live claimant between directory creation and the first state write.
            let lockText = try { String.fromUtf8(File.readFrom(path.join("lock.ckb"))) } catch (_: Exception) {
                try { String.fromUtf8(File.readFrom(pending)) } catch (_: Exception) { "" }
            }
            let expiresAtMillis = parseIntField(ckbCurrentField(lockText, "expiresAtMillis"), 0)
            if (expiresAtMillis > 0 && expiresAtMillis <= nowMillis) {
                try { _ = launch("/bin/rm", ["-rf", path.toString()]).wait() } catch (_: Exception) { () }
            } else {
                return false
            }
        }
        var createdLock = false
        try {
            // Persist an expiry before mkdir.  If the process crashes between
            // mkdir and lock.ckb, a later owner can reclaim only after this
            // independent short TTL; it never infers expiry from event lease.
            if (!exists(pending.parent)) { Directory.create(pending.parent, recursive: true) }
            File.writeTo(pending, "expiresAtMillis=${nowMillis + 30000}\n".toArray())
            Directory.create(path, recursive: false)
            createdLock = true
            File.writeTo(path.join("lock.ckb"), "expiresAtMillis=${nowMillis + 30000}\n".toArray())
            true
        } catch (_: Exception) {
            if (createdLock) {
                try { _ = launch("/bin/rm", ["-rf", path.toString()]).wait() } catch (_: Exception) { () }
            }
            false
        }
    }

    private func releaseRepositoryEventMutationLock(dedupeKey: String): Unit {
        let path = this.root.join(ckbRepositoryEventMutationLockPath(dedupeKey))
        try { _ = launch("/bin/rm", ["-rf", path.toString()]).wait() } catch (_: Exception) { () }
        let pending = this.root.join(ckbRepositoryEventMutationPendingPath(dedupeKey))
        try { _ = launch("/bin/rm", ["-f", pending.toString()]).wait() } catch (_: Exception) { () }
    }

    public func loadRepositoryEventReceipt(dedupeKey: String): CkbRepositoryEventReceipt {
        let receipt = CkbRepositoryEventReceipt()
        receipt.dedupeKey = dedupeKey
        receipt.artifactPath = ckbRepositoryEventReceiptPath(dedupeKey)
        receipt.queuePointerPath = ckbRepositoryEventQueuePointerPath(dedupeKey)
        let text = try { this.readText(receipt.artifactPath) } catch (_: Exception) {
            receipt.diagnostic = "invalid_response_encoding"
            return receipt
        }
        if (text == "") { return receipt }
        receipt.schemaVersion = ckbCurrentField(text, "schemaVersion")
        receipt.eventId = ckbCurrentField(text, "eventId")
        receipt.deliveryId = ckbCurrentField(text, "deliveryId")
        receipt.dedupeKey = ckbCurrentField(text, "dedupeKey")
        receipt.canonicalSha256 = ckbCurrentField(text, "canonicalSha256")
        receipt.state = ckbCurrentField(text, "state")
        receipt.attempt = parseIntField(ckbCurrentField(text, "attempt"), -1)
        receipt.revision = parseIntField(ckbCurrentField(text, "revision"), -1)
        receipt.leaseOwner = ckbCurrentField(text, "leaseOwner")
        receipt.leaseUntilMillis = parseIntField(ckbCurrentField(text, "leaseUntilMillis"), -1)
        receipt.nextAttemptAtMillis = parseIntField(ckbCurrentField(text, "nextAttemptAtMillis"), -1)
        receipt.maxAttempts = parseIntField(ckbCurrentField(text, "maxAttempts"), -1)
        receipt.lastErrorCode = ckbCurrentField(text, "lastErrorCode")
        receipt.createdAtMillis = parseIntField(ckbCurrentField(text, "createdAtMillis"), -1)
        receipt.updatedAtMillis = parseIntField(ckbCurrentField(text, "updatedAtMillis"), -1)
        receipt.repo = ckbCurrentField(text, "repo")
        receipt.ref = ckbCurrentField(text, "ref")
        receipt.mergeCommitSha = ckbCurrentField(text, "mergeCommitSha")
        receipt.resolvedCommit = ckbCurrentField(text, "resolvedCommit")
        receipt.changedFilesTruncated = ckbCurrentField(text, "changedFilesTruncated") == "true"
        receipt.changedFilesUnavailable = ckbCurrentField(text, "changedFilesUnavailable") == "true"
        receipt.prNumber = parseIntField(ckbCurrentField(text, "prNumber"), -1)
        let pathCount = parseIntField(ckbCurrentField(text, "changedFileCount"), -1)
        let profileCount = parseIntField(ckbCurrentField(text, "scheduledProfileCount"), -1)
        if (pathCount >= 0 && pathCount <= 256 && profileCount >= 0 && profileCount <= 8) {
            for (index in 0..pathCount) { receipt.changedFiles.add(ckbCurrentField(text, "changedFile${index}")) }
            for (index in 0..profileCount) { receipt.scheduledProfiles.add(ckbCurrentField(text, "scheduledProfile${index}")) }
        }
        receipt.checksum = ckbCurrentField(text, "checksum")
        let expected = ckbRepositoryEventReceiptChecksum(receipt)
        receipt.valid = receipt.schemaVersion == "ckb-repository-event-inbox-v1" &&
            receipt.dedupeKey == dedupeKey && receipt.eventId != "" &&
            receipt.canonicalSha256 == ckbRepositoryEventCanonicalSha256(receipt) &&
            ckbRepositoryEventReceiptStateValid(receipt) &&
            receipt.createdAtMillis > 0 && receipt.updatedAtMillis >= receipt.createdAtMillis &&
            receipt.repo != "" && receipt.ref != "" && receipt.prNumber >= 0 &&
            pathCount == receipt.changedFiles.size && profileCount == receipt.scheduledProfiles.size &&
            receipt.changedFiles.size == ckbCanonicalRepositoryEventPaths(receipt.changedFiles).size &&
            receipt.checksum == expected
        receipt.diagnostic = if (receipt.valid) { receipt.state } else { "repository_event_receipt_invalid" }
        receipt
    }

    private func repositoryEventQueuePointerMatches(receipt: CkbRepositoryEventReceipt): Bool {
        let text = try { this.readText(receipt.queuePointerPath) } catch (_: Exception) { return false }
        let expected = ckbReleaseEvidenceHash("${receipt.artifactPath}|${receipt.dedupeKey}|${receipt.canonicalSha256}|${receipt.checksum}")
        ckbCurrentField(text, "schemaVersion") == "ckb-repository-event-queue-pointer-v1" &&
            ckbCurrentField(text, "eventReceipt") == receipt.artifactPath &&
            ckbCurrentField(text, "dedupeKey") == receipt.dedupeKey &&
            ckbCurrentField(text, "canonicalSha256") == receipt.canonicalSha256 &&
            ckbCurrentField(text, "checksum") == expected
    }

    private func deleteRepositoryEventInboxFile(relative: String): Unit {
        if (!relative.startsWith("metadata/repository-event-inbox/") || relative.contains("..")) { return }
        let path = this.root.join(relative)
        if (!exists(path)) { return }
        try { _ = launch("/bin/rm", ["-f", path.toString()]).wait() } catch (_: Exception) { () }
    }

    public func saveSchedulerLoopMetadata(loopStatus: String, schedulerEnabled: Bool, intervalMillis: Int64, tickKind: String, limit: Int64, ran: Int64, taskNames: ArrayList<String>, diagnostic: String, readinessGate!: String = "", firstTickDeferred!: Bool = false): Unit {
        let existing = this.loadSchedulerLoopStatus()
        var failureCount = existing.loopFailureCount
        if (loopStatus == "failed" || loopStatus == "scheduler_disabled" || diagnostic.contains("failed")) {
            failureCount += 1
        }
        var text = "loopStatus=${escapeField(loopStatus)}\n"
        text += "schedulerEnabled=${schedulerEnabled}\n"
        text += "intervalMillis=${intervalMillis}\n"
        text += "readinessGate=${escapeField(readinessGate)}\n"
        text += "firstTickDeferred=${firstTickDeferred}\n"
        text += "tickKind=${escapeField(tickKind)}\n"
        text += "limit=${limit}\n"
        text += "ran=${ran}\n"
        text += "taskNames=${escapeField(joinStrings(taskNames, ","))}\n"
        text += "diagnostic=${escapeField(redactSensitive(diagnostic))}\n"
        text += "heartbeatFresh=${loopStatus == "running"}\n"
        text += "loopFailureCount=${failureCount}\n"
        this.writeLinesAtomically("metadata/scheduler-loop.ckb", text)
    }

    public func loadSchedulerLoopStatus(): CkbSchedulerLoopStatus {
        let status = CkbSchedulerLoopStatus()
        let text = this.readLines("metadata/scheduler-loop.ckb")
        if (text == "") {
            return status
        }
        for (line in text.split("\n")) {
            let trimmed = line.trimAscii()
            if (trimmed == "") {
                continue
            }
            if (trimmed.startsWith("loopStatus=")) {
                status.loopStatus = unescapeField(trimmed[11..trimmed.size])
            } else if (trimmed.startsWith("schedulerEnabled=")) {
                status.schedulerEnabled = parseBool(trimmed[17..trimmed.size])
            } else if (trimmed.startsWith("intervalMillis=")) {
                status.intervalMillis = parseIntField(trimmed[15..trimmed.size], 0)
            } else if (trimmed.startsWith("readinessGate=")) {
                status.readinessGate = unescapeField(trimmed[14..trimmed.size])
            } else if (trimmed.startsWith("firstTickDeferred=")) {
                status.firstTickDeferred = parseBool(trimmed[18..trimmed.size])
            } else if (trimmed.startsWith("tickKind=")) {
                status.tickKind = unescapeField(trimmed[9..trimmed.size])
            } else if (trimmed.startsWith("limit=")) {
                status.limit = parseIntField(trimmed[6..trimmed.size], 0)
            } else if (trimmed.startsWith("ran=")) {
                status.ran = parseIntField(trimmed[4..trimmed.size], 0)
            } else if (trimmed.startsWith("taskNames=")) {
                let value = unescapeField(trimmed[10..trimmed.size])
                if (value != "") {
                    for (name in value.split(",")) {
                        let clean = name.trimAscii()
                        if (clean != "") {
                            status.taskNames.add(clean)
                        }
                    }
                }
            } else if (trimmed.startsWith("diagnostic=")) {
                status.diagnostic = redactSensitive(unescapeField(trimmed[11..trimmed.size]))
            } else if (trimmed.startsWith("heartbeatFresh=")) {
                status.heartbeatFresh = parseBool(trimmed[15..trimmed.size])
            } else if (trimmed.startsWith("loopFailureCount=")) {
                status.loopFailureCount = parseIntField(trimmed[17..trimmed.size], 0)
            }
        }
        status
    }

    public func saveCangjieCorpusFreshness(report: CangjieCorpusFreshnessReport): Unit {
        var text = "ok=${report.ok}\n"
        text += "degraded=${report.degraded}\n"
        text += "activeKnowledgeVersion=${escapeField(report.activeKnowledgeVersion)}\n"
        text += "candidateKnowledgeVersion=${escapeField(report.candidateKnowledgeVersion)}\n"
        text += "failedCandidateVersion=${escapeField(report.failedCandidateVersion)}\n"
        text += "targetVersion=${escapeField(report.targetVersion)}\n"
        for (diagnostic in report.diagnostics) {
            text += "diagnostic|${escapeField(diagnostic)}\n"
        }
        for (source in report.sources) {
            text += "source|${escapeField(source.sourceSet)}|${escapeField(source.sourceFamily)}|${escapeField(source.sourceRepo)}|${escapeField(source.sourceRef)}|${escapeField(source.resolvedCommit)}|${escapeField(source.contentHash)}|${escapeField(source.crawlAt)}|${escapeField(source.indexedAt)}|${escapeField(source.staleness)}|${escapeField(source.status)}\n"
        }
        this.writeLinesAtomically("metadata/cangjie-freshness.ckb", text)
    }

    public func loadCangjieCorpusFreshness(): CangjieCorpusFreshnessReport {
        this.loadCangjieCorpusFreshnessFromRelative("metadata/cangjie-freshness.ckb")
    }

    public func loadActiveCangjieCorpusFreshness(): CangjieCorpusFreshnessReport {
        let pointer = this.loadActiveSnapshotPointer()
        if (pointer.valid && !pointer.legacy &&
            pointer.companionMode != CkbActiveSnapshotCompanionMode.NONE) {
            return this.loadCangjieCorpusFreshnessFromRelative(
                "transactions/${safeName(pointer.txId)}/metadata/cangjie-freshness.ckb")
        }
        if (pointer.legacy) { return this.loadCangjieCorpusFreshness() }
        let report = CangjieCorpusFreshnessReport()
        report.ok = false
        report.degraded = true
        report.diagnostics.add(if (pointer.valid) { "active_companion_mode_none" } else { pointer.diagnostic })
        report
    }

    private func loadCangjieCorpusFreshnessFromRelative(relative: String): CangjieCorpusFreshnessReport {
        let report = CangjieCorpusFreshnessReport()
        var text = ""
        try {
            text = this.readLines(relative)
        } catch (_: Exception) {
            report.ok = false
            report.degraded = true
            report.diagnostics.add("freshness_artifact_invalid_encoding")
            return report
        }
        ckbParseCangjieFreshnessArtifact(text)
    }

    public func saveCangjieVersionManifest(manifest: CangjieVersionManifest): Unit {
        var text = "manifestVersion=${escapeField(manifest.manifestVersion)}\n"
        text += "defaultTargetVersion=${escapeField(manifest.defaultTargetVersion)}\n"
        text += "degraded=${manifest.degraded}\n"
        for (diagnostic in manifest.diagnostics) {
            text += "diagnostic|${escapeField(diagnostic)}\n"
        }
        for (source in manifest.sources) {
            text += "source|${escapeField(source.targetVersion)}|${escapeField(source.sourceSet)}|${escapeField(source.sourceFamily)}|${escapeField(source.sourceRepo)}|${escapeField(source.sourceRef)}|${escapeField(source.refKind)}|${escapeField(source.resolvedCommit)}|${escapeField(source.contentHash)}|${escapeField(source.rootKind)}\n"
        }
        this.writeLinesAtomically("metadata/cangjie-version-manifest.ckb", text)
    }

    public func loadCangjieVersionManifest(): CangjieVersionManifest {
        this.loadCangjieVersionManifestFromRelative("metadata/cangjie-version-manifest.ckb")
    }

    public func loadActiveCangjieVersionManifest(): CangjieVersionManifest {
        let pointer = this.loadActiveSnapshotPointer()
        if (pointer.valid && !pointer.legacy &&
            pointer.companionMode != CkbActiveSnapshotCompanionMode.NONE) {
            return this.loadCangjieVersionManifestFromRelative(
                "transactions/${safeName(pointer.txId)}/metadata/cangjie-version-manifest.ckb")
        }
        if (pointer.legacy) { return this.loadCangjieVersionManifest() }
        let manifest = CangjieVersionManifest()
        manifest.sources.clear()
        manifest.degraded = true
        manifest.diagnostics.add(if (pointer.valid) { "active_companion_mode_none" } else { pointer.diagnostic })
        manifest
    }

    private func loadCangjieVersionManifestFromRelative(relative: String): CangjieVersionManifest {
        let manifest = CangjieVersionManifest()
        manifest.sources.clear()
        var text = ""
        try {
            text = this.readLines(relative)
        } catch (_: Exception) {
            manifest.degraded = true
            manifest.diagnostics.add("version_manifest_invalid_encoding")
            return manifest
        }
        ckbParseCangjieVersionManifestArtifact(text)
    }

    public func saveCache(key: String, value: String): Unit {
        this.writeLines("cache/${safeName(key)}.txt", value)
    }

    public func loadRaw(): ArrayList<RawRecord> {
        let snapshot = this.loadActiveSnapshot()
        if (snapshot.valid) { snapshot.rawRecords } else { ArrayList<RawRecord>() }
    }

    public func loadNormalized(): ArrayList<NormalizedRecord> {
        let snapshot = this.loadActiveSnapshot()
        if (snapshot.valid) { snapshot.normalizedRecords } else { ArrayList<NormalizedRecord>() }
    }

    public func loadActiveVersion(): String {
        let snapshot = this.loadActiveSnapshot()
        if (snapshot.valid) { snapshot.activeVersion } else { "" }
    }

    public func loadActiveIndex(): ArrayList<NormalizedRecord> {
        let snapshot = this.loadActiveSnapshot()
        if (snapshot.valid) { snapshot.activeIndex } else { ArrayList<NormalizedRecord>() }
    }

    public func loadMetadataStatus(): StoreMetadataStatus {
        if (!this.has("metadata/active-snapshot.manifest")) {
            return this.loadMetadataStatusFromPrefix("")
        }
        let pointer = this.loadActiveSnapshotPointer()
        if (pointer.valid) {
            let prefix = "transactions/${safeName(pointer.txId)}"
            let status = this.loadMetadataStatusFromPrefix(prefix)
            status.snapshotManifestTxId = pointer.txId
            status.valid = status.activeVersion == pointer.activeVersion
            status.diagnostic = if (status.valid) { if (pointer.legacy) { "legacy_active_pointer" } else { "ok" } } else { "active_metadata_pointer_mismatch" }
            return status
        }
        if (pointer.legacy) {
            let status = this.loadMetadataStatusFromPrefix("")
            status.snapshotManifestTxId = pointer.txId
            status.diagnostic = pointer.diagnostic
            return status
        }
        let invalid = StoreMetadataStatus()
        invalid.valid = false
        invalid.diagnostic = pointer.diagnostic
        invalid.vectorActiveCollection = ""
        invalid.vectorCandidateCollection = ""
        invalid
    }

    public func loadActiveSnapshot(): ActiveSnapshot {
        if (!this.has("metadata/active-snapshot.manifest")) {
            return this.loadActiveSnapshotFromPrefix("", "")
        }
        let pointer = this.loadActiveSnapshotPointer()
        if (pointer.valid) {
            let txRoot = "transactions/${safeName(pointer.txId)}"
            if (pointer.legacy) {
                if (this.has("${txRoot}/COMMIT")) {
                    return this.loadActiveSnapshotFromPrefix(txRoot, "")
                }
                return this.loadActiveSnapshotFromPrefix("", "ignored_uncommitted_snapshot_tx:${pointer.txId}")
            }
            let snapshot = this.loadActiveSnapshotFromPrefix(txRoot, "", allowLiveOverlay: false,
                allowCommittedEmpty: true)
            if (snapshot.valid && snapshot.activeVersion == pointer.activeVersion &&
                snapshot.vectorActiveCollection == pointer.vectorActiveCollection) {
                this.applyActiveSnapshotCandidateLifecycleOverlay(snapshot, pointer)
                return snapshot
            }
            snapshot.valid = false
            snapshot.diagnostic = "active_snapshot_v2_payload_identity_mismatch"
            return snapshot
        }
        if (pointer.legacy) {
            return this.loadActiveSnapshotFromPrefix("", "ignored_uncommitted_snapshot_tx:${pointer.txId}")
        }
        let invalid = ActiveSnapshot()
        invalid.valid = false
        invalid.diagnostic = pointer.diagnostic
        invalid
    }

    private func applyActiveSnapshotCandidateLifecycleOverlay(snapshot: ActiveSnapshot,
        pointer: CkbActiveSnapshotPointer): Unit {
        try {
            let live = this.loadMetadataStatusFromPrefix("")
            if (live.activeVersion == pointer.activeVersion) {
                snapshot.candidateVersion = live.candidateVersion
                snapshot.failedVersion = live.failedVersion
            }
        } catch (_: Exception) {
            // Transaction payload remains authoritative when the live
            // lifecycle overlay is unavailable or undecodable.
            ()
        }
    }

    public func backupActiveSnapshot(backupRoot: String): BackupRestoreResult {
        let result = BackupRestoreResult()
        result.action = "backup"
        result.source = "store"
        result.destination = redactSensitive(backupRoot)
        if (backupRoot.trimAscii() == "") {
            result.ok = false
            result.diagnostic = "missing_backup_path"
            return result
        }
        let snapshot = this.loadActiveSnapshot()
        result.activeVersion = snapshot.activeVersion
        if (!snapshot.valid) {
            result.ok = false
            result.diagnostic = snapshot.diagnostic
            return result
        }
        let companions = this.loadActiveSnapshotCompanionCopy()
        if (!companions.valid) {
            result.ok = false
            result.diagnostic = companions.diagnostic
            return result
        }
        let materialized = KnowledgeBase(FakeClock(0))
        if (!materialized.restoreActiveSnapshot(snapshot)) {
            result.ok = false
            result.diagnostic = materialized.status().restoreDiagnostic
            return result
        }
        let graph = materialized.activeGraphBuild()
        if (!graph.ok) {
            result.ok = false
            result.diagnostic = graph.diagnostic
            return result
        }
        let sourceMetadata = this.loadMetadataStatus()
        if (!sourceMetadata.valid) {
            result.ok = false
            result.diagnostic = sourceMetadata.diagnostic
            return result
        }
        let transactionStatus = this.activeSnapshotTransactionStatus(materialized.status(),
            sourceMetadata, snapshot, graph)
        let backup = FileKnowledgeStore(backupRoot)
        backup.ensureLayout()
        let committed = backup.writeActiveSnapshotTransaction(transactionStatus, snapshot.rawRecords,
            snapshot.normalizedRecords, snapshot.activeIndex, snapshot.vectorRecords,
            snapshot.vectorActiveCollection, graph, persistVectorFile: snapshot.hasVectorArtifact,
            companionCopy: companions)
        if (!committed.ok) {
            result.ok = false
            result.diagnostic = if (committed.diagnostics.size > 0) {
                committed.diagnostics[committed.diagnostics.size - 1]
            } else { "backup_transaction_not_committed" }
            return result
        }
        let lifecycleDiagnostic = backup.replayActiveSnapshotCandidateLifecycle(snapshot)
        if (lifecycleDiagnostic != "") {
            result.ok = false
            result.diagnostic = lifecycleDiagnostic
            return result
        }
        var markerDiagnostic = ""
        try {
            backup.writeLinesAtomically("metadata/backup.ckb",
                "schema=ckb-active-backup-v2\nactive=${snapshot.activeVersion}\ntxId=${committed.txId}\nsource=validated-active-transaction\n")
        } catch (e: Exception) {
            markerDiagnostic = "backup_marker_degraded:${utf8SafePrefix(redactSensitive(if (e.message == "") { "write_failed" } else { e.message }), 160)}"
        }
        result.files = 9 + (if (markerDiagnostic == "") { 1 } else { 0 }) +
            (if (snapshot.hasVectorArtifact) { 1 } else { 0 }) +
            (if (committed.companionMode == CkbActiveSnapshotCompanionMode.NONE) { 0 } else { 3 })
        result.ok = committed.businessCommitted
        result.diagnostic = if (result.ok) {
            if (markerDiagnostic == "") { "ok" } else { markerDiagnostic }
        } else { "backup_transaction_not_committed" }
        result
    }

    public func restoreActiveSnapshotBackup(backupRoot: String): BackupRestoreResult {
        let result = BackupRestoreResult()
        result.action = "restore"
        result.source = redactSensitive(backupRoot)
        result.destination = "store"
        if (backupRoot.trimAscii() == "") {
            result.ok = false
            result.diagnostic = "missing_backup_path"
            return result
        }
        let backup = FileKnowledgeStore(backupRoot)
        let snapshot = backup.loadActiveSnapshot()
        result.activeVersion = snapshot.activeVersion
        if (!snapshot.valid) {
            result.ok = false
            result.diagnostic = snapshot.diagnostic
            return result
        }
        let companions = backup.loadActiveSnapshotCompanionCopy()
        if (!companions.valid) {
            result.ok = false
            result.diagnostic = companions.diagnostic
            return result
        }
        let materialized = KnowledgeBase(FakeClock(0))
        if (!materialized.restoreActiveSnapshot(snapshot)) {
            result.ok = false
            result.diagnostic = materialized.status().restoreDiagnostic
            return result
        }
        let graph = materialized.activeGraphBuild()
        if (!graph.ok) {
            result.ok = false
            result.diagnostic = graph.diagnostic
            return result
        }
        let sourceMetadata = backup.loadMetadataStatus()
        if (!sourceMetadata.valid) {
            result.ok = false
            result.diagnostic = sourceMetadata.diagnostic
            return result
        }
        let transactionStatus = this.activeSnapshotTransactionStatus(materialized.status(),
            sourceMetadata, snapshot, graph)
        this.ensureLayout()
        let committed = this.writeActiveSnapshotTransaction(transactionStatus, snapshot.rawRecords,
            snapshot.normalizedRecords, snapshot.activeIndex, snapshot.vectorRecords,
            snapshot.vectorActiveCollection, graph, persistVectorFile: snapshot.hasVectorArtifact,
            companionCopy: companions)
        let lifecycleDiagnostic = if (committed.ok && committed.businessCommitted) {
            this.replayActiveSnapshotCandidateLifecycle(snapshot)
        } else { "" }
        let reloaded = this.loadActiveSnapshot()
        let pointer = this.loadActiveSnapshotPointer()
        result.ok = committed.ok && committed.businessCommitted && pointer.valid &&
            pointer.txId == committed.txId && reloaded.valid &&
            reloaded.activeVersion == snapshot.activeVersion && lifecycleDiagnostic == "" &&
            reloaded.candidateVersion == snapshot.candidateVersion &&
            reloaded.failedVersion == snapshot.failedVersion
        result.files = if (result.ok) {
            9 + (if (snapshot.hasVectorArtifact) { 1 } else { 0 }) +
                (if (committed.companionMode == CkbActiveSnapshotCompanionMode.NONE) { 0 } else { 3 })
        } else { 0 }
        result.diagnostic = if (result.ok) { "ok" } else if (lifecycleDiagnostic != "") {
            lifecycleDiagnostic
        } else if (committed.diagnostics.size > 0) {
            committed.diagnostics[committed.diagnostics.size - 1]
        } else if (!pointer.valid) { pointer.diagnostic } else { reloaded.diagnostic }
        result
    }

    private func replayActiveSnapshotCandidateLifecycle(snapshot: ActiveSnapshot): String {
        let lifecycle = KnowledgeStatus()
        lifecycle.activeKnowledgeVersion = snapshot.activeVersion
        lifecycle.candidateKnowledgeVersion = snapshot.candidateVersion
        lifecycle.failedCandidateVersion = snapshot.failedVersion
        try {
            // Backup/restore carries only the live lifecycle overlay. Candidate
            // immutable payloads are not part of the active backup contract.
            this.saveLiveCandidateLifecycleMetadata(lifecycle)
        } catch (e: Exception) {
            return "active_candidate_lifecycle_replay_failed:${utf8SafePrefix(redactSensitive(if (e.message == "") { "write_failed" } else { e.message }), 160)}"
        }
        let reloaded = this.loadActiveSnapshot()
        if (!reloaded.valid || reloaded.activeVersion != snapshot.activeVersion ||
            reloaded.candidateVersion != snapshot.candidateVersion ||
            reloaded.failedVersion != snapshot.failedVersion) {
            return "active_candidate_lifecycle_replay_mismatch"
        }
        ""
    }

    private func activeSnapshotTransactionStatus(materialized: KnowledgeStatus,
        source: StoreMetadataStatus, snapshot: ActiveSnapshot,
        graph: GraphBuildResult): KnowledgeStatus {
        materialized.activeKnowledgeVersion = snapshot.activeVersion
        materialized.candidateKnowledgeVersion = source.candidateVersion
        materialized.failedCandidateVersion = source.failedVersion
        materialized.activeStateSource = source.activeStateSource
        materialized.storage.rawCount = snapshot.rawRecords.size
        materialized.storage.normalizedCount = snapshot.normalizedRecords.size
        materialized.storage.indexCount = snapshot.activeIndex.size
        materialized.storage.textIndexCount = source.textIndexCount
        materialized.storage.vectorIndexCount = source.vectorIndexCount
        materialized.storage.symbolIndexCount = source.symbolIndexCount
        materialized.storage.graphIndexCount = source.graphIndexCount
        materialized.storage.vectorBackend = source.vectorBackend
        materialized.storage.vectorState = source.vectorState
        materialized.storage.vectorCollection = source.vectorCollection
        materialized.storage.vectorActiveCollection = source.vectorActiveCollection
        materialized.storage.vectorCandidateCollection = source.vectorCandidateCollection
        materialized.storage.vectorDimension = source.vectorDimension
        materialized.storage.vectorDegradedReason = source.vectorDegradedReason
        materialized.storage.graphBackend = source.graphBackend
        materialized.storage.graphState = source.graphState
        materialized.storage.graphNodeCount = if (source.graphNodeCount > 0) {
            source.graphNodeCount
        } else { graph.nodes.size }
        materialized.storage.graphEdgeCount = if (source.graphEdgeCount > 0) {
            source.graphEdgeCount
        } else { graph.edges.size }
        materialized
    }

    public func saveScheduler(entries: ArrayList<ScheduleEntry>): Unit {
        var text = ""
        for (entry in entries) {
            text += "${escapeField(entry.name)}|${entry.intervalMinutes}|${entry.nextRunAt}|${entry.lastStartedAt}|${entry.lastSuccessAt}|${entry.lastFailureAt}|${entry.failureCount}|${entry.degraded}|${escapeField(entry.lastCursor)}|${escapeField(entry.lastSince)}|${escapeField(entry.activeVersion)}|${escapeField(entry.candidateVersion)}|${escapeField(entry.lastStatus)}|${entry.lastDurationMillis}|${entry.lastRequestCount}|${escapeField(joinStrings(entry.lastUpdatedDataKinds, ","))}|${entry.lastTruncated}|${entry.timeBudgetMillis}|${escapeField(entry.lastRunId)}|${entry.lastRunStartedAtMillis}|${entry.lastRunFinishedAtMillis}|${escapeField(entry.lastBinaryEvidenceHash)}|${escapeField(entry.lastTerminalState)}\n"
        }
        this.writeLinesAtomically("metadata/scheduler.ckb", text)
    }

    public func loadScheduler(): ArrayList<ScheduleEntry> {
        let out = ArrayList<ScheduleEntry>()
        let text = this.readLines("metadata/scheduler.ckb")
        if (text == "") {
            return out
        }
        for (line in text.split("\n")) {
            if (line == "") {
                continue
            }
            let parts = line.split("|")
            if (parts.size < 13) {
                continue
            }
            let entry = ScheduleEntry(unescapeField(parts[0]), parseIntField(parts[1], 0), parseIntField(parts[2], 0))
            entry.lastStartedAt = parseIntField(parts[3], -1)
            entry.lastSuccessAt = parseIntField(parts[4], -1)
            entry.lastFailureAt = parseIntField(parts[5], -1)
            entry.failureCount = parseIntField(parts[6], 0)
            entry.degraded = parts[7] == "true"
            entry.lastCursor = unescapeField(parts[8])
            entry.lastSince = unescapeField(parts[9])
            entry.activeVersion = unescapeField(parts[10])
            entry.candidateVersion = unescapeField(parts[11])
            entry.lastStatus = unescapeField(parts[12])
            if (parts.size >= 18) {
                entry.lastDurationMillis = parseIntField(parts[13], 0)
                entry.lastRequestCount = parseIntField(parts[14], 0)
                let kinds = unescapeField(parts[15])
                if (kinds != "") {
                    for (kind in kinds.split(",")) {
                        let cleaned = kind.trimAscii()
                        if (cleaned != "") {
                            entry.lastUpdatedDataKinds.add(cleaned)
                        }
                    }
                }
                entry.lastTruncated = parts[16] == "true"
                entry.timeBudgetMillis = parseIntField(parts[17], 0)
            }
            if (parts.size >= 23) {
                entry.lastRunId = unescapeField(parts[18])
                entry.lastRunStartedAtMillis = parseIntField(parts[19], 0)
                entry.lastRunFinishedAtMillis = parseIntField(parts[20], 0)
                entry.lastBinaryEvidenceHash = unescapeField(parts[21])
                entry.lastTerminalState = unescapeField(parts[22])
            }
            out.add(entry)
        }
        out
    }

    public func publicStatus(): StorageStatus {
        let status = StorageStatus()
        status.rawPath = "data/raw"
        status.normalizedPath = "data/normalized"
        status.metadataPath = "data/metadata"
        status.indexesPath = "data/indexes"
        status.derivedPath = "data/derived"
        status.cachePath = "data/cache"
        status
    }

    public func has(relative: String): Bool {
        exists(this.root.join(relative))
    }

    public func hasAuthoritativeActiveSnapshotPointer(): Bool {
        if (!this.has("metadata/active-snapshot.manifest")) { return false }
        try {
            _ = this.readLines("metadata/active-snapshot.manifest")
            let pointer = this.loadActiveSnapshotPointer()
            return !(pointer.valid && pointer.legacy)
        } catch (_: Exception) {
            // An undecodable pointer cannot safely be classified as a legacy pointer.
            return true
        }
    }

    public func readText(relative: String): String {
        this.readLines(relative)
    }

    func routineReleaseCoverageSummary(relative: String): CkbRoutineReleaseCoverageSummary {
        let summary = CkbRoutineReleaseCoverageSummary()
        let path = this.root.join(relative)
        if (!exists(path)) { return summary }
        var schema = ""
        var targetVersion = ""
        var planHash = ""
        var complete = false
        var plannedSourceCount: Int64 = -1
        var completedSourceCount: Int64 = -1
        var plannedFileCount: Int64 = -1
        var completedFileCount: Int64 = -1
        var declaredCoverageHash = ""
        var declaredRawHash = ""
        var declaredNormalizedHash = ""
        var declaredInventoryHash = ""
        var removedEvidenceCount: Int64 = 0
        let sourceSets = HashSet<String>()
        let sourceIdentities = HashSet<String>()
        let sourceHashes = ArrayList<String>()
        let rawDigest = SHA256()
        let normalizedDigest = SHA256()
        try {
            try (file = File(path, OpenMode.Read)) {
                let reader = StringReader(file)
                while (true) {
                    let line = if (let Some(value) <- reader.readln()) { value } else { break }
                    if (line.toArray().size > 262144) { return summary }
                    let trimmed = line.trimAscii()
                    if (trimmed == "") { continue }
                    if (trimmed.startsWith("schema=")) {
                        schema = unescapeField(trimmed[7..trimmed.size])
                    } else if (trimmed.startsWith("targetVersion=")) {
                        targetVersion = unescapeField(trimmed[14..trimmed.size])
                    } else if (trimmed.startsWith("planHash=")) {
                        planHash = unescapeField(trimmed[9..trimmed.size])
                    } else if (trimmed.startsWith("complete=")) {
                        complete = trimmed[9..trimmed.size] == "true"
                    } else if (trimmed.startsWith("plannedSourceCount=")) {
                        plannedSourceCount = parseIntField(trimmed[19..trimmed.size], -1)
                    } else if (trimmed.startsWith("completedSourceCount=")) {
                        completedSourceCount = parseIntField(trimmed[21..trimmed.size], -1)
                    } else if (trimmed.startsWith("plannedFileCount=")) {
                        plannedFileCount = parseIntField(trimmed[17..trimmed.size], -1)
                    } else if (trimmed.startsWith("completedFileCount=")) {
                        completedFileCount = parseIntField(trimmed[19..trimmed.size], -1)
                    } else if (trimmed.startsWith("aggregateEvidenceHash=")) {
                        declaredCoverageHash = trimmed[22..trimmed.size]
                    } else if (trimmed.startsWith("source|")) {
                        let parts = trimmed.split("|")
                        if (parts.size != 15 || parts[8] != "true" || parts[9] != "true") { return summary }
                        let identity = unescapeField(parts[1])
                        let sourceSet = unescapeField(parts[2])
                        let inventoryHash = parts[14]
                        if (identity == "" || sourceIdentities.contains(identity) ||
                            sourceSets.contains(sourceSet) ||
                            !ckbRoutineRawSha256(inventoryHash)) { return summary }
                        sourceIdentities.add(identity)
                        sourceSets.add(sourceSet)
                        sourceHashes.add("${identity}|${inventoryHash}")
                    } else if (trimmed.startsWith("removedRaw|")) {
                        let value = unescapeField(trimmed[11..trimmed.size])
                        rawDigest.write(value.toArray())
                        rawDigest.write("\n".toArray())
                    } else if (trimmed.startsWith("removedNormalized|")) {
                        let value = unescapeField(trimmed[18..trimmed.size])
                        normalizedDigest.write(value.toArray())
                        normalizedDigest.write("\n".toArray())
                    } else if (trimmed.startsWith("removedEvidence|")) {
                        let parts = trimmed.split("|")
                        if (parts.size != 4) { return summary }
                        removedEvidenceCount += 1
                        declaredRawHash = parts[1]
                        declaredNormalizedHash = parts[2]
                        declaredInventoryHash = parts[3]
                    }
                }
            }
        } catch (_: Exception) {
            return summary
        }
        let rawHash = ckbReleaseDigestHex(rawDigest).toAsciiUpper()
        let normalizedHash = ckbReleaseDigestHex(normalizedDigest).toAsciiUpper()
        let inventoryHash = ckbReleaseEvidenceHash("raw=${rawHash}|normalized=${normalizedHash}")
        let orderedHashes = sourceHashes.toArray()
        sort(orderedHashes)
        let aggregate = StringBuilder()
        aggregate.append("schema=${schema}|target=${targetVersion}|plan=${planHash}|")
        aggregate.append("plannedSources=${plannedSourceCount}|completedSources=${completedSourceCount}|")
        aggregate.append("plannedFiles=${plannedFileCount}|completedFiles=${completedFileCount}|complete=${complete}")
        for (entry in orderedHashes) {
            aggregate.append("|source=${ckbReleaseBundleCanonicalField(entry)}")
        }
        let coverageHash = ckbReleaseEvidenceHash(aggregate.toString())
        summary.sourceCoverageEvidenceHash = coverageHash
        summary.inventoryEvidenceHash = inventoryHash
        summary.valid = schema == "ckb-release-coverage-v1" && targetVersion != "" &&
            planHash != "" && complete && plannedSourceCount == 5 &&
            completedSourceCount == 5 && plannedFileCount >= 0 &&
            plannedFileCount == completedFileCount && sourceHashes.size == 5 &&
            sourceIdentities.size == 5 &&
            sourceSets.contains(CangjieSourceSets.DOCS) &&
            sourceSets.contains(CangjieSourceSets.STD) &&
            sourceSets.contains(CangjieSourceSets.STDX) &&
            sourceSets.contains(CangjieSourceSets.TOOLS) &&
            sourceSets.contains(CangjieSourceSets.EVAL_SUPPORT) &&
            removedEvidenceCount == 1 && declaredRawHash == rawHash &&
            declaredNormalizedHash == normalizedHash &&
            declaredInventoryHash == inventoryHash &&
            declaredCoverageHash == coverageHash
        summary
    }

    private func ensure(relative: String): Unit {
        let path = this.root.join(relative)
        if (!exists(path)) {
            Directory.create(path, recursive: true)
        }
    }

    public func writeLinesAtomically(relative: String, text: String): Unit {
        this.ensureLayout()
        let path = this.root.join(relative)
        if (!exists(path.parent)) {
            Directory.create(path.parent, recursive: true)
        }
        let tmp = this.atomicTmpPath(path, relative)
        try {
            File.writeTo(tmp, text.toArray())
            this.replaceFileWithTmp(path, tmp)
            let readback = this.readLines(relative)
            if (ckbReleaseEvidenceHash(readback) != ckbReleaseEvidenceHash(text)) {
                throw Exception("atomic_write_readback_hash_mismatch:${ckbReleaseEvidenceHash(relative)}")
            }
        } catch (e: Exception) {
            this.deleteAtomicTmp(tmp)
            throw e
        }
    }

    private func atomicTmpPath(path: Path, relative: String): Path {
        this.atomicTmpSequence += 1
        let identity = "${relative}|${DateTime.now().toUnixTimeStamp().toMilliseconds()}|${this.atomicTmpSequence}"
        path.parent.join(".tmp-${ckbReleaseEvidenceHash(identity)}")
    }

    private func writeRecordsFileAtomically(relative: String, lines: ArrayList<String>): Unit {
        this.ensureLayout()
        let path = this.root.join(relative)
        if (!exists(path.parent)) {
            Directory.create(path.parent, recursive: true)
        }
        let tmp = this.atomicTmpPath(path, relative)
        try {
            try (file = File(tmp, OpenMode.Write)) {
                for (line in lines) { file.write(line.toArray()) }
            }
            this.replaceFileWithTmp(path, tmp)
        } catch (e: Exception) {
            this.deleteAtomicTmp(tmp)
            throw e
        }
    }

    private func replaceFileWithTmp(path: Path, tmp: Path): Unit {
        try {
            let code = launch("/bin/mv", ["-f", tmp.toString(), path.toString()]).wait()
            if (code != 0) {
                throw Exception("atomic_write_replace_failed")
            }
        } finally {
            this.deleteAtomicTmp(tmp)
        }
    }

    private func deleteAtomicTmp(tmp: Path): Unit {
        if (!exists(tmp)) { return }
        try { _ = launch("/bin/rm", ["-f", tmp.toString()]).wait() } catch (_: Exception) { () }
    }

    public func appendLinesAtomically(relative: String, text: String): Unit {
        this.writeLinesAtomically(relative, this.readLines(relative) + text)
    }

    private func writeLines(relative: String, text: String): Unit {
        this.ensureLayout()
        let path = this.root.join(relative)
        if (!exists(path.parent)) {
            Directory.create(path.parent, recursive: true)
        }
        File.writeTo(path, text.toArray())
    }

    private func readLines(relative: String): String {
        let path = this.root.join(relative)
        if (!exists(path)) {
            return ""
        }
        String.fromUtf8(File.readFrom(path))
    }

    private func readLinesFromPrefix(prefix: String, relative: String): String {
        if (prefix == "") {
            return this.readLines(relative)
        }
        this.readLines("${prefix}/${relative}")
    }

    private func activeLiveShadowMatchesTx(txRoot: String,
        companionMode!: String = CkbActiveSnapshotCompanionMode.NONE): Bool {
        try {
            let metadata = this.loadMetadataStatusFromPrefix(txRoot)
            let vectorRelative = "index/vector-${safeName(metadata.vectorActiveCollection)}.ckb"
            let vectorMatches = !this.has("${txRoot}/${vectorRelative}") ||
                this.readLines(vectorRelative) == this.readLines("${txRoot}/${vectorRelative}")
            let companionsMatch = if (companionMode == CkbActiveSnapshotCompanionMode.NONE) {
                !this.has("metadata/active-cangjie-version-manifest.ckb") &&
                    !this.has("metadata/active-cangjie-freshness.ckb") &&
                    !this.has("metadata/active-cangjie-release-coverage.ckb")
            } else {
                this.readLines("metadata/active-cangjie-version-manifest.ckb") == this.readLines("${txRoot}/metadata/cangjie-version-manifest.ckb") &&
                this.readLines("metadata/active-cangjie-freshness.ckb") == this.readLines("${txRoot}/metadata/cangjie-freshness.ckb") &&
                this.readLines("metadata/active-cangjie-release-coverage.ckb") == this.readLines("${txRoot}/metadata/cangjie-release-coverage.ckb")
            }
            return this.activeSnapshotAuthoritativeRawEvidenceHash("raw") ==
                    this.activeSnapshotAuthoritativeRawEvidenceHash("${txRoot}/raw") &&
                this.readLines("normalized/records.ckb") == this.readLines("${txRoot}/normalized/records.ckb") &&
                this.readLines("index/active.version") == this.readLines("${txRoot}/index/active.version") &&
                this.readLines("index/active.ckb") == this.readLines("${txRoot}/index/active.ckb") &&
                this.readLines("index/graph-nodes.ckb") == this.readLines("${txRoot}/index/graph-nodes.ckb") &&
                this.readLines("index/graph-edges.ckb") == this.readLines("${txRoot}/index/graph-edges.ckb") &&
                this.activeSnapshotAuthoritativeStatusText("metadata/status.ckb") ==
                    this.activeSnapshotAuthoritativeStatusText("${txRoot}/metadata/status.ckb") &&
                companionsMatch && vectorMatches
        } catch (_: Exception) {
            false
        }
    }

    private func activeSnapshotAuthoritativeRawEvidenceHash(relative: String): String {
        this.activeSnapshotAuthoritativeRawPathEvidenceHash(this.root.join(relative))
    }

    private func activeSnapshotAuthoritativeRawPathEvidenceHash(root: Path): String {
        if (!exists(root)) { return "missing" }
        let entries = ArrayList<String>()
        this.activeSnapshotCollectAuthoritativeRawEvidence(root, "", entries)
        let ordered = entries.toArray()
        sort(ordered)
        let canonical = ArrayList<String>()
        canonical.add(all: ordered)
        ckbReleaseCompanionEvidenceHash(joinStrings(canonical, "|"))
    }

    private func activeSnapshotCollectAuthoritativeRawEvidence(root: Path,
        prefix: String, out: ArrayList<String>): Unit {
        for (entry in Directory.readFrom(root)) {
            if (prefix == "" && entry.isDirectory() && entry.name == "candidate") {
                continue
            }
            let relative = if (prefix == "") { entry.name } else { "${prefix}/${entry.name}" }
            if (entry.isDirectory()) {
                this.activeSnapshotCollectAuthoritativeRawEvidence(entry.path, relative, out)
            } else if (entry.isRegular()) {
                out.add("${relative}=${this.activeSnapshotFilePathEvidenceHash(entry.path)}")
            }
        }
    }

    private func activeSnapshotAuthoritativeStatusText(relative: String): String {
        let out = StringBuilder()
        for (line in this.readLines(relative).split("\n")) {
            if (line == "" || line.startsWith("candidate=") ||
                line.startsWith("failed=")) { continue }
            out.append(line)
            out.append("\n")
        }
        out.toString()
    }

    private func deleteActiveSnapshotCompanionLiveShadows(): Unit {
        for (relative in ["metadata/active-cangjie-version-manifest.ckb",
            "metadata/active-cangjie-freshness.ckb",
            "metadata/active-cangjie-release-coverage.ckb"]) {
            let path = this.root.join(relative)
            if (!exists(path)) { continue }
            let code = try { launch("/bin/rm", ["-f", path.toString()]).wait() } catch (_: Exception) { -1 }
            if (code != 0 || exists(path)) {
                throw Exception("active_snapshot_live_companion_remove_failed:${relative}")
            }
        }
    }

    private func copySnapshotFileFromTx(txRoot: String, relative: String, result: ActiveSnapshotRepairResult): Unit {
        if (this.has("${txRoot}/${relative}")) {
            this.writeLinesAtomically(relative, this.readLines("${txRoot}/${relative}"))
            result.copiedFiles.add(relative)
        } else {
            result.missingFiles.add(relative)
        }
    }

    private func copySnapshotFileAtomicallyFromTx(txRoot: String, relative: String, deadlineAtMillis: Int64, progressStage: String): Unit {
        this.ensureActiveSnapshotDeadline("${progressStage}_copy_before", deadlineAtMillis)
        let sourceRelative = "${txRoot}/${relative}"
        if (!this.has(sourceRelative)) {
            throw Exception("active_snapshot_tx_missing:${relative}")
        }
        let source = this.root.join(sourceRelative)
        let path = this.root.join(relative)
        if (!exists(path.parent)) {
            Directory.create(path.parent, recursive: true)
        }
        let tmp = this.atomicTmpPath(path, relative)
        let code = launch("/bin/cp", ["-f", source.toString(), tmp.toString()]).wait()
        if (code != 0) {
            throw Exception("active_snapshot_live_copy_failed:${relative}")
        }
        this.replaceFileWithTmp(path, tmp)
        this.ensureActiveSnapshotDeadline("${progressStage}_copy_after", deadlineAtMillis)
    }

    private func copySnapshotDirectoryContentsFromTx(txRoot: String, relative: String, deadlineAtMillis: Int64, progressStage: String): Unit {
        this.ensureActiveSnapshotDeadline("${progressStage}_copy_before", deadlineAtMillis)
        let sourceRelative = "${txRoot}/${relative}"
        if (!this.has(sourceRelative)) {
            throw Exception("active_snapshot_tx_missing:${relative}")
        }
        let source = this.root.join(sourceRelative)
        let destination = this.root.join(relative)
        let tmp = this.atomicTmpPath(destination, "${relative}-tree")
        let backup = this.atomicTmpPath(destination, "${relative}-backup")
        let candidateSource = destination.join("candidate")
        let preserveCandidate = relative == "raw" && exists(candidateSource)
        var oldMoved = false
        var newMoved = false
        var candidateMoved = false
        var rollbackFailed = false
        try {
            Directory.create(tmp, recursive: true)
            let copied = launch("/bin/cp", ["-Rf", "${source.toString()}/.", tmp.toString()]).wait()
            if (copied != 0) {
                throw Exception("active_snapshot_live_tree_prepare_failed:${relative}")
            }
            if (this.activeSnapshotAuthoritativeRawPathEvidenceHash(source) !=
                this.activeSnapshotAuthoritativeRawPathEvidenceHash(tmp)) {
                throw Exception("active_snapshot_live_tree_prepare_failed:${relative}")
            }
            this.ensureActiveSnapshotDeadline("${progressStage}_swap_before", deadlineAtMillis)
            if (exists(destination)) {
                if (launch("/bin/mv", ["-f", destination.toString(), backup.toString()]).wait() != 0) {
                    throw Exception("active_snapshot_live_tree_backup_failed:${relative}")
                }
                oldMoved = true
            }
            if (launch("/bin/mv", ["-f", tmp.toString(), destination.toString()]).wait() != 0) {
                throw Exception("active_snapshot_live_tree_replace_failed:${relative}")
            }
            newMoved = true
            if (preserveCandidate) {
                let backupCandidate = backup.join("candidate")
                let destinationCandidate = destination.join("candidate")
                if (!exists(backupCandidate) || exists(destinationCandidate) ||
                    launch("/bin/mv", ["-f", backupCandidate.toString(),
                        destinationCandidate.toString()]).wait() != 0) {
                    throw Exception("active_snapshot_live_candidate_preserve_failed")
                }
                candidateMoved = true
            }
            if (this.activeSnapshotAuthoritativeRawPathEvidenceHash(source) !=
                this.activeSnapshotAuthoritativeRawPathEvidenceHash(destination) ||
                (preserveCandidate && !exists(destination.join("candidate")))) {
                throw Exception("active_snapshot_live_tree_readback_mismatch:${relative}")
            }
        } catch (e: Exception) {
            if (candidateMoved) {
                let destinationCandidate = destination.join("candidate")
                let backupCandidate = backup.join("candidate")
                if (!exists(destinationCandidate) || exists(backupCandidate)) {
                    rollbackFailed = true
                } else {
                    let movedBack = try { launch("/bin/mv", ["-f",
                        destinationCandidate.toString(), backupCandidate.toString()]).wait()
                    } catch (_: Exception) { -1 }
                    if (movedBack != 0) {
                        rollbackFailed = true
                    } else {
                        candidateMoved = false
                    }
                }
            }
            if (!rollbackFailed && newMoved && exists(destination)) {
                let removed = try { launch("/bin/rm", ["-rf",
                    destination.toString()]).wait() } catch (_: Exception) { -1 }
                if (removed != 0 || exists(destination)) { rollbackFailed = true }
            }
            if (!rollbackFailed && oldMoved && exists(backup) && !exists(destination)) {
                let restored = try { launch("/bin/mv", ["-f", backup.toString(),
                    destination.toString()]).wait() } catch (_: Exception) { -1 }
                if (restored != 0 || !exists(destination)) { rollbackFailed = true }
            }
            if (rollbackFailed) {
                throw Exception("active_snapshot_live_tree_rollback_failed:${relative}")
            }
            throw e
        } finally {
            if (exists(tmp)) { try { _ = launch("/bin/rm", ["-rf", tmp.toString()]).wait() } catch (_: Exception) { () } }
            if (!rollbackFailed && exists(backup)) { try { _ = launch("/bin/rm", ["-rf", backup.toString()]).wait() } catch (_: Exception) { () } }
        }
        this.ensureActiveSnapshotDeadline("${progressStage}_copy_after", deadlineAtMillis)
    }

    private func loadActiveSnapshotFromPrefix(prefix: String, extraDiagnostic: String,
        allowLiveOverlay!: Bool = true, allowCommittedEmpty!: Bool = false): ActiveSnapshot {
        this.activeSnapshotMaterializations += 1
        let snapshot = ActiveSnapshot()
        snapshot.activeVersion = this.readLinesFromPrefix(prefix, "index/active.version").trimAscii()
        if (snapshot.activeVersion == "") {
            snapshot.valid = false
            snapshot.diagnostic = snapshotDiagnostic("missing_active_version", extraDiagnostic)
            return snapshot
        }
        let metadata = if (allowLiveOverlay) {
            this.activeSnapshotMetadataWithLiveOverlay(prefix, snapshot.activeVersion)
        } else { this.loadMetadataStatusFromPrefix(prefix) }
        snapshot.candidateVersion = metadata.candidateVersion
        snapshot.failedVersion = metadata.failedVersion
        snapshot.activeStateSource = metadata.activeStateSource
        snapshot.vectorActiveCollection = metadata.vectorActiveCollection
        snapshot.vectorCandidateCollection = metadata.vectorCandidateCollection
        let mismatch = metadata.activeVersion != "" && metadata.activeVersion != snapshot.activeVersion
        let diagnostics = ArrayList<String>()
        snapshot.activeIndex = this.parseNormalizedStrict(this.readLinesFromPrefix(prefix, "index/active.ckb"), diagnostics)
        if (diagnostics.size > 0) {
            snapshot.valid = false
            snapshot.diagnostic = snapshotDiagnostic("malformed_active_index", extraDiagnostic)
            return snapshot
        }
        if (snapshot.activeIndex.size == 0 && !allowCommittedEmpty) {
            snapshot.valid = false
            snapshot.diagnostic = snapshotDiagnostic("missing_or_empty_active_index", extraDiagnostic)
            return snapshot
        }
        if (snapshot.activeIndex.size == 0 && (metadata.rawCount != 0 ||
            metadata.normalizedCount != 0 || metadata.indexCount != 0 ||
            metadata.vectorIndexCount != 0 || metadata.graphNodeCount != 0 ||
            metadata.graphEdgeCount != 0)) {
            snapshot.valid = false
            snapshot.diagnostic = snapshotDiagnostic("empty_active_index_count_mismatch", extraDiagnostic)
            return snapshot
        }
        for (record in snapshot.activeIndex) {
            if (record.metadata.knowledgeVersion != snapshot.activeVersion) {
                snapshot.valid = false
                snapshot.diagnostic = snapshotDiagnostic("active_index_version_mismatch", extraDiagnostic)
                return snapshot
            }
        }
        snapshot.rawRecords = this.parseRaw(this.readLinesFromPrefix(prefix, "raw/records.ckb"))
        snapshot.normalizedRecords = this.parseNormalized(this.readLinesFromPrefix(prefix, "normalized/records.ckb"))
        snapshot.valid = true
        snapshot.degraded = mismatch
        snapshot.diagnostic = snapshotDiagnostic(if (mismatch) { "metadata_active_mismatch" } else { "ok" }, extraDiagnostic)
        let vectorCollection = if (metadata.vectorActiveCollection == "") { "active" } else { metadata.vectorActiveCollection }
        let vectorRelative = "index/vector-${safeName(vectorCollection)}.ckb"
        snapshot.hasVectorArtifact = this.has(if (prefix == "") { vectorRelative } else { "${prefix}/${vectorRelative}" })
        if (snapshot.hasVectorArtifact) {
            snapshot.vectorRecords = this.parseVector(this.readLinesFromPrefix(prefix, vectorRelative))
        }
        snapshot.hasGraphArtifacts = this.has(if (prefix == "") { "index/graph-nodes.ckb" } else { "${prefix}/index/graph-nodes.ckb" }) && this.has(if (prefix == "") { "index/graph-edges.ckb" } else { "${prefix}/index/graph-edges.ckb" })
        snapshot
    }

    private func loadMetadataStatusFromPrefix(prefix: String): StoreMetadataStatus {
        let status = StoreMetadataStatus()
        let text = this.readLinesFromPrefix(prefix, "metadata/status.ckb")
        for (line in text.split("\n")) {
            let trimmed = line.trimAscii()
            if (trimmed == "") {
                continue
            }
            let parts = trimmed.split("=")
            if (parts.size < 2) {
                continue
            }
            let key = parts[0]
            let value = trimmed[(key.size + 1)..trimmed.size]
            if (key == "active") {
                status.activeVersion = value
            } else if (key == "candidate") {
                status.candidateVersion = value
            } else if (key == "failed") {
                status.failedVersion = value
            } else if (key == "activeStateSource") {
                status.activeStateSource = value
            } else if (key == "rawCount") {
                status.rawCount = parseIntField(value, 0)
            } else if (key == "normalizedCount") {
                status.normalizedCount = parseIntField(value, 0)
            } else if (key == "indexCount") {
                status.indexCount = parseIntField(value, 0)
            } else if (key == "textIndexCount") {
                status.textIndexCount = parseIntField(value, 0)
            } else if (key == "vectorIndexCount") {
                status.vectorIndexCount = parseIntField(value, 0)
            } else if (key == "symbolIndexCount") {
                status.symbolIndexCount = parseIntField(value, 0)
            } else if (key == "graphIndexCount") {
                status.graphIndexCount = parseIntField(value, 0)
            } else if (key == "vectorBackend") {
                status.vectorBackend = value
            } else if (key == "vectorState") {
                status.vectorState = value
            } else if (key == "vectorCollection") {
                status.vectorCollection = value
            } else if (key == "vectorActiveCollection") {
                status.vectorActiveCollection = value
            } else if (key == "vectorCandidateCollection") {
                status.vectorCandidateCollection = value
            } else if (key == "vectorDimension") {
                status.vectorDimension = parseIntField(value, 0)
            } else if (key == "vectorDegradedReason") {
                status.vectorDegradedReason = unescapeField(value)
            } else if (key == "graphBackend") {
                status.graphBackend = value
            } else if (key == "graphState") {
                status.graphState = value
            } else if (key == "graphNodeCount") {
                status.graphNodeCount = parseIntField(value, 0)
            } else if (key == "graphEdgeCount") {
                status.graphEdgeCount = parseIntField(value, 0)
            }
        }
        status
    }

    private func activeSnapshotMetadataWithLiveOverlay(prefix: String, activeVersion: String): StoreMetadataStatus {
        let metadata = this.loadMetadataStatusFromPrefix(prefix)
        if (prefix != "") {
            let live = this.loadMetadataStatusFromPrefix("")
            if (live.activeVersion == activeVersion) {
                if (live.candidateVersion != "") {
                    metadata.candidateVersion = live.candidateVersion
                }
                if (live.failedVersion != "") {
                    metadata.failedVersion = live.failedVersion
                }
                if (live.activeStateSource != "") {
                    metadata.activeStateSource = live.activeStateSource
                }
            }
        }
        metadata
    }

    private func copyIfPresentTo(destination: FileKnowledgeStore, relative: String): Int64 {
        if (!this.has(relative)) {
            return 0
        }
        destination.writeLines(relative, this.readLines(relative))
        1
    }

    private func deleteRelativeFile(relative: String): Bool {
        if (!relative.startsWith("index/vector-") || !relative.endsWith(".ckb") || relative.contains("..") || relative.contains("\u{0}")) {
            return false
        }
        let path = this.root.join(relative)
        if (!exists(path)) {
            return true
        }
        try {
            let code = launch("/bin/rm", ["-f", path.toString()]).wait()
            code == 0 && !exists(path)
        } catch (_: Exception) {
            false
        }
    }

    private func parseNormalized(text: String): ArrayList<NormalizedRecord> {
        let diagnostics = ArrayList<String>()
        this.parseNormalizedInternal(text, false, diagnostics)
    }

    private func parseRaw(text: String): ArrayList<RawRecord> {
        let out = ArrayList<RawRecord>()
        if (text == "") {
            return out
        }
        for (line in text.split("\n")) {
            let parts = line.split("|")
            if (parts.size >= 19) {
                let v2Record = parts.size >= 27 && parts[25] == "p5-record-v2"
                if (v2Record &&
                    !ckbMetadataDerivedFromDecode(parts[24]).valid) {
                    continue
                }
                let metadata = metadataFromParts(parts, 4)
                let record = RawRecord()
                record.sourceId = unescapeField(parts[0])
                record.title = unescapeField(parts[1])
                record.content = unescapeField(parts[2])
                record.contentHash = unescapeField(parts[3])
                record.metadata = metadata
                record.requiresReview = if (v2Record) {
                    parts[26] == "true"
                } else { metadata.reviewState == ReviewStates.CANDIDATE }
                out.add(record)
            }
        }
        out
    }

    private func parseNormalizedStrict(text: String, diagnostics: ArrayList<String>): ArrayList<NormalizedRecord> {
        this.parseNormalizedInternal(text, true, diagnostics)
    }

    private func parseNormalizedInternal(text: String, strict: Bool, diagnostics: ArrayList<String>): ArrayList<NormalizedRecord> {
        let out = ArrayList<NormalizedRecord>()
        if (text == "") {
            return out
        }
        var lineNumber: Int64 = 0
        for (line in text.split("\n")) {
            lineNumber += 1
            if (line == "") {
                continue
            }
            let parts = line.split("|")
            if (parts.size >= 20) {
                let v2Record = parts.size >= 29 && parts[27] == "p5-record-v2"
                if (v2Record) {
                    let derived = ckbMetadataDerivedFromDecode(parts[26])
                    if (!derived.valid) {
                        if (strict) {
                            diagnostics.add("malformed active index metadata derivedFrom line ${lineNumber}:${derived.status}")
                        }
                        continue
                    }
                }
                let metadata = metadataFromParts(parts, 6)
                let record = NormalizedRecord()
                record.sourceId = unescapeField(parts[0])
                record.recordKind = unescapeField(parts[1])
                record.title = unescapeField(parts[2])
                record.chunk = unescapeField(parts[3])
                record.citation = unescapeField(parts[4])
                record.score = try { Float64.parse(parts[5]) } catch (_: Exception) { 0.0 }
                record.metadata = metadata
                record.requiresReview = if (v2Record) {
                    parts[28] == "true"
                } else { metadata.reviewState == ReviewStates.CANDIDATE }
                out.add(record)
            } else if (strict) {
                diagnostics.add("malformed active index line ${lineNumber}")
            }
        }
        out
    }

    private func rawLines(records: ArrayList<RawRecord>): String {
        let out = StringBuilder()
        for (record in records) {
            out.append(this.rawLine(record))
        }
        out.toString()
    }

    private func rawLine(record: RawRecord): String {
        "${escapeField(record.sourceId)}|${escapeField(record.title)}|${escapeField(record.content)}|${escapeField(record.contentHash)}|${metadataLine(record.metadata)}|p5-record-v2|${record.requiresReview}\n"
    }

    private func writeRawRecordsAtomically(relative: String, records: ArrayList<RawRecord>, deadlineAtMillis: Int64, progressStage: String): Unit {
        this.ensureLayout()
        let path = this.root.join(relative)
        if (!exists(path.parent)) {
            Directory.create(path.parent, recursive: true)
        }
        let tmp = this.atomicTmpPath(path, relative)
        try {
            try (file = File(tmp, OpenMode.Write)) {
                var written: Int64 = 0
                for (record in records) {
                    if (written % 256 == 0) {
                        this.ensureActiveSnapshotDeadline("${progressStage}_aggregate:${written}:${records.size}", deadlineAtMillis)
                    }
                    file.write(this.rawLine(record).toArray())
                    written += 1
                }
            }
            this.replaceFileWithTmp(path, tmp)
        } catch (e: Exception) {
            this.deleteAtomicTmp(tmp)
            throw e
        }
    }

    private func writeRawRecordAtomically(relative: String, record: RawRecord): Unit {
        this.writeLinesAtomically(relative, this.rawLine(record))
    }

    private func writeRawFilesAtomically(prefix: String, records: ArrayList<RawRecord>, deadlineAtMillis!: Int64 = 0, progressStage!: String = "raw_write"): Unit {
        let base = if (prefix == "") { "" } else { "${prefix}/" }
        this.ensureActiveSnapshotDeadline("${progressStage}_aggregate_before", deadlineAtMillis)
        this.writeRawRecordsAtomically("${base}raw/records.ckb", records, deadlineAtMillis, progressStage)
        var written: Int64 = 0
        for (record in records) {
            if (written % 64 == 0) {
                this.ensureActiveSnapshotDeadline("${progressStage}_record:${written}:${records.size}", deadlineAtMillis)
            }
            this.writeRawRecordAtomically("${base}raw/${safeName(record.metadata.sourceType)}/${safeName(record.sourceId)}.ckb", record)
            written += 1
        }
    }

    private func writeActiveSnapshotLiveShadow(txRoot: String, status: KnowledgeStatus, rawRecords: ArrayList<RawRecord>, normalizedRecords: ArrayList<NormalizedRecord>, activeIndex: ArrayList<NormalizedRecord>, vectorRecords: ArrayList<VectorRecord>, vectorCollection: String, graph: GraphBuildResult, persistVectorFile!: Bool = true, deadlineAtMillis!: Int64 = 0, stageSink!: CkbStagedRebuildStageSink = NoopCkbStagedRebuildStageSink()): Unit {
        this.emitActiveSnapshotStage(stageSink, "active_snapshot_live_raw_before", "running", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
        this.copySnapshotDirectoryContentsFromTx(txRoot, "raw", deadlineAtMillis, "active_snapshot_live_raw")
        this.emitActiveSnapshotStage(stageSink, "active_snapshot_live_raw_after", "ok", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
        this.emitActiveSnapshotStage(stageSink, "active_snapshot_live_normalized_before", "running", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
        this.copySnapshotFileAtomicallyFromTx(txRoot, "normalized/records.ckb", deadlineAtMillis, "active_snapshot_live_normalized")
        this.emitActiveSnapshotStage(stageSink, "active_snapshot_live_normalized_after", "ok", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
        this.emitActiveSnapshotStage(stageSink, "active_snapshot_live_index_before", "running", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
        this.copySnapshotFileAtomicallyFromTx(txRoot, "index/active.version", deadlineAtMillis, "active_snapshot_live_index_version")
        this.copySnapshotFileAtomicallyFromTx(txRoot, "index/active.ckb", deadlineAtMillis, "active_snapshot_live_index")
        this.emitActiveSnapshotStage(stageSink, "active_snapshot_live_index_after", "ok", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
        if (persistVectorFile) {
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_live_vector_before", "running", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
            this.copySnapshotFileAtomicallyFromTx(txRoot, "index/vector-${safeName(vectorCollection)}.ckb", deadlineAtMillis, "active_snapshot_live_vector")
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_live_vector_after", "ok", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
        } else {
            this.emitActiveSnapshotStage(stageSink, "active_snapshot_live_vector_skipped", "skipped", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
        }
        this.emitActiveSnapshotStage(stageSink, "active_snapshot_live_graph_before", "running", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
        this.copySnapshotFileAtomicallyFromTx(txRoot, "index/graph-nodes.ckb", deadlineAtMillis, "active_snapshot_live_graph_nodes")
        this.copySnapshotFileAtomicallyFromTx(txRoot, "index/graph-edges.ckb", deadlineAtMillis, "active_snapshot_live_graph_edges")
        this.emitActiveSnapshotStage(stageSink, "active_snapshot_live_graph_after", "ok", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
        this.emitActiveSnapshotStage(stageSink, "active_snapshot_live_status_before", "running", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
        this.copySnapshotFileAtomicallyFromTx(txRoot, "metadata/status.ckb", deadlineAtMillis, "active_snapshot_live_status")
        this.emitActiveSnapshotStage(stageSink, "active_snapshot_live_status_after", "ok", status, rawRecords, normalizedRecords, activeIndex, vectorRecords, graph, deadlineAtMillis, persistVectorFile)
        if (this.has("${txRoot}/metadata/cangjie-version-manifest.ckb")) {
            this.writeLinesAtomically("metadata/active-cangjie-version-manifest.ckb",
                this.readLines("${txRoot}/metadata/cangjie-version-manifest.ckb"))
            this.writeLinesAtomically("metadata/active-cangjie-freshness.ckb",
                this.readLines("${txRoot}/metadata/cangjie-freshness.ckb"))
            this.writeLinesAtomically("metadata/active-cangjie-release-coverage.ckb",
                this.readLines("${txRoot}/metadata/cangjie-release-coverage.ckb"))
        } else {
            this.deleteActiveSnapshotCompanionLiveShadows()
        }
    }

    private func normalizedLines(records: ArrayList<NormalizedRecord>): String {
