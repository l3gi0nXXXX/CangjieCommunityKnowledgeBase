private func ckbRunScheduledProfileFetches(profile: CkbScheduleTaskProfile, runner: SourceFetchRunner, config: CkbRuntimeConfig, store: FileKnowledgeStore, manifest: CangjieVersionManifest, deadlineAtMillis!: Int64 = 0): CkbScheduledProfileFetchResult {
    let result = fetchScheduledProfileSources(profile, runner, config, store, manifest, deadlineAtMillis: deadlineAtMillis)
    ckbSyncScheduledRequestAccounting(result)
    result.diagnostics.add(ckbSchedulerProfileStageBudgetDiagnostic(profile))
    ckbWriteScheduledProfileStageCheckpoint(store, profile, "fetch", result.status, profile.fetchBudgetMillis, deadlineAtMillis, "plannedRequests=${result.plannedRequests}|actualAttempts=${result.actualAttempts}|successfulAttempts=${result.successfulAttempts}|retryAttempts=${result.retryAttempts}|completedRequests=${result.completedRequests}|failedRequests=${result.failedRequestCount}|fetched=${result.fetchedCount}|failed=${result.failedCount}")
    result.diagnostics.add("profile_stage_checkpoint:profile=${profile.profile}|stage=fetch|status=${result.status}|budgetMs=${profile.fetchBudgetMillis}|deadlineAtMillis=${deadlineAtMillis}|remainingMs=${ckbRemainingMillis(deadlineAtMillis)}")
    result
}

func fetchScheduledProfileSources(profile: CkbScheduleTaskProfile, runner: SourceFetchRunner, config: CkbRuntimeConfig, store: FileKnowledgeStore, manifest: CangjieVersionManifest, deadlineAtMillis!: Int64 = 0): CkbScheduledProfileFetchResult {
    let result = CkbScheduledProfileFetchResult()
    let builder = SourceRequestBuilder(gitCodeApiRoot: config.gitCodeBaseUrl)
    if (profile.profile == "cangjie_release_full_sync") {
        result.releasePlan = ckbBuildReleaseFullSyncPlan(profile, manifest, ckbScheduledTargetVersion(config))
        if (!result.releasePlan.ok) {
            result.ok = false
            result.status = result.releasePlan.status
            for (diagnostic in result.releasePlan.diagnostics) {
                result.diagnostics.add(diagnostic)
            }
            return result
        }
        ckbFetchReleaseFullSyncPlan(runner, builder, profile, result, config, store, deadlineAtMillis: deadlineAtMillis)
    } else if (profile.profile == "community_repo_discovery") {
        ckbFetchScheduledSource(runner, builder.gitCodeOrgRepos("cangjie"), profile, result, config, deadlineAtMillis: deadlineAtMillis)
        ckbFetchScheduledSource(runner, builder.gitCodeOrgRepos("cangjie-sig"), profile, result, config, deadlineAtMillis: deadlineAtMillis)
        ckbFetchScheduledSource(runner, builder.gitCodeOrgRepos("cangjie-tpc"), profile, result, config, deadlineAtMillis: deadlineAtMillis)
    } else if (profile.profile == "docs_probe") {
        ckbFetchScheduledSource(runner, builder.docs("https://docs.cangjie-lang.cn/docs/1.0.0/"), profile, result, config, deadlineAtMillis: deadlineAtMillis)
    } else if (profile.profile == "website_probe" || profile.profile == "website_full") {
        ckbFetchScheduledSource(runner, builder.website("https://cangjie-lang.cn/"), profile, result, config, deadlineAtMillis: deadlineAtMillis)
        ckbFetchScheduledSource(runner, builder.website("https://cangjie-lang.cn/docs"), profile, result, config, deadlineAtMillis: deadlineAtMillis)
        ckbFetchScheduledSource(runner, builder.website("https://cangjie-lang.cn/en/docs"), profile, result, config, deadlineAtMillis: deadlineAtMillis)
    } else if (profile.profile == "web_candidate_discovery" || profile.profile == "web_candidate_recrawl") {
        ckbFetchScheduledSource(runner, builder.webCandidate("https://cangjie-lang.cn/community"), profile, result, config, deadlineAtMillis: deadlineAtMillis)
        ckbFetchScheduledSource(runner, builder.webCandidate("https://cangjie-lang.cn/blog"), profile, result, config, deadlineAtMillis: deadlineAtMillis)
    } else if (profile.profile == "cangjie_freshness_probe") {
        ckbFetchScheduledSource(runner, builder.docs("https://docs.cangjie-lang.cn/docs/1.0.0/"), profile, result, config, deadlineAtMillis: deadlineAtMillis)
        ckbFetchScheduledManifestRepoSources(runner, builder, manifest, profile, result, config, store, true, true, true, true, true, deadlineAtMillis: deadlineAtMillis)
    } else if (profile.profile == "cangjie_docs_full_sync") {
        result.diagnostics.add("scheduled_source_boundary:profile=${profile.profile}|plannedFamilies=docs,eval-support|excluded=std,stdx,tools")
        ckbFetchScheduledSource(runner, builder.docs("https://docs.cangjie-lang.cn/docs/1.0.0/"), profile, result, config, deadlineAtMillis: deadlineAtMillis)
        ckbFetchScheduledManifestRepoSources(runner, builder, manifest, profile, result, config, store, true, false, false, false, true, deadlineAtMillis: deadlineAtMillis)
    } else if (profile.profile == "cangjie_source_event_sync") {
        ckbFetchScheduledManifestRepoSources(runner, builder, manifest, profile, result, config, store, false, true, true, true, true, deadlineAtMillis: deadlineAtMillis)
    } else if (profile.profile == "cangjie_version_branch_refresh") {
        ckbFetchVersionBranchRefreshSources(runner, builder, manifest, profile, result, config, store, deadlineAtMillis: deadlineAtMillis)
    } else if (profile.profile == "cangjie_benchmark_gap_curation") {
        result.ok = true
    }
    ckbSyncScheduledRequestAccounting(result)
    if (!result.ok && profile.profile == "cangjie_release_full_sync") {
        // P5 statuses are a durable acquisition contract. Do not collapse
        // plan, inventory, decoding, or content failures into fetch_degraded.
        if (ckbScheduledFetchDeadlineWasExceeded(result)) {
            result.status = "fetch_deadline_exceeded"
        }
    } else if (!result.ok && !result.status.startsWith("manifest_source_missing")) {
        result.status = "fetch_degraded:${ckbScheduledFetchPrimaryFailure(result)}"
    }
    result
}

private func ckbFetchReleaseFullSyncPlan(runner: SourceFetchRunner, builder: SourceRequestBuilder, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, store: FileKnowledgeStore, deadlineAtMillis!: Int64 = 0): Unit {
    var sourceOrdinal: Int64 = 0
    for (source in result.releasePlan.sources) {
        let inventory = ckbReleaseInventoryForSource(source)
        result.releaseInventories.add(inventory)
        let evidenceStart = result.controlEvidence.size
        ckbEmitReleaseSourceFetchStarted(store, source)
        try {
            if (source.sourceSet == CangjieSourceSets.EVAL_SUPPORT) {
                ckbFetchReleaseEvalSupportSource(source, profile, result,
                    inventory, config, store, sourceOrdinal: sourceOrdinal)
            } else {
                ckbFetchReleaseRemoteSource(runner, builder, source,
                    profile, result, inventory, config, store,
                    deadlineAtMillis: deadlineAtMillis,
                    sourceOrdinal: sourceOrdinal)
            }
        } catch (e: Exception) {
            inventory.complete = false
            inventory.status = "fetch_exception"
            ckbReleaseInventorySortPaths(inventory)
            ckbEmitReleaseTreePageScannedEvents(store, source,
                result.controlEvidence, evidenceStart)
            ckbEmitReleaseSourceFetchFinished(store, source, inventory,
                result.controlEvidence, evidenceStart)
            throw e
        }
        ckbReleaseInventorySortPaths(inventory)
        ckbEmitReleaseTreePageScannedEvents(store, source,
            result.controlEvidence, evidenceStart)
        ckbEmitReleaseSourceFetchFinished(store, source,
            inventory, result.controlEvidence, evidenceStart)
        if (!inventory.complete) {
            if (result.ok) {
                ckbReleaseFailFetchResult(result, inventory.status, source, "source_incomplete")
            }
            break
        }
        sourceOrdinal += 1
    }
    ckbSyncScheduledRequestAccounting(result)
    if (result.ok && ckbReleaseAllInventoriesComplete(result.releasePlan, result.releaseInventories)) {
        result.status = "profile_ok"
        result.diagnostics.add("release_inventory_complete:planHash=${result.releasePlan.planHash}|sources=${result.releaseInventories.size}|contentRecords=${result.contentRecords.size}|controlEvidence=${result.controlEvidence.size}")
    } else if (result.ok) {
        result.ok = false
        result.status = "release_inventory_incomplete"
        result.diagnostics.add("release_inventory_incomplete:planHash=${result.releasePlan.planHash}|inventories=${result.releaseInventories.size}|plannedSources=${result.releasePlan.sources.size}")
    }
}

private func ckbReleaseSourceFetchProgress(store: FileKnowledgeStore,
    source: CkbReleaseSourcePlan): CkbStagedRebuildStageProgress {
    let progress = CkbStagedRebuildStageProgress()
    progress.runId = ckbSchedulerCurrentRunId(store)
    progress.taskName = ckbSchedulerCurrentTaskName(store)
    progress.stage = "routine_fetch"
    progress.requestKind = if (source.sourceSet ==
        CangjieSourceSets.EVAL_SUPPORT) {
        "eval_support_local"
    } else { SourceKinds.GITCODE_SOURCE }
    progress.repo = source.normalizedRepo
    progress.sourceSet = source.sourceSet
    progress
}

private func ckbEmitReleaseSourceFetchStarted(store: FileKnowledgeStore,
    source: CkbReleaseSourcePlan): Unit {
    let progress = ckbReleaseSourceFetchProgress(store, source)
    progress.status = "running"
    progress.typedEvent = "routine.fetch.started"
    progress.atMillis = ckbCoreNowMillis()
    FileCkbStagedRebuildStageSink(store,
        schedulerRunId: progress.runId,
        schedulerTaskName: progress.taskName).onTypedEvent(progress)
}

private func ckbEmitReleaseSourceFetchFinished(store: FileKnowledgeStore,
    source: CkbReleaseSourcePlan,
    inventory: CkbReleaseSourceInventory,
    evidence: ArrayList<CkbReleaseControlEvidence>,
    evidenceStart: Int64): Unit {
    let progress = ckbReleaseSourceFetchProgress(store, source)
    let hashes = StringBuilder()
    var lastHttpStatus: Int64 = 0
    var retryCount: Int64 = 0
    for (index in evidenceStart..evidence.size) {
        let item = evidence[index]
        if (item.sourceIdentity != source.canonicalIdentity) { continue }
        hashes.append("${item.kind}|${item.bodyHash}\n")
        if (item.httpStatus > 0) { lastHttpStatus = item.httpStatus }
        retryCount += item.retryCount
    }
    progress.status = inventory.status
    progress.httpStatus = if (lastHttpStatus > 0) { lastHttpStatus } else if (
        inventory.complete) { 200 } else { 0 }
    let evidenceSeed = if (hashes.toString() != "") {
        hashes.toString()
    } else {
        "${inventory.sourceIdentity}|${inventory.resolvedCommit}|${inventory.status}"
    }
    progress.bodyHash = ckbReleaseEvidenceHash(evidenceSeed)
    progress.retryCount = retryCount
    progress.typedEvent = "routine.fetch.finished"
    progress.atMillis = ckbCoreNowMillis()
    FileCkbStagedRebuildStageSink(store,
        schedulerRunId: progress.runId,
        schedulerTaskName: progress.taskName).onTypedEvent(progress)
}

private func ckbEmitReleaseTreePageScannedEvents(store: FileKnowledgeStore,
    source: CkbReleaseSourcePlan,
    evidence: ArrayList<CkbReleaseControlEvidence>,
    evidenceStart: Int64): Unit {
    let sink = FileCkbStagedRebuildStageSink(store,
        schedulerRunId: ckbSchedulerCurrentRunId(store),
        schedulerTaskName: ckbSchedulerCurrentTaskName(store))
    for (index in evidenceStart..evidence.size) {
        let item = evidence[index]
        if (item.kind != "tree_page" ||
            item.sourceIdentity != source.canonicalIdentity) { continue }
        let progress = ckbReleaseSourceFetchProgress(store, source)
        progress.status = item.status
        progress.page = item.page
        progress.objectsSeen = item.objectCount
        progress.filesSeen = item.fileCount
        progress.directoriesSeen = item.directoryCount
        progress.candidatesSeen = item.candidateCount
        progress.stopReason = item.stopReason
        progress.typedEvent = "routine.tree.page_scanned"
        progress.atMillis = ckbCoreNowMillis()
        sink.onTypedEvent(progress)
    }
}

func ckbReleaseInventoryForSource(source: CkbReleaseSourcePlan): CkbReleaseSourceInventory {
    let inventory = CkbReleaseSourceInventory()
    inventory.sourceIdentity = source.canonicalIdentity
    inventory.sourceSet = source.sourceSet
    inventory.sourceFamily = source.sourceFamily
    inventory.repo = source.normalizedRepo
    inventory.originalRef = source.originalRef
    inventory
}

func ckbFetchReleaseRemoteSource(runner: SourceFetchRunner, builder: SourceRequestBuilder, source: CkbReleaseSourcePlan, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, inventory: CkbReleaseSourceInventory, config: CkbRuntimeConfig, store: FileKnowledgeStore, deadlineAtMillis!: Int64 = 0, sourceOrdinal!: Int64 = 0): Unit {
    let planningKey = ckbReleaseScheduledFetchRunKey(profile, source, result.releasePlan.planHash)
    let staleTempsRemoved = store.cleanupReleaseAcquisitionStaleTemps(planningKey.acquisitionId)
    if (staleTempsRemoved > 0) { result.diagnostics.add("release_acquisition_stale_temps_removed:sourceSet=${source.sourceSet}|count=${staleTempsRemoved}") }
    let acquisitionState = ckbLoadReleaseAcquisitionState(store, planningKey)
    let reuseExisting = acquisitionState.status == "not_found" || (acquisitionState.valid && acquisitionState.state == "active")
    let verifyConsumed = acquisitionState.valid && acquisitionState.state == "consumed"
    if (!reuseExisting && !verifyConsumed) {
        result.diagnostics.add("release_acquisition_artifacts_rejected:sourceSet=${source.sourceSet}|status=${acquisitionState.status}")
    }
    if (reuseExisting && ckbHydrateCompletedReleaseRemoteSource(builder, source, profile, result, inventory, store, planningKey, sourceOrdinal)) {
        return
    }
    var resolution = GitCodeRefResolution()
    resolution.status = "not_found"
    var resolutionAttempted = false
    if (reuseExisting) { resolution = ckbLoadReleaseRefResolution(store, planningKey) }
    if (verifyConsumed) {
        let consumedResolution = ckbLoadReleaseRefResolution(store,
            planningKey, allowConsumed: true)
        resolution = ckbResolveGitCodeRefForFetch(runner, builder,
            source.source.sourceRepo, source.originalRef, source.sourceSet,
            source.sourceFamily, config, deadlineAtMillis: deadlineAtMillis,
            accounting: result.accounting)
        resolutionAttempted = true
        if (resolution.ok && consumedResolution.ok &&
            resolution.resolvedCommit == consumedResolution.resolvedCommit &&
            ckbHydrateCompletedReleaseRemoteSource(builder, source, profile,
                result, inventory, store, planningKey, sourceOrdinal,
                verifiedResolution: resolution)) {
            result.diagnostics.add("release_consumed_ref_verified:sourceSet=${source.sourceSet}|commit=${utf8SafePrefix(resolution.resolvedCommit, 64)}")
            return
        }
        if (resolution.ok) {
            ckbStartReleaseAcquisitionForResolution(store, planningKey,
                resolution, sourceOrdinal)
            result.diagnostics.add("release_consumed_acquisition_restarted:sourceSet=${source.sourceSet}|commitChanged=${!consumedResolution.ok || resolution.resolvedCommit != consumedResolution.resolvedCommit}")
        }
    }
    if (!resolution.ok && !resolutionAttempted) {
        resolution = ckbResolveGitCodeRefForFetch(runner, builder, source.source.sourceRepo, source.originalRef, source.sourceSet, source.sourceFamily, config, deadlineAtMillis: deadlineAtMillis, accounting: result.accounting)
        if (resolution.ok) {
            ckbStartReleaseAcquisitionForResolution(store, planningKey,
                resolution, sourceOrdinal)
        } else if (resolution.status != "not_found") {
            result.diagnostics.add("release_ref_artifact_rejected:sourceSet=${source.sourceSet}|status=${resolution.status}")
        }
    } else if (reuseExisting && resolution.ok && !resolutionAttempted) {
        result.diagnostics.add("release_ref_artifact_hydrated:sourceSet=${source.sourceSet}|commit=${utf8SafePrefix(resolution.resolvedCommit, 64)}")
    }
    ckbAppendReleaseRefEvidence(result, source, resolution)
    if (!resolution.ok) {
        let status = ckbReleaseAcquisitionFailureStatus(resolution.status)
        ckbReleaseInventoryFailure(inventory, status)
        ckbReleaseFailFetchResult(result, status, source, "ref_resolution_failed")
        return
    }
    let runKey = ckbReleaseRunKeyWithCommit(planningKey, resolution.resolvedCommit)
    ckbMarkReleaseAcquisitionState(store, runKey, "active")
    result.releaseAcquisitionKeys.add(runKey)
    inventory.resolvedCommit = resolution.resolvedCommit
    var checkpoint = if (reuseExisting) { ckbLoadReleaseResumeCheckpoint(store, runKey) } else { CkbReleaseResumeCheckpoint() }
    if (!checkpoint.valid) {
        checkpoint = CkbReleaseResumeCheckpoint()
        checkpoint.phase = "ref"
        checkpoint.sourceOrdinal = sourceOrdinal
        checkpoint.refArtifactPath = ckbReleaseArtifactRelativePath(runKey, CkbReleaseArtifactKinds.REF)
    }
    var page: Int64 = 1
    while (true) {
        let request = builder.gitCodeTreePageWithFetchRef(source.source.sourceRepo, source.originalRef, resolution.effectiveRef, page: page, perPage: 100)
        var pageArtifact = if (reuseExisting) { ckbLoadReleaseContentArtifact(store, runKey, CkbReleaseArtifactKinds.TREE_PAGE, ordinal: page) } else { CkbScheduledContentArtifact() }
        if (pageArtifact.valid && (!checkpoint.pageArtifactPaths.contains(pageArtifact.relativePath) || !checkpoint.artifactEvidenceHashes.contains(pageArtifact.evidenceHash) || checkpoint.nextPage <= page)) {
            result.diagnostics.add("release_tree_page_artifact_uncommitted:sourceSet=${source.sourceSet}|page=${page}")
            pageArtifact = CkbScheduledContentArtifact()
        }
        var fetch = SourceFetchResult()
        if (pageArtifact.valid) {
            fetch = ckbReleaseHydratedFetch(request, resolution, pageArtifact)
            result.diagnostics.add("release_tree_page_artifact_hydrated:sourceSet=${source.sourceSet}|page=${page}|bodyHash=${pageArtifact.payloadHash}")
        } else {
            if (pageArtifact.status != "not_found") {
                result.diagnostics.add("release_tree_page_artifact_rejected:sourceSet=${source.sourceSet}|page=${page}|status=${pageArtifact.status}")
            }
            fetch = ckbFetchScheduledRequest(runner, request, config, deadlineAtMillis: deadlineAtMillis, accounting: result.accounting)
            ckbApplyGitCodeRefResolutionToFetch(fetch, resolution)
            if (fetch.body != "") { fetch.bodyHash = ckbReleaseEvidenceHash(fetch.body) }
        }
        inventory.pagesScanned += 1
        if (fetch.truncated) {
            ckbAppendReleaseControlEvidence(result, source, "tree_page", request, fetch, resolution, 0, 0, stopReason: "tree_response_truncated")
            ckbReleaseInventoryLimitFailure(result, inventory, source, "tree_response_truncated")
            return
        }
        if (!fetch.ok) {
            ckbAppendReleaseControlEvidence(result, source, "tree_page", request, fetch, resolution, 0, 0, stopReason: "tree_page_failed")
            let status = ckbReleaseAcquisitionFailureStatus(fetch.status)
            ckbReleaseInventoryFailure(inventory, status)
            ckbReleaseFailFetchResult(result, status, source, "tree_page_failed")
            checkpoint.phase = "tree_page"
            checkpoint.nextPage = page
            ckbSaveReleaseResumeCheckpoint(store, runKey, checkpoint)
            return
        }
        let parsed = ckbReleaseParseTreePage(source.sourceSet, fetch.body)
        ckbAppendReleaseControlEvidence(result, source, "tree_page", request, fetch, resolution, parsed.objectsSeen, parsed.filesSeen,
            directoryCount: parsed.directoriesSeen,
            candidateCount: parsed.eligiblePaths.size,
            stopReason: if (parsed.explicitEnd) { "explicit_end" } else { "continue" })
        if (!parsed.ok) {
            if (parsed.truncated || parsed.status == CkbReleaseAcquisitionStatus.INVENTORY_LIMIT_EXCEEDED) {
                ckbReleaseInventoryLimitFailure(result, inventory, source, "tree_response_truncated")
                return
            }
            ckbReleaseInventoryFailure(inventory, parsed.status)
            ckbReleaseFailFetchResult(result, parsed.status, source, "tree_page_parse_failed")
            return
        }
        let committedPage = if (pageArtifact.valid) { pageArtifact } else {
            ckbWriteReleaseContentArtifact(store, runKey, CkbReleaseArtifactKinds.TREE_PAGE, fetch.body, ordinal: page, method: request.kind, contentType: fetch.contentType, fetch: fetch)
        }
        addUniqueString(checkpoint.pageArtifactPaths, committedPage.relativePath)
        addUniqueString(checkpoint.artifactEvidenceHashes, committedPage.evidenceHash)
        checkpoint.phase = "tree_page"
        checkpoint.sourceOrdinal = sourceOrdinal
        // Replaying already committed page artifacts must never move the durable
        // cursor backwards; doing so would make the last committed page look
        // uncommitted on the next loop iteration and trigger a network refetch.
        if (checkpoint.nextPage < page + 1) {
            checkpoint.nextPage = page + 1
        }
        ckbSaveReleaseResumeCheckpoint(store, runKey, checkpoint)
        if (parsed.explicitEnd) {
            inventory.explicitEnd = true
            break
        }
        inventory.nonEmptyPages += 1
        if (inventory.nonEmptyPages > source.maxNonEmptyPages) { ckbReleaseInventoryLimitFailure(result, inventory, source, "nonempty_pages"); return }
        inventory.objectsSeen += parsed.objectsSeen
        inventory.filesSeen += parsed.filesSeen
        if (inventory.objectsSeen > source.maxObjects) { ckbReleaseInventoryLimitFailure(result, inventory, source, "objects"); return }
        if (inventory.filesSeen > source.maxFiles) { ckbReleaseInventoryLimitFailure(result, inventory, source, "files"); return }
        for (path in parsed.eligiblePaths) { _ = ckbReleaseInventoryPlanPath(inventory, path) }
        page += 1
    }
    ckbReleaseInventorySortPaths(inventory)
    if (inventory.plannedPaths.size == 0) {
        let status = "release_source_empty"
        ckbReleaseInventoryFailure(inventory, status)
        ckbReleaseFailFetchResult(result, status, source, "no_eligible_content")
        return
    }
    checkpoint.plannedPaths.clear()
    checkpoint.plannedPaths.add(all: inventory.plannedPaths)
    checkpoint.phase = "content"
    ckbSaveReleaseResumeCheckpoint(store, runKey, checkpoint)
    for (path in inventory.plannedPaths) {
        if (!ckbFetchReleaseContentPath(runner, builder, source, profile, result, inventory, config, resolution, path, store, runKey, checkpoint, allowResume: reuseExisting, deadlineAtMillis: deadlineAtMillis)) { return }
    }
    let completeArtifact = ckbWriteReleaseContentArtifact(store, runKey, CkbReleaseArtifactKinds.SOURCE_COMPLETE, ckbReleaseSourceCompletePayload(inventory))
    checkpoint.phase = "completed"
    checkpoint.sourceOrdinal = sourceOrdinal
    checkpoint.nextPage = inventory.pagesScanned + 1
    checkpoint.currentPathHash = ""
    checkpoint.sourceCompleteArtifactPath = completeArtifact.relativePath
    checkpoint.completedPaths.clear()
    checkpoint.completedPaths.add(all: inventory.completedPaths)
    addUniqueString(checkpoint.artifactEvidenceHashes, completeArtifact.evidenceHash)
    ckbSaveReleaseResumeCheckpoint(store, runKey, checkpoint)
    ckbSaveScheduledFetchCheckpoint(store, profile, source.source, resolution, "completed", inventory.pagesScanned, "", inventory.plannedPaths, inventory.completedPaths)
    inventory.complete = true
    inventory.status = CkbReleaseAcquisitionStatus.OK
}
private func ckbFetchReleaseContentPath(runner: SourceFetchRunner, builder: SourceRequestBuilder, source: CkbReleaseSourcePlan, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, inventory: CkbReleaseSourceInventory, config: CkbRuntimeConfig, resolution: GitCodeRefResolution, path: String, store: FileKnowledgeStore, runKey: CkbScheduledFetchRunKey, checkpoint: CkbReleaseResumeCheckpoint, allowResume!: Bool = true, deadlineAtMillis!: Int64 = 0): Bool {
    var hydratedArtifact = if (allowResume) { ckbLoadReleaseContentArtifact(store, runKey, CkbReleaseArtifactKinds.CONTENT, logicalPath: path) } else { CkbScheduledContentArtifact() }
    if (hydratedArtifact.valid && (!checkpoint.contentArtifactPaths.contains(hydratedArtifact.relativePath) || !checkpoint.artifactEvidenceHashes.contains(hydratedArtifact.evidenceHash) || !checkpoint.completedPaths.contains(path))) {
        result.diagnostics.add("release_content_artifact_uncommitted:sourceSet=${source.sourceSet}|pathHash=${ckbReleaseEvidenceHash(path)}")
        hydratedArtifact = CkbScheduledContentArtifact()
    }
    if (hydratedArtifact.valid) {
        if (!ckbAppendReleasePriorContentEvidence(result, source, builder, resolution, path, hydratedArtifact)) { return false }
        let hydratedRequest = if (hydratedArtifact.method == "contents") {
            builder.gitCodeReleaseSourceContentsWithFetchRef(source.source.sourceRepo, source.originalRef, resolution.effectiveRef, path)
        } else {
            builder.gitCodeReleaseSourceRawWithFetchRef(source.source.sourceRepo, source.originalRef, resolution.effectiveRef, path)
        }
        let hydratedFetch = ckbReleaseHydratedFetch(hydratedRequest, resolution, hydratedArtifact)
        let nextBytes = inventory.contentBytes + hydratedFetch.body.size
        if (nextBytes > source.maxBytes) {
            ckbReleaseInventoryLimitFailure(result, inventory, source, "bytes")
            return false
        }
        inventory.contentBytes = nextBytes
        ckbAppendReleaseControlEvidence(result, source, "content_${hydratedArtifact.method}", hydratedRequest, hydratedFetch, resolution, 0, 1)
        ckbAppendReleaseContentRecord(profile, result, source, hydratedRequest, hydratedFetch)
        _ = ckbReleaseInventoryCompletePath(inventory, path)
        addUniqueString(checkpoint.contentArtifactPaths, hydratedArtifact.relativePath)
        addUniqueString(checkpoint.artifactEvidenceHashes, hydratedArtifact.evidenceHash)
        addUniqueString(checkpoint.completedPaths, path)
        checkpoint.phase = "content"
        checkpoint.currentPathHash = ""
        ckbSaveReleaseResumeCheckpoint(store, runKey, checkpoint)
        result.diagnostics.add("release_content_artifact_hydrated:sourceSet=${source.sourceSet}|pathHash=${ckbReleaseEvidenceHash(path)}|bodyHash=${hydratedArtifact.payloadHash}")
        return true
    }
    if (hydratedArtifact.status != "not_found") {
        result.diagnostics.add("release_content_artifact_rejected:sourceSet=${source.sourceSet}|pathHash=${ckbReleaseEvidenceHash(path)}|status=${hydratedArtifact.status}")
    }

    checkpoint.phase = "content"
    checkpoint.currentPathHash = ckbReleaseEvidenceHash(path)
    ckbSaveReleaseResumeCheckpoint(store, runKey, checkpoint)
    let rawRequest = builder.gitCodeReleaseSourceRawWithFetchRef(source.source.sourceRepo, source.originalRef, resolution.effectiveRef, path)
    var contentRequest = rawRequest
    var contentFetch = ckbFetchScheduledRequest(runner, rawRequest, config, deadlineAtMillis: deadlineAtMillis, accounting: result.accounting)
    var method = "raw"
    var priorFetchEvidencePayload = ""
    ckbApplyGitCodeRefResolutionToFetch(contentFetch, resolution)
    if (contentFetch.body != "") { contentFetch.bodyHash = ckbReleaseEvidenceHash(contentFetch.body) }
    ckbAppendReleaseControlEvidence(result, source, "content_raw", rawRequest, contentFetch, resolution, 0, 1)
    if (contentFetch.truncated || contentFetch.status == "source_too_large") {
        ckbReleaseInventoryLimitFailure(result, inventory, source, "bytes")
        return false
    }
    if (!contentFetch.ok) {
        let rawStatus = ckbReleaseAcquisitionFailureStatus(contentFetch.status)
        if (rawStatus == "invalid_response_encoding" || rawStatus == "fetch_deadline_exceeded" || rawStatus == "timeout") {
            ckbReleaseInventoryFailure(inventory, rawStatus)
            ckbReleaseFailFetchResult(result, rawStatus, source, "content_raw_failed")
            return false
        }
        priorFetchEvidencePayload = ckbReleaseFetchEvidencePayload(contentFetch)
        let contentsRequest = builder.gitCodeReleaseSourceContentsWithFetchRef(source.source.sourceRepo, source.originalRef, resolution.effectiveRef, path)
        let contentsFetch = ckbFetchScheduledRequest(runner, contentsRequest, config, deadlineAtMillis: deadlineAtMillis, accounting: result.accounting)
        ckbApplyGitCodeRefResolutionToFetch(contentsFetch, resolution)
        if (contentsFetch.body != "") { contentsFetch.bodyHash = ckbReleaseEvidenceHash(contentsFetch.body) }
        ckbAppendReleaseControlEvidence(result, source, "content_contents", contentsRequest, contentsFetch, resolution, 0, 1)
        if (contentsFetch.truncated || contentsFetch.status == "source_too_large") {
            ckbReleaseInventoryLimitFailure(result, inventory, source, "bytes")
            return false
        }
        contentRequest = contentsRequest
        contentFetch = contentsFetch
        method = "contents"
    }
    if (!contentFetch.ok) {
        let status = ckbReleaseAcquisitionFailureStatus(contentFetch.status)
        ckbReleaseInventoryFailure(inventory, status)
        ckbReleaseFailFetchResult(result, status, source, "content_fetch_failed")
        return false
    }
    let nextBytes = inventory.contentBytes + contentFetch.body.size
    if (nextBytes > source.maxBytes) {
        ckbReleaseInventoryLimitFailure(result, inventory, source, "bytes")
        return false
    }
    contentFetch.bodyHash = ckbReleaseEvidenceHash(contentFetch.body)
    let artifact = ckbWriteReleaseContentArtifact(store, runKey, CkbReleaseArtifactKinds.CONTENT, contentFetch.body, logicalPath: path, method: method, contentType: contentFetch.contentType, fetch: contentFetch, priorFetchEvidencePayload: priorFetchEvidencePayload)
    inventory.contentBytes = nextBytes
    ckbAppendReleaseContentRecord(profile, result, source, contentRequest, contentFetch)
    _ = ckbReleaseInventoryCompletePath(inventory, path)
    addUniqueString(checkpoint.contentArtifactPaths, artifact.relativePath)
    addUniqueString(checkpoint.artifactEvidenceHashes, artifact.evidenceHash)
    addUniqueString(checkpoint.completedPaths, path)
    checkpoint.currentPathHash = ""
    ckbSaveReleaseResumeCheckpoint(store, runKey, checkpoint)
    true
}
private class CkbReleaseSourceCompleteDescriptor {
    var valid: Bool = false
    var resolvedCommit: String = ""
    var pagesScanned: Int64 = 0
    var nonEmptyPages: Int64 = 0
    var objectsSeen: Int64 = 0
    var filesSeen: Int64 = 0
    var contentBytes: Int64 = 0
    var plannedPaths: ArrayList<String> = ArrayList<String>()
    var completedPaths: ArrayList<String> = ArrayList<String>()

    init() {}
}

private func ckbStartReleaseAcquisitionForResolution(store: FileKnowledgeStore,
    planningKey: CkbScheduledFetchRunKey, resolution: GitCodeRefResolution,
    sourceOrdinal: Int64): Unit {
    let resolvedKey = ckbReleaseRunKeyWithCommit(planningKey,
        resolution.resolvedCommit)
    let refArtifact = ckbWriteReleaseContentArtifact(store, resolvedKey,
        CkbReleaseArtifactKinds.REF,
        ckbReleaseRefResolutionPayload(resolution))
    ckbMarkReleaseAcquisitionState(store, resolvedKey, "active")
    let initial = CkbReleaseResumeCheckpoint()
    initial.phase = "ref"
    initial.sourceOrdinal = sourceOrdinal
    initial.refArtifactPath = refArtifact.relativePath
    initial.artifactEvidenceHashes.add(refArtifact.evidenceHash)
    ckbSaveReleaseResumeCheckpoint(store, resolvedKey, initial)
}

private func ckbReleaseRefResolutionPayload(resolution: GitCodeRefResolution): String {
    "{\"status\":\"${ckbScheduledFetchJsonEscape(resolution.status)}\",\"repo\":\"${ckbScheduledFetchJsonEscape(resolution.repo)}\",\"sourceSet\":\"${ckbScheduledFetchJsonEscape(resolution.sourceSet)}\",\"sourceFamily\":\"${ckbScheduledFetchJsonEscape(resolution.sourceFamily)}\",\"originalRef\":\"${ckbScheduledFetchJsonEscape(resolution.originalRef)}\",\"effectiveRef\":\"${ckbScheduledFetchJsonEscape(resolution.effectiveRef)}\",\"resolvedCommit\":\"${ckbScheduledFetchJsonEscape(resolution.resolvedCommit)}\",\"refKind\":\"${ckbScheduledFetchJsonEscape(resolution.refKind)}\",\"evidenceBodyHash\":\"${resolution.evidenceBodyHash}\",\"evidenceAttempts\":${resolution.evidenceAttempts}}"
}

private func ckbLoadReleaseRefResolution(store: FileKnowledgeStore,
    planningKey: CkbScheduledFetchRunKey,
    allowConsumed!: Bool = false): GitCodeRefResolution {
    let resolution = GitCodeRefResolution()
    resolution.status = "not_found"
    let state = ckbLoadReleaseAcquisitionState(store, planningKey)
    let stateAllowsRead = state.status == "not_found" ||
        (state.valid && state.state == "active") ||
        (allowConsumed && state.valid && state.state == "consumed")
    if (!stateAllowsRead) {
        return resolution
    }
    let artifact = ckbLoadReleaseContentArtifact(store, planningKey, CkbReleaseArtifactKinds.REF)
    if (!artifact.valid) {
        resolution.status = artifact.status
        return resolution
    }
    let object = try { JsonValue.fromStr(artifact.payload).asObject() } catch (_: Exception) {
        resolution.status = "malformed_json"
        return resolution
    }
    resolution.status = ckbReleaseResumeJsonString(object, "status")
    resolution.repo = ckbReleaseResumeJsonString(object, "repo")
    resolution.sourceSet = ckbReleaseResumeJsonString(object, "sourceSet")
    resolution.sourceFamily = ckbReleaseResumeJsonString(object, "sourceFamily")
    resolution.originalRef = ckbReleaseResumeJsonString(object, "originalRef")
    resolution.effectiveRef = ckbReleaseResumeJsonString(object, "effectiveRef")
    resolution.resolvedCommit = ckbReleaseResumeJsonString(object, "resolvedCommit")
    resolution.refKind = ckbReleaseResumeJsonString(object, "refKind")
    resolution.evidenceBodyHash = ckbReleaseResumeJsonString(object, "evidenceBodyHash")
    resolution.evidenceAttempts = ckbReleaseResumeJsonInt(object, "evidenceAttempts", 0)
    let refIdentityValid = if (resolution.refKind == "local") {
        resolution.resolvedCommit != "" && resolution.evidenceBodyHash == resolution.resolvedCommit
    } else {
        ckbGitCodeLooksLikeCommit(resolution.resolvedCommit)
    }
    resolution.ok = resolution.status == "ok" && resolution.resolvedCommit == artifact.resolvedCommit &&
        refIdentityValid && resolution.originalRef == planningKey.originalRef
    if (!resolution.ok && resolution.status == "ok") {
        resolution.status = "artifact_identity_mismatch"
    }
    resolution
}

private func ckbReleaseHydratedFetch(request: SourceFetchRequest, resolution: GitCodeRefResolution, artifact: CkbScheduledContentArtifact): SourceFetchResult {
    let fetch = SourceFetchResult()
    if (!ckbHydrateReleaseFetchEvidence(artifact.fetchEvidencePayload, fetch)) {
        fetch.status = "malformed_json"
        return fetch
    }
    fetch.body = artifact.payload
    fetch.bodyHash = artifact.payloadHash
    fetch
}

private func ckbAppendReleasePriorContentEvidence(result: CkbScheduledProfileFetchResult, source: CkbReleaseSourcePlan, builder: SourceRequestBuilder, resolution: GitCodeRefResolution, path: String, artifact: CkbScheduledContentArtifact): Bool {
    if (artifact.priorFetchEvidencePayload == "") { return true }
    let prior = SourceFetchResult()
    if (!ckbHydrateReleaseFetchEvidence(artifact.priorFetchEvidencePayload, prior)) { return false }
    let request = builder.gitCodeReleaseSourceRawWithFetchRef(source.source.sourceRepo, source.originalRef, resolution.effectiveRef, path)
    ckbAppendReleaseControlEvidence(result, source, "content_raw", request, prior, resolution, 0, 1)
    true
}

private func ckbReleaseSourceCompletePayload(inventory: CkbReleaseSourceInventory): String {
    "{\"resolvedCommit\":\"${ckbScheduledFetchJsonEscape(inventory.resolvedCommit)}\",\"pagesScanned\":${inventory.pagesScanned},\"nonEmptyPages\":${inventory.nonEmptyPages},\"objectsSeen\":${inventory.objectsSeen},\"filesSeen\":${inventory.filesSeen},\"contentBytes\":${inventory.contentBytes},\"plannedPaths\":${ckbScheduledFetchPathsJson(inventory.plannedPaths)},\"completedPaths\":${ckbScheduledFetchPathsJson(inventory.completedPaths)}}"
}

private func ckbParseReleaseSourceComplete(payload: String): CkbReleaseSourceCompleteDescriptor {
    let descriptor = CkbReleaseSourceCompleteDescriptor()
    let object = try { JsonValue.fromStr(payload).asObject() } catch (_: Exception) { return descriptor }
    descriptor.resolvedCommit = ckbReleaseResumeJsonString(object, "resolvedCommit")
    descriptor.pagesScanned = ckbReleaseResumeJsonInt(object, "pagesScanned", -1)
    descriptor.nonEmptyPages = ckbReleaseResumeJsonInt(object, "nonEmptyPages", -1)
    descriptor.objectsSeen = ckbReleaseResumeJsonInt(object, "objectsSeen", -1)
    descriptor.filesSeen = ckbReleaseResumeJsonInt(object, "filesSeen", -1)
    descriptor.contentBytes = ckbReleaseResumeJsonInt(object, "contentBytes", -1)
    if (!ckbReleaseResumeJsonArray(object, "plannedPaths", descriptor.plannedPaths) ||
        !ckbReleaseResumeJsonArray(object, "completedPaths", descriptor.completedPaths)) {
        return descriptor
    }
    descriptor.valid = descriptor.resolvedCommit != "" && descriptor.pagesScanned >= 0 &&
        descriptor.nonEmptyPages >= 0 && descriptor.objectsSeen >= 0 && descriptor.filesSeen >= 0 &&
        descriptor.contentBytes >= 0 && descriptor.plannedPaths.size > 0 &&
        ckbReleaseResumeSameStringSet(descriptor.plannedPaths, descriptor.completedPaths)
    descriptor
}

private func ckbHydrateCompletedReleaseRemoteSource(builder: SourceRequestBuilder, source: CkbReleaseSourcePlan, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, inventory: CkbReleaseSourceInventory, store: FileKnowledgeStore, planningKey: CkbScheduledFetchRunKey, sourceOrdinal: Int64, verifiedResolution!: GitCodeRefResolution = GitCodeRefResolution()): Bool {
    let completeArtifact = ckbLoadReleaseContentArtifact(store, planningKey, CkbReleaseArtifactKinds.SOURCE_COMPLETE)
    if (!completeArtifact.valid) {
        if (completeArtifact.status != "not_found") {
            result.diagnostics.add("release_source_complete_artifact_rejected:sourceSet=${source.sourceSet}|status=${completeArtifact.status}")
        }
        return false
    }
    let runKey = ckbReleaseRunKeyWithCommit(planningKey, completeArtifact.resolvedCommit)
    let checkpoint = ckbLoadReleaseResumeCheckpoint(store, runKey)
    if (!checkpoint.valid || checkpoint.phase != "completed" ||
        (!verifiedResolution.ok && checkpoint.sourceOrdinal != sourceOrdinal) ||
        checkpoint.sourceCompleteArtifactPath != completeArtifact.relativePath ||
        !checkpoint.artifactEvidenceHashes.contains(completeArtifact.evidenceHash)) {
        result.diagnostics.add("release_completed_checkpoint_rejected:sourceSet=${source.sourceSet}|status=${checkpoint.status}|phase=${checkpoint.phase}")
        return false
    }
    let descriptor = ckbParseReleaseSourceComplete(completeArtifact.payload)
    if (!descriptor.valid || descriptor.resolvedCommit != runKey.resolvedCommit ||
        !ckbReleaseResumeSameStringSet(descriptor.plannedPaths, checkpoint.plannedPaths) ||
        !ckbReleaseResumeSameStringSet(descriptor.completedPaths, checkpoint.completedPaths)) {
        result.diagnostics.add("release_source_complete_descriptor_rejected:sourceSet=${source.sourceSet}")
        return false
    }
    let resolution = if (verifiedResolution.ok) { verifiedResolution } else {
        ckbLoadReleaseRefResolution(store, planningKey)
    }
    if (!resolution.ok || resolution.resolvedCommit != runKey.resolvedCommit) {
        result.diagnostics.add("release_ref_artifact_rejected_for_completed:sourceSet=${source.sourceSet}|status=${resolution.status}")
        return false
    }

    let hydratedResult = CkbScheduledProfileFetchResult()
    let hydratedInventory = ckbReleaseInventoryForSource(source)
    hydratedInventory.resolvedCommit = resolution.resolvedCommit
    ckbAppendReleaseRefEvidence(hydratedResult, source, resolution)
    var page: Int64 = 1
    while (page <= descriptor.pagesScanned) {
        let artifact = ckbLoadReleaseContentArtifact(store, runKey, CkbReleaseArtifactKinds.TREE_PAGE, ordinal: page)
        if (!artifact.valid || !checkpoint.pageArtifactPaths.contains(artifact.relativePath) ||
            !checkpoint.artifactEvidenceHashes.contains(artifact.evidenceHash)) {
            result.diagnostics.add("release_completed_page_artifact_rejected:sourceSet=${source.sourceSet}|page=${page}|status=${artifact.status}")
            return false
        }
        let request = builder.gitCodeTreePageWithFetchRef(source.source.sourceRepo, source.originalRef, resolution.effectiveRef, page: page, perPage: 100)
        let fetch = ckbReleaseHydratedFetch(request, resolution, artifact)
        let parsed = ckbReleaseParseTreePage(source.sourceSet, fetch.body)
        if (!parsed.ok) {
            result.diagnostics.add("release_completed_page_parse_rejected:sourceSet=${source.sourceSet}|page=${page}|status=${parsed.status}")
            return false
        }
        hydratedInventory.pagesScanned += 1
        ckbAppendReleaseControlEvidence(hydratedResult, source, "tree_page", request, fetch, resolution, parsed.objectsSeen, parsed.filesSeen,
            directoryCount: parsed.directoriesSeen,
            candidateCount: parsed.eligiblePaths.size,
            stopReason: if (parsed.explicitEnd) { "explicit_end" } else { "continue" })
        if (parsed.explicitEnd) {
            hydratedInventory.explicitEnd = true
            if (page != descriptor.pagesScanned) { return false }
        } else {
            hydratedInventory.nonEmptyPages += 1
            hydratedInventory.objectsSeen += parsed.objectsSeen
            hydratedInventory.filesSeen += parsed.filesSeen
            for (path in parsed.eligiblePaths) { _ = ckbReleaseInventoryPlanPath(hydratedInventory, path) }
        }
        page += 1
    }
    ckbReleaseInventorySortPaths(hydratedInventory)
    if (!hydratedInventory.explicitEnd || !ckbReleaseResumeSameStringSet(hydratedInventory.plannedPaths, descriptor.plannedPaths) ||
        hydratedInventory.nonEmptyPages != descriptor.nonEmptyPages || hydratedInventory.objectsSeen != descriptor.objectsSeen ||
        hydratedInventory.filesSeen != descriptor.filesSeen) {
        result.diagnostics.add("release_completed_inventory_rejected:sourceSet=${source.sourceSet}")
        return false
    }
    for (path in descriptor.plannedPaths) {
        let artifact = ckbLoadReleaseContentArtifact(store, runKey, CkbReleaseArtifactKinds.CONTENT, logicalPath: path)
        if (!artifact.valid || !checkpoint.contentArtifactPaths.contains(artifact.relativePath) ||
            !checkpoint.artifactEvidenceHashes.contains(artifact.evidenceHash)) {
            result.diagnostics.add("release_completed_content_artifact_rejected:sourceSet=${source.sourceSet}|pathHash=${ckbReleaseEvidenceHash(path)}|status=${artifact.status}")
            return false
        }
        if (!ckbAppendReleasePriorContentEvidence(hydratedResult, source, builder, resolution, path, artifact)) {
            result.diagnostics.add("release_completed_prior_content_evidence_rejected:sourceSet=${source.sourceSet}|pathHash=${ckbReleaseEvidenceHash(path)}")
            return false
        }
        let request = if (artifact.method == "contents") {
            builder.gitCodeReleaseSourceContentsWithFetchRef(source.source.sourceRepo, source.originalRef, resolution.effectiveRef, path)
        } else {
            builder.gitCodeReleaseSourceRawWithFetchRef(source.source.sourceRepo, source.originalRef, resolution.effectiveRef, path)
        }
        let fetch = ckbReleaseHydratedFetch(request, resolution, artifact)
        hydratedInventory.contentBytes += fetch.body.size
        ckbAppendReleaseControlEvidence(hydratedResult, source, "content_${artifact.method}", request, fetch, resolution, 0, 1)
        ckbAppendReleaseContentRecord(profile, hydratedResult, source, request, fetch)
        _ = ckbReleaseInventoryCompletePath(hydratedInventory, path)
    }
    ckbReleaseInventorySortPaths(hydratedInventory)
    if (hydratedInventory.contentBytes != descriptor.contentBytes ||
        !ckbReleaseResumeSameStringSet(hydratedInventory.completedPaths, descriptor.completedPaths)) {
        result.diagnostics.add("release_completed_content_evidence_rejected:sourceSet=${source.sourceSet}")
        return false
    }
    hydratedInventory.complete = true
    hydratedInventory.status = CkbReleaseAcquisitionStatus.OK
    ckbCopyReleaseInventory(inventory, hydratedInventory)
    for (record in hydratedResult.records) { result.records.add(record) }
    for (record in hydratedResult.contentRecords) { result.contentRecords.add(record) }
    for (evidence in hydratedResult.controlEvidence) { result.controlEvidence.add(evidence) }
    for (diagnostic in hydratedResult.diagnostics) { result.diagnostics.add(diagnostic) }
    for (request in hydratedResult.successfulRequests) { result.successfulRequests.add(request) }
    result.fetchedCount += hydratedResult.fetchedCount
    result.releaseAcquisitionKeys.add(runKey)
    result.diagnostics.add("release_source_completed_hydrated:sourceSet=${source.sourceSet}|records=${hydratedResult.contentRecords.size}|networkAttempts=0|planHash=${runKey.planEvidenceHash}")
    true
}

private func ckbCopyReleaseInventory(target: CkbReleaseSourceInventory, source: CkbReleaseSourceInventory): Unit {
    target.resolvedCommit = source.resolvedCommit
    target.status = source.status
    target.complete = source.complete
    target.explicitEnd = source.explicitEnd
    target.pagesScanned = source.pagesScanned
    target.nonEmptyPages = source.nonEmptyPages
    target.objectsSeen = source.objectsSeen
    target.filesSeen = source.filesSeen
    target.contentBytes = source.contentBytes
    for (path in source.plannedPaths) { _ = ckbReleaseInventoryPlanPath(target, path) }
    for (path in source.completedPaths) { _ = ckbReleaseInventoryCompletePath(target, path) }
    ckbReleaseInventorySortPaths(target)
}

private func ckbReleaseResumeSameStringSet(left: ArrayList<String>, right: ArrayList<String>): Bool {
    if (left.size != right.size) { return false }
    let values = HashSet<String>()
    for (item in left) { values.add(item) }
    if (values.size != left.size) { return false }
    for (item in right) { if (!values.contains(item)) { return false } }
    true
}

private func ckbReleaseResumeJsonString(object: JsonObject, key: String): String {
    match (object.get(key)) {
        case Some(value) => try { value.asString().getValue() } catch (_: Exception) { "" }
        case None => ""
    }
}

private func ckbReleaseResumeJsonInt(object: JsonObject, key: String, fallback: Int64): Int64 {
    match (object.get(key)) {
        case Some(value) => try { value.asInt().getValue() } catch (_: Exception) { fallback }
        case None => fallback
    }
}

private func ckbReleaseResumeJsonArray(object: JsonObject, key: String, out: ArrayList<String>): Bool {
    try {
        let items = match (object.get(key)) {
            case Some(value) => value.asArray().getItems()
            case None => return false
        }
        for (item in items) { out.add(item.asString().getValue()) }
        true
    } catch (_: Exception) {
        false
    }
}

private func ckbFetchReleaseEvalSupportSource(source: CkbReleaseSourcePlan, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, inventory: CkbReleaseSourceInventory, config: CkbRuntimeConfig, store: FileKnowledgeStore, sourceOrdinal!: Int64 = 0): Unit {
    let planningKey = ckbReleaseScheduledFetchRunKey(profile, source, result.releasePlan.planHash)
    let staleTempsRemoved = store.cleanupReleaseAcquisitionStaleTemps(planningKey.acquisitionId)
    if (staleTempsRemoved > 0) { result.diagnostics.add("release_acquisition_stale_temps_removed:sourceSet=${source.sourceSet}|count=${staleTempsRemoved}") }
    let acquisitionState = ckbLoadReleaseAcquisitionState(store, planningKey)
    let reuseExisting = acquisitionState.status == "not_found" || (acquisitionState.valid && acquisitionState.state == "active")
    let verifyConsumed = acquisitionState.valid && acquisitionState.state == "consumed"
    if (reuseExisting && ckbHydrateCompletedReleaseEvalSupportSource(source, profile, result, inventory, config, store, planningKey, sourceOrdinal)) {
        return
    }
    if (reuseExisting && ckbResumePartialReleaseEvalSupportSource(source, profile, result, inventory, config, store, planningKey, sourceOrdinal)) {
        return
    }
    if (verifyConsumed) {
        let consumedResolution = ckbLoadReleaseRefResolution(store,
            planningKey, allowConsumed: true)
        let currentEvidence = ckbCurrentReleaseEvalSupportEvidence(source,
            config, store)
        if (consumedResolution.ok && consumedResolution.refKind == "local" &&
            currentEvidence != "" &&
            currentEvidence == consumedResolution.resolvedCommit &&
            ckbHydrateCompletedReleaseEvalSupportSource(source, profile,
                result, inventory, config, store, planningKey, sourceOrdinal,
                allowConsumed: true)) {
            result.diagnostics.add("release_eval_consumed_evidence_verified:sourceSet=${source.sourceSet}|evidence=${ckbReleaseEvidenceHash(currentEvidence)}")
            return
        }
        result.diagnostics.add("release_eval_consumed_acquisition_restarted:sourceSet=${source.sourceSet}|evidenceChanged=${currentEvidence == "" || !consumedResolution.ok || currentEvidence != consumedResolution.resolvedCommit}")
    } else if (!reuseExisting) {
        result.diagnostics.add("release_eval_artifacts_rejected:sourceSet=${source.sourceSet}|status=${acquisitionState.status}")
    }
    let contentStart = result.contentRecords.size
    let root = ckbScheduledEvalSupportRoot(config)
    let extracted = if (root != "") {
        extractAllEvalSupportRecords(root, version: resolveCangjieVersion(cangjieVersionSelector(targetVersion: source.targetVersion, sourceSet: CangjieSourceSets.EVAL_SUPPORT), ckbRuntimeCangjieVersionManifest(config)))
    } else {
        ckbReleaseEvalSupportFromActive(store, source)
    }
    if (ckbReleaseDiagnosticsContain(extracted.diagnostics, "invalid_eval_support_encoding") || ckbReleaseDiagnosticsContain(extracted.diagnostics, "eval_support_artifact_invalid_encoding")) {
        let status = "eval_support_artifact_invalid_encoding"
        ckbReleaseInventoryFailure(inventory, status)
        ckbReleaseFailFetchResult(result, status, source, "eval_support_invalid_encoding")
        return
    }
    if (!extracted.ok || extracted.records.size == 0 || extracted.diagnostics.size > 0) {
        let status = "eval_support_source_unavailable"
        ckbReleaseInventoryFailure(inventory, status)
        ckbReleaseFailFetchResult(result, status, source, "eval_support_unavailable")
        return
    }
    for (record in extracted.records) {
        let typed = ckbReleaseCopyEvalTypedRecord(record, source)
        let logicalPath = ckbReleaseEvalLogicalPath(typed)
        if (logicalPath == "") {
            let status = CkbReleaseAcquisitionStatus.UNSAFE_PATH
            ckbReleaseInventoryFailure(inventory, status)
            ckbReleaseFailFetchResult(result, status, source, "eval_support_path_invalid")
            return
        }
        _ = ckbReleaseInventoryPlanPath(inventory, logicalPath)
        inventory.objectsSeen += 1
        inventory.filesSeen += 1
        let nextBytes = inventory.contentBytes + typed.content.size
        if (inventory.objectsSeen > source.maxObjects) {
            ckbReleaseInventoryLimitFailure(result, inventory, source, "objects")
            return
        }
        if (inventory.filesSeen > source.maxFiles) {
            ckbReleaseInventoryLimitFailure(result, inventory, source, "files")
            return
        }
        if (nextBytes > source.maxBytes) {
            ckbReleaseInventoryLimitFailure(result, inventory, source, "bytes")
            return
        }
        inventory.contentBytes = nextBytes
        let request = ckbScheduledEvalSupportLocalRequest(source.source, config)
        request.path = logicalPath
        request.sourceVariant = if (root == "") { "active_snapshot" } else { "local" }
        let fetch = SourceFetchResult()
        fetch.ok = true
        fetch.status = if (root == "") { "active_existing" } else { "local_existing" }
        fetch.statusCode = 200
        fetch.sourceUrl = typed.citation
        fetch.repo = "ckb-local://eval-support"
        fetch.ref = source.originalRef
        fetch.path = logicalPath
        fetch.normalizedType = request.kind
        fetch.contentType = "text/plain"
        fetch.body = typed.content
        fetch.bytes = typed.content.size
        fetch.bodyHash = ckbReleaseEvidenceHash(typed.content)
        fetch.commit = if (typed.resolvedCommit != "") { typed.resolvedCommit } else { fetch.bodyHash }
        typed.resolvedCommit = fetch.commit
        let scheduled = ckbAppendReleaseContentRecord(profile, result, source, request, fetch)
        scheduled.preparedTypedRecords.add(typed)
        _ = ckbReleaseInventoryCompletePath(inventory, logicalPath)
        ckbAppendReleaseControlEvidence(result, source, "eval_support_selection", request, fetch, GitCodeRefResolution(), 1, 1)
    }
    inventory.explicitEnd = true
    inventory.complete = true
    inventory.status = CkbReleaseAcquisitionStatus.OK
    inventory.resolvedCommit = ckbReleaseEvalInventoryCommit(extracted.records)
    let runKey = ckbReleaseRunKeyWithCommit(planningKey, inventory.resolvedCommit)
    let resolution = GitCodeRefResolution()
    resolution.ok = true
    resolution.status = "ok"
    resolution.repo = source.normalizedRepo
    resolution.sourceSet = source.sourceSet
    resolution.sourceFamily = source.sourceFamily
    resolution.originalRef = source.originalRef
    resolution.effectiveRef = inventory.resolvedCommit
    resolution.resolvedCommit = inventory.resolvedCommit
    resolution.refKind = "local"
    resolution.evidenceBodyHash = inventory.resolvedCommit
    let refArtifact = ckbWriteReleaseContentArtifact(store, runKey, CkbReleaseArtifactKinds.REF, ckbReleaseRefResolutionPayload(resolution))
    let checkpoint = CkbReleaseResumeCheckpoint()
    checkpoint.phase = "content"
    checkpoint.sourceOrdinal = sourceOrdinal
    checkpoint.refArtifactPath = refArtifact.relativePath
    checkpoint.artifactEvidenceHashes.add(refArtifact.evidenceHash)
    checkpoint.plannedPaths.add(all: inventory.plannedPaths)
    checkpoint.completedPaths.clear()
    ckbMarkReleaseAcquisitionState(store, runKey, "active")
    ckbSaveReleaseResumeCheckpoint(store, runKey, checkpoint)
    for (index in contentStart..result.contentRecords.size) {
        let record = result.contentRecords[index]
        if (record.preparedTypedRecords.size != 1) {
            ckbReleaseInventoryFailure(inventory, "eval_support_typed_artifact_mismatch")
            ckbReleaseFailFetchResult(result, "eval_support_typed_artifact_mismatch", source, "eval_support_typed_artifact_mismatch")
            return
        }
        let artifact = ckbWriteReleaseContentArtifact(store, runKey, CkbReleaseArtifactKinds.CONTENT, ckbReleaseEvalTypedArtifactPayload(record.preparedTypedRecords[0]), logicalPath: record.request.path, method: "local_typed", contentType: "application/json")
        checkpoint.contentArtifactPaths.add(artifact.relativePath)
        checkpoint.artifactEvidenceHashes.add(artifact.evidenceHash)
        addUniqueString(checkpoint.completedPaths, record.request.path)
        checkpoint.currentPathHash = ""
        ckbSaveReleaseResumeCheckpoint(store, runKey, checkpoint)
    }
    let completeArtifact = ckbWriteReleaseContentArtifact(store, runKey, CkbReleaseArtifactKinds.SOURCE_COMPLETE, ckbReleaseSourceCompletePayload(inventory))
    checkpoint.phase = "completed"
    checkpoint.sourceCompleteArtifactPath = completeArtifact.relativePath
    checkpoint.artifactEvidenceHashes.add(completeArtifact.evidenceHash)
    ckbSaveReleaseResumeCheckpoint(store, runKey, checkpoint)
    result.releaseAcquisitionKeys.add(runKey)
}

private func ckbCurrentReleaseEvalSupportEvidence(source: CkbReleaseSourcePlan,
    config: CkbRuntimeConfig, store: FileKnowledgeStore): String {
    let root = ckbScheduledEvalSupportRoot(config)
    let extracted = if (root != "") {
        extractAllEvalSupportRecords(root,
            version: resolveCangjieVersion(cangjieVersionSelector(
                targetVersion: source.targetVersion,
                sourceSet: CangjieSourceSets.EVAL_SUPPORT),
                ckbRuntimeCangjieVersionManifest(config)))
    } else {
        ckbReleaseEvalSupportFromActive(store, source)
    }
    if (!extracted.ok || extracted.records.size == 0 ||
        extracted.diagnostics.size > 0) {
        return ""
    }
    let records = ArrayList<CangjieTypedRecord>()
    for (record in extracted.records) {
        let copied = ckbReleaseCopyEvalTypedRecord(record, source)
        if (ckbReleaseEvalLogicalPath(copied) == "" ||
            copied.content == "") {
            return ""
        }
        records.add(copied)
    }
    ckbReleaseEvalInventoryCommit(records)
}

private func ckbHydrateCompletedReleaseEvalSupportSource(source: CkbReleaseSourcePlan, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, inventory: CkbReleaseSourceInventory, config: CkbRuntimeConfig, store: FileKnowledgeStore, planningKey: CkbScheduledFetchRunKey, sourceOrdinal: Int64, allowConsumed!: Bool = false): Bool {
    let completeArtifact = ckbLoadReleaseContentArtifact(store, planningKey, CkbReleaseArtifactKinds.SOURCE_COMPLETE)
    if (!completeArtifact.valid) { return false }
    let runKey = ckbReleaseRunKeyWithCommit(planningKey, completeArtifact.resolvedCommit)
    let checkpoint = ckbLoadReleaseResumeCheckpoint(store, runKey)
    let descriptor = ckbParseReleaseSourceComplete(completeArtifact.payload)
    if (!checkpoint.valid || checkpoint.phase != "completed" ||
        (!allowConsumed && checkpoint.sourceOrdinal != sourceOrdinal) ||
        checkpoint.sourceCompleteArtifactPath != completeArtifact.relativePath || !checkpoint.artifactEvidenceHashes.contains(completeArtifact.evidenceHash) ||
        !descriptor.valid || descriptor.resolvedCommit != runKey.resolvedCommit || descriptor.pagesScanned != 0 ||
        !ckbReleaseResumeSameStringSet(descriptor.plannedPaths, checkpoint.plannedPaths) ||
        !ckbReleaseResumeSameStringSet(descriptor.completedPaths, checkpoint.completedPaths)) {
        result.diagnostics.add("release_eval_completed_checkpoint_rejected:sourceSet=${source.sourceSet}|status=${checkpoint.status}")
        return false
    }
    let resolution = ckbLoadReleaseRefResolution(store, planningKey,
        allowConsumed: allowConsumed)
    if (!resolution.ok || resolution.refKind != "local" || resolution.resolvedCommit != runKey.resolvedCommit) { return false }
    let hydrated = CkbScheduledProfileFetchResult()
    let hydratedInventory = ckbReleaseInventoryForSource(source)
    hydratedInventory.resolvedCommit = descriptor.resolvedCommit
    hydratedInventory.explicitEnd = true
    hydratedInventory.pagesScanned = 0
    hydratedInventory.nonEmptyPages = descriptor.nonEmptyPages
    hydratedInventory.objectsSeen = descriptor.objectsSeen
    hydratedInventory.filesSeen = descriptor.filesSeen
    for (path in descriptor.plannedPaths) {
        let artifact = ckbLoadReleaseContentArtifact(store, runKey, CkbReleaseArtifactKinds.CONTENT, logicalPath: path)
        if (!artifact.valid || artifact.method != "local_typed" || !checkpoint.contentArtifactPaths.contains(artifact.relativePath) || !checkpoint.artifactEvidenceHashes.contains(artifact.evidenceHash)) {
            result.diagnostics.add("release_eval_content_artifact_rejected:sourceSet=${source.sourceSet}|pathHash=${ckbReleaseEvidenceHash(path)}|status=${artifact.status}")
            return false
        }
        let typed = ckbParseReleaseEvalTypedArtifact(artifact.payload)
        if (typed.recordKind != CangjieTypedRecordKinds.EVAL_SUPPORT || typed.sourceSet != CangjieSourceSets.EVAL_SUPPORT ||
            typed.targetVersion != source.targetVersion || typed.sourceRef != source.originalRef ||
            ckbReleaseEvalLogicalPath(typed) != path || typed.contentHash != ckbReleaseEvidenceHash(typed.content)) {
            result.diagnostics.add("release_eval_typed_artifact_rejected:sourceSet=${source.sourceSet}|pathHash=${ckbReleaseEvidenceHash(path)}")
            return false
        }
        let request = ckbScheduledEvalSupportLocalRequest(source.source, config)
        request.path = path
        request.sourceVariant = if (ckbScheduledEvalSupportRoot(config) == "") { "active_snapshot" } else { "local" }
        let fetch = SourceFetchResult()
        fetch.ok = true
        fetch.status = "artifact_hydrated"
        fetch.statusCode = 200
        fetch.sourceUrl = typed.citation
        fetch.repo = "ckb-local://eval-support"
        fetch.ref = source.originalRef
        fetch.path = path
        fetch.normalizedType = request.kind
        fetch.contentType = "text/plain"
        fetch.body = typed.content
        fetch.bytes = typed.content.size
        fetch.bodyHash = ckbReleaseEvidenceHash(typed.content)
        fetch.commit = typed.resolvedCommit
        let scheduled = ckbAppendReleaseContentRecord(profile, hydrated, source, request, fetch)
        scheduled.preparedTypedRecords.add(typed)
        _ = ckbReleaseInventoryPlanPath(hydratedInventory, path)
        _ = ckbReleaseInventoryCompletePath(hydratedInventory, path)
        hydratedInventory.contentBytes += typed.content.size
        ckbAppendReleaseControlEvidence(hydrated, source, "eval_support_selection", request, fetch, resolution, 1, 1)
    }
    ckbReleaseInventorySortPaths(hydratedInventory)
    if (hydratedInventory.contentBytes != descriptor.contentBytes || !ckbReleaseResumeSameStringSet(hydratedInventory.completedPaths, descriptor.completedPaths)) { return false }
    hydratedInventory.complete = true
    hydratedInventory.status = CkbReleaseAcquisitionStatus.OK
    ckbCopyReleaseInventory(inventory, hydratedInventory)
    for (record in hydrated.records) { result.records.add(record) }
    for (record in hydrated.contentRecords) { result.contentRecords.add(record) }
    for (evidence in hydrated.controlEvidence) { result.controlEvidence.add(evidence) }
    for (request in hydrated.successfulRequests) { result.successfulRequests.add(request) }
    result.fetchedCount += hydrated.fetchedCount
    result.releaseAcquisitionKeys.add(runKey)
    result.diagnostics.add("release_eval_completed_hydrated:records=${hydrated.contentRecords.size}|localReads=0|planHash=${runKey.planEvidenceHash}")
    true
}

private func ckbResumePartialReleaseEvalSupportSource(source: CkbReleaseSourcePlan, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, inventory: CkbReleaseSourceInventory, config: CkbRuntimeConfig, store: FileKnowledgeStore, planningKey: CkbScheduledFetchRunKey, sourceOrdinal: Int64): Bool {
    let resolution = ckbLoadReleaseRefResolution(store, planningKey)
    if (!resolution.ok || resolution.refKind != "local") { result.diagnostics.add("release_eval_partial_rejected:reason=ref|status=${resolution.status}"); return false }
    let runKey = ckbReleaseRunKeyWithCommit(planningKey, resolution.resolvedCommit)
    let checkpoint = ckbLoadReleaseResumeCheckpoint(store, runKey)
    if (!checkpoint.valid || checkpoint.phase != "content" || checkpoint.sourceOrdinal != sourceOrdinal || checkpoint.plannedPaths.size == 0 ||
        checkpoint.completedPaths.size > checkpoint.plannedPaths.size || checkpoint.refArtifactPath != ckbReleaseArtifactRelativePath(runKey, CkbReleaseArtifactKinds.REF)) { result.diagnostics.add("release_eval_partial_rejected:reason=checkpoint|status=${checkpoint.status}|phase=${checkpoint.phase}"); return false }
    let root = ckbScheduledEvalSupportRoot(config)
    let fallback = if (root == "") { ckbReleaseEvalSupportFromActive(store, source) } else { CangjieTypedRecordResult() }
    if (root == "" && (!fallback.ok || fallback.records.size == 0)) { result.diagnostics.add("release_eval_partial_rejected:reason=fallback"); return false }
    let version = resolveCangjieVersion(cangjieVersionSelector(targetVersion: source.targetVersion, sourceSet: CangjieSourceSets.EVAL_SUPPORT), ckbRuntimeCangjieVersionManifest(config))
    let resumedResult = CkbScheduledProfileFetchResult()
    let resumedInventory = ckbReleaseInventoryForSource(source)
    resumedInventory.resolvedCommit = resolution.resolvedCommit
    resumedInventory.explicitEnd = true
    let allTyped = ArrayList<CangjieTypedRecord>()
    var hydratedCount: Int64 = 0
    var localReadCount: Int64 = 0
    ckbAppendReleaseRefEvidence(resumedResult, source, resolution)
    for (path in checkpoint.plannedPaths) {
        var typed = CangjieTypedRecord()
        let alreadyCommitted = checkpoint.completedPaths.contains(path)
        if (alreadyCommitted) {
            let artifact = ckbLoadReleaseContentArtifact(store, runKey, CkbReleaseArtifactKinds.CONTENT, logicalPath: path)
            if (!artifact.valid || artifact.method != "local_typed" || !checkpoint.contentArtifactPaths.contains(artifact.relativePath) || !checkpoint.artifactEvidenceHashes.contains(artifact.evidenceHash)) { result.diagnostics.add("release_eval_partial_rejected:reason=artifact|pathHash=${ckbReleaseEvidenceHash(path)}|status=${artifact.status}"); return false }
            typed = ckbParseReleaseEvalTypedArtifact(artifact.payload)
            hydratedCount += 1
        } else {
            let extracted = if (root != "") { extractEvalSupportRecordAt(root, path, version: version) } else { fallback }
            var found = false
            for (record in extracted.records) {
                let candidate = ckbReleaseCopyEvalTypedRecord(record, source)
                if (ckbReleaseEvalLogicalPath(candidate) == path) { typed = candidate; found = true; break }
            }
            if (!found) { result.diagnostics.add("release_eval_partial_rejected:reason=local_read|pathHash=${ckbReleaseEvidenceHash(path)}"); return false }
            if (typed.resolvedCommit == "") { typed.resolvedCommit = ckbReleaseEvidenceHash(typed.content) }
            localReadCount += 1
        }
        if (typed.recordKind != CangjieTypedRecordKinds.EVAL_SUPPORT || typed.sourceSet != CangjieSourceSets.EVAL_SUPPORT || typed.targetVersion != source.targetVersion || typed.sourceRef != source.originalRef || ckbReleaseEvalLogicalPath(typed) != path || typed.contentHash != ckbReleaseEvidenceHash(typed.content)) { result.diagnostics.add("release_eval_partial_rejected:reason=typed_validation|pathHash=${ckbReleaseEvidenceHash(path)}"); return false }
        _ = ckbReleaseInventoryPlanPath(resumedInventory, path)
        resumedInventory.objectsSeen += 1
        resumedInventory.filesSeen += 1
        resumedInventory.contentBytes += typed.content.size
        if (resumedInventory.objectsSeen > source.maxObjects || resumedInventory.filesSeen > source.maxFiles || resumedInventory.contentBytes > source.maxBytes) { result.diagnostics.add("release_eval_partial_rejected:reason=limits"); return false }
        let request = ckbScheduledEvalSupportLocalRequest(source.source, config)
        request.path = path
        request.sourceVariant = if (root == "") { "active_snapshot" } else { "local" }
        let fetch = SourceFetchResult()
        fetch.ok = true
        fetch.status = if (alreadyCommitted) { "artifact_hydrated" } else { if (root == "") { "active_existing" } else { "local_existing" } }
        fetch.statusCode = 200
        fetch.sourceUrl = typed.citation
        fetch.repo = "ckb-local://eval-support"
        fetch.ref = source.originalRef
        fetch.path = path
        fetch.normalizedType = request.kind
        fetch.contentType = "text/plain"
        fetch.body = typed.content
        fetch.bytes = typed.content.size
        fetch.bodyHash = ckbReleaseEvidenceHash(typed.content)
        fetch.commit = typed.resolvedCommit
        let scheduled = ckbAppendReleaseContentRecord(profile, resumedResult, source, request, fetch)
        scheduled.preparedTypedRecords.add(typed)
        _ = ckbReleaseInventoryCompletePath(resumedInventory, path)
        ckbAppendReleaseControlEvidence(resumedResult, source, "eval_support_selection", request, fetch, resolution, 1, 1)
        allTyped.add(typed)
        if (!alreadyCommitted) {
            let artifact = ckbWriteReleaseContentArtifact(store, runKey, CkbReleaseArtifactKinds.CONTENT, ckbReleaseEvalTypedArtifactPayload(typed), logicalPath: path, method: "local_typed", contentType: "application/json")
            addUniqueString(checkpoint.contentArtifactPaths, artifact.relativePath)
            addUniqueString(checkpoint.artifactEvidenceHashes, artifact.evidenceHash)
            addUniqueString(checkpoint.completedPaths, path)
            checkpoint.currentPathHash = ""
            ckbSaveReleaseResumeCheckpoint(store, runKey, checkpoint)
        }
    }
    if (ckbReleaseEvalInventoryCommit(allTyped) != resolution.resolvedCommit || !ckbReleaseResumeSameStringSet(resumedInventory.completedPaths, checkpoint.plannedPaths)) { result.diagnostics.add("release_eval_partial_rejected:reason=aggregate"); return false }
    resumedInventory.complete = true
    resumedInventory.status = CkbReleaseAcquisitionStatus.OK
    let completeArtifact = ckbWriteReleaseContentArtifact(store, runKey, CkbReleaseArtifactKinds.SOURCE_COMPLETE, ckbReleaseSourceCompletePayload(resumedInventory))
    checkpoint.phase = "completed"
    checkpoint.sourceCompleteArtifactPath = completeArtifact.relativePath
    addUniqueString(checkpoint.artifactEvidenceHashes, completeArtifact.evidenceHash)
    ckbSaveReleaseResumeCheckpoint(store, runKey, checkpoint)
    ckbCopyReleaseInventory(inventory, resumedInventory)
    for (record in resumedResult.records) { result.records.add(record) }
    for (record in resumedResult.contentRecords) { result.contentRecords.add(record) }
    for (evidence in resumedResult.controlEvidence) { result.controlEvidence.add(evidence) }
    for (request in resumedResult.successfulRequests) { result.successfulRequests.add(request) }
    result.fetchedCount += resumedResult.fetchedCount
    result.releaseAcquisitionKeys.add(runKey)
    result.diagnostics.add("release_eval_partial_resumed:hydrated=${hydratedCount}|localReads=${localReadCount}|records=${resumedResult.contentRecords.size}")
    true
}

private func ckbReleaseEvalTypedArtifactPayload(record: CangjieTypedRecord): String {
    "{\"recordKind\":\"${ckbScheduledFetchJsonEscape(record.recordKind)}\",\"sourceId\":\"${ckbScheduledFetchJsonEscape(record.sourceId)}\",\"title\":\"${ckbScheduledFetchJsonEscape(record.title)}\",\"content\":\"${ckbScheduledFetchJsonEscape(record.content)}\",\"citation\":\"${ckbScheduledFetchJsonEscape(record.citation)}\",\"sourceSet\":\"${ckbScheduledFetchJsonEscape(record.sourceSet)}\",\"sourceFamily\":\"${ckbScheduledFetchJsonEscape(record.sourceFamily)}\",\"path\":\"${ckbScheduledFetchJsonEscape(record.path)}\",\"heading\":\"${ckbScheduledFetchJsonEscape(record.heading)}\",\"sectionId\":\"${ckbScheduledFetchJsonEscape(record.sectionId)}\",\"caseId\":\"${ckbScheduledFetchJsonEscape(record.caseId)}\",\"contentHash\":\"${record.contentHash}\",\"versionResolutionId\":\"${ckbScheduledFetchJsonEscape(record.versionResolutionId)}\",\"targetVersion\":\"${ckbScheduledFetchJsonEscape(record.targetVersion)}\",\"sourceRef\":\"${ckbScheduledFetchJsonEscape(record.sourceRef)}\",\"refKind\":\"${ckbScheduledFetchJsonEscape(record.refKind)}\",\"resolvedCommit\":\"${ckbScheduledFetchJsonEscape(record.resolvedCommit)}\",\"trustLevel\":\"${ckbScheduledFetchJsonEscape(record.trustLevel)}\",\"reviewState\":\"${ckbScheduledFetchJsonEscape(record.reviewState)}\"}"
}

private func ckbParseReleaseEvalTypedArtifact(payload: String): CangjieTypedRecord {
    let out = CangjieTypedRecord()
    let object = try { JsonValue.fromStr(payload).asObject() } catch (_: Exception) { return out }
    out.recordKind = ckbReleaseResumeJsonString(object, "recordKind")
    out.sourceId = ckbReleaseResumeJsonString(object, "sourceId")
    out.title = ckbReleaseResumeJsonString(object, "title")
    out.content = ckbReleaseResumeJsonString(object, "content")
    out.citation = ckbReleaseResumeJsonString(object, "citation")
    out.sourceSet = ckbReleaseResumeJsonString(object, "sourceSet")
    out.sourceFamily = ckbReleaseResumeJsonString(object, "sourceFamily")
    out.path = ckbReleaseResumeJsonString(object, "path")
    out.heading = ckbReleaseResumeJsonString(object, "heading")
    out.sectionId = ckbReleaseResumeJsonString(object, "sectionId")
    out.caseId = ckbReleaseResumeJsonString(object, "caseId")
    out.contentHash = ckbReleaseResumeJsonString(object, "contentHash")
    out.versionResolutionId = ckbReleaseResumeJsonString(object, "versionResolutionId")
    out.targetVersion = ckbReleaseResumeJsonString(object, "targetVersion")
    out.sourceRef = ckbReleaseResumeJsonString(object, "sourceRef")
    out.refKind = ckbReleaseResumeJsonString(object, "refKind")
    out.resolvedCommit = ckbReleaseResumeJsonString(object, "resolvedCommit")
    out.trustLevel = ckbReleaseResumeJsonString(object, "trustLevel")
    out.reviewState = ckbReleaseResumeJsonString(object, "reviewState")
    out
}

private func ckbReleaseEvalSupportFromActive(store: FileKnowledgeStore, source: CkbReleaseSourcePlan): CangjieTypedRecordResult {
    let result = CangjieTypedRecordResult()
    let snapshot = try {
        store.loadActiveSnapshot()
    } catch (_: Exception) {
        result.addDiagnostic("eval_support_artifact_invalid_encoding")
        return result
    }
    if (!snapshot.valid) {
        result.addDiagnostic("eval_support_active_snapshot_unavailable")
        return result
    }
    for (record in snapshot.activeIndex) {
        // Only first-initialization artifacts are a valid fallback input.
        // Prior P5 canonical records and benchmark-curated eval records are
        // outputs/other scopes and must never feed the next acquisition run.
        if (record.recordKind != CangjieTypedRecordKinds.EVAL_SUPPORT ||
            record.metadata.targetVersion != source.targetVersion ||
            !record.sourceId.startsWith("eval-support-CJ-HUMANEVAL-") ||
            record.sourceId.startsWith("p5typed|") ||
            record.metadata.sourceSet != CangjieSourceSets.EVAL_SUPPORT) {
            continue
        }
        let typed = CangjieTypedRecord()
        typed.recordKind = CangjieTypedRecordKinds.EVAL_SUPPORT
        typed.sourceId = record.sourceId
        typed.title = record.title
        typed.content = record.chunk
        typed.citation = record.citation
        typed.sourceSet = CangjieSourceSets.EVAL_SUPPORT
        typed.path = record.metadata.path
        typed.sourceFamily = ckbReleaseEvalSourceFamily(typed.path)
        typed.caseId = ckbReleaseEvalCaseId(record.citation)
        typed.contentHash = ckbReleaseEvidenceHash(record.chunk)
        typed.versionResolutionId = record.metadata.versionResolutionId
        typed.targetVersion = record.metadata.targetVersion
        typed.sourceRef = record.metadata.docVersion
        typed.refKind = "local"
        typed.resolvedCommit = record.metadata.commit
        typed.trustLevel = record.metadata.trustLevel
        typed.reviewState = record.metadata.reviewState
        if (typed.path == "" || typed.sourceFamily == "" || typed.caseId == "" || typed.content == "") {
            result.addDiagnostic("eval_support_active_record_malformed")
            return result
        }
        result.records.add(typed)
    }
    if (result.records.size == 0) {
        result.addDiagnostic("eval_support_active_target_missing")
    }
    result
}

private func ckbReleaseCopyEvalTypedRecord(record: CangjieTypedRecord, source: CkbReleaseSourcePlan): CangjieTypedRecord {
    let out = CangjieTypedRecord()
    out.recordKind = CangjieTypedRecordKinds.EVAL_SUPPORT
    out.sourceId = record.sourceId
    out.title = record.title
    out.content = record.content
    out.citation = record.citation
    out.sourceSet = CangjieSourceSets.EVAL_SUPPORT
    out.sourceFamily = record.sourceFamily
    out.path = record.path
    out.heading = record.heading
    out.sectionId = record.sectionId
    out.caseId = record.caseId
    out.contentHash = ckbReleaseEvidenceHash(record.content)
    out.versionResolutionId = record.versionResolutionId
    out.targetVersion = source.targetVersion
    out.sourceRef = source.originalRef
    out.refKind = if (record.refKind == "") { source.refKind } else { record.refKind }
    out.resolvedCommit = record.resolvedCommit
    out.trustLevel = record.trustLevel
    out.reviewState = record.reviewState
    out
}

private func ckbReleaseEvalLogicalPath(record: CangjieTypedRecord): String {
    ckbReleaseNormalizeSourcePath("${record.caseId}/${record.path}")
}

private func ckbReleaseEvalCaseId(citation: String): String {
    let parts = citation.split(":")
    if (parts.size < 2) { return "" }
    parts[0].trimAscii()
}

private func ckbReleaseEvalSourceFamily(path: String): String {
    if (path == CangjieEvalSupportPaths.PROMPT) { return "prompt" }
    if (path == CangjieEvalSupportPaths.METADATA) { return "metadata" }
    if (path == CangjieEvalSupportPaths.EVAL_SUPPORT) { return "eval_support" }
    if (path == CangjieEvalSupportPaths.VISIBLE_TESTS) { return "visible_test_helpers" }
    ""
}

private func ckbReleaseEvalInventoryCommit(records: ArrayList<CangjieTypedRecord>): String {
    let values = ArrayList<String>()
    for (record in records) {
        values.add("${ckbReleaseEvalLogicalPath(record)}:${ckbReleaseEvidenceHash(record.content)}")
    }
    let ordered = values.toArray()
    sort(ordered)
    ckbReleaseEvidenceHash(joinStrings(ArrayList<String>(ordered), "|"))
}

private func ckbAppendReleaseContentRecord(profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, source: CkbReleaseSourcePlan, request: SourceFetchRequest, fetch: SourceFetchResult): CkbScheduledSourceRecord {
    let record = CkbScheduledSourceRecord()
    record.request = request
    record.fetch = fetch
    record.releaseSource = source
    record.sourceType = SourceTypes.REPO
    record.sourceFamily = source.sourceFamily
    record.sourceSet = source.sourceSet
    record.title = "Scheduled ${profile.profile}: ${source.sourceSet}:${ckbReleaseSafePathSummary(request.path)}"
    record.sourceId = ckbReleaseCanonicalRawId(source, request.path)
    result.records.add(record)
    result.contentRecords.add(record)
    result.fetchedCount += 1
    result.successfulRequests.add("release_content_ok:sourceSet=${source.sourceSet}|repo=${source.normalizedRepo}|pathHash=${ckbReleaseEvidenceHash(request.path)}|bodyHash=${fetch.bodyHash}|bytes=${fetch.body.size}")
    record
}

private func ckbAppendReleaseRefEvidence(result: CkbScheduledProfileFetchResult, source: CkbReleaseSourcePlan, resolution: GitCodeRefResolution): Unit {
    let evidence = CkbReleaseControlEvidence()
    evidence.kind = "ref_resolution"
    evidence.requestKind = SourceKinds.GITCODE_BRANCH
    evidence.sourceIdentity = source.canonicalIdentity
    evidence.sourceSet = source.sourceSet
    evidence.repo = source.normalizedRepo
    evidence.originalRef = source.originalRef
    evidence.resolvedCommit = resolution.resolvedCommit
    evidence.status = ckbReleaseAcquisitionFailureStatus(resolution.status)
    evidence.httpStatus = if (resolution.ok) { 200 } else { 0 }
    evidence.bodyHash = if (resolution.evidenceBodyHash != "") { resolution.evidenceBodyHash } else { ckbReleaseEvidenceHash(resolution.resolvedCommit) }
    evidence.attemptCount = resolution.evidenceAttempts
    evidence.retryCount = if (resolution.evidenceAttempts > 0) {
        resolution.evidenceAttempts - 1
    } else { 0 }
    result.controlEvidence.add(evidence)
    result.diagnostics.add("release_ref_evidence:sourceSet=${source.sourceSet}|repo=${source.normalizedRepo}|status=${evidence.status}|commit=${utf8SafePrefix(resolution.resolvedCommit, 64)}|bodyHash=${evidence.bodyHash}|attempts=${evidence.attemptCount}")
}

private func ckbAppendReleaseControlEvidence(result: CkbScheduledProfileFetchResult, source: CkbReleaseSourcePlan, kind: String, request: SourceFetchRequest, fetch: SourceFetchResult, resolution: GitCodeRefResolution, objectCount: Int64, fileCount: Int64, directoryCount!: Int64 = 0, candidateCount!: Int64 = 0, stopReason!: String = ""): Unit {
    let evidence = CkbReleaseControlEvidence()
    evidence.kind = kind
    evidence.requestKind = request.kind
    evidence.sourceIdentity = source.canonicalIdentity
    evidence.sourceSet = source.sourceSet
    evidence.repo = source.normalizedRepo
    evidence.originalRef = source.originalRef
    evidence.resolvedCommit = if (resolution.resolvedCommit != "") { resolution.resolvedCommit } else { fetch.commit }
    evidence.path = request.path
    evidence.page = request.page
    evidence.status = ckbReleaseAcquisitionFailureStatus(fetch.status)
    evidence.httpStatus = fetch.statusCode
    evidence.bodyHash = fetch.bodyHash
    evidence.attemptCount = fetch.attempts
    evidence.retryCount = if (fetch.attempts > 0) { fetch.attempts - 1 } else { 0 }
    evidence.objectCount = objectCount
    evidence.fileCount = fileCount
    evidence.directoryCount = directoryCount
    evidence.candidateCount = candidateCount
    evidence.stopReason = stopReason
    result.controlEvidence.add(evidence)
    let safePath = ckbReleaseSafePathSummary(request.path)
    let safeUrl = ckbReleaseSafeUrlSummary(request.url)
    result.diagnostics.add("release_control_evidence:kind=${kind}|sourceSet=${source.sourceSet}|repo=${source.normalizedRepo}|page=${request.page}|path=${safePath}|pathHash=${ckbReleaseEvidenceHash(request.path)}|url=${safeUrl}|urlHash=${ckbReleaseEvidenceHash(request.url)}|status=${evidence.status}|bodyHash=${evidence.bodyHash}|attempts=${evidence.attemptCount}|objects=${objectCount}|files=${fileCount}")
}

private func ckbReleaseSafePathSummary(path: String): String {
    let lower = path.toAsciiLower()
    if (lower.contains("authorization") || lower.contains("bearer") || lower.contains("token") || lower.contains("secret") || lower.contains("password") || lower.contains("proxy")) {
        return "[redacted-path]"
    }
    utf8SafePrefix(redactSensitive(path), 120)
}

private func ckbReleaseSafeUrlSummary(url: String): String {
    let lower = url.toAsciiLower()
    if (lower.contains("authorization") || lower.contains("bearer") || lower.contains("token") || lower.contains("secret") || lower.contains("password") || lower.contains("proxy")) {
        return "[redacted-url]"
    }
    utf8SafePrefix(redactSensitive(url), 160)
}

private func ckbReleaseInventoryLimitFailure(result: CkbScheduledProfileFetchResult, inventory: CkbReleaseSourceInventory, source: CkbReleaseSourcePlan, dimension: String): Unit {
    let status = CkbReleaseAcquisitionStatus.INVENTORY_LIMIT_EXCEEDED
    ckbReleaseInventoryFailure(inventory, status)
    result.diagnostics.add("release_inventory_limit_exceeded:sourceSet=${source.sourceSet}|repo=${source.normalizedRepo}|dimension=${dimension}|nonEmptyPages=${inventory.nonEmptyPages}|objects=${inventory.objectsSeen}|files=${inventory.filesSeen}|bytes=${inventory.contentBytes}")
    ckbReleaseFailFetchResult(result, status, source, "inventory_limit:${dimension}")
}

private func ckbReleaseFailFetchResult(result: CkbScheduledProfileFetchResult, status: String, source: CkbReleaseSourcePlan, reason: String): Unit {
    result.ok = false
    if (result.status == "profile_ok" || result.status == "") {
        result.status = status
    }
    result.failedCount += 1
    let diagnostic = "release_source_failed:sourceSet=${source.sourceSet}|repo=${source.normalizedRepo}|status=${status}|reason=${reason}"
    result.failedRequests.add(diagnostic)
    result.diagnostics.add(diagnostic)
}

private func ckbReleaseAcquisitionFailureStatus(status: String): String {
    if (status == "ok" || status == "local_existing" || status == "active_existing") { return CkbReleaseAcquisitionStatus.OK }
    if (status == "invalid_response_encoding" || status == "invalid_utf8_contents") { return "invalid_response_encoding" }
    if (status.contains("malformed_json") || status == "malformed_contents_response" || status == "gitcode_branch_commit_missing") { return CkbReleaseAcquisitionStatus.MALFORMED_JSON }
    if (status == "") { return "request_failed" }
    status
}

private func ckbReleaseDiagnosticsContain(diagnostics: ArrayList<String>, needle: String): Bool {
    for (diagnostic in diagnostics) {
        if (diagnostic.contains(needle)) { return true }
    }
    false
}

private func ckbScheduledFetchDeadlineWasExceeded(result: CkbScheduledProfileFetchResult): Bool {
    if (result.status == "fetch_deadline_exceeded") {
        return true
    }
    for (diagnostic in result.diagnostics) {
        if (diagnostic.contains("fetch_deadline_exceeded")) {
            return true
        }
    }
    for (failed in result.failedRequests) {
        if (failed.contains("fetch_deadline_exceeded")) {
            return true
        }
    }
    false
}

private func ckbFetchScheduledManifestRepoSources(runner: SourceFetchRunner, builder: SourceRequestBuilder, manifest: CangjieVersionManifest, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, store: FileKnowledgeStore, docs: Bool, std: Bool, stdx: Bool, tools: Bool, evalSupport: Bool, deadlineAtMillis!: Int64 = 0): Unit {
    var matchedSources: Int64 = 0
    for (source in manifest.sources) {
        if (!ckbScheduledManifestSourceIncluded(source, docs, std, stdx, tools, evalSupport)) {
            continue
        }
        matchedSources += 1
        let sourceRequestStart = result.requestCount
        let sourceFetchedStart = result.fetchedCount
        let sourceFailedStart = result.failedCount
        ckbWriteScheduledProfileStageCheckpoint(store, profile, "fetch_source_started", "running", profile.fetchBudgetMillis, deadlineAtMillis, "sourceSet=${source.sourceSet}|sourceFamily=${source.sourceFamily}|repo=${source.sourceRepo}|ref=${source.sourceRef}")
        ckbFetchScheduledManifestSource(runner, builder, source, profile, result, config, store, deadlineAtMillis: deadlineAtMillis)
        ckbWriteScheduledProfileStageCheckpoint(store, profile, "fetch_source_finished", result.status, profile.fetchBudgetMillis, deadlineAtMillis, "sourceSet=${source.sourceSet}|sourceFamily=${source.sourceFamily}|repo=${source.sourceRepo}|ref=${source.sourceRef}|requests=${result.requestCount - sourceRequestStart}|fetched=${result.fetchedCount - sourceFetchedStart}|failed=${result.failedCount - sourceFailedStart}")
    }
    if (matchedSources == 0) {
        result.ok = false
        result.status = "manifest_source_missing"
        result.diagnostics.add("manifest_source_missing:no_matching_sources:${profile.profile}")
    }
}

private func ckbScheduledManifestSourceIncluded(source: CangjieVersionSource, docs: Bool, std: Bool, stdx: Bool, tools: Bool, evalSupport: Bool): Bool {
    (docs && source.sourceSet == CangjieSourceSets.DOCS) ||
        (std && source.sourceSet == CangjieSourceSets.STD) ||
        (stdx && source.sourceSet == CangjieSourceSets.STDX) ||
        (tools && source.sourceSet == CangjieSourceSets.TOOLS) ||
        (evalSupport && source.sourceSet == CangjieSourceSets.EVAL_SUPPORT)
}

private func ckbFetchVersionBranchRefreshSources(runner: SourceFetchRunner, builder: SourceRequestBuilder, manifest: CangjieVersionManifest, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, store: FileKnowledgeStore, deadlineAtMillis!: Int64 = 0): Unit {
    var matchedSources: Int64 = 0
    let resolved = ArrayList<CkbVersionBranchRefreshResolvedSource>()
    for (source in manifest.sources) {
        if (!ckbScheduledManifestSourceIncluded(source, true, true, true, true, true)) {
            continue
        }
        matchedSources += 1
        let sourceRequestStart = result.requestCount
        let sourceFetchedStart = result.fetchedCount
        let sourceFailedStart = result.failedCount
        ckbWriteScheduledProfileStageCheckpoint(store, profile, "fetch_manifest_ref_started", "running", profile.fetchBudgetMillis, deadlineAtMillis, "sourceSet=${source.sourceSet}|sourceFamily=${source.sourceFamily}|repo=${source.sourceRepo}|ref=${source.sourceRef}")
        if (source.sourceSet == CangjieSourceSets.EVAL_SUPPORT) {
            ckbFetchScheduledEvalSupportSource(source, profile, result, config, store)
        } else if (source.sourceRepo.trimAscii() == "" || source.sourceRef.trimAscii() == "") {
            result.ok = false
            result.status = "manifest_source_missing"
            result.diagnostics.add("manifest_source_missing:${source.sourceSet}:${source.sourceFamily}")
            result.failedRequests.add("manifest_source_missing:${source.sourceSet}:${source.sourceRepo}:${source.sourceRef}")
        } else {
            let resolution = ckbResolveGitCodeRefForScheduledFetch(runner, builder, source, profile, result, config, deadlineAtMillis: deadlineAtMillis)
            if (resolution.ok) {
                ckbAppendScheduledManifestRefRecord(profile, result, source, resolution)
                let item = CkbVersionBranchRefreshResolvedSource()
                item.source = source
                item.resolution = resolution
                resolved.add(item)
            } else {
                let failureRequest = builder.gitCodeTree(source.sourceRepo, source.sourceRef)
                let failureFetch = ckbGitCodeRefResolutionFailureFetch(failureRequest, resolution)
                _ = ckbAppendScheduledSourceRecord(profile, result, failureRequest, failureFetch)
            }
        }
        ckbWriteScheduledProfileStageCheckpoint(store, profile, "fetch_manifest_ref_finished", result.status, profile.fetchBudgetMillis, deadlineAtMillis, "sourceSet=${source.sourceSet}|sourceFamily=${source.sourceFamily}|repo=${source.sourceRepo}|ref=${source.sourceRef}|requests=${result.requestCount - sourceRequestStart}|fetched=${result.fetchedCount - sourceFetchedStart}|failed=${result.failedCount - sourceFailedStart}")
    }
    if (matchedSources == 0) {
        result.ok = false
        result.status = "manifest_source_missing"
        result.diagnostics.add("manifest_source_missing:no_matching_sources:${profile.profile}")
        return
    }
    let optionalContentDeadline = ckbVersionBranchRefreshOptionalContentDeadline(profile, deadlineAtMillis)
    for (item in resolved) {
        ckbFetchScheduledGitCodeContentSampleAfterResolvedRef(runner, builder, item.source, profile, result, config, store, item.resolution, deadlineAtMillis: optionalContentDeadline)
    }
}

private func ckbFetchScheduledManifestSource(runner: SourceFetchRunner, builder: SourceRequestBuilder, source: CangjieVersionSource, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, store: FileKnowledgeStore, deadlineAtMillis!: Int64 = 0): Unit {
    if (source.sourceSet == CangjieSourceSets.EVAL_SUPPORT) {
        ckbFetchScheduledEvalSupportSource(source, profile, result, config, store)
        return
    }
    if (source.sourceRepo.trimAscii() == "" || source.sourceRef.trimAscii() == "") {
        result.ok = false
        result.status = "manifest_source_missing"
        result.diagnostics.add("manifest_source_missing:${source.sourceSet}:${source.sourceFamily}")
        result.failedRequests.add("manifest_source_missing:${source.sourceSet}:${source.sourceRepo}:${source.sourceRef}")
        return
    }
    ckbFetchScheduledGitCodeTreeSnapshot(runner, builder, source, profile, result, config, store, deadlineAtMillis: deadlineAtMillis)
}

class GitCodeRefResolution {
    var ok: Bool = false
    var status: String = "not_started"
    var repo: String = ""
    var sourceSet: String = ""
    var sourceFamily: String = ""
    var originalRef: String = ""
    var effectiveRef: String = ""
    var resolvedCommit: String = ""
    var refKind: String = "branch"
    var evidenceBodyHash: String = ""
    var evidenceAttempts: Int64 = 0
    var diagnostics: ArrayList<String> = ArrayList<String>()
    var failedRequests: ArrayList<String> = ArrayList<String>()

    init() {}
}

private class GitCodeBranchResolutionParse {
    var malformed: Bool = false
    var found: Bool = false
    var commit: String = ""
    var count: Int64 = 0
    var status: String = "not_found"

    init() {}
}

private class GitCodeTreePageStats {
    var objectsSeen: Int64 = 0
    var filesSeen: Int64 = 0
    var directoriesSeen: Int64 = 0
    var candidatesSeen: Int64 = 0

    init() {}
}

private class GitCodeTreePageScan {
    var pagesScanned: Int64 = 0
    var objectsSeen: Int64 = 0
    var filesSeen: Int64 = 0
    var directoriesSeen: Int64 = 0
    var candidatesSeen: Int64 = 0
    var failed: Bool = false
    var completed: Bool = false
    var stopReason: String = ""
    var lastRequest: SourceFetchRequest = SourceFetchRequest()
    var selected: ArrayList<String> = ArrayList<String>()

    init() {}
}

private class CkbScheduledFetchCheckpoint {
    var valid: Bool = false
    var profile: String = ""
    var sourceSet: String = ""
    var repo: String = ""
    var ref: String = ""
    var resolvedCommit: String = ""
    var phase: String = ""
    var nextPage: Int64 = 1
    var currentPath: String = ""
    var selectedPaths: ArrayList<String> = ArrayList<String>()
    var completedPaths: ArrayList<String> = ArrayList<String>()

    init() {}
}

public class CkbRepositoryEventRecoveryMarkerStatus {
    var valid: Bool = false
    var status: String = "repository_event_recovery_marker_missing"
    var text: String = ""

    init() {}
}

private class GitCodeTreeScanBudget {
    var maxPages: Int64 = 10
    var maxObjects: Int64 = 1000
    var reason: String = "default"

    init() {}
}

private class CkbVersionBranchRefreshResolvedSource {
    var source: CangjieVersionSource = CangjieVersionSource()
    var resolution: GitCodeRefResolution = GitCodeRefResolution()

    init() {}
}

private func ckbFetchScheduledGitCodeTreeSnapshot(runner: SourceFetchRunner, builder: SourceRequestBuilder, source: CangjieVersionSource, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, store: FileKnowledgeStore, deadlineAtMillis!: Int64 = 0): Unit {
    let resolution = ckbResolveGitCodeRefForScheduledFetch(runner, builder, source, profile, result, config, deadlineAtMillis: deadlineAtMillis)
    if (!resolution.ok) {
        let failureRequest = builder.gitCodeTree(source.sourceRepo, source.sourceRef)
        let failureFetch = ckbGitCodeRefResolutionFailureFetch(failureRequest, resolution)
        _ = ckbAppendScheduledSourceRecord(profile, result, failureRequest, failureFetch)
        return
    }
    ckbAppendScheduledManifestRefRecord(profile, result, source, resolution)
    let optionalContentDeadline = ckbVersionBranchRefreshOptionalContentDeadline(profile, deadlineAtMillis)
    ckbFetchScheduledGitCodeContentSampleAfterResolvedRef(runner, builder, source, profile, result, config, store, resolution, deadlineAtMillis: optionalContentDeadline)
}

private func ckbFetchScheduledGitCodeContentSampleAfterResolvedRef(runner: SourceFetchRunner, builder: SourceRequestBuilder, source: CangjieVersionSource, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, store: FileKnowledgeStore, resolution: GitCodeRefResolution, deadlineAtMillis!: Int64 = 0): Unit {
    if (deadlineAtMillis < 0 || ckbDeadlineExceeded(deadlineAtMillis)) {
        result.diagnostics.add("manifest_content_sample_skipped_deadline:${source.sourceSet}:${source.sourceRepo}:remainingMs=${ckbRemainingMillis(deadlineAtMillis)}")
        result.diagnostics.add("version_branch_refresh_optional_content_skipped:${source.sourceSet}:${source.sourceRepo}:remainingMs=${ckbRemainingMillis(deadlineAtMillis)}")
        ckbWriteScheduledProfileStageCheckpoint(store, profile, "fetch_content_sample", "skipped", profile.fetchBudgetMillis, deadlineAtMillis, "sourceSet=${source.sourceSet}|repo=${source.sourceRepo}|reason=optional_content_budget_exhausted")
        return
    }
    let contentDeadlineAtMillis = deadlineAtMillis
    let scan = ckbFetchScheduledGitCodeTreePages(runner, builder, source, profile, result, config, store, resolution, deadlineAtMillis: contentDeadlineAtMillis)
    result.diagnostics.add("gitcode_tree_pages_scanned:${source.sourceSet}:${source.sourceRepo}:pagesScanned=${scan.pagesScanned}|objects=${scan.objectsSeen}|files=${scan.filesSeen}|directories=${scan.directoriesSeen}|candidates=${scan.candidatesSeen}|stop=${scan.stopReason}")
    if (scan.failed) {
        return
    }
    if (scan.selected.size == 0) {
        let empty = SourceFetchResult()
        empty.ok = false
        empty.status = "source_tree_no_candidate"
        empty.statusCode = 200
        empty.sourceUrl = scan.lastRequest.url
        empty.repo = scan.lastRequest.repo
        empty.ref = scan.lastRequest.ref
        empty.commit = resolution.resolvedCommit
        empty.body = "source_tree_no_candidate pagesScanned=${scan.pagesScanned} objects=${scan.objectsSeen} files=${scan.filesSeen} directories=${scan.directoriesSeen} candidates=${scan.candidatesSeen} stop=${scan.stopReason}"
        empty.bodyHash = stableSummaryHash(empty.body)
        _ = ckbAppendScheduledSourceRecord(profile, result, scan.lastRequest, empty)
        result.diagnostics.add("source_tree_no_candidate:${source.sourceSet}:${source.sourceRepo}:pagesScanned=${scan.pagesScanned}|objects=${scan.objectsSeen}|files=${scan.filesSeen}|directories=${scan.directoriesSeen}|candidates=${scan.candidatesSeen}|stop=${scan.stopReason}")
        ckbWriteScheduledProfileStageCheckpoint(store, profile, "fetch_tree_page", empty.status, profile.fetchBudgetMillis, contentDeadlineAtMillis, "sourceSet=${source.sourceSet}|repo=${source.sourceRepo}|pagesScanned=${scan.pagesScanned}|objects=${scan.objectsSeen}|files=${scan.filesSeen}|directories=${scan.directoriesSeen}|candidates=${scan.candidatesSeen}|stop=${scan.stopReason}")
        return
    }
    ckbFetchScheduledSelectedSourceFiles(runner, builder, source, profile, result, config, store, scan.selected, resolution, deadlineAtMillis: contentDeadlineAtMillis)
}

private func ckbScheduledFetchCheckpointPath(profile: CkbScheduleTaskProfile, source: CangjieVersionSource): String {
    "metadata/scheduled-fetch-checkpoints/${safeName(profile.profile)}-${safeName(source.sourceSet)}-${safeName(source.sourceRepo)}.ckb"
}

private func ckbLoadScheduledFetchCheckpoint(store: FileKnowledgeStore, profile: CkbScheduleTaskProfile, source: CangjieVersionSource, resolution: GitCodeRefResolution): CkbScheduledFetchCheckpoint {
    let checkpoint = CkbScheduledFetchCheckpoint()
    let text = store.readText(ckbScheduledFetchCheckpointPath(profile, source))
    if (text.trimAscii() == "") {
        return checkpoint
    }
    if (ckbCurrentField(text, "profile") != profile.profile || ckbCurrentField(text, "sourceSet") != source.sourceSet || ckbCurrentField(text, "repo") != source.sourceRepo) {
        return checkpoint
    }
    let savedCommit = ckbCurrentField(text, "resolvedCommit")
    if (savedCommit != "" && resolution.resolvedCommit != "" && savedCommit != resolution.resolvedCommit) {
        return checkpoint
    }
    checkpoint.valid = true
    checkpoint.profile = ckbCurrentField(text, "profile")
    checkpoint.sourceSet = ckbCurrentField(text, "sourceSet")
    checkpoint.repo = ckbCurrentField(text, "repo")
    checkpoint.ref = ckbCurrentField(text, "ref")
    checkpoint.resolvedCommit = savedCommit
    checkpoint.phase = ckbCurrentField(text, "phase")
    checkpoint.nextPage = parseIntField(ckbCurrentField(text, "nextPage"), 1)
    checkpoint.currentPath = ckbCurrentField(text, "currentPath")
    let selectedJson = ckbCurrentField(text, "selectedPathsJson")
    let completedJson = ckbCurrentField(text, "completedPathsJson")
    if (selectedJson != "") {
        if (!ckbScheduledFetchDecodePathsJson(selectedJson, checkpoint.selectedPaths)) {
            checkpoint.valid = false
            return checkpoint
        }
    } else {
        ckbScheduledFetchSplitPaths(ckbCurrentField(text, "selectedPaths"), checkpoint.selectedPaths)
    }
    if (completedJson != "") {
        if (!ckbScheduledFetchDecodePathsJson(completedJson, checkpoint.completedPaths)) {
            checkpoint.valid = false
            return checkpoint
        }
    } else {
        ckbScheduledFetchSplitPaths(ckbCurrentField(text, "completedPaths"), checkpoint.completedPaths)
    }
    checkpoint
}

private func ckbSaveScheduledFetchCheckpoint(store: FileKnowledgeStore, profile: CkbScheduleTaskProfile, source: CangjieVersionSource, resolution: GitCodeRefResolution, phase: String, nextPage: Int64, currentPath: String, selectedPaths: ArrayList<String>, completedPaths: ArrayList<String>): Unit {
    var text = "profile=${escapeField(profile.profile)}\n"
    text += "sourceSet=${escapeField(source.sourceSet)}\n"
    text += "sourceFamily=${escapeField(source.sourceFamily)}\n"
    text += "repo=${escapeField(source.sourceRepo)}\n"
    text += "ref=${escapeField(source.sourceRef)}\n"
    text += "resolvedCommit=${escapeField(resolution.resolvedCommit)}\n"
    text += "phase=${escapeField(phase)}\n"
    text += "nextPage=${nextPage}\n"
    text += "currentPath=${escapeField(currentPath)}\n"
    text += "selectedPathsJson=${escapeField(ckbScheduledFetchPathsJson(selectedPaths))}\n"
    text += "completedPathsJson=${escapeField(ckbScheduledFetchPathsJson(completedPaths))}\n"
    text += "updatedAtMillis=${ckbTaskWorkerNowMillis()}\n"
    store.writeLinesAtomically(ckbScheduledFetchCheckpointPath(profile, source), text)
}

private func ckbScheduledFetchSplitPaths(raw: String, out: ArrayList<String>): Unit {
    for (item in raw.split(",")) {
        let path = item.trimAscii()
        if (path != "") {
            addUniqueString(out, path)
        }
    }
}

func ckbScheduledFetchPathsJson(paths: ArrayList<String>): String {
    let out = StringBuilder()
    out.append("[")
    var first = true
    for (path in paths) {
        if (!first) { out.append(",") }
        first = false
        out.append("\"")
        out.append(ckbScheduledFetchJsonEscape(path))
        out.append("\"")
    }
    out.append("]")
    out.toString()
}

func ckbScheduledFetchJsonEscape(raw: String): String {
    let out = StringBuilder()
    for (ch in raw.toRuneArray()) {
        if (ch == r'"') {
            out.append("\\\"")
        } else if (ch == r'\\') {
            out.append("\\\\")
        } else if (ch == r'\n') {
            out.append("\\n")
        } else if (ch == r'\r') {
            out.append("\\r")
        } else if (ch == r'\t') {
            out.append("\\t")
        } else {
            out.append(ch)
        }
    }
    out.toString()
}

func ckbScheduledFetchDecodePathsJson(raw: String, out: ArrayList<String>): Bool {
    try {
        let items = JsonValue.fromStr(raw).asArray().getItems()
        for (item in items) {
            let path = item.asString().getValue()
            if (path == "") { return false }
            addUniqueString(out, path)
        }
        true
    } catch (_: Exception) {
        false
    }
}

private func ckbFetchScheduledGitCodeTreePages(runner: SourceFetchRunner, builder: SourceRequestBuilder, source: CangjieVersionSource, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, store: FileKnowledgeStore, resolution: GitCodeRefResolution, deadlineAtMillis!: Int64 = 0): GitCodeTreePageScan {
    let scan = GitCodeTreePageScan()
    let selector = SourceCandidateSelector()
    let maxFiles = ckbScheduledSourceSnapshotLimit(profile, source)
    let budget = ckbScheduledGitCodeTreeMaxPages(profile, source)
    let maxPages = budget.maxPages
    let perPage: Int64 = 100
    let checkpoint = ckbLoadScheduledFetchCheckpoint(store, profile, source, resolution)
    if (checkpoint.valid && checkpoint.phase == "selected_paths" && checkpoint.selectedPaths.size > 0) {
        for (path in checkpoint.selectedPaths) {
            addUniqueString(scan.selected, path)
        }
        scan.completed = true
        scan.stopReason = "resume_selected_paths"
        result.diagnostics.add("scheduled_fetch_checkpoint_resume:${profile.profile}:${source.sourceSet}:${source.sourceRepo}:phase=${checkpoint.phase}|selected=${checkpoint.selectedPaths.size}|completed=${checkpoint.completedPaths.size}")
        return scan
    }
    var page: Int64 = if (checkpoint.valid && checkpoint.phase == "tree_pages" && checkpoint.nextPage > 1) { checkpoint.nextPage } else { 1 }
    if (page > maxPages) {
        page = maxPages
    }
    if (checkpoint.valid && page > 1) {
        result.diagnostics.add("scheduled_fetch_checkpoint_resume:${profile.profile}:${source.sourceSet}:${source.sourceRepo}:phase=${checkpoint.phase}|nextPage=${page}")
    }
    result.diagnostics.add("gitcode_tree_scan_budget:${source.sourceSet}:${source.sourceRepo}:pages=${budget.maxPages}|objects=${budget.maxObjects}|reason=${budget.reason}")
    while (page <= maxPages) {
        let treeRequest = builder.gitCodeTreePageWithFetchRef(source.sourceRepo, source.sourceRef, resolution.effectiveRef, page: page, perPage: perPage)
        let treeFetch = ckbFetchScheduledRequest(runner, treeRequest, config, deadlineAtMillis: deadlineAtMillis, accounting: result.accounting)
        ckbApplyGitCodeRefResolutionToFetch(treeFetch, resolution)
        scan.lastRequest = treeRequest
        scan.pagesScanned += 1
        result.diagnostics.add("gitcode_tree_fetch_resolution:${ckbScheduledFetchDiagnosticWithResolution(profile, treeRequest, treeFetch, resolution)}|page=${page}")
        _ = ckbAppendScheduledSourceRecord(profile, result, treeRequest, treeFetch)
        ckbWriteScheduledProfileStageCheckpoint(store, profile, "fetch_tree_page", treeFetch.status, profile.fetchBudgetMillis, deadlineAtMillis, "sourceSet=${source.sourceSet}|repo=${source.sourceRepo}|page=${page}|ok=${treeFetch.ok}|objectsSeen=${scan.objectsSeen}|candidatesSeen=${scan.candidatesSeen}")
        if (!treeFetch.ok) {
            ckbSaveScheduledFetchCheckpoint(store, profile, source, resolution, "tree_pages", page, "", scan.selected, checkpoint.completedPaths)
            scan.failed = true
            scan.stopReason = "tree_page_failed:${treeFetch.status}"
            result.diagnostics.add("gitcode_tree_page_failed:${source.sourceSet}:${source.sourceRepo}:page=${page}|pagesScanned=${scan.pagesScanned}|objects=${scan.objectsSeen}|files=${scan.filesSeen}|directories=${scan.directoriesSeen}|candidates=${scan.candidatesSeen}|status=${treeFetch.status}")
            return scan
        }
        let stats = ckbGitCodeTreePageStats(source, profile, treeFetch.body)
        scan.objectsSeen += stats.objectsSeen
        scan.filesSeen += stats.filesSeen
        scan.directoriesSeen += stats.directoriesSeen
        scan.candidatesSeen += stats.candidatesSeen
        result.diagnostics.add("gitcode_tree_page_scanned:${source.sourceSet}:${source.sourceRepo}:page=${page}|objects=${stats.objectsSeen}|files=${stats.filesSeen}|directories=${stats.directoriesSeen}|candidates=${stats.candidatesSeen}|pagesScanned=${scan.pagesScanned}|objectsSeen=${scan.objectsSeen}|filesSeen=${scan.filesSeen}|directoriesSeen=${scan.directoriesSeen}|candidatesSeen=${scan.candidatesSeen}|stop=continue")
        if (stats.objectsSeen == 0) {
            ckbSaveScheduledFetchCheckpoint(store, profile, source, resolution, "completed", page, "", scan.selected, checkpoint.completedPaths)
            scan.completed = true
            scan.stopReason = "empty_page"
            return scan
        }
        let remaining = if (maxFiles < 0) { -1 } else { maxFiles - scan.selected.size }
        if (remaining != 0) {
            let selected = selector.selectFromTreeForSource(source, profile, treeFetch.body, maxFiles: remaining)
            for (path in selected) {
                addUniqueString(scan.selected, path)
            }
        }
        if (scan.selected.size > 0) {
            ckbSaveScheduledFetchCheckpoint(store, profile, source, resolution, "selected_paths", page, "", scan.selected, checkpoint.completedPaths)
            scan.completed = true
            scan.stopReason = "candidates_found"
            return scan
        }
        if (budget.maxObjects > 0 && scan.objectsSeen >= budget.maxObjects) {
            ckbSaveScheduledFetchCheckpoint(store, profile, source, resolution, "completed", page, "", scan.selected, checkpoint.completedPaths)
            scan.completed = true
            scan.stopReason = "object_budget_reached"
            return scan
        }
        ckbSaveScheduledFetchCheckpoint(store, profile, source, resolution, "tree_pages", page + 1, "", scan.selected, checkpoint.completedPaths)
        page += 1
    }
    scan.completed = true
    scan.stopReason = "max_pages_reached"
    ckbSaveScheduledFetchCheckpoint(store, profile, source, resolution, "completed", page, "", scan.selected, checkpoint.completedPaths)
    scan
}

private func ckbAppendScheduledManifestRefRecord(profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, source: CangjieVersionSource, resolution: GitCodeRefResolution): Unit {
    let request = SourceFetchRequest(SourceKinds.GITCODE_BRANCH, "ckb-manifest-ref://${source.sourceRepo}/${resolution.resolvedCommit}", repo: source.sourceRepo, ref: source.sourceRef, purpose: "manifest_ref_resolved")
    let fetch = SourceFetchResult()
    fetch.ok = true
    fetch.status = "manifest_ref_resolved"
    fetch.statusCode = 200
    fetch.sourceUrl = request.url
    fetch.normalizedType = request.kind
    fetch.repo = source.sourceRepo
    fetch.ref = source.sourceRef
    fetch.commit = resolution.resolvedCommit
    fetch.body = "sourceSet=${source.sourceSet}\nsourceFamily=${source.sourceFamily}\nrepo=${source.sourceRepo}\nref=${source.sourceRef}\nresolvedCommit=${resolution.resolvedCommit}\nrefKind=${resolution.refKind}\n"
    fetch.bodyHash = stableSummaryHash(fetch.body)
    _ = ckbAppendScheduledSourceRecord(profile, result, request, fetch)
    result.diagnostics.add("manifest_ref_record_resolved:${source.sourceSet}:${source.sourceRepo}:${source.sourceRef}:${resolution.resolvedCommit}")
}

private func ckbVersionBranchRefreshOptionalContentDeadline(profile: CkbScheduleTaskProfile, deadlineAtMillis: Int64): Int64 {
    if (profile.profile != "cangjie_version_branch_refresh") {
        return deadlineAtMillis
    }
    if (deadlineAtMillis <= 0) {
        return 0
    }
    let remaining = ckbRemainingMillis(deadlineAtMillis)
    if (remaining <= 15000) {
        return -1
    }
    let now = ckbTaskWorkerNowMillis()
    let sampleDeadline = now + 15000
    if (sampleDeadline < deadlineAtMillis) {
        return sampleDeadline
    }
    deadlineAtMillis
}

private func ckbGitCodeTreePageStats(source: CangjieVersionSource, profile: CkbScheduleTaskProfile, body: String): GitCodeTreePageStats {
    let stats = GitCodeTreePageStats()
    for (object in nestedJsonObjectChunks(body)) {
        let safeObject = asciiJsonProjection(object)
        let path = normalizeGitCodeSourcePath(jsonStringField(safeObject, "path"))
        if (path == "") {
            continue
        }
        stats.objectsSeen += 1
        let itemType = jsonStringField(safeObject, "type").toAsciiLower()
        if (itemType == "tree") {
            stats.directoriesSeen += 1
        } else if (itemType != "commit") {
            stats.filesSeen += 1
            if (!excludedSourceCandidate(path) && sourceCandidatePriorityForScheduledSource(source, profile, path.toAsciiLower()) >= 0) {
                stats.candidatesSeen += 1
            }
        }
    }
    stats
}

private func ckbScheduledGitCodeTreeMaxPages(profile: CkbScheduleTaskProfile, source: CangjieVersionSource): GitCodeTreeScanBudget {
    let budget = GitCodeTreeScanBudget()
    let sourceSet = if (source.sourceSet.trimAscii() != "") { source.sourceSet } else { ckbSourceSetFromSourceFamily(source.sourceFamily) }
    if (sourceSet == CangjieSourceSets.TOOLS) {
        budget.maxPages = 50
        budget.maxObjects = 5000
        budget.reason = "tools_required_source"
        return budget
    }
    if (sourceSet == CangjieSourceSets.STD || sourceSet == CangjieSourceSets.STDX) {
        budget.maxPages = 20
        budget.maxObjects = 2000
        budget.reason = "runtime_library_source"
        return budget
    }
    if (sourceSet == CangjieSourceSets.DOCS) {
        budget.maxPages = 20
        budget.maxObjects = 2000
        budget.reason = "docs_source"
        return budget
    }
    if (profile.profile == "cangjie_version_branch_refresh") {
        budget.reason = "version_refresh_default"
    }
    budget
}

private func ckbResolveGitCodeRefForScheduledFetch(runner: SourceFetchRunner, builder: SourceRequestBuilder, source: CangjieVersionSource, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, deadlineAtMillis!: Int64 = 0): GitCodeRefResolution {
    let resolution = ckbResolveGitCodeRefForFetch(runner, builder, source.sourceRepo, source.sourceRef, source.sourceSet, source.sourceFamily, config, deadlineAtMillis: deadlineAtMillis, accounting: result.accounting)
    for (diagnostic in resolution.diagnostics) {
        result.diagnostics.add(diagnostic)
    }
    for (failed in resolution.failedRequests) {
        if (!failed.startsWith("gitcode_ref_resolved")) {
            result.failedRequests.add(failed)
        }
    }
    resolution
}

private func ckbResolveGitCodeRefForFetch(runner: SourceFetchRunner, builder: SourceRequestBuilder, repo: String, ref: String, sourceSet: String, sourceFamily: String, config: CkbRuntimeConfig, deadlineAtMillis!: Int64 = 0, accounting!: CkbScheduledRequestAccounting = CkbScheduledRequestAccounting()): GitCodeRefResolution {
    let resolution = GitCodeRefResolution()
    resolution.repo = repo
    resolution.sourceSet = sourceSet
    resolution.sourceFamily = sourceFamily
    resolution.originalRef = ref
    if (!isSafeGitCodeRef(ref)) {
        resolution.status = "invalid_ref"
        resolution.diagnostics.add("gitcode_ref_resolution_invalid_ref:${repo}:${ref}")
        return resolution
    }
    if (ckbGitCodeLooksLikeCommit(ref)) {
        resolution.ok = true
        resolution.status = "ok"
        resolution.effectiveRef = ref
        resolution.resolvedCommit = ref
        resolution.refKind = "commit"
        resolution.evidenceBodyHash = ckbReleaseEvidenceHash(ref)
        resolution.diagnostics.add("gitcode_ref_resolved_commit:${repo}:${ref}")
        return resolution
    }
    let candidateRefs = ckbGitCodeRefResolutionCandidates(ref, config)
    var page: Int64 = 1
    while (page <= 10) {
        let branchListRequest = builder.gitCodeBranches(repo, page: page)
        let branchListFetch = ckbFetchScheduledRequest(runner, branchListRequest, config, deadlineAtMillis: deadlineAtMillis, accounting: accounting)
        let diagnostic = ckbGitCodeRefResolutionFetchDiagnostic(branchListRequest, branchListFetch)
        resolution.diagnostics.add("gitcode_ref_resolution_branch_list:${diagnostic}")
        if (!branchListFetch.ok) {
            resolution.failedRequests.add(diagnostic)
            if (ckbGitCodeRefResolutionTerminalStatus(branchListFetch.status)) {
                resolution.status = branchListFetch.status
                resolution.evidenceBodyHash = branchListFetch.bodyHash
                resolution.evidenceAttempts = branchListFetch.attempts
                return resolution
            }
            break
        }
        var parsedCount: Int64 = 0
        for (candidateRef in candidateRefs) {
            let parsed = ckbParseGitCodeBranchListResolution(branchListFetch.body, candidateRef)
            if (parsed.malformed) {
                resolution.status = parsed.status
                resolution.failedRequests.add(diagnostic)
                resolution.diagnostics.add("gitcode_ref_resolution_malformed_json:${repo}:${candidateRef}:page=${page}")
                return resolution
            }
            if (parsed.count > parsedCount) {
                parsedCount = parsed.count
            }
            if (parsed.found && parsed.commit != "") {
                resolution.ok = true
                resolution.status = "ok"
                resolution.effectiveRef = parsed.commit
                resolution.resolvedCommit = parsed.commit
                resolution.refKind = "branch"
                resolution.evidenceBodyHash = ckbReleaseEvidenceHash(branchListFetch.body)
                resolution.evidenceAttempts = branchListFetch.attempts
                resolution.diagnostics.add("gitcode_ref_resolved_branch_list:${repo}:${candidateRef}:${parsed.commit}")
                if (candidateRef != ref) {
                    resolution.diagnostics.add("gitcode_ref_alias_used:${repo}:${ref}:${candidateRef}")
                }
                return resolution
            }
        }
        if (parsedCount < 100) {
            break
        }
        page += 1
    }
    for (candidateRef in candidateRefs) {
        let branchRequest = builder.gitCodeBranchNativeSafe(repo, candidateRef)
        let branchFetch = ckbFetchScheduledRequest(runner, branchRequest, config, deadlineAtMillis: deadlineAtMillis, accounting: accounting)
        let branchDiagnostic = ckbGitCodeRefResolutionFetchDiagnostic(branchRequest, branchFetch)
        resolution.diagnostics.add("gitcode_ref_resolution_branch_ref:${branchDiagnostic}")
        if (branchFetch.ok) {
            let parsed = ckbParseGitCodeBranchObjectResolution(branchFetch.body, candidateRef)
            if (parsed.malformed) {
                resolution.status = parsed.status
                resolution.failedRequests.add(branchDiagnostic)
                return resolution
            }
            if (parsed.found && parsed.commit != "") {
                resolution.ok = true
                resolution.status = "ok"
                resolution.effectiveRef = parsed.commit
                resolution.resolvedCommit = parsed.commit
                resolution.refKind = "branch"
                resolution.evidenceBodyHash = ckbReleaseEvidenceHash(branchFetch.body)
                resolution.evidenceAttempts = branchFetch.attempts
                resolution.diagnostics.add("gitcode_ref_resolved_branch_ref:${repo}:${candidateRef}:${parsed.commit}")
                if (candidateRef != ref) {
                    resolution.diagnostics.add("gitcode_ref_alias_used:${repo}:${ref}:${candidateRef}")
                }
                return resolution
            }
        } else {
            resolution.failedRequests.add(branchDiagnostic)
            if (ckbGitCodeRefResolutionTerminalStatus(branchFetch.status)) {
                resolution.status = branchFetch.status
                resolution.evidenceBodyHash = branchFetch.bodyHash
                resolution.evidenceAttempts = branchFetch.attempts
                return resolution
            }
        }
    }
    resolution.status = "gitcode_ref_resolution_failed"
    resolution.diagnostics.add("gitcode_ref_resolution_failed:${repo}:${ref}")
    resolution
}

private func ckbGitCodeRefResolutionTerminalStatus(status: String): Bool {
    status == "invalid_response_encoding" ||
        status == "fetch_deadline_exceeded" ||
        status == "timeout" ||
        status == "auth_degraded" ||
        status == "rate_limited" ||
        status == "blocked_url"
}

private func ckbGitCodeRefResolutionCandidates(ref: String, config: CkbRuntimeConfig): ArrayList<String> {
    let candidates = ArrayList<String>()
    addUniqueString(candidates, ref)
    if (ref.startsWith("release")) {
        let aliases = cangjieSourceRefAliasesForTargetVersion(ckbScheduledTargetVersion(config))
        for (alias in aliases) {
            addUniqueString(candidates, alias)
        }
    }
    candidates
}

private func ckbGitCodeRefResolutionFetchDiagnostic(request: SourceFetchRequest, fetch: SourceFetchResult): String {
    "kind=${request.kind}|repo=${request.repo}|ref=${request.ref}|path=${request.path}|url=${request.url}|ok=${fetch.ok}|status=${fetch.status}|statusCode=${fetch.statusCode}|errorClass=${fetch.transportErrorClass}|bodyHash=${fetch.bodyHash}"
}

private func ckbGitCodeLooksLikeCommit(ref: String): Bool {
    if (ref.size != 40) {
        return false
    }
    for (b in ref.toArray()) {
        if (!((b >= UInt8(48) && b <= UInt8(57)) || (b >= UInt8(65) && b <= UInt8(70)) || (b >= UInt8(97) && b <= UInt8(102)))) {
            return false
        }
    }
    true
}

private func ckbParseGitCodeBranchListResolution(body: String, ref: String): GitCodeBranchResolutionParse {
    let parsed = GitCodeBranchResolutionParse()
    let items = try {
        JsonValue.fromStr(body).asArray().getItems()
    } catch (_: Exception) {
        parsed.malformed = true
        parsed.status = "gitcode_branch_list_malformed_json"
        return parsed
    }
    for (value in items) {
        parsed.count += 1
        let objectParsed = try {
            ckbParseGitCodeBranchObjectValue(value.asObject(), ref)
        } catch (_: Exception) {
            parsed.malformed = true
            parsed.status = "gitcode_branch_list_malformed_json"
            return parsed
        }
        if (objectParsed.malformed) {
            parsed.malformed = true
            parsed.status = objectParsed.status
            return parsed
        }
        if (objectParsed.found) {
            parsed.found = true
            parsed.commit = objectParsed.commit
            parsed.status = objectParsed.status
            return parsed
        }
    }
    parsed
}

private func ckbParseGitCodeBranchObjectResolution(body: String, ref: String): GitCodeBranchResolutionParse {
    let parsed = GitCodeBranchResolutionParse()
    let object = try {
        JsonValue.fromStr(body).asObject()
    } catch (_: Exception) {
        parsed.malformed = true
        parsed.status = "gitcode_branch_object_malformed_json"
        return parsed
    }
    ckbParseGitCodeBranchObjectValue(object, ref)
}

private func ckbParseGitCodeBranchObjectValue(object: JsonObject, ref: String): GitCodeBranchResolutionParse {
    let parsed = GitCodeBranchResolutionParse()
    let name = ckbStrictJsonString(object, "name")
    if (name == "") {
        parsed.malformed = true
        parsed.status = "gitcode_branch_object_malformed_json"
        return parsed
    }
    if (name != ref) {
        return parsed
    }
    var commit = ""
    match (object.get("commit")) {
        case Some(value) =>
            try {
                let commitObject = value.asObject()
                commit = ckbStrictFirstJsonString(commitObject, ["id", "sha"])
            } catch (_: Exception) {
                try { commit = value.asString().getValue() } catch (_inner: Exception) { () }
            }
        case None => ()
    }
    if (commit == "") {
        commit = ckbStrictFirstJsonString(object, ["commit_id", "commit_sha", "sha"])
    }
    if (!ckbGitCodeLooksLikeCommit(commit)) {
        parsed.malformed = true
        parsed.status = "gitcode_branch_commit_missing"
        return parsed
    }
    parsed.found = true
    parsed.commit = commit
    parsed.status = "ok"
    parsed
}

private func ckbStrictJsonString(object: JsonObject, key: String): String {
    match (object.get(key)) {
        case Some(value) => try { value.asString().getValue() } catch (_: Exception) { "" }
        case None => ""
    }
}

private func ckbStrictFirstJsonString(object: JsonObject, keys: Array<String>): String {
    for (key in keys) {
        let value = ckbStrictJsonString(object, key)
        if (value != "") { return value }
    }
    ""
}

private func ckbGitCodeRefResolutionFailureFetch(request: SourceFetchRequest, resolution: GitCodeRefResolution): SourceFetchResult {
    let fetch = SourceFetchResult()
    fetch.ok = false
    fetch.status = if (resolution.status == "") { "gitcode_ref_resolution_failed" } else { resolution.status }
    fetch.sourceUrl = request.url
    fetch.normalizedType = request.kind
    fetch.repo = request.repo
    fetch.ref = request.ref
    fetch.path = request.path
    fetch.body = joinStrings(resolution.diagnostics, "\n")
    if (fetch.body == "") {
        fetch.body = fetch.status
    }
    fetch.bodyHash = stableSummaryHash(fetch.body)
    fetch
}

private func ckbApplyGitCodeRefResolutionToFetch(fetch: SourceFetchResult, resolution: GitCodeRefResolution): Unit {
    fetch.ref = resolution.originalRef
    if (resolution.resolvedCommit != "") {
        fetch.commit = resolution.resolvedCommit
    }
}

private func ckbFetchScheduledSelectedSourceFiles(runner: SourceFetchRunner, builder: SourceRequestBuilder, source: CangjieVersionSource, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, store: FileKnowledgeStore, selected: ArrayList<String>, resolution: GitCodeRefResolution, deadlineAtMillis!: Int64 = 0): Unit {
    let checkpoint = ckbLoadScheduledFetchCheckpoint(store, profile, source, resolution)
    let completedPaths = ArrayList<String>()
    if (checkpoint.valid && checkpoint.phase == "selected_paths" && checkpoint.currentPath != "") {
        for (path in checkpoint.completedPaths) {
            addUniqueString(completedPaths, path)
        }
    }
    for (path in selected) {
        if (completedPaths.contains(path)) {
            result.diagnostics.add("scheduled_fetch_checkpoint_skip_completed_path:${source.sourceSet}:${source.sourceRepo}:${path}")
            continue
        }
        ckbSaveScheduledFetchCheckpoint(store, profile, source, resolution, "selected_paths", checkpoint.nextPage, path, selected, completedPaths)
        let rawRequest = builder.gitCodeSourceRawWithFetchRef(source.sourceRepo, source.sourceRef, resolution.effectiveRef, path)
        let rawFetch = ckbFetchScheduledRequest(runner, rawRequest, config, deadlineAtMillis: deadlineAtMillis, accounting: result.accounting)
        ckbApplyGitCodeRefResolutionToFetch(rawFetch, resolution)
        if (rawFetch.ok) {
            _ = ckbAppendScheduledSourceRecord(profile, result, rawRequest, rawFetch)
            addUniqueString(completedPaths, path)
            ckbSaveScheduledFetchCheckpoint(store, profile, source, resolution, "selected_paths", checkpoint.nextPage, "", selected, completedPaths)
            ckbWriteScheduledProfileStageCheckpoint(store, profile, "fetch_content_sample", rawFetch.status, profile.fetchBudgetMillis, deadlineAtMillis, "sourceSet=${source.sourceSet}|repo=${source.sourceRepo}|path=${path}|method=raw|ok=true")
            continue
        }
        result.diagnostics.add("source_raw_snapshot_fallback:${ckbScheduledFetchDiagnosticWithResolution(profile, rawRequest, rawFetch, resolution)}")
        if (rawFetch.status == "fetch_deadline_exceeded") {
            ckbSaveScheduledFetchCheckpoint(store, profile, source, resolution, "selected_paths", checkpoint.nextPage, path, selected, completedPaths)
            return
        }
        let contentsRequest = builder.gitCodeSourceContentsWithFetchRef(source.sourceRepo, source.sourceRef, resolution.effectiveRef, path)
        let contentsFetch = ckbFetchScheduledRequest(runner, contentsRequest, config, deadlineAtMillis: deadlineAtMillis, accounting: result.accounting)
        ckbApplyGitCodeRefResolutionToFetch(contentsFetch, resolution)
        if (contentsFetch.ok) {
            _ = ckbAppendScheduledSourceRecord(profile, result, contentsRequest, contentsFetch)
            addUniqueString(completedPaths, path)
            ckbSaveScheduledFetchCheckpoint(store, profile, source, resolution, "selected_paths", checkpoint.nextPage, "", selected, completedPaths)
            ckbWriteScheduledProfileStageCheckpoint(store, profile, "fetch_content_sample", contentsFetch.status, profile.fetchBudgetMillis, deadlineAtMillis, "sourceSet=${source.sourceSet}|repo=${source.sourceRepo}|path=${path}|method=contents|ok=true")
        } else {
            result.diagnostics.add("source_contents_snapshot_failed:${ckbScheduledFetchDiagnosticWithResolution(profile, contentsRequest, contentsFetch, resolution)}")
            _ = ckbAppendScheduledSourceRecord(profile, result, contentsRequest, contentsFetch)
            if (contentsFetch.status == "fetch_deadline_exceeded" || contentsFetch.status == "timeout") {
                ckbSaveScheduledFetchCheckpoint(store, profile, source, resolution, "selected_paths", checkpoint.nextPage, path, selected, completedPaths)
                return
            }
            addUniqueString(completedPaths, path)
            ckbSaveScheduledFetchCheckpoint(store, profile, source, resolution, "selected_paths", checkpoint.nextPage, "", selected, completedPaths)
            ckbWriteScheduledProfileStageCheckpoint(store, profile, "fetch_content_sample", contentsFetch.status, profile.fetchBudgetMillis, deadlineAtMillis, "sourceSet=${source.sourceSet}|repo=${source.sourceRepo}|path=${path}|method=contents|ok=false")
        }
    }
    ckbSaveScheduledFetchCheckpoint(store, profile, source, resolution, "completed", checkpoint.nextPage, "", selected, completedPaths)
}

private func ckbScheduledSourceSnapshotLimit(profile: CkbScheduleTaskProfile, source: CangjieVersionSource): Int64 {
    if (profile.profile == "cangjie_version_branch_refresh") {
        return 1
    }
    if (profile.profile == "cangjie_source_event_sync") {
        return 3
    }
    if (source.sourceSet == CangjieSourceSets.STD || source.sourceSet == CangjieSourceSets.STDX) {
        return 6
    }
    4
}

private func ckbFetchScheduledEvalSupportSource(source: CangjieVersionSource, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, store: FileKnowledgeStore): Unit {
    let root = ckbScheduledEvalSupportRoot(config)
    let request = ckbScheduledEvalSupportLocalRequest(source, config)
    if (root == "") {
        let fetch = ckbScheduledEvalSupportUnavailableFetch(request, "eval_support_source_unavailable")
        _ = ckbAppendScheduledSourceRecord(profile, result, request, fetch)
        return
    }
    let resolution = resolveCangjieVersion(cangjieVersionSelector(targetVersion: ckbScheduledTargetVersion(config), sourceSet: CangjieSourceSets.EVAL_SUPPORT), ckbRuntimeCangjieVersionManifest(config))
    let extracted = extractAllEvalSupportRecords(root, version: resolution)
    if (extracted.records.size == 0) {
        let fetch = ckbScheduledEvalSupportUnavailableFetch(request, "eval_support_source_unavailable")
        for (diagnostic in extracted.diagnostics) {
            result.diagnostics.add("eval_support_local:${diagnostic}")
        }
        _ = ckbAppendScheduledSourceRecord(profile, result, request, fetch)
        return
    }
    let fetch = SourceFetchResult()
    fetch.ok = true
    fetch.status = "local_existing"
    fetch.statusCode = 200
    fetch.sourceUrl = request.url
    fetch.repo = request.repo
    fetch.ref = request.ref
    fetch.path = request.path
    fetch.normalizedType = request.kind
    fetch.contentType = "text/plain"
    fetch.body = ckbScheduledEvalSupportBody(extracted)
    fetch.bytes = fetch.body.size
    fetch.bodyHash = stableSummaryHash(fetch.body)
    fetch.commit = stableSummaryHash("${root}:${fetch.bodyHash}")
    _ = ckbAppendScheduledSourceRecord(profile, result, request, fetch)
    result.diagnostics.add("eval_support_local_existing:${root}:${extracted.records.size}")
}

private func ckbScheduledEvalSupportRoot(config: CkbRuntimeConfig): String {
    let configured = config.firstInitEvalRoot.trimAscii()
    if (configured != "" && exists(Path(configured))) {
        return configured
    }
    ""
}

private func ckbScheduledEvalSupportLocalRequest(source: CangjieVersionSource, config: CkbRuntimeConfig): SourceFetchRequest {
    let ref = if (source.sourceRef.trimAscii() == "") { ckbScheduledTargetVersion(config) } else { source.sourceRef.trimAscii() }
    let request = SourceFetchRequest(SourceKinds.GITCODE_SOURCE, "ckb-local://eval-support", repo: "ckb-local://eval-support", ref: ref, path: "eval-support-snapshot", accept: "text/plain", purpose: "local_eval_support_snapshot")
    request.sourceVariant = "local"
    request
}

private func ckbScheduledEvalSupportUnavailableFetch(request: SourceFetchRequest, status: String): SourceFetchResult {
    let fetch = SourceFetchResult()
    fetch.ok = false
    fetch.status = status
    fetch.sourceUrl = request.url
    fetch.repo = request.repo
    fetch.ref = request.ref
    fetch.path = request.path
    fetch.normalizedType = request.kind
    fetch.body = status
    fetch.bodyHash = stableSummaryHash(status)
    fetch
}

private func ckbScheduledEvalSupportBody(extracted: CangjieTypedRecordResult): String {
    let body = StringBuilder()
    for (record in extracted.records) {
        body.append("# ")
        body.append(record.title)
        body.append("\n")
        body.append(record.content)
        body.append("\n")
        body.append("citation=")
        body.append(record.citation)
        body.append("\n\n")
    }
    body.toString()
}

private func ckbFetchScheduledSource(runner: SourceFetchRunner, request: SourceFetchRequest, profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, deadlineAtMillis!: Int64 = 0): Unit {
    let fetch = ckbFetchScheduledRequest(runner, request, config, deadlineAtMillis: deadlineAtMillis, accounting: result.accounting)
    _ = ckbAppendScheduledSourceRecord(profile, result, request, fetch)
}

private func ckbFetchScheduledRequest(runner: SourceFetchRunner, request: SourceFetchRequest, config: CkbRuntimeConfig, deadlineAtMillis!: Int64 = 0, accounting!: CkbScheduledRequestAccounting = CkbScheduledRequestAccounting()): SourceFetchResult {
    accounting.plannedRequests += 1
    request.deadlineAtMillis = deadlineAtMillis
    if (ckbDeadlineExceeded(deadlineAtMillis)) {
        let deadline = ckbFetchScheduledDeadlineExceededResult(request, deadlineAtMillis)
        accounting.failedRequests += 1
        return deadline
    }
    let remaining = ckbRemainingMillis(deadlineAtMillis)
    request.timeoutMillis = if (remaining > 0 && remaining < config.timeoutMillis) { remaining } else { config.timeoutMillis }
    request.retryCount = config.retryCount
    let fetch = SourceResponseNormalizer().normalize(request, runner.fetch(request))
    let attempts = if (fetch.attempts > 0) { fetch.attempts } else { 0 }
    accounting.actualAttempts += attempts
    if (attempts > 1) {
        accounting.retryAttempts += attempts - 1
    }
    if (attempts > 0 && fetch.statusCode >= 200 && fetch.statusCode < 300) {
        accounting.successfulAttempts += 1
    }
    if (fetch.ok) {
        accounting.completedRequests += 1
    } else {
        accounting.failedRequests += 1
    }
    fetch
}

private func ckbFetchScheduledDeadlineExceededResult(request: SourceFetchRequest, deadlineAtMillis: Int64): SourceFetchResult {
    let result = SourceFetchResult()
    result.ok = false
    result.status = "fetch_deadline_exceeded"
    result.statusCode = 0
    result.sourceUrl = request.url
    result.normalizedType = request.kind
    result.repo = request.repo
    result.ref = request.ref
    result.path = request.path
    result.transportErrorClass = "timeout"
    result.transportDiagnostic = "fetch_deadline_exceeded:deadline=${deadlineAtMillis}"
    result.body = result.transportDiagnostic
    result.bodyHash = stableSummaryHash(result.body)
    result
}

private func ckbAppendScheduledSourceRecord(profile: CkbScheduleTaskProfile, result: CkbScheduledProfileFetchResult, request: SourceFetchRequest, fetch: SourceFetchResult): CkbScheduledSourceRecord {
    ckbSyncScheduledRequestAccounting(result)
    if (fetch.truncated) {
        result.truncated = true
    }
    if (fetch.ok) {
        result.fetchedCount += 1
        result.successfulRequests.add(ckbScheduledFetchDiagnostic(profile, request, fetch))
    } else {
        result.ok = false
        result.failedCount += 1
        result.failedRequests.add(ckbScheduledFetchDiagnostic(profile, request, fetch))
    }
    result.diagnostics.add(ckbScheduledFetchDiagnostic(profile, request, fetch))
    let record = CkbScheduledSourceRecord()
    record.request = request
    record.fetch = fetch
    record.sourceType = ckbScheduledSourceType(request)
    record.sourceFamily = ckbScheduledSourceFamily(request, profile)
    record.sourceSet = ckbScheduledSourceSet(request, profile)
    record.title = ckbScheduledSourceTitle(request, profile)
    record.sourceId = if (profile.profile == "cangjie_source_event_sync" &&
        request.kind == SourceKinds.GITCODE_SOURCE && ckbSafeRepoRelativePath(request.path)) {
        ckbRepositoryEventLogicalSourceId(request.repo, request.ref, request.path)
    } else { "scheduled-${profile.profile}-${stableSummaryHash("${request.kind}:${request.url}:${request.repo}:${request.ref}:${fetch.bodyHash}")}" }
    result.records.add(record)
    record
}

private func ckbSyncScheduledRequestAccounting(result: CkbScheduledProfileFetchResult): Unit {
    result.actualAttempts = result.accounting.actualAttempts
    result.successfulAttempts = result.accounting.successfulAttempts
    result.retryAttempts = result.accounting.retryAttempts
    result.plannedRequests = result.accounting.plannedRequests
    result.completedRequests = result.accounting.completedRequests
    result.failedRequestCount = result.accounting.failedRequests
    result.requestCount = result.actualAttempts
}

private func ckbScheduledFetchDiagnostic(profile: CkbScheduleTaskProfile, request: SourceFetchRequest, fetch: SourceFetchResult): String {
    "profile=${profile.profile}|kind=${request.kind}|purpose=${request.purpose}|page=${request.page}|perPage=${request.perPage}|repo=${request.repo}|ref=${request.ref}|path=${request.path}|url=${request.url}|ok=${fetch.ok}|status=${fetch.status}|statusCode=${fetch.statusCode}|errorClass=${fetch.transportErrorClass}|attempts=${fetch.attempts}|timeoutMillis=${request.timeoutMillis}|retryCount=${request.retryCount}|transportDiagnostic=${utf8SafePrefix(redactSensitive(fetch.transportDiagnostic), 120)}|bodyHash=${fetch.bodyHash}"
}

private func ckbScheduledFetchDiagnosticWithResolution(profile: CkbScheduleTaskProfile, request: SourceFetchRequest, fetch: SourceFetchResult, resolution: GitCodeRefResolution): String {
    "${ckbScheduledFetchDiagnostic(profile, request, fetch)}|sourceSet=${resolution.sourceSet}|sourceFamily=${resolution.sourceFamily}|originalRef=${resolution.originalRef}|effectiveRef=${resolution.effectiveRef}|resolvedCommit=${resolution.resolvedCommit}|resolutionStatus=${resolution.status}|refKind=${resolution.refKind}"
}

private func ckbScheduledFetchPrimaryFailure(result: CkbScheduledProfileFetchResult): String {
    if (result.failedRequests.size == 0) {
        return if (result.status == "" || result.status == "profile_ok") { "unknown" } else { result.status }
    }
    let first = result.failedRequests[0]
    if (first.contains("status=timeout")) { return "timeout" }
    if (first.contains("errorClass=timeout")) { return "timeout" }
    if (first.contains("status=auth_degraded")) { return "auth_degraded" }
    if (first.contains("status=not_found") || first.contains("status=http_404")) { return "not_found" }
    if (first.contains("status=blocked_url")) { return "blocked_url" }
    if (first.contains("errorClass=tls")) { return "tls" }
    if (first.contains("errorClass=dns")) { return "dns" }
    if (first.contains("status=transport_error")) { return "transport_error" }
    "request_failed"
}

private func ckbEvaluateScheduledFetchReadiness(profile: CkbScheduleTaskProfile, fetch: CkbScheduledProfileFetchResult, manifest: CangjieVersionManifest): CkbScheduledFetchReadiness {
    let readiness = CkbScheduledFetchReadiness()
    if (fetch.records.size == 0) {
        readiness.canPromote = false
        readiness.requiredFailedCount += 1
        readiness.diagnostics.add("scheduled_no_fetch_records:${profile.profile}")
        return readiness
    }
    for (record in fetch.records) {
        if (record.fetch.ok) {
            if (record.request.repo == "ckb-local://eval-support" || record.fetch.status == "local_existing") {
                readiness.recoveredCount += 1
                readiness.diagnostics.add("source_recovered:${record.sourceSet}:${record.request.repo}:${record.fetch.status}")
            }
            continue
        }
        if (ckbScheduledSourceRequiredness(profile, record.sourceSet)) {
            let failureClass = ckbScheduledReadinessFailureClassForProfile(profile, fetch, record)
            if (failureClass == "manifest") {
                readiness.requiredFailedCount += 1
                readiness.canPromote = false
                readiness.manifestBlockingCount += 1
                readiness.diagnostics.add("manifest_blocking_source_failed:${record.sourceSet}:${record.request.repo}:${record.fetch.status}")
                readiness.diagnostics.add("required_source_failed:${record.sourceSet}:${record.request.repo}:${record.fetch.status}")
            } else if (profile.profile == "cangjie_version_branch_refresh") {
                readiness.optionalFailedCount += 1
                readiness.optionalContentFailedCount += 1
                readiness.diagnostics.add("content_warning_source_failed:${record.sourceSet}:${record.request.repo}:${record.fetch.status}")
            } else {
                readiness.requiredFailedCount += 1
                readiness.canPromote = false
                readiness.contentBlockingCount += 1
                readiness.diagnostics.add("content_blocking_source_failed:${record.sourceSet}:${record.request.repo}:${record.fetch.status}")
                readiness.diagnostics.add("required_source_failed:${record.sourceSet}:${record.request.repo}:${record.fetch.status}")
            }
        } else {
            readiness.optionalFailedCount += 1
            if (ckbScheduledReadinessFailureClassForProfile(profile, fetch, record) == "content") {
                readiness.optionalContentFailedCount += 1
            }
            readiness.diagnostics.add("optional_source_failed:${record.sourceSet}:${record.request.repo}:${record.fetch.status}")
        }
    }
    if (fetch.failedCount > readiness.requiredFailedCount + readiness.optionalFailedCount) {
        readiness.canPromote = false
        let unclassified = fetch.failedCount - readiness.requiredFailedCount - readiness.optionalFailedCount
        readiness.requiredFailedCount += unclassified
        readiness.manifestBlockingCount += unclassified
        readiness.diagnostics.add("unclassified_fetch_failure:${profile.profile}:${fetch.failedCount}")
    }
    readiness
}

private func ckbScheduledReadinessFailureClassForProfile(profile: CkbScheduleTaskProfile, fetch: CkbScheduledProfileFetchResult, record: CkbScheduledSourceRecord): String {
    if (profile.profile == "cangjie_version_branch_refresh") {
        if (record.fetch.status == "eval_support_source_unavailable") {
            return "content"
        }
        if (record.request.kind == SourceKinds.GITCODE_TREE && record.request.purpose == "source_tree") {
            return if (ckbScheduledManifestRefResolvedForRecord(fetch, record)) { "content" } else { "manifest" }
        }
        if (record.request.kind == SourceKinds.GITCODE_SOURCE) {
            return if (ckbScheduledManifestRefResolvedForRecord(fetch, record)) { "content" } else { "manifest" }
        }
    }
    ckbScheduledReadinessFailureClass(record)
}

private func ckbScheduledManifestRefResolvedForRecord(fetch: CkbScheduledProfileFetchResult, record: CkbScheduledSourceRecord): Bool {
    let sourceSet = record.sourceSet
    let repo = ckbScheduledRecordRepo(record)
    if (sourceSet == "" || repo == "") {
        return false
    }
    for (candidate in fetch.records) {
        if (!candidate.fetch.ok || candidate.request.purpose != "manifest_ref_resolved" || candidate.fetch.commit.trimAscii() == "") {
            continue
        }
        if (candidate.sourceSet == sourceSet && ckbScheduledRecordRepo(candidate) == repo) {
            return true
        }
    }
    false
}

private func ckbScheduledRecordRepo(record: CkbScheduledSourceRecord): String {
    if (record.request.repo != "") {
        return record.request.repo
    }
    record.fetch.repo
}

private func ckbScheduledReadinessFailureClass(record: CkbScheduledSourceRecord): String {
    if (record.request.kind == SourceKinds.GITCODE_SOURCE ||
        record.request.kind == SourceKinds.CANGJIE_DOCS ||
        record.request.kind == SourceKinds.CANGJIE_WEBSITE ||
        record.request.kind == SourceKinds.WEB_CANDIDATE ||
        record.fetch.status == "source_tree_empty_after_pages" ||
        record.fetch.status == "source_tree_no_candidate" ||
        record.fetch.status == "eval_support_source_unavailable") {
        return "content"
    }
    "manifest"
}

private func ckbScheduledCanPersistResolvedArtifacts(profile: CkbScheduleTaskProfile, readiness: CkbScheduledFetchReadiness): Bool {
    if (!(profile.profile == "cangjie_version_branch_refresh" || profile.profile == "cangjie_release_full_sync" || profile.profile == "cangjie_source_event_sync")) {
        return false
    }
    readiness.manifestBlockingCount == 0
}

private func ckbScheduledSourceRequiredness(profile: CkbScheduleTaskProfile, sourceSet: String): Bool {
    if (profile.profile == "cangjie_docs_full_sync") {
        return sourceSet == CangjieSourceSets.DOCS || sourceSet == CangjieSourceSets.EVAL_SUPPORT
    }
    if (profile.profile == "cangjie_source_event_sync") {
        return sourceSet == CangjieSourceSets.STD || sourceSet == CangjieSourceSets.STDX || sourceSet == CangjieSourceSets.TOOLS || sourceSet == CangjieSourceSets.EVAL_SUPPORT
    }
    if (profile.profile == "cangjie_release_full_sync" || profile.profile == "cangjie_version_branch_refresh") {
        return sourceSet == CangjieSourceSets.DOCS || sourceSet == CangjieSourceSets.STD || sourceSet == CangjieSourceSets.STDX || sourceSet == CangjieSourceSets.TOOLS || sourceSet == CangjieSourceSets.EVAL_SUPPORT
    }
    true
}

private func ingestScheduledProfileSources(kb: KnowledgeBase, store: FileKnowledgeStore, profile: CkbScheduleTaskProfile, fetch: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, manifest: CangjieVersionManifest, progressSink!: VectorBuildProgressSink = NoopVectorBuildProgressSink(), stageSink!: CkbStagedRebuildStageSink = NoopCkbStagedRebuildStageSink(), deadlineAtMillis!: Int64 = 0, promotionBudgetPlan!: CangjieCandidatePromotionBudgetPlan = CangjieCandidatePromotionBudgetPlan()): CkbScheduledProfileIngestResult {
    let result = CkbScheduledProfileIngestResult()
    result.status = if (fetch.ok) { "profile_ok" } else { fetch.status }
    result.validationDiagnostics.add(ckbSchedulerProfileStageBudgetDiagnostic(profile))
    ckbWriteScheduledProfileStageCheckpoint(store, profile, "ingest_started", result.status, ckbProfileIngestBudgetMillis(profile), deadlineAtMillis, "fetchRequests=${fetch.requestCount}|fetched=${fetch.fetchedCount}|failed=${fetch.failedCount}")
    result.validationDiagnostics.add("profile_stage_checkpoint:profile=${profile.profile}|stage=ingest_started|status=${result.status}|budgetMs=${ckbProfileIngestBudgetMillis(profile)}|deadlineAtMillis=${deadlineAtMillis}|remainingMs=${ckbRemainingMillis(deadlineAtMillis)}")
    if (ckbApplyScheduledIngestDeadline(result, profile, "ingest_started", deadlineAtMillis)) {
        return result
    }
    for (diagnostic in fetch.diagnostics) {
        result.validationDiagnostics.add("fetch:${diagnostic}")
    }
    if (profile.profile == "cangjie_benchmark_gap_curation") {
        return ingestScheduledBenchmarkGapCuration(kb, store, profile, config, manifest, progressSink: progressSink, deadlineAtMillis: deadlineAtMillis)
    }
    if (profile.profile == "cangjie_release_full_sync") {
        let readiness = ckbEvaluateScheduledFetchReadiness(profile, fetch,
            manifest)
        let releaseReady = fetch.ok && readiness.canPromote &&
            fetch.releasePlan.ok && ckbReleaseAllInventoriesComplete(
                fetch.releasePlan, fetch.releaseInventories)
        var requiredFailedCount = readiness.requiredFailedCount
        if (!releaseReady && requiredFailedCount == 0) {
            var completeInventories: Int64 = 0
            for (inventory in fetch.releaseInventories) {
                if (inventory.complete) { completeInventories += 1 }
            }
            let missing = fetch.releasePlan.sources.size -
                completeInventories
            requiredFailedCount = if (missing > 0) { missing } else { 1 }
        }
        ckbEmitStagedRebuildStage(stageSink, "readiness_evaluated",
            if (releaseReady) { "ready" } else { "failed" },
            deadlineAtMillis,
            "requiredFailedCount=${requiredFailedCount}|optionalFailedCount=${readiness.optionalFailedCount}",
            typedEvent: "routine.readiness.evaluated",
            requiredFailedCount: requiredFailedCount,
            optionalFailedCount: readiness.optionalFailedCount)
        return ckbIngestReleaseFullSync(kb, store, profile, fetch, config, manifest, result, progressSink, stageSink, deadlineAtMillis, promotionBudgetPlan)
    }
    if (profile.candidateMode == "" || profile.candidateMode == "none" || profile.candidateMode == "probe_only") {
        result.ok = fetch.ok
        if (result.ok) {
            ckbPersistProbeOnlyScheduledArtifacts(store, profile, fetch, config, manifest, result)
        }
        return result
    }
    let readiness = ckbEvaluateScheduledFetchReadiness(profile, fetch, manifest)
    for (diagnostic in readiness.diagnostics) {
        result.validationDiagnostics.add("readiness:${diagnostic}")
    }
    if (!readiness.canPromote) {
        if (ckbScheduledCanPersistResolvedArtifacts(profile, readiness)) {
            ckbPersistScheduledResolvedMetadataArtifacts(store, profile, fetch, config, manifest, result, "readiness_content_degraded")
        }
        result.ok = false
        result.status = "scheduled_readiness_failed"
        return result
    }
    if (!fetch.ok) {
        fetch.ok = true
        fetch.status = "fetch_degraded_recovered"
        result.validationDiagnostics.add("fetch_degraded_recovered:requiredFailed=${readiness.requiredFailedCount}:optionalFailed=${readiness.optionalFailedCount}:recovered=${readiness.recoveredCount}")
    }
    if (profile.profile == "cangjie_source_event_sync") {
        return ckbIngestSourceEventTransaction(kb, store, profile, fetch, config,
            manifest, result, progressSink, stageSink, deadlineAtMillis,
            promotionBudgetPlan)
    }
    if (profile.profile == "cangjie_version_branch_refresh") {
        ckbPersistScheduledResolvedMetadataArtifacts(store, profile, fetch, config, manifest, result, "version_manifest_only")
        if (!result.ok) {
            return result
        }
        result.ok = true
        result.status = if (readiness.optionalContentFailedCount > 0 || ckbVersionBranchRefreshHasContentWarnings(fetch)) { "version_manifest_refreshed_with_content_warnings" } else { "version_manifest_refreshed" }
        result.validationStatus = "version_manifest_write_verified"
        ckbAddScheduledValidationGate(result, "version_manifest_write_verified")
        result.validationSummary = "version_manifest_refreshed sources=${fetch.fetchedCount} contentWarnings=${readiness.optionalContentFailedCount}"
        result.validationEvidenceHash = stableSummaryHash("${profile.profile}:${fetch.requestCount}:${fetch.fetchedCount}:${fetch.failedCount}:${result.status}")
        ckbWriteScheduledProfileStageCheckpoint(store, profile, "ingest_finished", result.status, ckbProfileIngestBudgetMillis(profile), deadlineAtMillis, "validationStatus=${result.validationStatus}|fetchRequests=${fetch.requestCount}|fetched=${fetch.fetchedCount}|failed=${fetch.failedCount}|contentWarnings=${readiness.optionalContentFailedCount}")
        result.validationDiagnostics.add("profile_stage_checkpoint:profile=${profile.profile}|stage=ingest_finished|status=${result.status}|budgetMs=${ckbProfileIngestBudgetMillis(profile)}|deadlineAtMillis=${deadlineAtMillis}|remainingMs=${ckbRemainingMillis(deadlineAtMillis)}")
        return result
    }
    if (profile.profile == "cangjie_version_branch_refresh") {
        ckbPersistScheduledResolvedMetadataArtifacts(store, profile, fetch, config, manifest, result, "metadata_resolved_before_content_promotion")
        if (!result.ok) {
            return result
        }
    }
    let delta = ckbScheduledTypedDeltaRecords(profile, fetch.records, config, manifest)
    if (ckbApplyScheduledIngestDeadline(result, profile, "ingest_delta_built", deadlineAtMillis)) {
        return result
    }
    if (delta.size == 0) {
        result.ok = false
        result.status = "scheduled_delta_empty"
        result.validationDiagnostics.add("scheduled_delta_empty:${profile.profile}:records=${fetch.records.size}")
        if (profile.profile == "cangjie_source_event_sync" && ckbScheduledCanPersistResolvedArtifacts(profile, readiness)) {
            ckbPersistScheduledRepositoryEventCheckpoint(store, profile, fetch, result)
        }
        return result
    }
    var ingestedRecords: Int64 = 0
    for (record in fetch.records) {
        if (record.fetch.ok && !(profile.profile == "cangjie_source_event_sync" &&
            !ckbRepositoryEventContentRecord(record))) {
            _ = kb.ingestFetchResult(record.sourceId, record.sourceType, record.fetch, record.title, TrustLevels.OFFICIAL, ReviewStates.TRUSTED)
        }
        ingestedRecords += 1
        if (ingestedRecords % 64 == 0 && ckbApplyScheduledIngestDeadline(result, profile, "ingest_records", deadlineAtMillis)) {
            return result
        }
    }
    if (ckbApplyScheduledIngestDeadline(result, profile, "ingest_records_finished", deadlineAtMillis)) {
        return result
    }
    let candidateVersion = ckbScheduledCandidateVersion(profile, fetch)
    let candidateRecords = if (profile.profile == "cangjie_source_event_sync") {
        ckbRepositoryEventCandidateOverlay(kb.activeRecordSnapshot(), delta, fetch.removedSourceIds)
    } else { kb.activeRecordSnapshotOverlay(delta) }
    let promotion = cangjiePromoteCandidateRecordsAfterValidationWithVersion(kb, store, candidateVersion, candidateRecords, progressSink: progressSink, stageSink: stageSink, deadlineAtMillis: deadlineAtMillis, budgetPlan: promotionBudgetPlan)
    ckbApplyScheduledPromotionResult(result, promotion, "candidate_validated_promoted")
    if (profile.profile == "cangjie_source_event_sync") {
        ckbPersistScheduledRepositoryEventCheckpoint(store, profile, fetch, result)
    }
    ckbWriteScheduledProfileStageCheckpoint(store, profile, "ingest_finished", result.status, ckbProfileIngestBudgetMillis(profile), deadlineAtMillis, "activeVersion=${result.activeVersion}|candidateVersion=${result.candidateVersion}|validationStatus=${result.validationStatus}")
    result.validationDiagnostics.add("profile_stage_checkpoint:profile=${profile.profile}|stage=ingest_finished|status=${result.status}|budgetMs=${ckbProfileIngestBudgetMillis(profile)}|deadlineAtMillis=${deadlineAtMillis}|remainingMs=${ckbRemainingMillis(deadlineAtMillis)}")
    result
}

private func ckbIngestSourceEventTransaction(kb: KnowledgeBase, store: FileKnowledgeStore,
    profile: CkbScheduleTaskProfile, fetch: CkbScheduledProfileFetchResult,
    config: CkbRuntimeConfig, manifest: CangjieVersionManifest,
    result: CkbScheduledProfileIngestResult, progressSink: VectorBuildProgressSink,
    stageSink: CkbStagedRebuildStageSink, deadlineAtMillis: Int64,
    promotionBudgetPlan: CangjieCandidatePromotionBudgetPlan): CkbScheduledProfileIngestResult {
    let delta = ckbScheduledSourceEventDeltaRecords(profile, fetch.records, config, manifest)
    if (delta.size == 0 && fetch.removedSourceIds.size == 0) {
        result.ok = false
        result.status = "scheduled_delta_empty"
        return result
    }
    let currentRaw = ArrayList<RawRecord>()
    for (record in fetch.records) {
        if (record.fetch.ok && ckbRepositoryEventContentRecord(record)) {
            currentRaw.add(ckbScheduledRawRecord(profile, record, config, manifest))
        }
    }
    let oldRaw = kb.rawRecordSnapshot()
    let oldNormalized = kb.activeRecordSnapshot()
    let removedRaw = ckbRepositoryEventRemovedRawIds(oldRaw, currentRaw,
        fetch.removedSourceIds, fetch.tombstones)
    let removedNormalized = ckbRepositoryEventRemovedNormalizedIds(oldNormalized,
        delta, fetch.removedSourceIds, fetch.tombstones)
    let candidateRaw = ckbRepositoryEventRawOverlay(oldRaw, currentRaw, removedRaw)
    let candidateNormalized = ckbRepositoryEventCandidateOverlay(oldNormalized, delta,
        removedNormalized)
    let candidateVersion = ckbScheduledCandidateVersion(profile, fetch)
    let candidateKb = kb.forkIsolatedCandidate()
    candidateKb.replaceRawRecords(candidateRaw)
    let acquisitionContext = ckbRepositoryEventCandidateAcquisitionContext(store,
        profile, fetch, candidateVersion, candidateNormalized)
    let promotion = cangjiePromoteCandidateRecordsAfterValidationWithVersion(candidateKb, store,
        candidateVersion, candidateNormalized, progressSink: progressSink,
        stageSink: stageSink, deadlineAtMillis: deadlineAtMillis,
        budgetPlan: promotionBudgetPlan, acquisitionContext: acquisitionContext,
        repositoryEventIdentity: fetch.eventIdentity)
    ckbApplyScheduledPromotionResult(result, promotion, "candidate_validated_promoted")
    if (!result.ok) {
        result.validationDiagnostics.add("repository_event_transaction_rolled_back")
    } else {
        let committed = store.loadActiveSnapshot()
        if (!kb.restoreActiveSnapshot(committed)) {
            // The transaction pointer is already committed. Keep business
            // success and require roll-forward recovery; do not falsely turn
            // it into a rollback-safe failure after the irreversible commit.
            result.ok = true
            result.status = "repository_event_committed_recovery_required"
            result.validationDiagnostics.add(result.status)
            let pointer = store.loadActiveSnapshotPointer()
            try {
                store.saveRepositoryEventRecoveryMarker(fetch.eventIdentity,
                    if (result.transactionId != "") { result.transactionId } else { pointer.txId },
                    if (pointer.activeVersion != "") { pointer.activeVersion } else { result.activeVersion },
                    ckbReleaseEvidenceHash("${pointer.txId}|${pointer.activeVersion}|${pointer.manifestHash}|${pointer.freshnessHash}|${pointer.coverageHash}"))
            } catch (_: Exception) {
                result.validationDiagnostics.add("repository_event_recovery_marker_shadow_write_failed")
            }
        } else {
            let txId = store.loadActiveSnapshotPointer().txId
            let consumed = try { store.consumeRepositoryEventRecoverySidecar(txId) } catch (_: Exception) { false }
            if (!consumed) {
                result.validationDiagnostics.add("repository_event_recovery_sidecar_consume_degraded")
            }
            result.validationDiagnostics.add("repository_event_transaction_committed:rawRemoved=${removedRaw.size}|normalizedRemoved=${removedNormalized.size}")
        }
    }
    ckbPersistScheduledRepositoryEventCheckpoint(store, profile, fetch, result)
    result
}

private func ckbRepositoryEventCandidateAcquisitionContext(store: FileKnowledgeStore,
    profile: CkbScheduleTaskProfile, fetch: CkbScheduledProfileFetchResult,
    candidateVersion: String, records: ArrayList<NormalizedRecord>): CkbCandidateAcquisitionContext {
    let context = CkbCandidateAcquisitionContext()
    context.taskId = profile.profile
    context.candidateVersion = candidateVersion
    context.planHash = fetch.eventIdentity
    context.acquisitionId = "p6-event-${ckbReleaseEvidenceHash("${fetch.eventIdentity}|${candidateVersion}")}"
    let current = ckbSchedulerReadProgressArtifact(store, "metadata/scheduler-current.ckb")
    context.schedulerRunId = if (ckbCurrentField(current, "taskName") == profile.profile) { ckbCurrentField(current, "runId") } else { if (fetch.runId != "") { fetch.runId } else { "repository-event" } }
    context.recordsEvidenceHash = ckbCandidateRecordsEvidenceHash(records,
        stagedCandidateVersion: candidateVersion)
    context
}

private func ckbRepositoryEventRawOverlay(active: ArrayList<RawRecord>,
    current: ArrayList<RawRecord>, removed: ArrayList<String>): ArrayList<RawRecord> {
    let replacements = HashSet<String>()
    for (record in current) { replacements.add(record.sourceId) }
    let removedSet = HashSet<String>(removed)
    let out = ArrayList<RawRecord>()
    for (record in active) {
        if (!replacements.contains(record.sourceId) && !removedSet.contains(record.sourceId)) { out.add(record) }
    }
    for (record in current) { out.add(record) }
    out
}

private func ckbRepositoryEventRemovedRawIds(active: ArrayList<RawRecord>,
    current: ArrayList<RawRecord>, removed: ArrayList<String>,
    tombstones: ArrayList<CkbRepositoryEventTombstone>): ArrayList<String> {
    let out = ArrayList<String>()
    for (item in removed) { addUniqueString(out, item) }
    for (record in active) {
        for (next in current) {
            if (record.metadata.docVersion != "" && next.metadata.docVersion != "" &&
                record.metadata.repo.toAsciiLower() == next.metadata.repo.toAsciiLower() &&
                record.metadata.path == next.metadata.path &&
                record.metadata.docVersion == next.metadata.docVersion &&
                record.sourceId.startsWith("scheduled-cangjie_source_event_sync-")) {
                addUniqueString(out, record.sourceId)
            }
        }
        if (ckbRepositoryEventRecordTombstoned(record.sourceId, record.metadata,
            tombstones)) {
            addUniqueString(out, record.sourceId)
        }
    }
    out
}

private func ckbRepositoryEventRemovedNormalizedIds(active: ArrayList<NormalizedRecord>,
    current: ArrayList<NormalizedRecord>, removed: ArrayList<String>,
    tombstones: ArrayList<CkbRepositoryEventTombstone>): ArrayList<String> {
    let out = ArrayList<String>()
    for (item in removed) { addUniqueString(out, item) }
    for (record in active) {
        for (next in current) {
            if (record.metadata.docVersion != "" && next.metadata.docVersion != "" &&
                record.metadata.repo.toAsciiLower() == next.metadata.repo.toAsciiLower() &&
                record.metadata.path == next.metadata.path &&
                record.metadata.docVersion == next.metadata.docVersion &&
                record.sourceId.startsWith("scheduled-cangjie_source_event_sync-")) {
                addUniqueString(out, record.sourceId)
            }
        }
        if (ckbRepositoryEventRecordTombstoned(record.sourceId, record.metadata,
            tombstones)) {
            addUniqueString(out, record.sourceId)
        }
    }
    out
}

private func ckbRepositoryEventRecordTombstoned(sourceId: String,
    metadata: KnowledgeMetadata,
    tombstones: ArrayList<CkbRepositoryEventTombstone>): Bool {
    for (tombstone in tombstones) {
        if (sourceId == tombstone.sourceId) {
            return true
        }
        if (tombstone.ref != "" && metadata.docVersion != "" &&
            metadata.repo.toAsciiLower() == tombstone.repo.toAsciiLower() &&
            metadata.path == tombstone.path && metadata.docVersion == tombstone.ref) {
            return true
        }
    }
    false
}

private func ckbRepositoryEventCandidateOverlay(active: ArrayList<NormalizedRecord>,
    delta: ArrayList<NormalizedRecord>, removedSourceIds: ArrayList<String>): ArrayList<NormalizedRecord> {
    let replacement = HashSet<String>()
    for (record in delta) { replacement.add(record.sourceId) }
    let removed = HashSet<String>(removedSourceIds)
    let out = ArrayList<NormalizedRecord>()
    for (record in active) {
        if (!replacement.contains(record.sourceId) && !removed.contains(record.sourceId)) {
            out.add(record)
        }
    }
    for (record in delta) { out.add(record) }
    out
}

private func ckbIngestReleaseFullSync(kb: KnowledgeBase, store: FileKnowledgeStore, profile: CkbScheduleTaskProfile, fetch: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, manifest: CangjieVersionManifest, result: CkbScheduledProfileIngestResult, progressSink: VectorBuildProgressSink, stageSink: CkbStagedRebuildStageSink, deadlineAtMillis: Int64, promotionBudgetPlan: CangjieCandidatePromotionBudgetPlan): CkbScheduledProfileIngestResult {
    if (!fetch.ok || !fetch.releasePlan.ok || !ckbReleaseAllInventoriesComplete(fetch.releasePlan, fetch.releaseInventories)) {
        result.ok = false
        result.status = if (fetch.status == "" || fetch.status == "profile_ok") { "release_inventory_incomplete" } else { fetch.status }
        result.validationStatus = result.status
        result.validationDiagnostics.add("release_full_sync_acquisition_failed:status=${result.status}|plan=${fetch.releasePlan.status}|inventories=${fetch.releaseInventories.size}|plannedSources=${fetch.releasePlan.sources.size}")
        return result
    }
    if (ckbApplyScheduledIngestDeadline(result, profile, "release_delta_before", deadlineAtMillis)) {
        return result
    }
    let provisionalCandidateVersion = ckbScheduledCandidateVersion(profile, fetch)
    let noRemovedRaw = ArrayList<String>()
    let noRemovedNormalized = ArrayList<String>()
    let refreshedManifest = ckbRefreshVersionManifestFromScheduledFetch(profile, fetch, config, manifest)
    let provisionalBundle = ckbPrepareReleaseCommitBundle(profile, fetch, refreshedManifest,
        provisionalCandidateVersion, cangjieActiveVersionForCandidate(provisionalCandidateVersion), noRemovedRaw,
        noRemovedNormalized)
    if (!provisionalBundle.valid) {
        result.ok = false
        result.status = provisionalBundle.status
        result.validationStatus = provisionalBundle.status
        for (diagnostic in provisionalBundle.diagnostics) {
            result.validationDiagnostics.add("release_bundle:${diagnostic}")
        }
        return result
    }
    let delta = ckbBuildReleaseDelta(profile, fetch, config, provisionalBundle.manifest)
    ckbEmitStagedRebuildStage(stageSink, "ingest_delta_built",
        delta.status, deadlineAtMillis,
        "rawCount=${delta.rawRecords.size}|normalizedCount=${delta.normalizedRecords.size}",
        itemCount: delta.normalizedRecords.size,
        typedEvent: "routine.ingest.delta_built",
        deltaCount: delta.normalizedRecords.size)
    for (diagnostic in delta.diagnostics) {
        result.validationDiagnostics.add("release_delta:${diagnostic}")
    }
    if (!delta.ok) {
        result.ok = false
        result.status = delta.status
        result.validationStatus = delta.status
        return result
    }
    if (delta.rawRecords.size == 0 || delta.normalizedRecords.size == 0) {
        result.ok = false
        result.status = "scheduled_delta_empty"
        result.validationStatus = result.status
        result.validationDiagnostics.add("scheduled_delta_empty:${profile.profile}:raw=${delta.rawRecords.size}|normalized=${delta.normalizedRecords.size}")
        return result
    }
    let targetVersion = fetch.releasePlan.targetVersion
    let owner = "scheduled:${profile.profile}"
    let oldRaw = kb.rawRecordSnapshot()
    let removedRawIds = ckbReleaseRemovedRawIds(oldRaw, delta.rawRecords, fetch.releasePlan, owner, targetVersion)
    let activeBefore = kb.activeRecordSnapshot()
    let removedNormalizedIds = ckbReleaseRemovedNormalizedIds(activeBefore, delta.normalizedRecords, fetch.releasePlan, owner, targetVersion)
    let candidateRaw = kb.rawRecordSnapshotOverlayForOwner(owner, targetVersion, removedRawIds, delta.rawRecords)
    let candidateRecords = kb.activeRecordSnapshotOverlayForOwner(delta.normalizedRecords, owner, targetVersion, removedNormalizedIds)
    let candidateEvidence = ckbCandidateBusinessEvidence(candidateRaw, candidateRecords)
    if (!candidateEvidence.valid) {
        result.ok = false
        result.status = candidateEvidence.status
        result.validationStatus = candidateEvidence.status
        result.validationDiagnostics.add("release_candidate_business_evidence_invalid:status=${candidateEvidence.status}")
        return result
    }
    let derivedCandidateVersion = ckbReleaseCandidateVersionForBusinessEvidence(
        profile, fetch, candidateEvidence)
    let persistedSnapshot = store.loadActiveSnapshot()
    let sameActiveBusiness = ckbReleaseCandidateBusinessMatchesActiveSnapshot(
        persistedSnapshot, candidateEvidence)
    let effectiveCandidateVersion = if (sameActiveBusiness) {
        persistedSnapshot.candidateVersion
    } else { derivedCandidateVersion }
    let effectiveActiveVersion = if (sameActiveBusiness) {
        persistedSnapshot.activeVersion
    } else { cangjieActiveVersionForCandidate(derivedCandidateVersion) }
    let releaseBundle = ckbPrepareReleaseCommitBundle(profile, fetch, refreshedManifest,
        effectiveCandidateVersion, effectiveActiveVersion, noRemovedRaw,
        noRemovedNormalized)
    ckbFinalizeReleaseCommitBundleRemoved(releaseBundle, removedRawIds, removedNormalizedIds)
    if (!releaseBundle.valid) {
        result.ok = false
        result.status = releaseBundle.status
        result.validationStatus = releaseBundle.status
        for (diagnostic in releaseBundle.diagnostics) {
            result.validationDiagnostics.add("release_bundle:${diagnostic}")
        }
        return result
    }
    result.validationDiagnostics.add("release_reconciliation:owner=${owner}|target=${targetVersion}|rawBefore=${oldRaw.size}|rawCurrent=${delta.rawRecords.size}|rawRemoved=${removedRawIds.size}|rawCandidate=${candidateRaw.size}|activeBefore=${activeBefore.size}|activeCurrent=${delta.normalizedRecords.size}|activeRemoved=${removedNormalizedIds.size}|activeCandidate=${candidateRecords.size}")
    result.validationDiagnostics.add(ckbReleaseRemovedIdsDiagnostic("raw", removedRawIds))
    result.validationDiagnostics.add(ckbReleaseRemovedIdsDiagnostic("normalized", removedNormalizedIds))
    result.validationDiagnostics.add("release_candidate_business_evidence:raw=${candidateEvidence.rawCount}|normalized=${candidateEvidence.normalizedCount}|rawEvidence=${candidateEvidence.rawEvidenceHash}|normalizedEvidence=${candidateEvidence.normalizedEvidenceHash}|evidenceHash=${candidateEvidence.aggregateEvidenceHash}")
    if (ckbApplyScheduledIngestDeadline(result, profile, "release_candidate_before", deadlineAtMillis)) {
        return result
    }
    if (sameActiveBusiness) {
        if (!ckbApplyReleaseIdempotentNoop(kb, store, persistedSnapshot,
            candidateRaw, candidateRecords, candidateEvidence, releaseBundle,
            result, deadlineAtMillis)) {
            return result
        }
    } else {
        kb.replaceRawRecords(candidateRaw)
        let acquisitionContext = ckbReleaseCandidateAcquisitionContext(store, profile, fetch,
            derivedCandidateVersion, candidateRecords)
        let promotion = cangjiePromoteCandidateRecordsAfterValidationWithVersion(kb, store,
            derivedCandidateVersion, candidateRecords, progressSink: progressSink,
            stageSink: stageSink, deadlineAtMillis: deadlineAtMillis,
            budgetPlan: promotionBudgetPlan, acquisitionContext: acquisitionContext,
            releaseBundle: releaseBundle)
        ckbApplyScheduledPromotionResult(result, promotion, "candidate_validated_promoted")
        ckbApplyReleaseContractEvidence(result, promotion, releaseBundle, store)
        if (!result.ok) {
            kb.replaceRawRecords(oldRaw)
            result.validationDiagnostics.add("release_reconciliation_rolled_back:status=${result.status}|rawRestored=${oldRaw.size}")
            return result
        }
    }
    if (result.ok) {
        let consumed = ckbConsumeReleaseAcquisitionStatesBestEffort(store,
            fetch.releaseAcquisitionKeys, result.candidateVersion,
            result.activeVersion, result.validationDiagnostics)
        result.validationDiagnostics.add("release_acquisitions_consumed:count=${consumed.consumed}|failed=${consumed.failed}|total=${fetch.releaseAcquisitionKeys.size}|planHash=${fetch.releasePlan.planHash}")
    }
    try {
        ckbWriteScheduledProfileStageCheckpoint(store, profile, "ingest_finished", result.status, ckbProfileIngestBudgetMillis(profile), deadlineAtMillis, "activeVersion=${result.activeVersion}|candidateVersion=${result.candidateVersion}|validationStatus=${result.validationStatus}|rawCurrent=${delta.rawRecords.size}|activeCurrent=${delta.normalizedRecords.size}")
        result.validationDiagnostics.add("profile_stage_checkpoint:profile=${profile.profile}|stage=ingest_finished|status=${result.status}|budgetMs=${ckbProfileIngestBudgetMillis(profile)}|deadlineAtMillis=${deadlineAtMillis}|remainingMs=${ckbRemainingMillis(deadlineAtMillis)}")
    } catch (e: Exception) {
        result.validationDiagnostics.add("release_ingest_checkpoint_degraded:${utf8SafePrefix(redactSensitive(if (e.message == "") { "write_failed" } else { e.message }), 160)}")
    }
    result
}

private func ckbReleaseCandidateVersionForBusinessEvidence(profile: CkbScheduleTaskProfile,
    fetch: CkbScheduledProfileFetchResult,
    evidence: CkbCandidateBusinessEvidence): String {
    if (!evidence.valid || profile.profile != "cangjie_release_full_sync" ||
        !fetch.releasePlan.ok || fetch.releasePlan.planHash == "") {
        return ""
    }
    let identity = "p5-release-candidate-business-v1|profile=${profile.profile}|" +
        "plan=${fetch.releasePlan.planHash}|evidence=${evidence.aggregateEvidenceHash}"
    "ckb-scheduled-${ckbReleaseEvidenceHash(identity)}-candidate"
}

private func ckbReleaseCandidateBusinessMatchesActiveSnapshot(snapshot: ActiveSnapshot,
    candidate: CkbCandidateBusinessEvidence): Bool {
    if (!snapshot.valid || snapshot.activeVersion == "" ||
        snapshot.candidateVersion == "" || snapshot.vectorActiveCollection == "" ||
        !candidate.valid) {
        return false
    }
    let normalizedEvidence = ckbCandidateBusinessEvidence(snapshot.rawRecords,
        snapshot.normalizedRecords)
    let activeEvidence = ckbCandidateBusinessEvidence(snapshot.rawRecords,
        snapshot.activeIndex)
    ckbCandidateBusinessEvidenceMatches(candidate, normalizedEvidence) &&
        ckbCandidateBusinessEvidenceMatches(candidate, activeEvidence)
}

private func ckbApplyReleaseIdempotentNoop(kb: KnowledgeBase,
    store: FileKnowledgeStore, snapshot: ActiveSnapshot,
    candidateRaw: ArrayList<RawRecord>, candidateRecords: ArrayList<NormalizedRecord>,
    candidateEvidence: CkbCandidateBusinessEvidence, bundle: CkbReleaseCommitBundle,
    result: CkbScheduledProfileIngestResult, deadlineAtMillis: Int64): Bool {
    if (!ckbReleaseCandidateBusinessMatchesActiveSnapshot(snapshot,
        candidateEvidence)) {
        return ckbReleaseIdempotentNoopFailure(result,
            "candidate_business_evidence_mismatch")
    }
    let directCandidateEvidence = ckbCandidateBusinessEvidence(candidateRaw,
        candidateRecords)
    if (!ckbCandidateBusinessEvidenceMatches(candidateEvidence,
        directCandidateEvidence)) {
        return ckbReleaseIdempotentNoopFailure(result,
            "candidate_business_evidence_changed")
    }
    if (!bundle.valid || bundle.status != "release_commit_bundle_prepared" ||
        bundle.candidateVersion != snapshot.candidateVersion ||
        bundle.activeVersion != snapshot.activeVersion) {
        return ckbReleaseIdempotentNoopFailure(result,
            "release_bundle_identity_mismatch")
    }
    let pointer = store.loadActiveSnapshotPointer()
    let supportedMode = pointer.companionMode == CkbActiveSnapshotCompanionMode.RELEASE ||
        pointer.companionMode == CkbActiveSnapshotCompanionMode.COPY_FORWARD
    if (!pointer.valid || pointer.legacy || !supportedMode || pointer.txId == "" ||
        pointer.activeVersion != snapshot.activeVersion ||
        pointer.vectorActiveCollection != snapshot.vectorActiveCollection) {
        return ckbReleaseIdempotentNoopFailure(result,
            "active_pointer_invalid_or_misaligned")
    }
    let commit = try {
        store.readText("transactions/${safeName(pointer.txId)}/COMMIT")
    } catch (_: Exception) {
        return ckbReleaseIdempotentNoopFailure(result,
            "active_commit_unreadable")
    }
    let persistVectorFile = ckbCurrentField(commit, "persistVectorFile")
    if (ckbCurrentField(commit, "schema") != "ckb-active-commit-v2" ||
        ckbCurrentField(commit, "txId") != pointer.txId ||
        ckbCurrentField(commit, "active") != pointer.activeVersion ||
        ckbCurrentField(commit, "vectorActiveCollection") !=
            pointer.vectorActiveCollection ||
        ckbCurrentField(commit, "companionMode") != pointer.companionMode ||
        (persistVectorFile != "true" && persistVectorFile != "false") ||
        !ckbValidationEvidenceIsSha256(ckbCurrentField(commit, "payloadHash")) ||
        ckbCurrentField(commit, "manifestHash") != pointer.manifestHash ||
        ckbCurrentField(commit, "freshnessHash") != pointer.freshnessHash ||
        ckbCurrentField(commit, "coverageHash") != pointer.coverageHash ||
        ckbCurrentField(commit, "committed") != "true") {
        return ckbReleaseIdempotentNoopFailure(result,
            "active_commit_invalid_or_misaligned")
    }
    let companions = store.loadActiveSnapshotCompanionCopy()
    if (!companions.provided || !companions.valid ||
        companions.mode != pointer.companionMode ||
        !ckbValidationEvidenceIsSha256(pointer.manifestHash) ||
        !ckbValidationEvidenceIsSha256(pointer.freshnessHash) ||
        !ckbValidationEvidenceIsSha256(pointer.coverageHash) ||
        companions.manifestHash != pointer.manifestHash ||
        companions.freshnessHash != pointer.freshnessHash ||
        companions.coverageHash != pointer.coverageHash ||
        companions.manifestText != ckbRenderCangjieVersionManifestArtifact(bundle.manifest) ||
        companions.freshnessText != ckbRenderCangjieFreshnessArtifact(bundle.freshness) ||
        companions.coverageText == "") {
        return ckbReleaseIdempotentNoopFailure(result,
            "active_companions_not_current_run_exact")
    }
    if (pointer.manifestHash != bundle.manifestEvidenceHash ||
        pointer.freshnessHash != bundle.freshnessEvidenceHash ||
        !ckbReleaseCoverageCommitEvidenceValid(bundle.coverage) ||
        !ckbReleaseRemovedCommitEvidenceValid(bundle.removed)) {
        return ckbReleaseIdempotentNoopFailure(result,
            "release_companion_evidence_mismatch")
    }
    let persistedManifest = try {
        ckbParseCangjieVersionManifestArtifact(companions.manifestText)
    } catch (_: Exception) {
        return ckbReleaseIdempotentNoopFailure(result,
            "release_manifest_malformed")
    }
    let persistedFreshness = try {
        ckbParseCangjieFreshnessArtifact(companions.freshnessText)
    } catch (_: Exception) {
        return ckbReleaseIdempotentNoopFailure(result,
            "release_freshness_malformed")
    }
    if (!ckbRoutineReleaseManifestHasExactSources(persistedManifest) ||
        !persistedFreshness.ok || persistedFreshness.degraded ||
        persistedFreshness.sources.size != 5 ||
        persistedFreshness.activeKnowledgeVersion != snapshot.activeVersion ||
        persistedFreshness.candidateKnowledgeVersion != snapshot.candidateVersion ||
        persistedFreshness.failedCandidateVersion != "" ||
        !ckbReleaseManifestCoverageCommitAligned(persistedManifest,
            bundle.coverage) ||
        !ckbReleaseFreshnessManifestCommitAligned(persistedFreshness,
            persistedManifest, snapshot.activeVersion)) {
        return ckbReleaseIdempotentNoopFailure(result,
            "release_manifest_freshness_semantic_mismatch")
    }
    let coverage = store.routineReleaseCoverageSummary(
        "transactions/${safeName(pointer.txId)}/metadata/cangjie-release-coverage.ckb")
    if (!coverage.valid || coverage.sourceCoverageEvidenceHash !=
        bundle.coverage.aggregateEvidenceHash) {
        return ckbReleaseIdempotentNoopFailure(result,
            "release_coverage_summary_mismatch")
    }
    let vectorStatus = kb.vectorCollectionStatus(pointer.vectorActiveCollection)
    if (vectorStatus.state != EmbeddingProviderState.READY ||
        vectorStatus.count != snapshot.activeIndex.size ||
        vectorStatus.dimension <= 0 || vectorStatus.degradedReason != "" ||
        (vectorStatus.collection != "" &&
            vectorStatus.collection != pointer.vectorActiveCollection)) {
        return ckbReleaseIdempotentNoopFailure(result,
            "active_vector_not_ready_or_misaligned")
    }
    let validation = validateCandidateServingIndexWithVectorStatus(
        snapshot.activeIndex, snapshot.candidateVersion, vectorStatus,
        deadlineAtMillis: deadlineAtMillis,
        validationScope: "candidate_promotion")
    if (!validation.ok || validation.status != "candidate_validation_passed" ||
        validation.candidateVersion != snapshot.candidateVersion ||
        validation.activeVersion != snapshot.activeVersion ||
        validation.servingDocumentCount <= 0 ||
        !ckbValidationEvidenceIsSha256(validation.evidenceHash)) {
        for (diagnostic in validation.diagnostics) {
            result.validationDiagnostics.add(diagnostic)
        }
        return ckbReleaseIdempotentNoopFailure(result,
            "candidate_validation_failed")
    }
    result.ok = true
    result.status = "candidate_validated_promoted"
    result.candidateVersion = snapshot.candidateVersion
    result.activeVersion = snapshot.activeVersion
    result.validationStatus = validation.status
    result.validationSummary = renderCangjieCandidateValidationSummary(validation)
    result.validationEvidenceHash = validation.evidenceHash
    result.transactionId = pointer.txId
    result.manifestEvidenceHash = pointer.manifestHash
    result.freshnessEvidenceHash = pointer.freshnessHash
    result.sourceCoverageEvidenceHash = coverage.sourceCoverageEvidenceHash
    result.inventoryEvidenceHash = coverage.inventoryEvidenceHash
    for (diagnostic in validation.diagnostics) {
        result.validationDiagnostics.add(diagnostic)
    }
    ckbAddScheduledValidationGate(result, "candidate_validation_passed")
    ckbAddScheduledValidationGate(result, "active_companion_transaction_verified")
    ckbAddScheduledValidationGate(result, "version_manifest_write_verified")
    ckbAddScheduledValidationGate(result, "release_source_coverage_verified")
    ckbAddScheduledValidationGate(result, "release_removed_reconciliation_verified")
    result.validationDiagnostics.add("release_idempotent_noop_verified:tx=${ckbReleaseEvidenceHash(pointer.txId)}|candidateEvidence=${candidateEvidence.aggregateEvidenceHash}|freshRemovedEvidence=${bundle.removed.aggregateEvidenceHash}|persistedInventoryEvidence=${coverage.inventoryEvidenceHash}|sourceCoverageEvidence=${coverage.sourceCoverageEvidenceHash}|mode=${pointer.companionMode}")
    true
}

private func ckbReleaseIdempotentNoopFailure(
    result: CkbScheduledProfileIngestResult, reason: String): Bool {
    result.ok = false
    result.status = "release_idempotent_noop_verification_failed"
    result.validationStatus = result.status
    result.validationDiagnostics.add("release_idempotent_noop_verification_failed:reason=${reason}")
    false
}

func ckbConsumeReleaseAcquisitionStatesBestEffort(store: FileKnowledgeStore,
    keys: ArrayList<CkbScheduledFetchRunKey>, candidateVersion: String,
    activeVersion: String, diagnostics: ArrayList<String>): CkbReleaseAcquisitionConsumeResult {
    let result = CkbReleaseAcquisitionConsumeResult()
    for (key in keys) {
        try {
            ckbMarkReleaseAcquisitionState(store, key, "consumed",
                candidateVersion: candidateVersion, activeVersion: activeVersion)
            result.consumed += 1
        } catch (e: Exception) {
            result.failed += 1
            let failure = if (e.message == "") { "write_failed" } else { e.message }
            diagnostics.add("release_acquisition_consume_degraded:key=${ckbReleaseEvidenceHash(key.runIdentityHash)}|diagnostic=${utf8SafePrefix(redactSensitive(failure), 160)}")
        }
    }
    result
}

private func ckbReleaseCandidateAcquisitionContext(store: FileKnowledgeStore, profile: CkbScheduleTaskProfile, fetch: CkbScheduledProfileFetchResult, candidateVersion: String, records: ArrayList<NormalizedRecord>): CkbCandidateAcquisitionContext {
    let context = CkbCandidateAcquisitionContext()
    context.taskId = profile.profile
    context.candidateVersion = candidateVersion
    context.planHash = fetch.releasePlan.planHash
    context.acquisitionId = "p5-candidate-${ckbReleaseEvidenceHash("${profile.profile}|${fetch.releasePlan.planHash}|${candidateVersion}")}"
    let current = ckbSchedulerReadProgressArtifact(store, "metadata/scheduler-current.ckb")
    context.schedulerRunId = if (ckbCurrentField(current, "taskName") == profile.profile) { ckbCurrentField(current, "runId") } else { fetch.runId }
    context.recordsEvidenceHash = ckbCandidateRecordsEvidenceHash(records, stagedCandidateVersion: candidateVersion)
    context
}

private func ckbReleaseDigestHex(digest: SHA256): String {
    let out = StringBuilder()
    for (byte in digest.finish()) {
        out.append(ckbReleaseDigestHexNibble(byte / UInt8(16)))
        out.append(ckbReleaseDigestHexNibble(byte % UInt8(16)))
    }
    out.toString()
}

private func ckbReleaseDigestHexNibble(value: UInt8): String {
    if (value == UInt8(0)) { return "0" }; if (value == UInt8(1)) { return "1" }
    if (value == UInt8(2)) { return "2" }; if (value == UInt8(3)) { return "3" }
    if (value == UInt8(4)) { return "4" }; if (value == UInt8(5)) { return "5" }
    if (value == UInt8(6)) { return "6" }; if (value == UInt8(7)) { return "7" }
    if (value == UInt8(8)) { return "8" }; if (value == UInt8(9)) { return "9" }
    if (value == UInt8(10)) { return "a" }; if (value == UInt8(11)) { return "b" }
    if (value == UInt8(12)) { return "c" }; if (value == UInt8(13)) { return "d" }
    if (value == UInt8(14)) { return "e" }
    "f"
}

func ckbReleaseRemovedIdsEvidenceHash(sourceIds: ArrayList<String>): String {
    let ordered = sourceIds.toArray()
    sort(ordered)
    let seed = StringBuilder()
    for (sourceId in ordered) {
        seed.append(sourceId)
        seed.append("\n")
    }
    ckbReleaseEvidenceHash(seed.toString())
}

private func ckbReleaseRemovedIdsDiagnostic(kind: String, sourceIds: ArrayList<String>): String {
    let ordered = sourceIds.toArray()
    sort(ordered)
    let preview = StringBuilder()
    var count: Int64 = 0
    for (sourceId in ordered) {
        if (count >= 8) { break }
        if (count > 0) { preview.append(",") }
        preview.append(utf8SafePrefix(redactSensitive(sourceId), 120))
        count += 1
    }
    "release_reconciliation_removed_${kind}:count=${sourceIds.size}|evidenceHash=${ckbReleaseRemovedIdsEvidenceHash(sourceIds)}|preview=${preview.toString()}|previewTruncated=${sourceIds.size > 8}"
}

private func ckbApplyScheduledIngestDeadline(result: CkbScheduledProfileIngestResult, profile: CkbScheduleTaskProfile, stage: String, deadlineAtMillis: Int64): Bool {
    if (profile.profile != "cangjie_release_full_sync") {
        return false
    }
    let deadline = ckbDeadlineGuard(stage, deadlineAtMillis)
    if (!deadline.exceeded) {
        return false
    }
    result.ok = false
    result.status = "ingest_deadline_exceeded"
    result.validationStatus = "ingest_deadline_exceeded"
    result.validationDiagnostics.add("ingest_deadline_exceeded:stage=${stage}|remainingMillis=${deadline.remainingMillis}")
    true
}

private func ckbVersionBranchRefreshHasContentWarnings(fetch: CkbScheduledProfileFetchResult): Bool {
    for (diagnostic in fetch.diagnostics) {
        if (diagnostic.contains("manifest_source_content_sample_degraded") ||
            diagnostic.contains("source_tree_no_candidate") ||
            diagnostic.contains("source_tree_empty_after_pages") ||
            diagnostic.contains("gitcode_tree_page_failed") ||
            diagnostic.contains("source_contents_snapshot_failed") ||
            diagnostic.contains("manifest_content_sample_skipped_deadline") ||
            diagnostic.contains("version_branch_refresh_optional_content_skipped")) {
            return true
        }
    }
    false
}

private func ingestScheduledBenchmarkGapCuration(kb: KnowledgeBase, store: FileKnowledgeStore, profile: CkbScheduleTaskProfile, config: CkbRuntimeConfig, manifest: CangjieVersionManifest, progressSink!: VectorBuildProgressSink = NoopVectorBuildProgressSink(), deadlineAtMillis!: Int64 = 0): CkbScheduledProfileIngestResult {
    let result = CkbScheduledProfileIngestResult()
    let inputPath = ckbBenchmarkGapCurationInputPath(config, store)
    if (inputPath == "") {
        result.ok = false
        result.status = "benchmark_gap_curation_input_missing"
        return result
    }
    if (!exists(Path(inputPath))) {
        result.ok = false
        result.status = "benchmark_gap_curation_input_not_found"
        return result
    }
    let curationBytes = try {
        File.readFrom(Path(inputPath))
    } catch (_: Exception) {
        result.ok = false
        result.status = "input_read_failed"
        result.validationDiagnostics.add("benchmark_gap_input_gate:errorCode=input_read_failed")
        return result
    }
    if (curationBytes.size > ckbBenchmarkGapCurationMaxInputBytes()) {
        result.ok = false
        result.status = "benchmark_gap_curation_input_too_large"
        result.validationDiagnostics.add("benchmark_gap_input_gate:bytes=${curationBytes.size}:maxBytes=${ckbBenchmarkGapCurationMaxInputBytes()}")
        return result
    }
    let curationText = try {
        String.fromUtf8(curationBytes)
    } catch (_: Exception) {
        result.ok = false
        result.status = "invalid_response_encoding"
        result.validationDiagnostics.add("benchmark_gap_input_gate:errorCode=invalid_response_encoding:bytes=${curationBytes.size}")
        return result
    }
    if (curationText.trimAscii() == "") {
        result.ok = false
        result.status = "benchmark_gap_curation_input_empty"
        return result
    }
    let curated = curateBenchmarkGapRecordsFromJsonl(curationText, targetVersion: config.benchmarkGapTargetVersion)
    if (!curated.ok) {
        result.ok = false
        result.status = curated.diagnostic
        for (diagnostic in curated.diagnostics) {
            result.validationDiagnostics.add("benchmark_gap_input_rejected:${utf8SafePrefix(redactSensitive(diagnostic), 240)}")
        }
        return result
    }
    let inputHash = ckbReleaseEvidenceHash(curationText)
    let scanPlan = ckbBuildBenchmarkGapScanPlan(curated.records, curationText,
        config.benchmarkGapTargetVersion, runId: "benchmark-gap-${inputHash}",
        batchSize: ckbBenchmarkGapCurationBatchSize())
    if (!scanPlan.valid) {
        result.ok = false
        result.status = scanPlan.errorCode
        return result
    }
    var persistedPlan = ckbLoadBenchmarkGapScanPlan(store, scanPlan.planHash,
        scanPlan.inputSha256, scanPlan.targetVersion)
    if (persistedPlan.errorCode == "benchmark_gap_scan_plan_not_found") {
        persistedPlan = ckbSaveBenchmarkGapScanPlan(store, scanPlan)
    }
    if (!persistedPlan.valid) {
        result.ok = false
        result.status = persistedPlan.errorCode
        return result
    }
    _ = ckbPersistBenchmarkGapLifecycleEvent(store, scanPlan.runId, "planned", "planned",
        scanPlan.planHash, "", "durable scan plan", completed: persistedPlan.nextOffset,
        total: scanPlan.total)
    result.validationDiagnostics.add("benchmark_gap_input_gate:bytes=${curationBytes.size}:accepted=${curated.records.size}:rejected=${curated.rejected}:batchSize=${ckbBenchmarkGapCurationBatchSize()}:inputHash=${inputHash}:planHash=${scanPlan.planHash}")
    _ = ckbPersistBenchmarkGapLifecycleEvent(store, scanPlan.runId, "accepted", "accepted", scanPlan.planHash, "", "accepted input", completed: curated.records.size, total: scanPlan.total)
    if (persistedPlan.state != "complete") {
        let nowMillis = ckbCoreNowMillis()
        let claim = ckbClaimBenchmarkGapScanPlan(store, scanPlan.planHash, scanPlan.inputSha256,
            scanPlan.targetVersion, "scheduler-${profile.profile}", nowMillis, 60000)
        result.validationDiagnostics.add("benchmark_gap_scan_plan:planHash=${scanPlan.planHash}:total=${scanPlan.total}:batchSize=${scanPlan.batchSize}:batchStart=${claim.startOffset}:batchEnd=${claim.endOffset}:revision=${claim.plan.revision}:state=${claim.state}:errorCode=${claim.errorCode}")
        if (!claim.claimed) {
            result.ok = false
            result.status = claim.errorCode
            result.validationStatus = result.status
            return result
        }
        _ = ckbPersistBenchmarkGapLifecycleEvent(store, scanPlan.runId, "claimed", "claimed",
            scanPlan.planHash, "", "scan batch claimed", completed: claim.startOffset,
            total: scanPlan.total)
        let batch = ckbSaveBenchmarkGapCandidateBatch(store, scanPlan, curated.records,
            claim.startOffset, claim.endOffset)
        if (!batch.ok) {
            result.ok = false
            result.status = batch.errorCode
            result.validationStatus = result.status
            return result
        }
        persistedPlan = ckbCheckpointBenchmarkGapScanPlan(store, scanPlan.planHash,
            scanPlan.inputSha256, scanPlan.targetVersion, claim.plan.owner, claim.plan.revision,
            claim.startOffset, claim.endOffset, nowMillis + 1)
        if (!persistedPlan.valid) {
            result.ok = false
            result.status = persistedPlan.errorCode
            result.validationStatus = result.status
            return result
        }
        result.validationDiagnostics.add("benchmark_gap_candidate_batch:planHash=${scanPlan.planHash}:start=${batch.startOffset}:end=${batch.endOffset}:count=${batch.written}:evidenceHash=${batch.evidenceHash}")
        _ = ckbPersistBenchmarkGapLifecycleEvent(store, scanPlan.runId, "batch_checkpointed", "checkpointed", scanPlan.planHash, "", "candidate batch", completed: batch.endOffset, total: scanPlan.total)
        if (persistedPlan.state != "complete") {
            result.ok = false
            result.status = "benchmark_gap_scan_batch_checkpointed"
            result.validationStatus = result.status
            return result
        }
    }
    ckbWriteScheduledProfileStageCheckpoint(store, profile, "input_parsed", "ok", profile.ingestBudgetMillis, deadlineAtMillis, "accepted=${curated.records.size}|rejected=${curated.rejected}|inputHash=${inputHash}|planHash=${scanPlan.planHash}")
    result.validationDiagnostics.add("profile_stage_checkpoint:profile=${profile.profile}|stage=input_parsed|status=ok|budgetMs=${profile.ingestBudgetMillis}|deadlineAtMillis=${deadlineAtMillis}|remainingMs=${ckbRemainingMillis(deadlineAtMillis)}")
    let aggregate = ckbLoadBenchmarkGapCandidateBatches(store, scanPlan, curated.records)
    if (!aggregate.ok) {
        result.ok = false
        result.status = aggregate.errorCode
        result.validationStatus = result.status
        return result
    }
    let fetch = CkbScheduledProfileFetchResult()
    fetch.requestCount = curated.accepted
    fetch.fetchedCount = curated.accepted
    let candidateVersion = "ckb-benchmark-${scanPlan.planHash}-candidate"
    let recoveredTerminal = ckbLoadBenchmarkGapLastSuccessForPlan(store, scanPlan.planHash)
    if (recoveredTerminal.valid) {
        let pointer = store.loadActiveSnapshotPointer()
        if (pointer.valid && pointer.txId == recoveredTerminal.transactionId && pointer.activeVersion == recoveredTerminal.activeVersion) {
            let snapshot=store.loadActiveSnapshot();if(snapshot.valid){_=kb.restoreActiveSnapshot(snapshot)}
            result.ok=true;result.status="candidate_validated_promoted";result.validationStatus="curation_checkpoint_verified";result.candidateVersion=recoveredTerminal.candidateVersion;result.activeVersion=recoveredTerminal.activeVersion;result.transactionId=recoveredTerminal.transactionId
            for(g in ["curation_input_verified","curation_plan_complete","candidate_validation_passed","query_proof_complete","active_transaction_verified","curation_checkpoint_verified"]){result.validationGates.add(g)}
            result.validationDiagnostics.add("benchmark_gap_commit_recovered:planHash=${scanPlan.planHash}:tx=${ckbReleaseEvidenceHash(pointer.txId)}")
            _ = ckbPersistBenchmarkGapLifecycleEvent(store, scanPlan.runId, "duplicate",
                "terminal_skip", scanPlan.planHash, recoveredTerminal.candidateVersion,
                "terminal already committed", completed: recoveredTerminal.completed,
                total: recoveredTerminal.total)
            return result
        }
    }
    let candidateRecords = overlayBenchmarkGapRecords(kb.activeRecordSnapshot(), curated.records)
    let baseActiveVersion = if (kb.status().activeKnowledgeVersion == "") { "none" } else { kb.status().activeKnowledgeVersion }
    let recordsEvidenceHash = ckbCandidateRecordsEvidenceHash(candidateRecords, stagedCandidateVersion: candidateVersion)
    let expectedProof = ckbNewBenchmarkGapProofCheckpoint(scanPlan, candidateVersion,
        baseActiveVersion, recordsEvidenceHash)
    var checkpoint = ckbLoadBenchmarkGapProofCheckpoint(store, expectedProof)
    var candidateReused = checkpoint.valid
    var manifestEvidenceHash = ""
    var indexBuildCount: Int64 = 0
    var queryCount: Int64 = 0
    if (!candidateReused) {
        if (checkpoint.errorCode != "benchmark_gap_proof_checkpoint_not_found" && checkpoint.errorCode != "legacy-unverified") {
            result.ok = false; result.status = checkpoint.errorCode; result.validationStatus = result.status; return result
        }
        let preview = ckbBenchmarkGapPreviewAll(candidateRecords, curated.records)
        if (!preview.ok) { result.ok = false; result.status = preview.errorCode; result.validationStatus = result.status; return result }
        indexBuildCount = preview.indexBuildCount; queryCount = preview.queryCount
        let candidateRaw = ckbBenchmarkGapCandidateRawOverlay(kb.rawRecordSnapshot(), curated.records)
        let materialized = store.saveCandidateSnapshotImmutable(candidateRaw, candidateRecords,
            candidateVersion, deadlineAtMillis: deadlineAtMillis)
        if (!materialized.ok) { result.ok = false; result.status = materialized.status; result.validationStatus = result.status; return result }
        manifestEvidenceHash = materialized.manifestEvidenceHash
        checkpoint = ckbSaveBenchmarkGapProofCheckpoint(store, expectedProof)
        if (!checkpoint.valid) { result.ok = false; result.status = checkpoint.errorCode; result.validationStatus = result.status; return result }
    }
    result.candidateVersion = candidateVersion
    result.validationDiagnostics.add("benchmark_gap_candidate_ready:count=${curated.records.size}:candidateVersion=${candidateVersion}:manifestEvidenceHash=${manifestEvidenceHash}:indexBuildCount=${indexBuildCount}:queryCount=${queryCount}:reused=${candidateReused}")
    let candidateRaw = ckbBenchmarkGapCandidateRawOverlay(kb.rawRecordSnapshot(), curated.records)
    let candidateKb = kb.forkIsolatedCandidate()
    candidateKb.replaceRawRecords(candidateRaw)
    let acquisition = CkbCandidateAcquisitionContext()
    acquisition.taskId = profile.profile; acquisition.schedulerRunId = scanPlan.runId
    acquisition.planHash = scanPlan.planHash; acquisition.candidateVersion = candidateVersion
    acquisition.recordsEvidenceHash = recordsEvidenceHash
    acquisition.acquisitionId = "p7-curation-${ckbReleaseEvidenceHash("${scanPlan.runId}|${scanPlan.planHash}|${candidateVersion}")}"
    let gate = CkbBenchmarkGapPreCommitGate(store, expectedProof, curated.records,
        config.benchmarkGapProofBatchSize)
    let intentPrefix="schemaVersion=ckb-benchmark-gap-commit-intent-v1\nrunId=${escapeField(scanPlan.runId)}\ninputSha256=${scanPlan.inputSha256}\nplanHash=${scanPlan.planHash}\ncandidateVersion=${escapeField(candidateVersion)}\nbaseActiveVersion=${escapeField(baseActiveVersion)}\nrecordsEvidenceHash=${recordsEvidenceHash}\nstate=prepared\n"
    let intentText=intentPrefix+"checksum=${ckbReleaseEvidenceHash(intentPrefix)}\n"
    let intentPath="metadata/benchmark-gap-curation/runs/${safeName(scanPlan.planHash)}/commit-intent.ckb"
    let existingIntent=try{store.readText(intentPath)}catch(_:Exception){result.ok=false;result.status="benchmark_gap_commit_intent_invalid_response_encoding";return result}
    if(existingIntent!=""&&existingIntent!=intentText){result.ok=false;result.status="benchmark_gap_active_cas_conflict";return result}
    if(existingIntent==""){try{store.writeLinesAtomically(intentPath,intentText)}catch(_:Exception){result.ok=false;result.status="benchmark_gap_commit_intent_write_failed";return result}}
    let promotion = cangjiePromoteCandidateRecordsAfterValidationWithVersion(candidateKb, store,
        candidateVersion, candidateRecords, progressSink: progressSink,
        deadlineAtMillis: deadlineAtMillis, acquisitionContext: acquisition, preCommitGate: gate,
        repositoryEventIdentity: "p7:${scanPlan.planHash}",
        expectedBaseActiveVersion: baseActiveVersion)
    for (diagnostic in promotion.validation.diagnostics) { result.validationDiagnostics.add(diagnostic) }
    result.candidateVersion = promotion.candidateVersion; result.activeVersion = promotion.activeVersion
    result.transactionId = promotion.snapshotTxId; result.validationEvidenceHash = promotion.validation.evidenceHash
    if (!promotion.ok) {
        result.ok = false; result.status = promotion.validation.status; result.validationStatus = result.status
        return result
    }
    checkpoint = ckbLoadBenchmarkGapProofCheckpoint(store, expectedProof)
    let terminal = ckbFinalizeBenchmarkGapTerminal(store, checkpoint,
        promotion.activeVersion, promotion.snapshotTxId)
    if (!terminal.valid) { result.ok=false;result.status=terminal.errorCode;result.validationStatus=result.status;return result }
    let committedSnapshot = store.loadActiveSnapshot()
    if (!committedSnapshot.valid || !kb.restoreActiveSnapshot(committedSnapshot)) { result.ok=false;result.status="benchmark_gap_active_reload_failed";result.validationStatus=result.status;return result }
    _ = ckbPersistBenchmarkGapLifecycleEvent(store, scanPlan.runId, "committed", "committed", scanPlan.planHash, candidateVersion, "terminal confirmed", completed: terminal.completed, total: terminal.total)
    result.ok = true; result.status = "candidate_validated_promoted"; result.validationStatus = "curation_checkpoint_verified"
    for (gateName in ["curation_input_verified", "curation_plan_complete", "candidate_validation_passed", "query_proof_complete", "active_transaction_verified", "curation_checkpoint_verified"]) { result.validationGates.add(gateName) }
    result
}

public func ckbSaveBenchmarkGapCandidateBatch(store: FileKnowledgeStore,
    plan: CkbBenchmarkGapScanPlan, records: ArrayList<NormalizedRecord>, start: Int64,
    end: Int64): CkbBenchmarkGapCandidateBatchResult {
    let result = CkbBenchmarkGapCandidateBatchResult()
    result.startOffset = start; result.endOffset = end; result.expected = end - start
    if (!plan.valid || start < 0 || end <= start || end > records.size ||
        end != ckbBenchmarkGapBatchEnd(plan.total, start, plan.batchSize)) {
        result.errorCode = "benchmark_gap_candidate_batch_invalid"
        return result
    }
    let body = StringBuilder()
    for (index in start..end) {
        let record = records[index]
        body.append("record=${escapeField(record.sourceId)}|${ckbCandidateRecordsEvidenceHash(singleBenchmarkGapRecord(record))}\n")
    }
    result.evidenceHash = ckbReleaseEvidenceHash(body.toString())
    let text = "schemaVersion=ckb-benchmark-gap-candidate-batch-v1\nplanHash=${plan.planHash}\ninputSha256=${plan.inputSha256}\nstart=${start}\nend=${end}\ncount=${result.expected}\nevidenceHash=${result.evidenceHash}\n${body}checksum=${ckbReleaseEvidenceHash("${plan.planHash}|${plan.inputSha256}|${start}|${end}|${result.evidenceHash}")}\n"
    let path = ckbBenchmarkGapCandidateBatchPath(plan.planHash, start)
    try { store.writeLinesAtomically(path, text) } catch (_: Exception) {
        result.errorCode = "benchmark_gap_candidate_batch_write_failed"; return result
    }
    let readback = try { store.readText(path) } catch (_: Exception) {
        result.errorCode = "benchmark_gap_candidate_batch_invalid_response_encoding"; return result
    }
    if (readback != text) { result.errorCode = "benchmark_gap_candidate_batch_readback_failed"; return result }
    result.ok = true; result.status = "benchmark_gap_candidate_batch_saved"; result.written = result.expected
    result
}

public func ckbLoadBenchmarkGapCandidateBatches(store: FileKnowledgeStore,
    plan: CkbBenchmarkGapScanPlan, records: ArrayList<NormalizedRecord>): CkbBenchmarkGapCandidateBatchResult {
    let result = CkbBenchmarkGapCandidateBatchResult()
    var start: Int64 = 0
    while (start < plan.total) {
        let end = ckbBenchmarkGapBatchEnd(plan.total, start, plan.batchSize)
        let expected = ckbSaveBenchmarkGapCandidateBatchText(plan, records, start, end)
        let actual = try { store.readText(ckbBenchmarkGapCandidateBatchPath(plan.planHash, start)) } catch (_: Exception) {
            result.errorCode = "benchmark_gap_candidate_batch_invalid_response_encoding"; return result
        }
        if (actual != expected) { result.errorCode = "benchmark_gap_candidate_batch_mismatch"; return result }
        start = end
    }
    result.ok = true; result.status = "benchmark_gap_candidate_batches_complete"; result.written = plan.total
    result
}

private func ckbSaveBenchmarkGapCandidateBatchText(plan: CkbBenchmarkGapScanPlan,
    records: ArrayList<NormalizedRecord>, start: Int64, end: Int64): String {
    let body = StringBuilder()
    for (index in start..end) {
        let record = records[index]
        body.append("record=${escapeField(record.sourceId)}|${ckbCandidateRecordsEvidenceHash(singleBenchmarkGapRecord(record))}\n")
    }
    let evidence = ckbReleaseEvidenceHash(body.toString())
    "schemaVersion=ckb-benchmark-gap-candidate-batch-v1\nplanHash=${plan.planHash}\ninputSha256=${plan.inputSha256}\nstart=${start}\nend=${end}\ncount=${end - start}\nevidenceHash=${evidence}\n${body}checksum=${ckbReleaseEvidenceHash("${plan.planHash}|${plan.inputSha256}|${start}|${end}|${evidence}")}\n"
}

private func ckbBenchmarkGapCandidateBatchPath(planHash: String, start: Int64): String {
    "metadata/benchmark-gap-curation/candidate-batches/${safeName(planHash)}/batch-${start}.ckb"
}

private func singleBenchmarkGapRecord(record: NormalizedRecord): ArrayList<NormalizedRecord> {
    let out = ArrayList<NormalizedRecord>(); out.add(record); out
}

public func ckbBenchmarkGapPreviewAll(candidateRecords: ArrayList<NormalizedRecord>,
    gapRecords: ArrayList<NormalizedRecord>): CkbBenchmarkGapPreviewResult {
    let result = CkbBenchmarkGapPreviewResult()
    let observer = CkbBenchmarkGapIndexBuildObserver()
    let index = buildCangjieServingIndex(candidateRecords,
        activeKnowledgeVersion: "benchmark-gap-preview", buildObserver: observer)
    result.indexBuildCount = observer.count
    for (diagnostic in index.diagnostics) {
        if (diagnostic.contains("deadline_exceeded") || diagnostic == "serving_index_empty") {
            result.errorCode = "benchmark_gap_preview_index_invalid"; return result
        }
    }
    for (record in gapRecords) {
        let request = CangjieServingSearchRequest()
        request.query = "${record.sourceId} ${ckbBenchmarkGapTaskQuery(record)}"
        request.sourceSet = CangjieSourceSets.EVAL_SUPPORT
        request.targetVersion = record.metadata.targetVersion
        request.budget = 10
        let lookup = searchHybridServingIndex(index, request)
        result.queryCount += 1
        var matched = false
        for (hit in lookup.hits) {
            if (hit.document.sourceId == record.sourceId &&
                hit.document.sourceSet == CangjieSourceSets.EVAL_SUPPORT &&
                hit.document.targetVersion == record.metadata.targetVersion) { matched = true }
        }
        if (!matched) {
            result.errorCode = "benchmark_gap_preview_target_missed"
            result.failedCaseIdHash = ckbReleaseEvidenceHash(record.sourceId)
            return result
        }
        result.passed += 1
    }
    result.ok = result.indexBuildCount == 1 && result.passed == gapRecords.size
    result.status = if (result.ok) { "benchmark_gap_preview_passed" } else { "benchmark_gap_preview_incomplete" }
    if (!result.ok) { result.errorCode = result.status }
    result
}

private func ckbBenchmarkGapCandidateRawOverlay(active: ArrayList<RawRecord>,
    records: ArrayList<NormalizedRecord>): ArrayList<RawRecord> {
    let replacements = HashSet<String>()
    for (record in records) { replacements.add(record.sourceId) }
    let seenGapPoints = HashSet<String>()
    let out = ArrayList<RawRecord>()
    for (record in active) {
        if (replacements.contains(record.sourceId) || ckbBenchmarkGapRawReplaced(record, records)) { continue }
        let persisted = ckbBenchmarkGapMigrateLegacyRawRecord(record)
        if (ckbBenchmarkGapRawRecord(persisted)) {
            let pointId = ckbBenchmarkGapRawPointId(persisted)
            if (seenGapPoints.contains(pointId)) { continue }
            seenGapPoints.add(pointId)
        }
        out.add(persisted)
    }
    for (record in records) {
        let raw = RawRecord(); raw.sourceId = record.sourceId; raw.title = record.title
        raw.content = record.chunk; raw.contentHash = stableSummaryHash(record.chunk)
        raw.metadata = record.metadata; raw.requiresReview = record.requiresReview; out.add(raw)
    }
    out
}

private func ckbBenchmarkGapRawReplaced(record: RawRecord, replacements: ArrayList<NormalizedRecord>): Bool {
    if (!ckbBenchmarkGapRawRecord(record)) { return false }
    for (replacement in replacements) {
        if (record.metadata.path == replacement.metadata.path &&
            record.metadata.symbol == replacement.metadata.symbol &&
            record.metadata.targetVersion == replacement.metadata.targetVersion &&
            (record.metadata.docVersion == "" || replacement.metadata.docVersion == "" ||
                record.metadata.docVersion == replacement.metadata.docVersion)) {
            return true
        }
    }
    false
}

private func ckbBenchmarkGapRawRecord(record: RawRecord): Bool {
    record.sourceId.startsWith("curated-gap-") &&
        record.metadata.sourceSet == CangjieSourceSets.EVAL_SUPPORT &&
        record.metadata.path.startsWith("visible-benchmark/")
}

private func ckbBenchmarkGapRawPointId(record: RawRecord): String {
    let normalized = NormalizedRecord()
    normalized.sourceId = record.sourceId; normalized.title = record.title
    normalized.chunk = record.content; normalized.citation = record.metadata.sourceUrl
    normalized.metadata = record.metadata
    ckbVectorPointId(normalized)
}

private func ckbBenchmarkGapMigrateLegacyRawRecord(record: RawRecord): RawRecord {
    if (!ckbBenchmarkGapRawRecord(record) || !record.sourceId.startsWith("curated-gap-h")) {
        return record
    }
    let out = RawRecord()
    out.sourceId = benchmarkGapLegacyPersistentSourceId(record.metadata.path, record.metadata.symbol,
        record.metadata.targetVersion, record.metadata.docVersion, record.title, record.content)
    out.title = record.title; out.content = record.content; out.contentHash = record.contentHash
    out.metadata = cangjieCopyKnowledgeMetadata(record.metadata); out.metadata.sourceId = out.sourceId
    out.requiresReview = record.requiresReview
    out
}

public func ckbBuildBenchmarkGapScanPlan(records: ArrayList<NormalizedRecord>, inputText: String,
    targetVersion: String, runId!: String = "benchmark-gap-curation",
    batchSize!: Int64 = 200): CkbBenchmarkGapScanPlan {
    let plan = CkbBenchmarkGapScanPlan()
    if (batchSize <= 0 || targetVersion.trimAscii() == "" || runId.trimAscii() == "") {
        plan.errorCode = "benchmark_gap_scan_plan_input_invalid"
        return plan
    }
    plan.runId = runId.trimAscii()
    plan.inputSha256 = ckbReleaseEvidenceHash(inputText)
    plan.targetVersion = targetVersion.trimAscii()
    plan.total = records.size
    plan.batchSize = batchSize
    plan.state = if (records.size == 0) { "complete" } else { "planned" }
    let identity = StringBuilder()
    identity.append("schema=${plan.schemaVersion}|runId=${plan.runId}|inputSha256=${plan.inputSha256}")
    identity.append("|targetVersion=${plan.targetVersion}|total=${plan.total}|batchSize=${plan.batchSize}")
    for (record in records) {
        // S1 derives sourceId from canonicalBenchmarkGapIdentity plus the
        // canonical record key. Preserve that ordered identity; do not invent
        // a second case-id parser in the scheduler layer.
        identity.append("|record=${record.sourceId.size}:${record.sourceId}")
        identity.append("|evidence=${ckbCandidateRecordsEvidenceHash(singleBenchmarkGapRecord(record))}")
    }
    plan.planHash = ckbReleaseEvidenceHash(identity.toString())
    plan.checksum = ckbBenchmarkGapScanPlanChecksum(plan)
    plan.valid = true
    plan.errorCode = ""
    plan
}

public func ckbSaveBenchmarkGapScanPlan(store: FileKnowledgeStore,
    plan: CkbBenchmarkGapScanPlan): CkbBenchmarkGapScanPlan {
    if (!ckbBenchmarkGapScanPlanInvariant(plan)) {
        return ckbBenchmarkGapInvalidScanPlan("benchmark_gap_scan_plan_invariant_failed")
    }
    plan.checksum = ckbBenchmarkGapScanPlanChecksum(plan)
    try {
        store.writeLinesAtomically(ckbBenchmarkGapScanPlanPath(plan.planHash), ckbBenchmarkGapScanPlanText(plan))
    } catch (_: Exception) {
        return ckbBenchmarkGapInvalidScanPlan("benchmark_gap_scan_plan_write_failed")
    }
    let readback = ckbLoadBenchmarkGapScanPlan(store, plan.planHash, plan.inputSha256, plan.targetVersion)
    if (!readback.valid || readback.checksum != plan.checksum || readback.revision != plan.revision) {
        return ckbBenchmarkGapInvalidScanPlan("benchmark_gap_scan_plan_readback_failed")
    }
    readback
}

public func ckbLoadBenchmarkGapScanPlan(store: FileKnowledgeStore, planHash: String,
    inputSha256: String, targetVersion: String): CkbBenchmarkGapScanPlan {
    if (planHash == "" || inputSha256 == "" || targetVersion == "") {
        return ckbBenchmarkGapInvalidScanPlan("benchmark_gap_scan_plan_expected_identity_invalid")
    }
    let text = try { store.readText(ckbBenchmarkGapScanPlanPath(planHash)) } catch (_: Exception) {
        return ckbBenchmarkGapInvalidScanPlan("benchmark_gap_scan_plan_invalid_response_encoding")
    }
    if (text == "") { return ckbBenchmarkGapInvalidScanPlan("benchmark_gap_scan_plan_not_found") }
    if (!ckbBenchmarkGapScanPlanShapeValid(text)) {
        return ckbBenchmarkGapInvalidScanPlan("benchmark_gap_scan_plan_malformed")
    }
    let plan = CkbBenchmarkGapScanPlan()
    plan.schemaVersion = ckbCurrentField(text, "schemaVersion")
    plan.runId = ckbCurrentField(text, "runId")
    plan.inputSha256 = ckbCurrentField(text, "inputSha256")
    plan.planHash = ckbCurrentField(text, "planHash")
    plan.targetVersion = ckbCurrentField(text, "targetVersion")
    plan.total = parseIntField(ckbCurrentField(text, "total"), -1)
    plan.batchSize = parseIntField(ckbCurrentField(text, "batchSize"), -1)
    plan.nextOffset = parseIntField(ckbCurrentField(text, "nextOffset"), -1)
    plan.revision = parseIntField(ckbCurrentField(text, "revision"), -1)
    plan.owner = ckbCurrentField(text, "owner")
    plan.leaseUntilMillis = parseIntField(ckbCurrentField(text, "leaseUntilMillis"), -1)
    plan.state = ckbCurrentField(text, "state")
    plan.checksum = ckbCurrentField(text, "checksum")
    if (plan.schemaVersion != "ckb-benchmark-gap-scan-plan-v1") {
        plan.errorCode = "benchmark_gap_scan_plan_schema_mismatch"
        return plan
    }
    if (plan.planHash != planHash || plan.inputSha256 != inputSha256 || plan.targetVersion != targetVersion) {
        plan.errorCode = "benchmark_gap_scan_plan_identity_mismatch"
        return plan
    }
    if (!ckbBenchmarkGapScanPlanInvariant(plan)) {
        plan.errorCode = "benchmark_gap_scan_plan_invariant_failed"
        return plan
    }
    if (plan.checksum != ckbBenchmarkGapScanPlanChecksum(plan)) {
        plan.errorCode = "benchmark_gap_scan_plan_checksum_mismatch"
        return plan
    }
    plan.valid = true
    plan.errorCode = ""
    plan
}

public func ckbClaimBenchmarkGapScanPlan(store: FileKnowledgeStore, planHash: String,
    inputSha256: String, targetVersion: String, owner: String, nowMillis: Int64,
    leaseMillis: Int64): CkbBenchmarkGapScanClaimResult {
    let result = CkbBenchmarkGapScanClaimResult()
    if (owner.trimAscii() == "" || nowMillis <= 0 || leaseMillis <= 0) {
        result.errorCode = "benchmark_gap_scan_claim_input_invalid"
        return result
    }
    let current = ckbLoadBenchmarkGapScanPlan(store, planHash, inputSha256, targetVersion)
    result.plan = current
    if (!current.valid) { result.errorCode = current.errorCode; return result }
    if (current.state == "complete") {
        result.state = "complete"
        result.errorCode = "benchmark_gap_scan_plan_terminal"
        return result
    }
    if (current.state == "running" && current.leaseUntilMillis > nowMillis) {
        result.state = "running"
        result.errorCode = "benchmark_gap_scan_plan_lease_held"
        return result
    }
    if (!ckbAcquireBenchmarkGapScanPlanLock(store, planHash, nowMillis)) {
        result.state = "running"
        result.errorCode = "benchmark_gap_scan_plan_claim_conflict"
        return result
    }
    try {
        let fresh = ckbLoadBenchmarkGapScanPlan(store, planHash, inputSha256, targetVersion)
        if (!fresh.valid || fresh.revision != current.revision ||
            (fresh.state == "running" && fresh.leaseUntilMillis > nowMillis)) {
            result.plan = fresh
            result.state = if (fresh.valid) { fresh.state } else { "invalid" }
            result.errorCode = if (fresh.valid) { "benchmark_gap_scan_plan_claim_conflict" } else { fresh.errorCode }
            return result
        }
        fresh.state = "running"
        fresh.owner = owner.trimAscii()
        fresh.leaseUntilMillis = nowMillis + leaseMillis
        fresh.revision += 1
        let saved = ckbSaveBenchmarkGapScanPlan(store, fresh)
        result.plan = saved
        if (!saved.valid) { result.errorCode = saved.errorCode; return result }
        result.claimed = true
        result.startOffset = saved.nextOffset
        result.endOffset = ckbBenchmarkGapBatchEnd(saved.total, saved.nextOffset, saved.batchSize)
        result.state = saved.state
        result.errorCode = ""
    } finally {
        ckbReleaseBenchmarkGapScanPlanLock(store, planHash)
    }
    result
}

public func ckbCheckpointBenchmarkGapScanPlan(store: FileKnowledgeStore, planHash: String,
    inputSha256: String, targetVersion: String, owner: String, expectedRevision: Int64,
    expectedStart: Int64, completedEnd: Int64, nowMillis: Int64): CkbBenchmarkGapScanPlan {
    let current = ckbLoadBenchmarkGapScanPlan(store, planHash, inputSha256, targetVersion)
    if (!current.valid) { return current }
    if (current.state != "running" || current.owner != owner || current.revision != expectedRevision ||
        current.leaseUntilMillis <= nowMillis || current.nextOffset != expectedStart ||
        completedEnd != ckbBenchmarkGapBatchEnd(current.total, expectedStart, current.batchSize)) {
        return ckbBenchmarkGapInvalidScanPlan("benchmark_gap_scan_plan_revision_conflict")
    }
    if (!ckbAcquireBenchmarkGapScanPlanLock(store, planHash, nowMillis)) {
        return ckbBenchmarkGapInvalidScanPlan("benchmark_gap_scan_plan_claim_conflict")
    }
    try {
        let fresh = ckbLoadBenchmarkGapScanPlan(store, planHash, inputSha256, targetVersion)
        if (!fresh.valid || fresh.revision != expectedRevision || fresh.owner != owner ||
            fresh.state != "running" || fresh.leaseUntilMillis <= nowMillis || fresh.nextOffset != expectedStart) {
            return ckbBenchmarkGapInvalidScanPlan("benchmark_gap_scan_plan_revision_conflict")
        }
        fresh.nextOffset = completedEnd
        fresh.revision += 1
        fresh.owner = ""
        fresh.leaseUntilMillis = 0
        fresh.state = if (completedEnd == fresh.total) { "complete" } else { "checkpointed" }
        ckbSaveBenchmarkGapScanPlan(store, fresh)
    } finally {
        ckbReleaseBenchmarkGapScanPlanLock(store, planHash)
    }
}

public func ckbBenchmarkGapCurationBatchSize(): Int64 { 200 }

public func ckbBenchmarkGapBatchEnd(total: Int64, start: Int64, batchSize: Int64): Int64 {
    if (total <= 0 || start < 0 || start >= total || batchSize <= 0) { return if (total < 0) { 0 } else { total } }
    let end = start + batchSize
    if (end > total) { total } else { end }
}

private func ckbBenchmarkGapScanPlanPath(planHash: String): String {
    "metadata/benchmark-gap-curation/plans/${safeName(planHash)}.ckb"
}

private func ckbBenchmarkGapScanPlanLockPath(planHash: String): String {
    "metadata/benchmark-gap-curation/locks/${safeName(planHash)}.lock"
}

private func ckbBenchmarkGapScanPlanChecksum(plan: CkbBenchmarkGapScanPlan): String {
    ckbReleaseEvidenceHash("schema=${plan.schemaVersion}|runId=${plan.runId}|inputSha256=${plan.inputSha256}|planHash=${plan.planHash}|targetVersion=${plan.targetVersion}|total=${plan.total}|batchSize=${plan.batchSize}|nextOffset=${plan.nextOffset}|revision=${plan.revision}|owner=${plan.owner}|leaseUntilMillis=${plan.leaseUntilMillis}|state=${plan.state}")
}

private func ckbBenchmarkGapScanPlanInvariant(plan: CkbBenchmarkGapScanPlan): Bool {
    if (plan.schemaVersion != "ckb-benchmark-gap-scan-plan-v1" || plan.runId == "" ||
        plan.inputSha256.size != 64 || plan.planHash.size != 64 || plan.targetVersion == "" ||
        plan.total < 0 || plan.batchSize <= 0 || plan.nextOffset < 0 || plan.nextOffset > plan.total ||
        plan.revision < 0 || plan.leaseUntilMillis < 0) { return false }
    if (plan.state == "running") { return plan.owner != "" && plan.leaseUntilMillis > 0 && plan.nextOffset < plan.total }
    if (plan.state == "complete") { return plan.owner == "" && plan.leaseUntilMillis == 0 && plan.nextOffset == plan.total }
    (plan.state == "planned" || plan.state == "checkpointed") && plan.owner == "" &&
        plan.leaseUntilMillis == 0 && plan.nextOffset < plan.total
}

private func ckbBenchmarkGapScanPlanText(plan: CkbBenchmarkGapScanPlan): String {
    "schemaVersion=${escapeField(plan.schemaVersion)}\nrunId=${escapeField(plan.runId)}\ninputSha256=${plan.inputSha256}\nplanHash=${plan.planHash}\ntargetVersion=${escapeField(plan.targetVersion)}\ntotal=${plan.total}\nbatchSize=${plan.batchSize}\nnextOffset=${plan.nextOffset}\nrevision=${plan.revision}\nowner=${escapeField(plan.owner)}\nleaseUntilMillis=${plan.leaseUntilMillis}\nstate=${plan.state}\nchecksum=${plan.checksum}\n"
}

private func ckbBenchmarkGapScanPlanShapeValid(text: String): Bool {
    let required = HashSet<String>()
    for (key in ["schemaVersion", "runId", "inputSha256", "planHash", "targetVersion", "total",
        "batchSize", "nextOffset", "revision", "owner", "leaseUntilMillis", "state", "checksum"]) {
        required.add(key)
    }
    let seen = HashSet<String>()
    for (line in text.split("\n")) {
        if (line == "") { continue }
        match (line.indexOf("=")) {
            case Some(index) =>
                let fields = line.split("=")
                if (fields.size < 2) { return false }
                let key = fields[0]
                if (!required.contains(key) || seen.contains(key)) { return false }
                seen.add(key)
            case None => return false
        }
    }
    seen.size == required.size
}

public class CkbBenchmarkGapLegacyInspection {
    public var status: String = "absent"
    public var diagnostic: String = ""
    public var evidenceHash: String = ""
    public var size: Int64 = 0
    public init() {}
}

public func ckbInspectLegacyBenchmarkGapProof(store: FileKnowledgeStore): CkbBenchmarkGapLegacyInspection {
    let result = CkbBenchmarkGapLegacyInspection()
    let path = store.root.join("metadata/benchmark-gap-curation-proof.ckb")
    if (!exists(path)) { return result }
    result.status = "legacy-unverified"
    let bytes = try { File.readFrom(path) } catch (_: Exception) { result.diagnostic = "legacy_read_failed"; return result }
    result.size = bytes.size; let digest = SHA256(); digest.write(bytes); result.evidenceHash = ckbReleaseDigestHex(digest)
    let text = try { String.fromUtf8(bytes) } catch (_: Exception) { result.diagnostic = "invalid_response_encoding"; return result }
    result.diagnostic = if (text.trimAscii() == "") { "legacy_empty" } else { "legacy_present" }
    result
}

public func ckbRenderBenchmarkGapLifecycleEvent(runId: String, stage: String, status: String,
    planHash: String, candidateVersion: String, diagnostic: String, completed!: Int64 = 0,
    total!: Int64 = 0, errorCode!: String = ""): String {
    let redacted = redactSensitive(diagnostic)
    let safe = utf8SafePrefix(redacted, 240)
    "{\"time\":\"${ckbRuntimePreflightJsonEscape(DateTime.now().toString())}\",\"level\":\"${if (errorCode == "") { "info" } else { "error" }}\",\"subsystem\":\"ckb.routine.benchmark_gap\",\"event\":\"benchmark.curation.${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(stage), 80))}\",\"message\":\"benchmark gap lifecycle\",\"runIdHash\":\"${ckbReleaseEvidenceHash(runId)}\",\"taskName\":\"cangjie_benchmark_gap_curation\",\"stage\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(stage), 80))}\",\"status\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(status), 80))}\",\"errorCode\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(redactSensitive(errorCode), 120))}\",\"planHash\":\"${ckbRuntimePreflightJsonEscape(utf8SafePrefix(planHash, 64))}\",\"candidateVersionHash\":\"${ckbReleaseEvidenceHash(candidateVersion)}\",\"completed\":${completed},\"total\":${total},\"diagnostic\":\"${ckbRuntimePreflightJsonEscape(safe)}\",\"diagnosticTruncated\":${diagnostic.toRuneArray().size > 240}}"
}

private func ckbPersistBenchmarkGapLifecycleEvent(store: FileKnowledgeStore, runId: String,
    stage: String, status: String, planHash: String, candidateVersion: String,
    diagnostic: String, completed!: Int64 = 0, total!: Int64 = 0,
    errorCode!: String = ""): Bool {
    let line = ckbRenderBenchmarkGapLifecycleEvent(runId, stage, status, planHash,
        candidateVersion, diagnostic, completed: completed, total: total,
        errorCode: errorCode) + "\n"
    let path = "metadata/benchmark-gap-curation/runs/${safeName(planHash)}/events/${safeName(stage)}-${completed}.jsonl"
    try { store.writeLinesAtomically(path, line); store.readText(path) == line } catch (_: Exception) { false }
}

private func ckbBenchmarkGapInvalidScanPlan(errorCode: String): CkbBenchmarkGapScanPlan {
    let plan = CkbBenchmarkGapScanPlan()
    plan.errorCode = errorCode
    plan
}

private func ckbAcquireBenchmarkGapScanPlanLock(store: FileKnowledgeStore, planHash: String,
    nowMillis: Int64): Bool {
    let path = store.root.join(ckbBenchmarkGapScanPlanLockPath(planHash))
    if (exists(path)) {
        let lockText = try { String.fromUtf8(File.readFrom(path.join("lock.ckb"))) } catch (_: Exception) { "" }
        let expiresAtMillis = parseIntField(ckbCurrentField(lockText, "expiresAtMillis"), 0)
        if (expiresAtMillis <= 0 || expiresAtMillis > nowMillis) { return false }
        try { _ = launch("/bin/rm", ["-rf", path.toString()]).wait() } catch (_: Exception) { return false }
    }
    try {
        if (!exists(path.parent)) { Directory.create(path.parent, recursive: true) }
        Directory.create(path, recursive: false)
        File.writeTo(path.join("lock.ckb"), "expiresAtMillis=${nowMillis + 30000}\n".toArray())
        true
    } catch (_: Exception) { false }
}

private func ckbReleaseBenchmarkGapScanPlanLock(store: FileKnowledgeStore, planHash: String): Unit {
    let path = store.root.join(ckbBenchmarkGapScanPlanLockPath(planHash))
    try { _ = launch("/bin/rm", ["-rf", path.toString()]).wait() } catch (_: Exception) { () }
}

public func ckbBenchmarkGapCurationMaxInputBytes(): Int64 {
    1048576
}

public func ckbBenchmarkGapCurationMaxRecords(): Int64 { ckbBenchmarkGapCurationBatchSize() }

public func ckbBenchmarkGapQueryProofDeadlineDiagnostic(deadlineAtMillis: Int64, completed: Int64, total: Int64, batchId!: String = ""): String {
    let deadline = ckbDeadlineGuard("benchmark_gap_query_proof", deadlineAtMillis)
    if (!deadline.exceeded) {
        return ""
    }
    "benchmark_gap_query_proof_timeout:${deadline.diagnostic}:batchId=${if (batchId == "") { "default" } else { batchId }}:completed=${completed}:total=${total}:remainingMs=${deadline.remainingMillis}"
}

public func ckbNewBenchmarkGapProofCheckpoint(plan: CkbBenchmarkGapScanPlan,
    candidateVersion: String, baseActiveVersion: String, recordsEvidenceHash: String): CkbBenchmarkGapProofCheckpoint {
    let checkpoint = CkbBenchmarkGapProofCheckpoint()
    checkpoint.runId = plan.runId; checkpoint.inputSha256 = plan.inputSha256
    checkpoint.planHash = plan.planHash; checkpoint.candidateVersion = candidateVersion
    checkpoint.baseActiveVersion = if (baseActiveVersion == "") { "none" } else { baseActiveVersion }
    checkpoint.recordsEvidenceHash = recordsEvidenceHash; checkpoint.total = plan.total
    checkpoint.aggregateEvidenceHash = ckbReleaseEvidenceHash("")
    checkpoint.valid = ckbBenchmarkGapProofCheckpointInvariant(checkpoint)
    checkpoint.errorCode = if (checkpoint.valid) { "" } else { "benchmark_gap_proof_checkpoint_invalid" }
    checkpoint.checksum = ckbBenchmarkGapProofCheckpointChecksum(checkpoint)
    checkpoint
}

public func ckbBenchmarkGapProofForCandidate(record: NormalizedRecord, candidateVersion: String,
    baseActiveVersion: String, forcedStatus!: String = ""): CkbBenchmarkGapProofResult {
    let proof = CkbBenchmarkGapProofResult()
    proof.caseIdentity = record.sourceId
    proof.recordHash = ckbCandidateRecordsEvidenceHash(singleBenchmarkGapRecord(record), stagedCandidateVersion: candidateVersion)
    let atomKnowledgeMissing = ckbBenchmarkGapAtomKnowledgeMissing(record)
    if (forcedStatus == "retryable") { proof.status = "retryable"; proof.errorCode = "candidate_query_retryable" }
    else if (forcedStatus == "failed" || record.citation.trimAscii() == "" || atomKnowledgeMissing) { proof.status = "failed"; proof.errorCode = if (atomKnowledgeMissing) { "candidate_atom_knowledge_missing" } else { "candidate_coverage_failed" } }
    else {
        proof.status = "passed"; proof.coveragePass = true; proof.citationCount = 1
        proof.citationHashes.add(ckbReleaseEvidenceHash(record.citation.trimAscii()))
    }
    proof.evidenceHash = ckbReleaseEvidenceHash("case=${proof.caseIdentity}|record=${proof.recordHash}|candidate=${candidateVersion}|base=${if (baseActiveVersion == "") { "none" } else { baseActiveVersion }}|status=${proof.status}|coverage=${proof.coveragePass}|citations=${joinStrings(proof.citationHashes, ",")}|error=${proof.errorCode}")
    proof.valid = proof.caseIdentity != "" && proof.recordHash.size == 64 && proof.evidenceHash.size == 64 &&
        ((proof.status == "passed" && proof.coveragePass && proof.citationCount > 0) ||
         (proof.status == "failed" && !proof.coveragePass) || proof.status == "retryable")
    proof
}

private func ckbBenchmarkGapAtomKnowledgeMissing(record: NormalizedRecord): Bool {
    var atomDerived = false
    for (source in record.metadata.derivedFrom) {
        if (source.startsWith("knowledge-atom:")) { atomDerived = true; break }
    }
    if (!atomDerived) { return false }
    for (line in record.chunk.split("\n")) {
        if (line.startsWith("Knowledge: ") && line.replace("Knowledge: ", "").trimAscii() != "") { return false }
    }
    true
}

public func ckbRenderBenchmarkGapProofDiagnostic(proof: CkbBenchmarkGapProofResult): String {
    "benchmark_gap_query_proof:caseIdentityHash=${ckbReleaseEvidenceHash(proof.caseIdentity)}:status=${proof.status}:coveragePass=${proof.coveragePass}:citations=${proof.citationCount}:evidenceHash=${proof.evidenceHash}:errorCode=${proof.errorCode}"
}

public func ckbSaveBenchmarkGapProofArtifact(store: FileKnowledgeStore,
    checkpoint: CkbBenchmarkGapProofCheckpoint, proof: CkbBenchmarkGapProofResult): CkbBenchmarkGapProofResult {
    if (!checkpoint.valid || !proof.valid) { let invalid = CkbBenchmarkGapProofResult(); invalid.errorCode = "benchmark_gap_proof_artifact_invalid"; return invalid }
    let path = ckbBenchmarkGapProofArtifactPath(checkpoint.planHash, proof.recordHash)
    let text = ckbBenchmarkGapProofArtifactText(checkpoint, proof)
    let existing = try { store.readText(path) } catch (_: Exception) { let invalid = CkbBenchmarkGapProofResult(); invalid.errorCode = "benchmark_gap_proof_artifact_invalid_response_encoding"; return invalid }
    if (existing != "" && existing != text) { let invalid = CkbBenchmarkGapProofResult(); invalid.errorCode = "benchmark_gap_proof_artifact_conflict"; return invalid }
    if (existing == "") { try { store.writeLinesAtomically(path, text) } catch (_: Exception) { let invalid = CkbBenchmarkGapProofResult(); invalid.errorCode = "benchmark_gap_proof_artifact_write_failed"; return invalid } }
    ckbLoadBenchmarkGapProofArtifact(store, checkpoint, proof.caseIdentity, proof.recordHash)
}

public func ckbLoadBenchmarkGapProofArtifact(store: FileKnowledgeStore,
    checkpoint: CkbBenchmarkGapProofCheckpoint, caseIdentity: String, recordHash: String): CkbBenchmarkGapProofResult {
    let proof = CkbBenchmarkGapProofResult(); proof.caseIdentity = caseIdentity; proof.recordHash = recordHash
    let text = try { store.readText(ckbBenchmarkGapProofArtifactPath(checkpoint.planHash, recordHash)) } catch (_: Exception) { proof.errorCode = "benchmark_gap_proof_artifact_invalid_response_encoding"; return proof }
    if (text == "") { proof.errorCode = "benchmark_gap_proof_artifact_not_found"; return proof }
    let keys = ["schemaVersion", "runId", "inputSha256", "planHash", "candidateVersion", "baseActiveVersion", "recordsEvidenceHash", "caseIdentity", "recordHash", "status", "coveragePass", "citationCount", "citationHashes", "evidenceHash", "errorCode", "checksum"]
    if (!ckbStrictFieldShape(text, keys)) { proof.errorCode = "benchmark_gap_proof_artifact_malformed"; return proof }
    if (ckbCurrentField(text, "schemaVersion") != checkpoint.schemaVersion || ckbCurrentField(text, "runId") != checkpoint.runId ||
        ckbCurrentField(text, "inputSha256") != checkpoint.inputSha256 || ckbCurrentField(text, "planHash") != checkpoint.planHash ||
        ckbCurrentField(text, "candidateVersion") != checkpoint.candidateVersion || ckbCurrentField(text, "baseActiveVersion") != checkpoint.baseActiveVersion ||
        ckbCurrentField(text, "recordsEvidenceHash") != checkpoint.recordsEvidenceHash || ckbCurrentField(text, "caseIdentity") != caseIdentity ||
        ckbCurrentField(text, "recordHash") != recordHash) { proof.errorCode = "benchmark_gap_proof_artifact_identity_mismatch"; return proof }
    proof.status = ckbCurrentField(text, "status"); proof.coveragePass = ckbCurrentField(text, "coveragePass") == "true"
    proof.citationCount = parseIntField(ckbCurrentField(text, "citationCount"), -1)
    for (hash in ckbCurrentField(text, "citationHashes").split(",")) { if (hash != "") { proof.citationHashes.add(hash) } }
    proof.evidenceHash = ckbCurrentField(text, "evidenceHash"); proof.errorCode = ckbCurrentField(text, "errorCode")
    let checksum = ckbCurrentField(text, "checksum")
    if (checksum != ckbReleaseEvidenceHash(textBeforeFirst(text, "checksum=") + "checksum=\n")) { proof.errorCode = "benchmark_gap_proof_artifact_checksum_mismatch"; return proof }
    proof.valid = proof.evidenceHash.size == 64 && proof.citationCount == proof.citationHashes.size &&
        ((proof.status == "passed" && proof.coveragePass && proof.citationCount > 0) || (proof.status == "failed" && !proof.coveragePass) || proof.status == "retryable")
    if (!proof.valid && proof.errorCode == "") { proof.errorCode = "benchmark_gap_proof_artifact_invariant_failed" }
    proof
}

public func ckbSaveBenchmarkGapProofCheckpoint(store: FileKnowledgeStore,
    checkpoint: CkbBenchmarkGapProofCheckpoint): CkbBenchmarkGapProofCheckpoint {
    if (!ckbBenchmarkGapProofCheckpointInvariant(checkpoint)) { return ckbInvalidBenchmarkGapProofCheckpoint("benchmark_gap_proof_checkpoint_invariant_failed") }
    checkpoint.checksum = ckbBenchmarkGapProofCheckpointChecksum(checkpoint)
    try { store.writeLinesAtomically(ckbBenchmarkGapProofCheckpointPath(checkpoint.planHash), ckbBenchmarkGapProofCheckpointText(checkpoint)) } catch (_: Exception) { return ckbInvalidBenchmarkGapProofCheckpoint("benchmark_gap_proof_checkpoint_write_failed") }
    ckbLoadBenchmarkGapProofCheckpoint(store, checkpoint)
}

public func ckbLoadBenchmarkGapProofCheckpoint(store: FileKnowledgeStore,
    expected: CkbBenchmarkGapProofCheckpoint): CkbBenchmarkGapProofCheckpoint {
    let text = try { store.readText(ckbBenchmarkGapProofCheckpointPath(expected.planHash)) } catch (_: Exception) { return ckbInvalidBenchmarkGapProofCheckpoint("benchmark_gap_proof_checkpoint_invalid_response_encoding") }
    if (text == "") {
        let legacy = try { store.readText("metadata/benchmark-gap-curation-proof.ckb") } catch (_: Exception) { return ckbInvalidBenchmarkGapProofCheckpoint("legacy-unverified") }
        if (legacy != "") { return ckbInvalidBenchmarkGapProofCheckpoint("legacy-unverified") }
        return ckbInvalidBenchmarkGapProofCheckpoint("benchmark_gap_proof_checkpoint_not_found")
    }
    let keys = ["schemaVersion", "runId", "inputSha256", "planHash", "candidateVersion", "baseActiveVersion", "recordsEvidenceHash", "total", "nextProofOffset", "revision", "owner", "leaseUntilMillis", "state", "aggregateEvidenceHash", "checksum"]
    if (!ckbStrictFieldShape(text, keys)) { return ckbInvalidBenchmarkGapProofCheckpoint("benchmark_gap_proof_checkpoint_malformed") }
    let out = CkbBenchmarkGapProofCheckpoint(); out.schemaVersion = ckbCurrentField(text, "schemaVersion"); out.runId = ckbCurrentField(text, "runId"); out.inputSha256 = ckbCurrentField(text, "inputSha256"); out.planHash = ckbCurrentField(text, "planHash"); out.candidateVersion = ckbCurrentField(text, "candidateVersion"); out.baseActiveVersion = ckbCurrentField(text, "baseActiveVersion"); out.recordsEvidenceHash = ckbCurrentField(text, "recordsEvidenceHash"); out.total = parseIntField(ckbCurrentField(text, "total"), -1); out.nextProofOffset = parseIntField(ckbCurrentField(text, "nextProofOffset"), -1); out.revision = parseIntField(ckbCurrentField(text, "revision"), -1); out.owner = ckbCurrentField(text, "owner"); out.leaseUntilMillis = parseIntField(ckbCurrentField(text, "leaseUntilMillis"), -1); out.state = ckbCurrentField(text, "state"); out.aggregateEvidenceHash = ckbCurrentField(text, "aggregateEvidenceHash"); out.checksum = ckbCurrentField(text, "checksum")
    if (out.runId != expected.runId || out.inputSha256 != expected.inputSha256 || out.planHash != expected.planHash || out.candidateVersion != expected.candidateVersion || out.baseActiveVersion != expected.baseActiveVersion || out.recordsEvidenceHash != expected.recordsEvidenceHash || out.total != expected.total) { out.errorCode = "benchmark_gap_proof_checkpoint_identity_mismatch"; return out }
    if (!ckbBenchmarkGapProofCheckpointInvariant(out)) { out.errorCode = "benchmark_gap_proof_checkpoint_invariant_failed"; return out }
    if (out.checksum != ckbBenchmarkGapProofCheckpointChecksum(out)) { out.errorCode = "benchmark_gap_proof_checkpoint_checksum_mismatch"; return out }
    out.valid = true; out.errorCode = ""; out
}

public func ckbClaimBenchmarkGapProofCheckpoint(store: FileKnowledgeStore,
    expected: CkbBenchmarkGapProofCheckpoint, owner: String, nowMillis: Int64, leaseMillis: Int64): CkbBenchmarkGapProofClaimResult {
    let result = CkbBenchmarkGapProofClaimResult(); var current = ckbLoadBenchmarkGapProofCheckpoint(store, expected)
    if (owner == "" || nowMillis < 0 || leaseMillis <= 0) { result.errorCode = "benchmark_gap_proof_claim_invalid"; return result }
    if (current.errorCode == "benchmark_gap_proof_checkpoint_not_found") { current = ckbSaveBenchmarkGapProofCheckpoint(store, expected) }
    if (!current.valid) { result.errorCode = current.errorCode; result.checkpoint = current; return result }
    if (current.state == "complete" || current.state == "failed") { result.errorCode = "benchmark_gap_proof_terminal"; result.checkpoint = current; return result }
    if (current.state == "running" && current.leaseUntilMillis > nowMillis) { result.errorCode = "benchmark_gap_proof_lease_held"; result.checkpoint = current; return result }
    if (!ckbAcquireBenchmarkGapProofLock(store, expected.planHash)) { result.errorCode = "benchmark_gap_proof_claim_conflict"; result.checkpoint = current; return result }
    try {
        let fresh = ckbLoadBenchmarkGapProofCheckpoint(store, expected)
        if (!fresh.valid || fresh.revision != current.revision || (fresh.state == "running" && fresh.leaseUntilMillis > nowMillis)) { result.errorCode = "benchmark_gap_proof_claim_conflict"; result.checkpoint = fresh; return result }
        fresh.owner = owner; fresh.leaseUntilMillis = nowMillis + leaseMillis; fresh.state = "running"; fresh.revision += 1
        let saved = ckbSaveBenchmarkGapProofCheckpoint(store, fresh); result.checkpoint = saved; result.claimed = saved.valid; result.errorCode = if (saved.valid) { "" } else { saved.errorCode }
    } finally { ckbReleaseBenchmarkGapProofLock(store, expected.planHash) }
    result
}

public func ckbAdvanceBenchmarkGapProofCursor(store: FileKnowledgeStore,
    claimed: CkbBenchmarkGapProofCheckpoint, record: NormalizedRecord,
    proof: CkbBenchmarkGapProofResult, nowMillis: Int64): CkbBenchmarkGapProofCheckpoint {
    let expectedRecordHash = ckbCandidateRecordsEvidenceHash(singleBenchmarkGapRecord(record), stagedCandidateVersion: claimed.candidateVersion)
    if (proof.caseIdentity != record.sourceId || proof.recordHash != expectedRecordHash) { return ckbInvalidBenchmarkGapProofCheckpoint("benchmark_gap_proof_record_identity_mismatch") }
    let artifact = ckbSaveBenchmarkGapProofArtifact(store, claimed, proof)
    if (!artifact.valid) { return ckbInvalidBenchmarkGapProofCheckpoint(artifact.errorCode) }
    if (!ckbAcquireBenchmarkGapProofLock(store, claimed.planHash)) { return ckbInvalidBenchmarkGapProofCheckpoint("benchmark_gap_proof_claim_conflict") }
    try {
        let fresh = ckbLoadBenchmarkGapProofCheckpoint(store, claimed)
        if (!fresh.valid || fresh.revision != claimed.revision || fresh.owner != claimed.owner || fresh.state != "running" || fresh.leaseUntilMillis <= nowMillis || fresh.nextProofOffset >= fresh.total) { return ckbInvalidBenchmarkGapProofCheckpoint("benchmark_gap_proof_revision_conflict") }
        fresh.nextProofOffset += 1; fresh.revision += 1; fresh.aggregateEvidenceHash = ckbReleaseEvidenceHash("${fresh.aggregateEvidenceHash}|${artifact.evidenceHash}")
        fresh.owner = ""; fresh.leaseUntilMillis = 0
        fresh.state = if (artifact.status == "failed") { "failed" } else if (fresh.nextProofOffset == fresh.total) { "complete" } else { "checkpointed" }
        ckbSaveBenchmarkGapProofCheckpoint(store, fresh)
    } finally { ckbReleaseBenchmarkGapProofLock(store, claimed.planHash) }
}

private func ckbBenchmarkGapProofCheckpointPath(planHash: String): String { "metadata/benchmark-gap-curation/runs/${safeName(planHash)}/proof-checkpoint.ckb" }
private func ckbBenchmarkGapProofArtifactPath(planHash: String, recordHash: String): String { "metadata/benchmark-gap-curation/runs/${safeName(planHash)}/proofs/${safeName(recordHash)}.ckb" }
private func ckbBenchmarkGapProofCheckpointChecksum(c: CkbBenchmarkGapProofCheckpoint): String { ckbReleaseEvidenceHash("schema=${c.schemaVersion}|run=${c.runId}|input=${c.inputSha256}|plan=${c.planHash}|candidate=${c.candidateVersion}|base=${c.baseActiveVersion}|records=${c.recordsEvidenceHash}|total=${c.total}|next=${c.nextProofOffset}|revision=${c.revision}|owner=${c.owner}|lease=${c.leaseUntilMillis}|state=${c.state}|aggregate=${c.aggregateEvidenceHash}") }
private func ckbBenchmarkGapProofCheckpointInvariant(c: CkbBenchmarkGapProofCheckpoint): Bool { c.schemaVersion == "ckb-benchmark-gap-proof-v2" && c.runId != "" && c.inputSha256.size == 64 && c.planHash.size == 64 && c.candidateVersion != "" && c.baseActiveVersion != "" && c.recordsEvidenceHash.size == 64 && c.total > 0 && c.nextProofOffset >= 0 && c.nextProofOffset <= c.total && c.revision >= 0 && c.aggregateEvidenceHash.size == 64 && ((c.state == "running" && c.owner != "" && c.leaseUntilMillis > 0) || ((c.state == "planned" || c.state == "checkpointed" || c.state == "complete" || c.state == "failed") && c.owner == "" && c.leaseUntilMillis == 0)) && (c.state != "complete" || c.nextProofOffset == c.total) }
private func ckbBenchmarkGapProofCheckpointText(c: CkbBenchmarkGapProofCheckpoint): String { "schemaVersion=${c.schemaVersion}\nrunId=${escapeField(c.runId)}\ninputSha256=${c.inputSha256}\nplanHash=${c.planHash}\ncandidateVersion=${escapeField(c.candidateVersion)}\nbaseActiveVersion=${escapeField(c.baseActiveVersion)}\nrecordsEvidenceHash=${c.recordsEvidenceHash}\ntotal=${c.total}\nnextProofOffset=${c.nextProofOffset}\nrevision=${c.revision}\nowner=${escapeField(c.owner)}\nleaseUntilMillis=${c.leaseUntilMillis}\nstate=${c.state}\naggregateEvidenceHash=${c.aggregateEvidenceHash}\nchecksum=${c.checksum}\n" }
private func ckbBenchmarkGapProofArtifactText(c: CkbBenchmarkGapProofCheckpoint, p: CkbBenchmarkGapProofResult): String { let prefix = "schemaVersion=${c.schemaVersion}\nrunId=${escapeField(c.runId)}\ninputSha256=${c.inputSha256}\nplanHash=${c.planHash}\ncandidateVersion=${escapeField(c.candidateVersion)}\nbaseActiveVersion=${escapeField(c.baseActiveVersion)}\nrecordsEvidenceHash=${c.recordsEvidenceHash}\ncaseIdentity=${escapeField(p.caseIdentity)}\nrecordHash=${p.recordHash}\nstatus=${p.status}\ncoveragePass=${p.coveragePass}\ncitationCount=${p.citationCount}\ncitationHashes=${joinStrings(p.citationHashes, ",")}\nevidenceHash=${p.evidenceHash}\nerrorCode=${escapeField(p.errorCode)}\nchecksum=\n"; prefix.replace("checksum=\n", "checksum=${ckbReleaseEvidenceHash(prefix)}\n") }
private func ckbInvalidBenchmarkGapProofCheckpoint(error: String): CkbBenchmarkGapProofCheckpoint { let out = CkbBenchmarkGapProofCheckpoint(); out.errorCode = error; out }
private func ckbStrictFieldShape(text: String, requiredKeys: Array<String>): Bool { let required = HashSet<String>(); for (key in requiredKeys) { required.add(key) }; let seen = HashSet<String>(); for (line in text.split("\n")) { if (line == "") { continue }; match (line.indexOf("=")) { case Some(index) => let key = line[..index]; if (!required.contains(key) || seen.contains(key)) { return false }; seen.add(key); case None => return false } }; seen.size == required.size }
private func ckbAcquireBenchmarkGapProofLock(store: FileKnowledgeStore, planHash: String): Bool { let path = store.root.join("metadata/benchmark-gap-curation/runs/${safeName(planHash)}/proof.lock"); if (exists(path)) { return false }; try { Directory.create(path, recursive: false); true } catch (_: Exception) { false } }
private func ckbReleaseBenchmarkGapProofLock(store: FileKnowledgeStore, planHash: String): Unit { let path = store.root.join("metadata/benchmark-gap-curation/runs/${safeName(planHash)}/proof.lock"); try { _ = launch("/bin/rm", ["-rf", path.toString()]).wait() } catch (_: Exception) { () } }
private func ckbEnsureBenchmarkGapCommitIntent(store:FileKnowledgeStore,c:CkbBenchmarkGapProofCheckpoint):String{let prefix="schemaVersion=ckb-benchmark-gap-commit-intent-v1\nrunId=${escapeField(c.runId)}\ninputSha256=${c.inputSha256}\nplanHash=${c.planHash}\ncandidateVersion=${escapeField(c.candidateVersion)}\nbaseActiveVersion=${escapeField(c.baseActiveVersion)}\nrecordsEvidenceHash=${c.recordsEvidenceHash}\nstate=prepared\n";let text=prefix+"checksum=${ckbReleaseEvidenceHash(prefix)}\n";let path="metadata/benchmark-gap-curation/runs/${safeName(c.planHash)}/commit-intent.ckb";let existing=try{store.readText(path)}catch(_:Exception){return "benchmark_gap_commit_intent_invalid_response_encoding"};if(existing!=""&&existing!=text){return "benchmark_gap_active_cas_conflict"};if(existing==""){try{store.writeLinesAtomically(path,text)}catch(_:Exception){return "benchmark_gap_commit_intent_write_failed"}};""}

public func ckbFinalizeBenchmarkGapTerminal(store: FileKnowledgeStore,
    proof: CkbBenchmarkGapProofCheckpoint, activeVersion: String,
    transactionId: String, faultInjector!:CkbBenchmarkGapFinalizeFaultInjector=NoopCkbBenchmarkGapFinalizeFaultInjector()): CkbBenchmarkGapTerminalManifest {
    let terminal = CkbBenchmarkGapTerminalManifest()
    terminal.runId = proof.runId; terminal.inputSha256 = proof.inputSha256
    terminal.planHash = proof.planHash; terminal.candidateVersion = proof.candidateVersion
    terminal.baseActiveVersion = proof.baseActiveVersion; terminal.recordsEvidenceHash = proof.recordsEvidenceHash
    terminal.proofEvidenceHash = proof.aggregateEvidenceHash; terminal.total = proof.total
    terminal.completed = proof.nextProofOffset; terminal.activeVersion = activeVersion
    terminal.transactionId = transactionId
    terminal.gatesEvidenceHash = ckbReleaseEvidenceHash("curation_input_verified|curation_plan_complete|candidate_validation_passed|query_proof_complete|active_transaction_verified|curation_checkpoint_verified")
    if (!ckbBenchmarkGapTerminalInvariant(terminal) || proof.state != "complete") { terminal.errorCode = "benchmark_gap_terminal_incomplete"; return terminal }
    _ = ckbPersistBenchmarkGapLifecycleEvent(store, proof.runId, "proof_passed", "passed",
        proof.planHash, proof.candidateVersion, "all proof artifacts confirmed",
        completed: proof.nextProofOffset, total: proof.total)
    terminal.checksum = ckbBenchmarkGapTerminalChecksum(terminal)
    let path = ckbBenchmarkGapTerminalPath(terminal.planHash, terminal.transactionId)
    let text = ckbBenchmarkGapTerminalText(terminal)
    let existing = try { store.readText(path) } catch (_: Exception) { terminal.errorCode = "benchmark_gap_terminal_invalid_response_encoding"; return terminal }
    if (existing != "" && existing != text) { terminal.errorCode = "benchmark_gap_terminal_conflict"; return terminal }
    faultInjector.checkpoint("terminal_before")
    if (existing == "") { try { store.writeLinesAtomically(path, text) } catch (_: Exception) { terminal.errorCode = "benchmark_gap_terminal_write_failed"; return terminal } }
    let loaded = ckbLoadBenchmarkGapTerminal(store, terminal.planHash, terminal.transactionId)
    if (!loaded.valid) { return loaded }
    let pointer = "schemaVersion=ckb-benchmark-gap-last-success-v1\nplanHash=${terminal.planHash}\ntransactionId=${escapeField(terminal.transactionId)}\nterminalChecksum=${terminal.checksum}\nchecksum=${ckbReleaseEvidenceHash("${terminal.planHash}|${terminal.transactionId}|${terminal.checksum}")}\n"
    faultInjector.checkpoint("last_success_before")
    try { store.writeLinesAtomically("metadata/benchmark-gap-curation-last-success.ckb", pointer) } catch (_: Exception) { loaded.valid = false; loaded.errorCode = "benchmark_gap_last_success_write_failed"; return loaded }
    let cleanup=ckbCleanupBenchmarkGapCurationRun(store,loaded);if(!cleanup.ok){loaded.errorCode="benchmark_gap_cleanup_degraded"}
    loaded
}

public func ckbCleanupBenchmarkGapCurationRun(store:FileKnowledgeStore,t:CkbBenchmarkGapTerminalManifest):CkbBenchmarkGapCleanupResult {
    let r=CkbBenchmarkGapCleanupResult();if(!t.valid){r.diagnostics.add("terminal_invalid");return r}
    let prefix="schemaVersion=ckb-benchmark-gap-commit-intent-v1\nrunId=${escapeField(t.runId)}\ninputSha256=${t.inputSha256}\nplanHash=${t.planHash}\ncandidateVersion=${escapeField(t.candidateVersion)}\nbaseActiveVersion=${escapeField(t.baseActiveVersion)}\nrecordsEvidenceHash=${t.recordsEvidenceHash}\nstate=committed\ntransactionId=${escapeField(t.transactionId)}\n"
    let text=prefix+"checksum=${ckbReleaseEvidenceHash(prefix)}\n";try{store.writeLinesAtomically("metadata/benchmark-gap-curation/runs/${safeName(t.planHash)}/commit-intent.ckb",text);r.intentCommitted=store.readText("metadata/benchmark-gap-curation/runs/${safeName(t.planHash)}/commit-intent.ckb")==text}catch(_:Exception){r.diagnostics.add("commit_intent_cleanup_failed")}
    let proofLock=store.root.join("metadata/benchmark-gap-curation/runs/${safeName(t.planHash)}/proof.lock");let commitLock=store.root.join("metadata/benchmark-gap-curation/runs/${safeName(t.planHash)}/commit.lock")
    try{if(exists(proofLock)){_=launch("/bin/rm",["-rf",proofLock.toString()]).wait()};if(exists(commitLock)){_=launch("/bin/rm",["-rf",commitLock.toString()]).wait()}}catch(_:Exception){r.diagnostics.add("lock_cleanup_failed")};r.locksRemoved=!exists(proofLock)&&!exists(commitLock)
    let acquisition="p7-curation-${ckbReleaseEvidenceHash("${t.runId}|${t.planHash}|${t.candidateVersion}")}";r.spoolRemoved=store.deleteS4ArtifactTree("metadata/vector-builds/${acquisition}")
    let pointer=store.loadActiveSnapshotPointer();let txRoot=store.root.join("transactions")
    if(pointer.valid&&exists(txRoot)){try{for(entry in Directory.readFrom(txRoot)){if(!entry.isDirectory()||entry.name==safeName(t.transactionId)||entry.name==safeName(pointer.txId)){continue};let recovery=try{store.readText("transactions/${entry.name}/metadata/repository-event-recovery.ckb")}catch(_:Exception){""};if(ckbCurrentField(recovery,"eventIdentity")=="p7:${t.planHash}"){let path=txRoot.join(entry.name);if(launch("/bin/rm",["-rf",path.toString()]).wait()==0&&!exists(path)){r.unreferencedTransactionsRemoved+=1}}}}catch(_:Exception){r.diagnostics.add("transaction_cleanup_degraded")}}
    for(owner in store.listCandidateCollectionOwners()){if(owner.valid&&owner.planHash==t.planHash&&owner.schedulerRunId==t.runId&&owner.candidateVersion==t.candidateVersion&&owner.acquisitionId==acquisition&&pointer.valid&&owner.collection!=pointer.vectorActiveCollection&&owner.state!="cleaned"){owner.state="cleaned";if(store.saveCandidateCollectionOwner(owner).valid){r.nonActiveOwnersCleaned+=1}else{r.diagnostics.add("candidate_owner_cleanup_degraded")}}}
    r.ok=r.intentCommitted&&r.locksRemoved&&r.spoolRemoved;r
}

public func ckbLoadBenchmarkGapTerminal(store: FileKnowledgeStore, planHash: String,
    transactionId: String): CkbBenchmarkGapTerminalManifest {
    let out = CkbBenchmarkGapTerminalManifest()
    let text = try { store.readText(ckbBenchmarkGapTerminalPath(planHash, transactionId)) } catch (_: Exception) { out.errorCode = "benchmark_gap_terminal_invalid_response_encoding"; return out }
    let keys = ["schemaVersion","runId","inputSha256","planHash","candidateVersion","baseActiveVersion","recordsEvidenceHash","proofEvidenceHash","total","completed","activeVersion","transactionId","state","gatesEvidenceHash","checksum"]
    if (!ckbStrictFieldShape(text, keys)) { out.errorCode = "benchmark_gap_terminal_malformed"; return out }
    out.schemaVersion=ckbCurrentField(text,"schemaVersion");out.runId=ckbCurrentField(text,"runId");out.inputSha256=ckbCurrentField(text,"inputSha256");out.planHash=ckbCurrentField(text,"planHash");out.candidateVersion=ckbCurrentField(text,"candidateVersion");out.baseActiveVersion=ckbCurrentField(text,"baseActiveVersion");out.recordsEvidenceHash=ckbCurrentField(text,"recordsEvidenceHash");out.proofEvidenceHash=ckbCurrentField(text,"proofEvidenceHash");out.total=parseIntField(ckbCurrentField(text,"total"),-1);out.completed=parseIntField(ckbCurrentField(text,"completed"),-1);out.activeVersion=ckbCurrentField(text,"activeVersion");out.transactionId=ckbCurrentField(text,"transactionId");out.state=ckbCurrentField(text,"state");out.gatesEvidenceHash=ckbCurrentField(text,"gatesEvidenceHash");out.checksum=ckbCurrentField(text,"checksum")
    out.valid = out.planHash == planHash && out.transactionId == transactionId && ckbBenchmarkGapTerminalInvariant(out) && out.checksum == ckbBenchmarkGapTerminalChecksum(out)
    out.errorCode = if (out.valid) { "" } else { "benchmark_gap_terminal_identity_or_checksum_mismatch" }; out
}

public func ckbLoadBenchmarkGapLastSuccessForPlan(store:FileKnowledgeStore,planHash:String):CkbBenchmarkGapTerminalManifest{
    let invalid=CkbBenchmarkGapTerminalManifest();let text=try{store.readText("metadata/benchmark-gap-curation-last-success.ckb")}catch(_:Exception){invalid.errorCode="benchmark_gap_last_success_invalid_response_encoding";return invalid};if(text==""){invalid.errorCode="benchmark_gap_last_success_not_found";return invalid};let tx=ckbCurrentField(text,"transactionId");let checksum=ckbCurrentField(text,"terminalChecksum");if(ckbCurrentField(text,"planHash")!=planHash||ckbCurrentField(text,"checksum")!=ckbReleaseEvidenceHash("${planHash}|${tx}|${checksum}")){invalid.errorCode="benchmark_gap_last_success_mismatch";return invalid};let terminal=ckbLoadBenchmarkGapTerminal(store,planHash,tx);if(!terminal.valid||terminal.checksum!=checksum){invalid.errorCode="benchmark_gap_last_success_terminal_mismatch";return invalid};terminal
}

private func ckbBenchmarkGapTerminalPath(planHash:String,tx:String):String{"metadata/benchmark-gap-curation/runs/${safeName(planHash)}/terminal/${safeName(tx)}.ckb"}
private func ckbBenchmarkGapTerminalChecksum(t:CkbBenchmarkGapTerminalManifest):String{ckbReleaseEvidenceHash("${t.schemaVersion}|${t.runId}|${t.inputSha256}|${t.planHash}|${t.candidateVersion}|${t.baseActiveVersion}|${t.recordsEvidenceHash}|${t.proofEvidenceHash}|${t.total}|${t.completed}|${t.activeVersion}|${t.transactionId}|${t.state}|${t.gatesEvidenceHash}")}
private func ckbBenchmarkGapTerminalInvariant(t:CkbBenchmarkGapTerminalManifest):Bool{t.schemaVersion=="ckb-benchmark-gap-terminal-v1"&&t.runId!=""&&t.inputSha256.size==64&&t.planHash.size==64&&t.candidateVersion!=""&&t.baseActiveVersion!=""&&t.recordsEvidenceHash.size==64&&t.proofEvidenceHash.size==64&&t.total>0&&t.completed==t.total&&t.activeVersion!=""&&t.transactionId!=""&&t.state=="committed"&&t.gatesEvidenceHash.size==64}
private func ckbBenchmarkGapTerminalText(t:CkbBenchmarkGapTerminalManifest):String{"schemaVersion=${t.schemaVersion}\nrunId=${escapeField(t.runId)}\ninputSha256=${t.inputSha256}\nplanHash=${t.planHash}\ncandidateVersion=${escapeField(t.candidateVersion)}\nbaseActiveVersion=${escapeField(t.baseActiveVersion)}\nrecordsEvidenceHash=${t.recordsEvidenceHash}\nproofEvidenceHash=${t.proofEvidenceHash}\ntotal=${t.total}\ncompleted=${t.completed}\nactiveVersion=${escapeField(t.activeVersion)}\ntransactionId=${escapeField(t.transactionId)}\nstate=${t.state}\ngatesEvidenceHash=${t.gatesEvidenceHash}\nchecksum=${t.checksum}\n"}

private func ckbBenchmarkGapCurationInputPath(config: CkbRuntimeConfig, store: FileKnowledgeStore): String {
    if (config.benchmarkGapCurationInputPath.trimAscii() != "") {
        return config.benchmarkGapCurationInputPath.trimAscii()
    }
    let metadataPath = store.root.join("metadata/gap-curation-input.jsonl")
    if (exists(metadataPath)) {
        return metadataPath.toString()
    }
    let rootPath = store.root.join("gap-curation-input.jsonl")
    if (exists(rootPath)) {
        return rootPath.toString()
    }
    ""
}

private func ckbBenchmarkGapTaskQuery(record: NormalizedRecord): String {
    "visible-benchmark ${record.sourceId} ${ckbBenchmarkGapLine(record.chunk, "Task:")}"
}

private func ckbBenchmarkGapMissingKnowledge(record: NormalizedRecord): String {
    let symbolParts = record.metadata.symbol.split(":")
    if (symbolParts.size >= 2) {
        return symbolParts[1]
    }
    ckbBenchmarkGapLine(record.chunk, "Missing knowledge:")
}

private func ckbBenchmarkGapLine(text: String, prefix: String): String {
    for (line in text.split("\n")) {
        let trimmed = line.trimAscii()
        if (trimmed.startsWith(prefix)) {
            return trimmed.replace(prefix, "").trimAscii()
        }
    }
    ""
}

private func ckbPersistScheduledResolvedMetadataArtifacts(store: FileKnowledgeStore, profile: CkbScheduleTaskProfile, fetch: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, manifest: CangjieVersionManifest, result: CkbScheduledProfileIngestResult, reason: String): Unit {
    if (profile.profile == "cangjie_release_full_sync") {
        result.ok = false
        result.status = "release_live_companion_write_forbidden"
        result.validationDiagnostics.add("release_live_companion_write_forbidden:${reason}")
    } else if (profile.profile == "cangjie_version_branch_refresh") {
        ckbPersistScheduledVersionManifestAfterRefresh(store, profile, fetch, config, manifest, result)
        result.validationDiagnostics.add("resolved_metadata_artifact_persisted:${profile.profile}:${reason}")
    } else if (profile.profile == "cangjie_source_event_sync") {
        ckbPersistScheduledRepositoryEventCheckpoint(store, profile, fetch, result)
        result.validationDiagnostics.add("resolved_metadata_artifact_persisted:${profile.profile}:${reason}")
    }
}

private func ckbApplyScheduledPromotionResult(result: CkbScheduledProfileIngestResult, promotion: CangjieCandidatePromotionResult, successStatus: String): Unit {
    result.candidateVersion = promotion.candidateVersion
    result.activeVersion = promotion.activeVersion
    result.validationStatus = promotion.validation.status
    result.validationSummary = renderCangjieCandidateValidationSummary(promotion.validation)
    result.validationEvidenceHash = promotion.validation.evidenceHash
    result.transactionId = promotion.snapshotTxId
    for (diagnostic in promotion.validation.diagnostics) {
        result.validationDiagnostics.add(diagnostic)
    }
    result.ok = promotion.ok
    result.status = ckbScheduledPromotionTerminalStatus(promotion.ok, promotion.validation.status, successStatus)
    if (promotion.ok && promotion.validation.status == "candidate_validation_passed") {
        ckbAddScheduledValidationGate(result, "candidate_validation_passed")
    }
}

private func ckbAddScheduledValidationGate(result: CkbScheduledProfileIngestResult, gate: String): Unit {
    if (!result.validationGates.contains(gate)) {
        result.validationGates.add(gate)
    }
}

private func ckbApplyReleaseContractEvidence(result: CkbScheduledProfileIngestResult,
    promotion: CangjieCandidatePromotionResult, bundle: CkbReleaseCommitBundle,
    store: FileKnowledgeStore): Unit {
    result.inventoryEvidenceHash = bundle.removed.aggregateEvidenceHash
    let pointer = store.loadActiveSnapshotPointer()
    if (!promotion.ok || !promotion.snapshotPointerCommitted || !pointer.valid || pointer.legacy ||
        pointer.companionMode != CkbActiveSnapshotCompanionMode.RELEASE ||
        promotion.snapshotTxId == "" || pointer.txId != promotion.snapshotTxId ||
        pointer.activeVersion != promotion.activeVersion ||
        promotion.candidateVersion != bundle.candidateVersion ||
        promotion.activeVersion != bundle.activeVersion) {
        result.validationDiagnostics.add("release_contract_transaction_misaligned:tx=${ckbReleaseEvidenceHash(promotion.snapshotTxId)}")
        return
    }
    result.transactionId = pointer.txId
    result.manifestEvidenceHash = pointer.manifestHash
    result.freshnessEvidenceHash = pointer.freshnessHash
    result.sourceCoverageEvidenceHash = bundle.coverage.aggregateEvidenceHash
    if (pointer.manifestHash == bundle.manifestEvidenceHash &&
        pointer.freshnessHash == bundle.freshnessEvidenceHash &&
        pointer.coverageHash == bundle.coverageEvidenceHash) {
        ckbAddScheduledValidationGate(result, "active_companion_transaction_verified")
    }
    if (pointer.manifestHash == bundle.manifestEvidenceHash &&
        ckbValidationEvidenceIsSha256(pointer.manifestHash)) {
        ckbAddScheduledValidationGate(result, "version_manifest_write_verified")
    }
    if (pointer.coverageHash == bundle.coverageEvidenceHash &&
        ckbReleaseCoverageCommitEvidenceValid(bundle.coverage)) {
        ckbAddScheduledValidationGate(result, "release_source_coverage_verified")
    }
    if (pointer.coverageHash == bundle.coverageEvidenceHash &&
        ckbReleaseRemovedCommitEvidenceValid(bundle.removed)) {
        ckbAddScheduledValidationGate(result, "release_removed_reconciliation_verified")
    }
    if (pointer.freshnessHash != bundle.freshnessEvidenceHash) {
        result.validationDiagnostics.add("release_contract_freshness_evidence_misaligned")
    }
}

public func ckbScheduledPromotionTerminalStatus(ok: Bool, validationStatus: String, successStatus: String): String {
    if (ok) {
        return successStatus
    }
    if (validationStatus == "candidate_validation_recoverable" ||
        validationStatus == "candidate_validation_timeout" ||
        validationStatus == "candidate_vector_deadline_exceeded" ||
        validationStatus == "candidate_validation_deadline_exceeded" ||
        validationStatus == "candidate_active_commit_deadline_exceeded" ||
        validationStatus == "candidate_active_snapshot_deadline_exceeded" ||
        validationStatus == "candidate_vector_failed" ||
        validationStatus == "candidate_active_commit_failed" ||
        validationStatus == "candidate_active_snapshot_failed") {
        return validationStatus
    }
    "candidate_validation_failed"
}

private func ckbPersistScheduledVersionManifestAfterRefresh(store: FileKnowledgeStore, profile: CkbScheduleTaskProfile, fetch: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, manifest: CangjieVersionManifest, result: CkbScheduledProfileIngestResult): Unit {
    if (profile.profile == "cangjie_release_full_sync") {
        result.ok = false
        result.status = "release_live_companion_write_forbidden"
        result.validationDiagnostics.add(result.status)
        return
    }
    let refreshed = ckbRefreshVersionManifestFromScheduledFetch(profile, fetch, config, manifest)
    if (refreshed.sources.size == 0) {
        result.ok = false
        result.status = "version_manifest_empty_after_refresh"
        result.validationDiagnostics.add("version_manifest_empty_after_refresh")
        return
    }
    store.saveCangjieVersionManifest(refreshed)
    let loaded = store.loadCangjieVersionManifest()
    if (loaded.sources.size != refreshed.sources.size) {
        result.ok = false
        result.status = "version_manifest_write_verify_failed"
        result.validationDiagnostics.add("version_manifest_write_verify_failed")
        return
    }
    ckbSaveFreshnessBaselineFromManifest(store, loaded, "scheduled:${profile.profile}")
    let evidenceHash = cangjieManifestEvidenceHash(loaded)
    result.validationDiagnostics.add("version_manifest_saved:${loaded.sources.size}:${evidenceHash}")
    result.validationDiagnostics.add("version_manifest_write_verified:sources=${loaded.sources.size}:evidence=${evidenceHash}")
    for (diagnostic in refreshed.diagnostics) {
        result.validationDiagnostics.add("version_manifest_diagnostic:${diagnostic}")
    }
}

private func ckbSaveFreshnessBaselineFromManifest(store: FileKnowledgeStore, manifest: CangjieVersionManifest, crawlAt: String): Unit {
    let report = CangjieCorpusFreshnessReport()
    report.ok = true
    report.degraded = false
    report.targetVersion = manifest.defaultTargetVersion
    for (source in manifest.sources) {
        let item = CangjieCorpusFreshnessSource()
        item.sourceSet = source.sourceSet
        item.sourceFamily = source.sourceFamily
        item.sourceRepo = source.sourceRepo
        item.sourceRef = source.sourceRef
        item.refKind = source.refKind
        item.resolvedCommit = source.resolvedCommit
        item.contentHash = source.contentHash
        item.targetVersion = source.targetVersion
        item.crawlAt = crawlAt
        item.indexedAt = source.resolvedCommit
        if (source.resolvedCommit == "" || source.contentHash == "") {
            item.staleness = "unknown"
            item.status = "degraded"
            report.ok = false
            report.degraded = true
            report.diagnostics.add("freshness_baseline_incomplete:${source.sourceSet}:${source.sourceRepo}")
        } else {
            item.staleness = "fresh"
            item.status = "fresh"
        }
        report.sources.add(item)
    }
    store.saveCangjieCorpusFreshness(report)
}

private func ckbApplyFreshnessArtifactSemantics(report: CangjieCorpusFreshnessReport, previous: CangjieCorpusFreshnessReport): Unit {
    for (source in report.sources) {
        let baseline = ckbFindFreshnessSource(previous, source.sourceSet, source.sourceRepo)
        if (baseline.sourceSet == "") {
            continue
        }
        if (baseline.indexedAt == "" && baseline.resolvedCommit != "" && baseline.contentHash != "") {
            source.status = "degraded"
            source.staleness = "unknown"
            report.ok = false
            report.degraded = true
            report.diagnostics.add("freshness_source_missing_indexedAt:sourceSet=${source.sourceSet}|repo=${source.sourceRepo}|resolvedCommit=${baseline.resolvedCommit}|contentHash=${baseline.contentHash}")
        }
        if (source.staleness == "stale") {
            report.diagnostics.add("freshness_source_hash_changed:sourceSet=${source.sourceSet}|repo=${source.sourceRepo}|oldHash=${baseline.contentHash}|newHash=${source.contentHash}|oldCommit=${baseline.resolvedCommit}|newCommit=${source.resolvedCommit}")
        }
    }
}

private func ckbFreshnessStaleSignalCount(report: CangjieCorpusFreshnessReport): Int64 {
    var count: Int64 = 0
    for (source in report.sources) {
        if (source.staleness == "stale" || source.status == "stale_signal") {
            count += 1
        }
    }
    count
}

private func ckbFindFreshnessSource(report: CangjieCorpusFreshnessReport, sourceSet: String, repo: String): CangjieCorpusFreshnessSource {
    for (source in report.sources) {
        if (source.sourceSet == sourceSet && (repo == "" || source.sourceRepo == repo)) {
            return source
        }
    }
    CangjieCorpusFreshnessSource()
}

private func ckbRefreshVersionManifestFromScheduledFetch(profile: CkbScheduleTaskProfile, fetch: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, manifest: CangjieVersionManifest): CangjieVersionManifest {
    let out = CangjieVersionManifest()
    out.manifestVersion = manifest.manifestVersion
    out.defaultTargetVersion = if (manifest.defaultTargetVersion.trimAscii() == "") { ckbScheduledTargetVersion(config) } else { manifest.defaultTargetVersion }
    if (profile.profile != "cangjie_release_full_sync") {
        for (diagnostic in manifest.diagnostics) {
            if (ckbManifestDiagnosticStillRelevantAfterRefresh(diagnostic)) {
                out.diagnostics.add(diagnostic)
            }
        }
    }
    for (source in manifest.sources) {
        let next = ckbCopyVersionSourceForService(source)
        if (ckbScheduledManifestSourceIncluded(source, true, true, true, true, true)) {
            let sourceDiagnostics = ckbScheduledManifestSourceRefreshDiagnostics(profile, fetch, source)
            for (diagnostic in sourceDiagnostics) {
                out.diagnostics.add(diagnostic)
                if (diagnostic.contains("_degraded")) {
                    out.degraded = true
                }
            }
            let record = ckbFindScheduledManifestRecord(fetch, source)
            if (record.sourceId == "" || !record.fetch.ok) {
                out.degraded = true
                out.diagnostics.add("manifest_source_not_refreshed:${source.sourceSet}:${source.sourceRepo}:${source.sourceRef}")
            } else {
                // EVAL_SUPPORT is acquired from a local snapshot, but its
                // manifest repository remains the logical bootstrap source.
                // Rewriting it to ckb-local:// would make the next full-sync
                // plan depend on a transient acquisition representation.
                if (record.request.repo != "" && source.sourceSet != CangjieSourceSets.EVAL_SUPPORT) {
                    next.sourceRepo = record.request.repo
                }
                next.sourceRef = if (record.fetch.ref != "") { record.fetch.ref } else { if (record.request.ref != "") { record.request.ref } else { source.sourceRef } }
                next.refKind = if (record.request.repo == "ckb-local://eval-support") { "local" } else { if (source.refKind == "") { "branch" } else { source.refKind } }
                next.resolvedCommit = if (record.fetch.commit != "") { record.fetch.commit } else { stableSummaryHash("${record.request.repo}:${record.request.ref}:${record.fetch.bodyHash}") }
                next.contentHash = if (record.fetch.bodyHash != "") { record.fetch.bodyHash } else { source.contentHash }
                next.targetVersion = ckbScheduledTargetVersion(config)
                next.rootKind = ckbScheduledRecordRootKind(profile, record)
            }
        }
        out.sources.add(next)
    }
    out
}

func ckbPrepareReleaseCommitBundle(profile: CkbScheduleTaskProfile,
    fetch: CkbScheduledProfileFetchResult, refreshedManifest: CangjieVersionManifest,
    candidateVersion: String, activeVersion: String, removedRawIds: ArrayList<String>,
    removedNormalizedIds: ArrayList<String>): CkbReleaseCommitBundle {
    let bundle = CkbReleaseCommitBundle()
    bundle.candidateVersion = candidateVersion
    bundle.activeVersion = activeVersion
    bundle.coverage = ckbReleaseCoverageFromFetch(fetch)
    bundle.removed = ckbReleaseRemovedInventory(removedRawIds, removedNormalizedIds)
    bundle.manifest = ckbReleaseManifestForBundle(refreshedManifest, bundle.coverage)
    bundle.freshness = ckbReleaseFreshnessForBundle(bundle.manifest, profile.profile,
        candidateVersion, activeVersion)
    bundle.manifestEvidenceHash = ckbReleaseCompanionEvidenceHash(
        ckbRenderCangjieVersionManifestArtifact(bundle.manifest))
    bundle.freshnessEvidenceHash = ckbReleaseCompanionEvidenceHash(
        ckbRenderCangjieFreshnessArtifact(bundle.freshness))
    bundle.coverageEvidenceHash = ckbReleaseCompanionEvidenceHash(
        ckbRenderReleaseCoverageArtifact(bundle.coverage, bundle.removed))
    bundle.evidenceHash = ckbReleaseCompanionEvidenceHash(
        "manifest=${bundle.manifestEvidenceHash}|freshness=${bundle.freshnessEvidenceHash}|" +
        "coverage=${bundle.coverageEvidenceHash}|removed=${bundle.removed.aggregateEvidenceHash}|" +
        "candidate=${candidateVersion}|active=${activeVersion}")
    let diagnostics = ArrayList<String>()
    for (diagnostic in bundle.manifest.diagnostics) { diagnostics.add(diagnostic) }
    if (!bundle.coverage.complete) { diagnostics.add("release_coverage_incomplete") }
    if (bundle.manifest.sources.size != bundle.coverage.completedSourceCount) {
        diagnostics.add("release_manifest_coverage_source_mismatch")
    }
    if (bundle.freshness.sources.size != bundle.manifest.sources.size) {
        diagnostics.add("release_freshness_manifest_source_mismatch")
    }
    for (diagnostic in ckbReleaseCanonicalDiagnostics(diagnostics)) {
        bundle.diagnostics.add(diagnostic)
    }
    bundle.valid = profile.profile == "cangjie_release_full_sync" &&
        candidateVersion != "" && activeVersion != "" && bundle.coverage.complete &&
        bundle.coverage.completedSourceCount == 5 && bundle.manifest.sources.size == 5 &&
        bundle.freshness.sources.size == 5 &&
        ckbValidationEvidenceIsSha256(bundle.manifestEvidenceHash) &&
        ckbValidationEvidenceIsSha256(bundle.freshnessEvidenceHash) &&
        ckbValidationEvidenceIsSha256(bundle.coverageEvidenceHash) &&
        ckbValidationEvidenceIsSha256(bundle.evidenceHash)
    bundle.status = if (bundle.valid) { "release_commit_bundle_prepared" } else { "release_commit_bundle_invalid" }
    bundle
}

private func ckbFinalizeReleaseCommitBundleRemoved(bundle: CkbReleaseCommitBundle,
    removedRawIds: ArrayList<String>, removedNormalizedIds: ArrayList<String>): Unit {
    let manifestHashBefore = bundle.manifestEvidenceHash
    let freshnessHashBefore = bundle.freshnessEvidenceHash
    bundle.removed = ckbReleaseRemovedInventory(removedRawIds, removedNormalizedIds)
    bundle.coverageEvidenceHash = ckbReleaseCompanionEvidenceHash(
        ckbRenderReleaseCoverageArtifact(bundle.coverage, bundle.removed))
    bundle.evidenceHash = ckbReleaseCompanionEvidenceHash(
        "manifest=${bundle.manifestEvidenceHash}|freshness=${bundle.freshnessEvidenceHash}|" +
        "coverage=${bundle.coverageEvidenceHash}|removed=${bundle.removed.aggregateEvidenceHash}|" +
        "candidate=${bundle.candidateVersion}|active=${bundle.activeVersion}")
    if (bundle.manifestEvidenceHash != manifestHashBefore ||
        bundle.freshnessEvidenceHash != freshnessHashBefore) {
        bundle.valid = false
        bundle.status = "release_bundle_resolution_mutated"
        bundle.diagnostics.add(bundle.status)
    }
}

private func ckbReleaseCoverageFromFetch(fetch: CkbScheduledProfileFetchResult): CkbReleaseCoverage {
    let coverage = CkbReleaseCoverage()
    coverage.targetVersion = fetch.releasePlan.targetVersion
    coverage.planHash = fetch.releasePlan.planHash
    coverage.plannedSourceCount = fetch.releasePlan.sources.size
    for (inventory in fetch.releaseInventories) {
        let item = CkbReleaseSourceCoverage()
        item.sourceIdentity = inventory.sourceIdentity
        item.sourceSet = inventory.sourceSet
        item.sourceFamily = inventory.sourceFamily
        item.repo = inventory.repo
        item.originalRef = inventory.originalRef
        item.resolvedCommit = inventory.resolvedCommit
        item.status = inventory.status
        item.complete = inventory.complete
        item.explicitEnd = inventory.explicitEnd
        item.pagesScanned = inventory.pagesScanned
        item.objectsSeen = inventory.objectsSeen
        item.filesSeen = inventory.filesSeen
        item.contentBytes = inventory.contentBytes
        let planned = inventory.plannedPaths.toArray()
        sort(planned)
        for (path in planned) { item.plannedPaths.add(path) }
        let completed = inventory.completedPaths.toArray()
        sort(completed)
        for (path in completed) { item.completedPaths.add(path) }
        let contentEntries = ArrayList<String>()
        for (record in fetch.contentRecords) {
            if (record.releaseSource.canonicalIdentity != item.sourceIdentity) { continue }
            let bodyHash = if (record.fetch.bodyHash != "") {
                record.fetch.bodyHash
            } else { ckbReleaseEvidenceHash(record.fetch.body) }
            contentEntries.add("${record.request.path}|${bodyHash}")
        }
        let orderedContent = contentEntries.toArray()
        sort(orderedContent)
        for (entry in orderedContent) { item.contentEntries.add(entry) }
        item.inventoryEvidenceHash = ckbReleaseEvidenceHash(
            ckbReleaseSourceCoverageCanonicalText(item))
        coverage.plannedFileCount += item.plannedPaths.size
        coverage.completedFileCount += item.completedPaths.size
        if (item.complete && item.explicitEnd &&
            item.plannedPaths.size == item.completedPaths.size &&
            item.completedPaths.size == item.contentEntries.size) {
            coverage.completedSourceCount += 1
        }
        coverage.sources.add(item)
    }
    coverage.complete = coverage.plannedSourceCount == 5 &&
        coverage.completedSourceCount == coverage.plannedSourceCount &&
        coverage.plannedFileCount == coverage.completedFileCount
    let sourceHashes = ArrayList<String>()
    for (source in coverage.sources) {
        sourceHashes.add("${source.sourceIdentity}|${source.inventoryEvidenceHash}")
    }
    let orderedHashes = sourceHashes.toArray()
    sort(orderedHashes)
    let aggregate = StringBuilder()
    aggregate.append("schema=${coverage.schemaVersion}|target=${coverage.targetVersion}|plan=${coverage.planHash}|")
    aggregate.append("plannedSources=${coverage.plannedSourceCount}|completedSources=${coverage.completedSourceCount}|")
    aggregate.append("plannedFiles=${coverage.plannedFileCount}|completedFiles=${coverage.completedFileCount}|complete=${coverage.complete}")
    for (entry in orderedHashes) { aggregate.append("|source=${ckbReleaseBundleCanonicalField(entry)}") }
    coverage.aggregateEvidenceHash = ckbReleaseEvidenceHash(aggregate.toString())
    coverage
}

private func ckbReleaseSourceCoverageCanonicalText(source: CkbReleaseSourceCoverage): String {
    let out = StringBuilder()
    out.append("identity=${ckbReleaseBundleCanonicalField(source.sourceIdentity)}")
    out.append("|set=${ckbReleaseBundleCanonicalField(source.sourceSet)}")
    out.append("|family=${ckbReleaseBundleCanonicalField(source.sourceFamily)}")
    out.append("|repo=${ckbReleaseBundleCanonicalField(source.repo)}")
    out.append("|ref=${ckbReleaseBundleCanonicalField(source.originalRef)}")
    out.append("|commit=${ckbReleaseBundleCanonicalField(source.resolvedCommit)}")
    out.append("|status=${ckbReleaseBundleCanonicalField(source.status)}|complete=${source.complete}|explicitEnd=${source.explicitEnd}")
    out.append("|pages=${source.pagesScanned}|objects=${source.objectsSeen}|files=${source.filesSeen}|bytes=${source.contentBytes}")
    for (path in source.plannedPaths) { out.append("|planned=${ckbReleaseBundleCanonicalField(path)}") }
    for (path in source.completedPaths) { out.append("|completed=${ckbReleaseBundleCanonicalField(path)}") }
    for (entry in source.contentEntries) { out.append("|content=${ckbReleaseBundleCanonicalField(entry)}") }
    out.toString()
}

private func ckbReleaseRemovedInventory(rawIds: ArrayList<String>, normalizedIds: ArrayList<String>): CkbReleaseRemovedInventory {
    let removed = CkbReleaseRemovedInventory()
    let raw = rawIds.toArray()
    sort(raw)
    for (sourceId in raw) { removed.rawSourceIds.add(sourceId) }
    let normalized = normalizedIds.toArray()
    sort(normalized)
    for (sourceId in normalized) { removed.normalizedSourceIds.add(sourceId) }
    removed.rawEvidenceHash = ckbReleaseRemovedIdsEvidenceHash(removed.rawSourceIds)
    removed.normalizedEvidenceHash = ckbReleaseRemovedIdsEvidenceHash(removed.normalizedSourceIds)
    removed.aggregateEvidenceHash = ckbReleaseEvidenceHash(
        "raw=${removed.rawEvidenceHash}|normalized=${removed.normalizedEvidenceHash}")
    removed
}

private func ckbReleaseManifestForBundle(refreshed: CangjieVersionManifest,
    coverage: CkbReleaseCoverage): CangjieVersionManifest {
    let manifest = CangjieVersionManifest()
    manifest.manifestVersion = CangjieVersionManifestVersions.V2
    manifest.defaultTargetVersion = refreshed.defaultTargetVersion
    manifest.degraded = refreshed.degraded || !coverage.complete
    for (diagnostic in ckbReleaseCanonicalDiagnostics(refreshed.diagnostics)) {
        manifest.diagnostics.add(diagnostic)
    }
    for (source in refreshed.sources) {
        let copied = ckbCopyVersionSourceForService(source)
        for (item in coverage.sources) {
            if (item.sourceSet == copied.sourceSet) {
                copied.resolvedCommit = item.resolvedCommit
                copied.contentHash = item.inventoryEvidenceHash
                copied.targetVersion = coverage.targetVersion
                break
            }
        }
        manifest.sources.add(copied)
    }
    manifest
}

private func ckbReleaseFreshnessForBundle(manifest: CangjieVersionManifest, profile: String,
    candidateVersion: String, activeVersion: String): CangjieCorpusFreshnessReport {
    let report = CangjieCorpusFreshnessReport()
    report.ok = true
    report.degraded = manifest.degraded
    report.activeKnowledgeVersion = activeVersion
    report.candidateKnowledgeVersion = candidateVersion
    report.targetVersion = manifest.defaultTargetVersion
    for (source in manifest.sources) {
        let item = CangjieCorpusFreshnessSource()
        item.sourceSet = source.sourceSet
        item.sourceFamily = source.sourceFamily
        item.sourceRepo = source.sourceRepo
        item.sourceRef = source.sourceRef
        item.refKind = source.refKind
        item.resolvedCommit = source.resolvedCommit
        item.contentHash = source.contentHash
        item.targetVersion = source.targetVersion
        item.crawlAt = "scheduled:${profile}"
        item.indexedAt = activeVersion
        item.staleness = "fresh"
        item.status = "fresh"
        if (item.resolvedCommit == "" || item.contentHash == "") {
            item.staleness = "unknown"
            item.status = "degraded"
            report.ok = false
            report.degraded = true
        }
        report.sources.add(item)
    }
    report
}

private func ckbArtifactValueAfterAsciiPrefix(value: String, prefix: String): String {
    let out = StringBuilder()
    var remaining = prefix.toRuneArray().size
    for (ch in value.toRuneArray()) {
        if (remaining > 0) {
            remaining -= 1
        } else {
            out.append(ch)
        }
    }
    out.toString()
}

private func ckbParseCangjieFreshnessArtifact(text: String): CangjieCorpusFreshnessReport {
    let report = CangjieCorpusFreshnessReport()
    if (text == "") {
        report.ok = false
        report.degraded = true
        report.diagnostics.add("freshness_artifact_missing")
        return report
    }
    var recognizedLineCount: Int64 = 0
    for (line in text.split("\n")) {
        let trimmed = line.trimAscii()
        if (trimmed == "") { continue }
        if (trimmed.startsWith("ok=")) {
            recognizedLineCount += 1
            report.ok = parseBool(ckbArtifactValueAfterAsciiPrefix(trimmed, "ok="))
        } else if (trimmed.startsWith("degraded=")) {
            recognizedLineCount += 1
            report.degraded = parseBool(ckbArtifactValueAfterAsciiPrefix(trimmed,
                "degraded="))
        } else if (trimmed.startsWith("activeKnowledgeVersion=")) {
            recognizedLineCount += 1
            report.activeKnowledgeVersion = unescapeField(
                ckbArtifactValueAfterAsciiPrefix(trimmed, "activeKnowledgeVersion="))
        } else if (trimmed.startsWith("candidateKnowledgeVersion=")) {
            recognizedLineCount += 1
            report.candidateKnowledgeVersion = unescapeField(
                ckbArtifactValueAfterAsciiPrefix(trimmed, "candidateKnowledgeVersion="))
        } else if (trimmed.startsWith("failedCandidateVersion=")) {
            recognizedLineCount += 1
            report.failedCandidateVersion = unescapeField(
                ckbArtifactValueAfterAsciiPrefix(trimmed, "failedCandidateVersion="))
        } else if (trimmed.startsWith("targetVersion=")) {
            recognizedLineCount += 1
            report.targetVersion = unescapeField(
                ckbArtifactValueAfterAsciiPrefix(trimmed, "targetVersion="))
        } else if (trimmed.startsWith("diagnostic|")) {
            recognizedLineCount += 1
            let parts = trimmed.split("|")
            if (parts.size >= 2) { report.diagnostics.add(unescapeField(parts[1])) }
        } else if (trimmed.startsWith("source|")) {
            recognizedLineCount += 1
            let parts = trimmed.split("|")
            if (parts.size >= 11) {
                let source = CangjieCorpusFreshnessSource()
                source.sourceSet = unescapeField(parts[1])
                source.sourceFamily = unescapeField(parts[2])
                source.sourceRepo = unescapeField(parts[3])
                source.sourceRef = unescapeField(parts[4])
                source.resolvedCommit = unescapeField(parts[5])
                source.contentHash = unescapeField(parts[6])
                source.crawlAt = unescapeField(parts[7])
                source.indexedAt = unescapeField(parts[8])
                source.staleness = unescapeField(parts[9])
                source.status = unescapeField(parts[10])
                if (parts.size >= 13) {
                    source.refKind = unescapeField(parts[11])
                    source.targetVersion = unescapeField(parts[12])
                }
                report.sources.add(source)
            } else {
                report.ok = false
                report.degraded = true
                report.diagnostics.add("freshness_artifact_malformed_source_line")
            }
        }
    }
    if (text.trimAscii() != "" && report.sources.size == 0 &&
        recognizedLineCount == 0) {
        report.ok = false
        report.degraded = true
        report.diagnostics.add("freshness_artifact_malformed")
    }
    report
}

private func ckbParseCangjieVersionManifestArtifact(text: String): CangjieVersionManifest {
    let manifest = CangjieVersionManifest()
    manifest.sources.clear()
    if (text == "") { return manifest }
    var recognizedLineCount: Int64 = 0
    for (line in text.split("\n")) {
        let trimmed = line.trimAscii()
        if (trimmed == "") { continue }
        if (trimmed.startsWith("manifestVersion=")) {
            recognizedLineCount += 1
            manifest.manifestVersion = unescapeField(
                ckbArtifactValueAfterAsciiPrefix(trimmed, "manifestVersion="))
        } else if (trimmed.startsWith("defaultTargetVersion=")) {
            recognizedLineCount += 1
            manifest.defaultTargetVersion = unescapeField(
                ckbArtifactValueAfterAsciiPrefix(trimmed, "defaultTargetVersion="))
        } else if (trimmed.startsWith("degraded=")) {
            recognizedLineCount += 1
            manifest.degraded = ckbArtifactValueAfterAsciiPrefix(trimmed,
                "degraded=") == "true"
        } else if (trimmed.startsWith("diagnostic|")) {
            recognizedLineCount += 1
            let parts = trimmed.split("|")
            if (parts.size >= 2) { manifest.diagnostics.add(unescapeField(parts[1])) }
        } else if (trimmed.startsWith("source|")) {
            recognizedLineCount += 1
            let parts = trimmed.split("|")
            if (parts.size >= 9) {
                let source = CangjieVersionSource()
                source.targetVersion = unescapeField(parts[1])
                source.sourceSet = unescapeField(parts[2])
                source.sourceFamily = unescapeField(parts[3])
                source.sourceRepo = unescapeField(parts[4])
                source.sourceRef = unescapeField(parts[5])
                source.refKind = unescapeField(parts[6])
                source.resolvedCommit = unescapeField(parts[7])
                source.contentHash = unescapeField(parts[8])
                if (parts.size >= 10) { source.rootKind = unescapeField(parts[9]) }
                manifest.sources.add(source)
            } else {
                manifest.degraded = true
                manifest.diagnostics.add("version_manifest_malformed_source_line")
            }
        }
    }
    if (text.trimAscii() != "" && manifest.sources.size == 0 &&
        recognizedLineCount == 0) {
        manifest.degraded = true
        manifest.diagnostics.add("version_manifest_malformed")
    }
    manifest
}

func ckbRenderCangjieVersionManifestArtifact(manifest: CangjieVersionManifest): String {
    var text = "manifestVersion=${escapeField(manifest.manifestVersion)}\n"
    text += "defaultTargetVersion=${escapeField(manifest.defaultTargetVersion)}\n"
    text += "degraded=${manifest.degraded}\n"
    let diagnostics = ckbReleaseCanonicalDiagnostics(manifest.diagnostics)
    for (diagnostic in diagnostics) { text += "diagnostic|${escapeField(diagnostic)}\n" }
    let sourceLines = ArrayList<String>()
    for (source in manifest.sources) {
        sourceLines.add("source|${escapeField(source.targetVersion)}|${escapeField(source.sourceSet)}|${escapeField(source.sourceFamily)}|${escapeField(source.sourceRepo)}|${escapeField(source.sourceRef)}|${escapeField(source.refKind)}|${escapeField(source.resolvedCommit)}|${escapeField(source.contentHash)}|${escapeField(source.rootKind)}")
    }
    let ordered = sourceLines.toArray()
    sort(ordered)
    for (line in ordered) { text += "${line}\n" }
    text
}

func ckbRenderCangjieFreshnessArtifact(report: CangjieCorpusFreshnessReport): String {
    var text = "ok=${report.ok}\n"
    text += "degraded=${report.degraded}\n"
    text += "activeKnowledgeVersion=${escapeField(report.activeKnowledgeVersion)}\n"
    text += "candidateKnowledgeVersion=${escapeField(report.candidateKnowledgeVersion)}\n"
    text += "failedCandidateVersion=${escapeField(report.failedCandidateVersion)}\n"
    text += "targetVersion=${escapeField(report.targetVersion)}\n"
    for (diagnostic in ckbReleaseCanonicalDiagnostics(report.diagnostics)) {
        text += "diagnostic|${escapeField(diagnostic)}\n"
    }
    let sourceLines = ArrayList<String>()
    for (source in report.sources) {
        sourceLines.add("source|${escapeField(source.sourceSet)}|${escapeField(source.sourceFamily)}|${escapeField(source.sourceRepo)}|${escapeField(source.sourceRef)}|${escapeField(source.resolvedCommit)}|${escapeField(source.contentHash)}|${escapeField(source.crawlAt)}|${escapeField(source.indexedAt)}|${escapeField(source.staleness)}|${escapeField(source.status)}|${escapeField(source.refKind)}|${escapeField(source.targetVersion)}")
    }
    let ordered = sourceLines.toArray()
    sort(ordered)
    for (line in ordered) { text += "${line}\n" }
    text
}

func ckbRenderReleaseCoverageArtifact(coverage: CkbReleaseCoverage,
    removed: CkbReleaseRemovedInventory): String {
    var text = "schema=${escapeField(coverage.schemaVersion)}\n"
    text += "targetVersion=${escapeField(coverage.targetVersion)}\n"
    text += "planHash=${escapeField(coverage.planHash)}\n"
    text += "complete=${coverage.complete}\n"
    text += "plannedSourceCount=${coverage.plannedSourceCount}\n"
    text += "completedSourceCount=${coverage.completedSourceCount}\n"
    text += "plannedFileCount=${coverage.plannedFileCount}\n"
    text += "completedFileCount=${coverage.completedFileCount}\n"
    text += "aggregateEvidenceHash=${coverage.aggregateEvidenceHash}\n"
    let lines = ArrayList<String>()
    for (source in coverage.sources) {
        lines.add("source|${escapeField(source.sourceIdentity)}|${escapeField(source.sourceSet)}|${escapeField(source.sourceFamily)}|${escapeField(source.repo)}|${escapeField(source.originalRef)}|${escapeField(source.resolvedCommit)}|${escapeField(source.status)}|${source.complete}|${source.explicitEnd}|${source.pagesScanned}|${source.objectsSeen}|${source.filesSeen}|${source.contentBytes}|${source.inventoryEvidenceHash}")
        for (path in source.plannedPaths) { lines.add("planned|${escapeField(source.sourceIdentity)}|${escapeField(path)}") }
        for (path in source.completedPaths) { lines.add("completed|${escapeField(source.sourceIdentity)}|${escapeField(path)}") }
        for (entry in source.contentEntries) { lines.add("content|${escapeField(source.sourceIdentity)}|${escapeField(entry)}") }
    }
    for (sourceId in removed.rawSourceIds) { lines.add("removedRaw|${escapeField(sourceId)}") }
    for (sourceId in removed.normalizedSourceIds) { lines.add("removedNormalized|${escapeField(sourceId)}") }
    lines.add("removedEvidence|${removed.rawEvidenceHash}|${removed.normalizedEvidenceHash}|${removed.aggregateEvidenceHash}")
    let ordered = lines.toArray()
    sort(ordered)
    for (line in ordered) { text += "${line}\n" }
    text
}

private func ckbReleaseCanonicalDiagnostics(values: ArrayList<String>): ArrayList<String> {
    let unique = HashSet<String>()
    for (diagnostic in values) {
        let clean = utf8SafePrefix(redactSensitive(diagnostic.trimAscii()), 240)
        if (clean != "") { unique.add(clean) }
    }
    let ordered = ArrayList<String>()
    for (diagnostic in unique) { ordered.add(diagnostic) }
    let array = ordered.toArray()
    sort(array)
    let out = ArrayList<String>()
    for (diagnostic in array) {
        if (out.size >= 64) { break }
        out.add(diagnostic)
    }
    out
}

private func ckbReleaseBundleCanonicalField(value: String): String {
    "${value.toArray().size}:${value}"
}

func ckbReleaseCompanionEvidenceHash(value: String): String {
    "hsha256:${ckbReleaseEvidenceHash(value).toAsciiLower()}"
}

private func ckbValidateReleaseCommitBundleForSnapshot(bundle: CkbReleaseCommitBundle,
    status: KnowledgeStatus, manifestHash: String, freshnessHash: String,
    coverageHash: String): String {
    if (!bundle.valid || bundle.status != "release_commit_bundle_prepared") {
        return "release_commit_bundle_not_prepared"
    }
    if (bundle.activeVersion != status.activeKnowledgeVersion) {
        return "release_commit_bundle_active_mismatch"
    }
    if (bundle.candidateVersion != status.candidateKnowledgeVersion) {
        return "release_commit_bundle_candidate_mismatch"
    }
    if (bundle.manifest.manifestVersion != CangjieVersionManifestVersions.V2) {
        return "release_commit_bundle_manifest_version_invalid"
    }
    if (bundle.freshness.activeKnowledgeVersion != bundle.activeVersion ||
        bundle.freshness.candidateKnowledgeVersion != bundle.candidateVersion ||
        bundle.freshness.failedCandidateVersion != status.failedCandidateVersion) {
        return "release_commit_bundle_freshness_identity_mismatch"
    }
    if (bundle.manifest.defaultTargetVersion == "" ||
        bundle.freshness.targetVersion != bundle.manifest.defaultTargetVersion ||
        bundle.coverage.targetVersion != bundle.manifest.defaultTargetVersion) {
        return "release_commit_bundle_target_mismatch"
    }
    if (manifestHash != bundle.manifestEvidenceHash ||
        freshnessHash != bundle.freshnessEvidenceHash ||
        coverageHash != bundle.coverageEvidenceHash) {
        return "release_commit_bundle_component_hash_mismatch"
    }
    if (!ckbReleaseRemovedCommitEvidenceValid(bundle.removed)) {
        return "release_commit_bundle_removed_evidence_invalid"
    }
    if (!ckbReleaseCoverageCommitEvidenceValid(bundle.coverage)) {
        return "release_commit_bundle_coverage_evidence_invalid"
    }
    if (!ckbReleaseManifestCoverageCommitAligned(bundle.manifest, bundle.coverage)) {
        return "release_commit_bundle_manifest_coverage_mismatch"
    }
    if (!ckbReleaseFreshnessManifestCommitAligned(bundle.freshness, bundle.manifest,
        bundle.activeVersion)) {
        return "release_commit_bundle_freshness_manifest_mismatch"
    }
    let expectedEvidence = ckbReleaseCompanionEvidenceHash(
        "manifest=${bundle.manifestEvidenceHash}|freshness=${bundle.freshnessEvidenceHash}|" +
        "coverage=${bundle.coverageEvidenceHash}|removed=${bundle.removed.aggregateEvidenceHash}|" +
        "candidate=${bundle.candidateVersion}|active=${bundle.activeVersion}")
    if (bundle.evidenceHash != expectedEvidence) {
        return "release_commit_bundle_aggregate_evidence_mismatch"
    }
    ""
}

private func ckbReleaseRemovedCommitEvidenceValid(removed: CkbReleaseRemovedInventory): Bool {
    let rawHash = ckbReleaseRemovedIdsEvidenceHash(removed.rawSourceIds)
    let normalizedHash = ckbReleaseRemovedIdsEvidenceHash(removed.normalizedSourceIds)
    removed.rawEvidenceHash == rawHash && removed.normalizedEvidenceHash == normalizedHash &&
        removed.aggregateEvidenceHash == ckbReleaseEvidenceHash(
            "raw=${rawHash}|normalized=${normalizedHash}")
}

private func ckbReleaseCoverageCommitEvidenceValid(coverage: CkbReleaseCoverage): Bool {
    if (coverage.planHash == "" || !coverage.complete ||
        coverage.plannedSourceCount != 5 || coverage.completedSourceCount != 5 ||
        coverage.plannedSourceCount != coverage.sources.size || coverage.sources.size != 5 ||
        coverage.plannedFileCount != coverage.completedFileCount) { return false }
    var plannedFiles: Int64 = 0
    var completedFiles: Int64 = 0
    var completedSources: Int64 = 0
    let identities = HashSet<String>()
    let sourceSets = HashSet<String>()
    let sourceHashes = ArrayList<String>()
    for (source in coverage.sources) {
        if (source.sourceIdentity == "" || source.sourceSet == "" ||
            identities.contains(source.sourceIdentity) || sourceSets.contains(source.sourceSet)) {
            return false
        }
        identities.add(source.sourceIdentity)
        sourceSets.add(source.sourceSet)
        if (source.inventoryEvidenceHash != ckbReleaseEvidenceHash(
            ckbReleaseSourceCoverageCanonicalText(source))) { return false }
        plannedFiles += source.plannedPaths.size
        completedFiles += source.completedPaths.size
        if (source.complete && source.explicitEnd &&
            ckbReleaseResumeSameStringSet(source.plannedPaths, source.completedPaths) &&
            source.completedPaths.size == source.contentEntries.size) {
            completedSources += 1
        }
        sourceHashes.add("${source.sourceIdentity}|${source.inventoryEvidenceHash}")
    }
    if (coverage.plannedFileCount != plannedFiles ||
        coverage.completedFileCount != completedFiles ||
        coverage.completedSourceCount != completedSources) { return false }
    let complete = coverage.plannedSourceCount == 5 &&
        completedSources == coverage.plannedSourceCount && plannedFiles == completedFiles
    if (coverage.complete != complete) { return false }
    let orderedHashes = sourceHashes.toArray()
    sort(orderedHashes)
    let aggregate = StringBuilder()
    aggregate.append("schema=${coverage.schemaVersion}|target=${coverage.targetVersion}|plan=${coverage.planHash}|")
    aggregate.append("plannedSources=${coverage.plannedSourceCount}|completedSources=${coverage.completedSourceCount}|")
    aggregate.append("plannedFiles=${coverage.plannedFileCount}|completedFiles=${coverage.completedFileCount}|complete=${coverage.complete}")
    for (entry in orderedHashes) {
        aggregate.append("|source=${ckbReleaseBundleCanonicalField(entry)}")
    }
    coverage.aggregateEvidenceHash == ckbReleaseEvidenceHash(aggregate.toString())
}

private func ckbReleaseManifestCoverageCommitAligned(manifest: CangjieVersionManifest,
    coverage: CkbReleaseCoverage): Bool {
    if (manifest.sources.size != coverage.sources.size) { return false }
    let sourceSets = HashSet<String>()
    for (source in manifest.sources) {
        if (source.sourceSet == "" || sourceSets.contains(source.sourceSet) ||
            source.targetVersion != coverage.targetVersion) { return false }
        sourceSets.add(source.sourceSet)
        var matches: Int64 = 0
        for (item in coverage.sources) {
            if (item.sourceSet == source.sourceSet) {
                matches += 1
                if (source.resolvedCommit != item.resolvedCommit ||
                    source.contentHash != item.inventoryEvidenceHash) { return false }
            }
        }
        if (matches != 1) { return false }
    }
    true
}

private func ckbReleaseFreshnessManifestCommitAligned(
    freshness: CangjieCorpusFreshnessReport, manifest: CangjieVersionManifest,
    activeVersion: String): Bool {
    if (freshness.sources.size != manifest.sources.size ||
        freshness.degraded != manifest.degraded) { return false }
    for (source in manifest.sources) {
        var matches: Int64 = 0
        for (item in freshness.sources) {
            if (item.sourceSet == source.sourceSet) {
                matches += 1
                if (item.sourceFamily != source.sourceFamily ||
                    item.sourceRepo != source.sourceRepo || item.sourceRef != source.sourceRef ||
                    item.refKind != source.refKind || item.resolvedCommit != source.resolvedCommit ||
                    item.contentHash != source.contentHash || item.targetVersion != source.targetVersion ||
                    item.indexedAt != activeVersion) { return false }
            }
        }
        if (matches != 1) { return false }
    }
    true
}

private func ckbManifestDiagnosticStillRelevantAfterRefresh(diagnostic: String): Bool {
    !(diagnostic.contains("offline_baseline") || diagnostic.contains("offline-baseline") || diagnostic.contains("manifest_offline_baseline") || diagnostic.contains("version_manifest_contains_offline_baseline"))
}

private func ckbScheduledManifestSourceRefreshDiagnostics(profile: CkbScheduleTaskProfile, fetch: CkbScheduledProfileFetchResult, source: CangjieVersionSource): ArrayList<String> {
    let diagnostics = ArrayList<String>()
    for (record in fetch.records) {
        if (!ckbScheduledRecordMatchesManifestSource(record, source)) {
            continue
        }
        let repo = if (record.request.repo != "") { record.request.repo } else { record.fetch.repo }
        if (record.request.purpose == "manifest_ref_resolved" && record.fetch.ok) {
            diagnostics.add("manifest_source_ref_resolved:${source.sourceSet}:${repo}:${record.fetch.commit}:${record.fetch.bodyHash}")
        } else if (record.request.kind == SourceKinds.GITCODE_TREE && record.fetch.ok) {
            diagnostics.add("manifest_source_tree_resolved:${source.sourceSet}:${repo}:${record.fetch.commit}:page=${record.request.page}:bodyHash=${record.fetch.bodyHash}")
        } else if (record.request.kind == SourceKinds.GITCODE_SOURCE && record.fetch.ok) {
            diagnostics.add("manifest_source_content_sample_ok:${source.sourceSet}:${repo}:${record.request.path}:${record.fetch.bodyHash}")
        } else if (!record.fetch.ok && ckbScheduledReadinessFailureClassForProfile(profile, fetch, record) == "content") {
            diagnostics.add("manifest_source_content_sample_degraded:${source.sourceSet}:${repo}:${record.fetch.status}")
        } else if (!record.fetch.ok) {
            diagnostics.add("manifest_source_metadata_degraded:${source.sourceSet}:${repo}:${record.fetch.status}")
        }
    }
    diagnostics
}

private func ckbScheduledRecordRootKind(profile: CkbScheduleTaskProfile, record: CkbScheduledSourceRecord): String {
    if (record.request.repo == "ckb-local://eval-support") {
        return "local-eval-support"
    }
    "scheduled:${profile.profile}"
}

private func ckbFindScheduledManifestRecord(fetch: CkbScheduledProfileFetchResult, source: CangjieVersionSource): CkbScheduledSourceRecord {
    for (record in fetch.records) {
        if (ckbScheduledRecordMatchesManifestSource(record, source)) {
            return record
        }
    }
    CkbScheduledSourceRecord()
}

private func ckbScheduledRecordMatchesManifestSource(record: CkbScheduledSourceRecord, source: CangjieVersionSource): Bool {
    let repo = if (record.request.repo != "") { record.request.repo } else { record.fetch.repo }
    record.sourceSet == source.sourceSet && (repo == source.sourceRepo || source.sourceSet == CangjieSourceSets.EVAL_SUPPORT)
}

private func ckbCopyVersionSourceForService(source: CangjieVersionSource): CangjieVersionSource {
    let out = CangjieVersionSource()
    out.targetVersion = source.targetVersion
    out.sourceSet = source.sourceSet
    out.sourceFamily = source.sourceFamily
    out.sourceRepo = source.sourceRepo
    out.sourceRef = source.sourceRef
    out.refKind = source.refKind
    out.resolvedCommit = source.resolvedCommit
    out.contentHash = source.contentHash
    out.rootKind = source.rootKind
    out
}

private class CkbScheduledRepositoryEventWatermarks {
    var resolvedWatermark: String = ""
    var ingestedWatermark: String = ""
    var contentState: String = "not_ingested"

    init() {}
}

private func ckbPersistScheduledRepositoryEventCheckpoint(store: FileKnowledgeStore, profile: CkbScheduleTaskProfile, fetch: CkbScheduledProfileFetchResult, ingest: CkbScheduledProfileIngestResult): Unit {
    let watermarks = ckbScheduledRepositoryEventWatermarks(fetch, ingest)
    let checkpoint = CkbAdminOperationResult()
    checkpoint.status = ingest.status
    checkpoint.degraded = !ingest.ok
    checkpoint.diagnostic = "scheduled_repository_event_checkpoint|resolvedWatermark=${watermarks.resolvedWatermark}|ingestedWatermark=${watermarks.ingestedWatermark}|contentState=${watermarks.contentState}"
    checkpoint.profile = profile.profile
    checkpoint.requestCount = fetch.requestCount
    checkpoint.truncated = fetch.truncated
    checkpoint.activeKnowledgeVersion = ingest.activeVersion
    checkpoint.candidateKnowledgeVersion = ingest.candidateVersion
    for (kind in profile.updatedDataKinds) {
        checkpoint.updatedDataKinds.add(kind)
    }
    for (record in fetch.records) {
        if (!record.fetch.ok) {
            continue
        }
        if (checkpoint.repo == "") {
            checkpoint.repo = if (record.request.repo != "") { record.request.repo } else { record.fetch.repo }
            checkpoint.ref = if (record.request.ref != "") { record.request.ref } else { record.fetch.ref }
        }
        if (record.request.path != "") {
            checkpoint.matchedPaths.add(record.request.path)
        } else if (record.request.repo != "") {
            checkpoint.matchedPaths.add(record.request.repo)
        }
    }
    store.saveRepositoryEventCheckpoint(checkpoint)
    ingest.validationDiagnostics.add("repository_event_checkpoint_saved:${checkpoint.repo}:${checkpoint.ref}:resolvedWatermark=${watermarks.resolvedWatermark}:ingestedWatermark=${watermarks.ingestedWatermark}")
    if (watermarks.contentState != "ingested") {
        ingest.validationDiagnostics.add("repository_event_checkpoint_degraded:resolvedWatermark=${watermarks.resolvedWatermark}:ingestedWatermark=${watermarks.ingestedWatermark}:contentState=${watermarks.contentState}")
    }
}

private func ckbScheduledRepositoryEventWatermarks(fetch: CkbScheduledProfileFetchResult, ingest: CkbScheduledProfileIngestResult): CkbScheduledRepositoryEventWatermarks {
    let watermarks = CkbScheduledRepositoryEventWatermarks()
    let resolvedSeed = StringBuilder()
    let ingestedSeed = StringBuilder()
    for (record in fetch.records) {
        if (!record.fetch.ok) {
            continue
        }
        let repo = if (record.request.repo != "") { record.request.repo } else { record.fetch.repo }
        let ref = if (record.fetch.ref != "") { record.fetch.ref } else { record.request.ref }
        if (record.request.kind == SourceKinds.GITCODE_TREE || record.request.repo == "ckb-local://eval-support") {
            resolvedSeed.append("${record.sourceSet}:${repo}:${ref}:${record.fetch.commit}:${record.fetch.bodyHash}|")
        }
        if (record.request.kind == SourceKinds.GITCODE_SOURCE || record.request.repo == "ckb-local://eval-support") {
            ingestedSeed.append("${record.sourceSet}:${repo}:${record.request.path}:${record.fetch.commit}:${record.fetch.bodyHash}|")
        }
    }
    let resolvedText = resolvedSeed.toString()
    let ingestedText = ingestedSeed.toString()
    watermarks.resolvedWatermark = if (resolvedText == "") { "unresolved" } else { stableSummaryHash(resolvedText) }
    if (ingest.ok && ingestedText != "") {
        watermarks.ingestedWatermark = stableSummaryHash("${ingestedText}:${ingest.activeVersion}:${ingest.candidateVersion}")
        watermarks.contentState = "ingested"
    } else if (ingestedText != "") {
        watermarks.ingestedWatermark = "pending:${stableSummaryHash(ingestedText)}"
        watermarks.contentState = "content_degraded"
    } else {
        watermarks.ingestedWatermark = "not_ingested"
        watermarks.contentState = "content_degraded"
    }
    watermarks
}

private func ckbPersistProbeOnlyScheduledArtifacts(store: FileKnowledgeStore, profile: CkbScheduleTaskProfile, fetch: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig, manifest: CangjieVersionManifest, ingest: CkbScheduledProfileIngestResult): Unit {
    if (profile.profile == "community_repo_discovery") {
        let result = CkbAdminOperationResult()
        result.status = "ok"
        result.degraded = false
        result.diagnostic = "scheduled_repo_discovery_checkpoint"
        result.repo = "cangjie"
        result.ref = "scheduled"
        result.requestCount = fetch.requestCount
        result.repoCount = fetch.fetchedCount
        result.activeRepoListVersion = stableSummaryHash("repo-list:${fetch.requestCount}:${fetch.fetchedCount}:${fetch.runId}")
        result.candidateRepoListVersion = "${result.activeRepoListVersion}-candidate"
        for (record in fetch.records) {
            if (record.request.repo != "") {
                result.matchedPaths.add(record.request.repo)
            } else if (record.request.url != "") {
                result.matchedPaths.add(record.request.url)
            }
        }
        result.updatedDataKinds.add("repo_catalog")
        store.saveRepositoryListRefresh(result)
        ingest.validationDiagnostics.add("repo_list_checkpoint_saved:${result.repoCount}")
    } else if (profile.profile == "docs_probe") {
        let report = CangjieCorpusFreshnessReport()
        report.targetVersion = if (manifest.defaultTargetVersion.trimAscii() == "") { ckbScheduledTargetVersion(config) } else { manifest.defaultTargetVersion }
        report.ok = true
        report.degraded = false
        for (record in fetch.records) {
            let source = CangjieCorpusFreshnessSource()
            source.sourceSet = CangjieSourceSets.DOCS
            source.sourceFamily = "docs"
            source.sourceRepo = if (record.fetch.repo != "") { record.fetch.repo } else { record.request.repo }
            source.sourceRef = if (record.fetch.ref != "") { record.fetch.ref } else { if (record.request.ref != "") { record.request.ref } else { ckbScheduledTargetVersion(config) } }
            source.refKind = "probe"
            source.resolvedCommit = if (record.fetch.commit != "") { record.fetch.commit } else { stableSummaryHash("${record.request.url}:${record.fetch.bodyHash}") }
            source.contentHash = if (record.fetch.bodyHash != "") { record.fetch.bodyHash } else { stableSummaryHash(record.fetch.body) }
            source.targetVersion = report.targetVersion
            source.crawlAt = if (record.fetch.lastModified != "") { record.fetch.lastModified } else { "scheduled:${profile.profile}" }
            source.indexedAt = source.resolvedCommit
            source.staleness = "fresh"
            source.status = "fresh"
            report.sources.add(source)
        }
        if (report.sources.size == 0) {
            report.ok = false
            report.degraded = true
            report.diagnostics.add("docs_probe_no_sources")
        }
        store.saveCangjieCorpusFreshness(report)
        ingest.validationDiagnostics.add("docs_probe_freshness_saved:${report.sources.size}")
    }
}

private func ckbScheduledTypedDeltaRecords(profile: CkbScheduleTaskProfile, records: ArrayList<CkbScheduledSourceRecord>, config: CkbRuntimeConfig, manifest: CangjieVersionManifest): ArrayList<NormalizedRecord> {
    if (profile.profile == "cangjie_docs_full_sync") {
        return ckbScheduledDocsDeltaRecords(profile, records, config, manifest)
    }
    if (profile.profile == "cangjie_release_full_sync" || profile.profile == "cangjie_version_branch_refresh") {
        return ckbScheduledReleaseDeltaRecords(profile, records, config, manifest)
    }
    if (profile.profile == "cangjie_source_event_sync") {
        return ckbScheduledSourceEventDeltaRecords(profile, records, config, manifest)
    }
    ckbScheduledGenericDeltaRecords(profile, records, config, manifest, includeCangjieSymbols: true)
}

private func ckbScheduledDocsDeltaRecords(profile: CkbScheduleTaskProfile, records: ArrayList<CkbScheduledSourceRecord>, config: CkbRuntimeConfig, manifest: CangjieVersionManifest): ArrayList<NormalizedRecord> {
    ckbScheduledGenericDeltaRecords(profile, records, config, manifest, includeCangjieSymbols: false)
}

private func ckbScheduledReleaseDeltaRecords(profile: CkbScheduleTaskProfile, records: ArrayList<CkbScheduledSourceRecord>, config: CkbRuntimeConfig, manifest: CangjieVersionManifest): ArrayList<NormalizedRecord> {
    ckbScheduledGenericDeltaRecords(profile, records, config, manifest, includeCangjieSymbols: true)
}

private func ckbBuildReleaseDelta(profile: CkbScheduleTaskProfile, fetch: CkbScheduledProfileFetchResult,
    config: CkbRuntimeConfig, finalManifest: CangjieVersionManifest): CkbReleaseDeltaBuildResult {
    let result = CkbReleaseDeltaBuildResult()
    result.refreshedManifest = finalManifest
    if (result.refreshedManifest.sources.size == 0) {
        result.ok = false
        result.status = "version_manifest_empty_after_refresh"
        result.diagnostics.add(result.status)
        return result
    }
    let allocator = CkbReleaseLogicalIdAllocator()
    let rawIds = HashSet<String>()
    let normalizedIds = HashSet<String>()
    for (scheduled in fetch.contentRecords) {
        let source = scheduled.releaseSource
        let path = scheduled.request.path
        if (source.canonicalIdentity == "" || path == "") {
            result.ok = false
            result.status = CkbReleaseAcquisitionStatus.DUPLICATE_LOGICAL_RECORD_ID
            result.diagnostics.add("release_content_identity_missing")
            return result
        }
        let manifestResolution = ckbScheduledVersionResolution(scheduled, config,
            result.refreshedManifest)
        if (!manifestResolution.ok || manifestResolution.sources.size != 1 ||
            manifestResolution.sources[0].resolvedCommit == "") {
            result.ok = false
            result.status = "release_version_resolution_failed"
            result.diagnostics.add("release_version_resolution_failed:${source.sourceSet}:${source.canonicalIdentity}")
            return result
        }
        let selectedCommit = manifestResolution.sources[0].resolvedCommit
        if (source.sourceSet != CangjieSourceSets.EVAL_SUPPORT &&
            scheduled.fetch.commit != selectedCommit) {
            result.ok = false
            result.status = "release_resolved_commit_mismatch"
            result.diagnostics.add("release_resolved_commit_mismatch:${source.sourceSet}:${source.canonicalIdentity}")
            return result
        }
        let resolution = manifestResolution
        let raw = ckbReleaseRawRecord(profile, scheduled, fetch.releasePlan.targetVersion, resolution)
        if (rawIds.contains(raw.sourceId)) {
            result.ok = false
            result.status = CkbReleaseAcquisitionStatus.DUPLICATE_LOGICAL_RECORD_ID
            result.diagnostics.add("duplicate_raw_logical_record_id:${raw.sourceId}")
            return result
        }
        rawIds.add(raw.sourceId)
        result.rawRecords.add(raw)
        let typed = ArrayList<CangjieTypedRecord>()
        for (prepared in scheduled.preparedTypedRecords) {
            typed.add(prepared)
        }
        if (typed.size == 0) {
            let docs = cangjieTypedNormalizeRawRecord(raw)
            for (record in docs.records) {
                typed.add(record)
            }
            if (ckbScheduledCangjieSourcePath(scheduled)) {
                let symbols = extractCangjieSourceSymbolRecords(raw.metadata.path, raw.content,
                    raw.metadata.sourceSet, resolution)
                for (record in symbols.records) {
                    typed.add(record)
                }
            }
        }
        if (typed.size == 0 && raw.content != "") {
            typed.add(ckbReleaseFallbackTypedRecord(raw, source))
        }
        for (record in typed) {
            ckbReleaseCompleteTypedRecord(record, source, path, resolution)
            let subkey = ckbReleaseTypedBaseSubkey(record)
            record.sourceId = allocator.typedId(source, path, record)
            record.contentHash = ckbReleaseEvidenceHash(record.content)
            if (normalizedIds.contains(record.sourceId)) {
                result.ok = false
                result.status = CkbReleaseAcquisitionStatus.DUPLICATE_LOGICAL_RECORD_ID
                result.diagnostics.add("duplicate_typed_logical_record_id:${record.sourceId}")
                return result
            }
            normalizedIds.add(record.sourceId)
            let normalized = cangjieTypedRecordToNormalized(record, raw.metadata)
            normalized.metadata.crawlAt = "scheduled:${profile.profile}"
            normalized.metadata.indexedAt = "scheduled:${profile.profile}"
            normalized.metadata.derivedFrom = ["p5-logical:${ckbReleaseCanonicalTypedKey(source, path, record.recordKind, subkey)}"]
            result.normalizedRecords.add(normalized)
        }
    }
    result.diagnostics.add("release_delta_built:raw=${result.rawRecords.size}|normalized=${result.normalizedRecords.size}|planHash=${fetch.releasePlan.planHash}")
    result
}

private func ckbReleaseRawRecord(profile: CkbScheduleTaskProfile, scheduled: CkbScheduledSourceRecord,
    targetVersion: String, resolution: CangjieVersionResolution): RawRecord {
    let source = scheduled.releaseSource
    let path = scheduled.request.path
    let raw = RawRecord()
    raw.sourceId = ckbReleaseCanonicalRawId(source, path)
    raw.title = scheduled.title
    raw.content = scheduled.fetch.body
    raw.contentHash = if (scheduled.fetch.bodyHash != "") { scheduled.fetch.bodyHash } else { ckbReleaseEvidenceHash(scheduled.fetch.body) }
    raw.requiresReview = false
    let metadata = KnowledgeMetadata()
    metadata.sourceId = raw.sourceId
    metadata.sourceType = scheduled.sourceType
    metadata.sourceUrl = scheduled.fetch.sourceUrl
    metadata.repo = source.normalizedRepo
    metadata.path = path
    metadata.commit = if (resolution.sources.size == 1) {
        resolution.sources[0].resolvedCommit
    } else { "" }
    metadata.docVersion = source.originalRef
    metadata.targetVersion = targetVersion
    metadata.sourceSet = source.sourceSet
    metadata.versionResolutionId = resolution.versionResolutionId
    metadata.crawlAt = "scheduled:${profile.profile}"
    metadata.indexedAt = "scheduled:${profile.profile}"
    metadata.contentSize = scheduled.fetch.body.size
    metadata.trustLevel = TrustLevels.OFFICIAL
    metadata.reviewState = ReviewStates.TRUSTED
    metadata.license = "declared-or-unknown"
    metadata.repoVisibility = scheduled.fetch.repoVisibility
    metadata.derivedFrom = ["p5-logical:${ckbReleaseCanonicalRawKey(source, path)}"]
    raw.metadata = metadata
    raw
}

private func ckbReleaseFallbackTypedRecord(raw: RawRecord, source: CkbReleaseSourcePlan): CangjieTypedRecord {
    let record = CangjieTypedRecord()
    record.recordKind = CangjieTypedRecordKinds.DOC_SECTION
    record.title = raw.title
    record.content = raw.content
    record.citation = "${source.normalizedRepo}:${raw.metadata.path}@${raw.metadata.commit}"
    record.sourceSet = source.sourceSet
    record.sourceFamily = source.sourceFamily
    record.path = raw.metadata.path
    record.heading = "whole"
    record.sectionId = "whole"
    record.targetVersion = source.targetVersion
    record.sourceRef = source.originalRef
    record.refKind = source.refKind
    record.resolvedCommit = raw.metadata.commit
    record.trustLevel = TrustLevels.OFFICIAL
    record.reviewState = ReviewStates.TRUSTED
    record
}

private func ckbReleaseCompleteTypedRecord(record: CangjieTypedRecord, source: CkbReleaseSourcePlan,
    path: String, resolution: CangjieVersionResolution): Unit {
    record.sourceSet = source.sourceSet
    if (record.sourceFamily == "") { record.sourceFamily = source.sourceFamily }
    if (record.path == "") { record.path = path }
    record.targetVersion = source.targetVersion
    record.sourceRef = source.originalRef
    if (record.refKind == "") { record.refKind = source.refKind }
    record.resolvedCommit = if (resolution.sources.size > 0) {
        resolution.sources[0].resolvedCommit
    } else { "" }
    record.versionResolutionId = resolution.versionResolutionId
    record.trustLevel = TrustLevels.OFFICIAL
    record.reviewState = ReviewStates.TRUSTED
}

private func ckbReleaseRemovedRawIds(records: ArrayList<RawRecord>, current: ArrayList<RawRecord>, plan: CkbReleaseFullSyncPlan, owner: String, targetVersion: String): ArrayList<String> {
    let out = ArrayList<String>()
    let currentIds = HashSet<String>()
    for (record in current) { currentIds.add(record.sourceId) }
    for (record in records) {
        if (!currentIds.contains(record.sourceId) && (ckbReleaseOwnedMetadata(record.metadata, owner, targetVersion) || ckbReleaseLegacyRawOwned(record, plan, targetVersion))) {
            addUniqueString(out, record.sourceId)
        }
    }
    out
}

private func ckbReleaseRemovedNormalizedIds(records: ArrayList<NormalizedRecord>, current: ArrayList<NormalizedRecord>, plan: CkbReleaseFullSyncPlan, owner: String, targetVersion: String): ArrayList<String> {
    let out = ArrayList<String>()
    let currentIds = HashSet<String>()
    for (record in current) { currentIds.add(record.sourceId) }
    for (record in records) {
        if (!currentIds.contains(record.sourceId) && (ckbReleaseOwnedMetadata(record.metadata, owner, targetVersion) || ckbReleaseLegacyNormalizedOwned(record, plan, targetVersion))) {
            addUniqueString(out, record.sourceId)
        }
    }
    out
}

private func ckbReleaseOwnedMetadata(metadata: KnowledgeMetadata, owner: String, targetVersion: String): Bool {
    metadata.crawlAt == owner && metadata.targetVersion == targetVersion
}

private func ckbReleaseLegacyRawOwned(record: RawRecord, plan: CkbReleaseFullSyncPlan, targetVersion: String): Bool {
    record.sourceId.startsWith("scheduled-cangjie_release_full_sync-") &&
        record.metadata.targetVersion == targetVersion &&
        ckbReleaseRequiredMetadataSourceSet(record.metadata.sourceSet, plan)
}

private func ckbReleaseLegacyNormalizedOwned(record: NormalizedRecord, plan: CkbReleaseFullSyncPlan, targetVersion: String): Bool {
    record.sourceId.startsWith("scheduled-cangjie_release_full_sync-") &&
        record.metadata.targetVersion == targetVersion &&
        ckbReleaseRequiredMetadataSourceSet(record.metadata.sourceSet, plan)
}

private func ckbReleaseRequiredMetadataSourceSet(sourceSet: String, plan: CkbReleaseFullSyncPlan): Bool {
    for (source in plan.sources) {
        if (source.sourceSet == sourceSet) { return true }
    }
    false
}

private func ckbScheduledSourceEventDeltaRecords(profile: CkbScheduleTaskProfile, records: ArrayList<CkbScheduledSourceRecord>, config: CkbRuntimeConfig, manifest: CangjieVersionManifest): ArrayList<NormalizedRecord> {
    // Branch/tree/ref records prove acquisition only. They must never become
    // user-visible raw/vector content for a repository event.
    let content = ArrayList<CkbScheduledSourceRecord>()
    for (record in records) {
        if (ckbRepositoryEventContentRecord(record)) {
            content.add(record)
        }
    }
    let generated = ckbScheduledGenericDeltaRecords(profile, content, config, manifest,
        includeCangjieSymbols: true)
    let out = ArrayList<NormalizedRecord>()
    let seen = HashSet<String>()
    for (record in generated) {
        let identity = "${record.sourceId}|${record.recordKind}|${ckbReleaseEvidenceHash(record.chunk)}"
        if (!seen.contains(identity)) {
            seen.add(identity)
            out.add(record)
        }
    }
    out
}

private func ckbRepositoryEventContentRecord(record: CkbScheduledSourceRecord): Bool {
    let path = if (record.fetch.path != "") { record.fetch.path } else { record.request.path }
    record.request.kind == SourceKinds.GITCODE_SOURCE && ckbSafeRepoRelativePath(path)
}

private func ckbScheduledGenericDeltaRecords(profile: CkbScheduleTaskProfile, records: ArrayList<CkbScheduledSourceRecord>, config: CkbRuntimeConfig, manifest: CangjieVersionManifest, includeCangjieSymbols!: Bool): ArrayList<NormalizedRecord> {
    let out = ArrayList<NormalizedRecord>()
    for (record in records) {
        if (!record.fetch.ok) {
            continue
        }
        let raw = ckbScheduledRawRecord(profile, record, config, manifest)
        let before = out.size
        ckbAppendTypedDeltaRecords(out, cangjieTypedNormalizeRawRecord(raw), raw.metadata)
        if (includeCangjieSymbols && ckbScheduledCangjieSourcePath(record)) {
            ckbAppendTypedDeltaRecords(out, extractCangjieSourceSymbolRecords(raw.metadata.path, raw.content, raw.metadata.sourceSet, ckbScheduledVersionResolution(record, config, manifest)), raw.metadata)
        }
        if (out.size == before && raw.content.trimAscii() != "") {
            out.add(ckbScheduledFallbackNormalizedRecord(raw, profile))
        }
    }
    out
}

private func ckbScheduledFallbackNormalizedRecord(raw: RawRecord, profile: CkbScheduleTaskProfile): NormalizedRecord {
    let record = NormalizedRecord()
    record.sourceId = raw.sourceId
    record.recordKind = CangjieTypedRecordKinds.DOC_SECTION
    record.title = if (raw.title.trimAscii() == "") { "Scheduled ${profile.profile}" } else { raw.title }
    record.chunk = raw.content
    record.citation = if (raw.metadata.sourceUrl != "") { raw.metadata.sourceUrl } else { "scheduled:${profile.profile}:${raw.sourceId}" }
    record.metadata = raw.metadata
    record.requiresReview = raw.requiresReview
    record
}

private func ckbAppendTypedDeltaRecords(out: ArrayList<NormalizedRecord>, typed: CangjieTypedRecordResult, base: KnowledgeMetadata): Unit {
    for (record in typed.records) {
        out.add(cangjieTypedRecordToNormalized(record, base))
    }
}

private func ckbScheduledRawRecord(profile: CkbScheduleTaskProfile, record: CkbScheduledSourceRecord, config: CkbRuntimeConfig, manifest: CangjieVersionManifest): RawRecord {
    let raw = RawRecord()
    raw.sourceId = record.sourceId
    raw.title = record.title
    raw.content = record.fetch.body
    raw.contentHash = if (record.fetch.bodyHash != "") { record.fetch.bodyHash } else { stableSummaryHash("${record.sourceId}\n${record.fetch.body}") }
    raw.requiresReview = false
    let metadata = cangjieMetadataFromVersionResolution(ckbScheduledVersionResolution(record, config, manifest), record.sourceSet)
    metadata.sourceId = record.sourceId
    metadata.sourceType = record.sourceType
    metadata.sourceUrl = if (record.fetch.sourceUrl != "") { record.fetch.sourceUrl } else { record.request.url }
    metadata.repo = if (record.fetch.repo != "") { record.fetch.repo } else { record.request.repo }
    metadata.path = if (record.fetch.path != "") { record.fetch.path } else { record.request.path }
    metadata.commit = if (record.fetch.commit != "") { record.fetch.commit } else { metadata.commit }
    metadata.docVersion = if (record.fetch.ref != "") { record.fetch.ref } else { if (record.request.ref != "") { record.request.ref } else { metadata.docVersion } }
    metadata.targetVersion = ckbScheduledTargetVersion(config)
    metadata.sourceSet = record.sourceSet
    metadata.crawlAt = "scheduled:${profile.profile}"
    metadata.indexedAt = "scheduled:${profile.profile}"
    metadata.contentSize = record.fetch.body.size
    metadata.trustLevel = TrustLevels.OFFICIAL
    metadata.reviewState = ReviewStates.TRUSTED
    metadata.license = "declared-or-unknown"
    metadata.repoVisibility = record.fetch.repoVisibility
    raw.metadata = metadata
    raw
}

private func ckbScheduledVersionResolution(record: CkbScheduledSourceRecord, config: CkbRuntimeConfig, manifest: CangjieVersionManifest): CangjieVersionResolution {
    let resolution = resolveCangjieVersion(cangjieVersionSelector(
        targetVersion: ckbScheduledTargetVersion(config),
        sourceSet: if (record.sourceSet == "") { CangjieSourceSets.ALL } else { record.sourceSet },
        sourceFamily: record.sourceFamily,
        sourceRepo: if (record.request.repo != "") { record.request.repo } else { record.fetch.repo },
        sourceRef: if (record.request.ref != "") { record.request.ref } else { record.fetch.ref }),
        manifest)
    if (!resolution.ok && record.sourceSet == CangjieSourceSets.EVAL_SUPPORT) {
        return resolveCangjieVersion(cangjieVersionSelector(
            targetVersion: ckbScheduledTargetVersion(config),
            sourceSet: CangjieSourceSets.EVAL_SUPPORT,
            sourceFamily: record.sourceFamily,
            sourceRef: if (record.request.ref != "") { record.request.ref } else { record.fetch.ref }),
            manifest)
    }
    resolution
}

private func ckbRuntimeCangjieVersionManifest(config: CkbRuntimeConfig): CangjieVersionManifest {
    buildCangjieVersionManifestFromRoots(
        targetVersion: ckbScheduledTargetVersion(config),
        docsRoot: config.firstInitDocsRoot,
        toolDocsRoot: config.firstInitToolDocsRoot,
        stdRoot: config.firstInitStdRoot,
        stdxRoot: config.firstInitStdxRoot,
        evalRoot: config.firstInitEvalRoot)
}

private func ckbScheduledTargetVersion(config: CkbRuntimeConfig): String {
    if (config.benchmarkGapTargetVersion.trimAscii() != "") {
        return config.benchmarkGapTargetVersion.trimAscii()
    }
    if (config.firstInitTargetVersion.trimAscii() != "") {
        return config.firstInitTargetVersion.trimAscii()
    }
    cangjieDefaultTargetVersion()
}

private func ckbScheduledCangjieSourcePath(record: CkbScheduledSourceRecord): Bool {
    let path = if (record.fetch.path != "") { record.fetch.path } else { record.request.path }
    path.endsWith(".cj") && (record.sourceSet == CangjieSourceSets.STD || record.sourceSet == CangjieSourceSets.STDX)
}

private func ckbScheduledSourceType(request: SourceFetchRequest): String {
    if (request.kind == SourceKinds.CANGJIE_DOCS) {
        return SourceTypes.DOC
    }
    if (request.kind == SourceKinds.CANGJIE_WEBSITE) {
        return SourceTypes.WEBSITE
    }
    if (request.kind == SourceKinds.WEB_CANDIDATE) {
        return SourceTypes.WEB_CANDIDATE
    }
    if (request.kind == SourceKinds.GITCODE_ORG || request.kind == SourceKinds.GITCODE_REPO || request.kind == SourceKinds.GITCODE_BRANCH || request.kind == SourceKinds.GITCODE_TREE || request.kind == SourceKinds.GITCODE_SOURCE) {
        return SourceTypes.REPO
    }
    SourceTypes.COMMUNITY
}

private func ckbScheduledSourceFamily(request: SourceFetchRequest, profile: CkbScheduleTaskProfile): String {
    if (request.repo == "ckb-local://eval-support" || request.url == "ckb-local://eval-support") { return "eval-support" }
    if (request.repo.contains("cangjie_docs") || request.kind == SourceKinds.CANGJIE_DOCS) { return "docs" }
    if (request.repo.contains("cangjie_runtime")) { return "stdlib" }
    if (request.repo.contains("cangjie_stdx")) { return "stdx" }
    if (request.repo.contains("cangjie_tools")) { return "tools" }
    if (request.repo.contains("Cangjie-HumanEval") || request.repo.contains("cangjie_humaneval")) { return "eval-support" }
    if (request.kind == SourceKinds.CANGJIE_WEBSITE) { return "website" }
    if (request.kind == SourceKinds.WEB_CANDIDATE) { return "web-candidate" }
    if (profile.profile.contains("benchmark")) { return "eval-support" }
    profile.profile
}

private func ckbScheduledSourceSet(request: SourceFetchRequest, profile: CkbScheduleTaskProfile): String {
    if (request.repo == "ckb-local://eval-support" || request.url == "ckb-local://eval-support") { return CangjieSourceSets.EVAL_SUPPORT }
    if (request.repo.contains("cangjie_docs") || request.kind == SourceKinds.CANGJIE_DOCS) { return CangjieSourceSets.DOCS }
    if (request.repo.contains("cangjie_runtime")) { return CangjieSourceSets.STD }
    if (request.repo.contains("cangjie_stdx")) { return CangjieSourceSets.STDX }
    if (request.repo.contains("cangjie_tools")) { return CangjieSourceSets.TOOLS }
    if (request.repo.contains("Cangjie-HumanEval") || request.repo.contains("cangjie_humaneval")) { return CangjieSourceSets.EVAL_SUPPORT }
    if (request.kind == SourceKinds.CANGJIE_WEBSITE) { return CangjieSourceSets.DOCS }
    if (request.kind == SourceKinds.WEB_CANDIDATE) { return CangjieSourceSets.DOCS }
    if (profile.profile.contains("benchmark")) { return CangjieSourceSets.EVAL_SUPPORT }
    ""
}

private func ckbScheduledSourceTitle(request: SourceFetchRequest, profile: CkbScheduleTaskProfile): String {
    if (request.repo == "ckb-local://eval-support") {
        return "Scheduled ${profile.profile}: eval-support local HumanEval"
    }
    if (request.repo != "") {
        return "Scheduled ${profile.profile}: ${request.repo}"
    }
    "Scheduled ${profile.profile}: ${request.url}"
}

private func ckbScheduledCandidateVersion(profile: CkbScheduleTaskProfile, fetch: CkbScheduledProfileFetchResult): String {
    if (profile.profile == "cangjie_release_full_sync" && fetch.releasePlan.ok) {
        let evidence = ArrayList<String>()
        for (record in fetch.contentRecords) {
            evidence.add("${record.sourceId}:${record.fetch.bodyHash}:${record.fetch.commit}")
        }
        let ordered = evidence.toArray()
        sort(ordered)
        let digest = SHA256()
        digest.write(profile.profile.toArray())
        digest.write("|".toArray())
        digest.write(fetch.releasePlan.planHash.toArray())
        digest.write("|".toArray())
        for (index in 0..ordered.size) {
            if (index > 0) { digest.write("|".toArray()) }
            digest.write(ordered[index].toArray())
        }
        return "ckb-scheduled-${ckbReleaseDigestHex(digest)}-candidate"
    }
    if (profile.profile == "cangjie_source_event_sync") {
        let evidence = ArrayList<String>()
        evidence.add("event=${fetch.eventIdentity}")
        for (removed in fetch.removedSourceIds) { evidence.add("removed=${removed}") }
        for (record in fetch.records) {
            let path = if (record.fetch.path != "") { record.fetch.path } else { record.request.path }
            if (record.request.kind == SourceKinds.GITCODE_SOURCE &&
                ckbSafeRepoRelativePath(path) && record.fetch.ok) {
                evidence.add("${record.request.repo.toAsciiLower()}|${record.fetch.ref}|${record.fetch.commit}|${path}|${ckbReleaseEvidenceHash(record.fetch.body)}")
            }
        }
        let ordered = evidence.toArray()
        sort(ordered)
        let digest = SHA256()
        digest.write(profile.profile.toArray())
        for (item in ordered) {
            digest.write("|".toArray())
            digest.write(item.toArray())
        }
        return "ckb-scheduled-${ckbReleaseDigestHex(digest)}-candidate"
    }
    let seed = StringBuilder()
    seed.append(profile.profile)
    seed.append("|")
    seed.append("${fetch.requestCount}")
    seed.append("|")
    seed.append(fetch.runId)
    seed.append("|")
    for (record in fetch.records) {
        seed.append(record.sourceId)
        seed.append(":")
        seed.append(record.fetch.bodyHash)
        seed.append("|")
    }
    "ckb-scheduled-${stableSummaryHash(seed.toString())}-candidate"
}

private func ckbServiceCangjieSourceSetAllowed(sourceSet: String): Bool {
    sourceSet == CangjieSourceSets.ALL ||
        sourceSet == CangjieSourceSets.DOCS ||
        sourceSet == CangjieSourceSets.STD ||
        sourceSet == CangjieSourceSets.STDX ||
        sourceSet == CangjieSourceSets.TOOLS ||
        sourceSet == CangjieSourceSets.EVAL_SUPPORT
}

private func ckbServiceCangjieSourceFamilyAllowed(sourceFamily: String): Bool {
    sourceFamily == "docs" ||
        sourceFamily == "stdlib" ||
        sourceFamily == "stdx" ||
        sourceFamily == "tools" ||
        sourceFamily == "eval-support" ||
        sourceFamily == "website" ||
        sourceFamily == "web-candidate" ||
        sourceFamily == "community"
}

private func ckbServiceLiveSyncDataKind(sourceSet: String, sourceFamily: String, sourceRef: String): String {
    if (sourceSet == "" && sourceFamily == "" && sourceRef == "") {
        return "live_sync"
    }
    let out = StringBuilder()
    out.append("live_sync")
    if (sourceSet != "") {
        out.append("_")
        out.append(sourceSet)
    }
    if (sourceFamily != "") {
        out.append("_")
        out.append(sourceFamily)
    }
    if (sourceRef != "") {
        out.append("_ref")
    }
    out.toString()
}

private func ckbRepositoryEventSyncBody(event: GitCodeRepositoryChangedEvent, profiles: ArrayList<String>): String {
    let profile = if (profiles.contains("repo_source_and_items")) { "repo_source_and_items" } else { "items" }
    "{\"repo\":\"${ckbServiceJsonQuote(event.repo)}\",\"ref\":\"${ckbServiceJsonQuote(if (event.ref == "") { "main" } else { event.ref })}\",\"profile\":\"${profile}\",\"prNumber\":${event.prNumber},\"changedFiles\":${ckbServiceStringArrayJson(event.changedFiles)}}"
}

private func ckbRepositoryEventRepoListBody(event: GitCodeRepositoryChangedEvent): String {
    let paths = ArrayList<String>()
    for (path in event.changedFiles) {
        if (ckbRepoListTriggerPath(path.toAsciiLower())) {
            paths.add(path)
        }
    }
    "{\"repo\":\"${ckbServiceJsonQuote(event.repo)}\",\"ref\":\"${ckbServiceJsonQuote(if (event.ref == "") { "main" } else { event.ref })}\",\"prNumber\":${event.prNumber},\"paths\":${ckbServiceStringArrayJson(paths)}}"
}

private func ckbRunRepositoryChangedSourceSync(kb: KnowledgeBase, store: FileKnowledgeStore, runner: SourceFetchRunner, config: CkbRuntimeConfig, repo: String, ref: String, changedFiles: ArrayList<String>): CkbScheduledProfileFetchResult {
    let profile = ckbSyncProfileForScheduleTask("cangjie_source_event_sync")
    let result = CkbScheduledProfileFetchResult()
    let builder = SourceRequestBuilder(gitCodeApiRoot: config.gitCodeBaseUrl)
    let resolution = ckbResolveGitCodeRefForFetch(runner, builder, repo, ref,
        "repository_event", "repository_event", config, accounting: result.accounting)
    for (diagnostic in resolution.diagnostics) { result.diagnostics.add(diagnostic) }
    if (!resolution.ok) {
        result.ok = false
        result.status = if (resolution.status == "") { "gitcode_ref_resolution_failed" } else { resolution.status }
        for (failed in resolution.failedRequests) { result.failedRequests.add(failed) }
        return result
    }
    if (changedFiles.size == 0) {
        ckbFetchScheduledSource(runner, builder.gitCodeRepo(repo, ref: resolution.effectiveRef), profile, result, config)
    } else {
        for (path in changedFiles) {
            ckbFetchScheduledSource(runner,
                builder.gitCodeSourceRawWithFetchRef(repo, ref, resolution.effectiveRef, path),
                profile, result, config)
        }
    }
    let manifest = ckbRuntimeVersionManifestForStore(store, config)
    let ingest = ingestScheduledProfileSources(kb, store, profile, result, config, manifest)
    result.ok = result.ok && ingest.ok
    result.status = if (result.ok) { ingest.status } else { if (ingest.status != "") { ingest.status } else { result.status } }
    result
}

// Durable inbox events use their receipt identity and never fall back to the
// legacy repository-wide request. A missing/truncated change list is expanded
// from a bounded tree before any content is ingested.
private func ckbRunRepositoryEventSourceSync(kb: KnowledgeBase, store: FileKnowledgeStore,
    runner: SourceFetchRunner, config: CkbRuntimeConfig,
    receipt: CkbRepositoryEventReceipt,
    promotionBudgetPlan!: CangjieCandidatePromotionBudgetPlan = CangjieCandidatePromotionBudgetPlan(),
    workerSoftDeadlineAtMillis!: Int64 = 0): CkbScheduledProfileFetchResult {
    let profile = ckbSyncProfileForScheduleTask("cangjie_source_event_sync")
    let result = CkbScheduledProfileFetchResult()
    let builder = SourceRequestBuilder(gitCodeApiRoot: config.gitCodeBaseUrl)
    let bootstrapStartedAtMillis = ckbTaskWorkerNowMillis()
    let bootstrapDeadlineAtMillis = ckbStageDeadline(workerSoftDeadlineAtMillis,
        profile.bootstrapBudgetMillis)
    ckbWriteScheduledProfileStageCheckpoint(store, profile, "bootstrap_started",
        "running", profile.bootstrapBudgetMillis, bootstrapDeadlineAtMillis,
        "event=${ckbReleaseEvidenceHash(receipt.eventId)}")
    if (ckbDeadlineExceeded(bootstrapDeadlineAtMillis)) {
        result.ok = false
        result.status = "bootstrap_deadline_exceeded"
        result.diagnostics.add("bootstrap_deadline_exceeded")
        ckbWriteScheduledProfileStageCheckpoint(store, profile, "bootstrap_finished",
            result.status, profile.bootstrapBudgetMillis, bootstrapDeadlineAtMillis,
            "durationMillis=0")
        return result
    }
    let bootstrapDurationMillis = ckbTaskWorkerNowMillis() - bootstrapStartedAtMillis
    ckbWriteScheduledProfileStageCheckpoint(store, profile, "bootstrap_finished",
        "ok", profile.bootstrapBudgetMillis, bootstrapDeadlineAtMillis,
        "durationMillis=${if (bootstrapDurationMillis >= 0) { bootstrapDurationMillis } else { 0 }}")
    let fetchDeadlineAtMillis = ckbStageDeadline(workerSoftDeadlineAtMillis,
        profile.fetchBudgetMillis)
    let resolution = if (receipt.resolvedCommit != "") {
        ckbRepositoryEventPinnedResolution(receipt)
    } else if (ckbGitCodeLooksLikeCommit(receipt.mergeCommitSha)) {
        ckbRepositoryEventMergeCommitResolution(receipt)
    } else {
        ckbResolveGitCodeRefForFetch(runner, builder, receipt.repo, receipt.ref,
            "repository_event", "repository_event", config,
            deadlineAtMillis: fetchDeadlineAtMillis, accounting: result.accounting)
    }
    for (diagnostic in resolution.diagnostics) { result.diagnostics.add(diagnostic) }
    if (!resolution.ok) {
        result.ok = false
        result.status = if (resolution.status == "") { "gitcode_ref_resolution_failed" } else { resolution.status }
        for (failed in resolution.failedRequests) { result.failedRequests.add(failed) }
        return result
    }
    if (receipt.resolvedCommit == "") {
        let pinned = store.pinRepositoryEventResolvedCommit(receipt, resolution.resolvedCommit,
            ckbCoreNowMillis())
        if (!pinned.valid || pinned.resolvedCommit != resolution.resolvedCommit) {
            result.ok = false
            result.status = "repository_event_resolved_commit_pin_failed"
            return result
        }
    }
    result.eventIdentity = receipt.canonicalSha256
    let manifestSource = CangjieVersionSource()
    manifestSource.sourceRepo = receipt.repo
    manifestSource.sourceRef = receipt.ref
    manifestSource.sourceSet = ckbRepositoryEventSourceSet(receipt.repo)
    manifestSource.sourceFamily = if (manifestSource.sourceSet == CangjieSourceSets.STD) { "stdlib" } else if (manifestSource.sourceSet == CangjieSourceSets.STDX) { "stdx" } else { "tools" }
    ckbAppendScheduledManifestRefRecord(profile, result, manifestSource, resolution)
    let paths = if (receipt.changedFilesUnavailable || receipt.changedFilesTruncated ||
        receipt.changedFiles.size == 0) {
        ckbRepositoryEventFallbackPaths(runner, builder, profile, result, config,
            receipt, resolution, deadlineAtMillis: fetchDeadlineAtMillis)
    } else { ckbCanonicalRepositoryEventPaths(receipt.changedFiles) }
    if (!result.ok) { return result }
    if (paths.size == 0) {
        result.ok = false
        result.status = "repository_event_tree_no_content"
        result.diagnostics.add("repository_event_acquisition_no_content:event=${ckbReleaseEvidenceHash(receipt.eventId)}")
        return result
    }
    for (path in paths) {
        if (!ckbRepositoryEventFetchContent(store, runner, builder, profile, result, config,
            receipt, resolution, path, deadlineAtMillis: fetchDeadlineAtMillis)) {
            result.status = if (result.status == "profile_ok") { "repository_event_content_fetch_failed" } else { result.status }
            return result
        }
    }
    let manifest = ckbRuntimeVersionManifestForStore(store, config)
    let ingestDeadlineAtMillis = ckbStageDeadline(workerSoftDeadlineAtMillis,
        profile.ingestBudgetMillis)
    let ingest = ingestScheduledProfileSources(kb, store, profile, result, config, manifest,
        deadlineAtMillis: ingestDeadlineAtMillis, promotionBudgetPlan: promotionBudgetPlan)
    result.transactionId = ingest.transactionId
    result.candidateVersion = ingest.candidateVersion
    if (result.candidateVersion == "" && ingest.ok) {
        result.candidateVersion = ckbScheduledCandidateVersion(profile, result)
    }
    result.activeVersion = ingest.activeVersion
    result.validationEvidenceHash = ingest.validationEvidenceHash
    for (gate in ingest.validationGates) { result.validationGates.add(gate) }
    if (ingest.ok) {
        // Bind KU-10 to the durable transaction fact. Some compatible
        // promotion adapters omit the in-memory snapshot id.
        var pointer = store.loadActiveSnapshotPointer()
        if (!pointer.valid) {
            _ = kb.persistActiveSnapshot(store)
            pointer = store.loadActiveSnapshotPointer()
        }
        if (pointer.valid) {
            result.transactionId = pointer.txId
            result.activeVersion = pointer.activeVersion
        }
    }
    result.ok = result.ok && ingest.ok
    result.status = if (result.ok) { ingest.status } else {
        if (ingest.status != "") { ingest.status } else { result.status }
    }
    result
}

private func ckbRepositoryEventPinnedResolution(receipt: CkbRepositoryEventReceipt): GitCodeRefResolution {
    let resolution = GitCodeRefResolution()
    resolution.ok = true
    resolution.status = "resolved_commit_pinned"
    resolution.repo = receipt.repo
    resolution.originalRef = receipt.ref
    resolution.effectiveRef = receipt.resolvedCommit
    resolution.resolvedCommit = receipt.resolvedCommit
    resolution.sourceSet = "repository_event"
    resolution.sourceFamily = "repository_event"
    resolution
}

private func ckbRepositoryEventMergeCommitResolution(receipt: CkbRepositoryEventReceipt): GitCodeRefResolution {
    let resolution = ckbRepositoryEventPinnedResolution(receipt)
    resolution.status = "merge_commit_pinned"
    resolution.effectiveRef = receipt.mergeCommitSha
    resolution.resolvedCommit = receipt.mergeCommitSha
    resolution
}

private func ckbRepositoryEventFallbackPaths(runner: SourceFetchRunner,
    builder: SourceRequestBuilder, profile: CkbScheduleTaskProfile,
    result: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig,
    receipt: CkbRepositoryEventReceipt, resolution: GitCodeRefResolution,
    deadlineAtMillis!: Int64 = 0): ArrayList<String> {
    let selected = ArrayList<String>()
    let source = CangjieVersionSource()
    source.sourceRepo = receipt.repo
    source.sourceRef = receipt.ref
    source.sourceSet = ckbRepositoryEventSourceSet(receipt.repo)
    source.sourceFamily = if (source.sourceSet == CangjieSourceSets.STD) { "stdlib" } else if (source.sourceSet == CangjieSourceSets.STDX) { "stdx" } else { "tools" }
    let selector = SourceCandidateSelector()
    var page: Int64 = 1
    var objects: Int64 = 0
    var terminalPage = false
    var treeTruncated = false
    while (page <= 20 && objects < 2000) {
        let request = builder.gitCodeTreePageWithFetchRef(receipt.repo, receipt.ref,
            resolution.effectiveRef, page: page, perPage: 100)
        let fetch = ckbFetchScheduledRequest(runner, request, config,
            deadlineAtMillis: deadlineAtMillis, accounting: result.accounting)
        ckbApplyGitCodeRefResolutionToFetch(fetch, resolution)
        if (fetch.truncated) { treeTruncated = true }
        if (!fetch.ok) {
            _ = ckbAppendScheduledSourceRecord(profile, result, request, fetch)
            result.status = "repository_event_tree_fallback_failed"
            return selected
        }
        let stats = ckbGitCodeTreePageStats(source, profile, fetch.body)
        objects += stats.objectsSeen
        for (path in selector.selectFromTreeForSource(source, profile, fetch.body, maxFiles: -1)) {
            addUniqueString(selected, path)
        }
        if (stats.objectsSeen == 0) {
            terminalPage = true
            break
        }
        page += 1
    }
    let canonical = ckbCanonicalRepositoryEventPaths(selected)
    if (canonical.size > 256 || !terminalPage || objects >= 2000 || treeTruncated) {
        result.ok = false
        result.status = "repository_event_tree_fallback_bound_reached"
        result.diagnostics.add("repository_event_tree_fallback_bound_reached:pages=${page}|objects=${objects}|selected=${canonical.size}")
        return ArrayList<String>()
    }
    result.diagnostics.add("repository_event_tree_fallback_complete:pages=${page}|objects=${objects}|selected=${canonical.size}")
    canonical
}

private func ckbRepositoryEventSourceSet(repo: String): String {
    if (repo.contains("cangjie_runtime")) { return CangjieSourceSets.STD }
    if (repo.contains("cangjie_stdx")) { return CangjieSourceSets.STDX }
    CangjieSourceSets.TOOLS
}

private func ckbRepositoryEventLogicalSourceId(repo: String, ref: String, path: String): String {
    "repository-event-${ckbReleaseEvidenceHash("${repo.toAsciiLower()}|${ref}|${path}")}"
}

private func ckbRepositoryEventFetchContent(store: FileKnowledgeStore, runner: SourceFetchRunner,
    builder: SourceRequestBuilder, profile: CkbScheduleTaskProfile,
    result: CkbScheduledProfileFetchResult, config: CkbRuntimeConfig,
    receipt: CkbRepositoryEventReceipt, resolution: GitCodeRefResolution, path: String,
    deadlineAtMillis!: Int64 = 0): Bool {
    if (!ckbSafeRepoRelativePath(path)) {
        result.ok = false
        result.status = "repository_event_path_invalid"
        return false
    }
    let request = builder.gitCodeSourceRawWithFetchRef(receipt.repo, receipt.ref,
        resolution.effectiveRef, path)
    let cached = store.loadRepositoryEventFetchContent(receipt, resolution.resolvedCommit, request)
    if (cached.ok) {
        _ = ckbAppendScheduledSourceRecord(profile, result, request, cached)
        result.diagnostics.add("repository_event_content_hydrated:pathHash=${ckbReleaseEvidenceHash(path)}")
        return true
    }
    let raw = ckbFetchScheduledRequest(runner, request, config,
        deadlineAtMillis: deadlineAtMillis, accounting: result.accounting)
    ckbApplyGitCodeRefResolutionToFetch(raw, resolution)
    if (raw.ok) {
        _ = ckbAppendScheduledSourceRecord(profile, result, request, raw)
        if (!store.saveRepositoryEventFetchContent(receipt, resolution.resolvedCommit, request, raw)) {
            result.ok = false
            result.status = "repository_event_content_cache_write_failed"
            return false
        }
        return true
    }
    let contents = builder.gitCodeSourceContentsWithFetchRef(receipt.repo, receipt.ref,
        resolution.effectiveRef, path)
    let fallback = ckbFetchScheduledRequest(runner, contents, config,
        deadlineAtMillis: deadlineAtMillis, accounting: result.accounting)
    ckbApplyGitCodeRefResolutionToFetch(fallback, resolution)
    if (!fallback.ok) {
        if (raw.statusCode == 404 && fallback.statusCode == 404) {
            let tombstone = CkbRepositoryEventTombstone()
            tombstone.repo = receipt.repo
            tombstone.ref = receipt.ref
            tombstone.path = path
            tombstone.sourceId = ckbRepositoryEventLogicalSourceId(receipt.repo,
                receipt.ref, path)
            result.tombstones.add(tombstone)
            addUniqueString(result.removedSourceIds, tombstone.sourceId)
            result.diagnostics.add("repository_event_tombstone:pathHash=${ckbReleaseEvidenceHash(path)}")
            return true
        }
        _ = ckbAppendScheduledSourceRecord(profile, result, contents, fallback)
        // Only an explicit double-404 represents a deletion. Transient or
        // malformed raw/contents responses must preserve the active source and
        // flow through the worker's retryable content-failure transition.
        result.status = "repository_event_content_fetch_failed"
        return false
    }
    _ = ckbAppendScheduledSourceRecord(profile, result, contents, fallback)
    if (!store.saveRepositoryEventFetchContent(receipt, resolution.resolvedCommit, contents, fallback)) {
        result.ok = false
        result.status = "repository_event_content_cache_write_failed"
        return false
    }
    true
}

// S2 owns dispatch only.  It deliberately delegates the existing acquisition
// primitive so S3 can replace that primitive without moving HTTP ingress or
// lease ownership again.
private class CkbRepositoryEventSourceSyncWorker <: CkbRepositoryEventWorker {
    private let kb: KnowledgeBase
    private let store: FileKnowledgeStore
    private let runner: SourceFetchRunner
    private let config: CkbRuntimeConfig
    private let promotionBudgetPlan: CangjieCandidatePromotionBudgetPlan

    public init(kb: KnowledgeBase, store: FileKnowledgeStore, runner: SourceFetchRunner,
        config: CkbRuntimeConfig,
        promotionBudgetPlan!: CangjieCandidatePromotionBudgetPlan = CangjieCandidatePromotionBudgetPlan()) {
        this.kb = kb
        this.store = store
        this.runner = runner
        this.config = config
        this.promotionBudgetPlan = promotionBudgetPlan
    }

    public func execute(receipt: CkbRepositoryEventReceipt): CkbRepositoryEventWorkerResult {
        if (ckbRepositoryEventProcessWorkerEnabled(getCommand())) {
            return this.executeInChildProcess(receipt)
        }
        let result = CkbRepositoryEventWorkerResult()
        let profile = ckbSyncProfileForScheduleTask("cangjie_source_event_sync")
        let workerStartedAtMillis = ckbTaskWorkerNowMillis()
        let workerHardDeadlineAtMillis = workerStartedAtMillis + profile.timeBudgetMillis
        let workerSoftDeadlineAtMillis = ckbSchedulerWorkerSoftDeadlineAtMillis(
            workerHardDeadlineAtMillis, profile.resultFlushBudgetMillis,
            nowMillis: workerStartedAtMillis, safetyMillis: profile.unallocatedSafetyMillis)
        let resultRelativePath = "metadata/scheduler-workers/${safeName(receipt.dedupeKey)}.ckb"
        let startedText = ckbTaskWorkerStartedText("cangjie_source_event_sync",
            receipt.eventId, workerSoftDeadlineAtMillis, resultRelativePath,
            workerStartedAtMillis)
        try {
            this.store.writeLinesAtomically(resultRelativePath, startedText)
            this.store.writeLinesAtomically("${resultRelativePath}.started", startedText)
        } catch (_: Exception) {
            // The durable receipt remains authoritative; artifact degradation
            // must not turn a business success into a false terminal result.
        }
        let effectivePlan = ckbSourceEventPromotionBudgetPlanWithOverrides(
            this.promotionBudgetPlan, profile, workerSoftDeadlineAtMillis)
        let fetched = try {
            ckbRunRepositoryEventSourceSync(this.kb, this.store, this.runner,
                this.config, receipt, promotionBudgetPlan: effectivePlan,
                workerSoftDeadlineAtMillis: workerSoftDeadlineAtMillis)
        } catch (_: Exception) {
            let failed = CkbScheduledProfileFetchResult()
            failed.ok = false
            failed.status = "repository_event_worker_exception"
            failed
        }
        let hardTimedOut = ckbTaskWorkerNowMillis() >= workerHardDeadlineAtMillis
        let businessOk = fetched.ok && !hardTimedOut
        let businessStatus = if (hardTimedOut) { "task_timeout:cangjie_source_event_sync" } else {
            if (fetched.status == "") { if (fetched.ok) { "repository_event_committed" } else { "repository_event_worker_failed" } } else { fetched.status }
        }
        let terminal = SchedulerTaskResult()
        terminal.ok = businessOk
        terminal.status = businessStatus
        terminal.businessStatus = businessStatus
        terminal.primaryFailure = if (businessOk) { "" } else { businessStatus }
        terminal.since = receipt.eventId
        terminal.schedulerRunId = receipt.leaseOwner
        terminal.schedulerTaskName = "cangjie_source_event_sync"
        terminal.transactionId = fetched.transactionId
        terminal.candidateVersion = fetched.candidateVersion
        terminal.activeVersion = fetched.activeVersion
        terminal.validationEvidenceHash = fetched.validationEvidenceHash
        for (gate in fetched.validationGates) { terminal.validationGates.add(gate) }
        terminal.startedAtMillis = workerStartedAtMillis
        terminal.taskBodyStartedAtMillis = workerStartedAtMillis
        terminal.taskBodyEndedAtMillis = ckbTaskWorkerNowMillis()
        terminal.endedAtMillis = terminal.taskBodyEndedAtMillis
        terminal.deadlineAtMillis = workerHardDeadlineAtMillis
        terminal.timeBudgetMillis = profile.timeBudgetMillis
        terminal.lastStage = if (businessOk) { "repository_event_finished" } else { businessStatus }
        terminal.lastProgress = "softDeadlineAtMillis=${workerSoftDeadlineAtMillis}|hardDeadlineAtMillis=${workerHardDeadlineAtMillis}"
        _ = ckbWriteSchedulerTerminalResultArtifacts(this.store,
            resultRelativePath, terminal, terminal.taskBodyEndedAtMillis)
        result.schedulerRunId = terminal.schedulerRunId
        result.transactionId = terminal.transactionId
        result.candidateVersion = terminal.candidateVersion
        result.activeVersion = terminal.activeVersion
        result.validationEvidenceHash = terminal.validationEvidenceHash
        for (gate in terminal.validationGates) { result.validationGates.add(gate) }
        if (businessOk) {
            result.state = "committed"
            result.errorCode = ""
        } else if (businessStatus == "candidate_validation_recoverable" ||
            ckbScheduledIngestTimedOut(fetched.status) ||
            businessStatus.contains("timeout") || businessStatus.contains("deadline") ||
            fetched.status.contains("network") || fetched.status.contains("gitcode_ref_resolution")) {
            result.state = "retryable"
            result.errorCode = businessStatus
        } else if (fetched.status == "repository_event_content_fetch_failed" ||
            fetched.status == "repository_event_tree_fallback_failed" ||
            fetched.status == "repository_event_content_cache_write_failed") {
            result.state = "retryable"
            result.errorCode = fetched.status
        } else {
            result.state = "failed"
            result.errorCode = if (fetched.status == "") { "worker_failed" } else { fetched.status }
        }
        result
    }

    private func executeInChildProcess(receipt: CkbRepositoryEventReceipt): CkbRepositoryEventWorkerResult {
        let profile = ckbSyncProfileForScheduleTask("cangjie_source_event_sync")
        let startedAtMillis = ckbTaskWorkerNowMillis()
        let hardDeadlineAtMillis = startedAtMillis + profile.timeBudgetMillis
        let softDeadlineAtMillis = ckbSchedulerWorkerSoftDeadlineAtMillis(
            hardDeadlineAtMillis, profile.resultFlushBudgetMillis,
            nowMillis: startedAtMillis, safetyMillis: profile.unallocatedSafetyMillis)
        let cutoffAtMillis = hardDeadlineAtMillis - profile.unallocatedSafetyMillis
        let resultRelativePath = "metadata/scheduler-workers/${safeName(receipt.dedupeKey)}.ckb"
        let args = ArrayList<String>()
        args.add("--store"); args.add(this.store.rootPath())
        args.add("repository-event-worker")
        args.add("--dedupe-key"); args.add(receipt.dedupeKey)
        args.add("--owner"); args.add(receipt.leaseOwner)
        args.add("--revision"); args.add("${receipt.revision}")
        args.add("--hard-deadline"); args.add("${hardDeadlineAtMillis}")
        args.add("--deadline"); args.add("${softDeadlineAtMillis}")
        args.add("--result-rel"); args.add(resultRelativePath)
        args.add("--scheduler-run-id"); args.add(receipt.leaseOwner)
        let childEnvironment = ArrayList<CkbTimedWorkerProcessEnvironment>()
        childEnvironment.add(CkbTimedWorkerProcessEnvironment(
            "CKB_SCHEDULER_TASK_WORKER", "1"))
        let launched = CkbTimedWorkerProcessLauncher(getCommand(), args,
            environment: childEnvironment,
            cutoffAtMillis: cutoffAtMillis,
            hardDeadlineAtMillis: hardDeadlineAtMillis,
            pidPath: Path(this.store.rootPath()).join(resultRelativePath + ".started").toString(),
            timeoutMarkerPath: Path(this.store.rootPath()).join(resultRelativePath + ".timeout").toString()).run()
        let elapsed = ckbTaskWorkerNowMillis() - startedAtMillis
        if (launched.timedOut) {
            let task = ckbWriteSchedulerWorkerTimeoutCompensation(this.store,
                resultRelativePath, "cangjie_source_event_sync", receipt.eventId,
                elapsed, profile.timeBudgetMillis, "repository_event_worker_hard_timeout",
                workerPid: launched.workerPid)
            return ckbRepositoryEventWorkerResultFromTerminal(task)
        }
        let task = ckbReadSchedulerWorkerResult(this.store.rootPath(), resultRelativePath,
            "cangjie_source_event_sync", receipt.eventId, elapsed,
            profile.timeBudgetMillis, strictIdentity: true)
        ckbRepositoryEventWorkerResultFromTerminal(task)
    }
}

public func ckbRepositoryEventProcessWorkerEnabled(command: String): Bool {
    let trimmed = command.trimAscii()
    trimmed != "" && (trimmed == "main" || trimmed.endsWith("/main"))
}

public func ckbRepositoryEventWorkerResultFromTerminal(task: SchedulerTaskResult): CkbRepositoryEventWorkerResult {
    let result = CkbRepositoryEventWorkerResult()
    result.schedulerRunId = task.schedulerRunId
    result.transactionId = task.transactionId
    result.candidateVersion = task.candidateVersion
    result.activeVersion = task.activeVersion
    result.validationEvidenceHash = task.validationEvidenceHash
    for (gate in task.validationGates) { result.validationGates.add(gate) }
    if (task.ok) { result.state = "committed"; result.errorCode = "" }
    else { result.state = "retryable"; result.errorCode = if (task.primaryFailure != "") { task.primaryFailure } else { task.status } }
    result
}

// Child-process boundary: the parent owns claim/final receipt transitions.
// Re-read the durable receipt so a stale child can never execute another
// owner's lease or a superseded revision.
public func ckbRunRepositoryEventWorkerChild(kb: KnowledgeBase,
    store: FileKnowledgeStore, runner: SourceFetchRunner, config: CkbRuntimeConfig,
    dedupeKey: String, owner: String, revision: Int64,
    hardDeadlineAtMillis!: Int64 = 0, softDeadlineAtMillis!: Int64 = 0,
    resultRelativePath!: String = "", schedulerRunId!: String = ""): CkbRepositoryEventWorkerResult {
    let rejected = CkbRepositoryEventWorkerResult()
    rejected.state = "retryable"
    rejected.errorCode = "repository_event_claim_rejected"
    let receipt = store.loadRepositoryEventReceipt(dedupeKey)
    if (!receipt.valid || receipt.state != "running" || receipt.leaseOwner != owner ||
        receipt.revision != revision) {
        ckbWriteRepositoryEventChildTerminal(store, resultRelativePath, schedulerRunId,
            dedupeKey, hardDeadlineAtMillis, softDeadlineAtMillis, rejected)
        return rejected
    }
    let outcome = CkbRepositoryEventSourceSyncWorker(kb, store, runner, config).execute(receipt)
    ckbWriteRepositoryEventChildTerminal(store, resultRelativePath, schedulerRunId,
        receipt.eventId, hardDeadlineAtMillis, softDeadlineAtMillis, outcome)
    outcome
}

private func ckbWriteRepositoryEventChildTerminal(store: FileKnowledgeStore,
    resultRelativePath: String, schedulerRunId: String, since: String,
    hardDeadlineAtMillis: Int64, softDeadlineAtMillis: Int64,
    outcome: CkbRepositoryEventWorkerResult): Unit {
    if (resultRelativePath == "") { return }
    let nowMillis = ckbTaskWorkerNowMillis()
    let task = SchedulerTaskResult()
    task.ok = outcome.state == "committed"
    task.status = if (task.ok) { "repository_event_committed" } else {
        if (outcome.errorCode != "") { outcome.errorCode } else { "repository_event_worker_failed" }
    }
    task.businessStatus = task.status
    task.primaryFailure = if (task.ok) { "" } else { task.status }
    task.since = since
    task.schedulerRunId = schedulerRunId
    task.schedulerTaskName = "cangjie_source_event_sync"
    task.transactionId = outcome.transactionId
    task.candidateVersion = outcome.candidateVersion
    task.activeVersion = outcome.activeVersion
    task.validationEvidenceHash = outcome.validationEvidenceHash
    for (gate in outcome.validationGates) { task.validationGates.add(gate) }
    task.startedAtMillis = nowMillis
    task.taskBodyStartedAtMillis = nowMillis
    task.taskBodyEndedAtMillis = nowMillis
    task.endedAtMillis = nowMillis
    task.deadlineAtMillis = if (hardDeadlineAtMillis > 0) {
        hardDeadlineAtMillis
    } else { nowMillis }
    task.timeBudgetMillis = if (hardDeadlineAtMillis > nowMillis) {
        hardDeadlineAtMillis - nowMillis
    } else { 0 }
    task.lastStage = if (task.ok) { "repository_event_finished" } else { task.status }
    task.lastProgress = "softDeadlineAtMillis=${softDeadlineAtMillis}|hardDeadlineAtMillis=${hardDeadlineAtMillis}"
    _ = ckbWriteSchedulerTerminalResultArtifacts(store, resultRelativePath, task,
        nowMillis)
}

private func ckbRuntimeVersionManifestForStore(store: FileKnowledgeStore,
    config: CkbRuntimeConfig): CangjieVersionManifest {
    let pointer = store.loadActiveSnapshotPointer()
    if (pointer.valid && !pointer.legacy &&
        pointer.companionMode != CkbActiveSnapshotCompanionMode.NONE) {
        let active = store.loadActiveCangjieVersionManifest()
        if (active.sources.size == 0) {
            active.degraded = true
            active.diagnostics.add("active_version_manifest_empty")
        }
        return active
    }
    if (!pointer.valid && store.hasAuthoritativeActiveSnapshotPointer()) {
        let invalid = CangjieVersionManifest()
        invalid.sources.clear()
        invalid.degraded = true
        invalid.diagnostics.add("active_snapshot_pointer_invalid:${pointer.diagnostic}")
        return invalid
    }
    let stored = store.loadCangjieVersionManifest()
    if (stored.sources.size > 0) { return stored }
    let runtime = ckbRuntimeCangjieVersionManifest(config)
    for (diagnostic in stored.diagnostics) {
        runtime.degraded = true
        runtime.diagnostics.add("stored_manifest_${diagnostic}")
    }
    runtime
}

private func ckbServiceStringArrayJson(values: ArrayList<String>): String {
    var out = "["
    for (i in 0..values.size) {
        if (i > 0) {
            out += ","
        }
        out += "\"${ckbServiceJsonQuote(values[i])}\""
    }
    out + "]"
}

private func ckbServiceJsonQuote(raw: String): String {
    raw.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r")
}

private func ckbRejectedAdminResult(result: CkbAdminOperationResult, diagnostic: String): CkbAdminOperationResult {
    result.status = "rejected"
    result.degraded = true
    result.diagnostic = diagnostic
    result
}

private func ckbCommunityRepoAllowed(raw: String): Bool {
    let parts = raw.split("/")
    if (parts.size != 2 || !ckbServiceSafePathPart(parts[0]) || !ckbServiceSafePathPart(parts[1])) {
        return false
    }
    let owner = parts[0].toAsciiLower()
    owner == "cangjie" || owner == "cangjie-sig" || owner == "cangjie-tpc"
}

private func ckbRepoListTriggerPath(raw: String): Bool {
    let path = raw.toAsciiLower()
    path == "repo_list.md" || path == "repo_lists.md" || path.endsWith("/repo_list.md") || path.endsWith("/repo_lists.md")
}

private func ckbRepositorySourceTriggerPath(raw: String): Bool {
    let path = raw.toAsciiLower()
    path.endsWith(".cj") || path.endsWith(".md") || path.endsWith(".toml") || path.endsWith(".json") || path.endsWith(".yaml") || path.endsWith(".yml")
}

private func ckbSafeRepoRelativePath(raw: String): Bool {
    let path = raw.trimAscii()
    if (path == "" || path.startsWith("/") || path.startsWith("~") || path.contains("\\") || path.contains("..")) {
        return false
    }
    for (part in path.split("/")) {
        if (part == "" || part == "." || part == "..") {
            return false
        }
    }
    true
}

private func ckbServiceSafePathPart(raw: String): Bool {
    if (raw == "" || raw == "." || raw == "..") {
        return false
    }
    for (ch in raw.toRuneArray()) {
        let ok = (ch >= r'a' && ch <= r'z') || (ch >= r'A' && ch <= r'Z') || (ch >= r'0' && ch <= r'9') || ch == r'_' || ch == r'-' || ch == r'.'
        if (!ok) {
            return false
        }
    }
    true
}

private class CkbServiceJsonStringScan {
    var ok: Bool = false
    var value: String = ""
    var end: Int64 = 0

    init() {}
}

private func ckbServiceJsonStringField(raw: String, key: String): String {
    let start = ckbServiceJsonTopLevelValueStart(raw, key)
    if (start < 0 || start >= raw.size || raw[start..start + 1] != "\"") {
        return ""
    }
    let scan = ckbServiceReadJsonStringAt(raw, start)
    if (scan.ok) {
        return scan.value
    }
    ""
}

private func ckbServiceJsonIntField(raw: String, key: String, fallback: Int64): Int64 {
    let start = ckbServiceJsonTopLevelValueStart(raw, key)
    if (start < 0 || start >= raw.size) {
        return fallback
    }
    if (raw[start..start + 1] == "\"") {
        return try { Int64.parse(ckbServiceJsonStringField(raw, key).trimAscii()) } catch (_: Exception) { fallback }
    }
    var end = start
    while (end < raw.size) {
        let ch = raw[end..end + 1]
        if (ch == "," || ch == "}" || ch == "]" || ch == " " || ch == "\n" || ch == "\r" || ch == "\t") {
            break
        }
        end += 1
    }
    try { Int64.parse(raw[start..end].trimAscii()) } catch (_: Exception) { fallback }
}

private func ckbServiceJsonBoolFieldDefault(raw: String, key: String, fallback: Bool): Bool {
    let start = ckbServiceJsonTopLevelValueStart(raw, key)
    if (start < 0 || start >= raw.size) {
        return fallback
    }
    if (raw[start..start + 1] == "\"") {
        let value = ckbServiceJsonStringField(raw, key).trimAscii().toAsciiLower()
        if (value == "true" || value == "1" || value == "yes" || value == "enabled") {
            return true
        }
        if (value == "false" || value == "0" || value == "no" || value == "disabled") {
            return false
        }
        return fallback
    }
    var end = start
    while (end < raw.size) {
        let ch = raw[end..end + 1]
        if (ch == "," || ch == "}" || ch == "]" || ch == " " || ch == "\n" || ch == "\r" || ch == "\t") {
            break
        }
        end += 1
    }
    let value = raw[start..end].trimAscii().toAsciiLower()
    if (value == "true" || value == "1" || value == "yes" || value == "enabled") {
        return true
    }
    if (value == "false" || value == "0" || value == "no" || value == "disabled") {
        return false
    }
    fallback
}

private func ckbServiceJsonStringArrayField(raw: String, key: String): ArrayList<String> {
    let values = ArrayList<String>()
    let start = ckbServiceJsonTopLevelValueStart(raw, key)
    if (start < 0 || start >= raw.size || raw[start..start + 1] != "[") {
        return values
    }
    var i = start + 1
    while (i < raw.size) {
        i = ckbServiceSkipJsonWhitespace(raw, i)
        if (i >= raw.size || raw[i..i + 1] == "]") {
            break
        }
        if (raw[i..i + 1] == "\"") {
            let scan = ckbServiceReadJsonStringAt(raw, i)
            if (scan.ok) {
                values.add(scan.value)
                i = scan.end
            } else {
                break
            }
        } else {
            i += 1
        }
        i = ckbServiceSkipJsonWhitespace(raw, i)
        if (i < raw.size && raw[i..i + 1] == ",") {
            i += 1
        }
    }
    values
}

private func ckbServiceJsonTopLevelValueStart(raw: String, key: String): Int64 {
    var i: Int64 = 0
    var depth: Int64 = 0
    var inString = false
    var escaped = false
    while (i < raw.size) {
        let ch = raw[i..i + 1]
        if (inString) {
            if (escaped) {
                escaped = false
            } else if (ch == "\\") {
                escaped = true
            } else if (ch == "\"") {
                inString = false
            }
            i += 1
            continue
        }
        if (ch == "\"") {
            if (depth == 1) {
                let scan = ckbServiceReadJsonStringAt(raw, i)
                if (scan.ok && scan.value == key) {
                    var colon = ckbServiceSkipJsonWhitespace(raw, scan.end)
                    if (colon < raw.size && raw[colon..colon + 1] == ":") {
                        return ckbServiceSkipJsonWhitespace(raw, colon + 1)
                    }
                }
                i = if (scan.ok) { scan.end } else { i + 1 }
                continue
            }
            inString = true
        } else if (ch == "{" || ch == "[") {
            depth += 1
        } else if (ch == "}" || ch == "]") {
            depth -= 1
        }
        i += 1
    }
    -1
}

private func ckbServiceReadJsonStringAt(raw: String, start: Int64): CkbServiceJsonStringScan {
    let scan = CkbServiceJsonStringScan()
    if (start < 0 || start >= raw.size || raw[start..start + 1] != "\"") {
        return scan
    }
    var i = start + 1
    var escaped = false
    var value = ""
    while (i < raw.size) {
        let ch = raw[i..i + 1]
        if (escaped) {
            value += ckbServiceJsonUnescapeChar(ch)
            escaped = false
        } else if (ch == "\\") {
            escaped = true
        } else if (ch == "\"") {
            scan.ok = true
            scan.value = value
            scan.end = i + 1
            return scan
        } else {
            value += ch
        }
        i += 1
    }
    scan
}

private func ckbServiceJsonUnescapeChar(ch: String): String {
    if (ch == "\"") { return "\"" }
    if (ch == "\\") { return "\\" }
    if (ch == "/") { return "/" }
    if (ch == "n") { return "\n" }
    if (ch == "r") { return "\r" }
    if (ch == "t") { return "\t" }
    ch
}

private func ckbServiceSkipJsonWhitespace(raw: String, start: Int64): Int64 {
    var i = start
    while (i < raw.size) {
        let ch = raw[i..i + 1]
        if (ch != " " && ch != "\n" && ch != "\r" && ch != "\t") {
            break
        }
        i += 1
    }
    i
}

private func sourceAnalysisResultFromPack(pack: SourceAnalysisPack): SourceAnalysisResult {
    let result = SourceAnalysisResult()
    result.analysisId = stableSummaryHash("${pack.repo}:${pack.ref}:${pack.status}")
    result.repo = pack.repo
    result.ref = pack.ref
    result.sourceAcquisition = if (pack.ok) { SourceAnalysisAcquisition.CLONE } else { SourceAnalysisAcquisition.NONE }
    result.degraded = !pack.ok
    result.cleanupStatus = pack.cleanupStatus
    result.diagnostic = pack.diagnostic
    for (file in pack.selectedFiles) {
        result.filesRead.add(file)
        if (file.citation != "") {
            result.citations.add(file.citation)
        }
    }
    result
}

private func parseSourceAnalysisCommand(tail: String): SourceAnalysisRequest {
    let request = SourceAnalysisRequest()
    let parts = tail.split(" ")
    if (parts.size > 0 && parts[0].trimAscii() != "") {
        request.repo = parts[0].trimAscii()
    }
    if (parts.size > 1 && parts[1].trimAscii() != "") {
        request.ref = parts[1].trimAscii()
    }
    request.visibility = RepoVisibility.PUBLIC
    if (parts.size > 2) {
        for (i in 2..parts.size) {
            let path = parts[i].trimAscii()
            if (path != "") {
                request.changedFiles.add(path)
            }
        }
    }
    request
}

public func renderSourceAnalysis(pack: SourceAnalysisPack): String {
    var out = "source_analysis ok=${pack.ok} status=${pack.status} repo=${pack.repo} ref=${pack.ref} files=${pack.selectedFiles.size} truncated=${pack.truncated} cleanupStatus=${pack.cleanupStatus} workspace=${pack.workspaceStatus}\n"
    if (pack.diagnostic != "") {
        out += "diagnostic=${redactSensitive(pack.diagnostic)}\n"
    }
    for (file in pack.selectedFiles) {
        out += "file path=${file.path} bytes=${file.bytes} bodyHash=${file.bodyHash} truncated=${file.truncated} citation=${file.citation}\n"
    }
    redactSensitive(out)
}

public func ckbSyncOnce(kb: KnowledgeBase, adapter: SourceAdapter, store: FileKnowledgeStore): String {
    let planner = SourceSyncPlanner()
    let plan = planner.productionPlan(kb.sourceScope)
    var okCount: Int64 = 0
    var orgStatus = "missing"
    var repoStatus = "missing"
    var docsStatus = "missing"
    var webCandidateStatus = "missing"
    for (i in 0..plan.requests.size) {
        let request = plan.requests[i]
        let fetch = adapter.fetch(request)
        if (fetch.ok) {
            okCount += 1
        }
        if (request.kind == SourceKinds.GITCODE_ORG) {
            orgStatus = fetch.status
            kb.ingestFetchResult("sync-org-${request.repo}", SourceTypes.COMMUNITY, fetch, "GitCode ${request.repo} org", TrustLevels.COMMUNITY, ReviewStates.REVIEWED)
        } else if (request.kind == SourceKinds.GITCODE_REPO) {
            repoStatus = fetch.status
            kb.ingestFetchResult("sync-repo-${safeName(request.repo)}", SourceTypes.REPO, fetch, "GitCode ${request.repo} repo", TrustLevels.OFFICIAL, ReviewStates.TRUSTED)
        } else if (request.kind == SourceKinds.GITCODE_SOURCE) {
            kb.ingestFetchResult("sync-source-${safeName(request.repo)}-${safeName(request.path)}", SourceTypes.REPO, fetch, "GitCode ${request.repo} source", TrustLevels.OFFICIAL, ReviewStates.TRUSTED)
        } else if (request.kind == SourceKinds.GITCODE_ISSUE_HISTORY) {
            kb.ingestFetchResult("sync-issue-${safeName(request.repo)}", SourceTypes.COMMUNITY, fetch, "GitCode issue history", TrustLevels.COMMUNITY, ReviewStates.REVIEWED)
        } else if (request.kind == SourceKinds.GITCODE_PR_HISTORY) {
            kb.ingestFetchResult("sync-pr-${safeName(request.repo)}", SourceTypes.COMMUNITY, fetch, "GitCode PR history", TrustLevels.COMMUNITY, ReviewStates.REVIEWED)
        } else if (request.kind == SourceKinds.CANGJIE_DOCS) {
            docsStatus = fetch.status
            kb.ingestFetchResult("sync-docs-${i}", SourceTypes.DOC, fetch, "Cangjie docs", TrustLevels.OFFICIAL, ReviewStates.TRUSTED)
        } else if (request.kind == SourceKinds.CANGJIE_WEBSITE) {
            kb.ingestFetchResult("sync-website-${i}", SourceTypes.WEBSITE, fetch, "Cangjie website", TrustLevels.OFFICIAL, ReviewStates.TRUSTED)
        } else if (request.kind == SourceKinds.WEB_CANDIDATE) {
            webCandidateStatus = fetch.status
            kb.ingestFetchResult("sync-web-candidate-${i}", SourceTypes.WEB_CANDIDATE, fetch, "Web candidate", TrustLevels.WEB_CANDIDATE, ReviewStates.CANDIDATE)
        }
    }
    kb.normalize()
    kb.persist(store)
    "sync status requests=${plan.requests.size} ok=${okCount} org=${orgStatus} repo=${repoStatus} docs=${docsStatus} webCandidate=${webCandidateStatus}"
}

public func ckbSyncLiveApply(kb: KnowledgeBase, adapter: SourceAdapter, store: FileKnowledgeStore, options: LiveApplyOptions): LiveApplyResult {
    let result = LiveApplyResult()
    result.applied = options.apply
    result.since = options.since
    let planner = SourceSyncPlanner()
    let plan = limitedPlan(planner.productionPlan(kb.sourceScope), options)
    result.truncated = plan.truncated
    result.requests = plan.requests.size
    if (!options.apply) {
        result.ok = true
        return result
    }
    for (i in 0..plan.requests.size) {
        let request = plan.requests[i]
        let fetch = adapter.fetch(request)
        if (fetch.ok) {
            result.fetched += 1
            ingestLiveFetch(kb, request, fetch, i)
        } else {
            result.failed += 1
            result.errorReport += "${request.kind}:${request.repo}:${fetch.status}\n"
        }
    }
    kb.normalize()
    let promotion = cangjiePromoteCandidateAfterValidation(kb, store, forceFailure: options.simulateValidationFailure)
    let status = kb.status()
    result.rawCount = status.storage.rawCount
    result.normalizedCount = status.storage.normalizedCount
    result.activeVersion = status.activeKnowledgeVersion
    result.candidateVersion = status.candidateKnowledgeVersion
    result.failedVersion = status.failedCandidateVersion
    if (!promotion.ok) {
        result.ok = false
        result.errorReport += renderCangjieCandidateValidationSummary(promotion.validation)
        return result
    }
    result.ok = true
    result
}

public func ckbRebuildIndex(kb: KnowledgeBase, store: FileKnowledgeStore, fail!: Bool = false, progressSink!: VectorBuildProgressSink = NoopVectorBuildProgressSink(), targetVectorCollection!: String = "", persistSnapshot!: Bool = true, deadlineAtMillis!: Int64 = 0): IndexBuildResult {
    let before = ckbIndexDeadlineFailure("rebuild_start", deadlineAtMillis)
    if (!before.ok) {
        return before
    }
    let result = kb.rebuildIndex(fail, progressSink: progressSink, targetVectorCollection: targetVectorCollection, deadlineAtMillis: deadlineAtMillis)
    if (result.ok) {
        let vector = kb.lastVectorIndexBuild()
        if (!vector.ok) {
            result.ok = false
            result.failedVersion = if (vector.diagnostic != "") {
                vector.diagnostic
            } else if (result.failedVersion != "") {
                result.failedVersion
            } else if (result.candidateVersion != "") {
                result.candidateVersion
            } else {
                "vector_rebuild_failed"
            }
            return result
        }
        if (ckbApplyIndexDeadlineFailure(result, "rebuild_vector_complete", deadlineAtMillis)) {
            return result
        }
        if (targetVectorCollection.trimAscii() == "") {
            if (ckbApplyIndexDeadlineFailure(result, "rebuild_verify_before", deadlineAtMillis)) {
                return result
            }
            let verified = kb.verifyAndApplyVectorStoreStatus(kb.status().storage.vectorActiveCollection, result.count)
            if (verified.state != EmbeddingProviderState.READY) {
                result.ok = false
                result.failedVersion = if (verified.degradedReason != "") { verified.degradedReason } else { "vector_store_status_not_ready" }
                return result
            }
            if (ckbApplyIndexDeadlineFailure(result, "rebuild_verify_after", deadlineAtMillis)) {
                return result
            }
        }
        if (persistSnapshot) {
            if (ckbApplyIndexDeadlineFailure(result, "rebuild_persist_snapshot_before", deadlineAtMillis)) {
                return result
            }
            try {
                kb.persistActiveSnapshotUsingVectorRecords(store, vector.vectorRecords, deadlineAtMillis: deadlineAtMillis)
            } catch (e: Exception) {
                result.ok = false
                result.failedVersion = ckbSnapshotWriteFailureDiagnostic(e)
                return result
            }
            _ = ckbDeadlineGuard("rebuild_persist_snapshot_after", deadlineAtMillis)
        }
    }
    result
}

private func ckbIndexDeadlineFailure(stage: String, deadlineAtMillis: Int64): IndexBuildResult {
    let result = IndexBuildResult()
    let deadline = ckbDeadlineGuard(stage, deadlineAtMillis)
    if (deadline.exceeded) {
        result.ok = false
        result.failedVersion = deadline.diagnostic
        result.lastStage = stage
        result.lastProgress = deadline.diagnostic
    } else {
        result.ok = true
    }
    result
}

private func ckbApplyIndexDeadlineFailure(result: IndexBuildResult, stage: String, deadlineAtMillis: Int64): Bool {
    let deadline = ckbDeadlineGuard(stage, deadlineAtMillis)
    if (!deadline.exceeded) {
        return false
    }
    result.ok = false
    result.failedVersion = deadline.diagnostic
    result.lastStage = stage
    result.lastProgress = deadline.diagnostic
    true
}

private func ckbSetIndexBuildFailure(result: IndexBuildResult, stage: String, failedVersion: String, progress: String): Unit {
    result.ok = false
    result.failedVersion = failedVersion
    result.lastStage = stage
    result.lastProgress = progress
}

private func ckbSetIndexBuildProgress(result: IndexBuildResult, stage: String, progress: String): Unit {
    result.lastStage = stage
    result.lastProgress = progress
}

private func ckbStagedRebuildStageDeadline(result: IndexBuildResult, stage: String, parentDeadlineAtMillis: Int64, stageBudgetMillis: Int64): Int64 {
    if (parentDeadlineAtMillis <= 0 || stageBudgetMillis <= 0) {
        return parentDeadlineAtMillis
    }
    let remaining = ckbRemainingMillis(parentDeadlineAtMillis)
    let required = stageBudgetMillis + ckbSchedulerWorkerResultFlushMarginMillis()
    if (remaining < required) {
        ckbSetIndexBuildFailure(result, stage, "deadline_exceeded:${stage}_budget_insufficient:remaining=${remaining}:required=${required}:deadline=${parentDeadlineAtMillis}", "remainingMillis=${remaining},requiredMillis=${required}")
        return parentDeadlineAtMillis
    }
    ckbStageDeadline(parentDeadlineAtMillis, stageBudgetMillis)
}

private func ckbSnapshotWriteFailureDiagnostic(e: Exception): String {
    let message = e.message.trimAscii()
    if (message.startsWith("deadline_exceeded:")) {
        return message
    }
    if (message != "") {
        return "active_snapshot_write_failed:${utf8SafePrefix(message, 160)}"
    }
    "active_snapshot_write_failed"
}

private func ckbRestoreOldSnapshotBestEffort(kb: KnowledgeBase, snapshot: ActiveSnapshot): Unit {
    if (snapshot.valid) {
        _ = kb.restoreActiveSnapshot(snapshot)
    }
}

public func ckbStagedFullRebuildWithVectorStore(kb: KnowledgeBase, store: FileKnowledgeStore, config: CkbRuntimeConfig, vectorStore: VectorStore, progressSink: VectorBuildProgressSink, deadlineAtMillis: Int64, stageSink!: CkbStagedRebuildStageSink = NoopCkbStagedRebuildStageSink(), profile!: CkbScheduleTaskProfile = CkbScheduleTaskProfile()): IndexBuildResult {
    let vector = vectorStoreConfigFromRuntime(config)
    if (vector.backend != "qdrant") {
        return ckbRebuildIndex(kb, store, progressSink: progressSink, deadlineAtMillis: deadlineAtMillis)
    }
    let runId = ckbSchedulerCurrentRunId(store)
    let taskName = if (ckbSchedulerCurrentTaskName(store) != "") { ckbSchedulerCurrentTaskName(store) } else { "weekly_full_rebuild" }
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_start", "running", deadlineAtMillis, "backend=qdrant", runId: runId, taskName: taskName)
    let before = ckbIndexDeadlineFailure("staged_rebuild_start", deadlineAtMillis)
    if (!before.ok) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_start", "timeout", deadlineAtMillis, before.failedVersion, runId: runId, taskName: taskName)
        return before
    }
    let oldSnapshot = store.loadActiveSnapshot()
    let stagingCollection = ckbVectorReconcileStagingCollection(vector.activeCollection)
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_vector_before", "running", deadlineAtMillis, "stagingCollection=${stagingCollection}", runId: runId, taskName: taskName)
    let result = ckbRebuildIndex(kb, store, progressSink: progressSink, targetVectorCollection: stagingCollection, persistSnapshot: false, deadlineAtMillis: deadlineAtMillis)
    if (!result.ok) {
        if (result.lastStage == "") {
            ckbSetIndexBuildProgress(result, "staged_rebuild_vector_after", "stagingCollection=${stagingCollection},failedVersion=${result.failedVersion}")
        }
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_vector_after", "failed", deadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    ckbSetIndexBuildProgress(result, "staged_rebuild_vector_after", "stagingCollection=${stagingCollection},count=${result.count}")
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_vector_after", "ok", deadlineAtMillis, "stagingCollection=${stagingCollection}|count=${result.count}", runId: runId, taskName: taskName)
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_vector_after", deadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_vector_after", "timeout", deadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    let validationDeadlineAtMillis = ckbStagedRebuildStageDeadline(result, "staged_rebuild_validation_budget", deadlineAtMillis, profile.validationBudgetMillis)
    if (!result.ok) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_validation_budget", "timeout", deadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_status_before", "running", validationDeadlineAtMillis, "stagingCollection=${stagingCollection}", runId: runId, taskName: taskName)
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_status_before", validationDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_status_before", "timeout", validationDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    let staging = vectorStore.status(stagingCollection)
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_status_after", staging.state, validationDeadlineAtMillis, "stagingCollection=${stagingCollection}|count=${staging.count}|dimension=${staging.dimension}|distance=${staging.distance}|reason=${staging.degradedReason}", runId: runId, taskName: taskName)
    ckbSetIndexBuildProgress(result, "staged_rebuild_status_after", "stagingCollection=${stagingCollection},state=${staging.state},count=${staging.count},expected=${result.count}")
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_status_after", validationDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_status_after", "timeout", validationDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    if (staging.state != EmbeddingProviderState.READY) {
        ckbSetIndexBuildFailure(result, "staged_rebuild_status_after", "qdrant_staging_not_ready:${staging.degradedReason}", "stagingCollection=${stagingCollection},state=${staging.state},reason=${staging.degradedReason}")
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    if (staging.count != result.count) {
        ckbSetIndexBuildFailure(result, "staged_rebuild_status_after", "qdrant_staging_count_mismatch:${staging.count}:${result.count}:${stagingCollection}", "stagingCollection=${stagingCollection},count=${staging.count},expected=${result.count}")
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    if (vector.dimensions > 0 && staging.dimension > 0 && staging.dimension != vector.dimensions) {
        ckbSetIndexBuildFailure(result, "staged_rebuild_status_after", "qdrant_staging_dimension_mismatch:${staging.dimension}:${vector.dimensions}:${stagingCollection}", "stagingCollection=${stagingCollection},dimension=${staging.dimension},expected=${vector.dimensions}")
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    if (vector.distance != "" && staging.distance != "" && staging.distance.trimAscii().toAsciiLower() != vector.distance.trimAscii().toAsciiLower()) {
        ckbSetIndexBuildFailure(result, "staged_rebuild_status_after", "qdrant_staging_distance_mismatch:${staging.distance}:${vector.distance}:${stagingCollection}", "stagingCollection=${stagingCollection},distance=${staging.distance},expected=${vector.distance}")
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_promote_before", "running", validationDeadlineAtMillis, "stagingCollection=${stagingCollection}", runId: runId, taskName: taskName)
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_promote_before", validationDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_promote_before", "timeout", validationDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    kb.promoteVectorActiveCollection(stagingCollection)
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_promote_after", "ok", validationDeadlineAtMillis, "stagingCollection=${stagingCollection}", runId: runId, taskName: taskName)
    ckbSetIndexBuildProgress(result, "staged_rebuild_promote_after", "stagingCollection=${stagingCollection}")
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_promote_after", validationDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_promote_after", "timeout", validationDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        return result
    }
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_verify_before", "running", validationDeadlineAtMillis, "stagingCollection=${stagingCollection}|expected=${result.count}", runId: runId, taskName: taskName)
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_verify_before", validationDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_verify_before", "timeout", validationDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        return result
    }
    let verified = kb.verifyAndApplyVectorStoreStatus(stagingCollection, result.count)
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_verify_after", verified.state, validationDeadlineAtMillis, "stagingCollection=${stagingCollection}|count=${verified.count}|reason=${verified.degradedReason}", runId: runId, taskName: taskName)
    ckbSetIndexBuildProgress(result, "staged_rebuild_verify_after", "stagingCollection=${stagingCollection},state=${verified.state},count=${verified.count}")
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_verify_after", validationDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_verify_after", "timeout", validationDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        return result
    }
    if (verified.state != EmbeddingProviderState.READY) {
        ckbSetIndexBuildFailure(result, "staged_rebuild_verify_after", if (verified.degradedReason != "") { verified.degradedReason } else { "qdrant_active_status_not_ready:${stagingCollection}" }, "stagingCollection=${stagingCollection},state=${verified.state},reason=${verified.degradedReason}")
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    let snapshotDeadlineAtMillis = ckbStagedRebuildStageDeadline(result, "staged_rebuild_snapshot_budget", deadlineAtMillis, profile.snapshotBudgetMillis)
    if (!result.ok) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_snapshot_budget", "timeout", deadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        return result
    }
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_persist_snapshot_before", "running", snapshotDeadlineAtMillis, "stagingCollection=${stagingCollection}|count=${result.count}", runId: runId, taskName: taskName)
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_persist_snapshot_before", snapshotDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_persist_snapshot_before", "timeout", snapshotDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        return result
    }
    try {
        kb.persistActiveSnapshotUsingVectorRecords(store, kb.lastVectorIndexBuild().vectorRecords, persistVectorFile: false, deadlineAtMillis: snapshotDeadlineAtMillis, stageSink: stageSink)
    } catch (e: Exception) {
        let snapshotStage = ckbSchedulerWorkerLastStageFromStore(store)
        ckbSetIndexBuildFailure(result, if (snapshotStage != "") { snapshotStage } else { "staged_rebuild_persist_snapshot_before" }, ckbSnapshotWriteFailureDiagnostic(e), ckbSchedulerWorkerLastProgressFromStore(store))
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        ckbDeleteStagingBestEffort(vectorStore, stagingCollection)
        return result
    }
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_persist_snapshot_after", "ok", snapshotDeadlineAtMillis, "stagingCollection=${stagingCollection}|count=${result.count}", runId: runId, taskName: taskName)
    ckbSetIndexBuildProgress(result, "staged_rebuild_persist_snapshot_after", "stagingCollection=${stagingCollection},count=${result.count}")
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_persist_snapshot_after", snapshotDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_persist_snapshot_after", "timeout", snapshotDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
    }
    result
}

public func ckbStagedFullRebuild(kb: KnowledgeBase, store: FileKnowledgeStore, config: CkbRuntimeConfig, progressSink: VectorBuildProgressSink, deadlineAtMillis: Int64, stageSink!: CkbStagedRebuildStageSink = NoopCkbStagedRebuildStageSink(), profile!: CkbScheduleTaskProfile = CkbScheduleTaskProfile()): IndexBuildResult {
    let vector = vectorStoreConfigFromRuntime(config)
    if (vector.backend != "qdrant") {
        return ckbRebuildIndex(kb, store, progressSink: progressSink, deadlineAtMillis: deadlineAtMillis)
    }
    let runId = ckbSchedulerCurrentRunId(store)
    let taskName = if (ckbSchedulerCurrentTaskName(store) != "") { ckbSchedulerCurrentTaskName(store) } else { "weekly_full_rebuild" }
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_start", "running", deadlineAtMillis, "backend=qdrant", runId: runId, taskName: taskName)
    let before = ckbIndexDeadlineFailure("staged_rebuild_start", deadlineAtMillis)
    if (!before.ok) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_start", "timeout", deadlineAtMillis, before.failedVersion, runId: runId, taskName: taskName)
        return before
    }
    let oldSnapshot = store.loadActiveSnapshot()
    let stagingCollection = ckbVectorReconcileStagingCollection(vector.activeCollection)
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_vector_before", "running", deadlineAtMillis, "stagingCollection=${stagingCollection}", runId: runId, taskName: taskName)
    let result = ckbRebuildIndex(kb, store, progressSink: progressSink, targetVectorCollection: stagingCollection, persistSnapshot: false, deadlineAtMillis: deadlineAtMillis)
    if (!result.ok) {
        if (result.lastStage == "") {
            ckbSetIndexBuildProgress(result, "staged_rebuild_vector_after", "stagingCollection=${stagingCollection},failedVersion=${result.failedVersion}")
        }
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_vector_after", "failed", deadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    ckbSetIndexBuildProgress(result, "staged_rebuild_vector_after", "stagingCollection=${stagingCollection},count=${result.count}")
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_vector_after", "ok", deadlineAtMillis, "stagingCollection=${stagingCollection}|count=${result.count}", runId: runId, taskName: taskName)
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_vector_after", deadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_vector_after", "timeout", deadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    let validationDeadlineAtMillis = ckbStagedRebuildStageDeadline(result, "staged_rebuild_validation_budget", deadlineAtMillis, profile.validationBudgetMillis)
    if (!result.ok) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_validation_budget", "timeout", deadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_status_before", "running", validationDeadlineAtMillis, "stagingCollection=${stagingCollection}", runId: runId, taskName: taskName)
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_status_before", validationDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_status_before", "timeout", validationDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    let staging = kb.vectorCollectionStatus(stagingCollection)
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_status_after", staging.state, validationDeadlineAtMillis, "stagingCollection=${stagingCollection}|count=${staging.count}|dimension=${staging.dimension}|distance=${staging.distance}|reason=${staging.degradedReason}", runId: runId, taskName: taskName)
    ckbSetIndexBuildProgress(result, "staged_rebuild_status_after", "stagingCollection=${stagingCollection},state=${staging.state},count=${staging.count},expected=${result.count}")
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_status_after", validationDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_status_after", "timeout", validationDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    if (staging.state != EmbeddingProviderState.READY) {
        ckbSetIndexBuildFailure(result, "staged_rebuild_status_after", "qdrant_staging_not_ready:${staging.degradedReason}", "stagingCollection=${stagingCollection},state=${staging.state},reason=${staging.degradedReason}")
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    if (staging.count != result.count) {
        ckbSetIndexBuildFailure(result, "staged_rebuild_status_after", "qdrant_staging_count_mismatch:${staging.count}:${result.count}:${stagingCollection}", "stagingCollection=${stagingCollection},count=${staging.count},expected=${result.count}")
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    if (vector.dimensions > 0 && staging.dimension > 0 && staging.dimension != vector.dimensions) {
        ckbSetIndexBuildFailure(result, "staged_rebuild_status_after", "qdrant_staging_dimension_mismatch:${staging.dimension}:${vector.dimensions}:${stagingCollection}", "stagingCollection=${stagingCollection},dimension=${staging.dimension},expected=${vector.dimensions}")
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    if (vector.distance != "" && staging.distance != "" && staging.distance.trimAscii().toAsciiLower() != vector.distance.trimAscii().toAsciiLower()) {
        ckbSetIndexBuildFailure(result, "staged_rebuild_status_after", "qdrant_staging_distance_mismatch:${staging.distance}:${vector.distance}:${stagingCollection}", "stagingCollection=${stagingCollection},distance=${staging.distance},expected=${vector.distance}")
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_promote_before", "running", validationDeadlineAtMillis, "stagingCollection=${stagingCollection}", runId: runId, taskName: taskName)
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_promote_before", validationDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_promote_before", "timeout", validationDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    kb.promoteVectorActiveCollection(stagingCollection)
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_promote_after", "ok", validationDeadlineAtMillis, "stagingCollection=${stagingCollection}", runId: runId, taskName: taskName)
    ckbSetIndexBuildProgress(result, "staged_rebuild_promote_after", "stagingCollection=${stagingCollection}")
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_promote_after", validationDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_promote_after", "timeout", validationDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        return result
    }
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_verify_before", "running", validationDeadlineAtMillis, "stagingCollection=${stagingCollection}|expected=${result.count}", runId: runId, taskName: taskName)
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_verify_before", validationDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_verify_before", "timeout", validationDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        return result
    }
    let verified = kb.verifyAndApplyVectorStoreStatus(stagingCollection, result.count)
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_verify_after", verified.state, validationDeadlineAtMillis, "stagingCollection=${stagingCollection}|count=${verified.count}|reason=${verified.degradedReason}", runId: runId, taskName: taskName)
    ckbSetIndexBuildProgress(result, "staged_rebuild_verify_after", "stagingCollection=${stagingCollection},state=${verified.state},count=${verified.count}")
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_verify_after", validationDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_verify_after", "timeout", validationDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        return result
    }
    if (verified.state != EmbeddingProviderState.READY) {
        ckbSetIndexBuildFailure(result, "staged_rebuild_verify_after", if (verified.degradedReason != "") { verified.degradedReason } else { "qdrant_active_status_not_ready:${stagingCollection}" }, "stagingCollection=${stagingCollection},state=${verified.state},reason=${verified.degradedReason}")
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        return result
    }
    let snapshotDeadlineAtMillis = ckbStagedRebuildStageDeadline(result, "staged_rebuild_snapshot_budget", deadlineAtMillis, profile.snapshotBudgetMillis)
    if (!result.ok) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_snapshot_budget", "timeout", deadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        return result
    }
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_persist_snapshot_before", "running", snapshotDeadlineAtMillis, "stagingCollection=${stagingCollection}|count=${result.count}", runId: runId, taskName: taskName)
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_persist_snapshot_before", snapshotDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_persist_snapshot_before", "timeout", snapshotDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        return result
    }
    try {
        kb.persistActiveSnapshotUsingVectorRecords(store, kb.lastVectorIndexBuild().vectorRecords, persistVectorFile: false, deadlineAtMillis: snapshotDeadlineAtMillis, stageSink: stageSink)
    } catch (e: Exception) {
        let snapshotStage = ckbSchedulerWorkerLastStageFromStore(store)
        ckbSetIndexBuildFailure(result, if (snapshotStage != "") { snapshotStage } else { "staged_rebuild_persist_snapshot_before" }, ckbSnapshotWriteFailureDiagnostic(e), ckbSchedulerWorkerLastProgressFromStore(store))
        ckbRestoreOldSnapshotBestEffort(kb, oldSnapshot)
        ckbDeleteKnowledgeBaseStagingBestEffort(kb, stagingCollection)
        return result
    }
    ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_persist_snapshot_after", "ok", snapshotDeadlineAtMillis, "stagingCollection=${stagingCollection}|count=${result.count}", runId: runId, taskName: taskName)
    ckbSetIndexBuildProgress(result, "staged_rebuild_persist_snapshot_after", "stagingCollection=${stagingCollection},count=${result.count}")
    if (ckbApplyIndexDeadlineFailure(result, "staged_rebuild_persist_snapshot_after", snapshotDeadlineAtMillis)) {
        ckbEmitStagedRebuildStage(stageSink, "staged_rebuild_persist_snapshot_after", "timeout", snapshotDeadlineAtMillis, result.failedVersion, runId: runId, taskName: taskName)
    }
    result
}

public func renderRuntimeDoctor(config: CkbRuntimeConfig): String {
    "runtime ${config.redactedSummary()}\n"
}

public func embeddingConfigFromRuntime(config: CkbRuntimeConfig): EmbeddingConfig {
    let embedding = EmbeddingConfig()
    let localProvider = config.embeddingProvider == "deterministic" || config.embeddingProvider == "local" || config.embeddingProvider == "local-file"
    embedding.provider = config.embeddingProvider
    embedding.model = if (config.embeddingModel == "" && localProvider) { "deterministic-token-v1" } else { config.embeddingModel }
    embedding.dimensions = if (config.embeddingDimensions <= 0 && localProvider) { 16 } else { config.embeddingDimensions }
    embedding.endpoint = config.embeddingEndpoint
    embedding.tokenFile = config.embeddingTokenFile
    embedding.batchSize = if (config.embeddingBatchSize <= 0) { 16 } else { config.embeddingBatchSize }
    embedding.maxBatchBytes = if (config.embeddingMaxBatchBytes <= 0) { 65536 } else { config.embeddingMaxBatchBytes }
    embedding.maxTextBytes = if (config.embeddingMaxTextBytes <= 0) { 8192 } else { config.embeddingMaxTextBytes }
    embedding.totalTimeoutMillis = if (config.embeddingTotalTimeoutMillis < 0) { 0 } else { config.embeddingTotalTimeoutMillis }
    embedding.timeoutMillis = if (config.embeddingTimeoutMillis <= 0) { 10000 } else { config.embeddingTimeoutMillis }
    embedding.retryCount = if (config.embeddingRetryCount < 0) { 0 } else { config.embeddingRetryCount }
    embedding.production = !localProvider
    embedding.configured = config.embeddingProvider != "" && config.embeddingProvider != "none"
    embedding
}

public class RuntimeVectorStoreConfig {
    public var backend: String = "local-file"
    public var endpoint: String = ""
    public var activeCollection: String = "active"
    public var candidateCollection: String = "candidate"
    public var dimensions: Int64 = 16
    public var distance: String = "Cosine"
    public var timeoutMillis: Int64 = 10000
    public var retryCount: Int64 = 2
    public var apiKeyFile: String = ""
    public var allowPrivateEndpoint: Bool = false

    public init() {}

    public func apiKeyPresent(): Bool {
        this.apiKeyFile != ""
    }
}

public func vectorStoreConfigFromRuntime(config: CkbRuntimeConfig): RuntimeVectorStoreConfig {
    let vector = RuntimeVectorStoreConfig()
    vector.backend = if (config.vectorBackend == "") { "local-file" } else { config.vectorBackend }
    vector.endpoint = config.vectorEndpoint
    vector.activeCollection = if (config.vectorActiveCollection == "") { "active" } else { config.vectorActiveCollection }
    vector.candidateCollection = if (config.vectorCandidateCollection == "") { "candidate" } else { config.vectorCandidateCollection }
    vector.dimensions = if (config.vectorDimensions <= 0) { 16 } else { config.vectorDimensions }
    vector.distance = if (config.vectorDistance == "") { "Cosine" } else { config.vectorDistance }
    vector.timeoutMillis = if (config.vectorTimeoutMillis <= 0) { 10000 } else { config.vectorTimeoutMillis }
    vector.retryCount = if (config.vectorRetryCount < 0) { 0 } else { config.vectorRetryCount }
    vector.apiKeyFile = config.vectorApiKeyFile
    vector.allowPrivateEndpoint = config.vectorAllowPrivateEndpoint
    vector
}

public class RuntimeUnavailableEmbeddingProvider <: EmbeddingProvider {
    private let config: EmbeddingConfig
    private let degradedReason: String

    public init(config: EmbeddingConfig, degradedReason: String) {
        this.config = config
        this.degradedReason = degradedReason
    }

    public func embed(texts: ArrayList<String>, model: String, dimensions: Int64): EmbeddingBatch {
        let batch = EmbeddingBatch()
        batch.requested = texts.size
        batch.batchSize = this.config.batchSize
        batch.status = this.status()
        batch.failed = texts.size
        batch
    }

    public func embedWithDeadline(texts: ArrayList<String>, model: String, dimensions: Int64, deadlineAtMillis: Int64): EmbeddingBatch {
        this.embed(texts, model, dimensions)
    }

    public func status(): EmbeddingStatus {
        let status = EmbeddingStatus()
        status.provider = this.config.provider
        status.model = this.config.model
        status.dimensions = this.config.dimensions
        status.endpointConfigured = this.config.endpoint != ""
        status.tokenConfigured = this.config.credentialPresent()
        status.batchSize = this.config.batchSize
        status.timeoutMillis = this.config.timeoutMillis
        status.retryCount = this.config.retryCount
        status.production = true
        status.state = EmbeddingProviderState.DEGRADED
        status.degradedReason = this.degradedReason
        status
    }
}

public class RuntimeUnavailableVectorStore <: VectorStore {
    private let config: RuntimeVectorStoreConfig
    private let degradedReason: String

    public init(config: RuntimeVectorStoreConfig, degradedReason: String) {
        this.config = config
        this.degradedReason = degradedReason
    }

    public func upsert(collection: String, vectors: ArrayList<VectorRecord>): VectorStoreStatus {
        this.status(collection)
    }

    public func upsertBatch(collection: String, vectors: ArrayList<VectorRecord>): VectorStoreStatus {
        this.status(collection)
    }

    public func upsertBatchWithDeadline(collection: String, vectors: ArrayList<VectorRecord>, deadlineAtMillis: Int64): VectorStoreStatus {
        this.status(collection)
    }

    public func search(collection: String, queryVector: ArrayList<Float64>, filters: VectorSearchFilters, topK: Int64): ArrayList<VectorSearchResult> {
        ArrayList<VectorSearchResult>()
    }

    public func status(collection: String): VectorStoreStatus {
        let status = VectorStoreStatus()
        status.backend = this.config.backend
        status.collection = collection
        status.activeCollection = this.config.activeCollection
        status.candidateCollection = this.config.candidateCollection
        status.dimension = this.config.dimensions
        status.count = 0
        status.state = EmbeddingProviderState.DEGRADED
        status.degradedReason = this.degradedReason
        status
    }

    public func clear(collection: String): VectorStoreStatus {
        this.status(collection)
    }

    public func deleteCollection(collection: String): VectorStoreStatus {
        this.status(collection)
    }

    public func ensureReadyCollection(collection: String): VectorStoreStatus {
        this.status(collection)
    }

    public func recreate(collection: String, vectors: ArrayList<VectorRecord>): VectorStoreStatus {
        this.status(collection)
    }

    public func recreateWithDeadline(collection: String, vectors: ArrayList<VectorRecord>, deadlineAtMillis: Int64): VectorStoreStatus {
        this.status(collection)
    }

    public func backup(collection: String): VectorBackup {
        let backup = VectorBackup()
        backup.collection = collection
        backup.valid = false
        backup.diagnostic = this.degradedReason
        backup
    }

    public func backupWithDeadline(collection: String, deadlineAtMillis: Int64): VectorBackup {
        this.backup(collection)
    }

    public func lookupBatchWithDeadline(collection: String, pointIds: ArrayList<String>, deadlineAtMillis: Int64): VectorLookupResult {
        let result = VectorLookupResult()
        result.requested = pointIds.size
        result.status = this.degradedReason
        result.diagnostic = this.degradedReason
        result
    }

    public func restore(backup: VectorBackup): VectorStoreStatus {
        this.status(backup.collection)
    }
}

public class RuntimeOllamaEmbeddingHttpExecutor <: OllamaEmbeddingHttpExecutor {
    private let executor: HttpRequestExecutor

    public init(executor: HttpRequestExecutor) {
        this.executor = executor
    }

    public func execute(request: OllamaEmbeddingHttpRequest): OllamaEmbeddingHttpResponse {
        let http = HttpExecutionRequest()
        http.method = request.method
        http.url = request.url
        http.accept = request.accept
        http.contentType = request.contentType
        http.body = request.body
        http.timeoutMillis = request.timeoutMillis
        http.retryCount = request.retryCount
        for (header in request.headers) {
            http.headers.add(header)
        }
        let response = this.executor.execute(http)
        let out = OllamaEmbeddingHttpResponse()
        out.statusCode = response.statusCode
        out.body = response.body
        out.contentType = response.contentType
        out.status = response.status
        out.retryAfterSeconds = response.retryAfterSeconds
        out.transportErrorClass = response.transportErrorClass
        out.transportDiagnostic = response.transportDiagnostic
        out
    }
}

private func endpointLooksPrivate(endpoint: String): Bool {
    let lower = endpoint.trimAscii().toAsciiLower()
    lower.startsWith("http://127.") || lower.startsWith("https://127.") || lower.startsWith("http://localhost") || lower.startsWith("https://localhost") || lower.startsWith("http://[::1]") || lower.startsWith("https://[::1]") || lower.startsWith("http://10.") || lower.startsWith("https://10.") || lower.startsWith("http://192.168.") || lower.startsWith("https://192.168.")
}

public func embeddingProviderFromRuntime(config: CkbRuntimeConfig): EmbeddingProvider {
    let embedding = embeddingConfigFromRuntime(config)
    if (embedding.provider == "deterministic" || embedding.provider == "local" || embedding.provider == "local-file") {
        embedding.provider = "deterministic"
        embedding.production = false
        embedding.configured = true
        return DeterministicEmbeddingProvider(embedding)
    }
    if (embedding.provider == "ollama") {
        embedding.production = true
        embedding.configured = embedding.model != "" && embedding.endpoint != "" && embedding.dimensions > 0
        if (endpointLooksPrivate(embedding.endpoint) && !config.embeddingAllowPrivateEndpoint) {
            return RuntimeUnavailableEmbeddingProvider(embedding, "embedding_private_endpoint_not_allowed")
        }
        if (!embedding.configured) {
            return RuntimeUnavailableEmbeddingProvider(embedding, "ollama_embedding_missing_config")
        }
        let httpExecutor = NativeHttpRequestExecutor(ckbNativeHttpAdapterConfigFromRuntime(config, config.embeddingAllowPrivateEndpoint))
        return OllamaEmbeddingProvider(embedding, executor: RuntimeOllamaEmbeddingHttpExecutor(httpExecutor))
    }
    if (embedding.provider != "production-http") {
        embedding.production = true
        embedding.configured = false
        return RuntimeUnavailableEmbeddingProvider(embedding, "unsupported_provider")
    }
    ProductionEmbeddingProvider(embedding)
}

private func qdrantVectorStoreConfigFromRuntime(config: CkbRuntimeConfig, vector: RuntimeVectorStoreConfig): QdrantVectorStoreConfig {
    let qdrant = QdrantVectorStoreConfig()
    qdrant.endpoint = vector.endpoint
    qdrant.dimensions = vector.dimensions
    qdrant.distance = vector.distance
    qdrant.timeoutMillis = vector.timeoutMillis
    qdrant.retryCount = vector.retryCount
    if (vector.apiKeyFile != "") {
        let loaded = readCredentialFile(vector.apiKeyFile)
        if (loaded.status == "ok") {
            qdrant.apiKey = loaded.value
        }
    }
    qdrant
}

public func vectorStoreFromRuntime(config: CkbRuntimeConfig): VectorStore {
    let vector = vectorStoreConfigFromRuntime(config)
    let embedding = embeddingConfigFromRuntime(config)
    let backend = vector.backend
    if (backend == "local-file" || backend == "local" || backend == "deterministic" || backend == "") {
        return LocalVectorStore()
    }
    if (backend == "qdrant") {
        if (endpointLooksPrivate(vector.endpoint) && !vector.allowPrivateEndpoint) {
            return RuntimeUnavailableVectorStore(vector, "vector_private_endpoint_not_allowed")
        }
        if (vector.endpoint == "" || vector.dimensions <= 0 || vector.distance == "") {
            return RuntimeUnavailableVectorStore(vector, "qdrant_vector_missing_config")
        }
        if (cangjieRuntimeVectorDimensionMismatch(embedding, vector)) {
            return RuntimeUnavailableVectorStore(vector, "embedding_vector_dimension_mismatch")
        }
        let httpExecutor = NativeHttpRequestExecutor(ckbNativeHttpAdapterConfigFromRuntime(config, vector.allowPrivateEndpoint))
        return QdrantVectorStore(qdrantVectorStoreConfigFromRuntime(config, vector), executor: httpExecutor)
    }
    RuntimeUnavailableVectorStore(vector, "unsupported_vector_backend")
}

private func cangjieRuntimeVectorDimensionMismatch(embedding: EmbeddingConfig, vector: RuntimeVectorStoreConfig): Bool {
    embedding.dimensions > 0 && vector.dimensions > 0 && embedding.dimensions != vector.dimensions
}

public func newKnowledgeBaseFromStoreWithRuntime(store: FileKnowledgeStore, config: CkbRuntimeConfig): KnowledgeBaseLoadResult {
    let kb = KnowledgeBase(FakeClock(0), embeddingProviderFromRuntime(config), vectorStoreFromRuntime(config), LocalGraphStore())
    kb.configureVectorCollections(config.vectorActiveCollection, config.vectorCandidateCollection)
    let result = KnowledgeBaseLoadResult(kb)
    let snapshot = store.loadActiveSnapshot()
    if (kb.restoreActiveSnapshot(snapshot)) {
        kb.restoreScheduler(store.loadScheduler())
        result.source = "persisted"
        result.diagnostic = snapshot.diagnostic
        return result
    }
    if (store.hasAuthoritativeActiveSnapshotPointer()) {
        kb.markPersistedSnapshotInvalid(snapshot.diagnostic)
        kb.restoreScheduler(store.loadScheduler())
        result.source = "persisted_invalid"
        result.diagnostic = snapshot.diagnostic
        return result
    }
    kb.bootstrapOffline()
    kb.restoreScheduler(store.loadScheduler())
    result.source = "offline_baseline"
    result.diagnostic = snapshot.diagnostic
    return result
}

private func liveApplyOptionsFromSync(options: LiveSyncOptions): LiveApplyOptions {
    let out = LiveApplyOptions()
    out.apply = options.apply
    out.maxRepos = options.maxRepos
    out.maxFilesPerRepo = options.maxFilesPerRepo
    out.maxItems = options.maxItems
    out.since = options.since
    out.simulateValidationFailure = options.simulateValidationFailure
    out
}

private func limitedPlan(plan: SourceSyncPlan, options: LiveApplyOptions): SourceSyncPlan {
    let out = SourceSyncPlan()
    var repos: Int64 = 0
    var filesByRepo: ArrayList<String> = ArrayList<String>()
    for (request in plan.requests) {
        if (options.maxItems >= 0 && out.requests.size >= options.maxItems) {
            out.truncated = true
            continue
        }
        if (request.kind == SourceKinds.GITCODE_ORG || request.kind == SourceKinds.GITCODE_REPO || request.kind == SourceKinds.GITCODE_SOURCE || request.kind == SourceKinds.GITCODE_ISSUE_HISTORY || request.kind == SourceKinds.GITCODE_PR_HISTORY) {
            if (request.repo != "" && !repoSeen(out, request.repo)) {
                if (options.maxRepos >= 0 && repos >= options.maxRepos) {
                    out.truncated = true
                    continue
                }
                repos += 1
            }
        }
        if (request.kind == SourceKinds.GITCODE_SOURCE) {
            let key = request.repo
            let current = countMatches(filesByRepo, key)
            if (options.maxFilesPerRepo >= 0 && current >= options.maxFilesPerRepo) {
                out.truncated = true
                continue
            }
            filesByRepo.add(key)
        }
        out.requests.add(request)
    }
    out
}

private func vectorToLine(vector: ArrayList<Float64>): String {
    var out = ""
    for (i in 0..vector.size) {
        if (i > 0) {
            out += ","
        }
        out += "${vector[i]}"
    }
    out
}

private func parseVectorValues(raw: String): ArrayList<Float64> {
    let out = ArrayList<Float64>()
    for (value in raw.split(",")) {
        let trimmed = value.trimAscii()
        if (trimmed == "") {
            continue
        }
        out.add(try { Float64.parse(trimmed) } catch (_: Exception) { 0.0 })
    }
    out
}

private func repoSeen(plan: SourceSyncPlan, repo: String): Bool {
    for (request in plan.requests) {
        if (request.repo == repo && (request.kind == SourceKinds.GITCODE_ORG || request.kind == SourceKinds.GITCODE_REPO || request.kind == SourceKinds.GITCODE_SOURCE || request.kind == SourceKinds.GITCODE_ISSUE_HISTORY || request.kind == SourceKinds.GITCODE_PR_HISTORY)) {
            return true
        }
    }
    false
}

private func countMatches(values: ArrayList<String>, value: String): Int64 {
    var count: Int64 = 0
    for (entry in values) {
        if (entry == value) {
            count += 1
        }
    }
    count
}

private func authHeaderForRequest(config: CkbRuntimeConfig, request: SourceFetchRequest): GitCodeAuthResolution {
    if (isInvalidSourceRequest(request)) {
        return GitCodeAuthResolution()
    }
    if (!isGitCodeRequest(request)) {
        return GitCodeAuthResolution()
    }
    config.gitCodeAuth()
}

private func authSummaryForRequest(config: CkbRuntimeConfig, request: SourceFetchRequest): GitCodeAuthResolution {
    if (isInvalidSourceRequest(request)) {
        return GitCodeAuthResolution()
    }
    if (!isGitCodeRequest(request)) {
        return GitCodeAuthResolution()
    }
    config.gitCodeAuthSummary()
}

private func isGitCodeRequest(request: SourceFetchRequest): Bool {
    request.kind == SourceKinds.GITCODE_ORG || request.kind == SourceKinds.GITCODE_REPO || request.kind == SourceKinds.GITCODE_BRANCH || request.kind == SourceKinds.GITCODE_TREE || request.kind == SourceKinds.GITCODE_SOURCE || request.kind == SourceKinds.GITCODE_ISSUE_HISTORY || request.kind == SourceKinds.GITCODE_PR_HISTORY || request.kind == SourceKinds.GITCODE_COMMENT_HISTORY
}

private func ingestLiveFetch(kb: KnowledgeBase, request: SourceFetchRequest, fetch: SourceFetchResult, index: Int64): Unit {
    if (request.kind == SourceKinds.GITCODE_ORG) {
        kb.ingestFetchResult("live-org-${safeName(request.repo)}", SourceTypes.COMMUNITY, fetch, "GitCode ${request.repo} org", TrustLevels.COMMUNITY, ReviewStates.REVIEWED)
    } else if (request.kind == SourceKinds.GITCODE_REPO) {
        kb.ingestFetchResult("live-repo-${safeName(request.repo)}", SourceTypes.REPO, fetch, "GitCode ${request.repo} repo", TrustLevels.OFFICIAL, ReviewStates.TRUSTED)
    } else if (request.kind == SourceKinds.GITCODE_BRANCH) {
        kb.ingestFetchResult("live-branch-${safeName(request.repo)}-${safeName(request.ref)}", SourceTypes.REPO, fetch, "GitCode ${request.repo} branch", TrustLevels.OFFICIAL, ReviewStates.TRUSTED)
    } else if (request.kind == SourceKinds.GITCODE_TREE) {
        kb.ingestFetchResult("live-tree-${safeName(request.repo)}", SourceTypes.REPO, fetch, "GitCode ${request.repo} tree", TrustLevels.OFFICIAL, ReviewStates.TRUSTED)
    } else if (request.kind == SourceKinds.GITCODE_SOURCE) {
        kb.ingestFetchResult("live-source-${safeName(request.repo)}-${safeName(request.path)}", SourceTypes.REPO, fetch, "GitCode ${request.repo} source", TrustLevels.OFFICIAL, ReviewStates.TRUSTED)
    } else if (request.kind == SourceKinds.GITCODE_ISSUE_HISTORY) {
        kb.ingestFetchResult("live-issue-${safeName(request.repo)}", SourceTypes.COMMUNITY, fetch, "GitCode issue history", TrustLevels.COMMUNITY, ReviewStates.REVIEWED)
    } else if (request.kind == SourceKinds.GITCODE_PR_HISTORY) {
        kb.ingestFetchResult("live-pr-${safeName(request.repo)}", SourceTypes.COMMUNITY, fetch, "GitCode PR history", TrustLevels.COMMUNITY, ReviewStates.REVIEWED)
    } else if (request.kind == SourceKinds.GITCODE_COMMENT_HISTORY) {
        kb.ingestFetchResult("live-comments-${safeName(request.repo)}", SourceTypes.COMMUNITY, fetch, "GitCode comment history", TrustLevels.COMMUNITY, ReviewStates.REVIEWED)
    } else if (request.kind == SourceKinds.CANGJIE_DOCS) {
        kb.ingestFetchResult("live-docs-${index}", SourceTypes.DOC, fetch, "Cangjie docs", TrustLevels.OFFICIAL, ReviewStates.TRUSTED)
    } else if (request.kind == SourceKinds.CANGJIE_WEBSITE) {
        kb.ingestFetchResult("live-website-${index}", SourceTypes.WEBSITE, fetch, "Cangjie website", TrustLevels.OFFICIAL, ReviewStates.TRUSTED)
    } else if (request.kind == SourceKinds.WEB_CANDIDATE) {
        kb.ingestFetchResult("live-web-candidate-${index}", SourceTypes.WEB_CANDIDATE, fetch, "Web candidate", TrustLevels.WEB_CANDIDATE, ReviewStates.CANDIDATE)
    }
}

private func metadataLine(metadata: KnowledgeMetadata): String {
    "${escapeField(metadata.sourceType)}|${escapeField(metadata.sourceUrl)}|${escapeField(metadata.repo)}|${escapeField(metadata.commit)}|${escapeField(metadata.path)}|${escapeField(metadata.symbol)}|${escapeField(metadata.docVersion)}|${escapeField(metadata.crawlAt)}|${escapeField(metadata.indexedAt)}|${escapeField(metadata.knowledgeVersion)}|${escapeField(metadata.candidateVersion)}|${metadata.contentSize}|${escapeField(metadata.trustLevel)}|${escapeField(metadata.reviewState)}|${escapeField(metadata.license)}|${escapeField(metadata.sourceId)}|${escapeField(metadata.repoVisibility)}|${escapeField(metadata.targetVersion)}|${escapeField(metadata.sourceSet)}|${escapeField(metadata.versionResolutionId)}|${metadataDerivedFromLine(metadata.derivedFrom)}"
}

private func metadataFromParts(parts: Array<String>, start: Int64): KnowledgeMetadata {
    let metadata = KnowledgeMetadata()
    metadata.sourceType = unescapeField(parts[start])
    metadata.sourceUrl = unescapeField(parts[start + 1])
    metadata.repo = unescapeField(parts[start + 2])
    metadata.commit = unescapeField(parts[start + 3])
    metadata.path = unescapeField(parts[start + 4])
    metadata.symbol = unescapeField(parts[start + 5])
    metadata.docVersion = unescapeField(parts[start + 6])
    metadata.crawlAt = unescapeField(parts[start + 7])
    metadata.indexedAt = unescapeField(parts[start + 8])
    metadata.knowledgeVersion = unescapeField(parts[start + 9])
    metadata.candidateVersion = unescapeField(parts[start + 10])
    metadata.contentSize = try { Int64.parse(parts[start + 11]) } catch (_: Exception) { 0 }
    metadata.trustLevel = unescapeField(parts[start + 12])
    metadata.reviewState = unescapeField(parts[start + 13])
    metadata.license = unescapeField(parts[start + 14])
    if (parts.size > start + 15) {
        metadata.sourceId = unescapeField(parts[start + 15])
    }
    if (parts.size > start + 16) {
        metadata.repoVisibility = unescapeField(parts[start + 16])
    }
    if (parts.size > start + 17) {
        metadata.targetVersion = unescapeField(parts[start + 17])
    }
    if (parts.size > start + 18) {
        metadata.sourceSet = unescapeField(parts[start + 18])
    }
    if (parts.size > start + 19) {
        metadata.versionResolutionId = unescapeField(parts[start + 19])
    }
    if (parts.size > start + 20) {
        let derivedFrom = ckbMetadataDerivedFromDecode(parts[start + 20])
        if (derivedFrom.valid) {
            metadata.derivedFrom = derivedFrom.values.toArray()
        }
    }
    metadata
}

private func metadataDerivedFromLine(values: Array<String>): String {
    let out = StringBuilder()
    out.append("${values.size}:")
    for (index in 0..values.size) {
        if (index > 0) { out.append(",") }
        let bytes = values[index].toArray()
        if (bytes.size == 0) {
            out.append("-")
        } else {
            for (byte in bytes) {
                out.append(metadataHexNibble(byte / UInt8(16)))
                out.append(metadataHexNibble(byte % UInt8(16)))
            }
        }
    }
    out.toString()
}

class CkbMetadataDerivedFromDecodeResult {
    var valid: Bool = false
    var status: String = "metadata_derived_not_decoded"
    var values: ArrayList<String> = ArrayList<String>()

    init() {}
}

func ckbMetadataDerivedFromDecode(
    value: String): CkbMetadataDerivedFromDecodeResult {
    let result = CkbMetadataDerivedFromDecodeResult()
    let separator = findText(value, ":")
    if (separator <= 0) {
        result.status = "metadata_derived_separator_missing"
        return result
    }
    let expected = parseIntField(value[0..separator], -1)
    if (expected < 0) {
        result.status = "metadata_derived_count_invalid"
        return result
    }
    let payload = value[separator + 1..value.size]
    if (expected == 0) {
        result.valid = payload == ""
        result.status = if (result.valid) {
            "metadata_derived_valid"
        } else { "metadata_derived_zero_count_payload_present" }
        return result
    }
    let items = payload.split(",")
    if (items.size != expected) {
        result.status = "metadata_derived_count_mismatch"
        return result
    }
    for (item in items) {
        if (item == "-") { result.values.add(""); continue }
        if (item.size == 0 || item.size % 2 != 0) {
            result.status = "metadata_derived_hex_invalid"
            result.values.clear()
            return result
        }
        let bytes = ArrayList<Byte>()
        var index: Int64 = 0
        while (index < item.size) {
            let high = metadataHexValue(item[index])
            let low = metadataHexValue(item[index + 1])
            if (high < 0 || low < 0) {
                result.status = "metadata_derived_hex_invalid"
                result.values.clear()
                return result
            }
            bytes.add(UInt8(high * 16 + low))
            index += 2
        }
        let decoded = try {
            String.fromUtf8(bytes.toArray())
        } catch (_: Exception) {
            result.status = "metadata_derived_invalid_response_encoding"
            result.values.clear()
            return result
        }
        result.values.add(decoded)
    }
    result.valid = true
    result.status = "metadata_derived_valid"
    result
}

private func metadataHexNibble(value: UInt8): String {
    if (value < UInt8(10)) { return "${value}" }
    if (value == UInt8(10)) { return "a" }; if (value == UInt8(11)) { return "b" }
    if (value == UInt8(12)) { return "c" }; if (value == UInt8(13)) { return "d" }
    if (value == UInt8(14)) { return "e" }
    "f"
}

private func metadataHexValue(value: UInt8): Int64 {
    if (value >= UInt8(48) && value <= UInt8(57)) {
        return Int64(value - UInt8(48))
    }
    if (value >= UInt8(97) && value <= UInt8(102)) {
        return Int64(value - UInt8(97)) + 10
    }
    -1
}

private func publicRecordCitation(record: RawRecord): String {
    if (record.metadata.sourceType == SourceTypes.REPO) {
        return "${record.metadata.repo}:${record.metadata.path}#${record.metadata.symbol}"
    }
    if (record.metadata.sourceType == SourceTypes.COMMUNITY) {
        return "${record.metadata.repo}:${record.metadata.sourceUrl}"
    }
    record.metadata.sourceUrl
}

private func safeName(raw: String): String {
    raw.replace("/", "_").replace("\\", "_").replace(":", "_").replace("..", "_")
}

private func escapeField(raw: String): String {
    raw.replace("\\", "\\\\").replace("|", "\\p").replace("\n", "\\n").replace("\r", "\\r")
}

private func unescapeField(raw: String): String {
    let input = raw.toArray()
    let output = ArrayList<Byte>()
    var index: Int64 = 0
    while (index < input.size) {
        if (input[index] != UInt8(92) || index + 1 >= input.size) {
            output.add(input[index])
            index += 1
            continue
        }
        let escaped = input[index + 1]
        if (escaped == UInt8(92)) { output.add(UInt8(92)) }
        else if (escaped == UInt8(110)) { output.add(UInt8(10)) }
        else if (escaped == UInt8(114)) { output.add(UInt8(13)) }
        else if (escaped == UInt8(112)) { output.add(UInt8(124)) }
        else { output.add(UInt8(92)); output.add(escaped) }
        index += 2
    }
    try { String.fromUtf8(output.toArray()) } catch (_: Exception) { raw }
}

private func findText(raw: String, needle: String): Int64 {
    if (needle == "") {
        return 0
    }
    if (!raw.contains(needle)) {
        return -1
    }
    raw.split(needle)[0].size
}

