    private func graphNodeLine(node: GraphNode): String {
        "${escapeField(node.nodeId)}|${escapeField(node.nodeType)}|${escapeField(node.label)}|${escapeField(node.sourceId)}|${escapeField(node.knowledgeVersion)}\n"
    }

    private func graphEdgeLine(edge: GraphEdge): String {
        "${escapeField(edge.edgeId)}|${escapeField(edge.edgeType)}|${escapeField(edge.fromNodeId)}|${escapeField(edge.toNodeId)}|${escapeField(edge.sourceId)}|${escapeField(edge.knowledgeVersion)}\n"
    }

    private func writeGraphNodesAtomically(relative: String, nodes: ArrayList<GraphNode>, deadlineAtMillis: Int64, progressStage: String): Unit {
        this.ensureLayout()
        let path = this.root.join(relative)
        if (!exists(path.parent)) {
            Directory.create(path.parent, recursive: true)
        }
        let tmp = this.atomicTmpPath(path, relative)
        try (file = File(tmp, OpenMode.Write)) {
            var written: Int64 = 0
            for (node in nodes) {
                if (written % 512 == 0) {
                    this.ensureActiveSnapshotDeadline("${progressStage}:${written}:${nodes.size}", deadlineAtMillis)
                }
                file.write(this.graphNodeLine(node).toArray())
                written += 1
            }
        }
        this.replaceFileWithTmp(path, tmp)
    }

    private func writeGraphEdgesAtomically(relative: String, edges: ArrayList<GraphEdge>, deadlineAtMillis: Int64, progressStage: String): Unit {
        this.ensureLayout()
        let path = this.root.join(relative)
        if (!exists(path.parent)) {
            Directory.create(path.parent, recursive: true)
        }
        let tmp = this.atomicTmpPath(path, relative)
        try (file = File(tmp, OpenMode.Write)) {
            var written: Int64 = 0
            for (edge in edges) {
                if (written % 512 == 0) {
                    this.ensureActiveSnapshotDeadline("${progressStage}:${written}:${edges.size}", deadlineAtMillis)
                }
                file.write(this.graphEdgeLine(edge).toArray())
                written += 1
            }
        }
        this.replaceFileWithTmp(path, tmp)
    }

    private func indexManifestLines(manifest: IndexManifest): String {
        var out = "indexManifestActive=${manifest.activeVersion}\n"
        out += "indexManifestCandidate=${manifest.candidateVersion}\n"
        for (entry in manifest.entries) {
            out += "index ${entry.kind}|${entry.version}|${entry.itemCount}|${entry.deterministic}|${entry.candidateIsolated}|${escapeField(entry.notes)}\n"
        }
        out
    }

    private func metadataLines(status: KnowledgeStatus): String {
        var text = "active=${status.activeKnowledgeVersion}\n"
        text += "candidate=${status.candidateKnowledgeVersion}\n"
        text += "failed=${status.failedCandidateVersion}\n"
        text += "activeStateSource=${status.activeStateSource}\n"
        text += "rawCount=${status.storage.rawCount}\n"
        text += "normalizedCount=${status.storage.normalizedCount}\n"
        text += "indexCount=${status.storage.indexCount}\n"
        text += "textIndexCount=${status.storage.textIndexCount}\n"
        text += "vectorIndexCount=${status.storage.vectorIndexCount}\n"
        text += "symbolIndexCount=${status.storage.symbolIndexCount}\n"
        text += "graphIndexCount=${status.storage.graphIndexCount}\n"
        text += "vectorBackend=${status.storage.vectorBackend}\n"
        text += "vectorState=${status.storage.vectorState}\n"
        text += "vectorCollection=${status.storage.vectorCollection}\n"
        text += "vectorActiveCollection=${status.storage.vectorActiveCollection}\n"
        text += "vectorCandidateCollection=${status.storage.vectorCandidateCollection}\n"
        text += "vectorDimension=${status.storage.vectorDimension}\n"
        text += "vectorDegradedReason=${escapeField(status.storage.vectorDegradedReason)}\n"
        text += "graphBackend=${status.storage.graphBackend}\n"
        text += "graphState=${status.storage.graphState}\n"
        text += "graphNodeCount=${status.storage.graphNodeCount}\n"
        text += "graphEdgeCount=${status.storage.graphEdgeCount}\n"
        text + this.indexManifestLines(status.indexManifest)
    }

    private func newActiveSnapshotTxId(activeVersion: String): String {
        let nowMillis = this.activeSnapshotTxClock.nowMillis()
        while (true) {
            this.atomicTmpSequence += 1
            let identity = "${activeVersion}|${nowMillis}|${this.atomicTmpSequence}"
            let txId = "${safeName(activeVersion)}-${nowMillis}-${stableSummaryHash(identity)}"
            if (!this.has("transactions/${safeName(txId)}")) { return txId }
        }
        ""
    }

    private func activeSnapshotCommitLines(txId: String, status: KnowledgeStatus,
        result: CkbActiveSnapshotTransactionResult): String {
        var text = "schema=ckb-active-commit-v2\n"
        text += "txId=${txId}\n"
        text += "active=${status.activeKnowledgeVersion}\n"
        text += "vectorActiveCollection=${status.storage.vectorActiveCollection}\n"
        text += "companionMode=${result.companionMode}\n"
        text += "persistVectorFile=${result.persistVectorFile}\n"
        text += "payloadHash=${result.payloadHash}\n"
        text += "manifestHash=${result.manifestHash}\n"
        text += "freshnessHash=${result.freshnessHash}\n"
        text += "coverageHash=${result.coverageHash}\n"
        text += "committed=true\n"
        text
    }

    private func activeSnapshotManifestLines(txId: String, status: KnowledgeStatus,
        result: CkbActiveSnapshotTransactionResult): String {
        var text = "schema=ckb-active-pointer-v2\n"
        text += "txId=${txId}\n"
        text += "active=${status.activeKnowledgeVersion}\n"
        text += "vectorActiveCollection=${status.storage.vectorActiveCollection}\n"
        text += "companionMode=${result.companionMode}\n"
        text += "manifestHash=${result.manifestHash}\n"
        text += "freshnessHash=${result.freshnessHash}\n"
        text += "coverageHash=${result.coverageHash}\n"
        text += "committed=true\n"
        text
    }

    private func activeSnapshotCommitSidecarLines(txId: String, status: KnowledgeStatus, vectorCollection: String, activeCount: Int64, vectorCount: Int64, persistVectorFile: Bool, result: CkbActiveSnapshotTransactionResult): String {
        var text = "schema=ckb-active-commit-sidecar-v2\n"
        text += "txId=${escapeField(txId)}\n"
        text += "active=${escapeField(status.activeKnowledgeVersion)}\n"
        text += "vectorActiveCollection=${escapeField(status.storage.vectorActiveCollection)}\n"
        text += "vectorCollection=${escapeField(vectorCollection)}\n"
        text += "activeCount=${activeCount}\n"
        text += "vectorCount=${vectorCount}\n"
        text += "persistVectorFile=${persistVectorFile}\n"
        text += "companionMode=${result.companionMode}\n"
        text += "payloadHash=${result.payloadHash}\n"
        text += "manifestHash=${result.manifestHash}\n"
        text += "freshnessHash=${result.freshnessHash}\n"
        text += "coverageHash=${result.coverageHash}\n"
        text += "pointerCommitted=${result.pointerCommitted}\n"
        text += "liveShadowConsistent=${result.liveShadowConsistent}\n"
        text += "committed=true\n"
        text
    }
}

