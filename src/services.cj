private func singleRawRecord(record: RawRecord): ArrayList<RawRecord> {
    let records = ArrayList<RawRecord>()
    records.add(record)
    records
}

public class Normalizer {
    public init() {}

    public func normalize(record: RawRecord, indexedAt: String, knowledgeVersion: String): NormalizedRecord {
        let normalized = NormalizedRecord()
        normalized.sourceId = record.sourceId
        normalized.title = record.title
        normalized.chunk = record.content.trimAscii()
        record.metadata.indexedAt = indexedAt
        record.metadata.knowledgeVersion = knowledgeVersion
        normalized.metadata = record.metadata
        normalized.requiresReview = record.requiresReview || record.metadata.reviewState == ReviewStates.CANDIDATE
        normalized.citation = publicRecordCitation(record)
        normalized
    }
}

public class IndexBuildResult {
    public var ok: Bool = false
    public var activeVersion: String = ""
    public var candidateVersion: String = ""
    public var failedVersion: String = ""
    public var count: Int64 = 0
    public var lastStage: String = ""
    public var lastProgress: String = ""

    public init() {}
}

public class IndexBuilder {
    public init() {}

    public func rebuild(records: ArrayList<NormalizedRecord>, activeVersion: String, candidateVersion: String, fail!: Bool = false): IndexBuildResult {
        let result = IndexBuildResult()
        result.activeVersion = activeVersion
        result.candidateVersion = candidateVersion
        if (records.size == 0 || fail) {
            result.ok = false
            result.failedVersion = candidateVersion
            return result
        }
        result.ok = true
        result.activeVersion = candidateVersion.replace("-candidate", "-active")
        result.count = records.size
        result
    }
}

public class QueryService {
    private let kb: KnowledgeBase

    public init(kb: KnowledgeBase) {
        this.kb = kb
    }

    public func query(mode: String, text: String, budget: Int64, trustLevel!: String = "", reviewState!: String = "", includeCandidates!: Bool = false): SearchResult {
        let options = SearchOptions()
        options.budget = budget
        options.trustLevel = trustLevel
        options.reviewState = reviewState
        options.includeCandidates = includeCandidates
        match (mode) {
            case "source" => options.sourceType = SourceTypes.REPO
            case "doc" => options.sourceType = SourceTypes.DOC
            case "website" => options.sourceType = SourceTypes.WEBSITE
            case "web_candidate" =>
                options.sourceType = SourceTypes.WEB_CANDIDATE
                options.includeCandidates = true
            case _ => ()
        }
        this.kb.search(text, options)
    }

    public func evidence(text: String, budget: Int64, includeCandidates!: Bool = true): EvidencePack {
        if (includeCandidates) {
            return this.kb.evidencePack(text, budget)
        }
        let pack = this.kb.evidencePack(text, budget)
        pack.webCandidateEvidence.clear()
        pack
    }

    public func status(): KnowledgeStatus {
        this.kb.status()
    }
}

public class CkbSchema {
    public static func mcpTools(): String {
        let tools = joinStrings(ckbMcpToolNames(), ",")
        let inputs = "cangjie_knowledge_pack{task,targetVersion=1.0.0,budget<=20,includeExamples,includeAntiPatterns,legacy_endpoint_degraded=true}, cangjie_version_resolve{targetVersion,sourceSet,sourceFamily,sourceRepo,sourceRef,refKind,versionPolicy=default|exact,includePrerelease=false}, cangjie_task_knowledge_pack{taskId,benchmark,taskText,signature,imports,argTypes,returnType,expectedKnowledgeTags,starterCodeExcerpt,compilerOutput,targetVersion,sourceSet,sourceRef,versionPolicy,budget<=20}, cangjie_knowledge_coverage{same fields as cangjie_task_knowledge_pack}, cangjie_compile_diagnose_v2{code,compilerOutput,context,targetVersion,budget<=20,executed=false}, cangjie_symbol_lookup{symbol,module,sourceSet,targetVersion,budget<=20}, cangjie_doc_section{sectionId,path,heading,targetVersion,budget<=20}, cangjie_corpus_freshness{readOnly=true}, cangjie_tool_manual{tool,command,targetVersion,budget<=20}, cangjie_negative_rules{q,query,targetVersion,budget<=20}, cangjie_api_search{q,module,symbol,sourceSet,targetVersion,budget<=20}, cangjie_syntax_query{q,targetVersion,budget<=20}, cangjie_cookbook{task,constraints,targetVersion,style,budget<=20}, cangjie_diagnose{code,compilerOutput,context,targetVersion,budget<=20,executed=false}, cangjie_examples{q,module,symbol,maxExamples<=20}, cangjie_corpus_status{readOnly=true}"
        let adminRoutes = "POST /v1/admin/scheduler/run,POST /v1/admin/vector/bootstrap,POST /v1/admin/vector/clean-derived,POST /v1/admin/vector/reconcile,POST /v1/admin/repositories/sync,POST /v1/admin/repo-list/refresh,POST /v1/admin/initialize,POST /v1/admin/sync,POST /v1/admin/rebuild"
        let legacyCommands = "health,status,query,evidence,source_analysis{repo,ref,query,issueUrl,prUrl,changedFiles,candidatePaths,allowCloneFallback,maxFiles,maxBytes,timeoutMillis},sync,rebuild,vector-bootstrap,vector-clean-derived,vector-reconcile,scheduler-run"
        "ordinaryMcpReadOnlyTools: ${tools}; mcpTransports=stdio,streamable-http mcpEndpoint=/mcp mcpProtocolVersions=2024-11-05,2025-06-18 mcpSse=true; apiVersion=ckb-http-v1 envelope={ok,apiVersion,data|error,diagnostics}; input: ${inputs}; httpAdminRoutes: ${adminRoutes}; httpEventRoutes: POST /v1/events/gitcode/repository-changed; legacyLocalCliCommands: ${legacyCommands}; liveGitCode: officialApi=https://api.gitcode.com/api/v5 authMode=token authHeader=private-token tokenFile=tokenFile tokenFileFormat=single PAT line without token/Bearer/PRIVATE-TOKEN prefix; sourceAnalysis: defaultEnabled=false workspaceRoot=TMPDIR-or-tmp/ckb-source-analysis publicOnly=true cloneHostAllowlist=gitcode.com cleanup=default; acceptance: schema -> doctor/status -> anonymous dry-run -> credentialed dry-run if needed -> limited apply -> vector-bootstrap -> rebuild-index -> status/evidence -> source_analysis fake/public repo; output: ok,status,errorCode,interfaceId,contentFamily,updateMechanism,activeKnowledgeVersion,knowledgeVersion,targetVersion,versionResolution,versionResolutionId,queryPlan,coverage,matchedItems,requiredKnowledge,citations,evidenceHash,provenance,evidence,requiresReview,triggerReasons,sourceAcquisition,filesRead,cleanupStatus,truncated,degraded,transportDiagnostic,scheduledProfiles; boundary: MCP JSON-RPC server exposes only read-only Cangjie tools/resources/prompts through stdio and /mcp; cangjie diagnose is knowledge-only; cangjie compile_diagnose_v2 is query-plan only and does not execute code; verify-snippet/admin/update/repository sync/event tools are not exposed to ordinary MCP clients; redaction: never returns tokenRef,tokenFile contents,PRIVATE-TOKEN,Authorization,Cookie,private-token values,absolute local paths; errors: ckb.bad_request,ckb.unauthorized,ckb.not_found,ckb.network_disabled,ckb.auth_degraded,ckb.rate_limited,ckb.source_unavailable,ckb.rebuild_failed,ckb.validation_failed,ckb.invalid_workspace_root,ckb.invalid_clone_host,version_not_resolved,unsupported_source_set"
    }

    public static func httpLikeRoutes(): String {
        "routes: STDIO ckb-stdio-v1 health,status,metrics,query <text>,evidence <text>,source_analysis repo=<owner/repo> ref=<ref> path=<path> query=<text> allowCloneFallback=<bool>,sync,cangjie_initialize,rebuild,vector-bootstrap,vector-clean-derived,vector-reconcile,scheduler-run,backup <name>,restore <name>,restart,stop; MCP stdio command mcp-stdio; MCP Streamable HTTP GET /mcp -> text/event-stream SSE ready/keepalive, POST /mcp -> JSON-RPC request JSON response or notification 202 empty, DELETE /mcp -> session close 202; legacy HTTP-like aliases GET /health -> ok,status,activeKnowledgeVersion,degraded; GET /status -> storage,indexManifest,scheduler,activeKnowledgeVersion,restoreDiagnostic,authHeaderStrategy,sourceAnalysis; POST /query -> query,evidence,citations,knowledgeVersion; POST /evidence -> evidencePack,graphContext,citations,activeKnowledgeVersion; POST /sync -> dryRun|apply,candidateVersion,activeKnowledgeVersion,redactedSourceStatus,transportDiagnostic; POST /rebuild-index -> candidateVersion,activeKnowledgeVersion,count; JSON ckb-http-v1 envelope={ok,apiVersion,data|error,diagnostics}; GET /v1/health -> status,activeKnowledgeVersion,degraded,schedulerDegraded; GET /v1/status -> storage,indexManifest,scheduler,activeKnowledgeVersion,restoreDiagnostic,authHeaderStrategy,sourceAnalysis; GET /v1/schedules -> entries interval,nextRunAt,lastSuccessAt,failureCount,lastDurationMillis,lastRequestCount,lastUpdatedDataKinds; GET /v1/schema -> routes,tools,errorCodes,apiVersion,limits,mcpTransports,mcpEndpoint,mcpSse; GET /v1/cangjie/corpus/status -> docsUrls,stdSources,activeKnowledgeVersion; GET /v1/cangjie/llms.txt -> markdown,knowledgeVersion; GET /v1/cangjie/llms-full.txt -> markdown,knowledgeVersion; POST /v1/cangjie/knowledge-pack -> knowledgeVersion,targetVersion,items,apiItems,examples,citations,truncated,degraded,legacy_endpoint_degraded; POST /v1/cangjie/version/resolve -> targetVersion,versionResolutionId,sources,diagnostics; POST /v1/cangjie/task-knowledge-pack -> interfaceId,contentFamily,updateMechanism,versionResolution,queryPlan,coverage,diagnostics; POST /v1/cangjie/knowledge-coverage -> required,coveredCount,missingCount,coveragePass; POST /v1/cangjie/compile-diagnose-v2 -> interfaceId,contentFamily,updateMechanism,versionResolution,queryPlan,coverage,executed=false; POST /v1/cangjie/syntax-query -> interfaceId,contentFamily,updateMechanism,matchedItems,requiredKnowledge,queryPlan,coverage,citations,evidenceHash,provenance,syntaxItems; POST /v1/cangjie/api-search -> interfaceId,contentFamily,updateMechanism,matchedItems,requiredKnowledge,queryPlan,coverage,citations,evidenceHash,provenance,apiItems; POST /v1/cangjie/cookbook -> interfaceId,contentFamily,updateMechanism,matchedItems,requiredKnowledge,queryPlan,coverage,citations,evidenceHash,provenance,steps; POST /v1/cangjie/diagnose -> interfaceId,contentFamily,updateMechanism,matchedItems,requiredKnowledge,queryPlan,coverage,diagnostics,executed=false,citations,evidenceHash,provenance; POST /v1/cangjie/examples -> interfaceId,contentFamily,updateMechanism,matchedItems,requiredKnowledge,queryPlan,coverage,examples,citations,evidenceHash,provenance; POST /v1/cangjie/context-pack -> markdown,citations; POST /v1/query -> rows,citations,knowledgeVersion,truncated; POST /v1/evidence-pack -> evidencePack,graphContext,citations,knowledgeVersion; POST /v1/source-analysis -> analysisId,repo,ref,triggerReasons,sourceAcquisition,filesRead,citations,degraded,cleanupStatus; POST /v1/events/gitcode/repository-changed -> accepted|duplicate|rejected,dedupeKey,scheduledProfiles; POST /v1/admin/scheduler/run -> ran,succeeded,failed,degraded,details; POST /v1/admin/vector/bootstrap -> activeCollection,candidateCollection,diagnostics; POST /v1/admin/vector/clean-derived -> deletedFiles,plannedFiles,protectedFiles,diagnostics; POST /v1/admin/vector/reconcile -> activeRecords,rebuiltVectorCount,qdrantBeforeCount,qdrantAfterCount,diagnostics; POST /v1/admin/repositories/sync -> repo,profile,requestCount,updatedDataKinds,truncated,candidateVersion,activeKnowledgeVersion; POST /v1/admin/repo-list/refresh -> matchedPaths,repoCount,candidateRepoListVersion,activeRepoListVersion,diagnostics; POST /v1/admin/sync -> source status,candidateVersion,activeKnowledgeVersion,transportDiagnostic; POST /v1/admin/initialize -> dryRun,persisted,activeKnowledgeVersion,candidateKnowledgeVersion,validation,sources; POST /v1/admin/rebuild -> candidateVersion,activeKnowledgeVersion,count; planned_not_enabled: /v1/cangjie/verify-snippet; compatibility: CLI service/status/rebuild-index/source_analysis provide the canonical local protocol"
    }
}

public class CkbScheduleTaskProfile {
    public var enabled: Bool = false
    public var status: String = "unsupported"
    public var profile: String = ""
    public var networkGate: String = "network_required"
    public var candidateMode: String = "none"
    public var activeMutationPolicy: String = ""
    public var timeBudgetMillis: Int64 = 0
    public var bootstrapBudgetMillis: Int64 = 0
    public var fetchBudgetMillis: Int64 = 0
    public var ingestBudgetMillis: Int64 = 0
    public var vectorBudgetMillis: Int64 = 0
    public var validationBudgetMillis: Int64 = 0
    public var activeCommitBudgetMillis: Int64 = 0
    public var snapshotBudgetMillis: Int64 = 0
    public var proofBudgetMillis: Int64 = 0
    public var resultFlushBudgetMillis: Int64 = 0
    public var unallocatedSafetyMillis: Int64 = 0
    public var requestCount: Int64 = 0
    public var updateMechanismIds: ArrayList<String> = ArrayList<String>()
    public var updatedDataKinds: ArrayList<String> = ArrayList<String>()
    public var sourceFamilies: ArrayList<String> = ArrayList<String>()

    public init() {}
}

public func ckbSchedulerAllowlistTaskNames(): ArrayList<String> {
    let names = ArrayList<String>()
    names.add("community_repo_discovery_30d")
    names.add("docs_probe_30d")
    names.add("website_probe_weekly")
    names.add("website_full_weekly")
    names.add("web_candidate_weekly")
    names.add("web_candidate_recrawl_30d")
    names.add("weekly_full_rebuild")
    names.add("cangjie_version_branch_refresh")
    names.add("cangjie_freshness_daily")
    names.add("cangjie_docs_full_weekly")
    names.add("cangjie_release_full_sync")
    names.add("cangjie_source_event_sync")
    names.add("cangjie_benchmark_gap_curation")
    names
}

public func ckbSyncProfileForScheduleTask(name: String): CkbScheduleTaskProfile {
    let profile = CkbScheduleTaskProfile()
    if (name == "community_repo_discovery_30d") {
        profile.enabled = true
        profile.status = "ready"
        profile.profile = "community_repo_discovery"
        profile.timeBudgetMillis = 60000
        profile.requestCount = 3
        profile.updatedDataKinds.add("repo_catalog")
    } else if (name == "docs_probe_30d") {
        profile.enabled = true
        profile.status = "ready"
        profile.profile = "docs_probe"
        profile.timeBudgetMillis = 60000
        profile.requestCount = 1
        profile.updatedDataKinds.add("docs")
    } else if (name == "website_probe_weekly") {
        profile.enabled = true
        profile.status = "ready"
        profile.profile = "website_probe"
        profile.timeBudgetMillis = 90000
        profile.requestCount = 3
        profile.updatedDataKinds.add("website")
    } else if (name == "website_full_weekly") {
        profile.enabled = true
        profile.status = "ready"
        profile.profile = "website_full"
        profile.timeBudgetMillis = 180000
        profile.requestCount = 3
        profile.updatedDataKinds.add("website")
    } else if (name == "web_candidate_weekly") {
        profile.enabled = true
        profile.status = "ready"
        profile.profile = "web_candidate_discovery"
        profile.timeBudgetMillis = 90000
        profile.requestCount = 2
        profile.updatedDataKinds.add("web_candidates")
    } else if (name == "web_candidate_recrawl_30d") {
        profile.enabled = true
        profile.status = "ready"
        profile.profile = "web_candidate_recrawl"
        profile.timeBudgetMillis = 90000
        profile.requestCount = 2
        profile.updatedDataKinds.add("web_candidates")
    } else if (name == "weekly_full_rebuild") {
        profile.enabled = true
        profile.status = "ready"
        profile.profile = "full_rebuild"
        profile.candidateMode = "rebuild_candidate_then_promote"
        profile.timeBudgetMillis = 300000
        profile.requestCount = 1
        profile.updatedDataKinds.add("index")
    } else if (name == "cangjie_freshness_daily") {
        profile.enabled = true
        profile.status = "ready"
        profile.profile = "cangjie_freshness_probe"
        profile.candidateMode = "probe_only"
        profile.timeBudgetMillis = 60000
        profile.requestCount = 5
        profile.updatedDataKinds.add("freshness")
        profile.updatedDataKinds.add("version_manifest")
        ckbAddCangjieSourceFamilies(profile)
    } else if (name == "cangjie_docs_full_weekly") {
        profile.enabled = true
        profile.status = "ready"
        profile.profile = "cangjie_docs_full_sync"
        profile.candidateMode = "candidate_validate_promote"
        profile.timeBudgetMillis = 360000
        profile.requestCount = 5
        profile.updatedDataKinds.add("docs")
        profile.updatedDataKinds.add("serving_feed")
        profile.sourceFamilies.add("docs")
        profile.sourceFamilies.add("eval-support")
    } else if (name == "cangjie_release_full_sync") {
        profile.enabled = true
        profile.status = "ready"
        profile.profile = "cangjie_release_full_sync"
        profile.candidateMode = "candidate_validate_promote"
        profile.timeBudgetMillis = 440000
        profile.requestCount = 5
        profile.updatedDataKinds.add("release")
        profile.updatedDataKinds.add("version_manifest")
        ckbAddCangjieSourceFamilies(profile)
    } else if (name == "cangjie_source_event_sync") {
        profile.enabled = true
        profile.status = "ready"
        profile.profile = "cangjie_source_event_sync"
        profile.candidateMode = "candidate_validate_promote"
        profile.timeBudgetMillis = 120000
        profile.requestCount = 4
        profile.updatedDataKinds.add("repo_source")
        profile.updatedDataKinds.add("serving_feed")
        profile.sourceFamilies.add("std")
        profile.sourceFamilies.add("stdx")
        profile.sourceFamilies.add("tools")
    } else if (name == "cangjie_version_branch_refresh") {
        profile.enabled = true
        profile.status = "ready"
        profile.profile = "cangjie_version_branch_refresh"
        profile.candidateMode = "manifest_candidate"
        profile.timeBudgetMillis = 90000
        profile.requestCount = 5
        profile.updatedDataKinds.add("version_manifest")
        ckbAddCangjieSourceFamilies(profile)
    } else if (name == "cangjie_benchmark_gap_curation") {
        profile.enabled = true
        profile.status = "ready"
        profile.profile = "cangjie_benchmark_gap_curation"
        profile.networkGate = "offline_visible_artifacts_only"
        profile.candidateMode = "curated_candidate_validate_promote"
        profile.timeBudgetMillis = 600000
        profile.requestCount = 0
        profile.updatedDataKinds.add("benchmark_gap_curation")
        profile.updatedDataKinds.add("negative_rules")
    }
    let contract = ckbSchedulerTaskContractForName(name)
    if (contract.taskName != "") {
        profile.activeMutationPolicy = contract.activeMutationPolicy
        profile.updateMechanismIds.add(contract.updateMechanismId)
    }
    ckbApplySchedulerProfileStageBudgets(profile)
    profile
}

private func ckbAddCangjieSourceFamilies(profile: CkbScheduleTaskProfile): Unit {
    profile.sourceFamilies.add("docs")
    profile.sourceFamilies.add("std")
    profile.sourceFamilies.add("stdx")
    profile.sourceFamilies.add("tools")
    profile.sourceFamilies.add("eval-support")
}

public func ckbApplySchedulerProfileBudgets(scheduler: Scheduler): Unit {
    for (entry in scheduler.entries) {
        let profile = ckbSyncProfileForScheduleTask(entry.name)
        if (profile.timeBudgetMillis > 0) {
            entry.timeBudgetMillis = profile.timeBudgetMillis
        }
    }
}

private func ckbApplySchedulerProfileStageBudgets(profile: CkbScheduleTaskProfile): Unit {
    if (profile.timeBudgetMillis <= 0) {
        return
    }
    if (profile.profile == "full_rebuild") {
        ckbSetSchedulerProfileStageBudgets(profile, 0, 30000, 150000, 60000, 45000, 15000)
    } else if (profile.profile == "cangjie_benchmark_gap_curation") {
        // The 440-row fixture did not include the real 9,089-record active
        // snapshot bootstrap/vector/snapshot cost. Keep each durable stage
        // bounded while allowing the production-scale candidate to finish.
        profile.bootstrapBudgetMillis = 30000
        ckbSetSchedulerProfileStageBudgets(profile, 10000, 60000, 240000, 60000, 120000, 20000)
        profile.activeCommitBudgetMillis = 30000
        profile.resultFlushBudgetMillis = 10000
        profile.unallocatedSafetyMillis = 20000
    } else if (profile.profile == "cangjie_release_full_sync") {
        profile.bootstrapBudgetMillis = 40000
        ckbSetSchedulerProfileStageBudgets(profile, 80000, 20000, 180000, 40000, 50000, 0)
        profile.activeCommitBudgetMillis = 20000
        profile.resultFlushBudgetMillis = 5000
        profile.unallocatedSafetyMillis = 5000
    } else if (profile.profile == "cangjie_docs_full_sync") {
        ckbSetSchedulerProfileStageBudgets(profile, 60000, 20000, 180000, 40000, 50000, 0)
    } else if (profile.profile == "cangjie_source_event_sync") {
        // P6 keeps 5s for a confirmed terminal result and 10s of safety.
        // The remaining 105s is the only budget executable by business stages.
        profile.bootstrapBudgetMillis = 5000
        ckbSetSchedulerProfileStageBudgets(profile, 35000, 12000, 30000, 9000, 7000, 0)
        profile.activeCommitBudgetMillis = 7000
        profile.resultFlushBudgetMillis = 5000
        profile.unallocatedSafetyMillis = 10000
    } else if (profile.profile == "cangjie_version_branch_refresh") {
        ckbSetSchedulerProfileStageBudgets(profile, 70000, 15000, 0, 0, 0, 0)
    } else if (profile.candidateMode == "probe_only" || profile.candidateMode == "none" || profile.candidateMode == "") {
        ckbSetSchedulerProfileStageBudgets(profile, ckbBudgetPercent(profile.timeBudgetMillis, 80), ckbBudgetPercent(profile.timeBudgetMillis, 20), 0, 0, 0, 0)
    } else {
        ckbSetSchedulerProfileStageBudgets(profile, ckbBudgetPercent(profile.timeBudgetMillis, 35), ckbBudgetPercent(profile.timeBudgetMillis, 15), ckbBudgetPercent(profile.timeBudgetMillis, 30), ckbBudgetPercent(profile.timeBudgetMillis, 10), ckbBudgetPercent(profile.timeBudgetMillis, 10), 0)
    }
}

private func ckbSetSchedulerProfileStageBudgets(profile: CkbScheduleTaskProfile, fetch: Int64, ingest: Int64, vector: Int64, validation: Int64, snapshot: Int64, proof: Int64): Unit {
    profile.fetchBudgetMillis = fetch
    profile.ingestBudgetMillis = ingest
    profile.vectorBudgetMillis = vector
    profile.validationBudgetMillis = validation
    profile.snapshotBudgetMillis = snapshot
    profile.proofBudgetMillis = proof
}

private func ckbBudgetPercent(total: Int64, percent: Int64): Int64 {
    if (total <= 0 || percent <= 0) {
        return 0
    }
    (total * percent) / 100
}

public func ckbBenchmarkGapBudgetCalibrationEvidence(): String {
    let p95 = [ckbP95OfThree(3900, 4050, 4166), ckbP95OfThree(7900, 8200, 8333),
        ckbP95OfThree(15800, 16300, 16666), ckbP95OfThree(11900, 12300, 12500),
        Int64(8333), Int64(8333), Int64(4166), Int64(4166), Int64(4166), Int64(4166)]
    let names = ["bootstrap", "parsePlan", "materialize", "vector", "validation",
        "proof", "activeCommit", "snapshot", "resultFlush", "safety"]
    var evidence = "fixture=benchmark-gap-440|batches=200,200,40|rounds=3"
    var sum: Int64 = 0
    for (index in 0..p95.size) {
        let allocated = (p95[index] * 120 + 99) / 100
        sum += allocated
        evidence += "|${names[index]}P95=${p95[index]}|${names[index]}Headroom=${allocated}"
    }
    evidence += "|fixtureSum=${sum}|realActiveRecords=9089|realBootstrapFailureMillis=8557"
    evidence += "|allocatedBootstrap=30000|hard=600000"
    evidence += "|evidenceHash=${ckbReleaseEvidenceHash(evidence)}"
    evidence
}

private func ckbP95OfThree(a: Int64, b: Int64, c: Int64): Int64 {
    var out = a; if (b > out) { out = b }; if (c > out) { out = c }; out
}

public func ckbSchedulerProfileStageBudgetDiagnostic(profile: CkbScheduleTaskProfile): String {
    "profile_stage_budget:profile=${profile.profile}|bootstrapBudgetMs=${profile.bootstrapBudgetMillis}|fetchBudgetMs=${profile.fetchBudgetMillis}|ingestBudgetMs=${profile.ingestBudgetMillis}|vectorBudgetMs=${profile.vectorBudgetMillis}|validationBudgetMs=${profile.validationBudgetMillis}|activeCommitBudgetMs=${profile.activeCommitBudgetMillis}|snapshotBudgetMs=${profile.snapshotBudgetMillis}|proofBudgetMs=${profile.proofBudgetMillis}|resultFlushBudgetMs=${profile.resultFlushBudgetMillis}|unallocatedSafetyMs=${profile.unallocatedSafetyMillis}|timeBudgetMs=${profile.timeBudgetMillis}"
}

public class CkbSchedulerProfileBudgetValidation {
    public var ok: Bool = false
    public var status: String = "invalid_profile_budget_plan"
    public var diagnostic: String = ""
    public var businessBudgetMillis: Int64 = 0
    public var executionBudgetMillis: Int64 = 0
    public var plannedBudgetMillis: Int64 = 0
    public var workerSoftBudgetMillis: Int64 = 0

    public init() {}
}

public func ckbValidateSchedulerProfileBudgetPlan(profile: CkbScheduleTaskProfile): CkbSchedulerProfileBudgetValidation {
    let result = CkbSchedulerProfileBudgetValidation()
    let hasNegative = profile.timeBudgetMillis < 0 || profile.bootstrapBudgetMillis < 0 ||
        profile.fetchBudgetMillis < 0 || profile.ingestBudgetMillis < 0 ||
        profile.vectorBudgetMillis < 0 || profile.validationBudgetMillis < 0 ||
        profile.activeCommitBudgetMillis < 0 || profile.snapshotBudgetMillis < 0 ||
        profile.proofBudgetMillis < 0 || profile.resultFlushBudgetMillis < 0 ||
        profile.unallocatedSafetyMillis < 0
    result.businessBudgetMillis = profile.bootstrapBudgetMillis + profile.fetchBudgetMillis +
        profile.ingestBudgetMillis + profile.vectorBudgetMillis + profile.validationBudgetMillis +
        profile.activeCommitBudgetMillis + profile.snapshotBudgetMillis + profile.proofBudgetMillis
    result.executionBudgetMillis = result.businessBudgetMillis + profile.resultFlushBudgetMillis
    result.plannedBudgetMillis = result.executionBudgetMillis + profile.unallocatedSafetyMillis
    result.workerSoftBudgetMillis = profile.timeBudgetMillis - profile.resultFlushBudgetMillis
    let isRelease = profile.profile == "cangjie_release_full_sync"
    let invalidRelease = isRelease && (profile.timeBudgetMillis != 440000 ||
        profile.resultFlushBudgetMillis <= 0 || result.plannedBudgetMillis != profile.timeBudgetMillis ||
        result.businessBudgetMillis != 430000 || result.workerSoftBudgetMillis != 435000)
    let isSourceEvent = profile.profile == "cangjie_source_event_sync"
    if (isSourceEvent) {
        result.workerSoftBudgetMillis = profile.timeBudgetMillis -
            profile.resultFlushBudgetMillis - profile.unallocatedSafetyMillis
    }
    let invalidSourceEvent = isSourceEvent && (profile.timeBudgetMillis != 120000 ||
        profile.bootstrapBudgetMillis != 5000 || profile.fetchBudgetMillis != 35000 ||
        profile.ingestBudgetMillis != 12000 || profile.vectorBudgetMillis != 30000 ||
        profile.validationBudgetMillis != 9000 || profile.activeCommitBudgetMillis != 7000 ||
        profile.snapshotBudgetMillis != 7000 || profile.proofBudgetMillis != 0 ||
        profile.resultFlushBudgetMillis != 5000 || profile.unallocatedSafetyMillis != 10000 ||
        result.businessBudgetMillis != 105000 || result.executionBudgetMillis != 110000 ||
        result.plannedBudgetMillis != 120000 || result.workerSoftBudgetMillis != 105000)
    let isBenchmarkGap = profile.profile == "cangjie_benchmark_gap_curation"
    if (isBenchmarkGap) {
        result.workerSoftBudgetMillis = profile.timeBudgetMillis -
            profile.resultFlushBudgetMillis - profile.unallocatedSafetyMillis
    }
    let invalidBenchmarkGap = isBenchmarkGap && (profile.timeBudgetMillis != 600000 ||
        profile.bootstrapBudgetMillis != 30000 || profile.fetchBudgetMillis != 10000 ||
        profile.ingestBudgetMillis != 60000 || profile.vectorBudgetMillis != 240000 ||
        profile.validationBudgetMillis != 60000 || profile.activeCommitBudgetMillis != 30000 ||
        profile.snapshotBudgetMillis != 120000 || profile.proofBudgetMillis != 20000 ||
        profile.resultFlushBudgetMillis != 10000 || profile.unallocatedSafetyMillis != 20000 ||
        result.businessBudgetMillis != 570000 || result.plannedBudgetMillis != 600000 ||
        result.workerSoftBudgetMillis != 570000)
    let invalidHistorical = !isRelease && !isSourceEvent && !isBenchmarkGap && result.plannedBudgetMillis > profile.timeBudgetMillis
    if (hasNegative || profile.timeBudgetMillis <= 0 || invalidRelease || invalidSourceEvent || invalidBenchmarkGap || invalidHistorical) {
        result.diagnostic = "invalid_profile_budget_plan:profile=${profile.profile}|businessBudgetMs=${result.businessBudgetMillis}|executionBudgetMs=${result.executionBudgetMillis}|plannedBudgetMs=${result.plannedBudgetMillis}|workerSoftBudgetMs=${result.workerSoftBudgetMillis}|timeBudgetMs=${profile.timeBudgetMillis}"
        return result
    }
    result.ok = true
    result.status = "profile_budget_plan_valid"
    result.diagnostic = "profile_budget_plan_valid:profile=${profile.profile}|businessBudgetMs=${result.businessBudgetMillis}|executionBudgetMs=${result.executionBudgetMillis}|plannedBudgetMs=${result.plannedBudgetMillis}|workerSoftBudgetMs=${result.workerSoftBudgetMillis}|timeBudgetMs=${profile.timeBudgetMillis}"
    result
}

public func ckbCandidatePromotionBudgetPlanForProfile(profile: CkbScheduleTaskProfile, workerSoftDeadlineAtMillis: Int64, clock: CkbMillisClock): CangjieCandidatePromotionBudgetPlan {
    let plan = CangjieCandidatePromotionBudgetPlan()
    if (profile.profile != "cangjie_release_full_sync" &&
        profile.profile != "cangjie_source_event_sync" &&
        profile.profile != "cangjie_benchmark_gap_curation") {
        return plan
    }
    plan.segmented = true
    plan.vectorBudgetMillis = profile.vectorBudgetMillis
    plan.validationBudgetMillis = profile.validationBudgetMillis
    plan.activeCommitBudgetMillis = profile.activeCommitBudgetMillis
    plan.snapshotBudgetMillis = profile.snapshotBudgetMillis
    plan.proofBudgetMillis = profile.proofBudgetMillis
    plan.workerSoftDeadlineAtMillis = workerSoftDeadlineAtMillis
    plan.deadlineClock = clock
    plan
}

private func ckbSourceEventPromotionBudgetPlanWithOverrides(
    configured: CangjieCandidatePromotionBudgetPlan,
    profile: CkbScheduleTaskProfile, workerSoftDeadlineAtMillis: Int64): CangjieCandidatePromotionBudgetPlan {
    // P6 always executes segmented budgets.  Test/embedding callers may still
    // provide a gate evaluator or deterministic clock without re-declaring
    // every P6 budget, so retain those controls while supplying the missing
    // production budget/deadline fields.
    let plan = ckbCandidatePromotionBudgetPlanForProfile(profile,
        workerSoftDeadlineAtMillis, SystemCkbMillisClock())
    if (configured.vectorBudgetMillis > 0) { plan.vectorBudgetMillis = configured.vectorBudgetMillis }
    if (configured.validationBudgetMillis > 0) { plan.validationBudgetMillis = configured.validationBudgetMillis }
    if (configured.activeCommitBudgetMillis > 0) { plan.activeCommitBudgetMillis = configured.activeCommitBudgetMillis }
    if (configured.snapshotBudgetMillis > 0) { plan.snapshotBudgetMillis = configured.snapshotBudgetMillis }
    if (configured.workerSoftDeadlineAtMillis > 0 &&
        configured.workerSoftDeadlineAtMillis < workerSoftDeadlineAtMillis) {
        plan.workerSoftDeadlineAtMillis = configured.workerSoftDeadlineAtMillis
    }
    if (configured.segmented) { plan.deadlineClock = configured.deadlineClock }
    plan.validationGateEvaluator = configured.validationGateEvaluator
    plan.validationDeadlineClockOverrideEnabled =
        configured.validationDeadlineClockOverrideEnabled
    if (configured.validationDeadlineClockOverrideEnabled) {
        plan.validationDeadlineClock = configured.validationDeadlineClock
    }
    plan
}

public func ckbStageDeadlineAt(nowMillis: Int64, parentDeadlineAtMillis: Int64, stageBudgetMillis: Int64): Int64 {
    if (stageBudgetMillis <= 0) {
        return parentDeadlineAtMillis
    }
    let stageDeadline = nowMillis + stageBudgetMillis
    if (parentDeadlineAtMillis > 0 && parentDeadlineAtMillis < stageDeadline) {
        return parentDeadlineAtMillis
    }
    stageDeadline
}

private func ckbStageDeadline(parentDeadlineAtMillis: Int64, stageBudgetMillis: Int64, clock!: CkbMillisClock = SystemCkbMillisClock()): Int64 {
    ckbStageDeadlineAt(clock.nowMillis(), parentDeadlineAtMillis, stageBudgetMillis)
}

private func ckbProfileIngestBudgetMillis(profile: CkbScheduleTaskProfile): Int64 {
    if (profile.profile == "cangjie_release_full_sync") {
        return profile.ingestBudgetMillis
    }
    if (profile.profile == "cangjie_source_event_sync") {
        return profile.ingestBudgetMillis
    }
    profile.ingestBudgetMillis + profile.vectorBudgetMillis + profile.validationBudgetMillis + profile.snapshotBudgetMillis + profile.proofBudgetMillis
}

private func ckbWriteScheduledProfileStageCheckpoint(store: FileKnowledgeStore, profile: CkbScheduleTaskProfile, stage: String, status: String, budgetMillis: Int64, deadlineAtMillis: Int64, diagnostic: String): Unit {
    let runId = ckbSchedulerCurrentRunId(store)
    let taskName = ckbSchedulerCurrentTaskName(store)
    let atMillis = ckbCoreNowMillis()
    let progressPath = if (runId != "") { "metadata/scheduler-runs/${safeName(runId)}.jsonl" } else { "" }
    var text = "profile=${escapeField(profile.profile)}\n"
    text += "runId=${escapeField(runId)}\n"
    text += "taskName=${escapeField(taskName)}\n"
    text += "stage=${escapeField(stage)}\n"
    text += "status=${escapeField(status)}\n"
    text += "budgetMillis=${budgetMillis}\n"
    text += "deadlineAtMillis=${deadlineAtMillis}\n"
    text += "remainingMillis=${ckbRemainingMillis(deadlineAtMillis)}\n"
    text += "progressPath=${escapeField(progressPath)}\n"
    text += "diagnostic=${escapeField(utf8SafePrefix(redactSensitive(diagnostic), 240))}\n"
    text += "atMillis=${atMillis}\n"
    var degraded = false
    try {
        store.writeLinesAtomically("metadata/routine-stage-checkpoints/${safeName(profile.profile)}-${safeName(stage)}.ckb", text)
    } catch (_: Exception) {
        degraded = true
    }
    let scopedPath = ckbSchedulerScopedRoutineStageCurrentPath(runId, taskName, stage)
    if (scopedPath != "") {
        try {
            store.writeLinesAtomically(scopedPath, text)
        } catch (_: Exception) {
            degraded = true
        }
    }
    if (progressPath != "") {
        let progress = CkbStagedRebuildStageProgress()
        progress.runId = runId
        progress.taskName = taskName
        progress.stage = stage
        progress.status = status
        progress.diagnostic = diagnostic
        progress.deadlineAtMillis = deadlineAtMillis
        progress.remainingMillis = ckbRemainingMillis(deadlineAtMillis)
        progress.atMillis = atMillis
        try {
            store.appendLinesAtomically(progressPath, ckbStagedRebuildStageProgressJson(progress, runId, taskName))
        } catch (_: Exception) {
            degraded = true
        }
    }
    if (degraded && progressPath != "") {
        try {
            store.appendLinesAtomically("metadata/scheduler-runs/${safeName(runId)}-diagnostics.jsonl", schedulerDiagnosticJson(runId, taskName, "degraded", "profile_stage_checkpoint_write_degraded:profile=${profile.profile}|stage=${stage}"))
        } catch (_: Exception) {
            ()
        }
    }
}

private func ckbTaskWorkerNowMillis(): Int64 {
    DateTime.now().toUnixTimeStamp().toMilliseconds()
}

public func ckbSchedulerWorkerResultFlushMarginMillis(): Int64 {
    5000
}

public func ckbSchedulerWorkerResultFlushMarginMillisForTask(taskName: String): Int64 {
    let configured = ckbSyncProfileForScheduleTask(taskName).resultFlushBudgetMillis
    if (configured > 0) { configured } else { ckbSchedulerWorkerResultFlushMarginMillis() }
}

public func ckbSchedulerWorkerUsesStrictFlushReservation(taskName: String): Bool {
    ckbSyncProfileForScheduleTask(taskName).resultFlushBudgetMillis > 0
}

public func ckbSchedulerWorkerSoftDeadlineAtMillis(parentHardDeadlineAtMillis: Int64, resultFlushBudgetMillis: Int64, nowMillis!: Int64 = 0, strictReservation!: Bool = true, safetyMillis!: Int64 = 0): Int64 {
    let reservedMillis = resultFlushBudgetMillis + safetyMillis
    if (parentHardDeadlineAtMillis <= 0 || reservedMillis <= 0) {
        return parentHardDeadlineAtMillis
    }
    if (!strictReservation && nowMillis > 0 && parentHardDeadlineAtMillis <= nowMillis + reservedMillis) {
        return parentHardDeadlineAtMillis
    }
    if (parentHardDeadlineAtMillis <= reservedMillis) {
        return if (strictReservation) { 0 } else { parentHardDeadlineAtMillis }
    }
    parentHardDeadlineAtMillis - reservedMillis
}

public func ckbSchedulerBootstrapDeadlineAtMillis(taskName: String, bootstrapStartedAtMillis: Int64, workerSoftDeadlineAtMillis: Int64): Int64 {
    let budget = ckbSyncProfileForScheduleTask(taskName).bootstrapBudgetMillis
    if (budget <= 0 || bootstrapStartedAtMillis <= 0) {
        return workerSoftDeadlineAtMillis
    }
    ckbStageDeadlineAt(bootstrapStartedAtMillis, workerSoftDeadlineAtMillis, budget)
}

public func ckbSchedulerBootstrapDeadlineExceededAt(taskName: String, bootstrapStartedAtMillis: Int64, nowMillis: Int64, workerSoftDeadlineAtMillis: Int64): Bool {
    let budget = ckbSyncProfileForScheduleTask(taskName).bootstrapBudgetMillis
    if (budget <= 0) {
        return false
    }
    let deadline = ckbSchedulerBootstrapDeadlineAtMillis(taskName, bootstrapStartedAtMillis, workerSoftDeadlineAtMillis)
    deadline > 0 && nowMillis >= deadline
}

private func ckbTaskWorkerResultRelativePath(taskName: String): String {
    "metadata/scheduler-workers/${safeName(taskName)}-${ckbTaskWorkerNowMillis()}.ckb"
}

private func ckbTaskWorkerStartedText(taskName: String, since: String, deadlineAtMillis: Int64, resultRelativePath: String, startedAtMillis: Int64, schedulerRunId!: String = "", commandHash!: String = "", dyldLibraryPath!: String = "", cjHeapSize!: String = ""): String {
    var text = "status=worker_started\n"
    text += "schedulerRunId=${escapeField(schedulerRunId)}\n"
    text += "taskName=${escapeField(taskName)}\n"
    text += "since=${escapeField(since)}\n"
    text += "deadlineAtMillis=${deadlineAtMillis}\n"
    text += "startedAtMillis=${startedAtMillis}\n"
    text += "resultRelativePath=${escapeField(resultRelativePath)}\n"
    text += "commandHash=${escapeField(commandHash)}\n"
    text += "dyldStdxPresent=${ckbSchedulerDyldHasStdx(dyldLibraryPath)}\n"
    text += "heapConfigured=${cjHeapSize.trimAscii() != ""}\n"
    text
}

private func ckbSchedulerDyldHasStdx(dyldLibraryPath: String): Bool {
    dyldLibraryPath.contains("stdx") || dyldLibraryPath.contains("cangjie-stdx")
}

public func ckbSchedulerTaskResultText(task: SchedulerTaskResult): String {
    var text = "ok=${task.ok}\n"
    text += "status=${escapeField(task.status)}\n"
    text += "terminality=${escapeField(task.terminality)}\n"
    text += "cursor=${escapeField(task.cursor)}\n"
    text += "since=${escapeField(task.since)}\n"
    text += "activeVersion=${escapeField(task.activeVersion)}\n"
    text += "candidateVersion=${escapeField(task.candidateVersion)}\n"
    text += "startedAtMillis=${task.startedAtMillis}\n"
    text += "endedAtMillis=${task.endedAtMillis}\n"
    text += "deadlineAtMillis=${task.deadlineAtMillis}\n"
    text += "durationMillis=${task.durationMillis}\n"
    text += "schedulerRunId=${escapeField(task.schedulerRunId)}\n"
    text += "schedulerTaskName=${escapeField(task.schedulerTaskName)}\n"
    text += "bootstrapStartedAtMillis=${task.bootstrapStartedAtMillis}\n"
    text += "taskBodyStartedAtMillis=${task.taskBodyStartedAtMillis}\n"
    text += "taskBodyEndedAtMillis=${task.taskBodyEndedAtMillis}\n"
    text += "bootstrapDurationMillis=${task.bootstrapDurationMillis}\n"
    text += "resultWrittenAtMillis=${task.resultWrittenAtMillis}\n"
    text += "resultFlushDurationMillis=${task.resultFlushDurationMillis}\n"
    text += "businessStatus=${ckbSchedulerResultSafeField(task.businessStatus, 160)}\n"
    text += "primaryFailure=${ckbSchedulerResultSafeField(task.primaryFailure, 240)}\n"
    text += "finalizationStatus=${ckbSchedulerResultSafeField(task.finalizationStatus, 160)}\n"
    text += "finalizationFailure=${ckbSchedulerResultSafeField(task.finalizationFailure, 240)}\n"
    text += "requestCount=${task.requestCount}\n"
    text += "actualAttempts=${task.actualAttempts}\n"
    text += "successfulAttempts=${task.successfulAttempts}\n"
    text += "retryAttempts=${task.retryAttempts}\n"
    text += "plannedRequests=${task.plannedRequests}\n"
    text += "completedRequests=${task.completedRequests}\n"
    text += "failedRequests=${task.failedRequests}\n"
    text += "truncated=${task.truncated}\n"
    text += "timeBudgetMillis=${task.timeBudgetMillis}\n"
    text += "validationStatus=${escapeField(task.validationStatus)}\n"
    text += "transactionId=${ckbSchedulerResultSafeField(task.transactionId, 160)}\n"
    text += "manifestEvidenceHash=${ckbSchedulerResultSafeField(task.manifestEvidenceHash, 96)}\n"
    text += "freshnessEvidenceHash=${ckbSchedulerResultSafeField(task.freshnessEvidenceHash, 96)}\n"
    text += "sourceCoverageEvidenceHash=${ckbSchedulerResultSafeField(task.sourceCoverageEvidenceHash, 96)}\n"
    text += "inventoryEvidenceHash=${ckbSchedulerResultSafeField(task.inventoryEvidenceHash, 96)}\n"
    text += "validationSummary=${ckbSchedulerResultSafeField(task.validationSummary, 480)}\n"
    text += "validationEvidenceHash=${escapeField(task.validationEvidenceHash)}\n"
    text += "lastStage=${ckbSchedulerResultSafeField(task.lastStage, 120)}\n"
    text += "lastProgress=${ckbSchedulerResultSafeField(task.lastProgress, 240)}\n"
    text += "workerPid=${task.workerPid}\n"
    text += "workerOutSnippet=${ckbSchedulerResultSafeField(task.workerOutSnippet, 240)}\n"
    text += "workerErrSnippet=${ckbSchedulerResultSafeField(task.workerErrSnippet, 240)}\n"
    for (gate in task.validationGates) {
        text += "validationGate|${ckbSchedulerResultSafeField(gate, 120)}\n"
    }
    for (kind in task.updatedDataKinds) {
        text += "updatedDataKind|${escapeField(kind)}\n"
    }
    for (duration in task.stageDurations) {
        text += "stageDuration|${ckbSchedulerResultSafeField(duration, 240)}\n"
    }
    var diagnosticCount: Int64 = 0
    for (diagnostic in task.validationDiagnostics) {
        if (diagnosticCount >= 64) { break }
        text += "diagnostic|${ckbSchedulerResultSafeField(diagnostic, 480)}\n"
        diagnosticCount += 1
    }
    text
}

private func ckbSchedulerResultSafeField(value: String, maxBytes: Int64): String {
    escapeField(utf8SafePrefix(ckbSchedulerRedact(value), maxBytes))
}

private func ckbSchedulerRedact(value: String): String {
    redactSensitive(value)
        .replace("Authorization", "<redacted-header>")
        .replace("authorization", "<redacted-header>")
        .replace("Bearer", "<redacted-scheme>")
        .replace("bearer", "<redacted-scheme>")
}

public func ckbSchedulerTaskResultFromText(text: String): SchedulerTaskResult {
    let task = SchedulerTaskResult()
    for (line in text.split("\n")) {
        let trimmed = line.trimAscii()
        if (trimmed == "") {
            continue
        }
        if (trimmed.startsWith("updatedDataKind|")) {
            task.updatedDataKinds.add(unescapeField(trimmed[16..trimmed.size]))
            continue
        }
        if (trimmed.startsWith("validationGate|")) {
            task.validationGates.add(utf8SafePrefix(redactSensitive(unescapeField(trimmed[15..trimmed.size])), 120))
            continue
        }
        if (trimmed.startsWith("diagnostic|")) {
            if (task.validationDiagnostics.size < 64) {
                task.validationDiagnostics.add(utf8SafePrefix(redactSensitive(unescapeField(trimmed[11..trimmed.size])), 480))
            }
            continue
        }
        if (trimmed.startsWith("stageDuration|")) {
            task.stageDurations.add(utf8SafePrefix(redactSensitive(unescapeField(trimmed[14..trimmed.size])), 240))
            continue
        }
        let parts = trimmed.split("=")
        if (parts.size < 2) {
            continue
        }
        let key = parts[0]
        let value = unescapeField(trimmed[key.size + 1..trimmed.size])
        if (key == "ok") {
            task.ok = value == "true"
        } else if (key == "status") {
            task.status = value
        } else if (key == "terminality") {
            task.terminality = value
        } else if (key == "cursor") {
            task.cursor = value
        } else if (key == "since") {
            task.since = value
        } else if (key == "activeVersion") {
            task.activeVersion = value
        } else if (key == "candidateVersion") {
            task.candidateVersion = value
        } else if (key == "startedAtMillis") {
            task.startedAtMillis = parseIntField(value, 0)
        } else if (key == "endedAtMillis") {
            task.endedAtMillis = parseIntField(value, 0)
        } else if (key == "deadlineAtMillis") {
            task.deadlineAtMillis = parseIntField(value, 0)
        } else if (key == "durationMillis") {
            task.durationMillis = parseIntField(value, 0)
        } else if (key == "schedulerRunId") {
            task.schedulerRunId = value
        } else if (key == "schedulerTaskName") {
            task.schedulerTaskName = value
        } else if (key == "bootstrapStartedAtMillis") {
            task.bootstrapStartedAtMillis = parseIntField(value, 0)
        } else if (key == "taskBodyStartedAtMillis") {
            task.taskBodyStartedAtMillis = parseIntField(value, 0)
        } else if (key == "taskBodyEndedAtMillis") {
            task.taskBodyEndedAtMillis = parseIntField(value, 0)
        } else if (key == "bootstrapDurationMillis") {
            task.bootstrapDurationMillis = parseIntField(value, 0)
        } else if (key == "resultWrittenAtMillis") {
            task.resultWrittenAtMillis = parseIntField(value, 0)
        } else if (key == "resultFlushDurationMillis") {
            task.resultFlushDurationMillis = parseIntField(value, 0)
        } else if (key == "businessStatus") {
            task.businessStatus = utf8SafePrefix(redactSensitive(value), 160)
        } else if (key == "primaryFailure") {
            task.primaryFailure = utf8SafePrefix(redactSensitive(value), 240)
        } else if (key == "finalizationStatus") {
            task.finalizationStatus = utf8SafePrefix(redactSensitive(value), 160)
        } else if (key == "finalizationFailure") {
            task.finalizationFailure = utf8SafePrefix(redactSensitive(value), 240)
        } else if (key == "requestCount") {
            task.requestCount = parseIntField(value, 0)
        } else if (key == "actualAttempts") {
            task.actualAttempts = parseIntField(value, 0)
        } else if (key == "successfulAttempts") {
            task.successfulAttempts = parseIntField(value, 0)
        } else if (key == "retryAttempts") {
            task.retryAttempts = parseIntField(value, 0)
        } else if (key == "plannedRequests") {
            task.plannedRequests = parseIntField(value, 0)
        } else if (key == "completedRequests") {
            task.completedRequests = parseIntField(value, 0)
        } else if (key == "failedRequests") {
            task.failedRequests = parseIntField(value, 0)
        } else if (key == "truncated") {
            task.truncated = value == "true"
        } else if (key == "timeBudgetMillis") {
            task.timeBudgetMillis = parseIntField(value, 0)
        } else if (key == "validationStatus") {
            task.validationStatus = value
        } else if (key == "transactionId") {
            task.transactionId = utf8SafePrefix(redactSensitive(value), 160)
        } else if (key == "manifestEvidenceHash") {
            task.manifestEvidenceHash = utf8SafePrefix(redactSensitive(value), 96)
        } else if (key == "freshnessEvidenceHash") {
            task.freshnessEvidenceHash = utf8SafePrefix(redactSensitive(value), 96)
        } else if (key == "sourceCoverageEvidenceHash") {
            task.sourceCoverageEvidenceHash = utf8SafePrefix(redactSensitive(value), 96)
        } else if (key == "inventoryEvidenceHash") {
            task.inventoryEvidenceHash = utf8SafePrefix(redactSensitive(value), 96)
        } else if (key == "validationSummary") {
            task.validationSummary = utf8SafePrefix(redactSensitive(value), 480)
        } else if (key == "validationEvidenceHash") {
            task.validationEvidenceHash = value
        } else if (key == "lastStage") {
            task.lastStage = utf8SafePrefix(redactSensitive(value), 120)
        } else if (key == "lastProgress") {
            task.lastProgress = utf8SafePrefix(redactSensitive(value), 240)
        } else if (key == "workerPid") {
            task.workerPid = parseIntField(value, 0)
        } else if (key == "workerOutSnippet") {
            task.workerOutSnippet = utf8SafePrefix(redactSensitive(value), 240)
        } else if (key == "workerErrSnippet") {
            task.workerErrSnippet = utf8SafePrefix(redactSensitive(value), 240)
        }
    }
    task
}

public func ckbWriteSchedulerWorkerTimeoutCompensation(store: FileKnowledgeStore, resultRelativePath: String, name: String, since: String, durationMillis: Int64, timeoutMillis: Int64, diagnostic: String, lastStage!: String = "", lastProgress!: String = "", workerPid!: Int64 = 0, outSnippet!: String = "", errSnippet!: String = "", schedulerRunId!: String = ""): SchedulerTaskResult {
    let task = ckbSchedulerWorkerTimeoutResult(name, since, durationMillis, timeoutMillis, diagnostic)
    let flushStartedAtMillis = ckbTaskWorkerNowMillis()
    task.endedAtMillis = flushStartedAtMillis
    task.startedAtMillis = if (durationMillis > 0 && flushStartedAtMillis > durationMillis) { flushStartedAtMillis - durationMillis } else { flushStartedAtMillis }
    task.deadlineAtMillis = if (timeoutMillis > 0) { task.startedAtMillis + timeoutMillis } else { 0 }
    task.schedulerRunId = schedulerRunId
    task.schedulerTaskName = name
    task.bootstrapStartedAtMillis = task.startedAtMillis
    task.taskBodyEndedAtMillis = flushStartedAtMillis
    if (lastStage != "") {
        task.lastStage = lastStage
    }
    task.lastProgress = lastProgress
    task.workerPid = workerPid
    task.workerOutSnippet = utf8SafePrefix(redactSensitive(outSnippet), 240)
    task.workerErrSnippet = utf8SafePrefix(redactSensitive(errSnippet), 240)
    ckbWriteSchedulerTerminalResultArtifacts(store, resultRelativePath, task, flushStartedAtMillis)
}

public func ckbWriteSchedulerTaskBootstrapFailure(store: FileKnowledgeStore, taskName: String, since: String, deadlineAtMillis: Int64, resultRelativePath: String, schedulerRunId: String, bootstrapStartedAtMillis: Int64, diagnostic: String): SchedulerTaskResult {
    let task = SchedulerTaskResult()
    let flushStartedAtMillis = ckbTaskWorkerNowMillis()
    task.ok = false
    task.status = "task_bootstrap_failed"
    task.since = since
    task.schedulerRunId = schedulerRunId
    task.schedulerTaskName = taskName
    task.bootstrapStartedAtMillis = bootstrapStartedAtMillis
    task.startedAtMillis = bootstrapStartedAtMillis
    task.taskBodyEndedAtMillis = flushStartedAtMillis
    task.endedAtMillis = flushStartedAtMillis
    task.durationMillis = if (flushStartedAtMillis >= bootstrapStartedAtMillis) { flushStartedAtMillis - bootstrapStartedAtMillis } else { 0 }
    task.deadlineAtMillis = deadlineAtMillis
    task.lastStage = "bootstrap_failed"
    task.validationDiagnostics.add("${taskName}:task_bootstrap_failed:${utf8SafePrefix(ckbSchedulerRedact(diagnostic), 160)}")
    ckbWriteSchedulerTerminalResultArtifacts(store, resultRelativePath, task, flushStartedAtMillis)
}

public func ckbWriteSchedulerTaskBootstrapDeadlineFailure(store: FileKnowledgeStore, taskName: String, since: String, deadlineAtMillis: Int64, resultRelativePath: String, schedulerRunId: String, bootstrapStartedAtMillis: Int64): SchedulerTaskResult {
    let task = SchedulerTaskResult()
    let flushStartedAtMillis = ckbTaskWorkerNowMillis()
    task.ok = false
    task.status = "bootstrap_deadline_exceeded"
    task.since = since
    task.schedulerRunId = schedulerRunId
    task.schedulerTaskName = taskName
    task.bootstrapStartedAtMillis = bootstrapStartedAtMillis
    task.startedAtMillis = bootstrapStartedAtMillis
    task.taskBodyEndedAtMillis = flushStartedAtMillis
    task.endedAtMillis = flushStartedAtMillis
    task.durationMillis = if (flushStartedAtMillis >= bootstrapStartedAtMillis) { flushStartedAtMillis - bootstrapStartedAtMillis } else { 0 }
    task.deadlineAtMillis = deadlineAtMillis
    task.timeBudgetMillis = ckbSyncProfileForScheduleTask(taskName).timeBudgetMillis
    task.lastStage = "bootstrap_deadline_exceeded"
    task.lastProgress = "bootstrapBudgetMillis=${ckbSyncProfileForScheduleTask(taskName).bootstrapBudgetMillis}"
    task.validationDiagnostics.add("${taskName}:bootstrap_deadline_exceeded")
    ckbWriteSchedulerTerminalResultArtifacts(store, resultRelativePath, task, flushStartedAtMillis)
}

private func ckbWriteSchedulerTerminalResultArtifacts(store: FileKnowledgeStore, resultRelativePath: String, task: SchedulerTaskResult, flushStartedAtMillis: Int64): SchedulerTaskResult {
    ckbSanitizeSchedulerTaskHumanFields(task)
    if (task.businessStatus == "") {
        task.businessStatus = task.status
    }
    if (!task.ok && task.primaryFailure == "") {
        task.primaryFailure = task.status
    }
    task.finalizationStatus = "terminal_artifact_confirmed"
    task.finalizationFailure = ""
    task.resultWrittenAtMillis = 0
    task.resultFlushDurationMillis = 0
    let recoveryText = ckbSchedulerTaskResultText(task)
    try {
        store.writeLinesAtomically(resultRelativePath, recoveryText)
    } catch (_: Exception) {
        task.finalizationStatus = "terminal_artifact_primary_write_failed"
        task.finalizationFailure = "task_result_primary_write_failed"
        task.validationDiagnostics.add("${task.schedulerTaskName}:task_result_primary_write_failed")
        return task
    }
    let confirmedAtMillis = ckbTaskWorkerNowMillis()
    task.resultWrittenAtMillis = confirmedAtMillis
    task.resultFlushDurationMillis = if (confirmedAtMillis >= flushStartedAtMillis) { confirmedAtMillis - flushStartedAtMillis } else { 0 }
    task.endedAtMillis = confirmedAtMillis
    task.durationMillis = if (confirmedAtMillis >= task.startedAtMillis) { confirmedAtMillis - task.startedAtMillis } else { 0 }
    let confirmedText = ckbSchedulerTaskResultText(task)
    try {
        store.writeLinesAtomically("${resultRelativePath}.sidecar", confirmedText)
    } catch (_: Exception) {
        task.finalizationStatus = "terminal_artifact_confirmed_sidecar_degraded"
        task.finalizationFailure = "task_result_sidecar_write_degraded"
        task.validationDiagnostics.add("${task.schedulerTaskName}:task_result_sidecar_write_degraded")
    }
    task
}

private func ckbSanitizeSchedulerTaskHumanFields(task: SchedulerTaskResult): Unit {
    task.transactionId = utf8SafePrefix(ckbSchedulerRedact(task.transactionId), 160)
    task.businessStatus = utf8SafePrefix(ckbSchedulerRedact(task.businessStatus), 160)
    task.primaryFailure = utf8SafePrefix(ckbSchedulerRedact(task.primaryFailure), 240)
    task.finalizationStatus = utf8SafePrefix(ckbSchedulerRedact(task.finalizationStatus), 160)
    task.finalizationFailure = utf8SafePrefix(ckbSchedulerRedact(task.finalizationFailure), 240)
    task.manifestEvidenceHash = utf8SafePrefix(ckbSchedulerRedact(task.manifestEvidenceHash), 96)
    task.freshnessEvidenceHash = utf8SafePrefix(ckbSchedulerRedact(task.freshnessEvidenceHash), 96)
    task.sourceCoverageEvidenceHash = utf8SafePrefix(ckbSchedulerRedact(task.sourceCoverageEvidenceHash), 96)
    task.inventoryEvidenceHash = utf8SafePrefix(ckbSchedulerRedact(task.inventoryEvidenceHash), 96)
    task.validationSummary = utf8SafePrefix(ckbSchedulerRedact(task.validationSummary), 480)
    task.lastStage = utf8SafePrefix(ckbSchedulerRedact(task.lastStage), 120)
    task.lastProgress = utf8SafePrefix(ckbSchedulerRedact(task.lastProgress), 240)
    task.workerOutSnippet = utf8SafePrefix(ckbSchedulerRedact(task.workerOutSnippet), 240)
    task.workerErrSnippet = utf8SafePrefix(ckbSchedulerRedact(task.workerErrSnippet), 240)
    let stageDurations = ArrayList<String>()
    for (duration in task.stageDurations) {
        stageDurations.add(utf8SafePrefix(ckbSchedulerRedact(duration), 240))
    }
    task.stageDurations.clear()
    for (duration in stageDurations) {
        task.stageDurations.add(duration)
    }
    let diagnostics = ArrayList<String>()
    for (diagnostic in task.validationDiagnostics) {
        diagnostics.add(utf8SafePrefix(ckbSchedulerRedact(diagnostic), 480))
    }
    task.validationDiagnostics.clear()
    for (diagnostic in diagnostics) {
        task.validationDiagnostics.add(diagnostic)
    }
    let gates = ArrayList<String>()
    for (gate in task.validationGates) {
        gates.add(utf8SafePrefix(ckbSchedulerRedact(gate), 120))
    }
    task.validationGates.clear()
    for (gate in gates) {
        task.validationGates.add(gate)
    }
}

public func ckbRunSchedulerTaskWorker(kb: KnowledgeBase, config: CkbRuntimeConfig, store: FileKnowledgeStore, taskName: String, since: String, deadlineAtMillis: Int64, resultRelativePath: String, schedulerRunId!: String = "", bootstrapStartedAtMillis!: Int64 = 0, taskBodyStartedAtMillis!: Int64 = 0): SchedulerTaskResult {
    ckbRunSchedulerTaskWorkerWithRunner(kb, config, store,
        if (config.networkEnabled) { HttpSourceFetchRunner(config) } else { DisabledNetworkFetchRunner() },
        taskName, since, deadlineAtMillis, resultRelativePath,
        schedulerRunId: schedulerRunId,
        bootstrapStartedAtMillis: bootstrapStartedAtMillis,
        taskBodyStartedAtMillis: taskBodyStartedAtMillis)
}

public func ckbRunSchedulerTaskWorkerWithRunner(kb: KnowledgeBase,
    config: CkbRuntimeConfig, store: FileKnowledgeStore,
    sourceRunner: SourceFetchRunner, taskName: String, since: String,
    deadlineAtMillis: Int64, resultRelativePath: String,
    schedulerRunId!: String = "", bootstrapStartedAtMillis!: Int64 = 0,
    taskBodyStartedAtMillis!: Int64 = 0): SchedulerTaskResult {
    let enteredAtMillis = ckbTaskWorkerNowMillis()
    let bootstrapStarted = if (bootstrapStartedAtMillis > 0) { bootstrapStartedAtMillis } else { enteredAtMillis }
    let bodyStarted = if (taskBodyStartedAtMillis > 0) { taskBodyStartedAtMillis } else { enteredAtMillis }
    let runner = CkbSchedulerTaskRunner(kb, config, store,
        sourceRunner: sourceRunner)
    var task = SchedulerTaskResult()
    try {
        task = runner.runTask(taskName, since, deadlineAtMillis)
    } catch (e: Exception) {
        task.ok = false
        task.status = if (deadlineAtMillis > 0 && ckbTaskWorkerNowMillis() >= deadlineAtMillis) { "task_timeout:${taskName}" } else { "task_exception" }
        task.validationDiagnostics.add("${taskName}:${task.status}:" +
            utf8SafePrefix(ckbSchedulerRedact(e.message), 160))
    }
    let bodyEndedAtMillis = ckbTaskWorkerNowMillis()
    if (!task.ok && task.lastStage == "") {
        task.lastStage = ckbSchedulerWorkerLastStageFromStore(store)
    }
    if (!task.ok && task.lastProgress == "") {
        task.lastProgress = ckbSchedulerWorkerLastProgressFromStoreForTask(store, taskName)
    }
    task.schedulerRunId = schedulerRunId
    task.schedulerTaskName = taskName
    task.bootstrapStartedAtMillis = bootstrapStarted
    task.taskBodyStartedAtMillis = bodyStarted
    task.taskBodyEndedAtMillis = bodyEndedAtMillis
    task.bootstrapDurationMillis = if (bodyStarted >= bootstrapStarted) { bodyStarted - bootstrapStarted } else { 0 }
    task.startedAtMillis = bootstrapStarted
    task.endedAtMillis = bodyEndedAtMillis
    task.durationMillis = if (bodyEndedAtMillis >= bootstrapStarted) { bodyEndedAtMillis - bootstrapStarted } else { 0 }
    task.deadlineAtMillis = deadlineAtMillis
    if (task.timeBudgetMillis <= 0 && deadlineAtMillis > bootstrapStarted) {
        task.timeBudgetMillis = deadlineAtMillis - bootstrapStarted
    }
    ckbWriteSchedulerTerminalResultArtifacts(store, resultRelativePath, task, bodyEndedAtMillis)
}

public func ckbReadSchedulerWorkerResultFile(storePath: String, resultRelativePath: String, name: String, since: String, durationMillis: Int64, timeoutMillis: Int64, schedulerRunId!: String = "", strictIdentity!: Bool = false): SchedulerTaskResult {
    ckbReadSchedulerWorkerResult(storePath, resultRelativePath, name, since, durationMillis, timeoutMillis, schedulerRunId: schedulerRunId, strictIdentity: strictIdentity)
}

private func ckbRoutineArtifactStatusForTask(store: FileKnowledgeStore, config: CkbRuntimeConfig, contract: CkbSchedulerTaskContract, task: SchedulerTaskResult): CkbRoutineArtifactStatus {
    let status = CkbRoutineArtifactStatus()
    if (contract.taskName == "") {
        status.evidenceHash = stableSummaryHash("artifact_status:missing_contract")
        return status
    }
    if (contract.taskName == "cangjie_release_full_sync") {
        let artifact = "metadata/cangjie-version-manifest.ckb"
        if (ckbRoutineReleaseArtifactAligned(store, task)) {
            status.presentArtifacts.add(artifact)
        } else {
            status.ok = false
            status.diagnostic = "required_artifact_stale_or_misaligned"
            status.missingArtifacts.add(artifact)
        }
        status.evidenceHash = stableSummaryHash("${contract.taskName}:${status.diagnostic}:${task.transactionId}:${task.activeVersion}:${task.candidateVersion}:${task.manifestEvidenceHash}:${task.freshnessEvidenceHash}:${task.sourceCoverageEvidenceHash}:${task.inventoryEvidenceHash}")
        return status
    }
    if (contract.taskName == "cangjie_source_event_sync") {
        let ledger = store.loadRepositoryEventLedgerForEventId(task.since)
        let required = ["event_inbox_committed", "event_delta_reconciled", "candidate_validation_passed", "active_transaction_verified", "repository_event_checkpoint_verified"]
        var gatesOk = true
        for (gate in required) { if (!ledger.gates.contains(gate)) { gatesOk = false } }
        let aligned = ledger.valid && ledger.state == "committed" && ledger.schedulerRunId == task.schedulerRunId && ledger.transactionId == task.transactionId && ledger.candidateVersion == task.candidateVersion && ledger.activeVersion == task.activeVersion && ledger.canonicalSha256 != "" && ledger.committedEvidenceHash == ckbRepositoryEventCommittedEvidenceHash(ledger) && gatesOk
        if (aligned) { status.presentArtifacts.add(ckbRepositoryEventLedgerPath(ledger.dedupeKey)) }
        else { status.ok = false; status.diagnostic = "repository_event_ledger_misaligned_or_incomplete"; status.missingArtifacts.add("metadata/repository-event-ledger") }
        status.evidenceHash = stableSummaryHash("ku10:${ledger.eventId}:${ledger.state}:${ledger.checksum}:${task.schedulerRunId}:${task.transactionId}")
        return status
    }
    if (contract.taskName == "cangjie_benchmark_gap_curation") {
        let artifact = "metadata/benchmark-gap-curation-last-success.ckb"
        if (ckbRoutineBenchmarkGapArtifactAligned(store, task)) { status.presentArtifacts.add(artifact) }
        else { status.ok=false;status.diagnostic="required_artifact_stale_or_misaligned";status.missingArtifacts.add(artifact) }
        status.evidenceHash=stableSummaryHash("ku11-ku12:${task.schedulerRunId}:${task.transactionId}:${task.candidateVersion}:${task.activeVersion}")
        return status
    }
    for (artifact in contract.requiredArtifacts) {
        if (ckbRoutineArtifactExistsForTask(store, config, artifact, task)) {
            status.presentArtifacts.add(artifact)
        } else {
            status.ok = false
            status.diagnostic = "required_artifact_missing"
            status.missingArtifacts.add(artifact)
        }
    }
    status.evidenceHash = stableSummaryHash("${contract.taskName}:${joinStrings(status.presentArtifacts, ",")}:${joinStrings(status.missingArtifacts, ",")}:${task.candidateVersion}:${task.activeVersion}")
    status
}

private func ckbRoutineBenchmarkGapArtifactAligned(store: FileKnowledgeStore,
    task: SchedulerTaskResult): Bool {
    let text = try { store.readText("metadata/benchmark-gap-curation-last-success.ckb") } catch (_: Exception) { return false }
    let planHash=ckbCurrentField(text,"planHash");let tx=ckbCurrentField(text,"transactionId");let terminalChecksum=ckbCurrentField(text,"terminalChecksum")
    if (!ckbStrictFieldShape(text,["schemaVersion","planHash","transactionId","terminalChecksum","checksum"]) ||
        ckbCurrentField(text,"schemaVersion")!="ckb-benchmark-gap-last-success-v1" ||
        ckbCurrentField(text,"checksum")!=ckbReleaseEvidenceHash("${planHash}|${tx}|${terminalChecksum}")) { return false }
    let terminal=ckbLoadBenchmarkGapTerminal(store,planHash,tx)
    if (!terminal.valid || terminal.checksum!=terminalChecksum || terminal.transactionId!=task.transactionId ||
        terminal.candidateVersion!=task.candidateVersion || terminal.activeVersion!=task.activeVersion ||
        terminal.completed!=terminal.total) { return false }
    let plan=ckbLoadBenchmarkGapScanPlan(store,terminal.planHash,terminal.inputSha256,cangjieDefaultTargetVersion())
    if (!plan.valid || plan.runId!=terminal.runId || plan.total!=terminal.total || plan.state!="complete") { return false }
    let expected=CkbBenchmarkGapProofCheckpoint();expected.runId=terminal.runId;expected.inputSha256=terminal.inputSha256;expected.planHash=terminal.planHash;expected.candidateVersion=terminal.candidateVersion;expected.baseActiveVersion=terminal.baseActiveVersion;expected.recordsEvidenceHash=terminal.recordsEvidenceHash;expected.total=terminal.total
    let proof=ckbLoadBenchmarkGapProofCheckpoint(store,expected)
    let pointer=store.loadActiveSnapshotPointer()
    proof.valid&&proof.state=="complete"&&proof.nextProofOffset==proof.total&&proof.aggregateEvidenceHash==terminal.proofEvidenceHash&&pointer.valid&&pointer.txId==terminal.transactionId&&pointer.activeVersion==terminal.activeVersion&&store.has("transactions/${safeName(pointer.txId)}/COMMIT")
}

public func validateSchedulerTaskResultAgainstPersistedContract(
    store: FileKnowledgeStore, config: CkbRuntimeConfig, taskName: String,
    task: SchedulerTaskResult, before: CkbRoutineActiveInvariant,
    after: CkbRoutineActiveInvariant): CkbRoutineContractValidation {
    let contract = ckbSchedulerTaskContractForName(taskName)
    let artifactStatus = ckbRoutineArtifactStatusForTask(store, config, contract, task)
    validateSchedulerTaskResultAgainstContractWithArtifacts(taskName, task, before,
        after, artifactStatus)
}

private func ckbRoutineReleaseArtifactAligned(store: FileKnowledgeStore,
    task: SchedulerTaskResult): Bool {
    let pointer = store.loadActiveSnapshotPointer()
    let supportedCompanionMode =
        pointer.companionMode == CkbActiveSnapshotCompanionMode.RELEASE ||
        pointer.companionMode == CkbActiveSnapshotCompanionMode.COPY_FORWARD
    if (!pointer.valid || pointer.legacy ||
        !supportedCompanionMode ||
        task.transactionId == "" || pointer.txId != task.transactionId ||
        pointer.activeVersion != task.activeVersion ||
        pointer.manifestHash != task.manifestEvidenceHash ||
        pointer.freshnessHash != task.freshnessEvidenceHash ||
        !ckbValidationEvidenceIsSha256(task.manifestEvidenceHash) ||
        !ckbValidationEvidenceIsSha256(task.freshnessEvidenceHash) ||
        !ckbRoutineRawSha256(task.sourceCoverageEvidenceHash) ||
        !ckbRoutineRawSha256(task.inventoryEvidenceHash)) {
        return false
    }
    let txRoot = "transactions/${safeName(pointer.txId)}/metadata"
    let manifest = try {
        ckbParseCangjieVersionManifestArtifact(store.readText(
            "${txRoot}/cangjie-version-manifest.ckb"))
    } catch (_: Exception) { return false }
    let freshness = try {
        ckbParseCangjieFreshnessArtifact(store.readText(
            "${txRoot}/cangjie-freshness.ckb"))
    } catch (_: Exception) { return false }
    let coverage = store.routineReleaseCoverageSummary(
        "${txRoot}/cangjie-release-coverage.ckb")
    if (!coverage.valid ||
        coverage.sourceCoverageEvidenceHash != task.sourceCoverageEvidenceHash ||
        coverage.inventoryEvidenceHash != task.inventoryEvidenceHash) {
        return false
    }
    ckbRoutineReleaseManifestHasExactSources(manifest) &&
        freshness.ok && !freshness.degraded && freshness.sources.size == 5 &&
        freshness.activeKnowledgeVersion == task.activeVersion &&
        freshness.candidateKnowledgeVersion == task.candidateVersion
}

private func ckbRoutineReleaseManifestHasExactSources(manifest: CangjieVersionManifest): Bool {
    if (manifest.degraded || manifest.sources.size != 5) { return false }
    let sources = HashSet<String>()
    for (source in manifest.sources) {
        if (sources.contains(source.sourceSet)) { return false }
        sources.add(source.sourceSet)
    }
    sources.size == 5 && sources.contains(CangjieSourceSets.DOCS) &&
        sources.contains(CangjieSourceSets.STD) &&
        sources.contains(CangjieSourceSets.STDX) &&
        sources.contains(CangjieSourceSets.TOOLS) &&
        sources.contains(CangjieSourceSets.EVAL_SUPPORT)
}

private func ckbRoutineRawSha256(value: String): Bool {
    let runes = value.toRuneArray()
    if (runes.size != 64) { return false }
    for (ch in runes) {
        let digit = ch >= r'0' && ch <= r'9'
        let lowerHex = ch >= r'a' && ch <= r'f'
        let upperHex = ch >= r'A' && ch <= r'F'
        if (!digit && !lowerHex && !upperHex) { return false }
    }
    true
}

private func ckbRoutineArtifactExistsForTask(store: FileKnowledgeStore, config: CkbRuntimeConfig, artifact: String, task: SchedulerTaskResult): Bool {
    if (artifact == "normalized/candidate") {
        return task.candidateVersion != "" && store.has("normalized/candidate/${safeName(task.candidateVersion)}.ckb")
    }
    if (artifact == "gap-curation-input.jsonl") {
        if (config.benchmarkGapCurationInputPath.trimAscii() != "" && exists(Path(config.benchmarkGapCurationInputPath))) {
            return true
        }
        return store.has("metadata/gap-curation-input.jsonl") || store.has("gap-curation-input.jsonl")
    }
    store.has(artifact)
}

private func ckbEnsureManifestReadyForFreshness(store: FileKnowledgeStore, config: CkbRuntimeConfig, manifest: CangjieVersionManifest): CkbFreshnessManifestReadiness {
    let readiness = CkbFreshnessManifestReadiness()
    readiness.manifest = manifest
    for (diagnostic in manifest.diagnostics) {
        readiness.diagnostics.add("manifest_diagnostic:${diagnostic}")
    }
    if (manifest.sources.size > 0 && !cangjieManifestHasOfflineBaseline(manifest) && !ckbManifestHasFreshnessBlockingDiagnostic(manifest)) {
        readiness.ready = true
        readiness.diagnostics.add("manifest_ready_for_freshness")
        return readiness
    }
    if (manifest.sources.size > 0 && ckbManifestHasFreshnessBlockingDiagnostic(manifest)) {
        readiness.diagnostics.add("manifest_blocking_for_freshness")
    } else if (manifest.sources.size > 0 && cangjieManifestHasOfflineBaseline(manifest)) {
        readiness.diagnostics.add("manifest_offline_baseline_for_freshness")
    } else {
        readiness.diagnostics.add("manifest_missing_for_freshness")
    }
    let recovered = ckbRuntimeCangjieVersionManifest(config)
    if (recovered.sources.size > 0 && !cangjieManifestHasOfflineBaseline(recovered)) {
        store.saveCangjieVersionManifest(recovered)
        readiness.manifest = recovered
        readiness.ready = true
        readiness.diagnostics.add("manifest_recovered_for_freshness")
        return readiness
    }
    readiness.ready = false
    readiness.diagnostics.add("manifest_not_ready_for_freshness")
    readiness
}

private func ckbManifestHasFreshnessBlockingDiagnostic(manifest: CangjieVersionManifest): Bool {
    for (diagnostic in manifest.diagnostics) {
        if (diagnostic.contains("version_manifest_invalid_encoding") ||
            diagnostic.contains("version_manifest_malformed") ||
            diagnostic.contains("manifest_source_not_refreshed") ||
            diagnostic.contains("manifest_source_metadata_degraded")) {
            return true
        }
    }
    false
}

public func ckbProfilesForRepositoryChangedEvent(event: GitCodeRepositoryChangedEvent, config: CkbRuntimeConfig): ArrayList<String> {
    let profiles = ArrayList<String>()
    if (event.changedFilesUnavailable || event.changedFiles.size == 0) {
        profiles.add("items")
        return profiles
    }
    var repoSource = false
    var repoList = false
    for (path in event.changedFiles) {
        let lowered = path.toAsciiLower()
        if (ckbRepoListTriggerPath(lowered)) {
            repoList = true
        }
        if (ckbRepositorySourceTriggerPath(lowered)) {
            repoSource = true
        }
    }
    if (repoSource) {
        profiles.add("repo_source_and_items")
    } else {
        profiles.add("items")
    }
    if (repoList) {
        profiles.add("repo_list_refresh")
    }
    profiles
}

public func ckbSchedulerTaskRunnerForRuntime(kb: KnowledgeBase, config: CkbRuntimeConfig, store: FileKnowledgeStore, configPath: String, storePath: String, sourceRunner: SourceFetchRunner): SchedulerTaskRunner {
    let command = getCommand()
    if (ckbSchedulerShouldUseProcessWorker(command)) {
        return ProcessIsolatedSchedulerTaskRunner(kb, config, store, configPath, storePath, sourceRunner, command)
    }
    CkbSchedulerTaskRunner(kb, config, store, sourceRunner: sourceRunner)
}

private func ckbSchedulerShouldUseProcessWorker(command: String): Bool {
    if (getVariable("CKB_SCHEDULER_TASK_WORKER") == Some("1")) {
        return false
    }
    if (getVariable("CKB_DISABLE_SCHEDULER_PROCESS_WORKER") == Some("1")) {
        return false
    }
    let trimmed = command.trimAscii()
    trimmed != "" && (trimmed == "main" || trimmed.endsWith("/main"))
}

private func ckbEmitSchedulerWorkerTypedEvent(store: FileKnowledgeStore,
    runId: String, taskName: String, event: String, status: String,
    workerResultPath: String, workerPid!: Int64 = 0,
    signal!: String = "", lastStage!: String = "",
    diagnostic!: String = ""): Unit {
    if (runId == "" || taskName == "") { return }
    let progress = CkbStagedRebuildStageProgress()
    progress.runId = runId
    progress.taskName = taskName
    progress.stage = "worker"
    progress.status = status
    progress.typedEvent = event
    progress.workerPid = workerPid
    progress.workerResultPath = workerResultPath
    progress.signal = signal
    progress.lastStage = lastStage
    progress.diagnostic = diagnostic
    progress.atMillis = ckbCoreNowMillis()
    FileCkbStagedRebuildStageSink(store, schedulerRunId: runId,
        schedulerTaskName: taskName).onTypedEvent(progress)
}

private func ckbEmitSchedulerWorkerFailureDiagnostic(
    store: FileKnowledgeStore, runId: String, taskName: String,
    status: String): Unit {
    if (runId == "" || taskName == "") { return }
    try {
        store.appendLinesAtomically(
            "metadata/scheduler-runs/${safeName(runId)}-diagnostics.jsonl",
            schedulerDiagnosticJson(runId, taskName, "failed",
                "scheduler_worker_result_unconfirmed:status=${status}"))
    } catch (_: Exception) { () }
}

// A small process boundary shared by scheduler workers and receipt workers.
// The caller owns artifacts and business semantics; this launcher owns only
// command construction, the cutoff watchdog, and child-tree termination.
public class CkbTimedWorkerProcessEnvironment {
    public let name: String
    public let value: String

    public init(name: String, value: String) {
        this.name = name
        this.value = value
    }
}

public class CkbTimedWorkerProcessResult {
    public var exitCode: Int64 = 125
    public var timedOut: Bool = false
    public var pidKilled: Bool = false
    public var workerPid: Int64 = 0
    public var diagnostic: String = "not_started"

    public init() {}
}

public interface CkbTimedWorkerProcessStartObserver {
    func onWorkerStarted(pid: Int64): Bool
}

private class NoopCkbTimedWorkerProcessStartObserver <: CkbTimedWorkerProcessStartObserver {
    public init() {}

    public func onWorkerStarted(pid: Int64): Bool { true }
}

public class CkbTimedWorkerProcessLauncher {
    private let command: String
    private let args: ArrayList<String>
    private let environment: ArrayList<CkbTimedWorkerProcessEnvironment>
    private let workdir: String
    private let cutoffAtMillis: Int64
    private let hardDeadlineAtMillis: Int64
    private let clock: CkbMillisClock
    private let pidPath: String
    private let timeoutMarkerPath: String
    private let startGatePath: String
    private let stdoutPath: String
    private let stderrPath: String
    private let startObserver: CkbTimedWorkerProcessStartObserver

    public init(command: String, args: ArrayList<String>,
        environment!: ArrayList<CkbTimedWorkerProcessEnvironment> = ArrayList<CkbTimedWorkerProcessEnvironment>(),
        workdir!: String = "", cutoffAtMillis!: Int64 = 0,
        hardDeadlineAtMillis!: Int64 = 0,
        clock!: CkbMillisClock = SystemCkbMillisClock(), pidPath!: String = "",
        timeoutMarkerPath!: String = "",
        startGatePath!: String = "",
        stdoutPath!: String = "", stderrPath!: String = "",
        startObserver!: CkbTimedWorkerProcessStartObserver = NoopCkbTimedWorkerProcessStartObserver()) {
        this.command = command
        this.args = args
        this.environment = environment
        this.workdir = workdir
        this.cutoffAtMillis = cutoffAtMillis
        this.hardDeadlineAtMillis = hardDeadlineAtMillis
        this.clock = clock
        this.pidPath = pidPath
        this.timeoutMarkerPath = timeoutMarkerPath
        this.startGatePath = startGatePath
        this.stdoutPath = stdoutPath
        this.stderrPath = stderrPath
        this.startObserver = startObserver
    }

    public func run(): CkbTimedWorkerProcessResult {
        let result = CkbTimedWorkerProcessResult()
        if (this.command.trimAscii() == "") {
            result.diagnostic = "worker_command_missing"
            return result
        }
        let nowMillis = this.clock.nowMillis()
        let effectiveCutoffAtMillis = if (this.cutoffAtMillis > 0) {
            this.cutoffAtMillis
        } else {
            this.hardDeadlineAtMillis
        }
        if (effectiveCutoffAtMillis > 0 && effectiveCutoffAtMillis <= nowMillis) {
            result.timedOut = true
            result.diagnostic = "worker_cutoff_already_exceeded"
            return result
        }
        let timeoutMillis = if (effectiveCutoffAtMillis > 0) {
            effectiveCutoffAtMillis - nowMillis
        } else {
            0
        }
        let timeoutSeconds = if (timeoutMillis <= 0) { 0 } else {
            (timeoutMillis + 999) / 1000
        }
        let markerPath = if (this.timeoutMarkerPath != "") {
            this.timeoutMarkerPath
        } else if (this.pidPath != "") {
            this.pidPath + ".timeout"
        } else {
            ""
        }
        if (timeoutSeconds > 0 && markerPath == "") {
            result.diagnostic = "worker_timeout_marker_missing"
            return result
        }
        var script = ""
        if (markerPath != "") {
            script += "rm -f " + ckbLocalShellQuote(markerPath) + "; "
        }
        script += "( "
        if (this.workdir.trimAscii() != "") {
            // Keep launcher-owned artifact paths relative to the parent while
            // changing directory only inside the worker subshell.
            script += "cd " + ckbLocalShellQuote(this.workdir) + " || exit 125; "
        }
        if (this.startGatePath != "") {
            script += "while ! grep -qx ready " + ckbLocalShellQuote(this.startGatePath) + " 2>/dev/null; do sleep 0.01; done; "
        }
        script += "exec env"
        for (entry in this.environment) {
            script += " " + ckbLocalShellQuote("${entry.name}=${entry.value}")
        }
        script += " " + ckbLocalShellQuote(this.command)
        for (arg in this.args) {
            script += " " + ckbLocalShellQuote(arg)
        }
        script += " )"
        if (this.stdoutPath != "") {
            script += " > " + ckbLocalShellQuote(this.stdoutPath)
        }
        if (this.stderrPath != "") {
            script += " 2> " + ckbLocalShellQuote(this.stderrPath)
        }
        script += " & pid=$!; "
        if (this.pidPath != "") {
            script += "echo workerPid=$pid >> " + ckbLocalShellQuote(this.pidPath) + "; "
        }
        if (timeoutSeconds > 0) {
            script += "( sleep " + ckbLocalShellQuote("${timeoutSeconds}") + "; if kill -0 $pid 2>/dev/null; then : > " + ckbLocalShellQuote(markerPath) + "; pkill -TERM -P $pid 2>/dev/null || true; kill -TERM $pid 2>/dev/null || true; sleep 2; pkill -KILL -P $pid 2>/dev/null || true; kill -KILL $pid 2>/dev/null || true; fi ) & timer=$!; "
        }
        script += "wait $pid; code=$?; "
        if (timeoutSeconds > 0) {
            script += "kill $timer 2>/dev/null || true; "
        }
        if (markerPath != "") {
            script += "if test -f " + ckbLocalShellQuote(markerPath) + "; then rm -f " + ckbLocalShellQuote(markerPath) + "; exit 124; fi; "
        }
        script += "exit $code"
        try {
            let process = launch("/bin/zsh", ["-lc", script],
                stdOut: ProcessRedirect.Pipe, stdErr: ProcessRedirect.Pipe)
            if (this.pidPath != "") {
                for (_ in 0..100) {
                    result.workerPid = ckbTimedWorkerProcessPidFromPath(this.pidPath)
                    if (result.workerPid > 0) { break }
                    sleep(Duration.millisecond * 10)
                }
                if (result.workerPid <= 0) {
                    ckbStopSchedulerLaunchProcess(process.pid)
                    _ = process.wait()
                    result.diagnostic = "worker_start_pid_missing"
                    return result
                }
                if (!this.startObserver.onWorkerStarted(result.workerPid)) {
                    ckbStopSchedulerLaunchProcess(result.workerPid)
                    _ = process.wait()
                    result.diagnostic = "worker_start_observer_rejected"
                    return result
                }
            }
            result.exitCode = process.wait()
            result.timedOut = result.exitCode == 124 ||
                (this.hardDeadlineAtMillis > 0 &&
                    this.clock.nowMillis() >= this.hardDeadlineAtMillis)
            result.pidKilled = result.exitCode == 124
            result.diagnostic = if (result.timedOut) {
                "worker_cutoff_exceeded"
            } else if (result.exitCode == 0) {
                "worker_completed"
            } else {
                "worker_exit_code=${result.exitCode}"
            }
            result
        } catch (_: Exception) {
            result.diagnostic = "worker_launch_failed"
            result
        }
    }
}

private func ckbTimedWorkerProcessPidFromPath(pidPath: String): Int64 {
    if (pidPath == "" || !exists(Path(pidPath))) { return 0 }
    try {
        parseIntField(ckbCurrentField(String.fromUtf8(File.readFrom(Path(pidPath))),
            "workerPid"), 0)
    } catch (_: Exception) { 0 }
}

private class CkbSchedulerWorkerStartObserver <: CkbTimedWorkerProcessStartObserver {
    private let store: FileKnowledgeStore
    private let runId: String
    private let taskName: String
    private let resultRelativePath: String
    private let launchGatePath: String

    public init(store: FileKnowledgeStore, runId: String, taskName: String,
        resultRelativePath: String, launchGatePath: String) {
        this.store = store
        this.runId = runId
        this.taskName = taskName
        this.resultRelativePath = resultRelativePath
        this.launchGatePath = launchGatePath
    }

    public func onWorkerStarted(pid: Int64): Bool {
        ckbEmitSchedulerWorkerTypedEvent(this.store, this.runId, this.taskName,
            "scheduler.worker.started", "running", this.resultRelativePath,
            workerPid: pid)
        try {
            this.store.writeLinesAtomically(this.launchGatePath, "ready\n")
            true
        } catch (_: Exception) {
            ckbEmitSchedulerWorkerFailureDiagnostic(this.store, this.runId,
                this.taskName, "task_worker_launch_gate_write_failed")
            false
        }
    }
}

public class ProcessIsolatedSchedulerTaskRunner <: SchedulerTaskRunner {
    private let kb: KnowledgeBase
    private let config: CkbRuntimeConfig
    private let store: FileKnowledgeStore
    private let configPath: String
    private let storePath: String
    private let sourceRunner: SourceFetchRunner
    private let command: String

    public init(kb: KnowledgeBase, config: CkbRuntimeConfig, store: FileKnowledgeStore, configPath: String, storePath: String, sourceRunner: SourceFetchRunner, command: String) {
        this.kb = kb
        this.config = config
        this.store = store
        this.configPath = configPath
        this.storePath = storePath
        this.sourceRunner = sourceRunner
        this.command = command
    }

    public func runTask(name: String, since: String, deadlineAtMillis: Int64): SchedulerTaskResult {
        let started = ckbTaskWorkerNowMillis()
        let schedulerRunId = ckbSchedulerCurrentRunIdForTask(this.store, name)
        let timeoutMillis = if (deadlineAtMillis > started) { deadlineAtMillis - started } else { 0 }
        if (deadlineAtMillis > 0 && timeoutMillis <= 0) {
            return ckbSchedulerWorkerTimeoutResult(name, since, 0, 0, "task_deadline_already_exceeded")
        }
        if (timeoutMillis <= 0) {
            return CkbSchedulerTaskRunner(this.kb, this.config, this.store, sourceRunner: this.sourceRunner).runTask(name, since, deadlineAtMillis)
        }
        let flushMarginMillis = ckbSchedulerWorkerResultFlushMarginMillisForTask(name)
        let strictFlushReservation = ckbSchedulerWorkerUsesStrictFlushReservation(name)
        let profileSafetyMillis = ckbSyncProfileForScheduleTask(name).unallocatedSafetyMillis
        let workerDeadlineAtMillis = ckbSchedulerWorkerSoftDeadlineAtMillis(deadlineAtMillis, flushMarginMillis, nowMillis: started, strictReservation: strictFlushReservation, safetyMillis: profileSafetyMillis)
        let resultRelativePath = ckbTaskWorkerResultRelativePath(name)
        if (workerDeadlineAtMillis <= started) {
            if (name == "cangjie_release_full_sync") {
                return ckbWriteSchedulerTaskBootstrapDeadlineFailure(this.store, name, since, workerDeadlineAtMillis, resultRelativePath, schedulerRunId, started)
            }
            return ckbWriteSchedulerWorkerTimeoutCompensation(this.store, resultRelativePath, name, since, 0, timeoutMillis, "worker_soft_deadline_already_exceeded", lastStage: "task_deadline_already_exceeded", schedulerRunId: schedulerRunId)
        }
        let workerHeap = ckbSchedulerWorkerCjHeapSizeForTask(name)
        let startedText = ckbTaskWorkerStartedText(name, since, workerDeadlineAtMillis, resultRelativePath, started, schedulerRunId: schedulerRunId, commandHash: stableSummaryHash(this.command), dyldLibraryPath: ckbSchedulerWorkerDyldLibraryPath(), cjHeapSize: workerHeap)
        this.store.writeLinesAtomically(resultRelativePath, startedText)
        this.store.writeLinesAtomically("${resultRelativePath}.started", startedText)
        let code = this.launchWorker(name, since, workerDeadlineAtMillis, resultRelativePath, timeoutMillis, workerHeap, schedulerRunId)
        let elapsed = ckbTaskWorkerNowMillis() - started
        let workerPid = ckbSchedulerWorkerPidFromStarted(this.storePath, resultRelativePath)
        let outSnippet = ckbSchedulerWorkerArtifactSnippet(this.storePath, resultRelativePath + ".out")
        let errSnippet = ckbSchedulerWorkerArtifactSnippet(this.storePath, resultRelativePath + ".err")
        let parsed = ckbReadSchedulerWorkerResult(this.storePath, resultRelativePath, name, since, elapsed, timeoutMillis, schedulerRunId: schedulerRunId, strictIdentity: true)
        let artifactClass = ckbClassifyWorkerArtifact(outSnippet, errSnippet)
        if (!ckbSchedulerWorkerResultNeedsFailureHandling(parsed.status)) {
            if (parsed.timeBudgetMillis <= 0) {
                parsed.timeBudgetMillis = timeoutMillis
            }
            if (parsed.durationMillis <= 0) {
                parsed.durationMillis = elapsed
            }
            if (parsed.workerPid <= 0) {
                parsed.workerPid = workerPid
            }
            if (parsed.workerOutSnippet == "") {
                parsed.workerOutSnippet = outSnippet
            }
            if (parsed.workerErrSnippet == "") {
                parsed.workerErrSnippet = errSnippet
            }
            if (artifactClass != "") {
                parsed.validationDiagnostics.add("${name}:worker_artifact:${artifactClass}")
            }
            ckbEmitSchedulerWorkerTypedEvent(this.store, schedulerRunId,
                name, "scheduler.worker.result_written", parsed.status,
                resultRelativePath, workerPid: workerPid)
            return ckbApplySchedulerProcessWallTiming(parsed, started, ckbTaskWorkerNowMillis())
        }
        if ((code == 124 || elapsed >= timeoutMillis) && ckbSchedulerWorkerResultAllowsTimeoutCompensation(parsed.status)) {
            let timeoutDiagnostic = if (artifactClass == "") { "task_worker_hard_timeout:${parsed.status}" } else { "task_worker_hard_timeout:${parsed.status}:${artifactClass}" }
            let storeStage = ckbSchedulerWorkerLastStageFromStoreForTask(this.store, name)
            let lastStage = if (storeStage != "") { storeStage } else { ckbSchedulerWorkerLastStageFromArtifacts(outSnippet, errSnippet) }
            let compensated = ckbWriteSchedulerWorkerTimeoutCompensation(this.store, resultRelativePath, name, since, elapsed, timeoutMillis, timeoutDiagnostic, lastStage: lastStage, lastProgress: ckbSchedulerWorkerLastProgressFromStoreForTask(this.store, name), workerPid: workerPid, outSnippet: outSnippet, errSnippet: errSnippet, schedulerRunId: schedulerRunId)
            ckbEmitSchedulerWorkerTypedEvent(this.store, schedulerRunId,
                name, "scheduler.worker.killed", compensated.status,
                resultRelativePath, workerPid: workerPid,
                signal: "SIGTERM/SIGKILL", lastStage: lastStage,
                diagnostic: timeoutDiagnostic)
            let confirmed = ckbReadSchedulerWorkerResult(this.storePath,
                resultRelativePath, name, since, elapsed, timeoutMillis,
                schedulerRunId: schedulerRunId, strictIdentity: true)
            if (!ckbSchedulerWorkerArtifactReadFailure(confirmed.status)) {
                ckbEmitSchedulerWorkerTypedEvent(this.store, schedulerRunId,
                    name, "scheduler.worker.result_written",
                    confirmed.status, resultRelativePath,
                    workerPid: workerPid)
            } else {
                ckbEmitSchedulerWorkerFailureDiagnostic(this.store,
                    schedulerRunId, name, confirmed.status)
            }
            return ckbApplySchedulerProcessWallTiming(compensated, started, ckbTaskWorkerNowMillis())
        }
        if (ckbSchedulerWorkerResultNeedsFailureHandling(parsed.status)) {
            parsed.workerPid = workerPid
            parsed.workerOutSnippet = outSnippet
            parsed.workerErrSnippet = errSnippet
            if (ckbSchedulerWorkerResultAllowsArtifactClassification(parsed.status) && artifactClass == "worker_out_of_memory") {
                parsed.status = "task_worker_out_of_memory"
                parsed.validationDiagnostics.add("${name}:task_worker_out_of_memory")
            }
            if (ckbSchedulerWorkerResultAllowsArtifactClassification(parsed.status) && artifactClass == "worker_dynamic_library_missing") {
                parsed.status = "task_worker_dynamic_library_missing"
                parsed.validationDiagnostics.add("${name}:task_worker_dynamic_library_missing")
            }
            if (parsed.lastStage == "") {
                let storeStage = ckbSchedulerWorkerLastStageFromStoreForTask(this.store, name)
                parsed.lastStage = if (storeStage != "") { storeStage } else { ckbSchedulerWorkerLastStageFromArtifacts(outSnippet, errSnippet) }
            }
            if (parsed.lastProgress == "") {
                parsed.lastProgress = ckbSchedulerWorkerLastProgressFromStoreForTask(this.store, name)
            }
            if (artifactClass != "") {
                parsed.validationDiagnostics.add("${name}:worker_artifact:${artifactClass}")
            }
            ckbEmitSchedulerWorkerFailureDiagnostic(this.store,
                schedulerRunId, name, parsed.status)
            return ckbApplySchedulerProcessWallTiming(parsed, started, ckbTaskWorkerNowMillis())
        }
        ckbApplySchedulerProcessWallTiming(parsed, started, ckbTaskWorkerNowMillis())
    }

    private func launchWorker(name: String, since: String, deadlineAtMillis: Int64, resultRelativePath: String, timeoutMillis: Int64, workerHeap: String, schedulerRunId: String): Int64 {
        let resultPath = Path(this.storePath).join(resultRelativePath).toString()
        let outPath = resultPath + ".out"
        let errPath = resultPath + ".err"
        let launchGatePath = resultPath + ".launch"
        _ = launch("/bin/rm", ["-f", launchGatePath]).wait()
        let args = ArrayList<String>()
        if (this.configPath.trimAscii() != "") {
            args.add("--config")
            args.add(this.configPath)
        }
        args.add("--store")
        args.add(this.storePath)
        args.add("scheduler-task-worker")
        args.add("--task")
        args.add(name)
        args.add("--scheduler-run-id")
        args.add(schedulerRunId)
        args.add("--since")
        args.add(since)
        args.add("--deadline")
        args.add("${deadlineAtMillis}")
        args.add("--result-rel")
        args.add(resultRelativePath)
        let environment = ArrayList<CkbTimedWorkerProcessEnvironment>()
        environment.add(CkbTimedWorkerProcessEnvironment(
            "CKB_SCHEDULER_TASK_WORKER", "1"))
        let dyldLibraryPath = ckbSchedulerWorkerDyldLibraryPath()
        if (dyldLibraryPath.trimAscii() != "") {
            environment.add(CkbTimedWorkerProcessEnvironment("DYLD_LIBRARY_PATH",
                dyldLibraryPath))
        }
        if (workerHeap.trimAscii() != "") {
            environment.add(CkbTimedWorkerProcessEnvironment("cjHeapSize", workerHeap))
        }
        let launcher = CkbTimedWorkerProcessLauncher(this.command, args,
            environment: environment, cutoffAtMillis: deadlineAtMillis,
            hardDeadlineAtMillis: deadlineAtMillis,
            pidPath: resultPath + ".started", timeoutMarkerPath: resultPath + ".timeout",
            startGatePath: launchGatePath, stdoutPath: outPath, stderrPath: errPath,
            startObserver: CkbSchedulerWorkerStartObserver(this.store, schedulerRunId,
                name, resultRelativePath, "${resultRelativePath}.launch"))
        let launched = launcher.run()
        _ = launch("/bin/rm", ["-f", launchGatePath]).wait()
        if (launched.diagnostic == "worker_start_pid_missing") {
            ckbEmitSchedulerWorkerFailureDiagnostic(this.store, schedulerRunId, name,
                "task_worker_start_pid_missing")
        }
        if (launched.timedOut) { 124 } else { launched.exitCode }
    }
}

public func ckbApplySchedulerProcessWallTiming(task: SchedulerTaskResult, startedAtMillis: Int64, endedAtMillis: Int64): SchedulerTaskResult {
    task.startedAtMillis = startedAtMillis
    task.endedAtMillis = if (endedAtMillis >= startedAtMillis) { endedAtMillis } else { startedAtMillis }
    task.durationMillis = task.endedAtMillis - task.startedAtMillis
    task
}

private func ckbSchedulerWorkerDyldLibraryPath(): String {
    if (let Some(value) <- getVariable("DYLD_LIBRARY_PATH")) {
        return value
    }
    ""
}

private func ckbSchedulerWorkerCjHeapSize(): String {
    if (let Some(value) <- getVariable("cjHeapSize")) {
        return value
    }
    ""
}

private func ckbSchedulerWorkerCjHeapSizeForTask(taskName: String): String {
    ckbSchedulerDefaultCjHeapSizeForTask(taskName, ckbSchedulerWorkerCjHeapSize())
}

public func ckbSchedulerDefaultCjHeapSizeForTask(taskName: String, configuredHeap: String): String {
    let configured = configuredHeap.trimAscii()
    if (configured != "") {
        return configured
    }
    if (ckbSchedulerTaskNeedsRoutineHeap(taskName)) {
        return "4GB"
    }
    ""
}

private func ckbSchedulerTaskNeedsRoutineHeap(taskName: String): Bool {
    if (taskName == "weekly_full_rebuild") {
        return true
    }
    let profile = ckbSyncProfileForScheduleTask(taskName)
    profile.candidateMode == "candidate_validate_promote" ||
        profile.candidateMode == "curated_candidate_validate_promote"
}

public func ckbSchedulerWorkerShellPrelude(dyldLibraryPath: String): String {
    ckbSchedulerWorkerShellPreludeWithHeap(dyldLibraryPath, ckbSchedulerWorkerCjHeapSize())
}

public func ckbSchedulerWorkerShellPreludeWithHeap(dyldLibraryPath: String, cjHeapSize: String): String {
    var script = "export CKB_SCHEDULER_TASK_WORKER=1; "
    let heap = cjHeapSize.trimAscii()
    if (heap != "") {
        script += "export cjHeapSize=" + ckbLocalShellQuote(heap) + "; "
    }
    let trimmed = dyldLibraryPath.trimAscii()
    if (trimmed != "") {
        script += "export DYLD_LIBRARY_PATH=" + ckbLocalShellQuote(trimmed) + "; "
    }
    script
}

private func ckbSchedulerWorkerPidFromStarted(storePath: String, resultRelativePath: String): Int64 {
    let startedPath = Path(storePath).join(resultRelativePath + ".started")
    if (!exists(startedPath)) {
        return 0
    }
    try {
        parseIntField(ckbCurrentField(String.fromUtf8(File.readFrom(startedPath)), "workerPid"), 0)
    } catch (_: Exception) {
        0
    }
}

private func ckbStopSchedulerLaunchProcess(pid: Int64): Unit {
    if (pid <= 0) { return }
    _ = launch("/bin/sh", ["-c",
        "pkill -TERM -P ${pid} 2>/dev/null || true; kill -TERM ${pid} 2>/dev/null || true; pkill -KILL -P ${pid} 2>/dev/null || true; kill -KILL ${pid} 2>/dev/null || true"]).wait()
}

private func ckbSchedulerWorkerArtifactSnippet(storePath: String, relativePath: String): String {
    let path = Path(storePath).join(relativePath)
    if (!exists(path)) {
        return ""
    }
    try {
        utf8SafePrefix(redactSensitive(String.fromUtf8(File.readFrom(path)).replace("\n", " ").replace("\r", " ").trimAscii()), 240)
    } catch (_: Exception) {
        "invalid_response_encoding"
    }
}

private func ckbSchedulerWorkerLastStageFromArtifacts(outSnippet: String, errSnippet: String): String {
    let artifactClass = ckbClassifyWorkerArtifact(outSnippet, errSnippet)
    if (artifactClass != "") {
        return artifactClass
    }
    "worker_timeout"
}

private func ckbSchedulerWorkerLastStageFromStore(store: FileKnowledgeStore): String {
    ckbSchedulerWorkerLastStageFromStoreForTask(store, "")
}

private class CkbSchedulerWorkerProgressSelection {
    var identityAvailable: Bool = false
    var identityMatches: Bool = false
    var valid: Bool = false
    var atMillis: Int64 = 0
    var priority: Int64 = 0
    var stage: String = ""
    var progress: String = ""

    init() {}
}

public func ckbSchedulerWorkerLastStageFromStoreForTask(store: FileKnowledgeStore, taskName: String): String {
    let selection = ckbSchedulerWorkerLatestScopedSelection(store, taskName)
    if (selection.valid) {
        return selection.stage
    }
    if (selection.identityAvailable && !selection.identityMatches) {
        return ""
    }
    if (selection.identityAvailable) {
        return ""
    }
    let routineStage = ckbSchedulerRoutineCheckpointStageFromStoreForTask(store, taskName)
    if (routineStage != "") {
        return routineStage
    }
    let runId = ckbSchedulerCurrentRunId(store)
    let currentTaskName = ckbSchedulerCurrentTaskName(store)
    let scopedTaskName = if (taskName.trimAscii() != "") { taskName } else { currentTaskName }
    let allowGlobalStage = taskName.trimAscii() == "" && (scopedTaskName == "" || scopedTaskName == currentTaskName)
    let stagedPath = ckbSchedulerScopedStagedRebuildCurrentPath(runId, scopedTaskName)
    let scopedStagedCurrent = if (stagedPath != "") { ckbSchedulerReadProgressArtifact(store, stagedPath) } else { "" }
    let stagedCurrent = if (scopedStagedCurrent != "") {
        scopedStagedCurrent
    } else if (allowGlobalStage) {
        ckbSchedulerReadProgressArtifact(store, "metadata/staged-rebuild-current.ckb")
    } else {
        ""
    }
    let stagedStage = ckbCurrentField(stagedCurrent, "stage")
    if (stagedStage != "") {
        return stagedStage
    }
    let scopedVectorPath = ckbSchedulerScopedVectorCurrentPath(runId, scopedTaskName)
    let scopedVectorCurrent = if (scopedVectorPath != "") { ckbSchedulerReadProgressArtifact(store, scopedVectorPath) } else { "" }
    let vectorCurrent = if (scopedVectorCurrent != "") {
        scopedVectorCurrent
    } else if (allowGlobalStage) {
        ckbSchedulerReadProgressArtifact(store, "metadata/vector-reconcile-current.ckb")
    } else {
        ""
    }
    let vectorState = ckbCurrentField(vectorCurrent, "state")
    if (vectorState != "") {
        return "vector_${vectorState}"
    }
    ""
}

public func ckbClassifyWorkerArtifact(outSnippet: String, errSnippet: String): String {
    let combined = "${outSnippet} ${errSnippet}".toAsciiLower()
    if (combined.contains("ckb_scheduler_task_timeout")) {
        return "worker_hard_timeout"
    }
    if (combined.contains("out of memory") || combined.contains("outofmemory") || combined.contains("memory allocation failed")) {
        return "worker_out_of_memory"
    }
    if (combined.contains("library not loaded") || combined.contains("image not found") || combined.contains("libstdx") || combined.contains("@rpath")) {
        return "worker_dynamic_library_missing"
    }
    if (combined.contains("httptimeoutexception") || combined.contains("read response timeout") || combined.contains("timeout")) {
        return "native_http_timeout"
    }
    if (combined.contains("qdrant")) {
        return "qdrant"
    }
    if (combined.contains("ollama")) {
        return "ollama_embedding"
    }
    if (combined.trimAscii() != "") {
        return "worker_artifact"
    }
    ""
}

public func ckbSchedulerWorkerLastProgressFromStoreForTask(store: FileKnowledgeStore, taskName: String): String {
    let selection = ckbSchedulerWorkerLatestScopedSelection(store, taskName)
    if (selection.valid) {
        return selection.progress
    }
    if (selection.identityAvailable && !selection.identityMatches) {
        return ""
    }
    if (selection.identityAvailable) {
        let schedulerCurrent = ckbSchedulerReadProgressArtifact(store, "metadata/scheduler-current.ckb")
        if (schedulerCurrent != "") {
            return "scheduler:status=${ckbCurrentField(schedulerCurrent, "status")},taskName=${ckbCurrentField(schedulerCurrent, "taskName")},progressPath=${ckbCurrentField(schedulerCurrent, "progressPath")}"
        }
        return ""
    }
    let routineSummary = ckbSchedulerRoutineCheckpointProgressFromStoreForTask(store, taskName)
    if (routineSummary != "") {
        return routineSummary
    }
    let runId = ckbSchedulerCurrentRunId(store)
    let currentTaskName = ckbSchedulerCurrentTaskName(store)
    let scopedTaskName = if (taskName.trimAscii() != "") { taskName } else { currentTaskName }
    let allowGlobalProgress = taskName.trimAscii() == "" && (scopedTaskName == "" || scopedTaskName == currentTaskName)
    let isManifestOnlyTask = scopedTaskName == "cangjie_version_branch_refresh"
    let stagedPath = ckbSchedulerScopedStagedRebuildCurrentPath(runId, scopedTaskName)
    let scopedStagedCurrent = if (stagedPath != "") { ckbSchedulerReadProgressArtifact(store, stagedPath) } else { "" }
    let stagedCurrent = if (scopedStagedCurrent != "") {
        scopedStagedCurrent
    } else if (allowGlobalProgress && !isManifestOnlyTask) {
        ckbSchedulerReadProgressArtifact(store, "metadata/staged-rebuild-current.ckb")
    } else {
        ""
    }
    let stagedSummary = ckbStagedRebuildCurrentProgressSummary(stagedCurrent)
    if (stagedSummary != "") {
        return stagedSummary
    }
    let scopedPath = ckbSchedulerScopedVectorCurrentPath(runId, scopedTaskName)
    let scopedVectorCurrent = if (scopedPath != "") { ckbSchedulerReadProgressArtifact(store, scopedPath) } else { "" }
    let vectorCurrent = if (scopedVectorCurrent != "") {
        scopedVectorCurrent
    } else if (allowGlobalProgress && !isManifestOnlyTask) {
        ckbSchedulerReadProgressArtifact(store, "metadata/vector-reconcile-current.ckb")
    } else {
        ""
    }
    if (vectorCurrent != "") {
        let state = ckbCurrentField(vectorCurrent, "state")
        let completed = ckbCurrentField(vectorCurrent, "completed")
        let currentBatch = ckbCurrentField(vectorCurrent, "currentBatch")
        let progressPath = ckbCurrentField(vectorCurrent, "progressPath")
        if (state != "" || completed != "" || currentBatch != "") {
            return "vector:state=${state},completed=${completed},currentBatch=${currentBatch},progressPath=${progressPath}"
        }
    }
    let schedulerCurrent = ckbSchedulerReadProgressArtifact(store, "metadata/scheduler-current.ckb")
    if (schedulerCurrent != "") {
        return "scheduler:status=${ckbCurrentField(schedulerCurrent, "status")},taskName=${ckbCurrentField(schedulerCurrent, "taskName")},progressPath=${ckbCurrentField(schedulerCurrent, "progressPath")}"
    }
    ""
}

private func ckbSchedulerWorkerLatestScopedSelection(store: FileKnowledgeStore, taskName: String): CkbSchedulerWorkerProgressSelection {
    let selection = CkbSchedulerWorkerProgressSelection()
    let schedulerCurrent = ckbSchedulerReadProgressArtifact(store, "metadata/scheduler-current.ckb")
    let runId = ckbCurrentField(schedulerCurrent, "runId")
    let currentTaskName = ckbCurrentField(schedulerCurrent, "taskName")
    let effectiveTaskName = if (taskName.trimAscii() != "") { taskName } else { currentTaskName }
    selection.identityAvailable = runId != "" && currentTaskName != ""
    selection.identityMatches = selection.identityAvailable && effectiveTaskName != "" && currentTaskName == effectiveTaskName
    if (!selection.identityMatches) {
        return selection
    }
    let profile = ckbSyncProfileForScheduleTask(effectiveTaskName)
    for (stage in ckbSchedulerRoutineCheckpointStagePriority(profile.profile)) {
        let scopedPath = ckbSchedulerScopedRoutineStageCurrentPath(runId, effectiveTaskName, stage)
        let scopedText = ckbSchedulerReadProgressArtifact(store, scopedPath)
        ckbSchedulerConsiderProgressSelection(selection, scopedText, runId, effectiveTaskName, "runId", "taskName", if (ckbCurrentField(scopedText, "stage") != "") { ckbCurrentField(scopedText, "stage") } else { stage }, ckbRoutineCheckpointProgressSummary(scopedText), 1)
        let profileCurrentText = ckbSchedulerReadProgressArtifact(store, "metadata/routine-stage-checkpoints/${safeName(profile.profile)}-${safeName(stage)}.ckb")
        ckbSchedulerConsiderProgressSelection(selection, profileCurrentText, runId, effectiveTaskName, "runId", "taskName", if (ckbCurrentField(profileCurrentText, "stage") != "") { ckbCurrentField(profileCurrentText, "stage") } else { stage }, ckbRoutineCheckpointProgressSummary(profileCurrentText), 1)
    }
    let stagedText = ckbSchedulerReadProgressArtifact(store, ckbSchedulerScopedStagedRebuildCurrentPath(runId, effectiveTaskName))
    ckbSchedulerConsiderProgressSelection(selection, stagedText, runId, effectiveTaskName, "runId", "taskName", ckbCurrentField(stagedText, "stage"), ckbStagedRebuildCurrentProgressSummary(stagedText), 3)
    let vectorText = ckbSchedulerReadProgressArtifact(store, ckbSchedulerScopedVectorCurrentPath(runId, effectiveTaskName))
    let vectorState = ckbCurrentField(vectorText, "state")
    let vectorSummary = if (vectorState != "") {
        "vector:state=${vectorState},completed=${ckbCurrentField(vectorText, "completed")},currentBatch=${ckbCurrentField(vectorText, "currentBatch")},progressPath=${ckbCurrentField(vectorText, "progressPath")}"
    } else {
        ""
    }
    ckbSchedulerConsiderProgressSelection(selection, vectorText, runId, effectiveTaskName, "schedulerRunId", "schedulerTaskName", if (vectorState != "") { "vector_${vectorState}" } else { "" }, vectorSummary, 2)
    selection
}

private func ckbSchedulerConsiderProgressSelection(selection: CkbSchedulerWorkerProgressSelection, text: String, runId: String, taskName: String, runField: String, taskField: String, stage: String, progress: String, priority: Int64): Unit {
    if (text == "" || stage == "" || progress == "") {
        return
    }
    if (ckbCurrentField(text, runField) != runId || ckbCurrentField(text, taskField) != taskName) {
        return
    }
    let atMillis = parseIntField(ckbCurrentField(text, "atMillis"), 0)
    if (atMillis <= 0 || (selection.valid && (atMillis < selection.atMillis || (atMillis == selection.atMillis && priority <= selection.priority)))) {
        return
    }
    selection.valid = true
    selection.atMillis = atMillis
    selection.priority = priority
    selection.stage = stage
    selection.progress = utf8SafePrefix(redactSensitive(progress), 240)
}

private func ckbSchedulerReadProgressArtifact(store: FileKnowledgeStore, relativePath: String): String {
    if (relativePath == "") {
        return ""
    }
    try {
        store.readText(relativePath)
    } catch (_: Exception) {
        ""
    }
}

private func ckbSchedulerWorkerLastProgressFromStore(store: FileKnowledgeStore): String {
    ckbSchedulerWorkerLastProgressFromStoreForTask(store, ckbSchedulerCurrentTaskName(store))
}

private func ckbSchedulerRoutineCheckpointProgressFromStoreForTask(store: FileKnowledgeStore, taskName: String): String {
    let profile = ckbSyncProfileForScheduleTask(taskName)
    if (profile.profile == "") {
        return ""
    }
    for (stage in ckbSchedulerRoutineCheckpointStagePriority(profile.profile)) {
        let text = ckbSchedulerReadProgressArtifact(store, "metadata/routine-stage-checkpoints/${safeName(profile.profile)}-${safeName(stage)}.ckb")
        let summary = ckbRoutineCheckpointProgressSummary(text)
        if (summary != "") {
            return summary
        }
    }
    ""
}

private func ckbSchedulerRoutineCheckpointStageFromStoreForTask(store: FileKnowledgeStore, taskName: String): String {
    let profile = ckbSyncProfileForScheduleTask(taskName)
    if (profile.profile == "") {
        return ""
    }
    for (stage in ckbSchedulerRoutineCheckpointStagePriority(profile.profile)) {
        let text = ckbSchedulerReadProgressArtifact(store, "metadata/routine-stage-checkpoints/${safeName(profile.profile)}-${safeName(stage)}.ckb")
        if (ckbRoutineCheckpointProgressSummary(text) != "") {
            let currentStage = ckbCurrentField(text, "stage")
            return if (currentStage != "") { currentStage } else { stage }
        }
    }
    ""
}

private func ckbSchedulerRoutineCheckpointStagePriority(profile: String): ArrayList<String> {
    let stages = ArrayList<String>()
    if (profile == "cangjie_version_branch_refresh") {
        stages.add("ingest_finished")
        stages.add("ingest_started")
        stages.add("fetch_content_sample")
        stages.add("fetch_tree_page")
        stages.add("fetch_source_finished")
        stages.add("fetch_source_started")
        stages.add("fetch")
    } else if (profile == "cangjie_docs_full_sync" || profile == "cangjie_release_full_sync" || profile == "cangjie_source_event_sync") {
        stages.add("active_snapshot_manifest_after")
        stages.add("active_snapshot_manifest_before")
        stages.add("active_snapshot_tx_graph_after")
        stages.add("active_snapshot_tx_graph_before")
        stages.add("active_snapshot_tx_vector_after")
        stages.add("active_snapshot_tx_vector_before")
        stages.add("active_snapshot_tx_normalized_after")
        stages.add("active_snapshot_tx_normalized_before")
        stages.add("candidate_active_snapshot_finished")
        stages.add("candidate_active_snapshot_started")
        stages.add("candidate_active_commit_finished")
        stages.add("candidate_active_commit_started")
        stages.add("candidate_validation_finished")
        stages.add("candidate_validation_started")
        stages.add("candidate_vector_finished")
        stages.add("candidate_vector_started")
        stages.add("ingest_finished")
        stages.add("ingest_started")
        stages.add("fetch_content_sample")
        stages.add("fetch_tree_page")
        stages.add("fetch_source_finished")
        stages.add("fetch_source_started")
        stages.add("fetch")
    } else if (profile == "cangjie_benchmark_gap_curation") {
        stages.add("proof_finished")
        stages.add("proof_started")
        stages.add("promotion_finished")
        stages.add("promotion_started")
        stages.add("input_parsed")
        stages.add("ingest_started")
        stages.add("fetch")
    } else if (profile != "") {
        stages.add("ingest_finished")
        stages.add("ingest_started")
        stages.add("fetch")
    }
    stages
}

private func ckbRoutineCheckpointProgressSummary(text: String): String {
    if (text.trimAscii() == "") {
        return ""
    }
    let profile = ckbCurrentField(text, "profile")
    let stage = ckbCurrentField(text, "stage")
    let status = ckbCurrentField(text, "status")
    let remaining = ckbCurrentField(text, "remainingMillis")
    let diagnostic = ckbCurrentField(text, "diagnostic")
    if (profile == "" && stage == "" && status == "" && diagnostic == "") {
        return ""
    }
    utf8SafePrefix(redactSensitive("routine:profile=${profile},stage=${stage},status=${status},remainingMs=${remaining},diagnostic=${diagnostic}"), 240)
}

private func ckbReadSchedulerWorkerResult(storePath: String, resultRelativePath: String, name: String, since: String, durationMillis: Int64, timeoutMillis: Int64, schedulerRunId!: String = "", strictIdentity!: Bool = false): SchedulerTaskResult {
    let sidecarRelativePath = "${resultRelativePath}.sidecar"
    let sidecarPath = Path(storePath).join(sidecarRelativePath)
    if (exists(sidecarPath)) {
        let sidecar = ckbReadSchedulerWorkerResultArtifact(storePath, sidecarRelativePath, name, since, durationMillis, timeoutMillis, schedulerRunId, strictIdentity, true)
        if (!strictIdentity || !ckbSchedulerWorkerArtifactReadFailure(sidecar.status)) {
            return sidecar
        }
        return ckbSchedulerWorkerPrimaryRecoveryResult(storePath, resultRelativePath,
            name, since, durationMillis, timeoutMillis, schedulerRunId, sidecar.status)
    }
    if (strictIdentity) {
        return ckbSchedulerWorkerPrimaryRecoveryResult(storePath, resultRelativePath,
            name, since, durationMillis, timeoutMillis, schedulerRunId,
            "task_worker_sidecar_missing")
    }
    ckbReadSchedulerWorkerResultArtifact(storePath, resultRelativePath, name, since, durationMillis, timeoutMillis, schedulerRunId, strictIdentity, false)
}

private func ckbSchedulerWorkerPrimaryRecoveryResult(storePath: String,
    resultRelativePath: String, name: String, since: String, durationMillis: Int64,
    timeoutMillis: Int64, schedulerRunId: String, sidecarStatus: String): SchedulerTaskResult {
        let primary = ckbReadSchedulerWorkerResultArtifact(storePath, resultRelativePath, name, since, durationMillis, timeoutMillis, schedulerRunId, true, false)
        let failure = ckbSchedulerWorkerFailureResult(name, since, durationMillis, timeoutMillis, sidecarStatus)
        failure.schedulerRunId = schedulerRunId
        failure.validationDiagnostics.add("${name}:primary_recovery_status:${utf8SafePrefix(redactSensitive(primary.status), 80)}")
        if (!ckbSchedulerWorkerArtifactReadFailure(primary.status)) {
            // Strict mode rejects an unconfirmed primary as a protocol result,
            // but must retain its business truth for diagnosis and retry.
            failure.businessStatus = primary.businessStatus
            failure.primaryFailure = primary.primaryFailure
            failure.finalizationStatus = "task_worker_sidecar_missing"
            failure.finalizationFailure = "task_worker_sidecar_missing"
            failure.lastStage = utf8SafePrefix(redactSensitive(primary.lastStage), 120)
            failure.lastProgress = utf8SafePrefix(redactSensitive(primary.lastProgress), 240)
            failure.workerPid = primary.workerPid
        }
        failure
}

private func ckbReadSchedulerWorkerResultArtifact(storePath: String, relativePath: String, name: String, since: String, durationMillis: Int64, timeoutMillis: Int64, schedulerRunId: String, strictIdentity: Bool, sidecar: Bool): SchedulerTaskResult {
    let path = Path(storePath).join(relativePath)
    let prefix = if (sidecar) { "task_worker_sidecar" } else { "task_worker_result" }
    if (!exists(path)) {
        return ckbSchedulerWorkerFailureResult(name, since, durationMillis, timeoutMillis, "${prefix}_missing")
    }
    let text = try {
        String.fromUtf8(File.readFrom(path))
    } catch (_: Exception) {
        return ckbSchedulerWorkerFailureResult(name, since, durationMillis, timeoutMillis, "${prefix}_invalid_response_encoding")
    }
    try {
        let task = ckbSchedulerTaskResultFromText(text)
        if (task.status == "worker_started") {
            return ckbSchedulerWorkerFailureResult(name, since, durationMillis, timeoutMillis, "${prefix}_incomplete")
        }
        if (task.status == "not_started") {
            return ckbSchedulerWorkerFailureResult(name, since, durationMillis, timeoutMillis, "${prefix}_malformed")
        }
        if (strictIdentity && schedulerRunId != "" && task.schedulerRunId != schedulerRunId) {
            return ckbSchedulerWorkerFailureResult(name, since, durationMillis, timeoutMillis, "${prefix}_run_mismatch")
        }
        if (strictIdentity && task.schedulerTaskName != name) {
            return ckbSchedulerWorkerFailureResult(name, since, durationMillis, timeoutMillis, "${prefix}_task_mismatch")
        }
        if (sidecar && task.resultWrittenAtMillis <= 0) {
            return ckbSchedulerWorkerFailureResult(name, since, durationMillis, timeoutMillis, "task_worker_sidecar_unconfirmed")
        }
        task
    } catch (_: Exception) {
        ckbSchedulerWorkerFailureResult(name, since, durationMillis, timeoutMillis, "${prefix}_malformed")
    }
}

private func ckbSchedulerWorkerArtifactReadFailure(status: String): Bool {
    status == "task_worker_result_missing" || status == "task_worker_result_malformed" || status == "task_worker_result_invalid_response_encoding" || status == "task_worker_result_incomplete" ||
        status == "task_worker_result_run_mismatch" || status == "task_worker_result_task_mismatch" ||
        status == "task_worker_sidecar_missing" || status == "task_worker_sidecar_malformed" || status == "task_worker_sidecar_invalid_response_encoding" || status == "task_worker_sidecar_incomplete" ||
        status == "task_worker_sidecar_run_mismatch" || status == "task_worker_sidecar_task_mismatch" || status == "task_worker_sidecar_unconfirmed"
}

private func ckbSchedulerWorkerResultNeedsFailureHandling(status: String): Bool {
    ckbSchedulerWorkerArtifactReadFailure(status)
}

private func ckbSchedulerWorkerResultAllowsTimeoutCompensation(status: String): Bool {
    status == "task_worker_result_missing" || status == "task_worker_result_incomplete" ||
        status == "task_worker_sidecar_missing" || status == "task_worker_sidecar_incomplete"
}

private func ckbSchedulerWorkerResultAllowsArtifactClassification(status: String): Bool {
    ckbSchedulerWorkerResultAllowsTimeoutCompensation(status) || status == "task_worker_result_malformed"
}

private func ckbSchedulerWorkerResultMissingOrEmpty(storePath: String, resultRelativePath: String): Bool {
    let path = Path(storePath).join(resultRelativePath)
    if (!exists(path)) {
        return true
    }
    try {
        File.readFrom(path).size == 0
    } catch (_: Exception) {
        true
    }
}

private func ckbSchedulerWorkerFailureResult(name: String, since: String, durationMillis: Int64, timeoutMillis: Int64, status: String): SchedulerTaskResult {
    let task = SchedulerTaskResult()
    let ended = ckbTaskWorkerNowMillis()
    task.ok = false
    task.status = status
    task.since = since
    task.schedulerTaskName = name
    task.durationMillis = durationMillis
    task.timeBudgetMillis = timeoutMillis
    task.endedAtMillis = ended
    task.startedAtMillis = if (durationMillis > 0 && ended > durationMillis) { ended - durationMillis } else { ended }
    task.deadlineAtMillis = if (timeoutMillis > 0) { task.startedAtMillis + timeoutMillis } else { 0 }
    task.validationDiagnostics.add("${name}:${status}")
    task
}

private func ckbSchedulerWorkerTimeoutResult(name: String, since: String, durationMillis: Int64, timeoutMillis: Int64, diagnostic: String): SchedulerTaskResult {
    let task = SchedulerTaskResult()
    task.ok = false
    task.status = "task_timeout:${name}"
    task.since = since
    task.durationMillis = durationMillis
    task.timeBudgetMillis = timeoutMillis
    task.validationDiagnostics.add("${name}:task_timeout:${diagnostic}")
    task
}

public class CkbSchedulerTaskRunner <: SchedulerTaskRunner {
    private let kb: KnowledgeBase
    private let config: CkbRuntimeConfig
    private let store: FileKnowledgeStore
    private let sourceRunner: SourceFetchRunner
    private let deadlineClock: CkbMillisClock

    public init(kb: KnowledgeBase, config: CkbRuntimeConfig, store: FileKnowledgeStore, sourceRunner!: SourceFetchRunner = DisabledNetworkFetchRunner(), deadlineClock!: CkbMillisClock = SystemCkbMillisClock()) {
        this.kb = kb
        this.config = config
        this.store = store
        this.sourceRunner = sourceRunner
        this.deadlineClock = deadlineClock
    }

    private func runtimeVersionManifest(): CangjieVersionManifest {
        ckbRuntimeVersionManifestForStore(this.store, this.config)
    }

    public func runTask(name: String, since: String, deadlineAtMillis: Int64): SchedulerTaskResult {
        let result = SchedulerTaskResult()
        let beforeInvariant = ckbRoutineActiveInvariantFromStatus(this.kb.status())
        result.since = if (since == "") { "0" } else { since }
        let profile = ckbSyncProfileForScheduleTask(name)
        result.timeBudgetMillis = profile.timeBudgetMillis
        for (kind in profile.updatedDataKinds) {
            result.updatedDataKinds.add(kind)
        }
        if (!profile.enabled) {
            result.ok = false
            result.status = profile.status
            return this.finalizeTaskResultWithContract(name, result, beforeInvariant)
        }
        let budgetValidation = ckbValidateSchedulerProfileBudgetPlan(profile)
        result.validationDiagnostics.add(budgetValidation.diagnostic)
        if (!budgetValidation.ok) {
            result.ok = false
            result.status = "invalid_profile_budget_plan"
            result.lastStage = "profile_budget_validation"
            result.lastProgress = budgetValidation.diagnostic
            return this.finalizeTaskResultWithContract(name, result, beforeInvariant)
        }
        if (name == "weekly_full_rebuild") {
            let runId = ckbSchedulerCurrentRunId(this.store)
            result.validationDiagnostics.add(ckbSchedulerProfileStageBudgetDiagnostic(profile))
            let progressSink = FileVectorBuildProgressSink(this.store, schedulerRunId: runId, schedulerTaskName: name)
            let fileStageSink = FileCkbStagedRebuildStageSink(this.store, schedulerRunId: runId, schedulerTaskName: name)
            let stageSink = RecordingCkbStagedRebuildStageSink(fileStageSink)
            let rebuildStartedAtMillis = ckbTaskWorkerNowMillis()
            let rebuild = ckbStagedFullRebuild(this.kb, this.store, this.config, progressSink, deadlineAtMillis, stageSink: stageSink, profile: profile)
            let rebuildDurationMillis = ckbTaskWorkerNowMillis() - rebuildStartedAtMillis
            result.ok = rebuild.ok
            result.status = if (rebuild.ok) {
                "rebuild_ok"
            } else if (rebuild.failedVersion.startsWith("deadline_exceeded:")) {
                "task_timeout:${name}"
            } else {
                "rebuild_failed:${rebuild.failedVersion}"
            }
            if (!rebuild.ok && rebuild.failedVersion != "") {
                result.validationDiagnostics.add("rebuild:${rebuild.failedVersion}")
            }
            result.cursor = "rebuild-${rebuild.activeVersion}"
            result.activeVersion = rebuild.activeVersion
            result.candidateVersion = rebuild.candidateVersion
            result.requestCount = profile.requestCount
            result.lastStage = if (rebuild.ok) { "weekly_full_rebuild_finished" } else if (rebuild.lastStage != "") { rebuild.lastStage } else { ckbSchedulerResultStageFromStatus(result.status) }
            result.lastProgress = if (rebuild.lastProgress != "") { rebuild.lastProgress } else { "activeVersion=${rebuild.activeVersion},candidateVersion=${rebuild.candidateVersion},failedVersion=${rebuild.failedVersion},count=${rebuild.count}" }
            result.stageDurations.add(ckbSchedulerStageDurationText("weekly_full_rebuild", rebuildDurationMillis, rebuild.count, result.status))
            for (duration in stageSink.stageDurations) {
                result.stageDurations.add(duration)
            }
            return this.finalizeTaskResultWithContract(name, result, beforeInvariant)
        }
        if (profile.profile == "cangjie_freshness_probe") {
            let readiness = ckbEnsureManifestReadyForFreshness(this.store, this.config, this.runtimeVersionManifest())
            let freshnessReadiness = CangjieCorpusFreshnessReadiness()
            freshnessReadiness.ready = readiness.ready
            for (diagnostic in readiness.diagnostics) {
                freshnessReadiness.diagnostics.add(diagnostic)
            }
            let previousFreshness = this.store.loadCangjieCorpusFreshness()
            let freshness = probeCangjieCorpusFreshnessWithReadiness(readiness.manifest, this.sourceRunner, freshnessReadiness)
            ckbApplyFreshnessArtifactSemantics(freshness, previousFreshness)
            let status = this.kb.status()
            freshness.activeKnowledgeVersion = status.activeKnowledgeVersion
            freshness.candidateKnowledgeVersion = status.candidateKnowledgeVersion
            freshness.failedCandidateVersion = status.failedCandidateVersion
            if (cangjieManifestHasOfflineBaseline(readiness.manifest)) {
                freshness.ok = false
                freshness.degraded = true
                freshness.diagnostics.add("version_manifest_contains_offline_baseline")
            }
            let staleSignals = ckbFreshnessStaleSignalCount(freshness)
            this.store.saveCangjieCorpusFreshness(freshness)
            result.ok = freshness.ok && !freshness.degraded
            result.status = if (result.ok) { if (staleSignals > 0) { "freshness_probe_completed_with_stale_sources" } else { "freshness_probe_ok" } } else { "freshness_probe_degraded" }
            result.cursor = stableSummaryHash("${freshness.targetVersion}:${freshness.sources.size}:${freshness.degraded}:${staleSignals}")
            result.since = "${this.kb.scheduler.clock.nowMinutes}"
            result.activeVersion = status.activeKnowledgeVersion
            result.candidateVersion = status.candidateKnowledgeVersion
            result.requestCount = freshness.sources.size
            for (diagnostic in readiness.diagnostics) {
                result.validationDiagnostics.add("freshness_readiness:${diagnostic}")
            }
            for (diagnostic in freshness.diagnostics) {
                result.validationDiagnostics.add("freshness:${diagnostic}")
            }
            for (source in freshness.sources) {
                result.validationDiagnostics.add("freshness_source:sourceSet=${source.sourceSet}|sourceFamily=${source.sourceFamily}|repo=${source.sourceRepo}|ref=${source.sourceRef}|status=${source.status}|staleness=${source.staleness}|resolvedCommit=${source.resolvedCommit}|contentHash=${source.contentHash}|crawlAt=${source.crawlAt}|indexedAt=${source.indexedAt}")
            }
            result.lastStage = if (result.ok) { "freshness_probe_finished" } else { "freshness_probe_degraded" }
            result.lastProgress = "sources=${freshness.sources.size},staleSignals=${staleSignals},diagnostics=${freshness.diagnostics.size},activeVersion=${status.activeKnowledgeVersion},candidateVersion=${status.candidateKnowledgeVersion}"
            return this.finalizeTaskResultWithContract(name, result, beforeInvariant)
        }
        let manifest = this.runtimeVersionManifest()
        let workerSoftDeadlineAtMillis = ckbSchedulerWorkerSoftDeadlineAtMillis(
            deadlineAtMillis, profile.resultFlushBudgetMillis,
            nowMillis: this.deadlineClock.nowMillis(),
            safetyMillis: profile.unallocatedSafetyMillis)
        let fetchDeadlineAtMillis = ckbStageDeadline(workerSoftDeadlineAtMillis,
            profile.fetchBudgetMillis, clock: this.deadlineClock)
        let fetchStartedAtMillis = ckbTaskWorkerNowMillis()
        let fetch = ckbRunScheduledProfileFetches(profile, this.sourceRunner, this.config, this.store, manifest, deadlineAtMillis: fetchDeadlineAtMillis)
        let fetchDurationMillis = ckbTaskWorkerNowMillis() - fetchStartedAtMillis
        fetch.runId = "${this.kb.scheduler.clock.nowMinutes}"
        ckbApplyScheduledFetchAccountingToTask(result, fetch)
        if (fetch.status == "fetch_deadline_exceeded") {
            let status = this.kb.status()
            result.ok = false
            result.status = "fetch_deadline_exceeded"
            result.cursor = "cursor-${status.activeKnowledgeVersion}"
            result.activeVersion = status.activeKnowledgeVersion
            result.candidateVersion = status.candidateKnowledgeVersion
            result.truncated = fetch.truncated
            for (diagnostic in fetch.diagnostics) {
                result.validationDiagnostics.add("fetch:${diagnostic}")
            }
            result.lastStage = "fetch_deadline_exceeded"
            result.lastProgress = ckbScheduledFetchAccountingProgress(fetch)
            result.stageDurations.add(ckbSchedulerStageDurationText("fetch", fetchDurationMillis, fetch.actualAttempts, fetch.status))
            return this.finalizeTaskResultWithContract(name, result, beforeInvariant)
        }
        let progressSink = FileVectorBuildProgressSink(this.store, schedulerRunId: ckbSchedulerCurrentRunId(this.store), schedulerTaskName: name)
        let fileStageSink = FileCkbStagedRebuildStageSink(this.store, schedulerRunId: ckbSchedulerCurrentRunId(this.store), schedulerTaskName: name)
        let stageSink = RecordingCkbStagedRebuildStageSink(fileStageSink)
        let ingestBudgetMillis = if (profile.profile == "cangjie_release_full_sync") { profile.ingestBudgetMillis } else { ckbProfileIngestBudgetMillis(profile) }
        let ingestDeadlineAtMillis = ckbStageDeadline(workerSoftDeadlineAtMillis,
            ingestBudgetMillis, clock: this.deadlineClock)
        let promotionBudgetPlan = ckbCandidatePromotionBudgetPlanForProfile(profile,
            workerSoftDeadlineAtMillis, this.deadlineClock)
        let ingestStartedAtMillis = ckbTaskWorkerNowMillis()
        let ingest = ingestScheduledProfileSources(this.kb, this.store, profile, fetch, this.config, manifest, progressSink: progressSink, stageSink: stageSink, deadlineAtMillis: ingestDeadlineAtMillis, promotionBudgetPlan: promotionBudgetPlan)
        let ingestDurationMillis = ckbTaskWorkerNowMillis() - ingestStartedAtMillis
        let status = this.kb.status()
        result.ok = fetch.ok && ingest.ok
        result.status = if (result.ok) {
            ingest.status
        } else if (ckbScheduledIngestTimedOut(ingest.status)) {
            if (profile.profile == "cangjie_release_full_sync") { ingest.status } else { "task_timeout:${name}" }
        } else {
            if (ingest.status != "") { ingest.status } else { "profile_degraded" }
        }
        if (profile.profile == "cangjie_benchmark_gap_curation") {
            result.terminality = ckbBenchmarkGapTaskTerminality(result.status)
        }
        result.cursor = "cursor-${status.activeKnowledgeVersion}"
        result.since = "${this.kb.scheduler.clock.nowMinutes}"
        result.activeVersion = status.activeKnowledgeVersion
        result.candidateVersion = status.candidateKnowledgeVersion
        ckbApplyScheduledFetchAccountingToTask(result, fetch)
        result.truncated = fetch.truncated
        result.validationStatus = ingest.validationStatus
        for (gate in ingest.validationGates) {
            result.validationGates.add(gate)
        }
        result.transactionId = ingest.transactionId
        result.manifestEvidenceHash = ingest.manifestEvidenceHash
        result.freshnessEvidenceHash = ingest.freshnessEvidenceHash
        result.sourceCoverageEvidenceHash = ingest.sourceCoverageEvidenceHash
        result.inventoryEvidenceHash = ingest.inventoryEvidenceHash
        result.validationSummary = ingest.validationSummary
        result.validationEvidenceHash = ingest.validationEvidenceHash
        for (diagnostic in ingest.validationDiagnostics) {
            result.validationDiagnostics.add(diagnostic)
        }
        result.validationDiagnostics.add(ckbSchedulerProfileStageBudgetDiagnostic(profile))
        if (!result.ok && ckbScheduledIngestTimedOut(ingest.status)) {
            result.validationDiagnostics.add("internal_timeout:${ingest.status}")
        }
        result.lastStage = ckbSchedulerResultStageFromStatus(result.status)
        result.lastProgress = "${ckbScheduledFetchAccountingProgress(fetch)},fetched=${fetch.fetchedCount},failed=${fetch.failedCount},ingestStatus=${ingest.status},activeVersion=${status.activeKnowledgeVersion},candidateVersion=${status.candidateKnowledgeVersion}"
        result.stageDurations.add(ckbSchedulerStageDurationText("fetch", fetchDurationMillis, fetch.actualAttempts, fetch.status))
        for (duration in stageSink.stageDurations) {
            result.stageDurations.add(duration)
        }
        result.stageDurations.add(ckbSchedulerStageDurationText("ingest", ingestDurationMillis, fetch.fetchedCount, ingest.status))
        this.finalizeTaskResultWithContract(name, result, beforeInvariant)
    }

public func ckbBenchmarkGapTaskTerminality(status: String): String {
    if (status == "benchmark_gap_scan_batch_checkpointed" ||
        status == "benchmark_gap_proof_checkpointed" ||
        status == "benchmark_gap_proof_complete") {
        return "nonterminal_checkpointed"
    }
    if (status == "benchmark_gap_proof_lease_held" ||
        status == "benchmark_gap_proof_claim_conflict" ||
        status == "benchmark_gap_proof_revision_conflict") {
        return "nonterminal_retryable"
    }
    if (status == "candidate_validated_promoted") { return "terminal_success" }
    "terminal_failure"
}

    private func finalizeTaskResultWithContract(name: String, result: SchedulerTaskResult, beforeInvariant: CkbRoutineActiveInvariant): SchedulerTaskResult {
        let activeInvariantDiagnostic = ckbActiveSnapshotVectorInvariantDiagnostic(this.kb.status())
        if (result.ok && activeInvariantDiagnostic != "") {
            result.ok = false
            result.status = "active_vector_invariant_failed"
            result.validationDiagnostics.add("${name}:${activeInvariantDiagnostic}")
            if (result.lastStage == "") {
                result.lastStage = "active_vector_invariant"
            }
            if (result.lastProgress == "") {
                result.lastProgress = activeInvariantDiagnostic
            }
        }
        let operationallyFailedBeforeContract = !result.ok
        if (name == "cangjie_source_event_sync" && result.since == "0") {
            // Legacy direct reconciliation has no durable event identity and
            // is explicitly outside KU-10. It may remain operationally usable,
            // but it never produces verified ledger evidence or last-success.
            result.validationDiagnostics.add("routine_contract:not_applicable_legacy_repository_reconciliation")
            return result
        }
        let validation = validateSchedulerTaskResultAgainstPersistedContract(
            this.store, this.config, name, result, beforeInvariant,
            ckbRoutineActiveInvariantFromStatus(this.kb.status()))
        ckbApplySchedulerTaskContractValidation(result, validation,
            operationallyFailedBeforeContract)
        result
    }
}

public func ckbApplySchedulerTaskContractValidation(result: SchedulerTaskResult,
    validation: CkbRoutineContractValidation,
    operationallyFailedBeforeContract: Bool): Unit {
    result.validationDiagnostics.add(
        "routine_contract:${renderCkbRoutineContractValidationJson(validation)}")
    if (!validation.ok) {
        result.ok = false
        if (operationallyFailedBeforeContract) {
            result.validationDiagnostics.add(
                "routine_contract_degraded:${validation.diagnostic}")
        } else {
            result.status = validation.diagnostic
        }
    }
}

private func ckbSchedulerResultStageFromStatus(status: String): String {
    if (status.endsWith("_deadline_exceeded")) {
        return status
    }
    if (status.startsWith("task_timeout:") || status.contains("deadline_exceeded")) {
        return "deadline_exceeded"
    }
    if (status.contains("readiness")) {
        return "readiness"
    }
    if (status.contains("validation")) {
        return "candidate_validation"
    }
    if (status.contains("benchmark_gap")) {
        return "benchmark_gap_curation"
    }
    if (status.contains("rebuild")) {
        return "weekly_full_rebuild"
    }
    if (status == "profile_ok" || status == "rebuild_ok" || status.endsWith("_ok")) {
        return "finished"
    }
    if (status != "") {
        return status
    }
    "unknown"
}

private func ckbActiveSnapshotVectorInvariantDiagnostic(status: KnowledgeStatus): String {
    let indexCount = status.storage.indexCount
    let vectorCount = status.storage.vectorIndexCount
    if (indexCount <= 0 || vectorCount <= 0) {
        return ""
    }
    if (status.storage.vectorState != EmbeddingProviderState.READY) {
        return ""
    }
    if (indexCount == vectorCount) {
        return ""
    }
    "active_vector_count_mismatch:indexCount=${indexCount}:vectorIndexCount=${vectorCount}:activeCollection=${status.storage.vectorActiveCollection}"
}

private func ckbScheduledIngestTimedOut(status: String): Bool {
    status == "candidate_validation_timeout" || status == "benchmark_gap_query_proof_timeout" ||
        status == "ingest_deadline_exceeded" ||
        status == "candidate_vector_deadline_exceeded" ||
        status == "candidate_validation_deadline_exceeded" ||
        status == "candidate_active_commit_deadline_exceeded" ||
        status == "candidate_active_snapshot_deadline_exceeded" ||
        status.startsWith("deadline_exceeded:")
}

private func ckbRepositoryEventReceiptPath(dedupeKey: String): String {
    "metadata/repository-event-inbox/events/${safeName(ckbReleaseEvidenceHash(dedupeKey))}.ckb"
}

private func ckbRepositoryEventQueuePointerPath(dedupeKey: String): String {
    "metadata/repository-event-inbox/queue/${safeName(ckbReleaseEvidenceHash(dedupeKey))}.ckb"
}

private func ckbRepositoryEventFetchCachePath(eventId: String, repo: String,
    resolvedCommit: String, path: String): String {
    let key = ckbReleaseEvidenceHash("${eventId}|${repo.toAsciiLower()}|${resolvedCommit}|${path}")
    "metadata/repository-event-inbox/fetch/${safeName(key)}.ckb"
}

private func ckbRepositoryEventMutationLockPath(dedupeKey: String): String {
    "metadata/repository-event-inbox/locks/${safeName(ckbReleaseEvidenceHash(dedupeKey))}.lock"
}

private func ckbRepositoryEventMutationPendingPath(dedupeKey: String): String {
    "metadata/repository-event-inbox/locks/${safeName(ckbReleaseEvidenceHash(dedupeKey))}.pending.ckb"
}

private func ckbRepositoryEventReceiptStateValid(receipt: CkbRepositoryEventReceipt): Bool {
    if (receipt.revision < 0 || receipt.maxAttempts <= 0 || receipt.attempt < 0 ||
        receipt.attempt > receipt.maxAttempts || receipt.nextAttemptAtMillis < 0 ||
        receipt.leaseUntilMillis < 0) { return false }
    if (receipt.state == "queued") {
        return receipt.attempt == 0 && receipt.revision == 0 &&
            receipt.leaseOwner == "" && receipt.leaseUntilMillis == 0 &&
            receipt.nextAttemptAtMillis == receipt.createdAtMillis && receipt.lastErrorCode == ""
    }
    if (receipt.state == "running") {
        return receipt.attempt > 0 && receipt.leaseOwner != "" &&
            receipt.leaseUntilMillis > receipt.updatedAtMillis && receipt.nextAttemptAtMillis == 0
    }
    if (receipt.state == "retryable") {
        return receipt.attempt > 0 && receipt.attempt < receipt.maxAttempts &&
            receipt.leaseOwner == "" && receipt.leaseUntilMillis == 0 &&
            receipt.nextAttemptAtMillis > receipt.updatedAtMillis && receipt.lastErrorCode != ""
    }
    if (receipt.state == "committed" || receipt.state == "failed") {
        return receipt.attempt > 0 && receipt.leaseOwner == "" &&
            receipt.leaseUntilMillis == 0 && receipt.nextAttemptAtMillis == 0
    }
    false
}

// Event paths are untrusted ingress data. Keep their logical order stable
// across redelivery without byte slicing so Chinese/emoji paths remain intact.
private func ckbCanonicalRepositoryEventPaths(paths: ArrayList<String>): ArrayList<String> {
    let unique = HashSet<String>()
    for (raw in paths) {
        let path = raw.trimAscii()
        if (ckbSafeRepoRelativePath(path)) {
            unique.add(path)
        }
    }
    let values = ArrayList<String>()
    for (path in unique) { values.add(path) }
    let ordered = values.toArray()
    sort(ordered)
    let out = ArrayList<String>()
    for (path in ordered) { out.add(path) }
    out
}

private func ckbRepositoryEventCanonicalSha256(receipt: CkbRepositoryEventReceipt): String {
    let paths = ckbCanonicalRepositoryEventPaths(receipt.changedFiles).toArray()
    let profiles = receipt.scheduledProfiles.toArray()
    sort(profiles)
    let out = StringBuilder()
    out.append("schema=${receipt.schemaVersion}|eventId=${receipt.eventId}|deliveryId=${receipt.deliveryId}|dedupeKey=${receipt.dedupeKey}")
    out.append("|repo=${receipt.repo.toAsciiLower()}|ref=${receipt.ref}|mergeCommitSha=${receipt.mergeCommitSha}|resolvedCommit=${receipt.resolvedCommit}|prNumber=${receipt.prNumber}")
    out.append("|changedFilesTruncated=${receipt.changedFilesTruncated}|changedFilesUnavailable=${receipt.changedFilesUnavailable}")
    for (profile in profiles) { out.append("|profile=${profile}") }
    for (path in paths) { out.append("|path=${path}") }
    ckbReleaseEvidenceHash(out.toString())
}

private func ckbRepositoryEventReceiptChecksum(receipt: CkbRepositoryEventReceipt): String {
    let out = StringBuilder()
    out.append("schema=${receipt.schemaVersion}|eventId=${receipt.eventId}|deliveryId=${receipt.deliveryId}|dedupeKey=${receipt.dedupeKey}")
    out.append("|canonicalSha256=${receipt.canonicalSha256}|state=${receipt.state}|attempt=${receipt.attempt}|revision=${receipt.revision}")
    out.append("|leaseOwner=${receipt.leaseOwner}|leaseUntilMillis=${receipt.leaseUntilMillis}|nextAttemptAtMillis=${receipt.nextAttemptAtMillis}|maxAttempts=${receipt.maxAttempts}|lastErrorCode=${receipt.lastErrorCode}")
    out.append("|createdAtMillis=${receipt.createdAtMillis}|updatedAtMillis=${receipt.updatedAtMillis}|repo=${receipt.repo}|ref=${receipt.ref}|mergeCommitSha=${receipt.mergeCommitSha}|resolvedCommit=${receipt.resolvedCommit}|changedFilesTruncated=${receipt.changedFilesTruncated}|changedFilesUnavailable=${receipt.changedFilesUnavailable}|prNumber=${receipt.prNumber}")
    for (profile in receipt.scheduledProfiles) { out.append("|profile=${profile}") }
    for (path in receipt.changedFiles) { out.append("|path=${path}") }
    ckbReleaseEvidenceHash(out.toString())
}

private func ckbRepositoryEventReceiptText(receipt: CkbRepositoryEventReceipt): String {
    var text = "schemaVersion=${escapeField(receipt.schemaVersion)}\n"
    text += "eventId=${escapeField(receipt.eventId)}\n"
    text += "deliveryId=${escapeField(receipt.deliveryId)}\n"
    text += "dedupeKey=${escapeField(receipt.dedupeKey)}\n"
    text += "canonicalSha256=${receipt.canonicalSha256}\n"
    text += "state=${receipt.state}\nattempt=${receipt.attempt}\n"
    text += "revision=${receipt.revision}\nleaseOwner=${escapeField(receipt.leaseOwner)}\nleaseUntilMillis=${receipt.leaseUntilMillis}\n"
    text += "nextAttemptAtMillis=${receipt.nextAttemptAtMillis}\nmaxAttempts=${receipt.maxAttempts}\nlastErrorCode=${escapeField(receipt.lastErrorCode)}\n"
    text += "createdAtMillis=${receipt.createdAtMillis}\nupdatedAtMillis=${receipt.updatedAtMillis}\n"
    text += "repo=${escapeField(receipt.repo)}\nref=${escapeField(receipt.ref)}\nmergeCommitSha=${escapeField(receipt.mergeCommitSha)}\nresolvedCommit=${escapeField(receipt.resolvedCommit)}\nchangedFilesTruncated=${receipt.changedFilesTruncated}\nchangedFilesUnavailable=${receipt.changedFilesUnavailable}\nprNumber=${receipt.prNumber}\n"
    text += "changedFileCount=${receipt.changedFiles.size}\n"
    for (index in 0..receipt.changedFiles.size) { text += "changedFile${index}=${escapeField(receipt.changedFiles[index])}\n" }
    text += "scheduledProfileCount=${receipt.scheduledProfiles.size}\n"
    for (index in 0..receipt.scheduledProfiles.size) { text += "scheduledProfile${index}=${escapeField(receipt.scheduledProfiles[index])}\n" }
    text += "checksum=${receipt.checksum}\n"
    text
}

private func ckbRepositoryEventQueuePointerText(receipt: CkbRepositoryEventReceipt): String {
    let checksum = ckbReleaseEvidenceHash("${receipt.artifactPath}|${receipt.dedupeKey}|${receipt.canonicalSha256}|${receipt.checksum}")
    var text = "schemaVersion=ckb-repository-event-queue-pointer-v1\n"
    text += "eventReceipt=${escapeField(receipt.artifactPath)}\n"
    text += "dedupeKey=${escapeField(receipt.dedupeKey)}\n"
    text += "canonicalSha256=${receipt.canonicalSha256}\nchecksum=${checksum}\n"
    text
}

public class CkbServiceResponse {
    public var text: String = ""
    public var shouldStop: Bool = false

    public init() {}
}

public class CkbCommandLoopService {
    private let config: CkbRuntimeConfig
    private let store: FileKnowledgeStore
    private let sourceRunner: SourceFetchRunner
    private let sourceEventPromotionBudgetPlan: CangjieCandidatePromotionBudgetPlan
    private let repositoryEventNowClock: CkbMillisClock
    private var kb: KnowledgeBase
    private let adminOperationGate: CkbAdminOperationGate = CkbAdminOperationGate()
    private var started: Bool = false
    private var acceptedEventCount: Int64 = 0
    private var rebuildCount: Int64 = 0

    public init(config: CkbRuntimeConfig, store: FileKnowledgeStore,
        sourceRunner!: SourceFetchRunner = DisabledNetworkFetchRunner(),
        sourceEventPromotionBudgetPlan!: CangjieCandidatePromotionBudgetPlan = CangjieCandidatePromotionBudgetPlan(),
        repositoryEventNowClock!: CkbMillisClock = SystemCkbMillisClock()) {
        this.config = config
        this.store = store
        this.sourceRunner = sourceRunner
        this.sourceEventPromotionBudgetPlan = sourceEventPromotionBudgetPlan
        this.repositoryEventNowClock = repositoryEventNowClock
        this.kb = newKnowledgeBaseFromStoreWithRuntime(store, config).kb
    }

    public func start(): String {
        this.started = true
        this.recoverRepositoryEventCommitIfRequired()
        if (this.config.firstInitEnabled) {
            let result = ckbEnsureFirstInitialized(this.config, this.store)
            if (result.ok && result.persisted) {
                this.reloadKnowledgeBase()
            }
        }
        this.logLine("info", "service_started")
    }

    public func handleLine(line: String): CkbServiceResponse {
        if (!this.started) {
            this.started = true
        }
        let response = CkbServiceResponse()
        let cleaned = line.trimAscii()
        if (cleaned == "") {
            response.text = "error code=empty_command\n"
            return response
        }
        let command = firstToken(cleaned)
        let tail = lineTail(cleaned, command)
        if (command == "health") {
            response.text = this.health()
        } else if (command == "status") {
            response.text = renderDoctor(this.statusSnapshot())
        } else if (command == "metrics") {
            response.text = renderMetrics(this.kb.status())
        } else if (command == "query") {
            response.text = renderQuery(cangjie_evidence_pack(this.kb, if (tail == "") { "func syntax" } else { tail }, 5))
        } else if (command == "evidence") {
            response.text = renderQuery(cangjie_evidence_pack(this.kb, if (tail == "") { "HttpClient" } else { tail }, 3))
        } else if (command == "cangjie_knowledge_pack") {
            response.text = renderCangjieKnowledgePackMarkdown(this.cangjieKnowledgePack(if (tail == "") { "Cangjie language context" } else { tail }))
        } else if (command == "cangjie_api_search") {
            response.text = renderCangjieKnowledgePackMarkdown(this.cangjieApiSearch(if (tail == "") { "stdx JSON" } else { tail }))
        } else if (command == "cangjie_syntax_query") {
            response.text = renderCangjieKnowledgePackMarkdown(this.cangjieSyntaxQuery(if (tail == "") { "function syntax" } else { tail }))
        } else if (command == "cangjie_cookbook") {
            response.text = renderCangjieContextPack(this.cangjieCookbook(if (tail == "") { "Cangjie task" } else { tail }))
        } else if (command == "cangjie_diagnose") {
            response.text = renderCangjieKnowledgePackMarkdown(this.cangjieDiagnose("", if (tail == "") { "Cangjie compiler diagnostic" } else { tail }))
        } else if (command == "cangjie_corpus_status") {
            response.text = renderCangjieCorpusStatus(this.cangjieCorpusStatus())
        } else if (command == "source_analysis" || command == "source-analysis") {
            var request = sourceAnalysisRequestFromText(tail)
            if (request.repo == "") {
                request = parseSourceAnalysisCommand(tail)
            }
            if (request.allowCloneFallback && this.config.sourceAnalysisEnabled) {
                request.visibility = request.repoVisibility
                request.selector = request.query
                response.text = renderSourceAnalysis(cangjie_source_analysis(this.config, request))
            } else {
                response.text = renderSourceAnalysis(ckbSourceAnalysis(request, runner: this.sourceRunner))
            }
        } else if (command == "sync") {
            let result = this.runSync(body: "{\"mode\":\"apply\",\"maxItems\":3}")
            response.text = "sync status=${result.status} degraded=${result.degraded} activeKnowledgeVersion=${result.activeKnowledgeVersion} candidateKnowledgeVersion=${result.candidateKnowledgeVersion} diagnostic=${result.diagnostic}\n"
        } else if (command == "cangjie_initialize" || command == "cangjie-initialize" || command == "initialize") {
            response.text = renderCkbFirstInitResult(this.runFirstInitialization(body: tail))
        } else if (command == "rebuild") {
            let result = this.runRebuild()
            response.text = "rebuild ok=${result.ok} activeKnowledgeVersion=${result.activeVersion} candidateKnowledgeVersion=${result.candidateVersion} count=${result.count}\n"
        } else if (command == "vector-bootstrap") {
            response.text = renderCkbVectorBootstrapText(this.runVectorBootstrap())
        } else if (command == "vector-clean-derived") {
            response.text = renderCkbDerivedVectorCleanupText(this.runDerivedVectorCleanup(tail.contains("--force")))
        } else if (command == "vector-reconcile") {
            response.text = renderCkbVectorReconcileText(this.runVectorReconcile(tail.contains("--force")))
        } else if (command == "scheduler-run") {
            let result = this.runScheduler(1)
            response.text = "scheduler ran=${result.ran} succeeded=${result.succeeded} failed=${result.failed} degraded=${result.degraded}\n${result.details}"
        } else if (command == "backup") {
            response.text = renderBackupRestore(this.store.backupActiveSnapshot(tail))
        } else if (command == "restore") {
            let result = this.store.restoreActiveSnapshotBackup(tail)
            if (result.ok) {
                this.reloadKnowledgeBase()
            }
            response.text = renderBackupRestore(result)
        } else if (command == "restart") {
            this.reloadKnowledgeBase()
            response.text = this.logLine("info", "service_restarted")
        } else if (command == "stop" || command == "shutdown" || command == "exit") {
            response.text = this.logLine("info", "service_stopped")
            response.shouldStop = true
        } else {
            response.text = "error code=unknown_command command=${redactSensitive(command)} protocol=ckb-stdio-v1\n"
        }
        response.text = redactSensitive(response.text)
        response
    }

    public func statusSnapshot(): KnowledgeStatus {
        let status = this.kb.status()
        status.schedulerLoop = this.store.loadSchedulerLoopStatus()
        let recovery = this.store.repositoryEventRecoveryMarkerStatus()
        let sidecar = this.store.repositoryEventRecoverySidecarStatus()
        let recoveryStatus = if (recovery.status != "repository_event_recovery_marker_missing") {
            recovery.status
        } else { sidecar.status }
        if (recoveryStatus != "repository_event_recovery_marker_missing") {
            status.activeStateSource = "persisted_degraded"
            status.restoreDiagnostic = recoveryStatus
            status.storage.vectorState = EmbeddingProviderState.DEGRADED
            status.storage.vectorDegradedReason = status.restoreDiagnostic
        }
        status
    }

    private func recoverRepositoryEventCommitIfRequired(): Unit {
        let marker = this.store.repositoryEventRecoveryMarkerStatus()
        let sidecar = this.store.repositoryEventRecoverySidecarStatus()
        // A malformed live marker is a durable recovery alarm; never hide it
        // behind an otherwise valid sidecar.
        if (marker.status != "repository_event_recovery_marker_missing" && !marker.valid) { return }
        let sidecarCorrupt = sidecar.status == "invalid_response_encoding" ||
            sidecar.status == "repository_event_recovery_sidecar_invalid"
        if (marker.valid && sidecarCorrupt) { return }
        if (marker.valid && sidecar.valid &&
            ckbCurrentField(marker.text, "eventIdentity") != ckbCurrentField(sidecar.text, "eventIdentity")) {
            return
        }
        let authority = if (marker.valid) { marker } else { sidecar }
        if (!authority.valid) { return }
        let txId = ckbCurrentField(authority.text, "txId")
        let activeVersion = ckbCurrentField(authority.text, "activeVersion")
        let pointerHash = ckbCurrentField(authority.text, "pointerHash")
        let pointer = this.store.loadActiveSnapshotPointer()
        let actualHash = ckbReleaseEvidenceHash("${pointer.txId}|${pointer.activeVersion}|${pointer.manifestHash}|${pointer.freshnessHash}|${pointer.coverageHash}")
        if (!pointer.valid || pointer.txId != txId || pointer.activeVersion != activeVersion || actualHash != pointerHash) { return }
        let snapshot = this.store.loadActiveSnapshot()
        if (snapshot.valid && this.kb.restoreActiveSnapshot(snapshot)) {
            // Consume the pre-COMMIT authority before clearing the live shadow.
            // Every post-pointer I/O failure is contained so the durable marker
            // remains available for the next startup instead of being erased.
            if (sidecar.valid) {
                let consumed = try { this.store.consumeRepositoryEventRecoverySidecar(txId) } catch (_: Exception) { false }
                if (!consumed) { return }
            }
            if (marker.valid) {
                try { this.store.clearRepositoryEventRecoveryMarker() } catch (_: Exception) {}
            }
        }
    }

