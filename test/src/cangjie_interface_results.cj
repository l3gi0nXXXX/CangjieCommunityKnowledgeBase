private func cangjieInterfacePackResultJson(kind: String, ok: Bool, diagnostic: String, targetVersion: String, versionResolutionId: String, evidenceHash: String, sourceSet: String, knowledgeVersion: String, degraded: Bool, truncated: Bool, citations: ArrayList<SourceReference>, pack: CangjieKnowledgePack, itemAlias: String): String {
    let effectiveOk = ok && citations.size > 0
    let effectiveDiagnostic = if (!effectiveOk && citations.size == 0 && diagnostic == "ok") { "missing_citation" } else { diagnostic }
    var out = cangjieInterfaceResultPrefix(kind, effectiveOk, effectiveDiagnostic, targetVersion, versionResolutionId, evidenceHash, sourceSet, knowledgeVersion, degraded || citations.size == 0, truncated, citations, pack.sourceRef, pack.resolvedCommit, pack.contentHash, pack.sourceRepo)
    out += ",\"queryId\":\"${cangjieInterfaceJsonEscape(pack.queryId)}\",\"task\":\"${cangjieInterfaceJsonEscape(pack.task)}\""
    out += ",\"matchedItems\":${cangjieInterfacePackMatchedItems(pack)},\"requiredKnowledge\":${cangjieInterfaceRequiredKnowledgeJson(kind, pack)},\"queryPlan\":${cangjieInterfaceQueryPlanJson(kind, sourceSet, targetVersion, versionResolutionId, pack)},\"coverage\":${cangjieInterfaceCoverageJson(pack, citations, degraded || citations.size == 0)}"
    if (kind == "tool_manual") {
        out += ",\"command\":\"${cangjieInterfaceJsonEscape(cangjieInterfaceToolCommand(pack))}\",\"usage\":\"${cangjieInterfaceJsonEscape(cangjieInterfaceToolUsage(pack))}\",\"expectedOutput\":\"${cangjieInterfaceJsonEscape(cangjieInterfaceToolExpectedOutput(pack))}\""
    }
    out += ",\"${itemAlias}\":${cangjieInterfaceKnowledgeItemsJson(pack.items)},\"items\":${cangjieInterfaceKnowledgeItemsJson(pack.items)},\"apiItems\":${cangjieInterfaceApiItemsJson(pack.apiItems)},\"examples\":${cangjieInterfaceExamplesJson(pack.examples)},\"diagnostics\":${cangjieInterfaceDiagnosticItemsJson(pack.diagnostics)},\"notes\":${cangjieInterfaceStringArrayJson(pack.notes)}}"
    out
}

private func cangjieInterfaceResultPrefix(kind: String, ok: Bool, diagnostic: String, targetVersion: String, versionResolutionId: String, evidenceHash: String, sourceSet: String, knowledgeVersion: String, degraded: Bool, truncated: Bool, citations: ArrayList<SourceReference>, sourceRef: String, resolvedCommit: String, contentHash: String, sourceRepo: String): String {
    "{\"resultType\":\"${cangjieInterfaceJsonEscape(kind)}\",\"interfaceId\":\"${cangjieInterfaceJsonEscape(cangjieInterfaceId(kind))}\",\"contentFamily\":\"${cangjieInterfaceJsonEscape(cangjieInterfaceContentFamily(kind, sourceSet))}\",\"updateMechanism\":\"${cangjieInterfaceJsonEscape(cangjieInterfaceUpdateMechanism(kind, sourceSet))}\",\"ok\":${ok},\"diagnostic\":\"${cangjieInterfaceJsonEscape(diagnostic)}\",\"targetVersion\":\"${cangjieInterfaceJsonEscape(targetVersion)}\",\"versionResolutionId\":\"${cangjieInterfaceJsonEscape(versionResolutionId)}\",\"sourceRef\":\"${cangjieInterfaceJsonEscape(sourceRef)}\",\"resolvedCommit\":\"${cangjieInterfaceJsonEscape(resolvedCommit)}\",\"contentHash\":\"${cangjieInterfaceJsonEscape(contentHash)}\",\"sourceRepo\":\"${cangjieInterfaceJsonEscape(sourceRepo)}\",\"provenance\":{\"sourceRef\":\"${cangjieInterfaceJsonEscape(sourceRef)}\",\"resolvedCommit\":\"${cangjieInterfaceJsonEscape(resolvedCommit)}\",\"contentHash\":\"${cangjieInterfaceJsonEscape(contentHash)}\",\"sourceRepo\":\"${cangjieInterfaceJsonEscape(sourceRepo)}\"},\"evidenceHash\":\"${cangjieInterfaceJsonEscape(evidenceHash)}\",\"citations\":${cangjieInterfaceCitationsJson(citations)},\"sourceSet\":\"${cangjieInterfaceJsonEscape(sourceSet)}\",\"knowledgeVersion\":\"${cangjieInterfaceJsonEscape(knowledgeVersion)}\",\"degraded\":${degraded},\"truncated\":${truncated}"
}

private func cangjieInterfacePackDiagnostic(pack: CangjieKnowledgePack): String {
    if (pack.citations.size == 0) {
        return "missing_citation"
    }
    if (pack.degraded) {
        for (note in pack.notes) {
            if (note != "") {
                return note
            }
        }
        return "degraded"
    }
    for (note in pack.notes) {
        if (note == "exact_hit") {
            return "exact_hit"
        }
    }
    "ok"
}

private func cangjieInterfacePackOk(pack: CangjieKnowledgePack): Bool {
    !pack.degraded && pack.citations.size > 0
}

private func cangjieInterfacePackMatchedItems(pack: CangjieKnowledgePack): Int64 {
    pack.items.size + pack.apiItems.size + pack.examples.size + pack.diagnostics.size
}

private func cangjieInterfaceId(kind: String): String {
    if (kind == "symbol_card" || kind == "api_pattern") { return "KI-04" }
    if (kind == "tool_manual") { return "KI-08" }
    if (kind == "negative_rules" || kind == "diagnostic") { return "KI-09" }
    if (kind == "example_search" || kind == "recipe") { return "KI-07" }
    if (kind == "corpus_freshness") { return "KI-10" }
    "KI-02"
}

private func cangjieInterfaceContentFamily(kind: String, sourceSet: String): String {
    if (kind == "symbol_card") { return "symbol" }
    if (kind == "doc_section") { return "documentation" }
    if (kind == "tool_manual") { return "tool_manual" }
    if (kind == "negative_rules") { return "negative_rules" }
    if (kind == "api_pattern") { return "api_pattern" }
    if (kind == "syntax_rule") { return "syntax_rule" }
    if (kind == "example_search") { return "example" }
    if (kind == "recipe") { return "recipe" }
    if (kind == "diagnostic") { return "diagnostic" }
    if (kind == "corpus_freshness") { return "freshness" }
    if (sourceSet == CangjieSourceSets.TOOLS) { return "tool_manual" }
    if (sourceSet == CangjieSourceSets.STD || sourceSet == CangjieSourceSets.STDX) { return "api_pattern" }
    "documentation"
}

private func cangjieInterfaceUpdateMechanism(kind: String, sourceSet: String): String {
    if (kind == "corpus_freshness") {
        return "routine_update_status"
    }
    if (sourceSet == CangjieSourceSets.EVAL_SUPPORT) {
        return "first_init_and_benchmark_gap_curation"
    }
    "first_init_or_routine_update"
}

private func cangjieInterfaceRequiredKnowledgeJson(kind: String, pack: CangjieKnowledgePack): String {
    var out = "["
    var count: Int64 = 0
    for (item in pack.items) {
        out += cangjieInterfaceRequiredKnowledgeEntryJson(count, item.kind, cangjieInterfaceId(kind), "covered", item.sourceId)
        count += 1
    }
    for (item in pack.apiItems) {
        out += cangjieInterfaceRequiredKnowledgeEntryJson(count, item.symbol, cangjieInterfaceId(kind), "covered", item.sourceId)
        count += 1
    }
    for (item in pack.examples) {
        out += cangjieInterfaceRequiredKnowledgeEntryJson(count, item.symbol, cangjieInterfaceId(kind), "covered", item.sourceId)
        count += 1
    }
    for (item in pack.diagnostics) {
        out += cangjieInterfaceRequiredKnowledgeEntryJson(count, item.rule, cangjieInterfaceId(kind), "covered", item.sourceId)
        count += 1
    }
    if (count == 0) {
        out += cangjieInterfaceRequiredKnowledgeEntryJson(count, pack.task, cangjieInterfaceId(kind), "missing", cangjieInterfacePackDiagnostic(pack))
    }
    out + "]"
}

private func cangjieInterfaceRequiredKnowledgeEntryJson(index: Int64, tag: String, interfaceId: String, status: String, reason: String): String {
    let prefix = if (index > 0) { "," } else { "" }
    "${prefix}{\"tag\":\"${cangjieInterfaceJsonEscape(tag)}\",\"interfaceId\":\"${cangjieInterfaceJsonEscape(interfaceId)}\",\"status\":\"${cangjieInterfaceJsonEscape(status)}\",\"reason\":\"${cangjieInterfaceJsonEscape(reason)}\"}"
}

private func cangjieInterfaceQueryPlanJson(kind: String, sourceSet: String, targetVersion: String, versionResolutionId: String, pack: CangjieKnowledgePack): String {
    "{\"interfaceId\":\"${cangjieInterfaceJsonEscape(cangjieInterfaceId(kind))}\",\"queryKind\":\"${cangjieInterfaceJsonEscape(kind)}\",\"query\":\"${cangjieInterfaceJsonEscape(pack.task)}\",\"sourceSet\":\"${cangjieInterfaceJsonEscape(sourceSet)}\",\"targetVersion\":\"${cangjieInterfaceJsonEscape(targetVersion)}\",\"versionResolutionId\":\"${cangjieInterfaceJsonEscape(versionResolutionId)}\",\"selector\":\"${cangjieInterfaceJsonEscape(cangjieInterfaceSelector(pack))}\"}"
}

private func cangjieInterfaceCoverageJson(pack: CangjieKnowledgePack, citations: ArrayList<SourceReference>, degraded: Bool): String {
    let matched = cangjieInterfacePackMatchedItems(pack)
    let pass = !degraded && citations.size > 0 && matched > 0
    let missingReason = if (pass) { "" } else { cangjieInterfacePackDiagnostic(pack) }
    "{\"coveragePass\":${pass},\"matchedItems\":${matched},\"citationCount\":${citations.size},\"itemCount\":${pack.items.size},\"apiItemCount\":${pack.apiItems.size},\"exampleCount\":${pack.examples.size},\"diagnosticCount\":${pack.diagnostics.size},\"missingReason\":\"${cangjieInterfaceJsonEscape(missingReason)}\"}"
}

private func cangjieInterfaceSelector(pack: CangjieKnowledgePack): String {
    if (pack.apiItems.size > 0 && pack.apiItems[0].symbol != "") {
        return pack.apiItems[0].symbol
    }
    if (pack.items.size > 0 && pack.items[0].symbol != "") {
        return pack.items[0].symbol
    }
    if (pack.examples.size > 0 && pack.examples[0].symbol != "") {
        return pack.examples[0].symbol
    }
    pack.task
}

private func cangjieInterfaceToolCommand(pack: CangjieKnowledgePack): String {
    if (pack.items.size > 0 && pack.items[0].symbol != "") {
        return pack.items[0].symbol
    }
    pack.task
}

private func cangjieInterfaceToolUsage(pack: CangjieKnowledgePack): String {
    if (pack.items.size > 0) {
        return pack.items[0].content
    }
    if (pack.apiItems.size > 0) {
        return pack.apiItems[0].summary
    }
    ""
}

private func cangjieInterfaceToolExpectedOutput(pack: CangjieKnowledgePack): String {
    if (pack.items.size > 0 && pack.items[0].example != "") {
        return pack.items[0].example
    }
    "Returns the command result or a cited diagnostic according to the tool manual."
}

private func cangjieInterfaceDiagnostic(degraded: Bool, diagnostics: ArrayList<String>): String {
    if (diagnostics.size > 0) {
        return diagnostics[0]
    }
    if (degraded) {
        return "degraded"
    }
    "ok"
}

private func cangjieInterfaceSourceSet(raw: String, pack: CangjieKnowledgePack): String {
    let clean = raw.trimAscii()
    if (clean != "") {
        return clean
    }
    if (pack.citations.size > 0 || pack.items.size > 0 || pack.apiItems.size > 0 || pack.examples.size > 0 || pack.diagnostics.size > 0) {
        return "mixed"
    }
    ""
}

private func cangjiePackEvidenceHash(pack: CangjieKnowledgePack): String {
    var seed = "${pack.versionResolutionId}|${pack.knowledgeVersion}|${pack.targetVersion}|${pack.items.size}|${pack.apiItems.size}|${pack.examples.size}|${pack.diagnostics.size}"
    for (citation in pack.citations) {
        seed += "|${citation.sourceId}:${citation.citation}:${citation.knowledgeVersion}"
    }
    for (note in pack.notes) {
        seed += "|note:${note}"
    }
    stableSummaryHash(seed)
}

private func cangjieCorpusFreshnessEvidenceHash(report: CangjieCorpusFreshnessReport): String {
    var seed = "${report.activeKnowledgeVersion}|${report.candidateKnowledgeVersion}|${report.failedCandidateVersion}|${report.targetVersion}|${report.degraded}"
    for (source in report.sources) {
        seed += "|${source.sourceSet}:${source.sourceRepo}:${source.sourceRef}:${source.resolvedCommit}:${source.contentHash}:${source.staleness}:${source.status}"
    }
    for (diagnostic in report.diagnostics) {
        seed += "|diagnostic:${diagnostic}"
    }
    stableSummaryHash(seed)
}

private func cangjieInterfaceCopyCitations(target: ArrayList<SourceReference>, source: ArrayList<SourceReference>): Unit {
    for (citation in source) {
        target.add(SourceReference(citation.sourceId, citation.citation, citation.knowledgeVersion))
    }
}

private func cangjieInterfaceKnowledgeItemsJson(items: ArrayList<CangjieKnowledgeItem>): String {
    var out = "["
    for (i in 0..items.size) {
        if (i > 0) { out += "," }
        let item = items[i]
        out += "{\"kind\":\"${cangjieInterfaceJsonEscape(item.kind)}\",\"title\":\"${cangjieInterfaceJsonEscape(item.title)}\",\"content\":\"${cangjieInterfaceJsonEscape(item.content)}\",\"module\":\"${cangjieInterfaceJsonEscape(item.module)}\",\"symbol\":\"${cangjieInterfaceJsonEscape(item.symbol)}\",\"importLine\":\"${cangjieInterfaceJsonEscape(item.importLine)}\",\"signature\":\"${cangjieInterfaceJsonEscape(item.signature)}\",\"example\":\"${cangjieInterfaceJsonEscape(item.example)}\",\"citation\":\"${cangjieInterfaceJsonEscape(item.citation)}\",\"sourceId\":\"${cangjieInterfaceJsonEscape(item.sourceId)}\",\"knowledgeVersion\":\"${cangjieInterfaceJsonEscape(item.knowledgeVersion)}\",\"targetVersion\":\"${cangjieInterfaceJsonEscape(item.targetVersion)}\",\"trustLevel\":\"${cangjieInterfaceJsonEscape(item.trustLevel)}\",\"reviewState\":\"${cangjieInterfaceJsonEscape(item.reviewState)}\",\"requiresReview\":${item.requiresReview}}"
    }
    out + "]"
}

private func cangjieInterfaceApiItemsJson(items: ArrayList<CangjieApiItem>): String {
    var out = "["
    for (i in 0..items.size) {
        if (i > 0) { out += "," }
        let item = items[i]
        out += "{\"module\":\"${cangjieInterfaceJsonEscape(item.module)}\",\"symbol\":\"${cangjieInterfaceJsonEscape(item.symbol)}\",\"importLine\":\"${cangjieInterfaceJsonEscape(item.importLine)}\",\"signature\":\"${cangjieInterfaceJsonEscape(item.signature)}\",\"summary\":\"${cangjieInterfaceJsonEscape(item.summary)}\",\"example\":\"${cangjieInterfaceJsonEscape(item.example)}\",\"citation\":\"${cangjieInterfaceJsonEscape(item.citation)}\",\"sourceId\":\"${cangjieInterfaceJsonEscape(item.sourceId)}\",\"knowledgeVersion\":\"${cangjieInterfaceJsonEscape(item.knowledgeVersion)}\",\"targetVersion\":\"${cangjieInterfaceJsonEscape(item.targetVersion)}\",\"trustLevel\":\"${cangjieInterfaceJsonEscape(item.trustLevel)}\",\"reviewState\":\"${cangjieInterfaceJsonEscape(item.reviewState)}\",\"requiresReview\":${item.requiresReview}}"
    }
    out + "]"
}

private func cangjieInterfaceExamplesJson(items: ArrayList<CangjieExampleItem>): String {
    var out = "["
    for (i in 0..items.size) {
        if (i > 0) { out += "," }
        let item = items[i]
        out += "{\"title\":\"${cangjieInterfaceJsonEscape(item.title)}\",\"code\":\"${cangjieInterfaceJsonEscape(item.code)}\",\"explanation\":\"${cangjieInterfaceJsonEscape(item.explanation)}\",\"module\":\"${cangjieInterfaceJsonEscape(item.module)}\",\"symbol\":\"${cangjieInterfaceJsonEscape(item.symbol)}\",\"citation\":\"${cangjieInterfaceJsonEscape(item.citation)}\",\"sourceId\":\"${cangjieInterfaceJsonEscape(item.sourceId)}\",\"knowledgeVersion\":\"${cangjieInterfaceJsonEscape(item.knowledgeVersion)}\",\"targetVersion\":\"${cangjieInterfaceJsonEscape(item.targetVersion)}\",\"trustLevel\":\"${cangjieInterfaceJsonEscape(item.trustLevel)}\",\"reviewState\":\"${cangjieInterfaceJsonEscape(item.reviewState)}\",\"requiresReview\":${item.requiresReview}}"
    }
    out + "]"
}

private func cangjieInterfaceDiagnosticItemsJson(items: ArrayList<CangjieDiagnosticItem>): String {
    var out = "["
    for (i in 0..items.size) {
        if (i > 0) { out += "," }
        let item = items[i]
        out += "{\"rule\":\"${cangjieInterfaceJsonEscape(item.rule)}\",\"message\":\"${cangjieInterfaceJsonEscape(item.message)}\",\"relatedSyntax\":\"${cangjieInterfaceJsonEscape(item.relatedSyntax)}\",\"suggestedQuery\":\"${cangjieInterfaceJsonEscape(item.suggestedQuery)}\",\"citation\":\"${cangjieInterfaceJsonEscape(item.citation)}\",\"sourceId\":\"${cangjieInterfaceJsonEscape(item.sourceId)}\",\"knowledgeVersion\":\"${cangjieInterfaceJsonEscape(item.knowledgeVersion)}\",\"targetVersion\":\"${cangjieInterfaceJsonEscape(item.targetVersion)}\",\"trustLevel\":\"${cangjieInterfaceJsonEscape(item.trustLevel)}\",\"reviewState\":\"${cangjieInterfaceJsonEscape(item.reviewState)}\",\"executed\":${item.executed}}"
    }
    out + "]"
}

private func cangjieInterfaceCitationsJson(citations: ArrayList<SourceReference>): String {
    var out = "["
    for (i in 0..citations.size) {
        if (i > 0) { out += "," }
        let citation = citations[i]
        out += "{\"sourceId\":\"${cangjieInterfaceJsonEscape(citation.sourceId)}\",\"citation\":\"${cangjieInterfaceJsonEscape(citation.citation)}\",\"knowledgeVersion\":\"${cangjieInterfaceJsonEscape(citation.knowledgeVersion)}\"}"
    }
    out + "]"
}

private func cangjieInterfaceStringArrayJson(values: ArrayList<String>): String {
    var out = "["
    for (i in 0..values.size) {
        if (i > 0) { out += "," }
        out += "\"${cangjieInterfaceJsonEscape(values[i])}\""
    }
    out + "]"
}

private func cangjieInterfaceJsonEscape(raw: String): String {
    let text = redactSensitive(raw)
    let out = StringBuilder()
    for (ch in text.toRuneArray()) {
        if (ch == r'"') {
            out.append("\\\"")
        } else if (ch == r'\\') {
            out.append("\\\\")
        } else if (ch == r'\n') {
            out.append("\\n")
        } else if (ch == r'\r') {
            out.append("\\r")
        } else if (ch == r'\t') {
            out.append("\\t")
        } else {
            out.append(ch)
        }
    }
    out.toString()
}
