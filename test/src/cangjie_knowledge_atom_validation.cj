package cangjie_community_knowledge_base_test

import std.collection.{ArrayList, HashSet}
import stdx.crypto.digest.SHA256
import stdx.encoding.json.*

public class CangjieKnowledgeAtomTestBundleResult { public var ok=false;public var diagnostic="invalid_atom_test_bundle";public var total:Int64=0;public var passed:Int64=0;public var failed:Int64=0;public var atomId="";public var knowledgeText="";public var example="";public var sourceClass="";public init(){} }

public func validateKnowledgeAtomTestBundle(bundleJson:String):CangjieKnowledgeAtomTestBundleResult{
    let result=CangjieKnowledgeAtomTestBundleResult();let raw=bundleJson.trimAscii()
    if(raw==""){result.diagnostic="atom_test_bundle_required";return result};if(raw.toRuneArray().size>262144){result.diagnostic="atom_test_bundle_too_large";return result}
    try{let object=JsonValue.fromStr(raw).asObject();let atomId=atomJsonString(object,"atomId");let sourceClass=atomJsonString(object,"sourceClass").toAsciiLower();let citation=atomJsonString(object,"citation").toAsciiLower();let targetVersion=atomJsonString(object,"targetVersion");let candidateHash=atomJsonString(object,"candidateHash");let knowledgeText=atomJsonString(object,"knowledgeText");let example=atomJsonString(object,"example")
        if(atomId==""||targetVersion==""||candidateHash==""||knowledgeText==""){result.diagnostic="atom_identity_evidence_required";return result}
        let servingDiagnostic=validateKnowledgeAtomServingProjection(knowledgeText,example);if(servingDiagnostic!=""){result.diagnostic=servingDiagnostic;return result}
        if(candidateHash!=cangjieKnowledgeAtomCandidateHash(raw)){result.diagnostic="atom_candidate_hash_mismatch";return result}
        if(sourceClass!="official"&&sourceClass!="approved_trusted"&&sourceClass!="teacher_empirical"){result.diagnostic="atom_source_class_not_allowed";return result}
        if(sourceClass=="official"&&!citation.startsWith("https://docs.cangjie-lang.cn/")){result.diagnostic="atom_citation_not_allowed";return result}
        if(sourceClass=="approved_trusted"&&!citation.startsWith("https://github.com/dyingchinese/cangjie-stdx")){result.diagnostic="atom_citation_not_allowed";return result}
        if(sourceClass=="teacher_empirical"&&(citation!=""||!atomTeacherEmpiricalProvenanceValid(object))){result.diagnostic="unverified_teacher_empirical";return result}
        if(atomForbiddenContent(raw.toAsciiLower())){result.diagnostic="atom_content_contamination";return result}
        match(object.get("purificationPassed")){case Some(value)=>if(!value.asBool().getValue()){result.diagnostic="atom_purification_required";return result};case None=>result.diagnostic="atom_purification_required";return result}
        let categories=HashSet<String>();match(object.get("tests")){case Some(value)=>for(entry in value.asArray().getItems()){let test=entry.asObject();let category=atomJsonString(test,"category").toAsciiLower();let operation=atomJsonString(test,"operation").toAsciiLower();if(category!="positive"&&category!="negative"&&category!="boundary"){result.diagnostic="atom_test_category_invalid";return result};if(operation!="rune_count"&&operation!="contains"&&operation!="arraylist_size"){result.diagnostic="atom_test_operation_not_allowed";return result};categories.add(category);result.total+=1};case None=>result.diagnostic="atom_tests_required";return result}
        if(!categories.contains("positive")||!categories.contains("negative")||!categories.contains("boundary")){result.diagnostic="missing_atom_test_category";return result};result.atomId=atomId;result.knowledgeText=knowledgeText;result.example=example;result.sourceClass=sourceClass;result.ok=true;result.diagnostic="ok";result
    }catch(_:Exception){result.diagnostic="malformed_atom_test_bundle";result}
}
public func cangjieKnowledgeAtomCandidateHash(bundleJson:String):String{try{let object=JsonValue.fromStr(bundleJson.trimAscii()).asObject();let tests=atomJsonCanonicalField(object,"tests");let purified=match(object.get("purificationPassed")){case Some(value)=>"${value.asBool().getValue()}";case None=>""};let canonical=atomCanonicalPart(atomJsonString(object,"atomId"))+atomCanonicalPart(atomJsonString(object,"sourceClass").toAsciiLower())+atomCanonicalPart(atomJsonString(object,"citation").toAsciiLower())+atomCanonicalPart(atomJsonString(object,"targetVersion"))+atomCanonicalPart(atomJsonString(object,"knowledgeFamily"))+atomCanonicalPart(atomJsonString(object,"knowledgeText"))+atomCanonicalPart(atomJsonString(object,"example"))+atomCanonicalPart(atomJsonCanonicalField(object,"extractor"))+atomCanonicalPart(purified)+atomCanonicalPart(tests)+atomCanonicalPart(atomJsonCanonicalField(object,"teacherEmpiricalProvenance"))+atomCanonicalPart(atomJsonCanonicalField(object,"execution"));let digest=SHA256();digest.write(canonical.toArray());let out=StringBuilder();for(byte in digest.finish()){out.append(atomHexNibble(byte/UInt8(16)));out.append(atomHexNibble(byte%UInt8(16)))};"sha256:${out.toString()}"}catch(_:Exception){""}}
private func atomCanonicalPart(value:String):String{"${value.toArray().size}:${value}"}
private func atomHexNibble(value:UInt8):String{if(value==UInt8(0)){return "0"};if(value==UInt8(1)){return "1"};if(value==UInt8(2)){return "2"};if(value==UInt8(3)){return "3"};if(value==UInt8(4)){return "4"};if(value==UInt8(5)){return "5"};if(value==UInt8(6)){return "6"};if(value==UInt8(7)){return "7"};if(value==UInt8(8)){return "8"};if(value==UInt8(9)){return "9"};if(value==UInt8(10)){return "a"};if(value==UInt8(11)){return "b"};if(value==UInt8(12)){return "c"};if(value==UInt8(13)){return "d"};if(value==UInt8(14)){return "e"};"f"}
public func runKnowledgeAtomTestBundle(bundleJson:String):CangjieKnowledgeAtomTestBundleResult{let result=validateKnowledgeAtomTestBundle(bundleJson);if(!result.ok){return result};result.passed=0;try{let tests=JsonValue.fromStr(bundleJson.trimAscii()).asObject().get("tests").getOrThrow().asArray().getItems();for(entry in tests){let test=entry.asObject();let operation=atomJsonString(test,"operation").toAsciiLower();let input=atomJsonString(test,"input");let expected=atomJsonString(test,"expected");let actual=if(operation=="rune_count"){"${input.toRuneArray().size}"}else if(operation=="contains"){"${input.contains(atomJsonString(test,"needle"))}"}else{try{"${JsonValue.fromStr(input).asArray().getItems().size}"}catch(_:Exception){"invalid_input"}};if(actual==expected){result.passed+=1}else{result.failed+=1}};result.ok=result.failed==0&&result.passed==result.total;result.diagnostic=if(result.ok){"ok"}else{"atom_test_failed"}}catch(_:Exception){result.ok=false;result.failed=result.total-result.passed;result.diagnostic="atom_test_execution_failed"};result}
private func atomForbiddenContent(raw:String):Bool{raw.contains("teacher-solutions")||raw.contains("/reference/")||raw.contains("reference/")||raw.contains("/hidden/")||raw.contains("hidden_test")||raw.contains("hidden assertion")||raw.contains("cj-humaneval-")||raw.contains("canonical_solution")||raw.contains("solution n-gram")}
public func validateKnowledgeAtomServingProjection(knowledge:String,example:String):String{if(knowledge.trimAscii()==""){return "atom_identity_evidence_required"};if(knowledge.toRuneArray().size>4096||example.toRuneArray().size>4096){return "atom_serving_field_too_long"};let raw=atomNormalizeServingSafetyText("${knowledge}\n${example}");if(atomForbiddenServingContent(raw)){"atom_content_contamination"}else{""}}
private func atomNormalizeServingSafetyText(raw:String):String{raw.toAsciiLower().replace("\u{200b}","").replace("\u{200c}","").replace("\u{200d}","").replace("\u{feff}","")}
private func atomForbiddenServingContent(raw:String):Bool{raw.contains("cj-humaneval-")||raw.contains("task:")||raw.contains("visible tests:")||raw.contains("compiler output:")||raw.contains("missing knowledge:")||raw.contains("canonical_solution")||raw.contains("canonical solution")||raw.contains("teacher-solutions")||raw.contains("teacher solution")||raw.contains("hidden_test")||raw.contains("hidden test")||raw.contains("hidden assertion")||raw.contains("/hidden/")||raw.contains("/reference/")||raw.contains("reference solution")||raw.contains("solution.cj")}
private func atomTeacherEmpiricalProvenanceValid(object:JsonObject):Bool{try{let p=object.get("teacherEmpiricalProvenance").getOrThrow().asObject();for(field in ["originalFailureEvidenceHash","completedRunManifestHash","solutionBindingHash"]){if(!atomSha256Format(atomJsonString(p,field))){return false}};let execution=object.get("execution").getOrThrow().asObject();let evidence=atomJsonString(execution,"commandEvidence");execution.get("total").getOrThrow().asInt().getValue()==3&&execution.get("passed").getOrThrow().asInt().getValue()==3&&execution.get("failed").getOrThrow().asInt().getValue()==0&&atomJsonString(execution,"status")=="passed"&&evidence!=""&&atomJsonString(execution,"commandEvidenceHash")==atomSha256(evidence)}catch(_:Exception){false}}
private func atomSha256Format(value:String):Bool{let chars=value.toRuneArray();if(chars.size!=71||!value.startsWith("sha256:")){return false};for(i in 7..71){let ch=chars[i];if(!((ch>=r'0'&&ch<=r'9')||(ch>=r'a'&&ch<=r'f'))){return false}};true}
private func atomSha256(value:String):String{let digest=SHA256();digest.write(value.toArray());let out=StringBuilder();for(byte in digest.finish()){out.append(atomHexNibble(byte/UInt8(16)));out.append(atomHexNibble(byte%UInt8(16)))};"sha256:${out.toString()}"}
private func atomJsonString(object:JsonObject,field:String):String{match(object.get(field)){case Some(value)=>value.asString().getValue().trimAscii();case None=>""}}
private func atomJsonCanonicalField(object:JsonObject,field:String):String{match(object.get(field)){case Some(value)=>value.toString();case None=>""}}
