public package cangjie_community_knowledge_base_test

import std.collection.ArrayList
import std.fs.{Directory, File, Path, exists}
import std.sort.*
import stdx.crypto.digest.SHA256
import stdx.encoding.json.*

public class CkbFrozenCandidateSealOptions{public var outputPath:String="";public var expectedKnowledgeVersion:String="";public var expectedCandidateChecksum:String="";public var inputHash:String="";public var configHash:String="";public var modelHash:String="";public var studentLeakageProofJson:String="";public var studentLeakageArtifactJson:String="";public var anonymousQueryArtifactJson:String="";public var authorityIsolationArtifactJson:String="";public var atomTestArtifactJson:String="";public init(){}}
public class CkbFrozenCandidateSealReport{public var ok:Bool=false;public var diagnostic:String="";public var manifestJson:String="";public var evidenceHash:String="";public init(){}}
public interface CkbFrozenCandidateFaultInjector{func checkpoint():Unit}
public class NoopCkbFrozenCandidateFaultInjector<:CkbFrozenCandidateFaultInjector{public func checkpoint():Unit{}}

public func ckbBuildFrozenCandidateSeal(store:FileKnowledgeStore,options:CkbFrozenCandidateSealOptions,faultInjector!:CkbFrozenCandidateFaultInjector=NoopCkbFrozenCandidateFaultInjector()):CkbFrozenCandidateSealReport{let report=CkbFrozenCandidateSealReport();let pointer=store.loadActiveSnapshotPointer();if(!pointer.valid){report.diagnostic="active_snapshot_pointer_required";return report};if(pointer.activeVersion!=options.expectedKnowledgeVersion){report.diagnostic="frozen_knowledge_version_mismatch";return report};for(hash in [options.expectedCandidateChecksum,options.inputHash,options.configHash,options.modelHash]){if(!ckbFrozenCandidateHash(hash)){report.diagnostic="frozen_input_hash_required";return report}};let snapshot=store.loadActiveSnapshot();if(!snapshot.valid){report.diagnostic="active_snapshot_invalid";return report};let checksum=ckbCertifiedNormalizedRecordsChecksum(snapshot.normalizedRecords);if(checksum!=options.expectedCandidateChecksum){report.diagnostic="frozen_candidate_checksum_mismatch";return report};if(ckbCandidateTrustSealDiagnostic(options.studentLeakageProofJson,snapshot.normalizedRecords,options.studentLeakageArtifactJson,options.anonymousQueryArtifactJson,options.authorityIsolationArtifactJson,options.atomTestArtifactJson)!="ok"){report.diagnostic="student_leakage_proof_mismatch";return report};faultInjector.checkpoint();if(ckbActiveSnapshotPointerIdentityHash(store.loadActiveSnapshotPointer())!=ckbActiveSnapshotPointerIdentityHash(pointer)){report.diagnostic="frozen_active_pointer_drift";return report};let txRoot=store.root.join("transactions").join(pointer.txId);if(!exists(txRoot)||!exists(txRoot.join("COMMIT"))){report.diagnostic="committed_transaction_required";return report};let transactionHash=ckbFrozenCandidateDirectoryHash(txRoot);let body=ckbFrozenCandidateBody(pointer.activeVersion,benchmarkGapSha256(pointer.txId),ckbActiveSnapshotPointerIdentityHash(pointer),transactionHash,checksum,options.inputHash,options.configHash,options.modelHash,benchmarkGapSha256(options.studentLeakageProofJson),benchmarkGapSha256(options.authorityIsolationArtifactJson),benchmarkGapSha256(options.anonymousQueryArtifactJson),benchmarkGapSha256(options.atomTestArtifactJson));report.evidenceHash=benchmarkGapSha256(body+"}");report.manifestJson=body+",\"evidenceHash\":\"${report.evidenceHash}\"}";report.ok=true;report.diagnostic="ok";report}

public func ckbFrozenCandidateManifestIntegrityDiagnostic(raw:String,expectedCandidateChecksum!:String="",expectedLeakageProofHash!:String="",expectedKnowledgeVersion!:String=""):String{try{let o=JsonValue.fromStr(raw).asObject();if(ckbFrozenCandidateString(o,"schemaVersion")!="ckb-frozen-candidate-v1"){return "frozen_candidate_manifest_invalid"};let body=ckbFrozenCandidateBody(ckbFrozenCandidateString(o,"knowledgeVersion"),ckbFrozenCandidateString(o,"txIdHash"),ckbFrozenCandidateString(o,"activePointerHash"),ckbFrozenCandidateString(o,"transactionHash"),ckbFrozenCandidateString(o,"candidateChecksum"),ckbFrozenCandidateString(o,"inputHash"),ckbFrozenCandidateString(o,"configHash"),ckbFrozenCandidateString(o,"modelHash"),ckbFrozenCandidateString(o,"studentLeakageProofHash"),ckbFrozenCandidateString(o,"authorityIsolationArtifactHash"),ckbFrozenCandidateString(o,"anonymousQueryArtifactHash"),ckbFrozenCandidateString(o,"atomTestArtifactHash"));if(ckbFrozenCandidateString(o,"evidenceHash")!=benchmarkGapSha256(body+"}")){return "frozen_candidate_manifest_invalid"};for(k in ["txIdHash","activePointerHash","transactionHash","candidateChecksum","inputHash","configHash","modelHash","studentLeakageProofHash","authorityIsolationArtifactHash","anonymousQueryArtifactHash","atomTestArtifactHash"]){if(!ckbFrozenCandidateHash(ckbFrozenCandidateString(o,k))){return "frozen_candidate_manifest_invalid"}};if(expectedCandidateChecksum!=""&&ckbFrozenCandidateString(o,"candidateChecksum")!=expectedCandidateChecksum){return "frozen_candidate_checksum_mismatch"};if(expectedLeakageProofHash!=""&&ckbFrozenCandidateString(o,"studentLeakageProofHash")!=expectedLeakageProofHash){return "student_leakage_proof_mismatch"};if(expectedKnowledgeVersion!=""&&ckbFrozenCandidateString(o,"knowledgeVersion")!=expectedKnowledgeVersion){return "frozen_knowledge_version_mismatch"};"ok"}catch(_:Exception){"frozen_candidate_manifest_invalid"}}
public func ckbFrozenCandidateManifestDiagnostic(store:FileKnowledgeStore,raw:String):String{let d=ckbFrozenCandidateManifestIntegrityDiagnostic(raw);if(d!="ok"){return d};try{let o=JsonValue.fromStr(raw).asObject();let p=store.loadActiveSnapshotPointer();if(!p.valid){return "frozen_candidate_manifest_drift"};let s=store.loadActiveSnapshot();let tx=store.root.join("transactions").join(p.txId);if(!s.valid||ckbFrozenCandidateString(o,"knowledgeVersion")!=p.activeVersion||ckbFrozenCandidateString(o,"txIdHash")!=benchmarkGapSha256(p.txId)||ckbFrozenCandidateString(o,"activePointerHash")!=ckbActiveSnapshotPointerIdentityHash(p)||ckbFrozenCandidateString(o,"transactionHash")!=ckbFrozenCandidateDirectoryHash(tx)||ckbFrozenCandidateString(o,"candidateChecksum")!=ckbCertifiedNormalizedRecordsChecksum(s.normalizedRecords)){return "frozen_candidate_manifest_drift"};if(ckbActiveSnapshotPointerIdentityHash(store.loadActiveSnapshotPointer())!=ckbActiveSnapshotPointerIdentityHash(p)){return "frozen_candidate_manifest_drift"};"ok"}catch(_:Exception){"frozen_candidate_manifest_drift"}}
private func ckbFrozenCandidateBody(version:String,tx:String,pointer:String,transaction:String,candidate:String,input:String,config:String,model:String,leakage:String,authority:String,query:String,atom:String):String{"{\"schemaVersion\":\"ckb-frozen-candidate-v1\",\"knowledgeVersion\":\"${ckbFrozenCandidateEscape(version)}\",\"txIdHash\":\"${tx}\",\"activePointerHash\":\"${pointer}\",\"transactionHash\":\"${transaction}\",\"candidateChecksum\":\"${candidate}\",\"inputHash\":\"${input}\",\"configHash\":\"${config}\",\"modelHash\":\"${model}\",\"studentLeakageProofHash\":\"${leakage}\",\"authorityIsolationArtifactHash\":\"${authority}\",\"anonymousQueryArtifactHash\":\"${query}\",\"atomTestArtifactHash\":\"${atom}\""}
private func ckbFrozenCandidateString(o:JsonObject,k:String):String{o.get(k).getOrThrow().asString().getValue()}

private func ckbFrozenCandidateDirectoryHash(root:Path):String{let entries=ArrayList<String>();ckbFrozenCandidateCollect(root,"",entries);let ordered=entries.toArray();sort(ordered);let seed=StringBuilder();for(entry in ordered){seed.append("${entry.toArray().size}:${entry}")};benchmarkGapSha256(seed.toString())}
private func ckbFrozenCandidateCollect(root:Path,prefix:String,out:ArrayList<String>):Unit{for(entry in Directory.readFrom(root)){let relative=if(prefix==""){entry.name}else{"${prefix}/${entry.name}"};if(entry.isDirectory()){ckbFrozenCandidateCollect(entry.path,relative,out)}else if(entry.isRegular()){out.add("${relative}=${ckbFrozenCandidateBytesHash(File.readFrom(entry.path))}")}}}
private func ckbFrozenCandidateBytesHash(bytes:Array<UInt8>):String{let digest=SHA256();digest.write(bytes);let out=StringBuilder();for(byte in digest.finish()){out.append(ckbFrozenCandidateNibble(byte/UInt8(16)));out.append(ckbFrozenCandidateNibble(byte%UInt8(16)))};"sha256:${out.toString()}"}
private func ckbFrozenCandidateNibble(value:UInt8):String{if(value==UInt8(0)){return "0"};if(value==UInt8(1)){return "1"};if(value==UInt8(2)){return "2"};if(value==UInt8(3)){return "3"};if(value==UInt8(4)){return "4"};if(value==UInt8(5)){return "5"};if(value==UInt8(6)){return "6"};if(value==UInt8(7)){return "7"};if(value==UInt8(8)){return "8"};if(value==UInt8(9)){return "9"};if(value==UInt8(10)){return "a"};if(value==UInt8(11)){return "b"};if(value==UInt8(12)){return "c"};if(value==UInt8(13)){return "d"};if(value==UInt8(14)){return "e"};"f"}
private func ckbFrozenCandidateHash(value:String):Bool{if(!value.startsWith("sha256:")||value.toRuneArray().size!=71){return false};for(r in value.toRuneArray()[7..71]){if(!((r>=r'0'&&r<=r'9')||(r>=r'a'&&r<=r'f'))){return false}};true}
private func ckbFrozenCandidateEscape(value:String):String{value.replace("\\","\\\\").replace("\"","\\\"").replace("\n","\\n").replace("\r","\\r").replace("\t","\\t")}
